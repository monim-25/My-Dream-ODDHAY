<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Custom Quiz | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header', { pageTitle: 'Custom Quiz', activePage: 'exams' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <main class="flex-1 w-full overflow-y-auto p-4 sm:p-6 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-4 pb-12">
            
            <!-- CUSTOM TEST FORM CONTAINER -->
            <div class="max-w-3xl w-full mx-auto bg-slate-50/90 dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-4 sm:p-6 shadow-sm">
                
                <form id="customTestForm" action="/exams/custom-start" method="POST" onsubmit="return validateFormSubmit(event)" class="space-y-4">
                    
                    <input type="hidden" id="negativeMarkingInput" name="negativeMarking" value="off">

                    <!-- COMPACT 2-COLUMN GRID -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        
                        <!-- 1. SUBJECTS POPOVER DROPDOWN -->
                        <div class="space-y-1.5 relative" id="subjectsWrapper">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base text-indigo-500 flex items-center justify-center shrink-0">menu_book</span>
                                <span>Subjects</span>
                            </label>

                            <button type="button" id="subjectsTrigger" onclick="toggleSubjectsDropdown(event)" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100 flex items-center justify-between shadow-2xs hover:border-indigo-400 transition-all gap-2">
                                <span id="subjectsTriggerText" class="truncate font-semibold">Select Subjects</span>
                                <span class="material-symbols-rounded text-lg text-slate-400 shrink-0">expand_more</span>
                            </button>

                            <div id="subjectsDropdown" class="hidden absolute top-full left-0 w-full mt-1.5 z-40 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-3 space-y-2 max-h-60 overflow-y-auto no-scrollbar flex flex-col justify-between">
                                <div class="space-y-1 flex-1">
                                    <% if (allSubjects && allSubjects.length > 0) { %>
                                        <% allSubjects.forEach(function(sub) { %>
                                            <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none">
                                                <input type="checkbox" name="subject" value="<%= sub %>" onchange="onSubjectSelectionChange()" class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                                                <span><%= sub %></span>
                                            </label>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="text-xs text-slate-400 font-medium p-1">No subjects available for your class.</div>
                                    <% } %>
                                </div>

                                <!-- STICKY FOOTER BAR WITH EXPANDING SELECTED NAMES AND DONE BUTTON -->
                                <div class="sticky -bottom-3 -mx-3 -mb-3 p-2.5 bg-white dark:bg-slate-900 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2 rounded-b-xl z-20">
                                    <div id="subjectsDropdownSelectedCount" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 break-words leading-tight flex-1 mr-2">None selected</div>
                                    <button type="button" onclick="closeDropdowns()" class="px-3.5 py-1 rounded-lg bg-indigo-600 text-white text-[11px] font-bold hover:bg-indigo-500 transition-all shadow-xs shrink-0">Done</button>
                                </div>
                            </div>
                        </div>

                        <!-- 2. TOPICS POPOVER DROPDOWN -->
                        <div class="space-y-1.5 relative" id="topicsWrapper">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base text-teal-500 flex items-center justify-center shrink-0">topic</span>
                                <span>Topics / Chapters</span>
                            </label>

                            <button type="button" id="topicsTrigger" onclick="toggleTopicsDropdown(event)" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100 flex items-center justify-between shadow-2xs hover:border-teal-400 transition-all gap-2">
                                <span id="topicsTriggerText" class="truncate font-semibold">Select Topics</span>
                                <span class="material-symbols-rounded text-lg text-slate-400 shrink-0">expand_more</span>
                            </button>

                            <div id="topicsDropdown" class="hidden absolute top-full left-0 w-full mt-1.5 z-40 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-3 space-y-2 max-h-60 overflow-y-auto no-scrollbar flex flex-col justify-between">
                                <div id="topicsListInsideDropdown" class="space-y-1 flex-1">
                                    <div class="text-xs text-slate-400 font-medium p-1">Select one or more subjects first.</div>
                                </div>

                                <!-- STICKY FOOTER BAR WITH EXPANDING SELECTED NAMES AND DONE BUTTON -->
                                <div class="sticky -bottom-3 -mx-3 -mb-3 p-2.5 bg-white dark:bg-slate-900 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2 rounded-b-xl z-20">
                                    <div id="topicsDropdownSelectedCount" class="text-[11px] font-bold text-teal-600 dark:text-teal-400 break-words leading-tight flex-1 mr-2">None selected</div>
                                    <button type="button" onclick="closeDropdowns()" class="px-3.5 py-1 rounded-lg bg-teal-600 text-white text-[11px] font-bold hover:bg-teal-500 transition-all shadow-xs shrink-0">Done</button>
                                </div>
                            </div>
                        </div>

                        <!-- 3. QUESTION TYPE POPOVER DROPDOWN (AUTO-SELECTED MCQ) -->
                        <div class="space-y-1.5 relative" id="typesWrapper">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base text-sky-500 flex items-center justify-center shrink-0">checklist</span>
                                <span>Question Type</span>
                            </label>

                            <button type="button" id="typeTrigger" onclick="toggleTypesDropdown(event)" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100 flex items-center justify-between shadow-2xs hover:border-sky-400 transition-all gap-2">
                                <span id="typeTriggerText" class="truncate font-semibold">MCQ</span>
                                <span class="material-symbols-rounded text-lg text-slate-400 shrink-0">expand_more</span>
                            </button>

                            <div id="typesDropdown" class="hidden absolute top-full left-0 w-full mt-1.5 z-40 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-3 space-y-2 max-h-60 overflow-y-auto no-scrollbar flex flex-col justify-between">
                                <div class="space-y-1 flex-1">
                                    <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none">
                                        <input type="checkbox" name="questionTypes" value="MCQ" checked onchange="onTypeSelectionChange()" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                                        <span>MCQ</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none">
                                        <input type="checkbox" name="questionTypes" value="Short" onchange="onTypeSelectionChange()" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                                        <span>Short</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none">
                                        <input type="checkbox" name="questionTypes" value="Medium" onchange="onTypeSelectionChange()" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                                        <span>Medium</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none">
                                        <input type="checkbox" name="questionTypes" value="Comprehension" onchange="onTypeSelectionChange()" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                                        <span>Comprehension</span>
                                    </label>
                                </div>

                                <!-- STICKY FOOTER BAR WITH EXPANDING SELECTED NAMES AND DONE BUTTON -->
                                <div class="sticky -bottom-3 -mx-3 -mb-3 p-2.5 bg-white dark:bg-slate-900 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2 rounded-b-xl z-20">
                                    <div id="typesDropdownSelectedCount" class="text-[11px] font-bold text-sky-600 dark:text-sky-400 break-words leading-tight flex-1 mr-2">MCQ</div>
                                    <button type="button" onclick="closeDropdowns()" class="px-3.5 py-1 rounded-lg bg-sky-600 text-white text-[11px] font-bold hover:bg-sky-500 transition-all shadow-xs shrink-0">Done</button>
                                </div>
                            </div>
                        </div>

                        <!-- 4. EXAM DURATION (INPUT WITH COMPACT INTEGRATED UNIT SELECTOR INSIDE) -->
                        <div class="space-y-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base text-purple-500 flex items-center justify-center shrink-0">timer</span>
                                <span>Exam Duration</span>
                            </label>
                            
                            <div class="relative flex items-center">
                                <input type="number" id="durationInput" name="duration" min="1" max="300" value="15" class="w-full p-2.5 pr-24 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100 outline-none focus:border-purple-500 transition-all" placeholder="Duration...">
                                <div class="absolute right-1.5 top-1.5 bottom-1.5 flex items-center">
                                    <select name="durationUnit" class="h-full px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-[11px] font-bold text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700/60 outline-none cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
                                        <option value="mins" selected class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100">Minutes</option>
                                        <option value="hours" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100">Hours</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 5. DYNAMIC QUESTION COUNT INPUTS (LOADED PER CHECKED QUESTION TYPE) -->
                        <div class="space-y-2 sm:col-span-2" id="questionCountsWrapper">
                            <div id="questionCountsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
                        </div>

                    </div>

                    <!-- ACTION BUTTONS BAR (PROCEED BUTTON OPENS MODAL) -->
                    <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-end">
                        <button type="button" onclick="handleProceedClick()" id="submitBtn" class="px-6 py-2 rounded-lg bg-[#1e293b] hover:bg-[#0f172a] dark:bg-emerald-600 dark:hover:bg-emerald-500 text-white text-xs font-extrabold tracking-wide transition-all shadow-sm border border-white/10 active:scale-[0.98]">
                            Proceed
                        </button>
                    </div>

                </form>
            </div>

        </main>
    </div>

    <!-- PROCEED CONFIRMATION MODAL -->
    <div id="proceedModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-xs p-4 animate-in fade-in duration-200">
        <div class="max-w-md w-full bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-2xl space-y-4 relative overflow-hidden">
            
            <!-- MODAL HEADER WITH PERFECTLY POSITIONED ICON & CLOSE BUTTON -->
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-600 dark:text-cyan-400 shrink-0">
                        <span class="material-symbols-rounded text-lg leading-none">task_alt</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">Preview</h3>
                </div>
                <button type="button" onclick="closeProceedModal()" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center justify-center shrink-0 leading-none transition-all">
                    <span class="material-symbols-rounded text-base leading-none">close</span>
                </button>
            </div>

            <!-- MODAL SUMMARY BODY -->
            <div class="space-y-3">
                <div id="modalSummaryContent" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/70 dark:border-slate-800 space-y-2.5 text-xs text-slate-800 dark:text-slate-200">
                    <!-- Populated dynamically by JS -->
                </div>

                <!-- NEGATIVE MARKING TOGGLE (NOT BOLD DESIGN) -->
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/70 dark:border-slate-800 flex items-center justify-between gap-3">
                    <div>
                        <span class="text-xs font-semibold text-slate-800 dark:text-white block">Negative Marking</span>
                        <span class="text-[10px] font-normal text-slate-500 dark:text-slate-400 block">-0.25 penalty per wrong MCQ</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                        <input type="checkbox" id="modalNegativeToggle" onchange="toggleModalNegativeMarking(this)" class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-800 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-500 relative"></div>
                    </label>
                </div>
            </div>

            <!-- MODAL FOOTER ACTIONS (CYAN-650 START EXAM BUTTON) -->
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeProceedModal()" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold transition-all">
                    Cancel
                </button>
                <button type="button" onclick="startFinalExam()" class="px-5 py-2 rounded-xl bg-[#0891b2] hover:bg-[#0e7490] text-white text-xs font-bold transition-all shadow-md shadow-cyan-600/20 active:scale-[0.98] flex items-center gap-2 group">
                    <span class="material-symbols-rounded text-base text-white group-hover:scale-110 transition-transform leading-none">play_circle</span>
                    <span>Start Exam</span>
                </button>
            </div>

        </div>
    </div>

    <script>
        const rawTopicsData = <%- JSON.stringify(rawTopics || []) %>;
        let typeAvailableCounts = { MCQ: 0, Short: 0, Medium: 0, Comprehension: 0 };
        let totalAvailableQuestions = 0;

        document.addEventListener('DOMContentLoaded', () => {
            renderSelectedTypesText();
            renderDynamicCountInputs();
            renderTopicsDropdownList();
            fetchAvailableQuestionsCount();
        });

        function toggleSubjectsDropdown(e) {
            if (e) e.stopPropagation();
            closeDropdownsExcept('subjectsDropdown');
        }

        function toggleTopicsDropdown(e) {
            if (e) e.stopPropagation();
            closeDropdownsExcept('topicsDropdown');
        }

        function toggleTypesDropdown(e) {
            if (e) e.stopPropagation();
            closeDropdownsExcept('typesDropdown');
        }

        function closeDropdownsExcept(activeId) {
            const dropdowns = ['subjectsDropdown', 'topicsDropdown', 'typesDropdown'];
            dropdowns.forEach(id => {
                const el = document.getElementById(id);
                if (id === activeId) el.classList.toggle('hidden');
                else el.classList.add('hidden');
            });
        }

        function closeDropdowns() {
            document.getElementById('subjectsDropdown').classList.add('hidden');
            document.getElementById('topicsDropdown').classList.add('hidden');
            document.getElementById('typesDropdown').classList.add('hidden');
        }

        document.addEventListener('click', (e) => {
            const sWrapper = document.getElementById('subjectsWrapper');
            const tWrapper = document.getElementById('topicsWrapper');
            const typeWrapper = document.getElementById('typesWrapper');
            if (sWrapper && !sWrapper.contains(e.target)) document.getElementById('subjectsDropdown').classList.add('hidden');
            if (tWrapper && !tWrapper.contains(e.target)) document.getElementById('topicsDropdown').classList.add('hidden');
            if (typeWrapper && !typeWrapper.contains(e.target)) document.getElementById('typesDropdown').classList.add('hidden');
        });

        function getSelectedSubjects() {
            const checkboxes = document.querySelectorAll('input[name="subject"]:checked');
            return Array.from(checkboxes).map(cb => cb.value);
        }

        function getSelectedTopics() {
            const checkboxes = document.querySelectorAll('input[name="topic"]:checked');
            return Array.from(checkboxes).map(cb => cb.value);
        }

        function getSelectedQuestionTypes() {
            const checkboxes = document.querySelectorAll('input[name="questionTypes"]:checked');
            const types = Array.from(checkboxes).map(cb => cb.value);
            return types.length > 0 ? types : ['MCQ'];
        }

        function onSubjectSelectionChange() {
            renderSelectedSubjectsText();
            renderTopicsDropdownList();
            fetchAvailableQuestionsCount();
        }

        function onTopicSelectionChange() {
            renderSelectedTopicsText();
            fetchAvailableQuestionsCount();
        }

        function onTypeSelectionChange() {
            renderSelectedTypesText();
            renderDynamicCountInputs();
            fetchAvailableQuestionsCount();
        }

        function renderSelectedSubjectsText() {
            const selected = getSelectedSubjects();
            const triggerText = document.getElementById('subjectsTriggerText');
            const footerCount = document.getElementById('subjectsDropdownSelectedCount');

            if (selected.length === 0) triggerText.textContent = 'Select Subjects';
            else if (selected.length === 1) triggerText.textContent = selected[0];
            else if (selected.length === 2) triggerText.textContent = `${selected[0]}, ${selected[1]}`;
            else triggerText.textContent = `${selected[0]}, ${selected[1]} (+${selected.length - 2} more)`;

            if (footerCount) {
                footerCount.textContent = selected.length > 0 ? selected.join(', ') : 'None selected';
            }
        }

        function renderTopicsDropdownList() {
            const selectedSubjects = getSelectedSubjects();
            const listContainer = document.getElementById('topicsListInsideDropdown');

            if (selectedSubjects.length === 0) {
                listContainer.innerHTML = '<div class="text-xs text-slate-400 font-medium p-1">Select one or more subjects first.</div>';
                renderSelectedTopicsText();
                return;
            }

            const filteredTopics = rawTopicsData
                .filter(t => t._id && selectedSubjects.includes(t._id.subject) && t._id.topic)
                .map(t => t._id.topic);

            const uniqueTopics = Array.from(new Set(filteredTopics)).sort();

            if (uniqueTopics.length === 0) {
                listContainer.innerHTML = '<div class="text-xs text-slate-400 font-medium p-1">All topics under selected subjects included.</div>';
                renderSelectedTopicsText();
                return;
            }

            const currentSelectedTopics = getSelectedTopics();
            listContainer.innerHTML = '';

            uniqueTopics.forEach(tp => {
                const isChecked = currentSelectedTopics.includes(tp);
                const label = document.createElement('label');
                label.className = 'flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/70 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 select-none';
                
                label.innerHTML = `
                    <input type="checkbox" name="topic" value="${tp}" ${isChecked ? 'checked' : ''} onchange="onTopicSelectionChange()" class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                    <span>${tp}</span>
                `;
                listContainer.appendChild(label);
            });

            renderSelectedTopicsText();
        }

        function renderSelectedTopicsText() {
            const selected = getSelectedTopics();
            const triggerText = document.getElementById('topicsTriggerText');
            const footerCount = document.getElementById('topicsDropdownSelectedCount');

            if (selected.length === 0) triggerText.textContent = 'Select Topics';
            else if (selected.length === 1) triggerText.textContent = selected[0];
            else if (selected.length === 2) triggerText.textContent = `${selected[0]}, ${selected[1]}`;
            else triggerText.textContent = `${selected[0]}, ${selected[1]} (+${selected.length - 2} more)`;

            if (footerCount) {
                footerCount.textContent = selected.length > 0 ? selected.join(', ') : 'None selected';
            }
        }

        function renderSelectedTypesText() {
            const selected = getSelectedQuestionTypes();
            const triggerText = document.getElementById('typeTriggerText');
            const footerCount = document.getElementById('typesDropdownSelectedCount');

            if (selected.length === 0) triggerText.textContent = 'Select Question Types';
            else if (selected.length === 1) triggerText.textContent = selected[0];
            else if (selected.length === 2) triggerText.textContent = `${selected[0]}, ${selected[1]}`;
            else triggerText.textContent = `${selected[0]}, ${selected[1]} (+${selected.length - 2} more)`;

            if (footerCount) {
                footerCount.textContent = selected.length > 0 ? selected.join(', ') : 'None selected';
            }
        }

        function renderDynamicCountInputs() {
            const selectedTypes = getSelectedQuestionTypes();
            const container = document.getElementById('questionCountsContainer');
            
            const existingValues = {};
            selectedTypes.forEach(type => {
                const existingInput = document.querySelector(`input[name="count_${type}"]`);
                if (existingInput) existingValues[type] = existingInput.value;
            });

            container.innerHTML = '';
            selectedTypes.forEach(type => {
                const avail = typeAvailableCounts[type] !== undefined ? typeAvailableCounts[type] : 0;
                const userVal = existingValues[type] !== undefined ? existingValues[type] : '';
                const isZero = (avail === 0 && (getSelectedSubjects().length > 0 || getSelectedTopics().length > 0));
                
                const box = document.createElement('div');
                box.className = 'space-y-1.5';
                box.innerHTML = `
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-base text-amber-500 flex items-center justify-center shrink-0">format_list_numbered</span>
                        <span>${type} Question Count</span>
                    </label>
                    <input type="number" id="count_${type}" name="count_${type}" min="1" max="100" value="${isZero ? '0' : userVal}" ${isZero ? 'disabled' : ''} oninput="validateQuestionCountInput()" onchange="validateQuestionCountInput()" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-900 dark:text-white outline-none focus:border-amber-500 placeholder:text-slate-400/80 placeholder:font-normal transition-all ${isZero ? 'opacity-50 bg-slate-100 dark:bg-slate-800/80 cursor-not-allowed border-rose-300 dark:border-rose-900' : ''}" placeholder="${isZero ? '0 available' : 'Enter number'}">
                    
                    <div id="alert_${type}" class="${isZero ? '' : 'hidden'} text-[11px] font-bold ${isZero ? 'text-rose-500 dark:text-rose-400' : 'text-amber-600 dark:text-amber-400'} flex items-center gap-1 pt-0.5">
                        <span class="material-symbols-rounded text-xs shrink-0">${isZero ? 'block' : 'warning'}</span>
                        <span id="alert_text_${type}">${isZero ? `No ${type} questions available` : ''}</span>
                    </div>
                `;
                container.appendChild(box);
            });
        }

        async function fetchAvailableQuestionsCount() {
            const selectedSubjects = getSelectedSubjects();
            const selectedTopics = getSelectedTopics();
            const selectedTypes = getSelectedQuestionTypes();

            try {
                const query = new URLSearchParams();
                if (selectedSubjects.length > 0) query.append('subject', selectedSubjects.join(','));
                if (selectedTopics.length > 0) query.append('topic', selectedTopics.join(','));
                if (selectedTypes.length > 0) query.append('questionTypes', selectedTypes.join(','));

                const response = await fetch(`/api/questions/count?${query.toString()}`);
                const data = await response.json();

                if (data.success) {
                    totalAvailableQuestions = data.count;
                    typeAvailableCounts = data.typeCounts || { MCQ: 0, Short: 0, Medium: 0, Comprehension: 0 };
                } else {
                    totalAvailableQuestions = 0;
                    typeAvailableCounts = { MCQ: 0, Short: 0, Medium: 0, Comprehension: 0 };
                }
            } catch (err) {
                console.error('Error fetching question count:', err);
                totalAvailableQuestions = 0;
                typeAvailableCounts = { MCQ: 0, Short: 0, Medium: 0, Comprehension: 0 };
            }
            renderDynamicCountInputs();
            validateQuestionCountInput();
        }

        function validateQuestionCountInput() {
            const submitBtn = document.getElementById('submitBtn');
            const selectedTypes = getSelectedQuestionTypes();

            let hasOverflow = false;
            let hasAnyValidInput = false;

            selectedTypes.forEach(type => {
                const input = document.getElementById(`count_${type}`);
                const alertEl = document.getElementById(`alert_${type}`);
                const alertTextEl = document.getElementById(`alert_text_${type}`);
                if (!input) return;

                const avail = typeAvailableCounts[type] !== undefined ? typeAvailableCounts[type] : 0;
                const isZero = (avail === 0 && (getSelectedSubjects().length > 0 || getSelectedTopics().length > 0));

                if (isZero) {
                    input.disabled = true;
                    input.value = '0';
                    input.classList.add('opacity-50', 'bg-slate-100', 'dark:bg-slate-800/80', 'cursor-not-allowed', 'border-rose-300', 'dark:border-rose-900');
                    if (alertEl && alertTextEl) {
                        alertEl.className = 'text-[11px] font-bold text-rose-500 dark:text-rose-400 flex items-center gap-1 pt-0.5';
                        const iconSpan = alertEl.querySelector('.material-symbols-rounded');
                        if (iconSpan) iconSpan.textContent = 'block';
                        alertTextEl.textContent = `No ${type} questions available`;
                    }
                } else {
                    input.disabled = false;
                    input.classList.remove('opacity-50', 'bg-slate-100', 'dark:bg-slate-800/80', 'cursor-not-allowed', 'border-rose-300', 'dark:border-rose-900');

                    const val = parseInt(input.value) || 0;
                    if (avail > 0 && val > avail) {
                        hasOverflow = true;
                        input.classList.add('border-amber-500');
                        if (alertEl && alertTextEl) {
                            alertEl.className = 'text-[11px] font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1 pt-0.5';
                            const iconSpan = alertEl.querySelector('.material-symbols-rounded');
                            if (iconSpan) iconSpan.textContent = 'warning';
                            alertTextEl.textContent = `Only ${avail} ${type} questions available`;
                        }
                    } else {
                        input.classList.remove('border-amber-500');
                        if (alertEl) alertEl.classList.add('hidden');
                        if (val > 0) hasAnyValidInput = true;
                    }
                }
            });

            if (hasOverflow || !hasAnyValidInput) {
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                return false;
            } else {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                return true;
            }
        }

        function handleProceedClick() {
            const isValid = validateQuestionCountInput();
            if (!isValid) return;

            const selectedSubjects = getSelectedSubjects();
            const selectedTopics = getSelectedTopics();
            const selectedTypes = getSelectedQuestionTypes();
            const duration = document.getElementById('durationInput').value;
            const durationUnit = document.querySelector('select[name="durationUnit"]').value;

            let countsSummary = [];
            selectedTypes.forEach(t => {
                const inp = document.getElementById(`count_${t}`);
                if (inp && parseInt(inp.value) > 0) {
                    countsSummary.push(`${inp.value} ${t}`);
                }
            });

            const summaryContent = document.getElementById('modalSummaryContent');
            summaryContent.innerHTML = `
                <div class="flex items-start justify-between border-b border-slate-200/80 dark:border-slate-800/80 pb-2">
                    <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5 font-medium leading-none">
                        <span class="material-symbols-rounded text-base text-indigo-500 shrink-0 flex items-center justify-center leading-none">menu_book</span>
                        <span>Subjects</span>
                    </span>
                    <span class="text-right font-normal text-slate-800 dark:text-slate-200 max-w-[60%] break-words leading-tight">${selectedSubjects.length > 0 ? selectedSubjects.join(', ') : 'All Assigned'}</span>
                </div>
                <div class="flex items-start justify-between border-b border-slate-200/80 dark:border-slate-800/80 pb-2">
                    <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5 font-medium leading-none">
                        <span class="material-symbols-rounded text-base text-teal-500 shrink-0 flex items-center justify-center leading-none">topic</span>
                        <span>Topics</span>
                    </span>
                    <span class="text-right font-normal text-slate-800 dark:text-slate-200 max-w-[60%] break-words leading-tight">${selectedTopics.length > 0 ? selectedTopics.join(', ') : 'All Included'}</span>
                </div>
                <div class="flex items-start justify-between border-b border-slate-200/80 dark:border-slate-800/80 pb-2">
                    <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5 font-medium leading-none">
                        <span class="material-symbols-rounded text-base text-cyan-500 shrink-0 flex items-center justify-center leading-none">format_list_numbered</span>
                        <span>Questions</span>
                    </span>
                    <span class="text-right font-medium text-cyan-600 dark:text-cyan-400 leading-tight">${countsSummary.join(' + ')}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5 font-medium leading-none">
                        <span class="material-symbols-rounded text-base text-cyan-500 shrink-0 flex items-center justify-center leading-none">timer</span>
                        <span>Duration</span>
                    </span>
                    <span class="font-medium text-cyan-600 dark:text-cyan-400 leading-tight">${duration} ${durationUnit}</span>
                </div>
            `;

            document.getElementById('proceedModal').classList.remove('hidden');
        }

        function closeProceedModal() {
            const modal = document.getElementById('proceedModal');
            if (modal) modal.classList.add('hidden');
        }
        window.closeProceedModal = closeProceedModal;

        function toggleModalNegativeMarking(el) {
            document.getElementById('negativeMarkingInput').value = el.checked ? 'on' : 'off';
        }

        function startFinalExam() {
            document.getElementById('customTestForm').submit();
        }

        function validateFormSubmit(e) {
            const isValid = validateQuestionCountInput();
            if (!isValid) {
                e.preventDefault();
                return false;
            }
            return true;
        }
    </script>
</body>
</html>
