        // Initialize Tree, Video Listeners, and URL Hash Navigation
        let curriculumInitialized = false;
        function initCurriculum() {
            if (curriculumInitialized) return;
            curriculumInitialized = true;
            renderCurriculumTree();

            // Calculate and display only the count of new announcements
            try {
                updateAnnouncementBadge();
            } catch(e) {}

            // Setup HTML5 video progress saver & restore speed settings listeners
            const videoEl = document.getElementById('playerVideoEl');
            if (videoEl && !videoEl._listenersAttached) {
                videoEl._listenersAttached = true;
                let lastSavedTime = 0;
                let lastServerSyncTime = 0;

                window.syncCurrentPlaybackProgress = function(force = false) {
                    if (!activePlayingNodeId || !videoEl) return;
                    const now = videoEl.currentTime || 0;
                    const nowSec = Math.floor(now);
                    const durSec = Math.floor(videoEl.duration || 0);
                    if (nowSec <= 0 && !force) return;

                    localStorage.setItem(`video-progress-${currentUserId}-${activePlayingNodeId}`, now.toString());

                    const isCompleted = durSec > 0 && ((nowSec / durSec >= 0.92) || (durSec >= 300 && durSec - nowSec <= 25));

                    const activeNode = (typeof curriculumNodes !== 'undefined') ? curriculumNodes.find(n => String(n._id) === String(activePlayingNodeId)) : null;
                    const title = activeNode ? (activeNode.name || activeNode.title) : 'Lesson';
                    const thumb = activeNode ? (activeNode.thumbnail || '') : '';

                    if (typeof currentCourseId !== 'undefined') {
                        // Sync to /api/progress for dashboard lastWatchedLesson
                        fetch('/api/progress', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            keepalive: true,
                            body: JSON.stringify({
                                courseId: currentCourseId,
                                lessonId: activePlayingNodeId,
                                lessonTitle: title,
                                thumbnail: thumb,
                                lastPosition: nowSec,
                                duration: durSec,
                                completed: isCompleted,
                                isCompleted: isCompleted
                            })
                        }).catch(console.error);

                        // Sync to course progress map
                        fetch(`/api/course/${currentCourseId}/progress/${activePlayingNodeId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            keepalive: true,
                            body: JSON.stringify({ progress: now, completed: isCompleted })
                        }).catch(console.error);
                    }
                };

                videoEl.addEventListener('timeupdate', () => {
                    if (!activePlayingNodeId) return;
                    const now = videoEl.currentTime;
                    // Safeguard: do not save if seeking to resume
                    if (window.__currentVideoTargetResume > 1 && now < 1 && !window.__currentVideoHasResumed) return;

                    // Save locally every 2 seconds
                    if (Math.abs(now - lastSavedTime) >= 2) {
                        localStorage.setItem(`video-progress-${currentUserId}-${activePlayingNodeId}`, now.toString());
                        lastSavedTime = now;
                    }
                    
                    // Sync to server every 5 seconds
                    if (Math.abs(now - lastServerSyncTime) >= 5) {
                        lastServerSyncTime = now;
                        window.syncCurrentPlaybackProgress();
                    }
                });

                videoEl.addEventListener('pause', () => {
                    if (activePlayingNodeId) {
                        window.syncCurrentPlaybackProgress(true);
                    }
                });

                window.addEventListener('beforeunload', () => {
                    if (activePlayingNodeId) {
                        window.syncCurrentPlaybackProgress(true);
                    }
                });

                videoEl.addEventListener('ratechange', () => {
                    if (videoEl.playbackRate) {
                        localStorage.setItem('video-speed', videoEl.playbackRate.toString());
                    }
                });
            }

            // Periodically poll for new comments silently to enable live updates
            setInterval(() => {
                if (!activePlayingNodeId) return;
                
                const mainInput = document.getElementById('commentInput');
                if (mainInput && document.activeElement === mainInput && mainInput.value.trim() !== '') return;
                
                const openForms = document.querySelectorAll('[id^="reply-form-"]:not(.hidden), [id^="edit-comment-form-"]:not(.hidden), [id^="edit-reply-form-"]:not(.hidden)');
                if (openForms.length > 0) return;
                
                loadNodeComments(activePlayingNodeId, false, true);
            }, 5000);

        // Course Announcement publishing and deletion handlers
        async function submitCourseAnnouncement(e) {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('btnPublishAnn') || document.getElementById('btnPublishNotice');
            const title = (form.annTitle || form.noticeTitle).value.trim();
            const content = (form.annContent || form.noticeContent).value.trim();
            const priority = (form.annPriority || form.noticePriority).value;
            if (!title || !content) return;
            if (btn) btn.disabled = true;
            try {
                const res = await fetch('/course/<%= course._id %>/announcement', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, content, priority })
                });
                const data = await res.json();
                if (data.success) {
                    form.reset();
                    const formBox = document.getElementById('teacherAnnouncementFormBox');
                    if (formBox) formBox.classList.add('hidden');
                    if (data.announcement) {
                        handleLiveIncomingAnnouncement({
                            _id: data.announcement._id,
                            courseId: '<%= course._id %>',
                            title: data.announcement.title,
                            content: data.announcement.content,
                            priority: data.announcement.priority || 'normal',
                            isHighPriority: data.announcement.priority === 'high',
                            author: {
                                name: '<%= locals.user ? user.name : "Course Instructor" %>',
                                profileImage: '<%= locals.user ? (user.profileImage || user.profilePicture) : "" %>',
                                role: '<%= locals.user ? user.role : "teacher" %>'
                            },
                            createdAt: data.announcement.createdAt || new Date(),
                            timeAgo: 'Just now',
                            type: 'announcement'
                        });
                    }
                } else {
                    alert(data.error || 'Failed to publish announcement');
                }
            } catch(err) {
                console.error(err);
                alert('Failed to publish announcement. Please try again.');
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        async function deleteCourseAnnouncement(annId) {
            if (!confirm('Are you sure you want to delete this announcement?')) return;
            try {
                const res = await fetch(`/course/<%= course._id %>/announcement/${annId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    handleLiveDeletedAnnouncement(annId);
                } else {
                    alert(data.error || 'Failed to delete announcement');
                }
            } catch(err) {
                console.error(err);
                alert('Error deleting announcement');
            }
        }

        // Backward compatibility aliases
        const submitCourseNotice = submitCourseAnnouncement;
        const deleteCourseNotice = deleteCourseAnnouncement;

            const urlParams = new URLSearchParams(window.location.search);
            const queryLessonId = urlParams.get('lesson') || urlParams.get('nodeId');
            const queryTime = parseFloat(urlParams.get('time')) || 0;

            const hash = window.location.hash.replace('#', '');
            if (queryLessonId) {
                switchTab('content', true);
                playVideoNode(queryLessonId, true, true, queryTime);
            } else if (hash) {
                if (hash.startsWith('video-')) {
                    const nodeId = hash.replace('video-', '');
                    switchTab('content', true);
                    playVideoNode(nodeId, true, true);
                } else if (hash.startsWith('folder-')) {
                    const fId = hash.replace('folder-', '');
                    switchTab('content', true);
                    openFolder(fId);
                } else if (['content', 'instructor', 'exams', 'announcement', 'announcements', 'notice', 'notices', 'details'].includes(hash)) {
                    switchTab((['notice', 'notices', 'announcements'].includes(hash)) ? 'announcement' : hash, true);
                } else if (hash === 'qa') {
                    switchTab('announcement', true);
                }
            } else {
                switchTab('content', true);
            }
        }

        // Execute immediately since curriculumNodes are already loaded in memory
        initCurriculum();
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCurriculum);
        }
    </script>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#000]/80 backdrop-blur-sm transition-all duration-300">
        <div class="w-full max-w-md bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-2xl shadow-2xl p-6 relative">
            <h3 class="text-base font-bold text-slate-800 dark:text-white mb-2">Confirm Delete</h3>
            <p id="deleteModalText" class="text-xs text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">Are you sure you want to delete this comment? This action is permanent and cannot be undone.</p>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-slate-50 dark:hover:bg-white/5 transition-all">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm">Delete</button>
            </div>
        </div>
    </div>
</body>
</html>