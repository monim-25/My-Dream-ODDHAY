        async function submitComment(e) {
            e.preventDefault();
            if (!activePlayingNodeId) return;

            const input = document.getElementById('commentInput');
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn ? btn.innerText : 'Comment';
            if (btn) {
                btn.disabled = true;
                btn.innerText = 'Posting...';
            }

            try {
                const res = await fetch(`/api/curriculum/node/${activePlayingNodeId}/comments`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, courseId: currentCourseId })
                });
                const data = await res.json();
                if (data.success) {
                    if (input) input.value = '';
                    await loadNodeComments(activePlayingNodeId);
                } else {
                    alert('Error: ' + (data.error || 'Could not post comment'));
                }
            } catch (err) {
                console.error('Error posting comment:', err);
                alert('Failed to post comment');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            }
        }

        function toggleReplyForm(formId, replyToUser = '', forceHide = false) {
            const formDiv = document.getElementById(`reply-form-${formId}`);
            if (formDiv) {
                if (forceHide) {
                    formDiv.classList.add('hidden');
                    const textarea = formDiv.querySelector('textarea');
                    if (textarea) textarea.value = '';
                } else {
                    const isHidden = formDiv.classList.contains('hidden');
                    if (isHidden) {
                        document.querySelectorAll('[id^="reply-form-"]').forEach(el => {
                            if (el.id !== `reply-form-${formId}`) {
                                el.classList.add('hidden');
                                const ta = el.querySelector('textarea');
                                if (ta) ta.value = '';
                            }
                        });

                        formDiv.classList.remove('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) {
                            if (replyToUser) {
                                textarea.value = `@${replyToUser} `;
                            } else {
                                textarea.value = '';
                            }
                            textarea.focus();
                        }
                    } else {
                        formDiv.classList.add('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) textarea.value = '';
                    }
                }
            }
        }

