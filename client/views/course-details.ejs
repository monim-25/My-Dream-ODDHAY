            const btn = document.getElementById('toggleCommentsBtn');
            const icon = document.getElementById('toggleCommentsIcon');
            const text = document.getElementById('toggleCommentsText');
            const banner = document.getElementById('commentsDisabledBanner');

            if (text) text.innerText = disabled ? "Turn on" : "Turn off";
