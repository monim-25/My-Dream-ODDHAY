            if (!nodeId || completedList.includes(nodeId.toString())) return;
            completedList.push(nodeId.toString());
            updateCompletionBtnUI();
            renderCurriculumTree();
            renderCoursePlaylist();

            try {
                await fetch('/api/user/complete-lesson', {
                    method: 'POST',
