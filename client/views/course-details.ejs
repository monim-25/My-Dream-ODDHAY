<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <% 
    function getImg(path) {
        if(!path) return '';
        if(path.startsWith('http')) return path;
        let normalized = path.replace(/\\/g, '/');
        if (!normalized.startsWith('/')) normalized = '/' + normalized;
        return normalized;
    }

    function getPrice(c) {
        if (!c) return 'Free';
        if (c.accessType === 'paid' || c.accessType === 'Paid') {
            if (c.discountPrice > 0) return '৳' + c.discountPrice;
            if (c.price > 0) return '৳' + c.price;
            if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
            return '৳' + (c.price || 0);
        }
        if (c.accessType === 'free' || c.accessType === 'Free') return 'Free';
        if (c.accessType === 'trial' || c.accessType === 'Trial') return 'Trial';
        
        if (c.discountPrice > 0) return '৳' + c.discountPrice;
        if (c.price > 0) return '৳' + c.price;
        if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
        return 'Free';
    }

    function getOriginalPrice(c) {
        if (!c) return null;
        if (c.discountPrice > 0 && c.price > c.discountPrice) return '৳' + c.price;
        return null;
    }

    // Calculate resource counters
    let totalVideos = Number(course.totalRecordedClasses) || 0;
    let totalLives = Number(course.totalLiveClasses) || 0;
    let totalNotes = Number(course.totalLectureNotes) || 0;
    let totalQuizzes = Number(course.totalQuizzes) || 0;

    let dynamicVideos = 0, dynamicLives = 0, dynamicNotes = 0, dynamicQuizzes = 0;
    if (course.chapters && Array.isArray(course.chapters)) {
        course.chapters.forEach(ch => {
            if (ch.recordedClasses) dynamicVideos += ch.recordedClasses.length;
            if (ch.liveClasses) dynamicLives += ch.liveClasses.length;
            if (ch.notes) dynamicNotes += ch.notes.length;
            if (ch.quizzes) dynamicQuizzes += ch.quizzes.length;
        });
    }
    if (course.curriculumNodes && Array.isArray(course.curriculumNodes)) {
        course.curriculumNodes.forEach(node => {
            if (node.type === 'video') dynamicVideos++;
            else if (node.type === 'liveClass') dynamicLives++;
            else if (node.type === 'note') dynamicNotes++;
            else if (node.type === 'quiz') dynamicQuizzes++;
        });
    }

    if (totalVideos === 0) totalVideos = dynamicVideos;
    if (totalLives === 0) totalLives = dynamicLives;
    if (totalNotes === 0) totalNotes = dynamicNotes;
    if (totalQuizzes === 0) totalQuizzes = dynamicQuizzes;

    const totalMaterials = totalVideos + totalLives + totalNotes + totalQuizzes;

    // Syllabus List
    let syllabusList = [];
    if (course.chapters && Array.isArray(course.chapters) && course.chapters.length > 0) {
        syllabusList = course.chapters.map(c => c.title).filter(Boolean);
    } else if (course.curriculumNodes && Array.isArray(course.curriculumNodes) && course.curriculumNodes.length > 0) {
        const folders = course.curriculumNodes.filter(n => n.type === 'folder');
        if (folders.length > 0) {
            syllabusList = folders.map(f => f.name).filter(Boolean);
        } else {
            syllabusList = course.curriculumNodes.map(n => n.name).filter(Boolean);
        }
    }

    // Learning Highlights
    const defaultHighlights = [
        'Full syllabus coverage with organized chapter-wise modules',
        'Interactive live sessions and recorded archive access',
        'Comprehensive PDF handouts and lecture summaries',
        'Progress tracking, model exams, and detailed analytics'
    ];
    const learningHighlights = (course.learningHighlights && Array.isArray(course.learningHighlights) && course.learningHighlights.length > 0)
        ? course.learningHighlights
        : defaultHighlights;

    const defaultBenefits = [
        'Instant digital access on mobile, tablet & PC',
        'Full syllabus coverage & practice assessments',
        'Direct instructor Q&A forum access'
    ];
    const courseBenefits = (course.courseBenefits && Array.isArray(course.courseBenefits) && course.courseBenefits.length > 0)
        ? course.courseBenefits
        : defaultBenefits;

    const classBadge = Array.isArray(course.classLevel) ? course.classLevel.join(', ') : (course.classLevel || 'General');
    const subjectBadge = Array.isArray(course.subject) ? course.subject.join(', ') : (course.subject || 'All Subjects');
    const studentProgress = locals.progress !== undefined ? locals.progress : 0;
    const completedList = (locals.completedLessons || []).map(id => id.toString());
    %>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title><%= course.title || 'Course Details' %> | ODDHAY</title>
    <style>
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
        .tab-btn.active {
            color: #10b981;
            border-bottom: 2px solid #10b981;
        }
        .dark .tab-btn.active {
            color: #34d399;
            border-bottom-color: #34d399;
        }
        .btn-primary-action {
            background: #10b981;
            color: #ffffff;
            font-weight: 700;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
        }
        .btn-primary-action:hover {
            background: #059669;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }
        .btn-secondary-action {
            background: #f8fafc;
            color: #334155;
            border: 1px solid #cbd5e1;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-secondary-action:hover {
            background: #f1f5f9;
            color: #0f172a;
        }
        .dark .btn-secondary-action {
            background: #1e293b;
            color: #cbd5e1;
            border-color: #334155;
        }
        .dark .btn-secondary-action:hover {
            background: #334155;
            color: #ffffff;
        }
    </style>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <% const headerBackUrl = (locals.from === 'dashboard') ? '/dashboard' : '/courses'; %>
    <%- include('partials/student-header', { pageTitle: course.title, course: course, backUrl: headerBackUrl, activePage: 'courses' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative bg-white dark:bg-[#0b1120]">
        <%- include('partials/student-sidebar', { activePage: 'courses' }) %>

        <main id="main-content-area" class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120] relative">
            
            <% if (locals.hasAccess) { %>
            <!-- ========================================================================= -->
            <!-- ENROLLED STUDENT VIEW (Course Learning Hub with Tabs like Teacher Hub) -->
            <!-- ========================================================================= -->
            <div class="w-full bg-white dark:bg-[#0f172a] flex flex-col">

                <!-- Sticky Tabs Navigation Bar -->
                <div id="tabs-nav-bar" class="sticky top-0 z-40 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-2xs">
                    <div class="w-full flex items-center gap-6 sm:gap-8 px-3 sm:px-4 md:px-5 overflow-x-auto no-scrollbar">
                        <button onclick="switchTab('content')" class="tab-btn active py-3.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap" id="tab-content">
                            Course Content
                        </button>
                        <button onclick="switchTab('instructor')" class="tab-btn py-3.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap" id="tab-instructor">
                            Instructors
                        </button>
                        <button onclick="switchTab('exams')" class="tab-btn py-3.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap" id="tab-exams">
                            Examination
                        </button>
                        <button onclick="switchTab('announcement')" class="tab-btn py-3.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap flex items-center gap-1.5" id="tab-announcement">
                            <span>Announcement</span>
                            <span id="announcementBadge" class="hidden px-1.5 py-0.5 text-[10px] font-semibold rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 leading-none">0</span>
                        </button>
                        <button onclick="switchTab('details')" class="tab-btn py-3.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap" id="tab-details">
                            Details
                        </button>
                    </div>
                </div>

                <!-- Tab Panes Container -->
                <div id="course-panes-container" class="w-full px-3 sm:px-4 md:px-5 pt-3 sm:pt-4 pb-24">

                    <!-- ========================================== -->
                    <!-- TAB 1: COURSE CONTENT (Curriculum Studio)  -->
                    <!-- ========================================== -->
                    <div id="pane-content" class="tab-pane space-y-4">
                        
                        <!-- In-Page Video Player Panel (slides in over the curriculum tree, identical to teacher studio) -->
                        <div id="videoPlayerPanel" class="hidden mb-6 space-y-4">

                            <!-- Main Layout: Top row (video | playlist), Bottom (metadata + comments) -->
                            <div class="w-full flex flex-col gap-2">
                                
                                <!-- TOP ROW: Video (left) | Playlist (right) -->
                                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start">
                                    <!-- LEFT: Video Player & Metadata -->
                                    <div class="lg:col-span-7 flex flex-col">
                                        <div class="overflow-hidden">
                                            <div class="w-full aspect-video bg-black relative flex items-center justify-center">
                                                <video id="playerVideoEl" controls class="w-full h-full object-contain hidden" controlsList="nodownload"></video>
                                                <iframe id="playerIframeEl" class="w-full h-full border-0 hidden" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                                                <div id="playerEmptyState" class="w-full h-full flex items-center justify-center bg-slate-900">
                                                    <span class="material-symbols-rounded text-slate-600 text-6xl">play_circle</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- METADATA BLOCK -->
                                        <div class="space-y-4 py-4 px-1 sm:px-2 md:px-3">
                                            <div class="flex items-start justify-between gap-3">
                                                <h2 id="playerVideoTitle" class="text-xl font-medium text-slate-900 dark:text-white leading-snug">
                                                    Lesson Title
                                                </h2>

                                                <div class="flex items-center gap-2 shrink-0">
                                                    <!-- Speed Control -->
                                                    <select id="videoSpeedSelect" onchange="changePlaybackSpeed(this.value)" class="h-8 px-3 min-w-[74px] text-xs font-bold rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/90 dark:bg-slate-800/90 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors focus:outline-none cursor-pointer">
                                                        <option value="0.75">0.75x</option>
                                                        <option value="1" selected>1.0x</option>
                                                        <option value="1.25">1.25x</option>
                                                        <option value="1.5">1.5x</option>
                                                        <option value="2">2.0x</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-5 pb-3 border-b border-slate-100 dark:border-white/5">
                                                <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500">
                                                    <span class="material-symbols-rounded text-[16px] text-slate-400">visibility</span>
                                                    <span id="playerVideoViews">0</span> views
                                                </div>
                                                <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500">
                                                    <span class="material-symbols-rounded text-[16px] text-slate-400">comment</span>
                                                    <span id="playerVideoComments">0</span> comments
                                                </div>
                                            </div>

                                            <div class="pt-3 pb-1 flex items-center gap-3">
                                                <div class="size-10 rounded-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 shrink-0">
                                                    <img id="playerAuthorAvatar" src="/images/default-avatar.png" class="size-full object-cover" alt="Author">
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <h4 id="playerAuthorName" class="text-[15px] font-semibold text-slate-800 dark:text-slate-200 leading-tight">Instructor Name</h4>
                                                </div>
                                            </div>

                                            <div class="relative group !mt-3 p-3 bg-slate-50 dark:bg-white/5 rounded-md border border-slate-100 dark:border-white/10">
                                                <p id="playerVideoDesc" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium line-clamp-2 whitespace-pre-wrap break-words">
                                                    No description available for this lesson.
                                                </p>
                                                <button id="descToggleBtn" type="button" class="hidden text-[12px] font-bold text-primary hover:underline mt-1" onclick="toggleDescription()">
                                                    Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- RIGHT: Course Playlist -->
                                    <div class="hidden lg:flex lg:col-span-5 flex-col">
                                        <div class="flex flex-col sticky top-6" style="max-height: calc(100vh - 100px);">
                                            <div class="flex items-center justify-between p-3 border-b border-slate-100 dark:border-white/5 shrink-0 gap-2">
                                                <div class="flex items-center gap-1.5 shrink-0">
                                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">playlist_play</span>
                                                    <h3 class="text-xs font-bold text-slate-800 dark:text-white hidden sm:block">Course Playlist</h3>
                                                    <span id="playlistCountBadge" class="px-1.5 py-0.5 bg-slate-100 dark:bg-white/5 text-slate-500 rounded-full text-[9px] font-bold"></span>
                                                </div>
                                                <div class="flex items-center gap-1.5 shrink-0 w-40 md:w-52">
                                                    <div class="relative flex-1">
                                                        <input type="text" id="playlistSearchInput" oninput="filterPlaylist()" placeholder="Search lessons..." class="w-full px-3 py-1.5 text-[11px] bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-full focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-slate-700 dark:text-slate-300 placeholder-slate-400">
                                                    </div>
                                                    <button type="button" onclick="filterPlaylist()" class="size-7 flex items-center justify-center shrink-0 bg-slate-900 dark:bg-white hover:bg-primary dark:hover:bg-primary text-white dark:text-slate-900 dark:hover:text-white rounded-full transition-all shadow-sm" title="Search">
                                                        <span class="material-symbols-rounded text-[14px]">search</span>
                                                    </button>
                                                </div>
                                            </div>
                                            <div id="playlistContainer" class="flex-1 overflow-y-auto p-2 space-y-0.5 min-h-[300px]">
                                                <div class="flex flex-col items-center justify-center text-center py-12 opacity-60">
                                                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">playlist_play</span>
                                                    <p class="text-xs font-medium text-slate-500">No lessons yet</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- BOTTOM AREA: Comments -->
                                <div class="flex flex-col gap-2 px-1 sm:px-2 md:px-3 pb-6">
                                    <!-- COMMENTS BLOCK -->
                                    <div class="py-2">
                                        <div class="flex items-center gap-4 mb-4 pb-3 border-b border-slate-100 dark:border-white/5 flex-wrap">
                                            <div class="flex items-center gap-2 shrink-0">
                                                <span class="material-symbols-rounded text-slate-400">forum</span>
                                                <h3 class="text-sm font-bold text-slate-800 dark:text-white">Comments</h3>
                                                <span id="commentsCountBadge" class="px-2 py-0.5 bg-slate-100 dark:bg-white/5 text-slate-500 rounded-full text-[10px] font-bold">0</span>
                                            </div>
                                            <% if (locals.user && (user.role === 'teacher' || user.role === 'admin' || user.role === 'superadmin')) { %>
                                            <button type="button" id="toggleCommentsBtn" onclick="toggleNodeCommentsSetting()" class="text-xs font-bold px-3 py-1 bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-white/10 transition-all rounded-none flex items-center gap-1.5 shrink-0">
                                                <span class="material-symbols-rounded text-[15px]" id="toggleCommentsIcon">chat</span>
                                                <span id="toggleCommentsText">Turn off/on</span>
                                            </button>
                                            <% } %>
                                        </div>
                                        
                                        <div id="commentsDisabledBanner" class="hidden p-2.5 mb-3 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/30 text-amber-800 dark:text-amber-300 text-xs font-semibold rounded-none flex items-center gap-2 shrink-0">
                                            <span class="material-symbols-rounded text-[16px]">info</span>
                                            <span>Comments are currently turned off for students.</span>
                                        </div>
                                        
                                        <form id="commentForm" onsubmit="submitComment(event)" class="mb-4 shrink-0">
                                            <textarea id="commentInput" rows="2" oninput="this.style.height = 'auto'; this.style.height = this.scrollHeight + 'px';" placeholder="Add a public comment..." required class="w-full text-sm p-2.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed min-h-[50px]"></textarea>
                                            <div class="flex justify-end mt-2">
                                                <button type="submit" class="px-4 py-1.5 bg-primary hover:bg-primary/95 text-white text-[11px] font-bold uppercase tracking-wider rounded-none shadow transition-all">Comment</button>
                                            </div>
                                        </form>
                                        
                                        <div id="commentsList" class="space-y-4 pr-1">
                                            <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                                                <p class="text-xs font-medium text-slate-500">No comments yet</p>
                                                <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                                            </div>
                                        </div>
                                        
                                        <div id="loadMoreCommentsContainer" class="mt-4 pt-2 text-center hidden shrink-0">
                                            <button type="button" onclick="loadNextCommentsPage()" class="w-full py-2 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all rounded-none uppercase tracking-wider">
                                                Load More Comments
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Interactive Curriculum Explorer (Drill-Down Folders & Nested Files) -->
                        <div id="curriculum-tree-container" class="space-y-4">
                            <div class="py-20 text-center">
                                <div class="inline-block size-8 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
                                <p class="text-xs font-bold text-slate-400 mt-4">Loading Curriculum...</p>
                            </div>
                        </div>

                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 2: INSTRUCTORS                         -->
                    <!-- ========================================== -->
                    <div id="pane-instructor" class="tab-pane hidden space-y-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                            
                            <!-- Lead Mentor Card -->
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center text-center gap-3">
                                <div class="size-24 rounded-full overflow-hidden border-4 border-emerald-50 dark:border-emerald-950/50 shadow-sm shrink-0">
                                    <img src="<%= getImg(course.instructor?.profileImage) || '/images/default-avatar.png' %>" class="size-full object-cover">
                                </div>
                                <div class="space-y-1 w-full">
                                    <span class="px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold border border-emerald-200 dark:border-emerald-800">Lead Mentor</span>
                                    <h3 class="text-base font-bold text-slate-900 dark:text-white truncate pt-1"><%= course.instructor?.name || 'Lead Instructor' %></h3>
                                    <p class="text-xs text-slate-400 truncate"><%= course.instructor?.email || 'Instructor' %></p>
                                    
                                    <div class="flex items-center justify-center gap-1 pt-1 text-amber-400">
                                        <span class="material-symbols-rounded text-base">star</span>
                                        <span class="material-symbols-rounded text-base">star</span>
                                        <span class="material-symbols-rounded text-base">star</span>
                                        <span class="material-symbols-rounded text-base">star</span>
                                        <span class="material-symbols-rounded text-base">star_half</span>
                                        <span class="text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">4.9</span>
                                    </div>

                                    <% if (course.instructor?.bio) { %>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed pt-2 line-clamp-3"><%= course.instructor.bio %></p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Permitted Teachers -->
                            <% if (course.permittedTeachers && course.permittedTeachers.length > 0) { %>
                                <% course.permittedTeachers.forEach(t => { %>
                                    <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center text-center gap-3">
                                        <div class="size-24 rounded-full overflow-hidden border-4 border-slate-100 dark:border-slate-800 shadow-sm shrink-0">
                                            <img src="<%= getImg(t.profileImage || t.profilePicture) || '/images/default-avatar.png' %>" class="size-full object-cover">
                                        </div>
                                        <div class="space-y-1 w-full">
                                            <span class="px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 text-[10px] font-bold border border-blue-200 dark:border-blue-800">Faculty Teacher</span>
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white truncate pt-1"><%= t.name %></h3>
                                            <p class="text-xs text-slate-400 truncate"><%= t.email || 'Teacher' %></p>
                                            
                                            <div class="flex items-center justify-center gap-1 pt-1 text-amber-400">
                                                <span class="material-symbols-rounded text-base">star</span>
                                                <span class="material-symbols-rounded text-base">star</span>
                                                <span class="material-symbols-rounded text-base">star</span>
                                                <span class="material-symbols-rounded text-base">star</span>
                                                <span class="material-symbols-rounded text-base">star</span>
                                                <span class="text-xs font-bold text-slate-600 dark:text-slate-400 ml-1">4.8</span>
                                            </div>

                                            <% if (t.bio) { %>
                                                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed pt-2 line-clamp-3"><%= t.bio %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>

                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 3: EXAMINATION                        -->
                    <!-- ========================================== -->
                    <div id="pane-exams" class="tab-pane hidden space-y-6">
                        <% 
                            let courseQuizzes = [];
                            (course.curriculumNodes || []).forEach(n => {
                                if (n.type === 'quiz' && n.quizId) {
                                    courseQuizzes.push(n.quizId);
                                }
                            });
                            if (courseQuizzes.length === 0 && course.chapters) {
                                course.chapters.forEach(ch => {
                                    (ch.quizzes || []).forEach(q => {
                                        if (q) courseQuizzes.push(q);
                                    });
                                });
                            }
                        %>

                        <% if (courseQuizzes.length === 0) { %>
                            <div class="py-16 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-[#111827]">
                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-2">history_edu</span>
                                <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300">No Exams Scheduled</h3>
                                <p class="text-xs text-slate-400 mt-1">Examinations and chapter quizzes will appear here once published.</p>
                            </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <% courseQuizzes.forEach(quiz => { 
                                    const quizId = quiz._id || quiz;
                                %>
                                    <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between gap-4">
                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between">
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 text-[10px] font-bold border border-amber-200 dark:border-amber-800">
                                                    Assessment
                                                </span>
                                                <div class="flex items-center gap-1 text-[11px] font-semibold text-slate-400">
                                                    <span class="material-symbols-rounded text-sm">timer</span>
                                                    <%= quiz.duration || 10 %> Min
                                                </div>
                                            </div>
                                            <h4 class="text-sm font-bold text-slate-900 dark:text-white line-clamp-2"><%= quiz.title || 'Course Quiz' %></h4>
                                            <p class="text-xs text-slate-500 dark:text-slate-400"><%= (quiz.questions && quiz.questions.length) || 0 %> Questions</p>
                                        </div>

                                        <a href="/quiz/<%= quizId %>?courseId=<%= course._id %>&from=course" class="w-full py-2.5 px-3 rounded-xl btn-primary-action text-xs flex items-center justify-center gap-1.5 text-center">
                                            <span class="material-symbols-rounded text-base">play_arrow</span>
                                            <span>Start Exam</span>
                                        </a>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 4: COURSE ANNOUNCEMENTS                -->
                    <!-- ========================================== -->
                    <div id="pane-announcement" class="tab-pane hidden space-y-4">
                        
                        <% 
                        const isInstructorOrAdmin = locals.user && (
                            (course.instructor && String(course.instructor._id || course.instructor) === String(user._id)) ||
                            (course.permittedTeachers && course.permittedTeachers.some(t => String(t._id || t) === String(user._id))) ||
                            user.role === 'admin' || 
                            user.role === 'superadmin'
                        );
                        const displayedAnnouncements = (locals.courseAnnouncements && locals.courseAnnouncements.length > 0) 
                            ? locals.courseAnnouncements 
                            : ((locals.courseNotices && locals.courseNotices.length > 0) 
                                ? locals.courseNotices 
                                : ((locals.announcements && locals.announcements.length > 0) ? locals.announcements : []));
                        %>

                        <% if (isInstructorOrAdmin) { %>
                            <!-- Teacher / Admin Post Action -->
                            <div class="flex items-center justify-end pb-1 pt-0.5 px-0.5">
                                <button type="button" onclick="document.getElementById('teacherAnnouncementFormBox').classList.toggle('hidden')" class="px-3.5 py-1.5 rounded-xl btn-primary-action text-xs font-bold flex items-center gap-1.5 shadow-sm">
                                    <span class="material-symbols-rounded text-base">add_circle</span>
                                    <span>Post Announcement</span>
                                </button>
                            </div>
                        <% } %>

                        <!-- Teacher / Admin Post Announcement Form (Collapsible) -->
                        <% if (isInstructorOrAdmin) { %>
                            <div id="teacherAnnouncementFormBox" class="hidden p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#111827] border border-emerald-500/30 dark:border-emerald-500/20 shadow-sm space-y-4">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base">edit_note</span>
                                        <span>Publish Announcement to All Enrolled Students</span>
                                    </h4>
                                    <button type="button" onclick="document.getElementById('teacherAnnouncementFormBox').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs">
                                        <span class="material-symbols-rounded text-lg">close</span>
                                    </button>
                                </div>

                                <form onsubmit="submitCourseAnnouncement(event)" class="space-y-3">
                                    <div>
                                        <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Announcement Title</label>
                                        <input type="text" name="annTitle" required placeholder="e.g. Special Revision Class Announcement or Exam Date" class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 font-medium">
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <div class="sm:col-span-2">
                                            <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Announcement Description</label>
                                            <textarea name="annContent" required rows="3" placeholder="Write full details of the announcement..." class="w-full p-3 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 font-medium resize-y"></textarea>
                                        </div>
                                        <div class="space-y-3 flex flex-col justify-between">
                                            <div>
                                                <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Priority</label>
                                                <select name="annPriority" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 font-medium">
                                                    <option value="normal">Normal Priority</option>
                                                    <option value="high">High Priority (Urgent)</option>
                                                </select>
                                            </div>
                                            <div class="flex justify-end pt-2">
                                                <button type="submit" id="btnPublishAnn" class="w-full px-4 py-2.5 rounded-xl btn-primary-action text-xs font-bold flex items-center justify-center gap-1.5">
                                                    <span class="material-symbols-rounded text-base">send</span>
                                                    <span>Publish Announcement</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        <% } %>

                        <!-- Announcements Feed List (Newest at Top) -->
                        <div class="space-y-3" id="courseAnnouncementsContainer">
                            <% if (displayedAnnouncements && displayedAnnouncements.length > 0) { %>
                                <% displayedAnnouncements.forEach(ann => { %>
                                    <div id="ann-card-<%= ann._id %>" class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#111827] border <%= ann.isHighPriority ? 'border-rose-200 dark:border-rose-900/40' : 'border-slate-200 dark:border-slate-800' %> shadow-xs space-y-2.5 relative overflow-hidden transition-all">
                                        
                                        <% if (ann.isHighPriority) { %>
                                            <div class="absolute top-0 right-0 bg-rose-500 text-white text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-bl-lg shadow-xs">
                                                Important
                                            </div>
                                        <% } %>

                                        <!-- Announcement Author & Time Header -->
                                        <div class="flex items-start justify-between gap-3 pr-16">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700 shrink-0 bg-slate-100 dark:bg-slate-800">
                                                    <img src="<%= getImg(ann.author?.profileImage || ann.author?.profilePicture) || '/images/default-avatar.png' %>" class="size-full object-cover" alt="Author">
                                                </div>
                                                <div>
                                                    <div class="flex items-center gap-2">
                                                        <h5 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                                                            <%= ann.author?.name || 'Course Instructor' %>
                                                        </h5>
                                                        <span class="px-1.5 py-0.5 text-[9px] font-bold rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
                                                            <%= ann.author?.role === 'admin' ? 'Admin' : 'Instructor' %>
                                                        </span>
                                                    </div>
                                                    <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-0.5">
                                                        <span class="flex items-center gap-0.5">
                                                            <span class="material-symbols-rounded text-[12px]">schedule</span>
                                                            <%= ann.timeAgo %>
                                                        </span>
                                                        <span>•</span>
                                                        <span><%= ann.formattedDate %></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <% if (isInstructorOrAdmin && (ann.type === 'announcement' || !ann.type)) { %>
                                                <button type="button" onclick="deleteCourseAnnouncement('<%= ann._id %>')" class="text-slate-400 hover:text-rose-500 p-1 rounded-lg transition-colors" title="Delete Announcement">
                                                    <span class="material-symbols-rounded text-base">delete</span>
                                                </button>
                                            <% } %>
                                        </div>

                                        <!-- Announcement Title -->
                                        <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                                            <%= ann.title %>
                                        </h4>

                                        <!-- Announcement Content Body -->
                                        <div class="text-xs sm:text-[13px] text-slate-700 dark:text-slate-300 leading-relaxed font-normal whitespace-pre-line bg-slate-50/60 dark:bg-slate-900/40 p-3.5 sm:p-4 rounded-xl border border-slate-100 dark:border-slate-800/60">
                                            <%= ann.content %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div id="annEmptyState" class="py-10 text-center border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-[#111827]">
                                    <p class="text-xs font-medium text-slate-400">No announcements published yet</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 5: DETAILS (Placed as Last Tab)        -->
                    <!-- ========================================== -->
                    <div id="pane-details" class="tab-pane hidden space-y-6">
                        
                        <!-- Thumbnail & Overview -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                            <div class="lg:col-span-8 space-y-6">
                                <% if (course.thumbnail) { %>
                                    <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm bg-slate-900 aspect-video max-h-[380px]">
                                        <img src="<%= getImg(course.thumbnail) %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                                    </div>
                                <% } %>

                                <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                                    <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                        <span class="material-symbols-rounded text-emerald-500">info</span>
                                        Course Description
                                    </h3>
                                    <div class="prose dark:prose-invert max-w-none text-sm text-slate-600 dark:text-slate-300 leading-relaxed space-y-3 font-normal">
                                        <% if (course.description && course.description.trim() !== '') { %>
                                            <div><%- course.description %></div>
                                        <% } else { %>
                                            <p>Welcome to <%= course.title %>. All learning materials, recorded videos, handouts, routine schedules, and interactive assessments are accessible here.</p>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Learning Highlights -->
                                <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                        <span class="material-symbols-rounded text-emerald-500">task_alt</span>
                                        Key Learning Highlights
                                    </h3>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600 dark:text-slate-300">
                                        <% learningHighlights.forEach(hl => { %>
                                            <div class="flex items-center gap-2">
                                                <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">check_circle</span>
                                                <span><%= hl %></span>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>

                            <!-- Course Quick Specs -->
                            <div class="lg:col-span-4 space-y-4">
                                <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Course Information</h4>
                                    
                                    <div class="space-y-3 text-xs">
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                                            <span class="text-slate-500">Subject</span>
                                            <span class="font-bold text-slate-800 dark:text-slate-200"><%= subjectBadge %></span>
                                        </div>
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                                            <span class="text-slate-500">Class Level</span>
                                            <span class="font-bold text-slate-800 dark:text-slate-200"><%= classBadge %></span>
                                        </div>
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                                            <span class="text-slate-500">Access Status</span>
                                            <span class="font-bold text-emerald-600 dark:text-emerald-400">Active Access</span>
                                        </div>
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                                            <span class="text-slate-500">Learning Materials</span>
                                            <span class="font-bold text-slate-800 dark:text-slate-200"><%= totalMaterials %> Items</span>
                                        </div>
                                    </div>

                                    <button type="button" onclick="switchTab('content')" class="w-full py-3 px-4 rounded-xl btn-primary-action flex items-center justify-center gap-2 text-xs">
                                        <span class="material-symbols-rounded text-base">play_circle</span>
                                        <span>Go to Course Content</span>
                                    </button>
                                </div>

                                <!-- Routine Image if available -->
                                <% if (course.routineImage) { %>
                                    <div class="p-4 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
                                        <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300">Routine Sheet</h4>
                                        <div class="rounded-xl overflow-hidden border border-slate-100 dark:border-slate-800 group relative">
                                            <img src="<%= getImg(course.routineImage) %>" alt="Class Routine" class="w-full h-auto object-cover max-h-48">
                                            <a href="javascript:void(0)" onclick="openImageViewer('<%= getImg(course.routineImage) %>', 'Class Routine Sheet')" class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold gap-1.5 cursor-pointer">
                                                <span class="material-symbols-rounded text-base">zoom_in</span> View Full Routine
                                            </a>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Class Routine Table -->
                        <% if (course.routine && course.routine.length > 0) { %>
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                    <span class="material-symbols-rounded text-cyan-500">calendar_month</span>
                                    Weekly Live Class Routine & Schedule
                                </h3>
                                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 font-bold border-b border-slate-200 dark:border-slate-800">
                                            <tr>
                                                <th class="py-3 px-4">Day</th>
                                                <th class="py-3 px-4">Start Time</th>
                                                <th class="py-3 px-4">End Time</th>
                                                <th class="py-3 px-4">Topic / Note</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                                            <% course.routine.forEach(r => { %>
                                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                                                    <td class="py-3 px-4 font-bold text-slate-900 dark:text-white"><%= r.day || '-' %></td>
                                                    <td class="py-3 px-4"><%= r.startTime || '-' %></td>
                                                    <td class="py-3 px-4"><%= r.endTime || '-' %></td>
                                                    <td class="py-3 px-4 text-slate-500 dark:text-slate-400"><%= r.note || 'Regular Live Class' %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>

                    </div>

                </div>

            </div>

            <% } else { %>
            <!-- ========================================================================= -->
            <!-- MARKETING / CHECKOUT VIEW (For Visitors / Non-Enrolled Users)             -->
            <!-- ========================================================================= -->
            <div class="w-full bg-white dark:bg-[#0b1120] flex flex-col">
                <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 items-start">
                    
                    <!-- Left Marketing Details -->
                    <div class="lg:col-span-8 lg:border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1120] flex flex-col">
                        
                        <!-- Hero Section -->
                        <section class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 p-5 sm:p-7 lg:p-8">
                            <div class="flex flex-col gap-3.5">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                    <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-800 dark:text-slate-100 leading-snug tracking-tight">
                                        <%= course.title || 'Untitled Course' %>
                                    </h1>
                                    <div class="shrink-0">
                                        <% if (course.accessType === 'free' || course.accessType === 'Free') { %>
                                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                                Free Course
                                            </span>
                                        <% } else if (course.accessType === 'trial' || course.accessType === 'Trial') { %>
                                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                                <%= course.trialPeriod || 7 %> Days Trial
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                                                Paid Course
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-2.5 pt-0.5">
                                    <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 text-xs font-bold border border-rose-100 dark:border-rose-900/40">
                                        <%= classBadge %>
                                    </span>
                                    <span class="px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 text-xs font-bold border border-indigo-100 dark:border-indigo-900/40">
                                        <%= subjectBadge %>
                                    </span>
                                    <span class="text-slate-300 dark:text-slate-700">•</span>
                                    <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                                        <span class="material-symbols-rounded text-sm">group</span>
                                        <span><%= locals.enrolledCount || 0 %> Students Enrolled</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Quick Stats -->
                        <section class="p-5 sm:p-7 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a]">
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center gap-3">
                                    <div class="size-9 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-xl">play_circle</span>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= totalVideos %></p>
                                        <p class="text-[11px] text-slate-400">Recorded</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center gap-3">
                                    <div class="size-9 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-xl">live_tv</span>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= totalLives %></p>
                                        <p class="text-[11px] text-slate-400">Live Classes</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center gap-3">
                                    <div class="size-9 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-xl">description</span>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= totalNotes %></p>
                                        <p class="text-[11px] text-slate-400">Lecture Notes</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center gap-3">
                                    <div class="size-9 rounded-lg bg-violet-500/10 text-violet-500 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-xl">quiz</span>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= totalQuizzes %></p>
                                        <p class="text-[11px] text-slate-400">Quizzes</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- About Course -->
                        <section class="p-5 sm:p-7 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a]">
                            <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
                                <span class="material-symbols-rounded text-rose-500 text-2xl">info</span>
                                <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">About This Course</h2>
                            </div>

                            <div class="prose dark:prose-invert max-w-none text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal space-y-3">
                                <% if (course.description && course.description.trim() !== '') { %>
                                    <div><%- course.description %></div>
                                <% } else { %>
                                    <p>Master your curriculum with comprehensive step-by-step lessons, live question-answering support, downloadable lecture notes, and chapter-wise interactive quizzes designed by top educators.</p>
                                <% } %>
                            </div>

                            <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800">
                                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200 mb-3.5 flex items-center gap-2">
                                    <span class="material-symbols-rounded text-emerald-500 text-lg">check_circle</span>
                                    <span>Key Learning Highlights</span>
                                </h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600 dark:text-slate-300">
                                    <% learningHighlights.forEach(hl => { %>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-rounded text-emerald-500 text-base">task_alt</span>
                                            <span><%= hl %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </section>

                        <!-- Syllabus Preview -->
                        <section class="p-5 sm:p-7 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a]">
                            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
                                <div class="flex items-center gap-2.5">
                                    <span class="material-symbols-rounded text-indigo-500 text-2xl">menu_book</span>
                                    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Curriculum & Syllabus</h2>
                                </div>
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                    <%= totalVideos %> Videos • <%= totalNotes %> Notes
                                </span>
                            </div>

                            <div class="space-y-2.5">
                                <% if (syllabusList.length > 0) { %>
                                    <% syllabusList.forEach((chTitle, idx) => { %>
                                        <div class="px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 flex items-center justify-between gap-3">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <span class="size-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 text-xs font-extrabold flex items-center justify-center shrink-0 border border-indigo-100 dark:border-indigo-900/30">
                                                    <%= idx + 1 %>
                                                </span>
                                                <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 truncate"><%= chTitle %></h4>
                                            </div>
                                            <span class="text-[11px] font-semibold text-slate-400 bg-white dark:bg-slate-800 px-2.5 py-1 rounded-md border border-slate-200/80 dark:border-slate-700/80 shrink-0">
                                                Module <%= idx + 1 %>
                                            </span>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="p-8 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-slate-200/80 dark:border-slate-800">
                                        <span class="material-symbols-rounded text-4xl text-slate-300 mb-2">auto_stories</span>
                                        <p class="text-xs font-bold text-slate-500">Comprehensive syllabus being finalized.</p>
                                    </div>
                                <% } %>
                            </div>
                        </section>

                        <!-- Mentors -->
                        <section class="p-5 sm:p-7 bg-white dark:bg-[#0f172a]">
                            <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
                                <span class="material-symbols-rounded text-rose-500 text-2xl">co_present</span>
                                <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Course Faculty & Instructors</h2>
                            </div>

                            <div class="flex flex-col sm:flex-row items-start gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                                <div class="size-14 rounded-full overflow-hidden bg-slate-200 dark:bg-slate-700 shrink-0 border-2 border-white dark:border-slate-600 shadow-sm">
                                    <img src="<%= getImg(course.instructor?.profileImage) || '/images/default-avatar.png' %>" class="w-full h-full object-cover">
                                </div>
                                <div class="space-y-1">
                                    <h3 class="text-base font-bold text-slate-800 dark:text-slate-100"><%= course.instructor?.name || 'ODDHAY Mentor' %></h3>
                                    <p class="text-xs text-rose-500 font-semibold">Lead Instructor</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-normal pt-1">
                                        <%= course.instructor?.bio || 'Dedicated educator and subject matter specialist committed to academic excellence.' %>
                                    </p>
                                </div>
                            </div>
                        </section>

                    </div>

                    <!-- Right Sticky Checkout Box -->
                    <aside class="lg:col-span-4 bg-white dark:bg-[#0f172a] p-5 sm:p-7 lg:p-8 space-y-6 lg:sticky lg:top-0">
                        <div class="w-full aspect-video rounded-xl bg-slate-900 relative overflow-hidden group shadow-md border border-slate-200 dark:border-slate-800">
                            <% if (course.thumbnail) { %>
                                <img src="<%= getImg(course.thumbnail) %>" class="w-full h-full object-cover" alt="<%= course.title %>">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-600">
                                    <span class="material-symbols-rounded text-6xl">school</span>
                                </div>
                            <% } %>
                        </div>

                        <div class="p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 space-y-4">
                            <div class="flex items-baseline justify-between gap-2">
                                <div>
                                    <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                                        <%= getPrice(course) %>
                                    </span>
                                    <% if (getOriginalPrice(course)) { %>
                                        <span class="text-sm font-semibold text-slate-400 line-through ml-2">
                                            <%= getOriginalPrice(course) %>
                                        </span>
                                    <% } %>
                                </div>
                                <% if (course.discountPrice > 0 && course.price > course.discountPrice) { %>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-black bg-rose-50 text-rose-600 border border-rose-200">
                                        SAVE <%= Math.round(((course.price - course.discountPrice) / course.price) * 100) %>%
                                    </span>
                                <% } %>
                            </div>

                            <div class="space-y-2.5 pt-1">
                                <% if (course.accessType === 'free' || course.accessType === 'Free') { %>
                                    <a href="/course-details/<%= course._id %>?play=1" class="w-full py-3.5 px-4 rounded-xl btn-primary-action flex items-center justify-center gap-2 text-sm text-center">
                                        <span class="material-symbols-rounded text-lg">school</span>
                                        <span>Start Learning for Free</span>
                                    </a>
                                <% } else if (course.accessType === 'trial' || course.accessType === 'Trial') { %>
                                    <form action="/enroll-trial/<%= course._id %>" method="POST">
                                        <button type="submit" class="w-full py-3.5 px-4 rounded-xl btn-primary-action flex items-center justify-center gap-2 text-sm text-center cursor-pointer">
                                            <span class="material-symbols-rounded text-lg">bolt</span>
                                            <span>Start <%= course.trialPeriod || 7 %>-Day Free Trial</span>
                                        </button>
                                    </form>
                                    <a href="/checkout/<%= course._id %>" class="w-full py-2.5 px-4 rounded-xl btn-secondary-action flex items-center justify-center gap-1.5 text-xs text-center mt-2">
                                        <span>Buy Full Course</span>
                                    </a>
                                <% } else { %>
                                    <a href="/checkout/<%= course._id %>" class="w-full py-3.5 px-4 rounded-xl btn-primary-action flex items-center justify-center gap-2 text-sm text-center">
                                        <span class="material-symbols-rounded text-lg">how_to_reg</span>
                                        <span>Enroll in Course</span>
                                    </a>
                                <% } %>

                                <button type="button" onclick="shareCourse()" class="w-full py-2.5 px-4 rounded-xl btn-secondary-action flex items-center justify-center gap-1.5 text-xs text-center cursor-pointer">
                                    <span class="material-symbols-rounded text-base">share</span>
                                    <span>Share Course</span>
                                </button>
                            </div>

                            <div class="pt-3 border-t border-slate-200 dark:border-slate-700/80 space-y-2 text-xs text-slate-500 dark:text-slate-400">
                                <% courseBenefits.forEach(benefit => { %>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-emerald-500 text-base">check_circle</span>
                                        <span><%= benefit %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </aside>

                </div>
            </div>
            <% } %>

        </main>
    </div>

    <!-- Toast Notification for Share Link -->
    <div id="shareToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2 border border-slate-800">
        <span class="material-symbols-rounded text-emerald-400 text-base">link</span>
        <span>Course link copied to clipboard!</span>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'courses' }) %>
    <%- include('partials/app-scripts') %>
    <script src="/socket.io/socket.io.js"></script>

    <script>
        <% 
            const isFreeCourse = (course.accessType === 'free' || course.accessType === 'Free');
            const isInstructorOrAdmin = (course && course.instructor && course.instructor._id && locals.user && user._id && course.instructor._id.toString() === user._id.toString()) || (locals.user && ['admin', 'superadmin', 'teacher'].includes(user.role));
            const isPaidEnrolled = Boolean(locals.user && user.enrolledCourses && course && course._id && user.enrolledCourses.some(e => e && e.course && e.course.toString() === course._id.toString() && (!e.expiresAt || new Date(e.expiresAt) > new Date())));
            const userCanDownload = Boolean(isFreeCourse || isPaidEnrolled || isInstructorOrAdmin);
        %>
        window.canDownloadMaterial = <%= userCanDownload ? 'true' : 'false' %>;

        const currentUserId = '<%= locals.user ? user._id : "" %>';
        const currentCourseId = '<%= course._id %>';
        const userRole = '<%= locals.user ? user.role : "student" %>';
        const completedList = <%- JSON.stringify((locals.completedLessons || []).map(id => id.toString())) %>;
        const currentAnnouncementIds = <%- JSON.stringify(((locals.courseAnnouncements && locals.courseAnnouncements.length > 0) ? locals.courseAnnouncements : ((locals.courseNotices && locals.courseNotices.length > 0) ? locals.courseNotices : ((locals.announcements && locals.announcements.length > 0) ? locals.announcements : []))).map(a => String(a._id || a.rawId || a.id || ''))) %>;

        function updateAnnouncementBadge() {
            const badge = document.getElementById('announcementBadge');
            if (!badge) return;

            const validIds = (currentAnnouncementIds || []).filter(Boolean);
            if (validIds.length === 0) {
                badge.classList.add('hidden');
                badge.innerText = '0';
                return;
            }

            const storageKey = 'seen_announcements_' + currentCourseId;
            const rawSeen = localStorage.getItem(storageKey);

            let seenIds = [];
            if (rawSeen) {
                try {
                    seenIds = JSON.parse(rawSeen);
                    if (!Array.isArray(seenIds)) seenIds = [];
                } catch(e) {
                    seenIds = [];
                }
            } else {
                const legacySeenCount = parseInt(localStorage.getItem('announcements_seen_' + currentCourseId) || '-1', 10);
                if (legacySeenCount >= validIds.length) {
                    seenIds = [...validIds];
                    try { localStorage.setItem(storageKey, JSON.stringify(seenIds)); } catch(e) {}
                }
            }

            // Only count announcements that the student hasn't seen yet
            const newCount = validIds.filter(id => !seenIds.includes(String(id))).length;

            if (newCount > 0) {
                badge.innerText = newCount.toString();
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                badge.innerText = '0';
            }
        }

        // Real-Time Live Announcements via Socket.IO
        let courseSocket = null;
        try {
            if (typeof io !== 'undefined') {
                courseSocket = window.socket || io();
                window.socket = courseSocket;

                courseSocket.emit('course:join', currentCourseId);

                // Live New Announcement Event
                courseSocket.on('course:announcement_new', (ann) => {
                    if (!ann || String(ann.courseId) !== String(currentCourseId)) return;
                    handleLiveIncomingAnnouncement(ann);
                });

                // Live Deleted Announcement Event
                courseSocket.on('course:announcement_deleted', (payload) => {
                    if (!payload || String(payload.courseId) !== String(currentCourseId)) return;
                    handleLiveDeletedAnnouncement(payload.announcementId);
                });
            }
        } catch(err) {
            console.warn('Socket setup notice:', err);
        }

        function handleLiveIncomingAnnouncement(ann) {
            if (!ann) return;
            const annId = String(ann._id);
            if (document.getElementById('ann-card-' + annId)) return;

            if (!currentAnnouncementIds.includes(annId)) {
                currentAnnouncementIds.unshift(annId);
            }

            const emptyState = document.getElementById('annEmptyState');
            if (emptyState) emptyState.remove();

            const container = document.getElementById('courseAnnouncementsContainer');
            if (!container) return;

            const paneAnnouncement = document.getElementById('pane-announcement');
            const isCurrentlyViewingAnnouncements = paneAnnouncement && !paneAnnouncement.classList.contains('hidden');

            const authorName = escapeHTML(ann.author?.name || 'Course Instructor');
            const authorRole = ann.author?.role === 'admin' ? 'Admin' : 'Instructor';
            const authorImg = getImg(ann.author?.profileImage || ann.author?.profilePicture) || '/images/default-avatar.png';
            const annTitle = escapeHTML(ann.title || '');
            const annContent = escapeHTML(ann.content || '');
            const isHigh = !!ann.isHighPriority;
            const timeAgo = ann.timeAgo || 'Just now';
            const formattedDate = ann.formattedDate || new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });

            const isInstructorOrAdmin = (userRole === 'admin' || userRole === 'superadmin' || userRole === 'teacher');

            const card = document.createElement('div');
            card.id = 'ann-card-' + annId;
            card.className = `p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#111827] border ${isHigh ? 'border-rose-200 dark:border-rose-900/40' : 'border-slate-200 dark:border-slate-800'} shadow-xs space-y-2.5 relative overflow-hidden transition-all duration-300 opacity-0 transform -translate-y-2`;

            card.innerHTML = `
                ${isHigh ? `
                    <div class="absolute top-0 right-0 bg-rose-500 text-white text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-bl-lg shadow-xs">
                        Important
                    </div>
                ` : ''}

                <div class="flex items-start justify-between gap-3 pr-16">
                    <div class="flex items-center gap-3">
                        <div class="size-9 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700 shrink-0 bg-slate-100 dark:bg-slate-800">
                            <img src="${authorImg}" class="size-full object-cover" alt="Author">
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h5 class="text-xs font-bold text-slate-900 dark:text-slate-100">${authorName}</h5>
                                <span class="px-1.5 py-0.5 text-[9px] font-bold rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
                                    ${authorRole}
                                </span>
                            </div>
                            <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-0.5">
                                <span class="flex items-center gap-0.5">
                                    <span class="material-symbols-rounded text-[12px]">schedule</span>
                                    ${timeAgo}
                                </span>
                                <span>•</span>
                                <span>${formattedDate}</span>
                            </div>
                        </div>
                    </div>

                    ${isInstructorOrAdmin ? `
                        <button type="button" onclick="deleteCourseAnnouncement('${annId}')" class="text-slate-400 hover:text-rose-500 p-1 rounded-lg transition-colors" title="Delete Announcement">
                            <span class="material-symbols-rounded text-base">delete</span>
                        </button>
                    ` : ''}
                </div>

                <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                    ${annTitle}
                </h4>

                <div class="text-xs sm:text-[13px] text-slate-700 dark:text-slate-300 leading-relaxed font-normal whitespace-pre-line bg-slate-50/60 dark:bg-slate-900/40 p-3.5 sm:p-4 rounded-xl border border-slate-100 dark:border-slate-800/60">
                    ${annContent}
                </div>
            `;

            container.insertBefore(card, container.firstChild);

            requestAnimationFrame(() => {
                card.classList.remove('opacity-0', '-translate-y-2');
            });

            if (isCurrentlyViewingAnnouncements) {
                try {
                    const validIds = (currentAnnouncementIds || []).filter(Boolean);
                    localStorage.setItem('seen_announcements_' + currentCourseId, JSON.stringify(validIds));
                    localStorage.setItem('announcements_seen_' + currentCourseId, validIds.length.toString());
                } catch(e) {}
                const badge = document.getElementById('announcementBadge');
                if (badge) badge.classList.add('hidden');
            } else {
                updateAnnouncementBadge();
            }
        }

        function handleLiveDeletedAnnouncement(annId) {
            const card = document.getElementById('ann-card-' + annId);
            if (card) {
                card.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    card.remove();
                    const container = document.getElementById('courseAnnouncementsContainer');
                    if (container && container.children.length === 0) {
                        container.innerHTML = `
                            <div id="annEmptyState" class="py-10 text-center border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-[#111827]">
                                <p class="text-xs font-medium text-slate-400">No announcements published yet</p>
                            </div>
                        `;
                    }
                }, 300);
            }

            const idx = currentAnnouncementIds.indexOf(String(annId));
            if (idx > -1) {
                currentAnnouncementIds.splice(idx, 1);
            }
            updateAnnouncementBadge();
        }
        
        // Load curriculum nodes & chapters
        let rawCurriculumNodes = <%- JSON.stringify(course.curriculumNodes || []) %>;
        let rawChapters = <%- JSON.stringify(course.chapters || []) %>;
        let curriculumNodes = [...rawCurriculumNodes];

        // If curriculumNodes is empty but legacy chapters exist, normalize them into the tree
        if ((!curriculumNodes || curriculumNodes.length === 0) && rawChapters && rawChapters.length > 0) {
            curriculumNodes = [];
            rawChapters.forEach((ch, chIdx) => {
                const folderId = ch._id || ('ch-' + chIdx);
                curriculumNodes.push({
                    _id: folderId,
                    name: ch.title || ('Chapter ' + (chIdx + 1)),
                    type: 'folder',
                    parentId: null
                });
                (ch.recordedClasses || []).forEach((rc, rIdx) => {
                    curriculumNodes.push({
                        _id: rc._id || (folderId + '-v-' + rIdx),
                        name: rc.title || ('Video Lesson ' + (rIdx + 1)),
                        type: 'video',
                        videoPath: rc.videoPath || rc.url,
                        duration: rc.duration,
                        description: rc.description,
                        parentId: folderId
                    });
                });
                (ch.notes || []).forEach((nt, nIdx) => {
                    curriculumNodes.push({
                        _id: nt._id || (folderId + '-n-' + nIdx),
                        name: nt.title || ('Lecture Note ' + (nIdx + 1)),
                        type: 'note',
                        filePath: nt.filePath || nt.url,
                        parentId: folderId
                    });
                });
                (ch.liveClasses || []).forEach((lc, lIdx) => {
                    curriculumNodes.push({
                        _id: lc._id || (folderId + '-l-' + lIdx),
                        name: lc.title || 'Live Session',
                        type: 'liveClass',
                        meetingUrl: lc.meetingUrl || lc._id,
                        date: lc.date,
                        parentId: folderId
                    });
                });
                (ch.quizzes || []).forEach((qz, qIdx) => {
                    curriculumNodes.push({
                        _id: qz._id || (folderId + '-q-' + qIdx),
                        name: qz.title || 'Chapter Quiz',
                        type: 'quiz',
                        quizId: qz._id || qz,
                        parentId: folderId
                    });
                });
            });
        }

        let currentFolderId = null;

        // Custom back button handler: if a video is playing, flush progress before navigating back
        window.onBeforeHeaderNavBack = function(proceed) {
            try {
                if (typeof window.syncCurrentPlaybackProgress === 'function') {
                    window.syncCurrentPlaybackProgress(true);
                }
            } catch(e) {}

            const searchParams = new URLSearchParams(window.location.search);
            const fromSource = searchParams.get('from');

            // If the user arrived from dashboard (e.g. "Resume Lesson" or "Continue Watching")
            // or was directed directly to a lesson via query params, back should return them to origin!
            if (fromSource === 'dashboard') {
                return false; // Allows executeCoreBackNavigation to navigate immediately to /dashboard
            }

            // If user opened a video while browsing curriculum on this page, first back closes player
            if (activePlayingNodeId) {
                closeVideoPlayer();
                return true; // Handled by closing player and restoring curriculum tree
            }

            // If user is drilled into a curriculum folder, back goes up one folder
            if (currentFolderId) {
                const curr = curriculumNodes.find(n => String(n._id) === String(currentFolderId));
                openFolder(curr ? (curr.parentId || null) : null);
                return true;
            }

            return false;
        };

        function getImg(path) {
            if(!path) return '';
            if(path.startsWith('http')) return path;
            let normalized = path.replace(/\\/g, '/');
            if (!normalized.startsWith('/')) normalized = '/' + normalized;
            return normalized;
        }

        // Tab Switching
        function switchTab(tabId, skipHash = false) {
            if (tabId === 'notice' || tabId === 'notices' || tabId === 'announcements') tabId = 'announcement';
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            const btn = document.getElementById(`tab-${tabId}`) || document.getElementById('tab-announcement');
            if (btn) btn.classList.add('active');
            
            document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.add('hidden'));
            const pane = document.getElementById(`pane-${tabId}`) || document.getElementById('pane-announcement');
            if (pane) pane.classList.remove('hidden');
            
            if (tabId === 'announcement') {
                const badge = document.getElementById('announcementBadge');
                if (badge) {
                    badge.classList.add('hidden');
                    badge.innerText = '0';
                }
                try {
                    const validIds = (currentAnnouncementIds || []).filter(Boolean);
                    localStorage.setItem('seen_announcements_' + currentCourseId, JSON.stringify(validIds));
                    localStorage.setItem('announcements_seen_' + currentCourseId, validIds.length.toString());
                } catch(e) {}
            }

            if (!skipHash) {
                window.location.hash = tabId;
            }
        }

        // Folder drill-down navigation
        function openFolder(folderId) {
            if (activePlayingNodeId) {
                closeVideoPlayer();
            }
            currentFolderId = folderId ? folderId.toString() : null;
            const tree = document.getElementById('curriculum-tree-container');
            const panel = document.getElementById('videoPlayerPanel');
            if (tree) tree.classList.remove('hidden');
            if (panel) panel.classList.add('hidden');
            

            if (currentFolderId) {
                window.location.hash = 'folder-' + currentFolderId;
            } else {
                history.replaceState("", document.title, window.location.pathname + window.location.search);
            }
            renderCurriculumTree();
        }

        function getRecursiveChildNodeIds(nodes, parentId) {
            const children = nodes.filter(n => String(n.parentId || '') === String(parentId));
            let ids = children.map(c => c._id.toString());
            children.forEach(c => {
                ids = ids.concat(getRecursiveChildNodeIds(nodes, c._id.toString()));
            });
            return ids;
        }

        // Render Curriculum Tree Explorer
        function renderCurriculumTree() {
            const container = document.getElementById('curriculum-tree-container');
            if (!container) return;

            const items = curriculumNodes.filter(n => {
                if (currentFolderId) {
                    return String(n.parentId || '') === String(currentFolderId);
                } else {
                    return !n.parentId || n.parentId === 'null' || n.parentId === '' || n.parentId === 'undefined';
                }
            });

            let html = '';
            const currentFolder = currentFolderId ? curriculumNodes.find(n => String(n._id) === String(currentFolderId)) : null;
            const parentId = currentFolder ? (currentFolder.parentId || null) : null;

            // Build full breadcrumb trail
            let breadcrumbs = [];
            let curr = currentFolder;
            while (curr) {
                breadcrumbs.unshift(curr);
                curr = curr.parentId ? curriculumNodes.find(n => String(n._id) === String(curr.parentId)) : null;
            }

            // Header bar / Breadcrumb
            if (currentFolderId) {
                html += `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-4 gap-2">
                        <div class="flex items-center gap-2 flex-wrap min-w-0">
                            <button type="button" onclick="openFolder('${parentId || ''}')" class="p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-all text-slate-600 dark:text-slate-300 flex items-center justify-center border border-slate-200 dark:border-slate-700 cursor-pointer shrink-0" title="Go Back">
                                <span class="material-symbols-rounded text-base">arrow_back</span>
                            </button>
                            <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 overflow-x-auto no-scrollbar py-0.5">
                                ${breadcrumbs.map((b, idx) => {
                                    const isLast = idx === breadcrumbs.length - 1;
                                    const divider = idx > 0 ? `<span class="text-slate-300 dark:text-slate-700 shrink-0">/</span>` : '';
                                    if (isLast) {
                                        return `
                                            ${divider}
                                            <span class="font-bold text-slate-900 dark:text-white flex items-center gap-1 shrink-0">
                                                <span class="material-symbols-rounded text-amber-500 text-sm">folder_open</span>
                                                ${b.name}
                                            </span>
                                        `;
                                    } else {
                                        return `
                                            ${divider}
                                            <button type="button" onclick="openFolder('${b._id}')" class="hover:text-emerald-600 dark:hover:text-emerald-400 font-medium transition-colors shrink-0">
                                                ${b.name}
                                            </button>
                                        `;
                                    }
                                }).join('')}
                            </nav>
                        </div>
                        <span class="text-xs font-semibold text-slate-400 shrink-0 self-end sm:self-center">${items.length} Items</span>
                    </div>
                `;
            } else {
                const totalItemsCount = curriculumNodes.filter(n => n.type !== 'folder').length;
                html += `
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-4">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500">folder_special</span>
                            Course Modules & Materials
                        </h3>
                        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                            ${totalItemsCount} Total Learning Items
                        </span>
                    </div>
                `;
            }

            if (items.length === 0) {
                html += `
                    <div class="py-16 text-center">
                        <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-2">folder_open</span>
                        <p class="text-xs font-bold text-slate-400">This folder is empty</p>
                    </div>
                `;
            } else {
                // Sort folders first, then items
                items.sort((a, b) => {
                    if (a.type === 'folder' && b.type !== 'folder') return -1;
                    if (a.type !== 'folder' && b.type === 'folder') return 1;
                    if (a.order !== undefined && b.order !== undefined && a.order !== b.order) return a.order - b.order;
                    return 0;
                });

                html += `<div class="divide-y divide-slate-200/80 dark:divide-slate-800/80">`;

                items.forEach((node) => {
                    const isFolder = node.type === 'folder';
                    const isDone = completedList.includes(node._id ? node._id.toString() : '');
                    let icon = 'folder';
                    let typeLabel = 'Folder';
                    let detailHtml = '';
                    let rightIconHtml = '';

                    if (isFolder) {
                        const childIds = getRecursiveChildNodeIds(curriculumNodes, node._id.toString());
                        const fileCount = curriculumNodes.filter(n => childIds.includes(n._id.toString()) && n.type !== 'folder').length;
                        typeLabel = fileCount > 0 ? `${fileCount} Files` : 'Folder';
                        rightIconHtml = `
                            <span class="material-symbols-rounded text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 text-xl transition-transform group-hover:translate-x-0.5">
                                chevron_right
                            </span>
                        `;
                    } else if (node.type === 'video') {
                        icon = 'play_circle';
                        typeLabel = 'Video Class';
                        detailHtml = node.duration ? node.duration : '';
                        if (isDone) {
                            rightIconHtml = `<span class="material-symbols-rounded text-emerald-500 text-lg" title="Completed">check_circle</span>`;
                        }
                    } else if (node.type === 'note') {
                        const docPath = node.filePath || node.url || node.file || node.path || node.fileUrl || '';
                        const ext = (docPath.split('.').pop() || '').toLowerCase();
                        const isPdf = ext === 'pdf';
                        const isImg = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg'].includes(ext);

                        icon = 'description';
                        typeLabel = 'Note';
                    } else if (node.type === 'liveClass') {
                        const isEnded = node.videoPath || node.isRecorded;
                        if (isEnded) {
                            icon = 'smart_display';
                            typeLabel = 'Recorded Class';
                            detailHtml = node.duration ? node.duration : '';
                            if (isDone) {
                                rightIconHtml = `<span class="material-symbols-rounded text-emerald-500 text-lg" title="Completed">check_circle</span>`;
                            }
                        } else {
                            icon = 'live_tv';
                            typeLabel = 'Live Class';
                            if (node.date) {
                                detailHtml = new Date(node.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            }
                            rightIconHtml = `
                                <span class="flex items-center gap-1.5 text-xs text-rose-500 font-bold px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-950/40">
                                    <span class="size-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                                    <span>Live</span>
                                </span>
                            `;
                        }
                    } else if (node.type === 'quiz') {
                        icon = 'quiz';
                        typeLabel = 'Quiz Exam';
                    }

                    const iconColor = isFolder ? 'text-amber-500' : (node.type === 'video' ? (isDone ? 'text-emerald-500' : 'text-blue-500') : (node.type === 'note' ? 'text-amber-500' : (node.type === 'liveClass' ? (node.videoPath || node.isRecorded ? 'text-indigo-500' : 'text-rose-500') : 'text-violet-500')));

                    const isVideo = node.type === 'video' || (node.type === 'liveClass' && (node.videoPath || node.isRecorded));

                    html += `
                        <div onclick="handleNodeItemClick('${node._id}')" class="px-2.5 sm:px-3 py-3 flex items-center justify-between gap-4 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 rounded-xl transition-all cursor-pointer group select-none">
                            <div class="flex items-center gap-3.5 min-w-0 flex-1">
                                <span class="material-symbols-rounded text-[24px] shrink-0 ${iconColor}">${icon}</span>
                                <div class="flex items-center gap-2 min-w-0 flex-1 flex-wrap">
                                    <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors truncate leading-tight">
                                        ${node.name || node.title || 'Untitled Item'}
                                    </h4>
                                    
                                    ${(isVideo && isDone) ? `<span class="material-symbols-rounded text-emerald-500 text-base shrink-0 select-none" title="Completed">check_circle</span>` : ''}

                                    ${detailHtml ? `<span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 font-mono px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">${detailHtml}</span>` : ''}
                                </div>
                            </div>
                            <div class="flex items-center gap-2.5 shrink-0">
                                <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 whitespace-nowrap">
                                    ${typeLabel}
                                </span>
                                ${isFolder ? `<span class="material-symbols-rounded text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 text-xl transition-transform group-hover:translate-x-0.5">chevron_right</span>` : ''}
                            </div>
                        </div>
                    `;
                });

                html += `</div>`;
            }

            container.innerHTML = html;
        }

        // Global Node Item Click Dispatcher
        function handleNodeItemClick(nodeId) {
            const node = curriculumNodes.find(n => String(n._id) === String(nodeId));
            if (!node) {
                console.error('Node not found for id:', nodeId);
                return;
            }

            if (node.type === 'folder') {
                openFolder(node._id);
                return;
            }

            if (node.type === 'video' || (node.type === 'liveClass' && (node.videoPath || node.isRecorded))) {
                playVideoNode(node, false, true);
                return;
            }

            if (node.type === 'note') {
                const docPath = node.filePath || node.url || node.file || node.path || node.fileUrl;
                if (docPath) {
                    const fullUrl = getImg(docPath);
                    const ext = (docPath.split('.').pop() || '').toLowerCase().split('?')[0];
                    const isImg = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'avif'].includes(ext);

                    if (isImg && typeof openImageViewer === 'function') {
                        // Gather sibling image notes in course for gallery view
                        const siblingImages = curriculumNodes.filter(n => {
                            if (n.type !== 'note') return false;
                            const p = n.filePath || n.url || n.file || n.path || n.fileUrl;
                            if (!p) return false;
                            const e = (p.split('.').pop() || '').toLowerCase().split('?')[0];
                            return ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'avif'].includes(e);
                        }).map(n => ({
                            url: getImg(n.filePath || n.url || n.file || n.path || n.fileUrl),
                            title: n.name || n.title || 'Image Note'
                        }));

                        openImageViewer(fullUrl, node.name || node.title || 'Image Note', siblingImages);
                        return;
                    }

                    // In-app PDF Viewer (Never opens in a different tab)
                    if (typeof openPdfViewer === 'function') {
                        openPdfViewer(fullUrl, node.name || node.title || 'PDF Note');
                        return;
                    }

                    if (window.canDownloadMaterial) {
                        window.open(fullUrl, '_blank', 'noopener,noreferrer');
                    } else {
                        window.open(fullUrl + '#toolbar=0', '_blank', 'noopener,noreferrer');
                    }
                } else {
                    alert('No document file attached to this note.');
                }
                return;
            }

            if (node.type === 'liveClass') {
                const meetingUrl = node.meetingUrl || node.url || node._id;
                window.location.href = '/live/' + meetingUrl;
                return;
            }

            if (node.type === 'quiz') {
                const qId = (node.quizId && node.quizId._id) ? node.quizId._id : (node.quizId || node._id);
                window.location.href = '/quiz/' + qId + '?courseId=' + currentCourseId + '&from=course';
                return;
            }
        }

        // Video Player Logic
        let activePlayingNodeId = null;
        let commentsSkip = 0;
        const commentsLimit = 10;
        let commentsHasMore = false;
        let loadedCommentsArray = [];
        const openCommentReplies = new Set();
        const courseInstructorName = `<%= (course.instructor && course.instructor.name) ? course.instructor.name.replace(/'/g, "\\'") : 'ODDHAY Mentor' %>`;
        const courseInstructorAvatar = `<%= getImg(course.instructor?.profileImage || course.instructor?.profilePicture) || '/images/default-avatar.png' %>`;

        function playVideoNode(node, skipHash = false, incrementView = false, customStartTime = 0) {
            try {
                if (typeof node === 'string') {
                    const targetId = String(node);
                    let found = curriculumNodes.find(n => String(n._id) === targetId);
                    if (!found) {
                        found = curriculumNodes.find(n => n.type === 'video' && (n.videoPath || n.url)) ||
                                curriculumNodes.find(n => n.videoPath || n.url);
                    }
                    node = found;
                    if (!node) return;
                }

                const panel = document.getElementById('videoPlayerPanel');
                const tree = document.getElementById('curriculum-tree-container');
                const videoEl = document.getElementById('playerVideoEl');
                const iframeEl = document.getElementById('playerIframeEl');
                const emptyState = document.getElementById('playerEmptyState');
                
                if (!panel) return;
                panel.classList.remove('hidden');
                if (tree) tree.classList.add('hidden');

                const url = node.videoPath || node.url || node.videoUrl || node.filePath;
                const title = node.name || node.title;
                const description = node.description || '';
                const nodeId = node._id;

                if (!url) {
                    if (node.type === 'note' && (node.filePath || node.url)) {
                        const docPath = node.filePath || node.url;
                        const fullUrl = getImg(docPath);
                        const ext = (docPath.split('.').pop() || '').toLowerCase().split('?')[0];
                        const isImg = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'avif'].includes(ext);
                        if (isImg && typeof openImageViewer === 'function') {
                            openImageViewer(fullUrl, node.name || node.title || 'Image Note');
                            return;
                        }
                        if (typeof openPdfViewer === 'function') {
                            openPdfViewer(fullUrl, node.name || node.title || 'PDF Note');
                            return;
                        }
                        return;
                    } else if (node.type === 'quiz') {
                        const qId = (node.quizId && node.quizId._id) ? node.quizId._id : (node.quizId || node._id);
                        window.location.href = '/quiz/' + qId + '?courseId=' + currentCourseId + '&from=course';
                        return;
                    } else if (node.type === 'liveClass') {
                        window.location.href = '/live/' + (node.meetingUrl || node._id);
                        return;
                    }
                    alert('This lesson does not have a video attached.');
                    return;
                }

                activePlayingNodeId = nodeId;

                // Hide tabs navigation bar when playing video
                const tabsNavBar = document.getElementById('tabs-nav-bar');
                if (tabsNavBar) tabsNavBar.classList.add('hidden');

                // Update Navbar Header Title with Video Title (Max 5 words, ellipsis if more)
                const headerTitleEl = document.getElementById('headerPageTitle');
                if (headerTitleEl) {
                    if (!headerTitleEl.dataset.originalTitle) {
                        headerTitleEl.dataset.originalTitle = headerTitleEl.innerText.trim();
                    }
                    const words = (title || 'Lesson Video').trim().split(/\s+/);
                    const shortNavTitle = words.length > 5 ? words.slice(0, 5).join(' ') + '...' : (title || 'Lesson Video');
                    headerTitleEl.innerText = shortNavTitle;
                    headerTitleEl.title = title || '';
                }

                // Extract Author Info
                let authorName = courseInstructorName;
                let authorAvatar = courseInstructorAvatar;
                if (node.addedBy) {
                    authorName = node.addedBy.name || authorName;
                    authorAvatar = getImg(node.addedBy.profileImage || node.addedBy.profilePicture) || authorAvatar;
                }

                // Reset elements
                if (videoEl) {
                    videoEl.onerror = null;
                    videoEl.classList.add('hidden');
                    videoEl.src = '';
                }
                if (iframeEl) {
                    iframeEl.classList.add('hidden');
                    iframeEl.src = '';
                }
                if (emptyState) emptyState.classList.add('hidden');

                // Check URL type (YouTube, Vimeo, MP4/WebM)
                if (url.includes('youtube.com') || url.includes('youtu.be')) {
                    let embedUrl = url;
                    if (url.includes('watch?v=')) {
                        embedUrl = 'https://www.youtube.com/embed/' + url.split('v=')[1].split('&')[0] + '?autoplay=1';
                    } else if (url.includes('youtu.be/')) {
                        embedUrl = 'https://www.youtube.com/embed/' + url.split('youtu.be/')[1].split('?')[0] + '?autoplay=1';
                    }
                    if (iframeEl) {
                        iframeEl.src = embedUrl;
                        iframeEl.classList.remove('hidden');
                    }
                } else if (url.includes('vimeo.com')) {
                    const videoId = url.split('vimeo.com/')[1].split('?')[0];
                    if (iframeEl) {
                        iframeEl.src = 'https://player.vimeo.com/video/' + videoId + '?autoplay=1';
                        iframeEl.classList.remove('hidden');
                    }
                } else {
                    if (videoEl) {
                        videoEl.src = getImg(url);
                        videoEl.classList.remove('hidden');
                        
                        const savedSpeed = parseFloat(localStorage.getItem('video-speed') || '1.0');
                        videoEl.playbackRate = savedSpeed;
                        const speedSelect = document.getElementById('videoSpeedSelect');
                        if (speedSelect) speedSelect.value = savedSpeed.toString();

                        videoEl.onerror = function() {
                            // Log error silently without disruptive alert popups on unload
                            if (videoEl.getAttribute('src')) {
                                console.warn('Video format or source load error:', videoEl.src);
                            }
                        };

                        videoEl.load();

                        // Resume watch progress with multi-stage seeking guarantee
                        const savedProgress = localStorage.getItem(`video-progress-${currentUserId}-${nodeId}`);
                        const resumeTime = customStartTime > 0 ? customStartTime : (savedProgress ? parseFloat(savedProgress) : 0);
                        let hasResumedPlayback = (resumeTime <= 0);
                        window.__currentVideoTargetResume = resumeTime;
                        window.__currentVideoHasResumed = hasResumedPlayback;

                        if (resumeTime > 0) {
                            const applyResume = function() {
                                if (hasResumedPlayback) return;
                                if (!videoEl.duration || resumeTime < videoEl.duration - 2) {
                                    try {
                                        videoEl.currentTime = resumeTime;
                                    } catch(e) {}
                                }
                                if (Math.abs(videoEl.currentTime - resumeTime) <= 1 || videoEl.currentTime >= resumeTime) {
                                    hasResumedPlayback = true;
                                    window.__currentVideoHasResumed = true;
                                }
                            };

                            if (videoEl.readyState >= 1) {
                                applyResume();
                            }
                            videoEl.addEventListener('loadedmetadata', applyResume);
                            videoEl.addEventListener('canplay', applyResume);
                            videoEl.addEventListener('playing', function onPlayingSeek() {
                                if (!hasResumedPlayback && resumeTime > 0) {
                                    applyResume();
                                    setTimeout(() => {
                                        if (videoEl.currentTime < 1 && resumeTime > 1) {
                                            try { videoEl.currentTime = resumeTime; } catch(e) {}
                                        }
                                        hasResumedPlayback = true;
                                        window.__currentVideoHasResumed = true;
                                    }, 150);
                                }
                            });
                        }

                        // Track watch progress and auto-mark complete
                        videoEl.ontimeupdate = function() {
                            if (!videoEl.duration || videoEl.duration <= 0) return;
                            // Safeguard: do not overwrite progress while seeking to resume timestamp
                            if (!hasResumedPlayback && resumeTime > 1 && videoEl.currentTime < 1) return;

                            localStorage.setItem(`video-progress-${currentUserId}-${nodeId}`, videoEl.currentTime.toString());

                            const remaining = videoEl.duration - videoEl.currentTime;
                            // Complete when full video watched OR remaining < 2 mins for 30m+ video OR watched >= 92% (for >=5m videos, remaining <= 25s)
                            const isAutoCompleted = (videoEl.duration >= 1800 && remaining <= 120) ||
                                                   (videoEl.duration >= 300 && remaining <= 25) ||
                                                   (videoEl.duration > 0 && (videoEl.currentTime / videoEl.duration) >= 0.92);

                            if (isAutoCompleted && !completedList.includes(nodeId.toString())) {
                                autoMarkLessonComplete(nodeId, title);
                            }
                        };

                        videoEl.onended = function() {
                            if (!completedList.includes(nodeId.toString())) {
                                autoMarkLessonComplete(nodeId, title);
                            }
                        };

                        const playPromise = videoEl.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(e => {
                                if (e.name !== 'AbortError') {
                                    console.log('Autoplay blocked, attempting muted autoplay:', e);
                                    videoEl.muted = true;
                                    videoEl.play().catch(console.error);
                                }
                            });
                        }
                    }
                }

                // Populate Metadata
                const titleEl = document.getElementById('playerVideoTitle');
                if (titleEl) titleEl.innerText = title || 'Untitled Lesson';
                
                const descEl = document.getElementById('playerVideoDesc');
                const descToggleBtn = document.getElementById('descToggleBtn');
                if (descEl) {
                    descEl.innerText = description || 'No detailed description available for this video lesson.';
                    descEl.classList.add('line-clamp-2');
                    if (descToggleBtn) {
                        descToggleBtn.innerText = 'Details';
                        setTimeout(() => {
                            if (descEl.scrollHeight > descEl.clientHeight || description.length > 140) {
                                descToggleBtn.classList.remove('hidden');
                            } else {
                                descToggleBtn.classList.add('hidden');
                            }
                        }, 50);
                    }
                }

                const viewsEl = document.getElementById('playerVideoViews');
                if (viewsEl) viewsEl.innerText = formatCount(node.views || 0);

                const authorNameEl = document.getElementById('playerAuthorName');
                if (authorNameEl) authorNameEl.innerText = authorName;

                const authorAvatarEl = document.getElementById('playerAuthorAvatar');
                if (authorAvatarEl) authorAvatarEl.src = authorAvatar;

                // Check completion status
                updateCompletionBtnUI();

                // Increment views if requested
                if (incrementView) {
                    incrementNodeView(nodeId);
                }

                // Load Playlist & Comments
                renderCoursePlaylist();
                loadNodeComments(nodeId);

                if (!skipHash && nodeId) {
                    window.location.hash = 'video-' + nodeId;
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });

            } catch (err) {
                console.error('Error playing video:', err);
            }
        }

        async function incrementNodeView(nodeId) {
            try {
                const res = await fetch(`/api/curriculum/node/${nodeId}/view`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    const viewsEl = document.getElementById('playerVideoViews');
                    if (viewsEl) viewsEl.innerText = formatCount(data.views);
                    const cachedNode = curriculumNodes.find(n => String(n._id) === String(nodeId));
                    if (cachedNode) cachedNode.views = data.views;
                }
            } catch (err) {
                console.error('Error incrementing views:', err);
            }
        }

        function closeVideoPlayer() {
            try {
                if (typeof window.syncCurrentPlaybackProgress === 'function') {
                    window.syncCurrentPlaybackProgress(true);
                }
            } catch(e) {}

            const panel = document.getElementById('videoPlayerPanel');
            const tree = document.getElementById('curriculum-tree-container');
            const videoEl = document.getElementById('playerVideoEl');
            const iframeEl = document.getElementById('playerIframeEl');
            
            if (videoEl) {
                videoEl.onerror = null;
                videoEl.ontimeupdate = null;
                videoEl.onended = null;
                videoEl.pause();
                videoEl.removeAttribute('src');
                videoEl.load();
            }
            if (iframeEl) {
                iframeEl.src = '';
            }

            if (panel) panel.classList.add('hidden');
            if (tree) tree.classList.remove('hidden');
            activePlayingNodeId = null;

            // Restore Tabs Navigation Bar
            const tabsNavBar = document.getElementById('tabs-nav-bar');
            if (tabsNavBar) tabsNavBar.classList.remove('hidden');

            // Restore Navbar Header Title
            const headerTitleEl = document.getElementById('headerPageTitle');
            if (headerTitleEl && headerTitleEl.dataset.originalTitle) {
                headerTitleEl.innerText = headerTitleEl.dataset.originalTitle;
                headerTitleEl.removeAttribute('title');
            }

            if (currentFolderId) {
                window.location.hash = 'folder-' + currentFolderId;
            } else {
