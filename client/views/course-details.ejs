        function renderExpandableText(text, id) {
            const escaped = escapeHTML(text);
            if (text.length <= 220) {
                return `<p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed whitespace-pre-wrap">${escaped}</p>`;
            }
            const shortText = escapeHTML(text.substring(0, 220));
            return `
                <div id="text-container-${id}" class="mt-1">
                    <p id="text-short-${id}" class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${shortText}... <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-emerald-600 font-bold hover:underline inline ml-1">Read more</button></p>
                    <p id="text-full-${id}" class="hidden text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${escaped} <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-emerald-600 font-bold hover:underline inline ml-1">Read less</button></p>
