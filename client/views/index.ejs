<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>অধ্যায় (ODDHAY) — শেখার নতুন অধ্যায়</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #18a957;
            --primary-dark: #138745;
        }

        body {
            font-family: 'Hind Siliguri', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8faff;
            color: #1e293b;
            transition: background-color 0.3s ease, color 0.3s ease;
            -webkit-font-smoothing: antialiased;
        }

        /* 
         * Rich, inspirational background reflecting intellect, youthful energy, 
         * education, resilience, and the story to success.
         */
        .dark body {
            background-color: #091122;
            color: #e2e8f0;
        }

        /* Luminous ambient education & youth aura mesh */
        .academic-aura-bg {
            background: 
                radial-gradient(ellipse 60% 45% at 50% -10%, rgba(24, 169, 87, 0.12), transparent 70%),
                radial-gradient(ellipse 40% 35% at 15% 25%, rgba(19, 127, 236, 0.10), transparent 60%),
                radial-gradient(ellipse 35% 30% at 85% 35%, rgba(245, 158, 11, 0.08), transparent 60%);
        }

        .dark .academic-aura-bg {
            background: 
                radial-gradient(ellipse 65% 50% at 50% -10%, rgba(20, 100, 220, 0.28), transparent 70%),
                radial-gradient(ellipse 45% 40% at 10% 30%, rgba(124, 58, 237, 0.18), transparent 65%),
                radial-gradient(ellipse 40% 35% at 90% 40%, rgba(24, 169, 87, 0.15), transparent 60%),
                radial-gradient(ellipse 55% 45% at 50% 85%, rgba(16, 185, 129, 0.10), transparent 70%);
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .feature-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-2px);
        }

        /* Soft subtle dot constellation for thought & structure */
        .constellation-dots {
            background-image: radial-gradient(rgba(24, 169, 87, 0.12) 1px, transparent 1px);
            background-size: 26px 26px;
        }
        .dark .constellation-dots {
            background-image: radial-gradient(rgba(52, 211, 153, 0.08) 1px, transparent 1px);
        }

        /* Prevent double expand icon on selects in all browsers */
        select.appearance-none {
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            background-image: none !important;
        }
        select.appearance-none::-ms-expand {
            display: none !important;
        }

        /* Highlighted brand word gradient */
        .brand-gradient-word {
            background: linear-gradient(135deg, #18a957 0%, #10b981 45%, #06b6d4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col academic-aura-bg selection:bg-[#18a957]/20 selection:text-[#18a957]">

    <!-- 1. Sleek Navigation Bar with Class Filter Beside Options -->
    <header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#091122]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
            
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 shrink-0 select-none group">
                <div class="size-9 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                    <span class="material-symbols-rounded text-[20px] pointer-events-none">menu_book</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-semibold text-lg sm:text-xl tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                    <span class="text-[9px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
                </div>
            </a>

            <!-- Desktop Middle: Nav Links + Class Filter Beside Options -->
            <div class="hidden md:flex items-center gap-2 lg:gap-3">
                <nav class="flex items-center gap-1 text-[13px] font-medium text-slate-600 dark:text-slate-300">
                    <a href="#courses" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                    <a href="#video-tour" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম অভিজ্ঞতা</a>
                    <a href="#features" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                    <a href="#question-bank" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">বোর্ড প্রশ্ন</a>
                    <a href="#how-it-works" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
                </nav>

                <!-- Class Filter at Navbar -->
                <div class="relative flex items-center ml-1 pl-2 border-l border-slate-200 dark:border-slate-800">
                    <label for="navbarClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                    <div class="relative flex items-center">
                        <span class="material-symbols-rounded text-[#18a957] text-base absolute left-2 pointer-events-none">tune</span>
                        <select id="navbarClassFilter" onchange="filterLandingByClass(this.value)"
                            class="appearance-none h-8 pl-7 pr-7 py-1 text-xs font-medium rounded-lg border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 outline-none focus:border-[#18a957] focus:ring-1 focus:ring-[#18a957]/20 transition-all cursor-pointer shadow-2xs">
                            <option value="all">শ্রেণী: সকল</option>
                            <% if (locals.activeClasses && activeClasses.length > 0) { %>
                                <% activeClasses.forEach(cls => { %>
                                    <option value="<%= cls.name %>"><%= cls.name %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Class 9">Class 9</option>
                                <option value="Class 10">Class 10</option>
                                <option value="HSC">HSC (Class 11-12)</option>
                            <% } %>
                        </select>
                        <span class="material-symbols-rounded text-slate-400 text-sm absolute right-2 pointer-events-none">expand_more</span>
                    </div>
                </div>
            </div>

            <!-- Right Actions: Theme Toggle + Dashboard/Login/Signup -->
            <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
                <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                    class="size-8.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer"
                    title="ডার্ক / লাইট মোড পরিবর্তন">
                    <span class="material-symbols-rounded text-[19px] dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded text-[19px] hidden dark:block text-amber-400">light_mode</span>
                </button>

                <% if (locals.user) { %>
                    <% 
                        let dashUrl = '/dashboard';
                        if (user.role === 'teacher') dashUrl = '/teacher';
                        else if (user.role === 'admin') dashUrl = '/admin';
                        else if (user.role === 'superadmin') dashUrl = '/superadmin';
                    %>
                    <a href="<%= dashUrl %>" class="px-3.5 py-1.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs active:scale-95">
                        <span class="material-symbols-rounded text-sm">dashboard</span>
                        <span>ড্যাশবোর্ড</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="px-3.5 py-1.5 text-xs font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95">
                        লগইন
                    </a>
                    <a href="/register" class="px-3.5 py-1.5 bg-[#18a957] hover:bg-[#148e49] text-white text-xs font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                        শুরু করুন
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Mobile Filter Bar (Visible only on mobile screens under header) -->
        <div class="md:hidden px-4 py-2 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/60 flex items-center justify-between gap-2">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="material-symbols-rounded text-sm text-[#18a957]">tune</span>
                <span>শ্রেণী ফিল্টার:</span>
            </span>
            <div class="relative flex items-center">
                <select id="mobileClassFilter" onchange="filterLandingByClass(this.value); document.getElementById('navbarClassFilter').value = this.value;"
                    class="appearance-none h-7 pl-2.5 pr-6 py-0.5 text-xs font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 outline-none cursor-pointer">
                    <option value="all">সকল শ্রেণী</option>
                    <% if (locals.activeClasses && activeClasses.length > 0) { %>
                        <% activeClasses.forEach(cls => { %>
                            <option value="<%= cls.name %>"><%= cls.name %></option>
                        <% }) %>
                    <% } else { %>
                        <option value="Class 9">Class 9</option>
                        <option value="Class 10">Class 10</option>
                        <option value="HSC">HSC (Class 11-12)</option>
                    <% } %>
                </select>
                <span class="material-symbols-rounded text-slate-400 text-xs absolute right-1.5 pointer-events-none">expand_more</span>
            </div>
        </div>
    </header>

    <!-- 2. Hero Section: Split 2-Column Layout (Text + Info on one side, SuperAdmin Screenshot on other side) -->
    <section class="relative pt-10 sm:pt-14 md:pt-16 pb-8 sm:pb-10 constellation-dots overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Column 1: Text, Buttons & Integrated Platform Info -->
                <div class="lg:col-span-6 space-y-5 text-left">
                    
                    <!-- Headline: Balanced font-semibold with styled 'অধ্যায়' -->
                    <h1 class="text-[26px] sm:text-[34px] md:text-[38px] lg:text-[40px] font-semibold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        শেখার নতুন <span class="brand-gradient-word font-semibold">অধ্যায়</span>
                    </h1>

                    <!-- Subtext: 9th to 12th class focused -->
                    <p class="text-sm sm:text-[15px] md:text-base text-slate-500 dark:text-slate-400 font-normal leading-relaxed max-w-xl">
                        নবম শ্রেণী থেকে দ্বাদশ শ্রেণী — বোর্ড পরীক্ষা ও একাডেমিক প্রস্তুতির পূর্ণাঙ্গ ডিজিটাল শিক্ষা মাধ্যম।
                    </p>

                    <!-- Call to Action Buttons -->
                    <div class="pt-1 flex flex-wrap items-center gap-3">
                        <a href="/register" class="px-5 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white text-xs sm:text-sm font-semibold transition-all shadow-xs active:scale-95">
                            শুরু করুন
                        </a>
                        <a href="#courses" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 hover:border-[#18a957] text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-semibold transition-all shadow-2xs">
                            কোর্সসমূহ দেখুন
                        </a>
                    </div>

                    <!-- Platform Info Metrics (Real Database Info Integrated into Hero) -->
                    <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-slate-800 dark:text-slate-100 leading-tight">
                                <%= totalStudents > 0 ? totalStudents : 1 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">সক্রিয় শিক্ষার্থী</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-[#18a957] leading-tight">
                                <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">ভিডিও লেসন</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-teal-600 dark:text-teal-400 leading-tight">
                                <%= totalQuestions > 0 ? totalQuestions : 30 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">বোর্ড প্রশ্ন</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-violet-600 dark:text-violet-400 leading-tight">
                                <%= totalQuizzes > 0 ? totalQuizzes : 0 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">মক টেস্ট</p>
                        </div>
                    </div>

                </div>

                <!-- Column 2: Unboxed, Organic Hero Visual Area (Full PNG Image, No Box Constraints) -->
                <div class="lg:col-span-6 relative flex items-center justify-center">
                    <!-- Soft Ambient Glow Mesh Behind the Image -->
                    <div class="absolute -inset-4 sm:-inset-8 bg-gradient-to-tr from-[#18a957]/15 via-blue-500/10 to-violet-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

                    <% if (locals.landingSettings && landingSettings.heroScreenshotUrl) { %>
                        <% 
                            const heroScale = (typeof landingSettings.heroImageScale === 'number' ? landingSettings.heroImageScale : 100) / 100;
                            const heroRotate = typeof landingSettings.heroImageRotate === 'number' ? landingSettings.heroImageRotate : 0;
                            const heroOffsetX = typeof landingSettings.heroImageOffsetX === 'number' ? landingSettings.heroImageOffsetX : 0;
                            const heroOffsetY = typeof landingSettings.heroImageOffsetY === 'number' ? landingSettings.heroImageOffsetY : 0;
                        %>
                        <!-- Whole Picture Rendered: Sized, Rotated and Positioned Exactly as SuperAdmin Configured -->
                        <div class="w-full flex items-center justify-center p-2 overflow-visible">
                            <img src="<%= landingSettings.heroScreenshotUrl %>" 
                                 alt="ODDHAY Platform Visual" 
                                 style="transform: translate(<%= heroOffsetX %>px, <%= heroOffsetY %>px) scale(<%= heroScale %>) rotate(<%= heroRotate %>deg); transform-origin: center center;"
                                 class="w-full h-auto max-h-[480px] sm:max-h-[540px] lg:max-h-[580px] object-contain drop-shadow-2xl transition-transform duration-200 select-none">
                        </div>
                    <% } else { %>
                        <!-- Default Clean Floating Mockup Graphic when no image is uploaded yet -->
                        <div class="w-full max-w-lg mx-auto p-2 sm:p-4 text-center select-none">
                            <div class="relative mx-auto rounded-3xl p-6 bg-gradient-to-tr from-white/80 to-white/50 dark:from-slate-900/80 dark:to-slate-850/50 backdrop-blur-md border border-slate-200/70 dark:border-slate-700/60 shadow-xl drop-shadow-xl space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-slate-800 pb-3">
                                    <div class="flex items-center gap-2">
                                        <div class="size-8 rounded-xl bg-[#18a957] text-white flex items-center justify-center shadow-xs">
                                            <span class="material-symbols-rounded text-lg">school</span>
                                        </div>
                                        <span class="font-semibold text-sm text-slate-800 dark:text-white">অধ্যায় ডিজিটাল প্ল্যাটফর্ম</span>
                                    </div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-100/70 dark:bg-emerald-950/70 text-[#18a957] text-xs font-semibold">লাইভ ব্যাচ ৯-১২</span>
                                </div>

                                <div class="grid grid-cols-2 gap-3 text-left">
                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-[#18a957]">
                                            <span class="text-xs font-semibold">স্মার্ট ক্লাস</span>
                                            <span class="material-symbols-rounded text-sm">smart_display</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">অধ্যায়ভিত্তিক লেকচার ও রিভিশন শিট</p>
                                    </div>

                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-teal-600">
                                            <span class="text-xs font-semibold">প্রশ্ন ব্যাংক</span>
                                            <span class="material-symbols-rounded text-sm">quiz</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">বিগত বছরের সকল বোর্ড প্রশ্ন সমাধান</p>
                                    </div>
                                </div>

                                <div class="pt-2 text-[11px] text-slate-400 font-normal">
                                    সুপারএডমিন প্যানেল থেকে যেকোনো স্বচ্ছ PNG বা ছবি আপলোড করলে তা সরাসরি এখানে সুন্দরভাবে প্রদর্শিত হবে।
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. "কেন অধ্যায় সেরা" (Generous Section Gap, font-semibold Headings) -->
    <section id="features" class="pt-8 sm:pt-10 pb-16 sm:pb-20 border-t border-slate-200/80 dark:border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                    কেন অধ্যায় বেছে নেবে?
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1.5">
                    ক্লাস, বোর্ড প্রশ্ন, পরীক্ষা ও শিক্ষক সহায়তার গোছানো সমন্বয়।
                </p>
            </div>

            <!-- Initial Core Features (3 Cards) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-[#18a957] flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">smart_display</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">ভিডিও লেসন ও ক্লাসরুম</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        অধ্যায়ভিত্তিক সাজানো ভিডিও লেসন ও ক্লাস রুটিনের মাধ্যমে বেসিক পরিষ্কার করো।
                    </p>
                </div>

                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">quiz</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">বোর্ড প্রশ্ন ব্যাংক আর্কাইভ</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        সকল শিক্ষা বোর্ডের বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যামূলক সমাধান।
                    </p>
                </div>

                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">timer</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">টাইমারভিত্তিক মক টেস্ট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        আসল পরীক্ষার মতো টাইমার ও নেগেটিভ মার্কিংযুক্ত পরীক্ষায় নিজের অবস্থান যাচাই।
                    </p>
                </div>
            </div>

            <!-- Extended Features Container (Toggled via button) -->
            <div id="extendedFeaturesGrid" class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6 hidden animate-fade-in">
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">forum</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">১-অন-১ মেন্টর চ্যাট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়ার মাঝে যেকোনো সমস্যায় শিক্ষকের সাথে সরাসরি চ্যাট করে প্রশ্ন সমাধানের সুযোগ।
                    </p>
                </div>

                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">description</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">লেকচার নোটস ও শিট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        প্রতিটি অধ্যায়ের গুরুত্বপূর্ণ রিভিশন নোটস ও ডাউনলোডযোগ্য পিডিএফ শিট।
                    </p>
                </div>

                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xs">
                    <div class="size-10 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-3.5">
                        <span class="material-symbols-rounded text-xl">psychology</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1">স্মার্ট AI স্টাডি টুল</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        ২৪/৭ যেকোনো কঠিন প্রশ্নের তাৎক্ষণিক ব্যাখ্যা ও সহজবোধ্য সমাধান পাওয়ার টুল।
                    </p>
                </div>
            </div>

            <!-- View All Features Button -->
            <div class="text-center mt-8">
                <button type="button" id="toggleFeaturesBtn" onclick="toggleAllLandingFeatures()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-[#18a957] text-xs font-semibold text-slate-700 dark:text-slate-200 transition-all cursor-pointer shadow-2xs inline-flex items-center gap-1.5">
                    <span id="featuresBtnText">সকল ফিচার দেখুন</span>
                    <span id="featuresBtnIcon" class="material-symbols-rounded text-base">expand_more</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 4. "প্ল্যাটফর্ম অভিজ্ঞতা" (Platform Overview Video - SuperAdmin Controlled) -->
    <section id="video-tour" class="py-16 sm:py-20 border-y border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/30 backdrop-blur-xs">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            
            <span class="text-xs font-semibold text-[#18a957] tracking-wider uppercase">প্ল্যাটফর্ম অভিজ্ঞতা</span>
            <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100 mt-1.5">
                <%= (locals.landingSettings && landingSettings.videoTitle) ? landingSettings.videoTitle : 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1 max-w-lg mx-auto">
                <%= (locals.landingSettings && landingSettings.videoCaption) ? landingSettings.videoCaption : 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %>
            </p>

            <!-- Video Player Box -->
            <div class="mt-8 rounded-3xl border border-slate-200 dark:border-slate-700/80 bg-slate-950 overflow-hidden shadow-md aspect-video max-w-3xl mx-auto flex items-center justify-center relative">
                <% 
                    const customVideoUrl = (locals.landingSettings && landingSettings.videoUrl) ? landingSettings.videoUrl.trim() : '';
                    let ytEmbedId = null;
                    if (customVideoUrl.includes('youtube.com/watch')) {
                        const m = customVideoUrl.match(/[?&]v=([^&]+)/);
                        if (m) ytEmbedId = m[1];
                    } else if (customVideoUrl.includes('youtu.be/')) {
                        const parts = customVideoUrl.split('youtu.be/');
                        if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                    } else if (customVideoUrl.includes('youtube.com/embed/')) {
                        const parts = customVideoUrl.split('youtube.com/embed/');
                        if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                    }
                %>

                <% if (ytEmbedId) { %>
                    <iframe src="https://www.youtube.com/embed/<%= ytEmbedId %>?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                <% } else if (customVideoUrl.endsWith('.mp4') || customVideoUrl.endsWith('.webm') || customVideoUrl.includes('cloudinary.com')) { %>
                    <video src="<%= customVideoUrl %>" controls class="w-full h-full object-contain"></video>
                <% } else { %>
                    <!-- Default Attractive Video Mockup Player -->
                    <div class="p-6 text-center text-white space-y-3">
                        <div class="size-14 mx-auto rounded-full bg-[#18a957]/20 text-[#18a957] flex items-center justify-center mb-2">
                            <span class="material-symbols-rounded text-3xl">play_circle</span>
                        </div>
                        <h4 class="text-base font-semibold text-white">অধ্যায় ওভারভিউ ভিডিও</h4>
                        <p class="text-xs text-slate-400 max-w-xs mx-auto font-normal">সুপারঅ্যাডমিন প্যানেলের Landing Page Control Center থেকে নিজস্ব ভিডিও লিঙ্ক যুক্ত করা যাবে।</p>
                    </div>
                <% } %>
            </div>

        </div>
    </section>

    <!-- 5. "কোর্স ও ব্যাচসমূহ" (Dynamically Filtered Available Courses) -->
    <section id="courses" class="py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                        কোর্স ও ব্যাচসমূহ
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1">
                        <span id="activeFilteredClassText">সকল শ্রেণীর</span> জন্য উপলব্ধ একাডেমিক ও প্রস্তুতি কোর্স
                    </p>
                </div>
                <a href="/courses" class="text-xs sm:text-sm font-semibold text-[#18a957] hover:underline inline-flex items-center gap-1 shrink-0">
                    <span>সবগুলো কোর্স দেখুন</span>
                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Course Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="coursesGridContainer">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <% 
                            let courseClassStr = Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '');
                            let primaryPrice = 0;
                            let originalPrice = 0;
                            if (course.plans && course.plans.length > 0) {
                                primaryPrice = course.plans[0].price || 0;
                            } else if (course.price) {
                                primaryPrice = course.discountPrice || course.price;
                                originalPrice = course.price;
                            }
                            let isFree = course.accessType === 'free' || primaryPrice === 0;
                        %>
                        <div class="course-card-item feature-card rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/85 dark:bg-slate-900/70 backdrop-blur-xs overflow-hidden flex flex-col justify-between"
                             data-class="<%= courseClassStr.toLowerCase() %>">
                            <div class="relative aspect-video bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-rounded text-4xl">auto_stories</span>
                                    </div>
                                <% } %>
                                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-[10px] font-semibold <%= isFree ? 'bg-[#18a957] text-white' : 'bg-slate-900/85 text-white' %>">
                                    <%= isFree ? 'ফ্রি' : 'অনলাইন কোর্স' %>
                                </span>
                            </div>

                            <div class="p-5 flex-1 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center gap-1.5 text-[10px] font-medium text-slate-400 mb-1.5">
                                        <span><%= (course.classLevel && course.classLevel[0]) || 'একাডেমিক' %></span>
                                        <span>•</span>
                                        <span><%= (course.subject && course.subject[0]) || 'বিষয়' %></span>
                                    </div>

                                    <h3 class="text-sm sm:text-[15px] font-semibold text-slate-800 dark:text-white line-clamp-2 leading-snug">
                                        <%= course.title %>
                                    </h3>

                                    <% if (course.instructor) { %>
                                        <div class="flex items-center gap-1.5 mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                                            <p class="text-xs text-slate-600 dark:text-slate-300 font-normal truncate">
                                                <%= course.instructor.name %>
                                                <% if (course.instructor.designation) { %>
                                                    <span class="text-slate-400 font-normal">• <%= course.instructor.designation %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
                                    <div class="num-font">
                                        <% if (isFree) { %>
                                            <span class="text-xs sm:text-sm font-semibold text-[#18a957]">ফ্রি অ্যাক্সেস</span>
                                        <% } else { %>
                                            <span class="text-sm sm:text-base font-semibold text-slate-800 dark:text-white">৳<%= primaryPrice %></span>
                                            <% if (originalPrice > primaryPrice) { %>
                                                <span class="text-xs text-slate-400 line-through ml-1">৳<%= originalPrice %></span>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <a href="/course-details/<%= course._id %>" class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-[#18a957] hover:text-white dark:bg-slate-800 dark:hover:bg-[#18a957] text-slate-700 dark:text-slate-200 text-xs font-semibold transition-colors">
                                        বিস্তারিত
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-12 text-center text-slate-400 space-y-2">
                        <span class="material-symbols-rounded text-3xl">school</span>
                        <p class="text-xs sm:text-sm font-semibold">কোনো কোর্স পাওয়া যায়নি। শীঘ্রই নতুন ব্যাচ যুক্ত হবে।</p>
                    </div>
                <% } %>
            </div>

            <!-- Empty State for Filter mismatch -->
            <div id="noCoursesFilteredMsg" class="hidden py-10 text-center space-y-2">
                <span class="material-symbols-rounded text-3xl text-slate-400">filter_alt_off</span>
                <p class="text-xs sm:text-sm font-semibold text-slate-500">এই শ্রেণীর জন্য বর্তমানে কোনো সরাসরি কোর্স নেই। শীঘ্রই নতুন ব্যাচ যুক্ত হচ্ছে।</p>
                <button type="button" onclick="filterLandingByClass('all')" class="text-xs sm:text-sm text-[#18a957] font-semibold hover:underline">সকল কোর্স দেখুন</button>
            </div>
        </div>
    </section>

    <!-- 6. "বিগত বছরের বোর্ড প্রশ্ন ব্যাংক" (Relevant, Clean, font-semibold) -->
    <section id="question-bank" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/30 backdrop-blur-xs">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-2 mb-8">
            <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                বিগত বছরের বোর্ড প্রশ্ন ব্যাংক
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                অধ্যায়ভিত্তিক সৃজনশীল ও বহুনির্বাচনী প্রশ্নের নির্ভুল সমাধান।
            </p>
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Board Badges -->
            <div class="flex flex-wrap items-center justify-center gap-1.5 mb-6 text-xs text-slate-600 dark:text-slate-300 font-medium">
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">ঢাকা</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">রাজশাহী</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">চট্টগ্রাম</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">কুমিল্লা</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">যশোর</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">দিনাজপুর</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">সিলেট</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">বরিশাল</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">মাদ্রাসা</span>
            </div>

            <!-- Question Bank List -->
            <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/85 dark:bg-slate-900/80 overflow-hidden divide-y divide-slate-100 dark:divide-slate-800/80">
                <% if (locals.questionBankSample && questionBankSample.length > 0) { %>
                    <% questionBankSample.forEach(qb => { %>
                        <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                            <div>
                                <span class="text-xs font-semibold text-[#18a957] dark:text-emerald-400">
                                    <%= qb.board || 'জাতীয় বোর্ড' %> • <%= qb.year || '২০২৪' %>
                                </span>
                                <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100">
                                    <%= qb.title || (qb.subject + ' বোর্ড প্রশ্ন ও সমাধান') %>
                                </h3>
                            </div>
                            <a href="/login" class="px-3.5 py-1.5 rounded-lg bg-[#137a43] hover:bg-[#0e6336] text-white text-xs font-semibold text-center transition-colors shrink-0 shadow-2xs">
                                সমাধান দেখো
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <span class="text-xs font-semibold text-[#18a957]">ঢাকা বোর্ড • ২০২৩</span>
                            <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100">এসএসসি পদার্থবিজ্ঞান — সৃজনশীল ও বহুনির্বাচনী প্রশ্ন সমাধান</h3>
                        </div>
                        <a href="/login" class="px-3.5 py-1.5 rounded-lg bg-[#137a43] hover:bg-[#0e6336] text-white text-xs font-semibold text-center shrink-0 shadow-2xs">সমাধান দেখো</a>
                    </div>
                    <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <span class="text-xs font-semibold text-[#18a957]">রাজশাহী বোর্ড • ২০২৩</span>
                            <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100">এইচএসসি উচ্চতর গণিত ১ম পত্র — সম্পূর্ণ সমাধান</h3>
                        </div>
                        <a href="/login" class="px-3.5 py-1.5 rounded-lg bg-[#137a43] hover:bg-[#0e6336] text-white text-xs font-semibold text-center shrink-0 shadow-2xs">সমাধান দেখো</a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- 7. পড়াশোনার গোছানো ধারাবাহিকতা (Generous Gap, font-semibold) -->
    <section id="how-it-works" class="py-16 sm:py-20">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                    পড়াশোনার গোছানো ধারাবাহিকতা
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1.5">
                    টপিক ক্লিয়ারিং থেকে পরীক্ষার প্রস্তুতি।
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-6 rounded-2xl border border-slate-200/70 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 backdrop-blur-xs">
                    <span class="num-font text-xs font-semibold text-[#18a957] px-2.5 py-1 rounded-md bg-emerald-100/60 dark:bg-emerald-950/60">01</span>
