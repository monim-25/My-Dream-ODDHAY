<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>অধ্যায় (ODDHAY) — শেখার নতুন অধ্যায়</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #18a957;
            --primary-dark: #138745;
        }

        body, button, input, select, textarea, .font-sans {
            font-family: 'Inter', 'Noto Sans Bengali', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8faff;
            color: #1e293b;
            transition: background-color 0.3s ease, color 0.3s ease;
            -webkit-font-smoothing: antialiased;
        }

        .font-bangla, [lang="bn"], .bangla-font {
            font-family: 'Noto Sans Bengali', 'Hind Siliguri', 'Inter', sans-serif !important;
        }

        /* 
         * Rich, inspirational background reflecting intellect, youthful energy, 
         * education, resilience, and the story to success.
         */
        .dark body {
            background-color: #091122;
            color: #e2e8f0;
        }

        /* Luminous ambient education & youth aura mesh */
        .academic-aura-bg {
            background: 
                radial-gradient(ellipse 60% 45% at 50% -10%, rgba(24, 169, 87, 0.12), transparent 70%),
                radial-gradient(ellipse 40% 35% at 15% 25%, rgba(19, 127, 236, 0.10), transparent 60%),
                radial-gradient(ellipse 35% 30% at 85% 35%, rgba(245, 158, 11, 0.08), transparent 60%);
        }

        .dark .academic-aura-bg {
            background: 
                radial-gradient(ellipse 65% 50% at 50% -10%, rgba(20, 100, 220, 0.28), transparent 70%),
                radial-gradient(ellipse 45% 40% at 10% 30%, rgba(124, 58, 237, 0.18), transparent 65%),
                radial-gradient(ellipse 40% 35% at 90% 40%, rgba(24, 169, 87, 0.15), transparent 60%),
                radial-gradient(ellipse 55% 45% at 50% 85%, rgba(16, 185, 129, 0.10), transparent 70%);
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .feature-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-2px);
        }

        /* Soft subtle dot constellation for thought & structure */
        .constellation-dots {
            background-image: radial-gradient(rgba(24, 169, 87, 0.12) 1px, transparent 1px);
            background-size: 26px 26px;
        }
        .dark .constellation-dots {
            background-image: radial-gradient(rgba(52, 211, 153, 0.08) 1px, transparent 1px);
        }

        /* Prevent double expand icon on selects in all browsers */
        select.appearance-none {
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            background-image: none !important;
        }
        select.appearance-none::-ms-expand {
            display: none !important;
        }

        /* Highlighted brand word gradient */
        .brand-gradient-word {
            background: linear-gradient(135deg, #18a957 0%, #10b981 45%, #06b6d4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col academic-aura-bg selection:bg-[#18a957]/20 selection:text-[#18a957]">

    <!-- 1. Sleek Navigation Bar with Class Filter Beside Options -->
    <header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#091122]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
            
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 shrink-0 select-none group">
                <div class="size-9 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                    <span class="material-symbols-rounded text-[20px] pointer-events-none">menu_book</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-semibold text-lg sm:text-xl tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                    <span class="text-[9px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
                </div>
            </a>

            <!-- Desktop Middle: Nav Links + Class Filter Beside Options -->
            <div class="hidden md:flex items-center gap-2 lg:gap-3">
                <nav class="flex items-center gap-1 text-[13px] font-medium text-slate-600 dark:text-slate-300">
                    <a href="#courses" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                    <a href="#video-tour" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম পরিচিতি</a>
                    <a href="#features" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                    <a href="#question-bank" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">বোর্ড প্রশ্ন</a>
                    <a href="#how-it-works" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
                </nav>

                <!-- Class Filter at Navbar -->
                <div class="relative flex items-center ml-1 pl-2 border-l border-slate-200 dark:border-slate-800">
                    <label for="navbarClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                    <div class="relative flex items-center">
                        <span class="material-symbols-rounded text-[#18a957] text-base absolute left-2 pointer-events-none">tune</span>
                        <select id="navbarClassFilter" onchange="filterLandingByClass(this.value)"
                            class="appearance-none h-8 pl-7 pr-7 py-1 text-xs font-medium rounded-lg border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 outline-none focus:border-[#18a957] focus:ring-1 focus:ring-[#18a957]/20 transition-all cursor-pointer shadow-2xs">
                            <option value="all">শ্রেণী: সকল</option>
                            <% if (locals.activeClasses && activeClasses.length > 0) { %>
                                <% activeClasses.forEach(cls => { %>
                                    <option value="<%= cls.name %>"><%= cls.name %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Class 9">Class 9</option>
                                <option value="Class 10">Class 10</option>
                                <option value="HSC">HSC (Class 11-12)</option>
                            <% } %>
                        </select>
                        <span class="material-symbols-rounded text-slate-400 text-sm absolute right-2 pointer-events-none">expand_more</span>
                    </div>
                </div>
            </div>

            <!-- Right Actions: Theme Toggle + Dashboard/Login/Signup -->
            <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
                <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                    class="size-8.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer"
                    title="ডার্ক / লাইট মোড পরিবর্তন">
                    <span class="material-symbols-rounded text-[19px] dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded text-[19px] hidden dark:block text-amber-400">light_mode</span>
                </button>

                <% if (locals.user) { %>
                    <% 
                        let dashUrl = '/dashboard';
                        if (user.role === 'teacher') dashUrl = '/teacher';
                        else if (user.role === 'admin') dashUrl = '/admin';
                        else if (user.role === 'superadmin') dashUrl = '/superadmin';
                    %>
                    <a href="<%= dashUrl %>" class="px-3.5 py-1.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs active:scale-95">
                        <span class="material-symbols-rounded text-sm">dashboard</span>
                        <span>ড্যাশবোর্ড</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="px-3.5 py-1.5 text-xs font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95">
                        লগইন
                    </a>
                    <a href="/register" class="px-3.5 py-1.5 bg-[#18a957] hover:bg-[#148e49] text-white text-xs font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                        শুরু করুন
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Mobile Filter Bar (Visible only on mobile screens under header) -->
        <div class="md:hidden px-4 py-2 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/60 flex items-center justify-between gap-2">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="material-symbols-rounded text-sm text-[#18a957]">tune</span>
                <span>শ্রেণী ফিল্টার:</span>
            </span>
            <div class="relative flex items-center">
                <select id="mobileClassFilter" onchange="filterLandingByClass(this.value); document.getElementById('navbarClassFilter').value = this.value;"
                    class="appearance-none h-7 pl-2.5 pr-6 py-0.5 text-xs font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 outline-none cursor-pointer">
                    <option value="all">সকল শ্রেণী</option>
                    <% if (locals.activeClasses && activeClasses.length > 0) { %>
                        <% activeClasses.forEach(cls => { %>
                            <option value="<%= cls.name %>"><%= cls.name %></option>
                        <% }) %>
                    <% } else { %>
                        <option value="Class 9">Class 9</option>
                        <option value="Class 10">Class 10</option>
                        <option value="HSC">HSC (Class 11-12)</option>
                    <% } %>
                </select>
                <span class="material-symbols-rounded text-slate-400 text-xs absolute right-1.5 pointer-events-none">expand_more</span>
            </div>
        </div>
    </header>

    <!-- 2. Hero Section: Split 2-Column Layout (Text + Info on one side, SuperAdmin Screenshot on other side) -->
    <section class="relative pt-10 sm:pt-14 md:pt-16 pb-12 sm:pb-14 md:pb-16 constellation-dots overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Column 1: Text, Buttons & Integrated Platform Info -->
                <div class="lg:col-span-6 space-y-5 text-left">
                    
                    <!-- Headline: Balanced font-semibold with styled 'অধ্যায়' -->
                    <h1 class="text-[26px] sm:text-[34px] md:text-[38px] lg:text-[40px] font-semibold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        শেখার নতুন <span class="brand-gradient-word font-semibold">অধ্যায়</span>
                    </h1>

                    <!-- Subtext: 9th to 12th class focused -->
                    <p class="text-sm sm:text-[15px] md:text-base text-slate-500 dark:text-slate-400 font-normal leading-relaxed max-w-xl">
                        নবম শ্রেণী থেকে দ্বাদশ শ্রেণী — বোর্ড পরীক্ষা ও একাডেমিক প্রস্তুতির পূর্ণাঙ্গ ডিজিটাল শিক্ষা মাধ্যম।
                    </p>

                    <!-- Call to Action Buttons -->
                    <div class="pt-1 flex flex-wrap items-center gap-3">
                        <a href="/register" class="px-5 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white text-xs sm:text-sm font-semibold transition-all shadow-xs active:scale-95">
                            শুরু করুন
                        </a>
                        <a href="#courses" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 hover:border-[#18a957] text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-semibold transition-all shadow-2xs">
                            কোর্সসমূহ দেখুন
                        </a>
                    </div>

                    <!-- Platform Info Metrics (Real Database Info Integrated into Hero) -->
                    <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-slate-800 dark:text-slate-100 leading-tight">
                                <%= totalStudents > 0 ? totalStudents : 1 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">সক্রিয় শিক্ষার্থী</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-[#18a957] leading-tight">
                                <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">ভিডিও লেসন</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-teal-600 dark:text-teal-400 leading-tight">
                                <%= totalQuestions > 0 ? totalQuestions : 30 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">বোর্ড প্রশ্ন</p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-lg sm:text-xl font-semibold text-violet-600 dark:text-violet-400 leading-tight">
                                <%= totalQuizzes > 0 ? totalQuizzes : 0 %>+
                            </div>
                            <p class="text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">মক টেস্ট</p>
                        </div>
                    </div>

                </div>

                <!-- Column 2: Unboxed, Organic Hero Visual Area (Full PNG Image, No Box Constraints) -->
                <div class="lg:col-span-6 relative flex items-center justify-center">
                    <!-- Soft Ambient Glow Mesh Behind the Image -->
                    <div class="absolute -inset-4 sm:-inset-8 bg-gradient-to-tr from-[#18a957]/15 via-blue-500/10 to-violet-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

                    <% if (locals.landingSettings && landingSettings.heroScreenshotUrl) { %>
                        <% 
                            const heroScale = (typeof landingSettings.heroImageScale === 'number' ? landingSettings.heroImageScale : 100) / 100;
                            const heroRotate = typeof landingSettings.heroImageRotate === 'number' ? landingSettings.heroImageRotate : 0;
                            const heroOffsetX = typeof landingSettings.heroImageOffsetX === 'number' ? landingSettings.heroImageOffsetX : 0;
                            const heroOffsetY = typeof landingSettings.heroImageOffsetY === 'number' ? landingSettings.heroImageOffsetY : 0;
                        %>
                        <!-- Whole Picture Rendered: Sized, Rotated and Positioned Exactly as SuperAdmin Configured -->
                        <div class="w-full flex items-center justify-center p-2 overflow-visible">
                            <img src="<%= landingSettings.heroScreenshotUrl %>" 
                                 alt="ODDHAY Platform Visual" 
                                 style="transform: translate(<%= heroOffsetX %>px, <%= heroOffsetY %>px) scale(<%= heroScale %>) rotate(<%= heroRotate %>deg); transform-origin: center center;"
                                 class="w-full h-auto max-h-[480px] sm:max-h-[540px] lg:max-h-[580px] object-contain drop-shadow-2xl transition-transform duration-200 select-none">
                        </div>
                    <% } else { %>
                        <!-- Default Clean Floating Mockup Graphic when no image is uploaded yet -->
                        <div class="w-full max-w-lg mx-auto p-2 sm:p-4 text-center select-none">
                            <div class="relative mx-auto rounded-3xl p-6 bg-gradient-to-tr from-white/80 to-white/50 dark:from-slate-900/80 dark:to-slate-850/50 backdrop-blur-md border border-slate-200/70 dark:border-slate-700/60 shadow-xl drop-shadow-xl space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-slate-800 pb-3">
                                    <div class="flex items-center gap-2">
                                        <div class="size-8 rounded-xl bg-[#18a957] text-white flex items-center justify-center shadow-xs">
                                            <span class="material-symbols-rounded text-lg">school</span>
                                        </div>
                                        <span class="font-semibold text-sm text-slate-800 dark:text-white">অধ্যায় ডিজিটাল প্ল্যাটফর্ম</span>
                                    </div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-100/70 dark:bg-emerald-950/70 text-[#18a957] text-xs font-semibold">লাইভ ব্যাচ ৯-১২</span>
                                </div>

                                <div class="grid grid-cols-2 gap-3 text-left">
                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-[#18a957]">
                                            <span class="text-xs font-semibold">স্মার্ট ক্লাস</span>
                                            <span class="material-symbols-rounded text-sm">smart_display</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">অধ্যায়ভিত্তিক লেকচার ও রিভিশন শিট</p>
                                    </div>

                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-teal-600">
                                            <span class="text-xs font-semibold">প্রশ্ন ব্যাংক</span>
                                            <span class="material-symbols-rounded text-sm">quiz</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">বিগত বছরের সকল বোর্ড প্রশ্ন সমাধান</p>
                                    </div>
                                </div>

                                <div class="pt-2 text-[11px] text-slate-400 font-normal">
                                    সুপারএডমিন প্যানেল থেকে যেকোনো স্বচ্ছ PNG বা ছবি আপলোড করলে তা সরাসরি এখানে সুন্দরভাবে প্রদর্শিত হবে।
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. "কেন অধ্যায় সেরা" (6 Core Cards + Extended Cards) -->
    <section id="features" class="pt-14 sm:pt-16 md:pt-20 pb-16 sm:pb-20 border-t border-slate-200/80 dark:border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                    কেন অধ্যায় বেছে নেবে?
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1.5">
                    ক্লাস, বোর্ড প্রশ্ন, পরীক্ষা ও শিক্ষক সহায়তার গোছানো সমন্বয়।
                </p>
            </div>

            <!-- Initial Core 6 Cards (3x2 Grid on desktop) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                
                <!-- Card 1: ভিডিও লেসন ও ক্লাসরুম (Emerald Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-emerald-500/[0.08] via-emerald-500/[0.03] to-white/70 dark:to-slate-900/40 border border-emerald-500/20 hover:border-emerald-500/40 dark:from-emerald-500/[0.13] dark:via-emerald-500/[0.04] dark:border-emerald-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-emerald-500/15 text-[#18a957] dark:text-emerald-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">smart_display</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1.5">ভিডিও লেসন ও ক্লাসরুম</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        অধ্যায়ভিত্তিক সাজানো ভিডিও লেসন ও ক্লাস রুটিনের মাধ্যমে বেসিক পরিষ্কার করো।
                    </p>
                </div>

                <!-- Card 2: বোর্ড প্রশ্ন ব্যাংক আর্কাইভ (Teal Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-teal-500/[0.08] via-teal-500/[0.03] to-white/70 dark:to-slate-900/40 border border-teal-500/20 hover:border-teal-500/40 dark:from-teal-500/[0.13] dark:via-teal-500/[0.04] dark:border-teal-500/30 backdrop-blur-xs shadow-xs">
