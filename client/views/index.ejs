                                <span class="material-symbols-rounded text-sm text-slate-400">info</span>
                                আমাদের সম্পর্কে
                            </a>
                        </li>
                        <li>
                            <a href="/contact" class="hover:text-[#18a957] transition-colors flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm text-slate-400">contact_support</span>
                                যোগাযোগ কেন্দ্র
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Column 4: Address, Hotline & Social (lg:col-span-4) -->
                <div class="lg:col-span-4 space-y-4">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                        প্রধান কার্যালয় ও যোগাযোগ
                    </h4>

                    <div class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400">
                        <!-- Office Address -->
                        <div class="flex items-start gap-2.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base shrink-0 mt-0.5">location_on</span>
                            <span class="leading-relaxed">
                                <%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.address) ? siteSettings.legalInfo.address : 'বাড়ি #১২, রোড #০৪, ধানমন্ডি, ঢাকা - ১২০৯, বাংলাদেশ' %>
                            </span>
                        </div>

                        <!-- Hotline Call -->
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">call</span>
                            <a href="tel:<%= ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+8809638789012').replace(/\s+/g, '') %>" class="hover:text-[#18a957] transition-colors font-medium num-font">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+৮৮০ ৯৬৩৮-৭৮৯০১২' %>
                            </a>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium"><%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.supportHours) ? siteSettings.contactInfo.supportHours : 'সকাল ৯টা - রাত ১১টা' %></span>
                        </div>

                        <!-- Official Email -->
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">mail</span>
                            <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="hover:text-[#18a957] transition-colors font-sans">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                            </a>
                        </div>

                        <!-- WhatsApp Direct -->
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">chat</span>
                            <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" class="hover:text-[#18a957] transition-colors font-medium flex items-center gap-1.5">
                                <span>হোয়াটসঅ্যাপ মেসেজ সাপোর্ট</span>
                                <span class="material-symbols-rounded text-xs text-slate-400">open_in_new</span>
                            </a>
                        </div>
                    </div>

                    <!-- Social Media Connect -->
                    <div class="pt-2">
                        <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-2">সোশ্যাল মিডিয়ায় যুক্ত থাকুন</p>
                        <div class="flex items-center gap-2">
                            <!-- Facebook -->
                            <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.facebook) ? siteSettings.socialLinks.facebook : 'https://facebook.com/oddhay' %>" target="_blank" rel="noopener" title="Facebook Page" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#1877f2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                                <i class="fa-brands fa-facebook-f text-xs"></i>
                            </a>

                            <!-- YouTube -->
                            <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.youtube) ? siteSettings.socialLinks.youtube : 'https://youtube.com/@oddhay' %>" target="_blank" rel="noopener" title="YouTube Channel" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#ff0000] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                                <i class="fa-brands fa-youtube text-xs"></i>
                            </a>

                            <!-- WhatsApp Community -->
                            <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" title="WhatsApp" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#25d366] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                                <i class="fa-brands fa-whatsapp text-xs"></i>
                            </a>

                            <!-- LinkedIn -->
                            <a href="https://linkedin.com/company/oddhay" target="_blank" rel="noopener" title="LinkedIn" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#0a66c2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                                <i class="fa-brands fa-linkedin-in text-xs"></i>
                            </a>

                            <!-- Instagram -->
                            <a href="https://instagram.com/oddhay.official" target="_blank" rel="noopener" title="Instagram" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                                <i class="fa-brands fa-instagram text-xs"></i>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Bottom Copyright Bar -->
        <div class="border-t border-slate-200/80 dark:border-slate-800/80 py-6 bg-slate-50/80 dark:bg-slate-950/60">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal">
                    &copy; ২০২৬ <strong class="text-slate-700 dark:text-slate-300 font-semibold"><%= (locals.siteSettings && siteSettings.footerInfo && siteSettings.footerInfo.copyrightText) ? siteSettings.footerInfo.copyrightText : 'অধ্যায় (ODDHAY) শিক্ষাপ্রযুক্তি লিমিটেড। সর্বস্বত্ব সংরক্ষিত।' %></strong>
                </p>
            </div>
        </div>
    </footer>
<!-- Mobile Quick Bar -->
    <% if (!locals.user) { %>
        <div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center gap-2 shadow-lg">
            <a href="/login" class="flex-1 py-2 rounded-xl bg-[#137a43] text-white text-xs font-semibold text-center shadow-xs">
                লগইন
            </a>
            <a href="/register" class="flex-2 py-2 rounded-xl bg-[#18a957] text-white text-xs font-semibold text-center shadow-xs">
                শুরু করো
            </a>
        </div>
    <% } %>

    <script>
        // 1. Toggle Extended Features
        function toggleAllLandingFeatures() {
            const grid = document.getElementById('extendedFeaturesGrid');
            const btnText = document.getElementById('featuresBtnText');
            const btnIcon = document.getElementById('featuresBtnIcon');
            if (!grid) return;

            const isHidden = grid.classList.contains('hidden');
            if (isHidden) {
                grid.classList.remove('hidden');
                if (btnText) btnText.textContent = 'সংক্ষিপ্ত করুন';
                if (btnIcon) btnIcon.textContent = 'expand_less';
            } else {
                grid.classList.add('hidden');
                if (btnText) btnText.textContent = 'সকল ফিচার দেখুন';
                if (btnIcon) btnIcon.textContent = 'expand_more';
            }
        }

        // 2. Class Filter Controller (Synchronized with Navbar & Mobile selector)
        function filterLandingByClass(className) {
            // Sync both select dropdowns
            const navSelect = document.getElementById('navbarClassFilter');
            const mobSelect = document.getElementById('mobileClassFilter');
            if (navSelect && navSelect.value !== className) navSelect.value = className;
            if (mobSelect && mobSelect.value !== className) mobSelect.value = className;

            const headerText = document.getElementById('activeFilteredClassText');
            if (headerText) {
                headerText.textContent = className === 'all' ? 'সকল শ্রেণীর' : (className + '-এর');
            }

            const cards = document.querySelectorAll('.course-card-item');
            const noCoursesMsg = document.getElementById('noCoursesFilteredMsg');
            let visibleCount = 0;

            cards.forEach(card => {
                if (className === 'all') {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    const cData = card.getAttribute('data-class') || '';
                    if (cData.includes(className.toLowerCase())) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                }
            });

            if (noCoursesMsg) {
                if (visibleCount === 0 && cards.length > 0) {
                    noCoursesMsg.classList.remove('hidden');
                } else {
                    noCoursesMsg.classList.add('hidden');
                }
            }
        }

        // 3. Smooth scroll and filter to specific class section
        function scrollToClassAndFilter(className) {
            filterLandingByClass(className);
            const coursesElem = document.getElementById('courses');
            if (coursesElem) {
                coursesElem.scrollIntoView({ behavior: 'smooth' });
            }
        }
    </script>
</body>
</html>
