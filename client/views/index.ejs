    <!-- Interactive Client Scripts -->
    <script>
        // Toggle extended features (Cards 7-10)
        function toggleExtendedFeatures() {
            const ext = document.getElementById('extendedFeatures');
            const txt = document.getElementById('featuresBtnText');
            const icon = document.getElementById('featuresBtnIcon');
            if (!ext) return;

            const isHidden = ext.classList.contains('hidden');
            if (isHidden) {
                ext.classList.remove('hidden');
                txt.textContent = 'কম ফিচার দেখুন';
                icon.style.transform = 'rotate(180deg)';
            } else {
                ext.classList.add('hidden');
                txt.textContent = 'আরও ৪টি গুরুত্বপূর্ণ ফিচার দেখুন';
                icon.style.transform = 'rotate(0deg)';
            }
        }

        // Live Dynamic Class Filtering for Landing Page Courses
        function filterLandingByClass(className) {
            const cards = document.querySelectorAll('.course-card-item');
            const emptyState = document.getElementById('landingNoCoursesFound');
            const allLink = document.getElementById('allCoursesLink');
            let visibleCount = 0;

            const normClass = (className || 'all').trim().toLowerCase();

            cards.forEach(card => {
                const cardClass = (card.getAttribute('data-class') || '').toLowerCase();
                
                if (normClass === 'all' || normClass === 'সকল শ্রেণী' || normClass === '') {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    if (cardClass.includes(normClass) || cardClass.includes('সকল') || cardClass.includes('all')) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                }
            });

            // Update empty state display
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            // Sync link to all courses with the active class filter
            if (allLink) {
                if (normClass === 'all' || normClass === 'সকল শ্রেণী' || normClass === '') {
                    allLink.href = '/courses';
                } else {
                    const originalClass = className.replace(/\b(class|শ্রেণী)\s*/i, '').trim();
                    allLink.href = `/courses?classLevel=${encodeURIComponent(className)}`;
                }
            }

            // Sync visual active state on navbar select if present
            const navSelect = document.getElementById('navClassFilterSelect');
            if (navSelect && navSelect.value !== className) {
                navSelect.value = className;
            }
        }

        // Listen for filter events triggered from navigation select
        window.addEventListener('oddhay-class-filter-changed', function(e) {
            const chosenClass = e.detail && e.detail.className ? e.detail.className : 'all';
            
            // 1. Filter courses on this page
            filterLandingByClass(chosenClass);

            // 2. Smooth scroll to courses section so student sees immediate result
            const coursesSection = document.getElementById('courses');
            if (coursesSection && chosenClass !== 'all') {
                coursesSection.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Initialize from URL parameters if someone lands with ?class=9
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const classParam = urlParams.get('class') || urlParams.get('classLevel');
            if (classParam) {
                filterLandingByClass(classParam);
            }
        });
    </script>
