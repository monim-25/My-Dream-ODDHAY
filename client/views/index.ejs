<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ODDHAY | আধুনিক অনলাইন লার্নিং প্ল্যাটফর্ম</title>
    <%- include('partials/head') %>
        <style>
            :root {
                --primary: #137fec;
                --primary-dark: #0e66c0;
                --bg-light: #f8fafc;
                --bg-dark: #0f172a;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-light);
                transition: background-color 0.3s ease;
            }

            .dark body {
                background-color: var(--bg-dark);
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.8);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.3);
                border-radius: 2rem;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
            }

            .dark .glass-card {
                background: rgba(30, 41, 59, 0.7);
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .hero-gradient {
                background: radial-gradient(circle at top right, rgba(19, 127, 236, 0.1), transparent 40%),
                    radial-gradient(circle at bottom left, rgba(139, 92, 246, 0.1), transparent 40%);
            }

            .course-card {
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .course-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            }

            .stat-glow {
                box-shadow: 0 0 20px rgba(19, 127, 236, 0.15);
            }

            .btn-premium {
                background: linear-gradient(135deg, var(--primary), #8b5cf6);
                transition: all 0.3s ease;
            }

            .btn-premium:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 20px rgba(19, 127, 236, 0.3);
            }
        </style>
</head>

<body class="text-slate-800 dark:text-slate-100 min-h-screen overflow-x-hidden">

    <!-- Header -->
    <header class="fixed top-0 w-full z-50 px-6 py-4">
        <nav class="max-w-[1400px] mx-auto glass-card h-16 px-8 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div
                    class="size-10 rounded-xl bg-primary flex items-center justify-center text-white shadow-lg shadow-primary/20">
                    <span class="material-symbols-rounded">rocket_launch</span>
                </div>
                <span class="font-black text-2xl tracking-tighter uppercase">Oddhay</span>
            </div>

            <div
                class="hidden md:flex items-center gap-8 text-[11px] font-black uppercase tracking-widest text-slate-500 dark:text-slate-400">
                <a href="/courses" class="hover:text-primary transition-colors">কোর্সসমূহ</a>
                <a href="/about" class="hover:text-primary transition-colors">আমাদের সম্পর্কে</a>
                <a href="/faq" class="hover:text-primary transition-colors">জিজ্ঞাসা</a>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="document.documentElement.classList.toggle('dark')"
                    class="size-10 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-all">
                    <span class="material-symbols-rounded dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded hidden dark:block text-amber-400">light_mode</span>
                </button>
                <% if(locals.user) { %>
                    <a href="/dashboard"
                        class="px-6 py-2.5 btn-premium text-white rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-primary/20">ড্যাশবোর্ড</a>
                    <% } else { %>
                        <a href="/login"
                            class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">লগইন</a>
                        <a href="/register"
                            class="px-6 py-2.5 btn-premium text-white rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-primary/20">শুরু
                            করুন</a>
                        <% } %>
            </div>
        </nav>
    </header>

    <!-- Hero Section -->
    <main class="pt-32 pb-20 hero-gradient">
        <div class="max-w-[1400px] mx-auto px-10 grid lg:grid-cols-2 gap-20 items-center">
            <div class="space-y-8 animate-fade-in-up">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full border border-primary/20">
                    <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                    <span class="text-[10px] font-black uppercase tracking-widest">আধুনিক শিক্ষার নতুন দিগন্ত</span>
                </div>
                <h1
                    class="text-6xl md:text-8xl font-black tracking-tighter leading-[0.9] text-slate-900 dark:text-white">
                    শিখুন <br><span class="text-primary italic">স্মার্টলি</span><br> সহজ করে।
                </h1>
                <p class="text-lg text-slate-500 dark:text-slate-400 max-w-md font-medium leading-relaxed">
                    ওদ্ধয় আপনাকে দিচ্ছে বিশ্বের সেরা লার্নিং টেকনোলজি এবং বিশেষজ্ঞ মেন্টরদের সান্নিধ্য। আজই আমাদের সাথে
                    আপনার যাত্রা শুরু করুন।
                </p>
                <div class="flex gap-4 pt-4">
                    <a href="/courses"
                        class="px-10 py-5 btn-premium text-white rounded-2xl text-[12px] font-black uppercase tracking-[0.2em] shadow-2xl shadow-primary/25">এক্ষুনি
                        ভর্তি হোন</a>
                    <a href="#featured"
                        class="px-10 py-5 border-2 border-slate-200 dark:border-slate-800 rounded-2xl text-[12px] font-black uppercase tracking-widest hover:border-primary transition-all">কোর্স
                        ব্রাউজ করুন</a>
                </div>
            </div>

            <div class="relative group">
                <div
                    class="absolute -inset-10 bg-primary/20 blur-[100px] rounded-full group-hover:bg-primary/30 transition-all">
                </div>
                <div class="relative glass-card p-12 space-y-8 scale-105">
                    <div class="grid grid-cols-2 gap-6">
                        <div
                            class="p-6 bg-slate-50 dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800">
                            <h4 class="text-3xl font-black text-primary">
                                <%= totalStudents %>+
                            </h4>
                            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-1">সক্রিয়
                                শিক্ষার্থী</p>
                        </div>
                        <div
                            class="p-6 bg-slate-50 dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800">
                            <h4 class="text-3xl font-black text-violet-500">
                                <%= totalCourses %>+
                            </h4>
                            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-1">এক্সপার্ট
                                কোর্স</p>
                        </div>
                    </div>
                    <div class="p-8 bg-primary rounded-[2rem] text-white shadow-2xl shadow-primary/30">
                        <div class="flex items-center gap-4 mb-4">
                            <div
                                class="size-12 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center">
                                <span class="material-symbols-rounded">verified</span>
                            </div>
                            <div>
                                <h5 class="font-black text-lg">সার্টিফাইড লার্নিং</h5>
                                <p class="text-xs text-white/70">জাতীয় কারিকুলাম ভিত্তিক কোর্স</p>
                            </div>
                        </div>
                        <div class="h-2 w-full bg-white/20 rounded-full overflow-hidden">
                            <div class="h-full bg-white w-3/4"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Stats Slider -->
        <div class="max-w-[1400px] mx-auto px-10 mt-32">
            <div class="glass-card p-10 flex flex-wrap justify-around gap-12 items-center">
                <div class="text-center group">
                    <span
                        class="material-symbols-rounded text-4xl text-primary mb-2 block transition-transform group-hover:scale-125">play_circle</span>
                    <h3 class="text-2xl font-black">
                        <%= totalClasses %>+
                    </h3>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">ভিডিও লেসন</p>
                </div>
                <div class="size-px h-16 bg-slate-200 dark:bg-slate-800"></div>
                <div class="text-center group">
                    <span
                        class="material-symbols-rounded text-4xl text-emerald-500 mb-2 block transition-transform group-hover:scale-125">description</span>
                    <h3 class="text-2xl font-black">
                        <%= totalNotes %>+
                    </h3>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">লেকচার নোটস</p>
                </div>
                <div class="size-px h-16 bg-slate-200 dark:bg-slate-800"></div>
                <div class="text-center group">
                    <span
                        class="material-symbols-rounded text-4xl text-amber-500 mb-2 block transition-transform group-hover:scale-125">quiz</span>
                    <h3 class="text-2xl font-black">
                        <%= totalQuizzes %>+
                    </h3>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">মক এক্সাম</p>
                </div>
                <div class="size-px h-16 bg-slate-200 dark:bg-slate-800"></div>
                <div class="text-center group">
                    <span
                        class="material-symbols-rounded text-4xl text-rose-500 mb-2 block transition-transform group-hover:scale-125">support_agent</span>
                    <h3 class="text-2xl font-black">২৪/৭</h3>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">স্টুডেন্ট সাপোর্ট</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Featured Courses -->
    <section id="featured" class="py-32 bg-slate-50 dark:bg-[#0b1120]">
        <div class="max-w-[1400px] mx-auto px-10">
            <div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-20">
                <div class="space-y-3">
                    <h2 class="text-4xl md:text-5xl font-black tracking-tighter leading-none">জনপ্রিয় <br><span
                            class="text-primary">কোর্সসমূহ</span></h2>
                    <p class="text-slate-500 dark:text-slate-400 font-medium max-w-sm">আপনার পছন্দের বিষয়গুলো শিখুন একদম
                        নতুন আঙ্গিকে।</p>
                </div>
                <a href="/courses"
                    class="px-8 py-4 bg-white dark:bg-slate-800 rounded-2xl text-[10px] font-black uppercase tracking-widest border border-slate-100 dark:border-slate-700 hover:border-primary transition-all">সবগুলো
                    দেখুন</a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
                <% courses.forEach(course=> { %>
                    <div class="course-card glass-card overflow-hidden group">
                        <div class="relative aspect-video overflow-hidden">
                            <img src="<%= course.thumbnail %>"
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                            <div
                                class="absolute top-4 left-4 px-4 py-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-xl text-[9px] font-black text-primary uppercase tracking-[0.2em]">
                                <%= course.accessType==='free' ? '🆓 Free Access' : '💳 Premium' %>
                            </div>
                        </div>
                        <div class="p-8">
                            <div class="flex items-center gap-2 mb-4">
                                <% if(course.plans && course.plans.length> 0) { %>
                                    <span class="text-xl font-black text-slate-800 dark:text-white">৳<%=
                                            course.plans[0].price %></span>
                                    <% if(course.plans[0].originalPrice) { %>
                                        <span class="text-xs text-slate-400 line-through">৳<%=
                                                course.plans[0].originalPrice %></span>
                                        <% } %>
                                            <% } %>
                            </div>
                            <h3 class="text-xl font-bold mb-6 line-clamp-2 h-14 tracking-tight">
                                <%= course.title %>
                            </h3>
                            <a href="/course-details/<%= course._id %>"
                                class="w-full py-4 rounded-xl bg-slate-100 dark:bg-slate-800 group-hover:bg-primary group-hover:text-white flex items-center justify-center gap-2 text-[10px] font-black uppercase tracking-widest transition-all">বিস্তারিত
                                দেখুন <span class="material-symbols-rounded">arrow_forward</span></a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-20 border-t border-slate-100 dark:border-slate-800">
        <div class="max-w-[1400px] mx-auto px-10 text-center space-y-8">
            <div class="flex items-center justify-center gap-3">
                <div class="size-10 rounded-xl bg-primary flex items-center justify-center text-white">
                    <span class="material-symbols-rounded">rocket_launch</span>
                </div>
                <span class="font-black text-2xl tracking-tighter uppercase">Oddhay</span>
            </div>
            <p class="text-slate-400 text-sm max-w-md mx-auto">ODDHAY - আধুনিক বিশ্বের সাথে তাল মিলিয়ে শেখার মাধ্যম।
                আমরা বিশ্বাস করি মানসম্মত শিক্ষা সবার অধিকার।</p>
            <div class="flex justify-center gap-8 text-[10px] font-black uppercase tracking-widest text-slate-500">
                <a href="/privacy-policy" class="hover:text-primary">প্রাইভেসি পলিসি</a>
                <a href="/terms" class="hover:text-primary">শর্তাবলী</a>
                <a href="/contact" class="hover:text-primary">যোগাযোগ</a>
            </div>
            <p
                class="text-[10px] text-slate-400 font-bold uppercase tracking-widest pt-8 border-t border-slate-50 dark:border-slate-900">
                &copy; 2026 ODDHAY. All Rights Reserved.</p>
        </div>
    </footer>

    <script>
        // Init Theme
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</body>

</html>