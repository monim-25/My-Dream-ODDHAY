<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>অধ্যায় (ODDHAY) — শেখার নতুন অধ্যায়</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #137fec;
            --primary-dark: #0e66c0;
        }

        body {
            font-family: 'Hind Siliguri', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #FFFFFF;
            color: #1e293b;
            transition: background-color 0.25s ease, color 0.25s ease;
            -webkit-font-smoothing: antialiased;
        }

        .dark body {
            background-color: #0b1120;
            color: #f1f5f9;
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .feature-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-2px);
        }

        .dot-pattern {
            background-image: radial-gradient(rgba(148, 163, 184, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .dark .dot-pattern {
            background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col selection:bg-primary/20 selection:text-primary">

    <!-- 1. Navigation Bar -->
    <header class="sticky top-0 z-50 w-full bg-white/90 dark:bg-[#0b1120]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 shrink-0 select-none">
                <div class="size-9 rounded-xl bg-primary flex items-center justify-center text-white shadow-xs">
                    <span class="material-symbols-rounded text-[20px] pointer-events-none">menu_book</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-lg sm:text-xl tracking-tight text-slate-900 dark:text-white leading-none font-sans">ODDHAY</span>
                    <span class="text-[9px] font-semibold text-primary tracking-wider leading-none mt-0.5">অধ্যায়</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-[13px] font-medium text-slate-600 dark:text-slate-300">
                <a href="#courses" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                <a href="#video-tour" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম অভিজ্ঞতা</a>
                <a href="#features" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                <a href="#question-bank" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">বোর্ড প্রশ্ন</a>
                <a href="#how-it-works" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
            </nav>

            <!-- Right Actions -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                    class="size-9 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer"
                    title="ডার্ক / লাইট মোড পরিবর্তন">
                    <span class="material-symbols-rounded text-[20px] dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded text-[20px] hidden dark:block text-amber-400">light_mode</span>
                </button>

                <% if (locals.user) { %>
                    <% 
                        let dashUrl = '/dashboard';
                        if (user.role === 'teacher') dashUrl = '/teacher';
                        else if (user.role === 'admin') dashUrl = '/admin';
                        else if (user.role === 'superadmin') dashUrl = '/superadmin';
                    %>
                    <a href="<%= dashUrl %>" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs sm:text-[13px] font-semibold transition-all flex items-center gap-1.5 shadow-xs active:scale-95">
                        <span class="material-symbols-rounded text-sm">dashboard</span>
                        <span>ড্যাশবোর্ড</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-[13px] font-semibold text-slate-700 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">
                        লগইন
                    </a>
                    <a href="/register" class="px-3.5 py-1.5 sm:px-4.5 sm:py-2 bg-primary hover:bg-primary-dark text-white text-xs sm:text-[13px] font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                        শুরু করুন
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- 2. Hero Section (Short, Punchy, Focused on অধ্যায়) -->
    <section class="relative pt-12 sm:pt-16 pb-12 sm:pb-16 dot-pattern overflow-hidden">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
            
            <!-- Micro Badge -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900/60 text-primary text-xs font-semibold">
                <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
                <span>অধ্যায় • ডিজিটাল শিক্ষা মাধ্যম</span>
            </div>

            <!-- Short Headline -->
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
                শেখার নতুন অধ্যায়
            </h1>

            <!-- Short Subtext (1-2 lines only) -->
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 font-normal max-w-xl mx-auto leading-relaxed">
                ষষ্ঠ শ্রেণী থেকে এইচএসসি — বোর্ড পরীক্ষা ও একাডেমিক প্রস্তুতির পূর্ণাঙ্গ ডিজিটাল শিক্ষা মাধ্যম।
            </p>

            <!-- Dynamic Class Filter Option (Loaded ONLY from SuperAdmin-configured AcademicClasses) -->
            <div class="pt-2 max-w-3xl mx-auto">
                <div class="flex items-center justify-center gap-2 mb-2">
                    <span class="material-symbols-rounded text-sm text-primary">filter_list</span>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">শ্রেণী নির্বাচন করে রিসোর্স দেখুন:</span>
                </div>

                <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
                    <button type="button" onclick="filterLandingByClass('all', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-primary bg-primary text-white transition-all cursor-pointer shadow-2xs">
                        সকল
                    </button>
                    <% if (locals.activeClasses && activeClasses.length > 0) { %>
                        <% activeClasses.forEach(cls => { %>
                            <button type="button" onclick="filterLandingByClass('<%= cls.name %>', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                                <%= cls.name %>
                            </button>
                        <% }) %>
                    <% } else { %>
                        <button type="button" onclick="filterLandingByClass('Class 6', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">Class 6</button>
                        <button type="button" onclick="filterLandingByClass('Class 7', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">Class 7</button>
                        <button type="button" onclick="filterLandingByClass('Class 8', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">Class 8</button>
                        <button type="button" onclick="filterLandingByClass('Class 9', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">Class 9</button>
                        <button type="button" onclick="filterLandingByClass('Class 10', this)" class="class-filter-pill px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">Class 10</button>
                    <% } %>
                </div>
            </div>

        </div>
    </section>

    <!-- 3. Proof Ribbon (REAL INFO FROM DATABASE) -->
    <section class="border-y border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/30 py-5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
                <div class="p-2">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white leading-tight">
                        <%= totalStudents > 0 ? totalStudents : 1 %>+
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">সক্রিয় শিক্ষার্থী</p>
                </div>
                <div class="p-2 border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-primary leading-tight">
                        <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">ভিডিও লেসন ও ক্লাস</p>
                </div>
                <div class="p-2 border-l-0 md:border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
                        <%= totalQuestions > 0 ? totalQuestions : 30 %>+
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">বোর্ড প্রশ্ন ও সমাধান</p>
                </div>
                <div class="p-2 border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-violet-600 dark:text-violet-400 leading-tight">
                        <%= totalQuizzes > 0 ? totalQuizzes : 0 %>+
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">লাইভ মক টেস্ট</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. "কেন অধ্যায় সেরা" (1-line Head, 1-line Sub + Expandable Cards Button) -->
    <section id="features" class="py-14 sm:py-20 bg-white dark:bg-[#0b1120]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                    কেন অধ্যায় বেছে নেবে?
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1">
                    ক্লাস, বোর্ড প্রশ্ন, পরীক্ষা ও শিক্ষক সহায়তার গোছানো সমন্বয়।
                </p>
            </div>

            <!-- Initial Core Features (3 Cards) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-primary flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">smart_display</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">ভিডিও লেসন ও ক্লাসরুম</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        অধ্যায়ভিত্তিক সাজানো ভিডিও লেসন ও ক্লাস রুটিনের মাধ্যমে বেসিক পরিষ্কার করো।
                    </p>
                </div>

                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">quiz</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">বোর্ড প্রশ্ন ব্যাংক আর্কাইভ</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        সকল শিক্ষা বোর্ডের বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যামূলক সমাধান।
                    </p>
                </div>

                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">timer</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">টাইমারভিত্তিক মক টেস্ট</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        আসল পরীক্ষার মতো টাইমার ও নেগেটিভ মার্কিংযুক্ত পরীক্ষায় নিজের অবস্থান যাচাই।
                    </p>
                </div>
            </div>

            <!-- Extended Features Container (Toggled via button) -->
            <div id="extendedFeaturesGrid" class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-5 hidden animate-fade-in">
                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">forum</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">১-অন-১ মেন্টর চ্যাট</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        পড়ার মাঝে যেকোনো সমস্যায় শিক্ষকের সাথে সরাসরি চ্যাট করে প্রশ্ন সমাধানের সুযোগ।
                    </p>
                </div>

                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">description</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">লেকচার নোটস ও শিট</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        প্রতিটি অধ্যায়ের গুরুত্বপূর্ণ রিভিশন নোটস ও ডাউনলোডযোগ্য পিডিএফ শিট।
                    </p>
                </div>

                <div class="feature-card p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-10 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-3">
                        <span class="material-symbols-rounded text-xl">psychology</span>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">স্মার্ট AI স্টাডি টুল</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        ২৪/৭ যেকোনো কঠিন প্রশ্নের তাৎক্ষণিক ব্যাখ্যা ও সহজবোধ্য সমাধান পাওয়ার টুল।
                    </p>
                </div>
            </div>

            <!-- View All Features Button -->
            <div class="text-center mt-6">
                <button type="button" id="toggleFeaturesBtn" onclick="toggleAllLandingFeatures()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary text-xs font-semibold text-slate-700 dark:text-slate-200 transition-all cursor-pointer shadow-2xs inline-flex items-center gap-1.5">
                    <span id="featuresBtnText">সকল ফিচার দেখুন</span>
                    <span id="featuresBtnIcon" class="material-symbols-rounded text-base">expand_more</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 5. "প্ল্যাটফর্ম অভিজ্ঞতা" (Platform Overview Video - SuperAdmin Controlled) -->
    <section id="video-tour" class="py-14 sm:py-20 bg-slate-50/60 dark:bg-slate-900/30 border-y border-slate-200/80 dark:border-slate-800/80">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            
            <span class="text-xs font-bold text-primary tracking-wider uppercase">প্ল্যাটফর্ম অভিজ্ঞতা</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
                <%= (locals.landingSettings && landingSettings.videoTitle) ? landingSettings.videoTitle : 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1 max-w-lg mx-auto">
                <%= (locals.landingSettings && landingSettings.videoCaption) ? landingSettings.videoCaption : 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %>
            </p>

            <!-- Video Player Box (Dynamic from SuperAdmin or sleek fallback) -->
            <div class="mt-8 rounded-3xl border border-slate-200 dark:border-slate-700/80 bg-slate-950 overflow-hidden shadow-sm aspect-video max-w-3xl mx-auto flex items-center justify-center relative">
                <% 
                    const customVideoUrl = (locals.landingSettings && landingSettings.videoUrl) ? landingSettings.videoUrl.trim() : '';
                    let ytEmbedId = null;
                    if (customVideoUrl.includes('youtube.com/watch')) {
                        const m = customVideoUrl.match(/[?&]v=([^&]+)/);
                        if (m) ytEmbedId = m[1];
                    } else if (customVideoUrl.includes('youtu.be/')) {
                        const parts = customVideoUrl.split('youtu.be/');
                        if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                    } else if (customVideoUrl.includes('youtube.com/embed/')) {
                        const parts = customVideoUrl.split('youtube.com/embed/');
                        if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                    }
                %>

                <% if (ytEmbedId) { %>
                    <iframe src="https://www.youtube.com/embed/<%= ytEmbedId %>?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                <% } else if (customVideoUrl.endsWith('.mp4') || customVideoUrl.endsWith('.webm') || customVideoUrl.includes('cloudinary.com')) { %>
                    <video src="<%= customVideoUrl %>" controls class="w-full h-full object-contain"></video>
                <% } else { %>
                    <!-- Default Attractive Video Mockup Player -->
                    <div class="p-6 text-center text-white space-y-3">
                        <div class="size-14 mx-auto rounded-full bg-primary/25 text-primary flex items-center justify-center mb-2">
                            <span class="material-symbols-rounded text-3xl">play_circle</span>
                        </div>
                        <h4 class="text-base font-bold text-white">অধ্যায় ওভারভিউ ভিডিও</h4>
                        <p class="text-xs text-slate-400 max-w-xs mx-auto">সুপারঅ্যাডমিন প্যানেল থেকে ল্যান্ডিং পেজ কন্ট্রোল সেন্টারে নিজস্ব ভিডিও লিঙ্ক সেট করা যাবে।</p>
                    </div>
                <% } %>
            </div>

        </div>
    </section>

    <!-- 6. "কোর্স ও ব্যাচসমূহ" (Dynamically Filtered Available Courses) -->
    <section id="courses" class="py-14 sm:py-20 bg-white dark:bg-[#0b1120]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                        কোর্স ও ব্যাচসমূহ
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-0.5">
                        <span id="activeFilteredClassText">সকল শ্রেণীর</span> জন্য উপলব্ধ একাডেমিক ও প্রস্তুতি কোর্স
                    </p>
                </div>
                <a href="/courses" class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1 shrink-0">
                    <span>সবগুলো কোর্স দেখুন</span>
                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Course Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="coursesGridContainer">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <% 
                            let courseClassStr = Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '');
                            let primaryPrice = 0;
                            let originalPrice = 0;
                            if (course.plans && course.plans.length > 0) {
                                primaryPrice = course.plans[0].price || 0;
                            } else if (course.price) {
                                primaryPrice = course.discountPrice || course.price;
                                originalPrice = course.price;
                            }
                            let isFree = course.accessType === 'free' || primaryPrice === 0;
                        %>
                        <div class="course-card-item feature-card rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden flex flex-col justify-between"
                             data-class="<%= courseClassStr.toLowerCase() %>">
                            <div class="relative aspect-video bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-rounded text-4xl">auto_stories</span>
                                    </div>
                                <% } %>
                                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-[10px] font-bold <%= isFree ? 'bg-emerald-600 text-white' : 'bg-primary text-white' %>">
                                    <%= isFree ? 'ফ্রি' : 'অনলাইন কোর্স' %>
                                </span>
                            </div>

                            <div class="p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center gap-1.5 text-[10px] font-semibold text-slate-400 mb-1.5">
                                        <span><%= (course.classLevel && course.classLevel[0]) || 'একাডেমিক' %></span>
                                        <span>•</span>
                                        <span><%= (course.subject && course.subject[0]) || 'বিষয়' %></span>
                                    </div>

                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white line-clamp-2 leading-snug">
                                        <%= course.title %>
                                    </h3>

                                    <% if (course.instructor) { %>
                                        <div class="flex items-center gap-1.5 mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                                            <p class="text-xs text-slate-600 dark:text-slate-300 font-medium truncate">
                                                <%= course.instructor.name %>
                                                <% if (course.instructor.designation) { %>
                                                    <span class="text-slate-400 font-normal">• <%= course.instructor.designation %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="mt-3.5 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
                                    <div class="num-font">
                                        <% if (isFree) { %>
                                            <span class="text-xs font-bold text-emerald-600">ফ্রি অ্যাক্সেস</span>
                                        <% } else { %>
                                            <span class="text-sm font-bold text-slate-900 dark:text-white">৳<%= primaryPrice %></span>
                                            <% if (originalPrice > primaryPrice) { %>
                                                <span class="text-xs text-slate-400 line-through ml-1">৳<%= originalPrice %></span>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <a href="/course-details/<%= course._id %>" class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-primary hover:text-white dark:bg-slate-800 dark:hover:bg-primary text-slate-700 dark:text-slate-200 text-xs font-semibold transition-colors">
                                        বিস্তারিত
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-12 text-center text-slate-400 space-y-2">
                        <span class="material-symbols-rounded text-3xl">school</span>
                        <p class="text-xs font-semibold">কোনো কোর্স পাওয়া যায়নি। শীঘ্রই নতুন ব্যাচ যুক্ত হবে।</p>
                    </div>
                <% } %>
            </div>

            <!-- Empty State for Filter mismatch -->
            <div id="noCoursesFilteredMsg" class="hidden py-10 text-center space-y-2">
                <span class="material-symbols-rounded text-3xl text-slate-400">filter_alt_off</span>
                <p class="text-xs font-semibold text-slate-500">এই শ্রেণীর জন্য বর্তমানে কোনো সরাসরি কোর্স নেই। শীঘ্রই নতুন ব্যাচ যুক্ত হচ্ছে।</p>
                <button type="button" onclick="filterLandingByClass('all', document.querySelector('.class-filter-pill'))" class="text-xs text-primary font-bold hover:underline">সকল কোর্স দেখুন</button>
            </div>
        </div>
