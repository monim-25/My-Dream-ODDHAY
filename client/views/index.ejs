<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ODDHAY (অধ্যয়) — জাতীয় কারিকুলাম ও বোর্ড পরীক্ষার স্মার্ট লার্নিং প্ল্যাটফর্ম</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #137fec;
            --primary-dark: #0e66c0;
        }

        body {
            font-family: 'Hind Siliguri', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #FFFFFF;
            color: #1e293b;
            transition: background-color 0.25s ease, color 0.25s ease;
            -webkit-font-smoothing: antialiased;
        }

        .dark body {
            background-color: #0b1120;
            color: #f1f5f9;
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        /* Subtle smooth transition for cards */
        .feature-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-3px);
        }

        /* Clean tab underline */
        .tab-btn.active {
            background-color: #137fec;
            color: #ffffff;
        }

        /* Noise-free background patterns */
        .dot-pattern {
            background-image: radial-gradient(rgba(148, 163, 184, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .dark .dot-pattern {
            background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col selection:bg-primary/20 selection:text-primary">

    <!-- 1. Sleek Navigation Bar -->
    <header class="sticky top-0 z-50 w-full bg-white/90 dark:bg-[#0b1120]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 shrink-0 group select-none">
                <div class="size-9 rounded-xl bg-primary flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
                    <span class="material-symbols-rounded text-[20px] pointer-events-none">menu_book</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-lg sm:text-xl tracking-tight text-slate-900 dark:text-white leading-none font-sans">ODDHAY</span>
                    <span class="text-[9px] font-semibold text-primary tracking-wider leading-none mt-0.5">অধ্যয় • এডটেক</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-[13px] font-medium text-slate-600 dark:text-slate-300">
                <a href="#courses" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                <a href="#question-bank" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">বোর্ড প্রশ্ন ব্যাংক</a>
                <a href="#features" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                <a href="#how-it-works" class="px-3 py-1.5 rounded-lg hover:text-primary hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">কীভাবে শুরু করবে</a>
            </nav>

            <!-- Right Actions -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <!-- Theme Toggle Button -->
                <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                    class="size-9 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer"
                    title="ডার্ক / লাইট মোড পরিবর্তন">
                    <span class="material-symbols-rounded text-[20px] dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded text-[20px] hidden dark:block text-amber-400">light_mode</span>
                </button>

                <% if (locals.user) { %>
                    <!-- User is logged in: direct dashboard link -->
                    <% 
                        let dashUrl = '/dashboard';
                        if (user.role === 'teacher') dashUrl = '/teacher';
                        else if (user.role === 'admin') dashUrl = '/admin';
                        else if (user.role === 'superadmin') dashUrl = '/superadmin';
                    %>
                    <a href="<%= dashUrl %>" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs sm:text-[13px] font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                        <span class="material-symbols-rounded text-sm">dashboard</span>
                        <span>ড্যাশবোর্ড</span>
                    </a>
                <% } else { %>
                    <!-- Logged-out state -->
                    <a href="/login" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-[13px] font-semibold text-slate-700 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">
                        লগইন
                    </a>
                    <a href="/register" class="px-3.5 py-1.5 sm:px-4.5 sm:py-2 bg-primary hover:bg-primary-dark text-white text-xs sm:text-[13px] font-semibold rounded-xl transition-all shadow-sm active:scale-95">
                        শুরু করুন
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- 2. High-Impact Hero Section -->
    <section class="relative pt-10 sm:pt-16 pb-14 sm:pb-20 dot-pattern overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center space-y-5">
                
                <!-- Micro Badge -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900/60 text-primary text-xs font-semibold">
                    <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
                    <span>জাতীয় কারিকুলাম ও বোর্ড পরীক্ষার স্মার্ট প্ল্যাটফর্ম</span>
                </div>

                <!-- Main Headline -->
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.18] sm:leading-[1.15]">
                    সহজ প্রস্তুতি, সেরা ফলাফল。<br>
                    <span class="text-primary font-bold">ষষ্ঠ থেকে এইচএসসি</span> — সবার জন্য ওদ্ধয়।
                </h1>

                <!-- Subtitle (Clean & Concise) -->
                <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 font-normal max-w-2xl mx-auto leading-relaxed">
                    অভিজ্ঞ মেন্টরদের ক্লাস, বিগত বছরের সকল শিক্ষা বোর্ডের প্রশ্ন ব্যাংক, লাইভ মক টেস্ট ও সার্বক্ষণিক শিক্ষক সহায়তায় নিজেকে এগিয়ে রাখো প্রতিদিন।
                </p>

                <!-- Interactive Class & Goal Selector Pills -->
                <div class="pt-3">
                    <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2.5">তোমার ক্লাস বা লক্ষ্য নির্বাচন করো</p>
                    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 max-w-xl mx-auto">
                        <button type="button" onclick="selectLandingClass('all', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-primary text-white transition-all cursor-pointer">
                            সকল ক্লাস
                        </button>
                        <button type="button" onclick="selectLandingClass('Class 6', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            ৬ষ্ঠ শ্রেণী
                        </button>
                        <button type="button" onclick="selectLandingClass('Class 7', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            ৭ম শ্রেণী
                        </button>
                        <button type="button" onclick="selectLandingClass('Class 8', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            ৮ম শ্রেণী
                        </button>
                        <button type="button" onclick="selectLandingClass('Class 9', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            ৯ম শ্রেণী
                        </button>
                        <button type="button" onclick="selectLandingClass('Class 10', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            ১০ম শ্রেণী
                        </button>
                        <button type="button" onclick="selectLandingClass('SSC', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            SSC প্রস্তুতি
                        </button>
                        <button type="button" onclick="selectLandingClass('HSC', this)" class="class-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary transition-all cursor-pointer">
                            HSC প্রস্তুতি
                        </button>
                    </div>
                </div>

                <!-- Call to Action Buttons -->
                <div class="flex flex-wrap items-center justify-center gap-3 pt-3">
                    <a href="#courses" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-all shadow-sm active:scale-95 flex items-center justify-center gap-2">
                        <span>কোর্সসমূহ এক্সপ্লোর করো</span>
                        <span class="material-symbols-rounded text-base">arrow_forward</span>
                    </a>
                    <a href="#question-bank" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-rounded text-base text-slate-500">collections_bookmark</span>
                        <span>বোর্ড প্রশ্ন ব্যাংক দেখো</span>
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. Proof Bar / Live Metric Ribbon -->
    <section class="border-y border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/30 py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
                <div class="p-2">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white leading-tight">
                        <%= totalStudents > 0 ? totalStudents.toLocaleString() + '+' : '১০,০০০+' %>
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">সক্রিয় শিক্ষার্থী</p>
                </div>
                <div class="p-2 border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-primary leading-tight">
                        <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">ভিডিও লেসন ও ক্লাস</p>
                </div>
                <div class="p-2 border-l-0 md:border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
                        <%= totalQuestions > 0 ? totalQuestions.toLocaleString() + '+' : '৫,০০০+' %>
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">বোর্ড প্রশ্ন ও সমাধান</p>
                </div>
                <div class="p-2 border-l border-slate-200/80 dark:border-slate-800">
                    <div class="num-font text-2xl sm:text-3xl font-bold text-violet-600 dark:text-violet-400 leading-tight">
                        <%= totalQuizzes > 0 ? totalQuizzes.toLocaleString() + '+' : '৮০০+' %>
                    </div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">লাইভ মক টেস্ট</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. The 6 Core Pillars (Feature Matrix) -->
    <section id="features" class="py-16 sm:py-24 bg-white dark:bg-[#0b1120]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
                <span class="text-xs font-bold text-primary tracking-wider uppercase">কেন ওদ্ধয় সেরা</span>
                <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mt-1.5">
                    এক প্ল্যাটফর্মে তোমার পূর্ণাঙ্গ প্রস্তুতি
                </h2>
                <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 font-normal mt-2">
                    ক্লাস নেওয়া থেকে শুরু করে পরীক্ষা দেওয়া ও ডাউট সমাধান—সবকিছু নিখুঁতভাবে সাজানো।
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
                
                <!-- Pillar 1 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-primary flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">smart_display</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">লাইভ ও রেকর্ডেড ক্লাস</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        স্টুডিও কোয়ালিটি ভিডিও লেসন এবং সময়মতো অধ্যায়ভিত্তিক ক্লাসের মাধ্যমে বেসিক থেকে অ্যাডভান্সড ক্লিয়ার হবে সহজে।
                    </p>
                </div>

                <!-- Pillar 2 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">quiz</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">বোর্ড প্রশ্ন ব্যাংক আর্কাইভ</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        ঢাকা, চট্টগ্রাম, রাজশাহীসহ সকল শিক্ষা বোর্ডের বিগত বছরের শত শত বোর্ড প্রশ্নের নির্ভুল সমাধান ও ফিল্টারিং সুবিধা।
                    </p>
                </div>

                <!-- Pillar 3 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">timer</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">টাইমারভিত্তিক মক টেস্ট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        আসল পরীক্ষার মতো টাইমার ও নেগেটিভ মার্কিংযুক্ত পরীক্ষা দিয়ে নিজের দুর্বলতা চিহ্নিত করো এবং মার্কস বাড়াও।
                    </p>
                </div>

                <!-- Pillar 4 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">forum</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">১-অন-১ মেন্টর চ্যাট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        পড়ার মাঝে যেকোনো সমস্যায় শিক্ষকের সাথে সরাসরি ইনবক্সে মেসেজ করে প্রশ্ন জিজ্ঞেস ও সমাধান পাওয়ার সুযোগ।
                    </p>
                </div>

                <!-- Pillar 5 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">description</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">লেকচার শিট ও নোটস লাইব্রেরি</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        প্রতিটি বিষয়ের গোছানো রিভিশন নোটস, সাজেশন্স এবং পিডিএফ রিসোর্স যা পরীক্ষার আগের রাতে সবচেয়ে বেশি কাজে দেয়।
                    </p>
                </div>

                <!-- Pillar 6 -->
                <div class="feature-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/40">
                    <div class="size-11 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-rounded text-2xl pointer-events-none">psychology</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">স্মার্ট AI স্টাডি টুল</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        গভীর রাতে পড়তে বসে আটকে গেলে ওদ্ধয়ের AI অ্যাসিস্ট্যান্ট মুহূর্তেই সহজ ভাষায় প্রশ্নের উত্তর ও সমাধান বুঝিয়ে দেবে।
