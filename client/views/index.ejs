                    <div class="size-11 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">forum</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1.5">১-অন-১ মেন্টর চ্যাট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়ার মাঝে যেকোনো কঠিন প্রশ্নে সরাসরি শিক্ষকের সাথে চ্যাট করে ডাউট সমাধান করার সুবিধা।
                    </p>
                </div>

                <!-- Card 8: লেকচার নোটস ও পিডিএফ শিট (Orange Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-orange-500/[0.08] via-orange-500/[0.03] to-white/70 dark:to-slate-900/40 border border-orange-500/20 hover:border-orange-500/40 dark:from-orange-500/[0.13] dark:via-orange-500/[0.04] dark:border-orange-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-orange-500/15 text-orange-600 dark:text-orange-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">description</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1.5">লেকচার নোটস ও শিট</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        প্রতিটি অধ্যায়ের গুরুত্বপূর্ণ রিভিশন নোটস, ফর্মুলা শিট ও ডাউনলোডযোগ্য পিডিএফ শিট।
                    </p>
                </div>

                <!-- Card 9: সার্বক্ষণিক শিক্ষার্থী সহায়তা (Rose Theme - Moved here) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-rose-500/[0.08] via-rose-500/[0.03] to-white/70 dark:to-slate-900/40 border border-rose-500/20 hover:border-rose-500/40 dark:from-rose-500/[0.13] dark:via-rose-500/[0.04] dark:border-rose-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-rose-500/15 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">support_agent</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1.5">সার্বক্ষণিক শিক্ষার্থী সহায়তা</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়াশোনা বা প্ল্যাটফর্ম ব্যবহারে যেকোনো সমস্যায় ডেডিকেটেড সাপোর্ট টিমের সার্বক্ষণিক সহযোগিতা।
