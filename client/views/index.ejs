<!DOCTYPE html>
<html lang="bn" class="light scroll-smooth" style="scroll-behavior: smooth;">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>অধ্যায় (ODDHAY) — শেখার নতুন অধ্যায়</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #18a957;
            --primary-dark: #138745;
        }

        html {
            scroll-behavior: smooth !important;
            scroll-padding-top: 80px;
        }

        #courses, #video-tour, #features, #question-bank, #how-it-works {
            scroll-margin-top: 80px;
        }

        /* 
         * Ultra-HD Typography & Balanced Antialiasing 
         * Crisp and refined without overly harsh or heavy blackish bleed
         */
        body, button, input, select, textarea, .font-sans {
            font-family: 'Inter', 'Noto Sans Bengali', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #fafbfc;
            color: #1e293b;
            transition: background-color 0.25s ease, color 0.25s ease;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .font-bangla, [lang="bn"], .bangla-font {
            font-family: 'Noto Sans Bengali', 'Hind Siliguri', 'Inter', sans-serif !important;
        }

        .dark body {
            background-color: #0b1120;
            color: #f1f5f9;
        }

        /* Refined heading tone: softens deep black into a crisp, modern slate */
        h1, h2, h3, h4 {
            color: #1e293b;
        }
        .dark h1, .dark h2, .dark h3, .dark h4 {
            color: #f8fafc;
        }

        /* 
         * Ultra-HD Clean Canvas: Solid, crisp surfaces with sharp micro-borders
         * Zero murky backdrop-blur sludge
         */
        .hd-surface {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .dark .hd-surface {
            background-color: #0f172a;
            border-color: #1e293b;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
        }
        .hd-surface:hover {
            border-color: #cbd5e1;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 4px 10px -3px rgba(15, 23, 42, 0.04);
            transform: translateY(-2px);
        }
        .dark .hd-surface:hover {
            border-color: #334155;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
        }

        /* Crisp Brand Word Gradient */
        .brand-gradient-word {
            background: linear-gradient(135deg, #18a957 0%, #10b981 50%, #059669 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        /* Prevent double expand icon on selects */
        select.appearance-none {
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            background-image: none !important;
        }
        select.appearance-none::-ms-expand {
            display: none !important;
        }

        /* Responsive course count limiter (4 on mobile/small screen, 8 on desktop/large screen) */
        @media (max-width: 639px) {
            .course-card-desktop-only {
                display: none !important;
            }
        }

        /* Smooth Mobile Course Carousel Scrollbar Hide */
        .no-scrollbar::-webkit-scrollbar {
            display: none !important;
        }
        .no-scrollbar {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col selection:bg-[#18a957]/20 selection:text-[#18a957]">

    <!-- 1. Sleek Navigation Bar with Class Filter Beside Options -->
    <%- include('partials/nav') %>

    <!-- 2. Hero Section: Split 2-Column Layout (Text + Info on one side, Ultra-HD Interactive Platform Showcase on other side) -->
    <section class="relative pt-6 sm:pt-12 md:pt-14 pb-10 sm:pb-16 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80">
        <!-- Crisp subtle top ambient accent -->
        <div class="absolute top-0 inset-x-0 h-40 bg-gradient-to-b from-emerald-500/[0.04] to-transparent pointer-events-none -z-10"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
                
                <!-- Column 1: Text, Buttons & (Desktop-only) Platform Info -->
                <div class="lg:col-span-6 space-y-3 sm:space-y-5 text-left">
                    
                    <!-- Headline: Balanced font-semibold with styled 'অধ্যায়' -->
                    <h1 class="text-[26px] xs:text-[29px] sm:text-[35px] md:text-[40px] lg:text-[46px] font-bold tracking-tight text-slate-800 dark:text-slate-100 leading-[1.22]">
                        শেখার নতুন <span class="brand-gradient-word font-bold">অধ্যায়</span>
                    </h1>

                    <!-- Subtext: 9th to 12th class focused -->
                    <p class="text-[14.5px] xs:text-[15.5px] sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-xl">
                        নবম শ্রেণী থেকে দ্বাদশ শ্রেণী — বোর্ড পরীক্ষা ও একাডেমিক প্রস্তুতির পূর্ণাঙ্গ ডিজিটাল শিক্ষা মাধ্যম।
                    </p>

                    <!-- Call to Action Buttons: Compact auto-width, not stretching widely on small screen -->
                    <div class="pt-1 flex flex-wrap items-center gap-2.5 sm:gap-3">
                        <a href="/register" class="w-auto text-center px-4 sm:px-6 py-2 sm:py-2.5 lg:py-3 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white text-[13px] xs:text-[14px] lg:text-[15px] font-semibold transition-all shadow-sm hover:shadow active:scale-95">
                            শুরু করুন
                        </a>
                        <a href="#courses" class="w-auto text-center px-4 sm:px-6 py-2 sm:py-2.5 lg:py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-850 hover:border-[#18a957] hover:text-[#18a957] text-slate-800 dark:text-slate-100 text-[13px] xs:text-[14px] lg:text-[15px] font-semibold transition-all shadow-2xs">
                            কোর্সসমূহ দেখুন
                        </a>
                    </div>

                    <!-- Informative Metrics Cards (Shown BEFORE the image on all screens) -->
                    <div class="pt-4 sm:pt-5 border-t border-slate-200/90 dark:border-slate-800/90 grid grid-cols-2 sm:grid-cols-4 gap-2 xs:gap-2.5 sm:gap-3">
                        <div class="p-2.5 xs:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-2xs">
                            <div class="num-font text-xl xs:text-[22px] sm:text-2xl font-bold text-slate-800 dark:text-white leading-tight">
                                <%= totalStudents > 0 ? totalStudents : 1 %>+
                            </div>
                            <p class="text-xs xs:text-[13px] sm:text-[13.5px] font-medium text-slate-500 dark:text-slate-400 mt-0.5 truncate">সক্রিয় শিক্ষার্থী</p>
                        </div>

                        <div class="p-2.5 xs:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-2xs">
                            <div class="num-font text-xl xs:text-[22px] sm:text-2xl font-bold text-[#18a957] leading-tight">
                                <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                            </div>
                            <p class="text-xs xs:text-[13px] sm:text-[13.5px] font-medium text-slate-500 dark:text-slate-400 mt-0.5 truncate">ভিডিও লেসন</p>
                        </div>

                        <div class="p-2.5 xs:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-2xs">
                            <div class="num-font text-xl xs:text-[22px] sm:text-2xl font-bold text-teal-600 dark:text-teal-400 leading-tight">
                                <%= totalQuestions > 0 ? totalQuestions : 30 %>+
                            </div>
                            <p class="text-xs xs:text-[13px] sm:text-[13.5px] font-medium text-slate-500 dark:text-slate-400 mt-0.5 truncate">বোর্ড প্রশ্ন</p>
                        </div>

                        <div class="p-2.5 xs:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-2xs">
                            <div class="num-font text-xl xs:text-[22px] sm:text-2xl font-bold text-violet-600 dark:text-violet-400 leading-tight">
                                <%= totalQuizzes > 0 ? totalQuizzes : 0 %>+
                            </div>
                            <p class="text-xs xs:text-[13px] sm:text-[13.5px] font-medium text-slate-500 dark:text-slate-400 mt-0.5 truncate">মক টেস্ট</p>
                        </div>
                    </div>

                </div>

                <!-- Column 2: Ultra-HD Platform Showcase Frame (Enlarged and well-balanced on small screen) -->
                <div class="lg:col-span-6 relative flex items-center justify-center mt-3.5 lg:mt-0 w-full overflow-visible">
                    <% if (locals.landingSettings && landingSettings.heroScreenshotUrl) { %>
                        <% 
                            const heroScale = (typeof landingSettings.heroImageScale === 'number' ? landingSettings.heroImageScale : 100) / 100;
                            const heroMobileScaleNum = typeof landingSettings.heroImageMobileScale === 'number' ? landingSettings.heroImageMobileScale : 100;
                            const heroRotate = typeof landingSettings.heroImageRotate === 'number' ? landingSettings.heroImageRotate : 0;
                            const heroOffsetX = typeof landingSettings.heroImageOffsetX === 'number' ? landingSettings.heroImageOffsetX : 0;
                            const heroOffsetY = typeof landingSettings.heroImageOffsetY === 'number' ? landingSettings.heroImageOffsetY : 0;
                            
                            // Safe physical dimension multipliers for small screen
                            const mobileRatio = heroMobileScaleNum / 100;
                            const mobileMaxWidthPx = Math.round(380 * mobileRatio);
                            const mobileMaxHeightPx = Math.round(340 * mobileRatio);
                        %>
                        <style>
                            @media (max-width: 1023px) {
                                .hero-mobile-img-wrapper {
                                    width: 100%;
                                    max-width: min(100%, <%= mobileMaxWidthPx %>px);
                                    margin-left: auto;
                                    margin-right: auto;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    overflow: visible;
                                }
                                .hero-interactive-img {
                                    width: 100%;
                                    height: auto;
                                    max-height: <%= mobileMaxHeightPx %>px;
                                    object-fit: contain;
                                    image-rendering: -webkit-optimize-contrast;
                                    display: block;
                                }
                            }
                            @media (min-width: 1024px) {
                                .hero-mobile-img-wrapper {
                                    width: 100%;
                                    max-width: none;
                                    overflow: visible;
                                }
                                .hero-interactive-img {
                                    width: auto;
                                    height: auto;
                                    max-width: 100%;
                                    max-height: 560px;
                                    object-fit: contain;
                                    transform: translate(<%= heroOffsetX %>px, <%= heroOffsetY %>px) scale(<%= heroScale %>) rotate(<%= heroRotate %>deg);
                                    image-rendering: -webkit-optimize-contrast;
                                }
                            }
                        </style>
                        <div class="hero-mobile-img-wrapper p-1 sm:p-2 overflow-visible mx-auto">
                            <img src="<%= landingSettings.heroScreenshotUrl %>" 
                                 alt="ODDHAY Platform Visual" 
                                 class="hero-interactive-img drop-shadow-xl select-none mx-auto transition-all duration-200">
                        </div>
                    <% } else { %>
                        <!-- Ultra-HD Crisp Platform Window Showcase (Balanced on small screens) -->
                        <div class="w-full max-w-[360px] xs:max-w-[400px] sm:max-w-md lg:max-w-lg mx-auto select-none">
                            <div class="rounded-2xl sm:rounded-3xl bg-white dark:bg-[#0f172a] border border-slate-200/90 dark:border-slate-800 shadow-xl shadow-slate-200/50 dark:shadow-black/60 overflow-hidden">
                                
                                <!-- App Window Top Bar -->
                                <div class="px-3 sm:px-4 py-2 sm:py-2.5 bg-slate-50 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <span class="size-2 sm:size-2.5 rounded-full bg-red-400 inline-block"></span>
                                        <span class="size-2 sm:size-2.5 rounded-full bg-amber-400 inline-block"></span>
                                        <span class="size-2 sm:size-2.5 rounded-full bg-emerald-400 inline-block"></span>
                                    </div>
                                    <div class="px-2 sm:px-3 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 text-[10px] sm:text-[11px] font-mono text-slate-500 dark:text-slate-400 flex items-center gap-1 min-w-0 truncate">
                                        <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">lock</span>
                                        <span class="truncate">oddhay.com</span>
                                    </div>
                                    <span class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-semibold text-[#18a957] bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full shrink-0">
                                        <span class="size-1.5 rounded-full bg-[#18a957] animate-pulse"></span>
                                        <span>লাইভ</span>
                                    </span>
                                </div>

                                <!-- App Window Inner View -->
                                <div class="p-3 sm:p-4 space-y-2.5 sm:space-y-3">
                                    
                                    <!-- Student Profile & Daily Target Strip -->
                                    <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 dark:bg-slate-850/80 border border-slate-200/70 dark:border-slate-800 flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <div class="size-7 sm:size-8 rounded-full bg-[#18a957] text-white flex items-center justify-center font-bold text-xs shadow-xs shrink-0">
                                                অ
                                            </div>
                                            <div class="min-w-0">
                                                <div class="text-[11.5px] sm:text-xs font-bold text-slate-800 dark:text-white leading-tight truncate">স্বাগতম, শিক্ষার্থী!</div>
                                                <div class="text-[9.5px] sm:text-[10.5px] text-slate-500 dark:text-slate-400 truncate">এইচএসসি ২০২৫ ব্যাচ • বিজ্ঞান</div>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1 shrink-0">
                                            <span class="px-1.5 py-0.5 rounded-lg bg-amber-50 dark:bg-amber-950/50 border border-amber-200/60 dark:border-amber-800/60 text-[9.5px] sm:text-[10.5px] font-bold text-amber-600 dark:text-amber-400">
                                                🔥 ১২ দিন
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Feature: Live Class Player Card -->
                                    <div class="p-2.5 sm:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 space-y-2">
                                        <div class="relative aspect-video rounded-lg bg-slate-900 overflow-hidden flex items-center justify-center">
                                            <div class="absolute inset-0 bg-gradient-to-tr from-[#18a957]/30 to-blue-600/30"></div>
                                            <div class="size-8 sm:size-9 rounded-full bg-white/95 text-[#18a957] flex items-center justify-center shadow-md z-10">
                                                <span class="material-symbols-rounded text-base sm:text-lg">play_arrow</span>
                                            </div>
                                            <span class="absolute bottom-1 left-1.5 text-[9px] font-mono text-white/90 bg-black/60 px-1 py-0.5 rounded">
                                                HD 1080p
                                            </span>
                                        </div>
                                        <div>
                                            <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-[#18a957]">পদার্থবিজ্ঞান ১ম পত্র</span>
                                            <h4 class="text-[11px] sm:text-xs font-semibold text-slate-800 dark:text-white leading-snug mt-0.5">নিউটনিয়ান বলবিদ্যা — লেকচার ০৪</h4>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. "কেন অধ্যায় সেরা" (10 Ultra-HD Solid Cards) -->
    <section id="features" class="pt-14 sm:pt-16 md:pt-20 pb-16 sm:pb-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#0b1120]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-[22px] xs:text-[24px] sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-100">
                    কেন অধ্যায় বেছে নেবে?
                </h2>
                <p class="text-[14.5px] xs:text-[15.5px] sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 font-normal leading-relaxed mt-1.5">
                    ক্লাস, বোর্ড প্রশ্ন, পরীক্ষা ও শিক্ষক সহায়তার গোছানো সমন্বয়।
                </p>
            </div>

            <!-- Initial Core 6 Cards (2 in a line on small screen, 3 on desktop) -->
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 xs:gap-3.5 sm:gap-5">
                
                <!-- Card 1: ভিডিও লেসন ও ক্লাসরুম (Emerald Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 text-[#18a957] dark:text-emerald-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">smart_display</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">ভিডিও লেসন ও ক্লাসরুম</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            অধ্যায়ভিত্তিক সাজানো ভিডিও লেসন ও ক্লাস রুটিনের মাধ্যমে বেসিক পরিষ্কার করো।
                        </p>
                    </div>
                </div>

                <!-- Card 2: বোর্ড প্রশ্ন ব্যাংক আর্কাইভ (Teal Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-teal-50 dark:bg-teal-950/60 border border-teal-200/60 dark:border-teal-800/60 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">quiz</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">বোর্ড প্রশ্ন ব্যাংক আর্কাইভ</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            সকল শিক্ষা বোর্ডের বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যামূলক সমাধান।
                        </p>
                    </div>
                </div>

                <!-- Card 3: টাইমারভিত্তিক মক টেস্ট (Violet Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-violet-50 dark:bg-violet-950/60 border border-violet-200/60 dark:border-violet-800/60 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">timer</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">টাইমারভিত্তিক মক টেস্ট</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            আসল পরীক্ষার মতো টাইমার ও মার্কিংযুক্ত পরীক্ষায় নিজের অবস্থান যাচাই।
                        </p>
                    </div>
                </div>

                <!-- Card 4: কাস্টম এক্সাম ক্রিয়েটর (Blue / Sky Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200/60 dark:border-blue-800/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">tune</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">কাস্টম এক্সাম ক্রিয়েটর</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            নির্দিষ্ট অধ্যায় বা টপিক বেছে নিয়ে নিজের প্রয়োজনমতো কাস্টম পরীক্ষা তৈরি ও অনুশীলন করো।
                        </p>
                    </div>
                </div>

                <!-- Card 5: রুটিন ও টাস্ক প্ল্যানার (Amber Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-amber-50 dark:bg-amber-950/60 border border-amber-200/60 dark:border-amber-800/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">event_available</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">রুটিন ও টাস্ক প্ল্যানার</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            পড়াশোনার সাপ্তাহিক রুটিন, ডেইলি স্টাডি টার্গেট ও চেকলিস্ট ট্র্যাক করে নিয়মানুবর্তী থাকো।
                        </p>
                    </div>
                </div>

                <!-- Card 6: স্মার্ট AI স্টাডি অ্যাসিস্ট্যান্ট (Purple Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-6 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-11 rounded-lg sm:rounded-xl bg-purple-50 dark:bg-purple-950/60 border border-purple-200/60 dark:border-purple-800/60 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-2 sm:mb-4">
                            <span class="material-symbols-rounded text-lg xs:text-xl sm:text-2xl">psychology</span>
                        </div>
                        <h3 class="text-[14px] xs:text-[15px] sm:text-[17px] font-bold text-slate-800 dark:text-slate-100 mb-1 sm:mb-1.5 leading-snug line-clamp-1 sm:line-clamp-none">স্মার্ট AI স্টাডি অ্যাসিস্ট্যান্ট</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[14px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            যেকোনো জটিল প্রশ্নের সহজ ব্যাখ্যা ও পড়ার পরামর্শ পেতে সার্বক্ষণিক এআই সহায়তা।
                        </p>
                    </div>
                </div>

            </div>

            <!-- Extended Features Container (Additional 4 Cards, 2 in a line on small screen) -->
            <div id="extendedFeatures" class="hidden grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 xs:gap-3.5 sm:gap-5 mt-2.5 sm:mt-5">
                
                <!-- Card 7: ১-অন-১ মেন্টর ও ডাউট সমাধান (Indigo Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-5 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-10 rounded-lg sm:rounded-xl bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/60 dark:border-indigo-800/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-2 sm:mb-3.5">
                            <span class="material-symbols-rounded text-base xs:text-lg sm:text-xl">support_agent</span>
                        </div>
                        <h3 class="text-[13.5px] xs:text-[14px] sm:text-[15px] font-bold text-slate-800 dark:text-slate-100 mb-1 leading-snug line-clamp-1 sm:line-clamp-none">১-অন-১ মেন্টর ও ডাউট সমাধান</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            পড়াশোনায় আটকে গেলে অভিজ্ঞ শিক্ষকদের সরাসরি সহায়তা ও সমস্যা সমাধান।
                        </p>
                    </div>
                </div>

                <!-- Card 8: লেকচার নোটস ও পিডিএফ শিট (Orange Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-5 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-10 rounded-lg sm:rounded-xl bg-orange-50 dark:bg-orange-950/60 border border-orange-200/60 dark:border-orange-800/60 text-orange-600 dark:text-orange-400 flex items-center justify-center mb-2 sm:mb-3.5">
                            <span class="material-symbols-rounded text-base xs:text-lg sm:text-xl">description</span>
                        </div>
                        <h3 class="text-[13.5px] xs:text-[14px] sm:text-[15px] font-bold text-slate-800 dark:text-slate-100 mb-1 leading-snug line-clamp-1 sm:line-clamp-none">লেকচার নোটস ও পিডিএফ শিট</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            প্রতিটি ক্লাসের সাথে নির্ভুল সাজানো হ্যান্ডনোট, সামারি ও কুইক রিভিশন শিট।
                        </p>
                    </div>
                </div>

                <!-- Card 9: সার্বক্ষণিক শিক্ষার্থী সহায়তা (Rose Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-5 rounded-xl sm:rounded-2xl flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-10 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200/60 dark:border-rose-800/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-2 sm:mb-3.5">
                            <span class="material-symbols-rounded text-base xs:text-lg sm:text-xl">help</span>
                        </div>
                        <h3 class="text-[13.5px] xs:text-[14px] sm:text-[15px] font-bold text-slate-800 dark:text-slate-100 mb-1 leading-snug line-clamp-1 sm:line-clamp-none">সার্বক্ষণিক শিক্ষার্থী সহায়তা</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            প্ল্যাটফর্মের ব্যবহার বা কোর্স সংক্রান্ত যেকোনো প্রয়োজনে সার্বক্ষণিক সাপোর্ট টিম।
                        </p>
                    </div>
                </div>

                <!-- Card 10: আরও অসংখ্য স্মার্ট ফিচার (Cyan Theme) -->
                <div class="hd-surface p-3 xs:p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border-emerald-500/30 flex flex-col justify-between">
                    <div>
                        <div class="size-8 xs:size-9 sm:size-10 rounded-lg sm:rounded-xl bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200/60 dark:border-cyan-800/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-2 sm:mb-3.5">
                            <span class="material-symbols-rounded text-base xs:text-lg sm:text-xl">stars</span>
                        </div>
                        <h3 class="text-[13.5px] xs:text-[14px] sm:text-[15px] font-bold text-slate-800 dark:text-slate-100 mb-1 leading-snug line-clamp-1 sm:line-clamp-none">আরও অসংখ্য স্মার্ট ফিচার</h3>
                        <p class="text-[12.5px] xs:text-[13px] sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                            পরীক্ষার প্রস্তুতিকে একধাপ এগিয়ে রাখতে অধ্যায় নিয়ে এসেছে সকল আধুনিক সমাধান।
                        </p>
                    </div>
                </div>

            </div>

            <!-- View All Features Button -->
            <div class="text-center mt-6 sm:mt-8">
                <button type="button" id="toggleFeaturesBtn" onclick="toggleExtendedFeatures()" 
                    class="w-full xs:w-auto justify-center inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-[#18a957] text-[13px] xs:text-[13.5px] sm:text-sm font-semibold text-slate-800 dark:text-slate-200 transition-all shadow-2xs">
                    <span id="featuresBtnText">আরও ৪টি গুরুত্বপূর্ণ ফিচার দেখুন</span>
                    <span id="featuresBtnIcon" class="material-symbols-rounded text-lg transition-transform duration-200">expand_more</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 4. প্ল্যাটফর্ম ওভারভিউ ভিডিও (Split 2-Column: Video at Left, Title & Caption at Right) -->
    <section id="video-tour" class="py-16 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-50/70 dark:bg-[#091122]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left Column: Video Player Box -->
                <div class="lg:col-span-7 relative">
                    <div class="relative group">
                        <!-- Video Player Container (16:9 Aspect Ratio) -->
                        <div class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-950 overflow-hidden shadow-xl aspect-video w-full flex items-center justify-center relative">
                            <% 
                                const customVideoUrl = (locals.landingSettings && landingSettings.videoUrl) ? landingSettings.videoUrl.trim() : '';
                                let ytEmbedId = null;
                                if (customVideoUrl.includes('youtube.com/watch')) {
                                    const m = customVideoUrl.match(/[?&]v=([^&]+)/);
                                    if (m) ytEmbedId = m[1];
                                } else if (customVideoUrl.includes('youtu.be/')) {
                                    const parts = customVideoUrl.split('youtu.be/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                } else if (customVideoUrl.includes('youtube.com/embed/')) {
                                    const parts = customVideoUrl.split('youtube.com/embed/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                }
                            %>

                            <% if (ytEmbedId) { %>
                                <iframe src="https://www.youtube.com/embed/<%= ytEmbedId %>?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                            <% } else if (customVideoUrl.endsWith('.mp4') || customVideoUrl.endsWith('.webm') || customVideoUrl.includes('cloudinary.com')) { %>
                                <video src="<%= customVideoUrl %>" controls class="w-full h-full object-contain"></video>
                            <% } else { %>
                                <!-- Default Video Mockup Player -->
                                <div class="p-6 text-center text-white space-y-3">
                                    <div class="size-14 mx-auto rounded-full bg-[#18a957] text-white flex items-center justify-center mb-2 shadow-lg">
                                        <span class="material-symbols-rounded text-3xl">play_arrow</span>
                                    </div>
                                    <h4 class="text-base font-bold text-white">অধ্যায় ওভারভিউ ভিডিও</h4>
                                    <p class="text-xs text-slate-400 max-w-xs mx-auto font-normal">সুপারঅ্যাডমিন প্যানেলের Landing Page Control Center থেকে নিজস্ব ভিডিও লিঙ্ক যুক্ত করা যাবে।</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Title & Caption Text -->
                <div class="lg:col-span-5 space-y-4 text-left">
                    <h2 class="text-[22px] xs:text-[24px] sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        <%= (locals.landingSettings && landingSettings.videoTitle) ? landingSettings.videoTitle : 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>
                    </h2>
                    <p class="text-[14.5px] xs:text-[15.5px] sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
                        <%= (locals.landingSettings && landingSettings.videoCaption) ? landingSettings.videoCaption : 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %>
                    </p>

                    <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center gap-2 text-[13px] xs:text-[13.5px] font-semibold text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-rounded text-[#18a957] text-lg shrink-0">check_circle</span>
                        <span>প্ল্যাটফর্মের সকল সুবিধা ও ব্যবহারবিধি এক ভিডিওতেই</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 5. "কোর্স ও ব্যাচসমূহ" (Professional, Perfectly Sized 4-Column Grid) -->
    <section id="courses" class="py-14 sm:py-18 bg-white dark:bg-[#0b1120]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
                <div>
                    <h2 class="text-[22px] xs:text-[24px] sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-100">
                        কোর্স ও ব্যাচসমূহ
                    </h2>
                    <p class="text-[14.5px] xs:text-[15.5px] sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 font-normal leading-relaxed mt-1">
                        তোমার ক্লাসের জন্য সেরা একাডেমিক ও বোর্ড স্পেশাল কোর্স।
                    </p>
                </div>
                
                <!-- Link to all courses (Dynamically filtered by active class - Hidden on small screen, visible on desktop) -->
                <a href="/courses" id="allCoursesLink" class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-[#18a957] hover:underline shrink-0">
                    <span>সকল কোর্স দেখুন</span>
                    <span class="material-symbols-rounded text-base">arrow_forward</span>
                </a>
            </div>

            <!-- Course Cards: Interactive Touch Carousel on Small Screen, Multi-Column Grid on Larger Screens -->
            <div id="landingCoursesContainer" class="flex sm:grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-5 overflow-x-auto sm:overflow-visible pb-2 sm:pb-0 px-4 sm:px-0 -mx-4 sm:mx-0 snap-x snap-mandatory scroll-smooth no-scrollbar">
                <% 
                    const courseItems = (locals.courses && courses.length > 0) ? courses : (locals.featuredCourses || []);
                    const displayCourses = courseItems.slice(0, 8);
                %>
                <% if (displayCourses && displayCourses.length > 0) { %>
                    <% displayCourses.forEach((course, index) => { 
                            let isFree = (course.accessType === 'free' || !course.price || course.price === 0);
                            let subjectName = (course.subject && Array.isArray(course.subject) ? course.subject[0] : course.subject) || 'সাধারণ বিষয়';
                            let courseClassStr = '';
                            if (course.classLevel) {
                                if (Array.isArray(course.classLevel)) courseClassStr = course.classLevel.join(' ');
                                else courseClassStr = String(course.classLevel);
                            }
                            let className = (course.classLevel && Array.isArray(course.classLevel) ? course.classLevel[0] : course.classLevel) || 'সকল শ্রেণী';
                            const isDesktopOnly = index >= 4;
                        %>
                        <div class="course-card-item <%= isDesktopOnly ? 'course-card-desktop-only hidden sm:flex' : 'flex' %> shrink-0 sm:shrink snap-center sm:snap-align-none w-[78vw] max-w-[290px] xs:w-[260px] sm:w-auto min-w-[240px] sm:min-w-0 group rounded-xl sm:rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-[#0f172a] hover:border-[#18a957]/60 hover:shadow-xl dark:hover:shadow-black/50 overflow-hidden flex-col justify-between transition-all duration-300"
                             data-class="<%= courseClassStr.toLowerCase() %>">
                            
                            <!-- Thumbnail Area -->
                            <div class="relative aspect-[16/9] w-full bg-slate-900 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" style="image-rendering: -webkit-optimize-contrast;">
                                <% } else { %>
                                    <!-- High-definition geometric course banner -->
                                    <div class="w-full h-full flex flex-col items-center justify-center p-2 sm:p-4 bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 text-white relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                                        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
                                        <div class="relative z-10 flex flex-col items-center text-center">
                                            <span class="material-symbols-rounded text-xl sm:text-3xl mb-0.5 sm:mb-1 text-emerald-300 drop-shadow-sm">school</span>
                                            <span class="text-[10px] sm:text-xs font-bold tracking-wide uppercase text-white/90 font-mono"><%= subjectName %></span>
                                        </div>
                                    </div>
                                <% } %>
                                
                                <!-- Top Badges -->
                                <div class="absolute top-1.5 left-1.5 right-1.5 flex items-center justify-between gap-1 pointer-events-none">
                                    <span class="px-1.5 sm:px-2 py-0.5 rounded text-[11px] xs:text-[11.5px] sm:text-[10.5px] font-bold <%= isFree ? 'bg-[#18a957] text-white' : 'bg-slate-950 text-white' %> shadow-sm truncate max-w-[65px] xs:max-w-none">
                                        <%= isFree ? 'ফ্রি' : 'অনলাইন' %>
                                    </span>
                                    <span class="px-1.5 sm:px-2 py-0.5 rounded text-[11px] xs:text-[11.5px] sm:text-[10.5px] font-bold bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 shadow-sm border border-slate-200/60 dark:border-slate-700 truncate max-w-[70px] xs:max-w-none">
                                        <%= className %>
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-2.5 xs:p-3 sm:p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <!-- Subject Tag -->
                                    <div class="flex items-center gap-1 text-[12px] xs:text-[12.5px] sm:text-[12.5px] font-semibold text-slate-500 dark:text-slate-400 mb-0.5 sm:mb-1">
                                        <span class="text-[#18a957] font-bold truncate"><%= subjectName %></span>
                                        <span>•</span>
                                        <span class="truncate"><%= className %></span>
                                    </div>

                                    <!-- Course Title -->
                                    <h3 class="text-[14px] xs:text-[14.5px] sm:text-base font-bold text-slate-800 dark:text-slate-100 line-clamp-2 leading-snug group-hover:text-[#18a957] transition-colors">
                                        <%= course.title %>
                                    </h3>

                                    <!-- Instructor Row -->
                                    <% if (course.instructor && course.instructor.name) { %>
                                        <div class="flex items-center gap-1 mt-1 sm:mt-2 text-[12px] xs:text-[12.5px] sm:text-xs text-slate-500 dark:text-slate-400">
                                            <span class="material-symbols-rounded text-xs text-slate-400">person</span>
                                            <span class="truncate"><%= course.instructor.name %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Footer: Price & Details Button -->
                                <div class="mt-2.5 sm:mt-4 pt-2 sm:pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-1">
                                    <div class="min-w-0">
                                        <% if (isFree) { %>
                                            <span class="text-[13.5px] xs:text-sm font-bold text-[#18a957] truncate block">ফ্রি</span>
                                        <% } else { %>
                                            <div class="flex items-baseline gap-1">
                                                <span class="num-font text-[13.5px] xs:text-sm sm:text-base font-bold text-slate-800 dark:text-white truncate">
