<!DOCTYPE html>
<html lang="bn" class="light scroll-smooth" style="scroll-behavior: smooth;">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>অধ্যায় (ODDHAY) — শেখার নতুন অধ্যায়</title>
    <%- include('partials/head') %>
    <style>
        :root {
            --primary: #18a957;
            --primary-dark: #138745;
        }

        html {
            scroll-behavior: smooth !important;
            scroll-padding-top: 80px;
        }

        #courses, #video-tour, #features, #question-bank, #how-it-works {
            scroll-margin-top: 80px;
        }

        body, button, input, select, textarea, .font-sans {
            font-family: 'Inter', 'Noto Sans Bengali', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8faff;
            color: #1e293b;
            transition: background-color 0.3s ease, color 0.3s ease;
            -webkit-font-smoothing: antialiased;
        }

        .font-bangla, [lang="bn"], .bangla-font {
            font-family: 'Noto Sans Bengali', 'Hind Siliguri', 'Inter', sans-serif !important;
        }

        /* 
         * Rich, inspirational background reflecting intellect, youthful energy, 
         * education, resilience, and the story to success.
         */
        .dark body {
            background-color: #091122;
            color: #e2e8f0;
        }

        /* Luminous ambient education & youth aura mesh */
        .academic-aura-bg {
            background: 
                radial-gradient(ellipse 60% 45% at 50% -10%, rgba(24, 169, 87, 0.12), transparent 70%),
                radial-gradient(ellipse 40% 35% at 15% 25%, rgba(19, 127, 236, 0.10), transparent 60%),
                radial-gradient(ellipse 35% 30% at 85% 35%, rgba(245, 158, 11, 0.08), transparent 60%);
        }

        .dark .academic-aura-bg {
            background: 
                radial-gradient(ellipse 65% 50% at 50% -10%, rgba(20, 100, 220, 0.28), transparent 70%),
                radial-gradient(ellipse 45% 40% at 10% 30%, rgba(124, 58, 237, 0.18), transparent 65%),
                radial-gradient(ellipse 40% 35% at 90% 40%, rgba(24, 169, 87, 0.15), transparent 60%),
                radial-gradient(ellipse 55% 45% at 50% 85%, rgba(16, 185, 129, 0.10), transparent 70%);
        }

        .num-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .feature-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-2px);
        }

        /* Soft subtle dot constellation for thought & structure */
        .constellation-dots {
            background-image: radial-gradient(rgba(24, 169, 87, 0.12) 1px, transparent 1px);
            background-size: 26px 26px;
        }
        .dark .constellation-dots {
            background-image: radial-gradient(rgba(52, 211, 153, 0.08) 1px, transparent 1px);
        }

        /* Prevent double expand icon on selects in all browsers */
        select.appearance-none {
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            background-image: none !important;
        }
        select.appearance-none::-ms-expand {
            display: none !important;
        }

        /* Highlighted brand word gradient */
        .brand-gradient-word {
            background: linear-gradient(135deg, #18a957 0%, #10b981 45%, #06b6d4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden flex flex-col academic-aura-bg selection:bg-[#18a957]/20 selection:text-[#18a957]">

    <!-- 1. Sleek Navigation Bar with Class Filter Beside Options -->
    <%- include('partials/nav') %>

    <!-- 2. Hero Section: Split 2-Column Layout (Text + Info on one side, SuperAdmin Screenshot on other side) -->
    <section class="relative pt-10 sm:pt-14 md:pt-16 pb-12 sm:pb-14 md:pb-16 constellation-dots overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Column 1: Text, Buttons & Integrated Platform Info -->
                <div class="lg:col-span-6 space-y-5 text-left">
                    
                    <!-- Headline: Balanced font-semibold with styled 'অধ্যায়' -->
                    <h1 class="text-[28px] sm:text-[36px] md:text-[40px] lg:text-[44px] font-semibold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        শেখার নতুন <span class="brand-gradient-word font-semibold">অধ্যায়</span>
                    </h1>

                    <!-- Subtext: 9th to 12th class focused -->
                    <p class="text-[15px] sm:text-base md:text-[17px] text-slate-500 dark:text-slate-400 font-normal leading-relaxed max-w-xl">
                        নবম শ্রেণী থেকে দ্বাদশ শ্রেণী — বোর্ড পরীক্ষা ও একাডেমিক প্রস্তুতির পূর্ণাঙ্গ ডিজিটাল শিক্ষা মাধ্যম।
                    </p>

                    <!-- Call to Action Buttons -->
                    <div class="pt-1 flex flex-wrap items-center gap-3">
                        <a href="/register" class="px-6 py-2.5 sm:py-3 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white text-sm sm:text-[15px] font-semibold transition-all shadow-xs active:scale-95">
                            শুরু করুন
                        </a>
                        <a href="#courses" class="px-6 py-2.5 sm:py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 hover:border-[#18a957] text-slate-700 dark:text-slate-200 text-sm sm:text-[15px] font-semibold transition-all shadow-2xs">
                            কোর্সসমূহ দেখুন
                        </a>
                    </div>

                    <!-- Platform Info Metrics (Real Database Info Integrated into Hero) -->
                    <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="p-2.5 sm:p-3 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-xl sm:text-2xl font-semibold text-slate-800 dark:text-slate-100 leading-tight">
                                <%= totalStudents > 0 ? totalStudents : 1 %>+
                            </div>
                            <p class="text-xs sm:text-[13px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">সক্রিয় শিক্ষার্থী</p>
                        </div>

                        <div class="p-2.5 sm:p-3 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-xl sm:text-2xl font-semibold text-[#18a957] leading-tight">
                                <%= totalClasses > 0 ? totalClasses.toLocaleString() + '+' : '১,২০০+' %>
                            </div>
                            <p class="text-xs sm:text-[13px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">ভিডিও লেসন</p>
                        </div>

                        <div class="p-2.5 sm:p-3 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-xl sm:text-2xl font-semibold text-teal-600 dark:text-teal-400 leading-tight">
                                <%= totalQuestions > 0 ? totalQuestions : 30 %>+
                            </div>
                            <p class="text-xs sm:text-[13px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">বোর্ড প্রশ্ন</p>
                        </div>

                        <div class="p-2.5 sm:p-3 rounded-xl bg-white/60 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60">
                            <div class="num-font text-xl sm:text-2xl font-semibold text-violet-600 dark:text-violet-400 leading-tight">
                                <%= totalQuizzes > 0 ? totalQuizzes : 0 %>+
                            </div>
                            <p class="text-xs sm:text-[13px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">মক টেস্ট</p>
                        </div>
                    </div>

                </div>

                <!-- Column 2: Unboxed, Organic Hero Visual Area (Full PNG Image, No Box Constraints) -->
                <div class="lg:col-span-6 relative flex items-center justify-center">
                    <!-- Soft Ambient Glow Mesh Behind the Image -->
                    <div class="absolute -inset-4 sm:-inset-8 bg-gradient-to-tr from-[#18a957]/15 via-blue-500/10 to-violet-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

                    <% if (locals.landingSettings && landingSettings.heroScreenshotUrl) { %>
                        <% 
                            const heroScale = (typeof landingSettings.heroImageScale === 'number' ? landingSettings.heroImageScale : 100) / 100;
                            const heroRotate = typeof landingSettings.heroImageRotate === 'number' ? landingSettings.heroImageRotate : 0;
                            const heroOffsetX = typeof landingSettings.heroImageOffsetX === 'number' ? landingSettings.heroImageOffsetX : 0;
                            const heroOffsetY = typeof landingSettings.heroImageOffsetY === 'number' ? landingSettings.heroImageOffsetY : 0;
                        %>
                        <!-- Whole Picture Rendered: Sized, Rotated and Positioned Exactly as SuperAdmin Configured -->
                        <div class="w-full flex items-center justify-center p-2 overflow-visible">
                            <img src="<%= landingSettings.heroScreenshotUrl %>" 
                                 alt="ODDHAY Platform Visual" 
                                 style="transform: translate(<%= heroOffsetX %>px, <%= heroOffsetY %>px) scale(<%= heroScale %>) rotate(<%= heroRotate %>deg); transform-origin: center center;"
                                 class="w-full h-auto max-h-[480px] sm:max-h-[540px] lg:max-h-[580px] object-contain drop-shadow-2xl transition-transform duration-200 select-none">
                        </div>
                    <% } else { %>
                        <!-- Default Clean Floating Mockup Graphic when no image is uploaded yet -->
                        <div class="w-full max-w-lg mx-auto p-2 sm:p-4 text-center select-none">
                            <div class="relative mx-auto rounded-3xl p-6 bg-gradient-to-tr from-white/80 to-white/50 dark:from-slate-900/80 dark:to-slate-850/50 backdrop-blur-md border border-slate-200/70 dark:border-slate-700/60 shadow-xl drop-shadow-xl space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-slate-800 pb-3">
                                    <div class="flex items-center gap-2">
                                        <div class="size-8 rounded-xl bg-[#18a957] text-white flex items-center justify-center shadow-xs">
                                            <span class="material-symbols-rounded text-lg">school</span>
                                        </div>
                                        <span class="font-semibold text-sm text-slate-800 dark:text-white">অধ্যায় ডিজিটাল প্ল্যাটফর্ম</span>
                                    </div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-100/70 dark:bg-emerald-950/70 text-[#18a957] text-xs font-semibold">লাইভ ব্যাচ ৯-১২</span>
                                </div>

                                <div class="grid grid-cols-2 gap-3 text-left">
                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-[#18a957]">
                                            <span class="text-xs font-semibold">স্মার্ট ক্লাস</span>
                                            <span class="material-symbols-rounded text-sm">smart_display</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">অধ্যায়ভিত্তিক লেকচার ও রিভিশন শিট</p>
                                    </div>

                                    <div class="p-3 rounded-2xl bg-white/90 dark:bg-slate-800/90 border border-slate-100 dark:border-slate-700/60 shadow-xs space-y-1.5">
                                        <div class="flex items-center justify-between text-teal-600">
                                            <span class="text-xs font-semibold">প্রশ্ন ব্যাংক</span>
                                            <span class="material-symbols-rounded text-sm">quiz</span>
                                        </div>
                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-snug">বিগত বছরের সকল বোর্ড প্রশ্ন সমাধান</p>
                                    </div>
                                </div>

                                <div class="pt-2 text-[11px] text-slate-400 font-normal">
                                    সুপারএডমিন প্যানেল থেকে যেকোনো স্বচ্ছ PNG বা ছবি আপলোড করলে তা সরাসরি এখানে সুন্দরভাবে প্রদর্শিত হবে।
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. "কেন অধ্যায় সেরা" (6 Core Cards + Extended Cards) -->
    <section id="features" class="pt-14 sm:pt-16 md:pt-20 pb-16 sm:pb-20 border-t border-slate-200/80 dark:border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                    কেন অধ্যায় বেছে নেবে?
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1.5">
                    ক্লাস, বোর্ড প্রশ্ন, পরীক্ষা ও শিক্ষক সহায়তার গোছানো সমন্বয়।
                </p>
            </div>

            <!-- Initial Core 6 Cards (3x2 Grid on desktop) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                
                <!-- Card 1: ভিডিও লেসন ও ক্লাসরুম (Emerald Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-emerald-500/[0.08] via-emerald-500/[0.03] to-white/70 dark:to-slate-900/40 border border-emerald-500/20 hover:border-emerald-500/40 dark:from-emerald-500/[0.13] dark:via-emerald-500/[0.04] dark:border-emerald-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-emerald-500/15 text-[#18a957] dark:text-emerald-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">smart_display</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">ভিডিও লেসন ও ক্লাসরুম</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        অধ্যায়ভিত্তিক সাজানো ভিডিও লেসন ও ক্লাস রুটিনের মাধ্যমে বেসিক পরিষ্কার করো।
                    </p>
                </div>

                <!-- Card 2: বোর্ড প্রশ্ন ব্যাংক আর্কাইভ (Teal Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-teal-500/[0.08] via-teal-500/[0.03] to-white/70 dark:to-slate-900/40 border border-teal-500/20 hover:border-teal-500/40 dark:from-teal-500/[0.13] dark:via-teal-500/[0.04] dark:border-teal-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-teal-500/15 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">quiz</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">বোর্ড প্রশ্ন ব্যাংক আর্কাইভ</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        সকল শিক্ষা বোর্ডের বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যামূলক সমাধান।
                    </p>
                </div>

                <!-- Card 3: টাইমারভিত্তিক মক টেস্ট (Violet Theme - Updated Text) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-violet-500/[0.08] via-violet-500/[0.03] to-white/70 dark:to-slate-900/40 border border-violet-500/20 hover:border-violet-500/40 dark:from-violet-500/[0.13] dark:via-violet-500/[0.04] dark:border-violet-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-violet-500/15 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">timer</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">টাইমারভিত্তিক মক টেস্ট</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        আসল পরীক্ষার মতো টাইমার ও মার্কিংযুক্ত পরীক্ষায় নিজের অবস্থান যাচাই।
                    </p>
                </div>

                <!-- Card 4: কাস্টম এক্সাম ক্রিয়েটর (Blue / Sky Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-blue-500/[0.08] via-blue-500/[0.03] to-white/70 dark:to-slate-900/40 border border-blue-500/20 hover:border-blue-500/40 dark:from-blue-500/[0.13] dark:via-blue-500/[0.04] dark:border-blue-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">tune</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">কাস্টম এক্সাম ক্রিয়েটর</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        নির্দিষ্ট অধ্যায় বা টপিক বেছে নিয়ে নিজের প্রয়োজনমতো কাস্টম পরীক্ষা তৈরি ও অনুশীলন করো।
                    </p>
                </div>

                <!-- Card 5: রুটিন ও টাস্ক প্ল্যানার (Amber Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-amber-500/[0.08] via-amber-500/[0.03] to-white/70 dark:to-slate-900/40 border border-amber-500/20 hover:border-amber-500/40 dark:from-amber-500/[0.13] dark:via-amber-500/[0.04] dark:border-amber-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">event_available</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">রুটিন ও টাস্ক প্ল্যানার</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়াশোনার সাপ্তাহিক রুটিন, ডেইলি স্টাডি টার্গেট ও চেকলিস্ট ট্র্যাক করে নিয়মানুবর্তী থাকো।
                    </p>
                </div>

                <!-- Card 6: স্মার্ট AI স্টাডি অ্যাসিস্ট্যান্ট (Purple Theme - Replaced Here) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-purple-500/[0.08] via-purple-500/[0.03] to-white/70 dark:to-slate-900/40 border border-purple-500/20 hover:border-purple-500/40 dark:from-purple-500/[0.13] dark:via-purple-500/[0.04] dark:border-purple-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-purple-500/15 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">psychology</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">স্মার্ট AI স্টাডি অ্যাসিস্ট্যান্ট</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        ২৪/৭ যেকোনো কঠিন প্রশ্নের তাৎক্ষণিক ব্যাখ্যা ও সহজবোধ্য সমাধান পাওয়ার স্মার্ট সহায়ক টুল।
                    </p>
                </div>

            </div>

            <!-- Extended Features Container (Additional 4 Cards, toggled via button) -->
            <div id="extendedFeaturesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-5 hidden animate-fade-in">
                
                <!-- Card 7: ১-অন-১ মেন্টর ও ডাউট সমাধান (Indigo Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-indigo-500/[0.08] via-indigo-500/[0.03] to-white/70 dark:to-slate-900/40 border border-indigo-500/20 hover:border-indigo-500/40 dark:from-indigo-500/[0.13] dark:via-indigo-500/[0.04] dark:border-indigo-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">forum</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">১-অন-১ মেন্টর চ্যাট</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়ার মাঝে যেকোনো কঠিন প্রশ্নে সরাসরি শিক্ষকের সাথে চ্যাট করে ডাউট সমাধান করার সুবিধা।
                    </p>
                </div>

                <!-- Card 8: লেকচার নোটস ও পিডিএফ শিট (Orange Theme) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-orange-500/[0.08] via-orange-500/[0.03] to-white/70 dark:to-slate-900/40 border border-orange-500/20 hover:border-orange-500/40 dark:from-orange-500/[0.13] dark:via-orange-500/[0.04] dark:border-orange-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-orange-500/15 text-orange-600 dark:text-orange-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">description</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">লেকচার নোটস ও শিট</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        প্রতিটি অধ্যায়ের গুরুত্বপূর্ণ রিভিশন নোটস, ফর্মুলা শিট ও ডাউনলোডযোগ্য পিডিএফ শিট।
                    </p>
                </div>

                <!-- Card 9: সার্বক্ষণিক শিক্ষার্থী সহায়তা (Rose Theme - Moved here) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-rose-500/[0.08] via-rose-500/[0.03] to-white/70 dark:to-slate-900/40 border border-rose-500/20 hover:border-rose-500/40 dark:from-rose-500/[0.13] dark:via-rose-500/[0.04] dark:border-rose-500/30 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-rose-500/15 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4 shadow-2xs">
                        <span class="material-symbols-rounded text-2xl">support_agent</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">সার্বক্ষণিক শিক্ষার্থী সহায়তা</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পড়াশোনা বা প্ল্যাটফর্ম ব্যবহারে যেকোনো সমস্যায় ডেডিকেটেড সাপোর্ট টিমের সার্বক্ষণিক সহযোগিতা।
                    </p>
                </div>

                <!-- Card 10: আরও অসংখ্য স্মার্ট ফিচার (পারফরম্যান্স অ্যানালিটিক্স সহ মোটিভেশনাল কার্ড) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-cyan-500/[0.12] via-emerald-500/[0.06] to-white/80 dark:to-slate-900/50 border border-cyan-500/30 hover:border-cyan-500/50 dark:from-cyan-500/[0.18] dark:via-emerald-500/[0.08] dark:border-cyan-500/40 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-gradient-to-tr from-cyan-500 to-emerald-500 text-white flex items-center justify-center mb-4 shadow-xs">
                        <span class="material-symbols-rounded text-2xl">auto_awesome</span>
                    </div>
                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-800 dark:text-white mb-1.5">আরও অসংখ্য স্মার্ট ফিচার</h3>
                    <p class="text-[13.5px] sm:text-[14px] text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পারফরম্যান্স অ্যানালিটিক্স, দুর্বল অধ্যায় ট্র্যাকিং ও বিস্তারিত প্রগ্রেস রিপোর্ট সহ আরও অনেক দারুণ ফিচার নিয়ে তোমার প্রস্তুতি থাকবে সবসময় সেরা!
                    </p>
                </div>

            </div>

            <!-- View All Features Button -->
            <div class="text-center mt-8">
                <button type="button" id="toggleFeaturesBtn" onclick="toggleAllLandingFeatures()" class="px-6 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-[#18a957] text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200 transition-all cursor-pointer shadow-2xs inline-flex items-center gap-1.5 active:scale-95">
                    <span id="featuresBtnText">সকল ফিচার দেখুন (১০টি)</span>
                    <span id="featuresBtnIcon" class="material-symbols-rounded text-base">expand_more</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 4. প্ল্যাটফর্ম ওভারভিউ ভিডিও (Split 2-Column: Video at Left, Title & Caption at Right) -->
    <section id="video-tour" class="py-16 sm:py-20 border-y border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/30 backdrop-blur-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left Column: Video Player Box -->
                <div class="lg:col-span-7 relative">
                    <div class="relative group">
                        <!-- Soft Ambient Glow -->
                        <div class="absolute -inset-1.5 bg-gradient-to-r from-[#18a957]/20 via-blue-500/15 to-violet-500/15 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition duration-500 pointer-events-none -z-10"></div>
                        
                        <!-- Video Player Container (16:9 Aspect Ratio) -->
                        <div class="rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-700/80 bg-slate-950 overflow-hidden shadow-xl aspect-video w-full flex items-center justify-center relative">
                            <% 
                                const customVideoUrl = (locals.landingSettings && landingSettings.videoUrl) ? landingSettings.videoUrl.trim() : '';
                                let ytEmbedId = null;
                                if (customVideoUrl.includes('youtube.com/watch')) {
                                    const m = customVideoUrl.match(/[?&]v=([^&]+)/);
                                    if (m) ytEmbedId = m[1];
                                } else if (customVideoUrl.includes('youtu.be/')) {
                                    const parts = customVideoUrl.split('youtu.be/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                } else if (customVideoUrl.includes('youtube.com/embed/')) {
                                    const parts = customVideoUrl.split('youtube.com/embed/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                }
                            %>

                            <% if (ytEmbedId) { %>
                                <iframe src="https://www.youtube.com/embed/<%= ytEmbedId %>?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                            <% } else if (customVideoUrl.endsWith('.mp4') || customVideoUrl.endsWith('.webm') || customVideoUrl.includes('cloudinary.com')) { %>
                                <video src="<%= customVideoUrl %>" controls class="w-full h-full object-contain"></video>
                            <% } else { %>
                                <!-- Default Video Mockup Player -->
                                <div class="p-6 text-center text-white space-y-3">
                                    <div class="size-14 mx-auto rounded-full bg-[#18a957]/20 text-[#18a957] flex items-center justify-center mb-2 shadow-xs">
                                        <span class="material-symbols-rounded text-3xl">play_circle</span>
                                    </div>
                                    <h4 class="text-base font-semibold text-white">অধ্যায় ওভারভিউ ভিডিও</h4>
                                    <p class="text-xs text-slate-400 max-w-xs mx-auto font-normal">সুপারঅ্যাডমিন প্যানেলের Landing Page Control Center থেকে নিজস্ব ভিডিও লিঙ্ক যুক্ত করা যাবে।</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Title & Caption Text -->
                <div class="lg:col-span-5 space-y-4 text-left">
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        <%= (locals.landingSettings && landingSettings.videoTitle) ? landingSettings.videoTitle : 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>
                    </h2>
                    <p class="text-[14px] sm:text-[14.5px] text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        <%= (locals.landingSettings && landingSettings.videoCaption) ? landingSettings.videoCaption : 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %>
                    </p>

                    <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                        <span class="material-symbols-rounded text-[#18a957] text-base shrink-0">play_circle</span>
                        <span>প্ল্যাটফর্মের সকল সুবিধা ও ব্যবহারবিধি এক ভিডিওতেই</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 5. "কোর্স ও ব্যাচসমূহ" (Professional, Perfectly Sized 4-Column Grid) -->
    <section id="courses" class="py-14 sm:py-18">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                        কোর্স ও ব্যাচসমূহ
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1">
                        <span id="activeFilteredClassText">সকল শ্রেণীর</span> জন্য উপলব্ধ একাডেমিক ও প্রস্তুতি কোর্স
                    </p>
                </div>
                <a href="/courses" id="viewAllCoursesBtn" class="text-sm sm:text-[15px] font-semibold text-[#18a957] hover:underline inline-flex items-center gap-1 shrink-0">
                    <span>সবগুলো কোর্স দেখুন</span>
                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Professional Compact Cards Grid (1 col mobile, 2 sm, 3 lg, 4 xl) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5" id="coursesGridContainer">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <% 
                            let courseClassStr = Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '');
                            let primaryPrice = 0;
                            let originalPrice = 0;
                            if (course.plans && course.plans.length > 0) {
                                primaryPrice = course.plans[0].price || 0;
                            } else if (course.price) {
                                primaryPrice = course.discountPrice || course.price;
                                originalPrice = course.price;
                            }
                            let isFree = course.accessType === 'free' || primaryPrice === 0;
                            let subjectName = (course.subject && Array.isArray(course.subject) ? course.subject[0] : course.subject) || 'একাডেমিক';
                            let className = (course.classLevel && Array.isArray(course.classLevel) ? course.classLevel[0] : course.classLevel) || 'সকল শ্রেণী';
                        %>
                        <div class="course-card-item group rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-slate-900/80 hover:border-[#18a957]/50 dark:hover:border-[#18a957]/40 hover:shadow-lg dark:hover:shadow-black/30 backdrop-blur-xs overflow-hidden flex flex-col justify-between transition-all duration-300"
                             data-class="<%= courseClassStr.toLowerCase() %>">
                            
                            <!-- Thumbnail Area -->
                            <div class="relative aspect-[16/9] w-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-slate-400 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                                        <span class="material-symbols-rounded text-3xl text-slate-400">auto_stories</span>
                                    </div>
                                <% } %>
                                
                                <!-- Top Badges -->
                                <div class="absolute top-2 left-2 right-2 flex items-center justify-between gap-1 pointer-events-none">
                                    <span class="px-2 py-0.5 rounded-md text-[10.5px] font-semibold <%= isFree ? 'bg-[#18a957] text-white' : 'bg-slate-950/80 text-white backdrop-blur-xs' %> shadow-xs">
                                        <%= isFree ? 'ফ্রি' : 'অনলাইন কোর্স' %>
                                    </span>
                                    <span class="px-2 py-0.5 rounded-md text-[10.5px] font-semibold bg-white/90 dark:bg-slate-900/90 text-slate-700 dark:text-slate-200 backdrop-blur-xs shadow-xs">
                                        <%= className %>
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <!-- Subject Tag -->
                                    <div class="flex items-center gap-1.5 text-[13px] font-medium text-slate-400 mb-1">
                                        <span class="text-[#18a957] font-semibold truncate"><%= subjectName %></span>
                                        <span>•</span>
                                        <span class="truncate"><%= className %></span>
                                    </div>

                                    <!-- Course Title -->
                                    <h3 class="text-[15px] sm:text-base font-semibold text-slate-800 dark:text-white line-clamp-2 leading-snug group-hover:text-[#18a957] transition-colors">
                                        <%= course.title %>
                                    </h3>

                                    <!-- Instructor Row -->
                                    <% if (course.instructor) { %>
                                        <div class="flex items-center gap-1.5 mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                                            <div class="size-5 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0">
                                                <span class="material-symbols-rounded text-[14px]">person</span>
                                            </div>
                                            <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 font-normal truncate">
                                                <%= course.instructor.name %>
                                                <% if (course.instructor.designation) { %>
                                                    <span class="text-slate-400 font-normal">• <%= course.instructor.designation %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Footer: Price & Details Button -->
                                <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
                                    <div class="num-font">
                                        <% if (isFree) { %>
                                            <span class="text-xs font-semibold text-[#18a957]">ফ্রি অ্যাক্সেস</span>
                                        <% } else { %>
                                            <div class="flex items-baseline gap-1">
                                                <span class="text-[15px] sm:text-base font-bold text-slate-900 dark:text-white">৳<%= primaryPrice %></span>
                                                <% if (originalPrice > primaryPrice) { %>
                                                    <span class="text-[11px] text-slate-400 line-through">৳<%= originalPrice %></span>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <a href="/course-details/<%= course._id %>" class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-[#18a957] hover:text-white dark:bg-slate-800 dark:hover:bg-[#18a957] text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-semibold transition-colors shrink-0 shadow-2xs">
                                        বিস্তারিত
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-12 text-center text-slate-400 space-y-2">
                        <span class="material-symbols-rounded text-3xl">school</span>
                        <p class="text-xs sm:text-sm font-semibold">কোনো কোর্স পাওয়া যায়নি। শীঘ্রই নতুন ব্যাচ যুক্ত হবে।</p>
                    </div>
                <% } %>
            </div>

            <!-- Empty State for Filter mismatch -->
            <div id="noCoursesFilteredMsg" class="hidden py-10 text-center space-y-2">
                <span class="material-symbols-rounded text-3xl text-slate-400">filter_alt_off</span>
                <p class="text-xs sm:text-sm font-semibold text-slate-500">এই শ্রেণীর জন্য বর্তমানে কোনো সরাসরি কোর্স নেই। শীঘ্রই নতুন ব্যাচ যুক্ত হচ্ছে।</p>
                <button type="button" onclick="filterLandingByClass('all')" class="text-xs sm:text-sm text-[#18a957] font-semibold hover:underline">সকল কোর্স দেখুন</button>
            </div>
        </div>
    </section>

    <!-- 6. "বিগত বছরের বোর্ড প্রশ্ন ব্যাংক" (Relevant, Clean, font-semibold) -->
    <section id="question-bank" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/30 backdrop-blur-xs">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-2 mb-8">
            <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                বিগত বছরের বোর্ড প্রশ্ন ব্যাংক
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                অধ্যায়ভিত্তিক সৃজনশীল ও বহুনির্বাচনী প্রশ্নের নির্ভুল সমাধান।
            </p>
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Board Badges -->
            <div class="flex flex-wrap items-center justify-center gap-1.5 mb-6 text-[13px] text-slate-600 dark:text-slate-300 font-medium">
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">ঢাকা</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">রাজশাহী</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">চট্টগ্রাম</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">কুমিল্লা</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">যশোর</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">দিনাজপুর</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">সিলেট</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">বরিশাল</span>
                <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80">মাদ্রাসা</span>
            </div>

            <!-- Question Bank List -->
