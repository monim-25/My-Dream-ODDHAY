    <!-- Minimal Vanilla JS Controller -->
    <script>
        // 1. Cockpit Switcher
        function switchCockpitTab(tabKey, btn) {
            const tabs = ['classroom', 'qbank', 'exam'];
            tabs.forEach(t => {
                const el = document.getElementById('cockpit-' + t);
                if (el) el.classList.add('hidden');
            });
            const activeEl = document.getElementById('cockpit-' + tabKey);
            if (activeEl) activeEl.classList.remove('hidden');

            document.querySelectorAll('.cockpit-btn').forEach(b => {
                b.className = 'cockpit-btn px-3 py-1 rounded-lg text-xs font-medium text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-all';
            });
            if (btn) {
                btn.className = 'cockpit-btn px-3 py-1 rounded-lg text-xs font-semibold bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-2xs transition-all';
            }
        }

        // 2. Class Selector Filter
        function selectLandingClass(className, btn) {
            document.querySelectorAll('.class-pill').forEach(p => {
                p.classList.remove('bg-primary', 'text-white');
                p.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
            });
            if (btn) {
                btn.classList.add('bg-primary', 'text-white');
                btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
            }

            const cards = document.querySelectorAll('.course-card-item');
            if (cards.length === 0) return;

            cards.forEach(card => {
                if (className === 'all') {
                    card.style.display = 'flex';
                } else {
                    const cardClass = card.getAttribute('data-classes') || '';
                    if (cardClass.toLowerCase().includes(className.toLowerCase())) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                }
            });
        }
    </script>
