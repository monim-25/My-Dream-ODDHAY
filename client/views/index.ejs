    <script>
        // 1. Toggle Extended Features
        function toggleAllLandingFeatures() {
            const grid = document.getElementById('extendedFeaturesGrid');
            const btnText = document.getElementById('featuresBtnText');
            const btnIcon = document.getElementById('featuresBtnIcon');
            if (!grid) return;

            const isHidden = grid.classList.contains('hidden');
            if (isHidden) {
                grid.classList.remove('hidden');
                if (btnText) btnText.textContent = 'সংক্ষিপ্ত করুন';
                if (btnIcon) btnIcon.textContent = 'expand_less';
            } else {
                grid.classList.add('hidden');
                if (btnText) btnText.textContent = 'সকল ফিচার দেখুন';
                if (btnIcon) btnIcon.textContent = 'expand_more';
            }
        }

        // 2. Class Filter Controller (Synchronized with Navbar & Mobile selector)
        function filterLandingByClass(className) {
            // Sync both select dropdowns
            const navSelect = document.getElementById('navbarClassFilter');
            const mobSelect = document.getElementById('mobileClassFilter');
            if (navSelect && navSelect.value !== className) navSelect.value = className;
            if (mobSelect && mobSelect.value !== className) mobSelect.value = className;

            const headerText = document.getElementById('activeFilteredClassText');
            if (headerText) {
                headerText.textContent = className === 'all' ? 'সকল শ্রেণীর' : (className + '-এর');
            }

            // Sync link to all courses with the active class filter
            const allCoursesBtn = document.getElementById('viewAllCoursesBtn');
            if (allCoursesBtn) {
                allCoursesBtn.href = (className && className !== 'all') ? ('/courses?class=' + encodeURIComponent(className)) : '/courses';
            }

            const cards = document.querySelectorAll('.course-card-item');
            const noCoursesMsg = document.getElementById('noCoursesFilteredMsg');
            let visibleCount = 0;

            cards.forEach(card => {
                if (className === 'all') {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    const cData = card.getAttribute('data-class') || '';
                    if (cData.includes(className.toLowerCase())) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                }
            });

            if (noCoursesMsg) {
                if (visibleCount === 0 && cards.length > 0) {
                    noCoursesMsg.classList.remove('hidden');
                } else {
                    noCoursesMsg.classList.add('hidden');
                }
            }
        }

        // 3. Smooth scroll and filter to specific class section
        function scrollToClassAndFilter(className) {
            filterLandingByClass(className);
            const coursesElem = document.getElementById('courses');
            if (coursesElem) {
                coursesElem.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // 4. Handle initial deep link from URL params (e.g. /?class=class9#courses)
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const classParam = urlParams.get('class');
                if (classParam) {
                    filterLandingByClass(classParam);
                    if (window.location.hash === '#courses') {
                        setTimeout(() => {
                            const coursesElem = document.getElementById('courses');
                            if (coursesElem) coursesElem.scrollIntoView({ behavior: 'smooth' });
                        }, 250);
                    }
                }
            } catch (e) {}
        });
        // 5. Universal Butter-Smooth Anchor Link Scrolling
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('a[href*="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    const href = this.getAttribute('href');
                    if (!href) return;
                    const hashIndex = href.indexOf('#');
                    if (hashIndex === -1) return;
                    const hash = href.substring(hashIndex);
                    if (hash === '#' || hash.length < 2) return;

                    // If it points to an external page path, allow normal navigation
                    const pathPart = href.substring(0, hashIndex);
                    if (pathPart && pathPart !== '/' && pathPart !== window.location.pathname) {
                        return;
                    }

                    const target = document.querySelector(hash);
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                        if (window.history && window.history.pushState) {
                            window.history.pushState(null, null, hash);
                        }
                    }
                });
            });
        });
    </script>
</body>
