    <!-- 9. Comprehensive Professional Footer -->
    <%- include('partials/footer') %>

    <!-- Interactive Client Scripts -->
    <script>
        // Toggle extended features (Cards 7-10)
        function toggleExtendedFeatures() {
            const ext = document.getElementById('extendedFeatures');
            const txt = document.getElementById('featuresBtnText');
            const icon = document.getElementById('featuresBtnIcon');
            if (!ext) return;

            const isHidden = ext.classList.contains('hidden');
            if (isHidden) {
                ext.classList.remove('hidden');
                txt.textContent = 'কম ফিচার দেখুন';
                icon.style.transform = 'rotate(180deg)';
            } else {
                ext.classList.add('hidden');
                txt.textContent = 'আরও ৪টি গুরুত্বপূর্ণ ফিচার দেখুন';
                icon.style.transform = 'rotate(0deg)';
            }
        }

        // Live Dynamic Class Filtering for Landing Page Courses
        function filterLandingByClass(className) {
            const cards = document.querySelectorAll('.course-card-item');
            const emptyState = document.getElementById('landingNoCoursesFound');
            const allLink = document.getElementById('allCoursesLink');
            const bottomLink = document.getElementById('bottomAllCoursesLink');
            let visibleCount = 0;
            const isSmallScreen = window.innerWidth < 640;

            const normClass = (className || 'all').trim().toLowerCase();

            cards.forEach(card => {
                const cardClass = (card.getAttribute('data-class') || '').toLowerCase();
                const isDesktopOnly = card.classList.contains('course-card-desktop-only');
                
                let matches = false;
                if (normClass === 'all' || normClass === 'সকল শ্রেণী' || normClass === '') {
                    matches = true;
                } else {
                    matches = cardClass.includes(normClass) || cardClass.includes('সকল') || cardClass.includes('all');
                }

                if (matches) {
                    card.style.display = 'flex';
                    if (!isSmallScreen || !isDesktopOnly) {
                        visibleCount++;
                    }
                } else {
                    card.style.display = 'none';
                }
            });

            // Update empty state display
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            // Sync mobile carousel dots with visible cards
            updateCourseCarouselDots();

            // Sync links to all courses with the active class filter
            const targetUrl = (normClass === 'all' || normClass === 'সকল শ্রেণী' || normClass === '')
                ? '/courses'
                : `/courses?classLevel=${encodeURIComponent(className)}`;
            if (allLink) allLink.href = targetUrl;
            if (bottomLink) bottomLink.href = targetUrl;

            // Sync visual active state on navbar select if present
            const navSelect = document.getElementById('navbarClassFilter');
            const mobSelect = document.getElementById('mobileClassFilter');
            const legacyNavSelect = document.getElementById('navClassFilterSelect');
            if (navSelect && navSelect.value !== className) navSelect.value = className;
            if (mobSelect && mobSelect.value !== className) mobSelect.value = className;
            if (legacyNavSelect && legacyNavSelect.value !== className) legacyNavSelect.value = className;
            if (window.syncNavClassDropdown) window.syncNavClassDropdown(className);
        }

        // Listen for filter events triggered from navigation select
        window.addEventListener('oddhay-class-filter-changed', function(e) {
            const chosenClass = e.detail && e.detail.className ? e.detail.className : 'all';
            
            // 1. Filter courses on this page
            filterLandingByClass(chosenClass);

            // 2. Smooth scroll to courses section so student sees immediate result
            const coursesSection = document.getElementById('courses');
            if (coursesSection && chosenClass !== 'all') {
                coursesSection.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Helper to smoothly scroll horizontal carousel container to center a card without affecting vertical window scroll
        function scrollContainerToCard(container, card) {
            if (!container || !card) return;
            const containerRect = container.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();
            const relativeCardLeft = cardRect.left - containerRect.left;
            const targetScrollLeft = container.scrollLeft + relativeCardLeft - ((container.clientWidth - card.clientWidth) / 2);
            container.scrollTo({ left: Math.max(0, targetScrollLeft), behavior: 'smooth' });
        }

        // Update carousel dots for mobile course slider
        function updateCourseCarouselDots() {
            const container = document.getElementById('landingCoursesContainer');
            const dotsWrapper = document.getElementById('courseCarouselDots');
            if (!container || !dotsWrapper) return;
            
            if (window.innerWidth >= 640) {
                dotsWrapper.style.display = 'none';
                return;
            }

            const visibleCards = Array.from(container.querySelectorAll('.course-card-item')).filter(c => {
                if (c.style.display === 'none') return false;
                if (c.classList.contains('course-card-desktop-only')) return false;
                return true;
            });
            
            if (visibleCards.length <= 1) {
                dotsWrapper.style.display = 'none';
                return;
            }

            dotsWrapper.style.display = 'flex';
            dotsWrapper.innerHTML = '';

            const containerRect = container.getBoundingClientRect();
            const containerCenter = containerRect.left + (containerRect.width / 2);

            let closestIdx = 0;
            let minDiff = Infinity;

            visibleCards.forEach((card, idx) => {
                const cardRect = card.getBoundingClientRect();
                const cardCenter = cardRect.left + (cardRect.width / 2);
                const diff = Math.abs(cardCenter - containerCenter);
                if (diff < minDiff) {
                    minDiff = diff;
                    closestIdx = idx;
                }
            });

            visibleCards.forEach((card, idx) => {
                const dot = document.createElement('button');
                dot.type = 'button';
                dot.setAttribute('aria-label', `কোর্স ${idx + 1}`);
                const isActive = idx === closestIdx;
                dot.className = isActive
                    ? 'h-2 w-5 rounded-full bg-[#18a957] transition-all duration-300 cursor-pointer'
                    : 'h-2 w-2 rounded-full bg-slate-300 dark:bg-slate-700 hover:bg-slate-400 transition-all duration-300 cursor-pointer';
                
                dot.addEventListener('click', function() {
                    scrollContainerToCard(container, card);
                });
                
                dotsWrapper.appendChild(dot);
            });
        }

        // Setup mobile course carousel (dots + auto-scroll loop for small screen)
        (function setupCourseCarousel() {
            const courseContainer = document.getElementById('landingCoursesContainer');
            if (!courseContainer) return;

            let scrollTimer;
            courseContainer.addEventListener('scroll', function() {
                if (!scrollTimer) {
                    window.requestAnimationFrame(function() {
                        updateCourseCarouselDots();
                        scrollTimer = null;
                    });
                    scrollTimer = true;
                }
            }, { passive: true });

            // Auto-scroll loop for small screen (every 5 seconds, relaxed & smooth)
            let autoScrollTimer = null;
            let pauseTimer = null;
            let isUserInteracting = false;
            let isSectionInView = false;

            // Track if courses section is visible in user's viewport so auto-scroll never activates when user is elsewhere
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        isSectionInView = entry.isIntersecting;
                    });
                }, { threshold: 0.15 });
                const coursesSection = document.getElementById('courses');
                if (coursesSection) {
                    observer.observe(coursesSection);
                }
            } else {
                isSectionInView = true;
            }

            function getVisibleMobileCards() {
                return Array.from(courseContainer.querySelectorAll('.course-card-item')).filter(c => {
                    if (c.style.display === 'none') return false;
                    if (c.classList.contains('course-card-desktop-only')) return false;
                    return true;
                });
            }

            function scrollNextCard() {
                if (window.innerWidth >= 640 || isUserInteracting || !isSectionInView) return;
                const cards = getVisibleMobileCards();
                if (cards.length <= 1) return;

                const containerRect = courseContainer.getBoundingClientRect();
                const containerCenter = containerRect.left + (containerRect.width / 2);

                let closestIdx = 0;
                let minDiff = Infinity;
                cards.forEach((card, idx) => {
                    const cardRect = card.getBoundingClientRect();
                    const cardCenter = cardRect.left + (cardRect.width / 2);
                    const diff = Math.abs(cardCenter - containerCenter);
                    if (diff < minDiff) {
                        minDiff = diff;
                        closestIdx = idx;
                    }
                });

                const nextIdx = (closestIdx + 1) % cards.length;
                scrollContainerToCard(courseContainer, cards[nextIdx]);
            }

            function startAutoScroll() {
                stopAutoScroll();
                if (window.innerWidth < 640) {
                    autoScrollTimer = setInterval(scrollNextCard, 5000);
                }
            }

            function stopAutoScroll() {
                if (autoScrollTimer) {
                    clearInterval(autoScrollTimer);
                    autoScrollTimer = null;
                }
            }

            function pauseAutoScrollTemporarily() {
                isUserInteracting = true;
                clearTimeout(pauseTimer);
                pauseTimer = setTimeout(function() {
                    isUserInteracting = false;
                }, 5000);
            }

            // Pause temporarily on user touch/pointer interaction
            courseContainer.addEventListener('touchstart', pauseAutoScrollTemporarily, { passive: true });
            courseContainer.addEventListener('touchmove', pauseAutoScrollTemporarily, { passive: true });
            courseContainer.addEventListener('touchend', pauseAutoScrollTemporarily, { passive: true });
            courseContainer.addEventListener('mousedown', pauseAutoScrollTemporarily, { passive: true });
            courseContainer.addEventListener('mouseenter', pauseAutoScrollTemporarily, { passive: true });

            window.addEventListener('resize', function() {
                updateCourseCarouselDots();
                if (window.innerWidth < 640) {
                    startAutoScroll();
                } else {
                    stopAutoScroll();
                }
            }, { passive: true });

            document.addEventListener('DOMContentLoaded', function() {
                updateCourseCarouselDots();
                startAutoScroll();
            });

            updateCourseCarouselDots();
            startAutoScroll();
        })();

        // Initialize from URL parameters if someone lands with ?class=9
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const classParam = urlParams.get('class') || urlParams.get('classLevel');
            if (classParam) {
                filterLandingByClass(classParam);
            }
        });
    </script>
</body>

</html>
