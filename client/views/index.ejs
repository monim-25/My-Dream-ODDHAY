                <!-- Card 10: আরও অসংখ্য স্মার্ট ফিচার (পারফরম্যান্স অ্যানালিটিক্স সহ মোটিভেশনাল কার্ড) -->
                <div class="feature-card p-6 rounded-2xl bg-gradient-to-br from-cyan-500/[0.12] via-emerald-500/[0.06] to-white/80 dark:to-slate-900/50 border border-cyan-500/30 hover:border-cyan-500/50 dark:from-cyan-500/[0.18] dark:via-emerald-500/[0.08] dark:border-cyan-500/40 backdrop-blur-xs shadow-xs">
                    <div class="size-11 rounded-xl bg-gradient-to-tr from-cyan-500 to-emerald-500 text-white flex items-center justify-center mb-4 shadow-xs">
                        <span class="material-symbols-rounded text-2xl">auto_awesome</span>
                    </div>
                    <h3 class="text-[15px] font-semibold text-slate-800 dark:text-white mb-1.5">আরও অসংখ্য স্মার্ট ফিচার</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        পারফরম্যান্স অ্যানালিটিক্স, দুর্বল অধ্যায় ট্র্যাকিং ও বিস্তারিত প্রগ্রেস রিপোর্ট সহ আরও অনেক দারুণ ফিচার নিয়ে তোমার প্রস্তুতি থাকবে সবসময় সেরা!
                    </p>
                </div>

            </div>

            <!-- View All Features Button -->
            <div class="text-center mt-8">
                <button type="button" id="toggleFeaturesBtn" onclick="toggleAllLandingFeatures()" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-[#18a957] text-xs font-semibold text-slate-700 dark:text-slate-200 transition-all cursor-pointer shadow-2xs inline-flex items-center gap-1.5 active:scale-95">
                    <span id="featuresBtnText">সকল ফিচার দেখুন (১০টি)</span>
                    <span id="featuresBtnIcon" class="material-symbols-rounded text-base">expand_more</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 4. প্ল্যাটফর্ম ওভারভিউ ভিডিও (Split 2-Column: Video at Left, Title & Caption at Right) -->
    <section id="video-tour" class="py-16 sm:py-20 border-y border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/30 backdrop-blur-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left Column: Video Player Box -->
                <div class="lg:col-span-7 relative">
                    <div class="relative group">
                        <!-- Soft Ambient Glow -->
                        <div class="absolute -inset-1.5 bg-gradient-to-r from-[#18a957]/20 via-blue-500/15 to-violet-500/15 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition duration-500 pointer-events-none -z-10"></div>
                        
                        <!-- Video Player Container (16:9 Aspect Ratio) -->
                        <div class="rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-700/80 bg-slate-950 overflow-hidden shadow-xl aspect-video w-full flex items-center justify-center relative">
                            <% 
                                const customVideoUrl = (locals.landingSettings && landingSettings.videoUrl) ? landingSettings.videoUrl.trim() : '';
                                let ytEmbedId = null;
                                if (customVideoUrl.includes('youtube.com/watch')) {
                                    const m = customVideoUrl.match(/[?&]v=([^&]+)/);
                                    if (m) ytEmbedId = m[1];
                                } else if (customVideoUrl.includes('youtu.be/')) {
                                    const parts = customVideoUrl.split('youtu.be/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                } else if (customVideoUrl.includes('youtube.com/embed/')) {
                                    const parts = customVideoUrl.split('youtube.com/embed/');
                                    if (parts[1]) ytEmbedId = parts[1].split(/[?&]/)[0];
                                }
                            %>

                            <% if (ytEmbedId) { %>
                                <iframe src="https://www.youtube.com/embed/<%= ytEmbedId %>?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                            <% } else if (customVideoUrl.endsWith('.mp4') || customVideoUrl.endsWith('.webm') || customVideoUrl.includes('cloudinary.com')) { %>
                                <video src="<%= customVideoUrl %>" controls class="w-full h-full object-contain"></video>
                            <% } else { %>
                                <!-- Default Video Mockup Player -->
                                <div class="p-6 text-center text-white space-y-3">
                                    <div class="size-14 mx-auto rounded-full bg-[#18a957]/20 text-[#18a957] flex items-center justify-center mb-2 shadow-xs">
                                        <span class="material-symbols-rounded text-3xl">play_circle</span>
                                    </div>
                                    <h4 class="text-base font-semibold text-white">অধ্যায় ওভারভিউ ভিডিও</h4>
                                    <p class="text-xs text-slate-400 max-w-xs mx-auto font-normal">সুপারঅ্যাডমিন প্যানেলের Landing Page Control Center থেকে নিজস্ব ভিডিও লিঙ্ক যুক্ত করা যাবে।</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Title & Caption Text -->
                <div class="lg:col-span-5 space-y-4 text-left">
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100 leading-snug">
                        <%= (locals.landingSettings && landingSettings.videoTitle) ? landingSettings.videoTitle : 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>
                    </h2>
                    <p class="text-sm sm:text-[15px] text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                        <%= (locals.landingSettings && landingSettings.videoCaption) ? landingSettings.videoCaption : 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %>
                    </p>

                    <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                        <span class="material-symbols-rounded text-[#18a957] text-base shrink-0">play_circle</span>
                        <span>প্ল্যাটফর্মের সকল সুবিধা ও ব্যবহারবিধি এক ভিডিওতেই</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 5. "কোর্স ও ব্যাচসমূহ" (Professional, Perfectly Sized 4-Column Grid) -->
    <section id="courses" class="py-14 sm:py-18">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-slate-800 dark:text-slate-100">
                        কোর্স ও ব্যাচসমূহ
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1">
                        <span id="activeFilteredClassText">সকল শ্রেণীর</span> জন্য উপলব্ধ একাডেমিক ও প্রস্তুতি কোর্স
                    </p>
                </div>
                <a href="/courses" class="text-xs sm:text-sm font-semibold text-[#18a957] hover:underline inline-flex items-center gap-1 shrink-0">
                    <span>সবগুলো কোর্স দেখুন</span>
                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Professional Compact Cards Grid (1 col mobile, 2 sm, 3 lg, 4 xl) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5" id="coursesGridContainer">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <% 
                            let courseClassStr = Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '');
                            let primaryPrice = 0;
                            let originalPrice = 0;
                            if (course.plans && course.plans.length > 0) {
                                primaryPrice = course.plans[0].price || 0;
                            } else if (course.price) {
                                primaryPrice = course.discountPrice || course.price;
                                originalPrice = course.price;
                            }
                            let isFree = course.accessType === 'free' || primaryPrice === 0;
                            let subjectName = (course.subject && Array.isArray(course.subject) ? course.subject[0] : course.subject) || 'একাডেমিক';
                            let className = (course.classLevel && Array.isArray(course.classLevel) ? course.classLevel[0] : course.classLevel) || 'সকল শ্রেণী';
                        %>
                        <div class="course-card-item group rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-slate-900/80 hover:border-[#18a957]/50 dark:hover:border-[#18a957]/40 hover:shadow-lg dark:hover:shadow-black/30 backdrop-blur-xs overflow-hidden flex flex-col justify-between transition-all duration-300"
                             data-class="<%= courseClassStr.toLowerCase() %>">
                            
                            <!-- Thumbnail Area -->
                            <div class="relative aspect-[16/9] w-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-slate-400 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                                        <span class="material-symbols-rounded text-3xl text-slate-400">auto_stories</span>
                                    </div>
                                <% } %>
                                
                                <!-- Top Badges -->
                                <div class="absolute top-2 left-2 right-2 flex items-center justify-between gap-1 pointer-events-none">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold <%= isFree ? 'bg-[#18a957] text-white' : 'bg-slate-950/80 text-white backdrop-blur-xs' %> shadow-xs">
                                        <%= isFree ? 'ফ্রি' : 'অনলাইন কোর্স' %>
                                    </span>
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-white/90 dark:bg-slate-900/90 text-slate-700 dark:text-slate-200 backdrop-blur-xs shadow-xs">
                                        <%= className %>
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <!-- Subject Tag -->
                                    <div class="flex items-center gap-1.5 text-[11px] font-medium text-slate-400 mb-1">
                                        <span class="text-[#18a957] font-semibold truncate"><%= subjectName %></span>
