    <script>
        // 1. Toggle Extended Features
        function toggleAllLandingFeatures() {
            const grid = document.getElementById('extendedFeaturesGrid');
            const btnText = document.getElementById('featuresBtnText');
            const btnIcon = document.getElementById('featuresBtnIcon');
            if (!grid) return;

            const isHidden = grid.classList.contains('hidden');
            if (isHidden) {
                grid.classList.remove('hidden');
                if (btnText) btnText.textContent = 'সংক্ষিপ্ত করুন';
                if (btnIcon) btnIcon.textContent = 'expand_less';
            } else {
                grid.classList.add('hidden');
                if (btnText) btnText.textContent = 'সকল ফিচার দেখুন';
                if (btnIcon) btnIcon.textContent = 'expand_more';
            }
        }

        // 2. Class Filter Controller (Synchronized with Navbar & Mobile selector)
        function filterLandingByClass(className) {
            // Sync both select dropdowns
            const navSelect = document.getElementById('navbarClassFilter');
            const mobSelect = document.getElementById('mobileClassFilter');
            if (navSelect && navSelect.value !== className) navSelect.value = className;
            if (mobSelect && mobSelect.value !== className) mobSelect.value = className;

            const headerText = document.getElementById('activeFilteredClassText');
            if (headerText) {
                headerText.textContent = className === 'all' ? 'সকল শ্রেণীর' : (className + '-এর');
            }

            const cards = document.querySelectorAll('.course-card-item');
            const noCoursesMsg = document.getElementById('noCoursesFilteredMsg');
            let visibleCount = 0;

            cards.forEach(card => {
                if (className === 'all') {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    const cData = card.getAttribute('data-class') || '';
                    if (cData.includes(className.toLowerCase())) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                }
            });

            if (noCoursesMsg) {
                if (visibleCount === 0 && cards.length > 0) {
                    noCoursesMsg.classList.remove('hidden');
                } else {
                    noCoursesMsg.classList.add('hidden');
                }
            }
        }
    </script>
