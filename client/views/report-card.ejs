<!DOCTYPE html>
<html lang="en" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Academic Progress & Performance | ODDHAY</title>
    <style>
        :root {
            --progress-percent: <%= (locals.stats && stats.avgScore ? stats.avgScore : 0) %>%;
        }

        @media print {
            header, aside, nav, .print-hide, .student-header {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            main {
                padding: 0 !important;
                overflow: visible !important;
            }
            .print-card {
                border: 1px solid #cbd5e1 !important;
                box-shadow: none !important;
                break-inside: avoid;
            }
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'progress' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <% const u = locals.user || {}; %>
            <% const st = locals.stats || {}; %>
            <% const rTasks = locals.routineTasks || []; %>
            <% const enrolled = u.enrolledCourses || []; %>
            <% const wActivity = locals.weeklyActivity || []; %>
            <% const subjPerf = locals.subjectPerformance || {}; %>
            <% const recQuizzes = locals.recentQuizzes || []; %>

            <!-- 1. HERO IDENTITY & ACADEMIC PROGRESS BANNER (ATTACHED FLUSH TO SIDEBAR & NAVBAR) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 shadow-none print-card relative overflow-hidden">
                <div class="flex flex-col md:flex-row items-center justify-between gap-4 w-full">
                    <!-- Student Info -->
                    <div class="flex items-center gap-3.5 min-w-0 w-full md:w-auto">
                        <div class="relative shrink-0">
                            <div class="size-16 sm:size-20 rounded-full border-2 border-primary/30 overflow-hidden bg-slate-100 dark:bg-slate-800 shadow-xs ring-2 ring-white dark:ring-slate-900">
                                <img src="<%= u.profileImage ? u.profileImage : (u.name ? `https://ui-avatars.com/api/?name=${encodeURIComponent(u.name)}&background=random&size=144` : '/default-avatar.png') %>" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h1 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white leading-tight truncate">
                                    <%= u.name || 'Student' %>
                                </h1>
                                <span class="px-2 py-0.5 rounded bg-primary/10 text-primary text-[10px] font-bold border border-primary/20">
                                    Academic Progress
                                </span>
                            </div>
                            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-0.5 flex items-center gap-2 flex-wrap">
                                <span>Class <%= u.classLevel || '10' %></span>
                                <% if (u._id) { %>
                                    <span>•</span>
                                    <span>ID: #<%= u._id.toString().slice(-6).toUpperCase() %></span>
                                <% } %>
                                <% if (u.rollNumber && u.rollNumber !== 'N/A') { %>
                                    <span>•</span>
                                    <span>Roll: <%= u.rollNumber %></span>
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <!-- Overall Score Action -->
                    <div class="flex items-center gap-3 shrink-0 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 pt-2 md:pt-0 border-slate-100 dark:border-slate-800">
                        <div class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200/60 dark:border-emerald-500/20">
                            <span class="material-symbols-rounded text-emerald-500 text-xl leading-none flex items-center justify-center">insights</span>
                            <div>
                                <p class="text-[9px] font-medium text-slate-400">Average Performance</p>
                                <p class="text-sm font-bold text-emerald-600 dark:text-emerald-400 leading-none"><%= st.avgScore || 0 %>%</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. KEY PERFORMANCE METRICS GRID (ATTACHED FLUSH) -->
            <div class="grid grid-cols-2 lg:grid-cols-4 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-x divide-y lg:divide-y-0 divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a] print-card">
                <div class="p-3.5 sm:p-4 flex items-center gap-3">
                    <div class="size-10 rounded-lg flex items-center justify-center border shrink-0 text-blue-500 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20">
                        <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center">star</span>
                    </div>
                    <div class="min-w-0">
                        <h4 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-none mb-1"><%= st.avgScore || 0 %>%</h4>
                        <p class="text-[11.5px] font-medium text-slate-500 dark:text-slate-400 truncate">Average Score</p>
                    </div>
                </div>

                <div class="p-3.5 sm:p-4 flex items-center gap-3">
                    <div class="size-10 rounded-lg flex items-center justify-center border shrink-0 text-amber-500 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20">
                        <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center">quiz</span>
                    </div>
                    <div class="min-w-0">
                        <h4 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-none mb-1"><%= st.totalQuizzes || 0 %></h4>
                        <p class="text-[11.5px] font-medium text-slate-500 dark:text-slate-400 truncate">Total Exams Taken</p>
                    </div>
                </div>

                <div class="p-3.5 sm:p-4 flex items-center gap-3">
                    <div class="size-10 rounded-lg flex items-center justify-center border shrink-0 text-indigo-500 bg-indigo-50 dark:bg-indigo-500/10 border-indigo-200/60 dark:border-indigo-500/20">
                        <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center">schedule</span>
                    </div>
                    <div class="min-w-0">
                        <h4 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-none mb-1"><%= st.learningHours || '0.0' %>h</h4>
                        <p class="text-[11.5px] font-medium text-slate-500 dark:text-slate-400 truncate">Learning Hours</p>
                    </div>
                </div>

                <div class="p-3.5 sm:p-4 flex items-center gap-3">
                    <div class="size-10 rounded-lg flex items-center justify-center border shrink-0 text-rose-500 bg-rose-50 dark:bg-rose-500/10 border-rose-200/60 dark:border-rose-500/20">
                        <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center">local_fire_department</span>
                    </div>
                    <div class="min-w-0">
                        <h4 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-none mb-1"><%= u.streak || 0 %> Days</h4>
                        <p class="text-[11.5px] font-medium text-slate-500 dark:text-slate-400 truncate">Study Streak</p>
                    </div>
                </div>
            </div>

            <!-- 3. ACHIEVEMENTS & LEVEL PROGRESS SECTION (ATTACHED FLUSH) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 print-card">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-amber-500 text-lg leading-none flex items-center justify-center">military_tech</span>
                        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Achievements & Level Badges</h3>
                    </div>
                    <div class="flex items-center gap-1 text-xs font-bold text-primary">
                        <span>Level <%= u.level || 1 %></span>
                        <span>•</span>
                        <span><%= u.totalXP || 0 %> XP</span>
                    </div>
                </div>

                <!-- XP Bar -->
                <div class="mb-4 bg-slate-50 dark:bg-slate-800/40 p-3 rounded-lg border border-slate-200/60 dark:border-slate-700/60">
                    <div class="flex items-center justify-between text-xs font-bold mb-1.5 flex-wrap gap-1">
                        <span class="text-slate-700 dark:text-slate-300">Level <%= locals.level || 1 %> Progress</span>
                        <span class="text-primary text-[11px]"><%= locals.xpInLevel || 0 %> / <%= locals.xpNeededForLevel || 100 %> XP (<%= locals.xpNeeded || 0 %> XP to Level <%= locals.nextLevel || 2 %>)</span>
                    </div>
                    <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-primary via-indigo-500 to-purple-500 rounded-full transition-all duration-500" style="width: <%= locals.levelProgress || 0 %>%"></div>
                    </div>
                </div>

                <!-- Badges Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <% const badges = [
                        { name: 'Streak Master', desc: 'Maintain active study streak', icon: 'local_fire_department', unlocked: (u.streak || 0) > 0, color: 'text-rose-500 bg-rose-50 dark:bg-rose-500/10 border-rose-200/60 dark:border-rose-500/20' },
                        { name: 'Quiz Ace', desc: 'Complete 1+ exam quizzes', icon: 'psychology', unlocked: (st.totalQuizzes || 0) > 0, color: 'text-amber-500 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20' },
                        { name: 'Knowledge Seeker', desc: 'Finish lessons & courses', icon: 'auto_stories', unlocked: (st.completedLessons || 0) > 0, color: 'text-blue-500 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20' },
                        { name: 'Top Scholar', desc: 'Maintain 75%+ avg score', icon: 'emoji_events', unlocked: (parseFloat(st.avgScore || 0)) >= 75, color: 'text-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200/60 dark:border-emerald-500/20' }
                    ]; %>

                    <% badges.forEach(b => { %>
                        <div class="p-3 rounded-lg border flex items-center gap-3 transition-all <%= b.unlocked ? 'bg-white dark:bg-slate-800/80 border-slate-200 dark:border-slate-700' : 'bg-slate-50/50 dark:bg-slate-900/40 border-slate-200/50 dark:border-slate-800 opacity-60' %>">
                            <div class="size-9 rounded-lg flex items-center justify-center border shrink-0 <%= b.color %>">
                                <span class="material-symbols-rounded text-lg leading-none flex items-center justify-center"><%= b.icon %></span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs font-bold text-slate-800 dark:text-white truncate"><%= b.name %></p>
                                <p class="text-[10px] font-medium text-slate-400 truncate"><%= b.unlocked ? 'Unlocked' : 'In Progress' %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!-- 4. WEEKLY ACTIVITY & SUBJECT PERFORMANCE GRID (ATTACHED FLUSH) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-y lg:divide-y-0 lg:divide-x divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a] print-card">
                <!-- Weekly Activity Bar Chart -->
                <div class="p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary text-lg leading-none flex items-center justify-center">bar_chart</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Weekly Learning Activity</h3>
                        </div>
                    </div>

                    <% if (wActivity && wActivity.length > 0) { %>
                        <div class="flex items-end gap-2 h-36 border-b border-slate-100 dark:border-slate-800 pb-2 pt-4">
                            <% const maxCount = Math.max(...wActivity.map(d => d.count), 1); %>
                            <% wActivity.forEach(function(day) { %>
                                <div class="flex-1 flex flex-col items-center gap-2">
                                    <div class="w-full bg-primary/20 hover:bg-primary rounded-lg transition-all relative group flex flex-col justify-end"
                                        style="height: <%= Math.max((day.count / maxCount) * 100, 8) %>px;">
                                        <% if (day.count > 0) { %>
                                            <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-[8px] font-bold px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-20 shadow-xs">
                                                <%= day.count %> <%= day.count === 1 ? 'Activity' : 'Activities' %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <span class="text-[9px] font-bold text-slate-400 uppercase"><%= day.day %></span>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="py-8 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                            <span class="material-symbols-rounded text-2xl text-slate-300 mb-1">bar_chart</span>
                            <p class="text-xs font-bold text-slate-400">No activity logged this week</p>
                        </div>
                    <% } %>
                </div>

                <!-- Subject Performance Breakdown -->
                <div class="p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg leading-none flex items-center justify-center">school</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Subject Performance & Mastery</h3>
                        </div>
                    </div>

                    <% const subjects = subjPerf ? Object.entries(subjPerf) : []; %>
                    <% if (subjects.length > 0) { %>
                        <div class="space-y-3">
                            <% subjects.slice(0, 4).forEach(function([subject, data]) { %>
                                <% const pct = Math.round((data.score / Math.max(data.total, 1)) * 100); %>
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= subject %></span>
                                        <span class="text-xs font-bold <%= pct >= 70 ? 'text-emerald-500' : pct >= 50 ? 'text-amber-500' : 'text-rose-500' %>"><%= pct %>%</span>
                                    </div>
                                    <div class="h-1.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full rounded-full transition-all duration-700 <%= pct >= 70 ? 'bg-emerald-500' : pct >= 50 ? 'bg-amber-500' : 'bg-rose-500' %>" style="width: <%= pct %>%;"></div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="py-8 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                            <span class="material-symbols-rounded text-2xl text-slate-300 mb-1">quiz</span>
                            <p class="text-xs font-bold text-slate-400">Subject stats will appear after taking quizzes</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- 5. NEEDS PRACTICE & REVISION SECTION (ATTACHED FLUSH) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 print-card">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-rose-500 text-lg leading-none flex items-center justify-center">menu_book</span>
                        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Needs Practice & Revision 📚</h3>
                    </div>
                    <span class="text-[10px] font-medium text-slate-400">Targeted Learning Improvement</span>
                </div>

                <% 
                    const weakSubjects = Object.entries(subjPerf).filter(([s, d]) => Math.round((d.score / Math.max(d.total, 1)) * 100) < 70);
                %>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <% if (weakSubjects.length > 0) { %>
                        <% weakSubjects.forEach(([subj, data]) => { %>
                            <% const pct = Math.round((data.score / Math.max(data.total, 1)) * 100); %>
                            <div class="p-3 rounded-lg bg-rose-50/40 dark:bg-rose-500/5 border border-rose-200/60 dark:border-rose-500/20 flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="size-8 rounded-lg bg-rose-100 dark:bg-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-xs shrink-0">
                                        <%= pct %>%
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-bold text-slate-800 dark:text-white truncate"><%= subj %></p>
                                        <p class="text-[10px] font-medium text-rose-600 dark:text-rose-400 truncate">Requires additional revision</p>
                                    </div>
                                </div>
                                <a href="/exams" class="px-2.5 py-1 bg-rose-500 hover:bg-rose-600 text-white rounded-md text-[10px] font-bold shrink-0 print-hide transition-all">
                                    Practice Now
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <!-- Default Recommended Practice Modules -->
                        <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-500 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base leading-none flex items-center justify-center">psychology</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-800 dark:text-white truncate">Exam Quiz Practice</p>
                                    <p class="text-[10px] font-medium text-slate-400 truncate">Take model tests to boost accuracy</p>
                                </div>
                            </div>
                            <a href="/exams" class="px-2.5 py-1 bg-primary hover:bg-primary/90 text-white rounded-md text-[10px] font-bold shrink-0 print-hide transition-all">
                                Take Quiz
                            </a>
                        </div>
                        <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base leading-none flex items-center justify-center">description</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-800 dark:text-white truncate">Lecture Notes Revision</p>
                                    <p class="text-[10px] font-medium text-slate-400 truncate">Review formulas & key concepts</p>
                                </div>
                            </div>
                            <a href="/notes" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-900 text-white rounded-md text-[10px] font-bold shrink-0 print-hide transition-all">
                                Read Notes
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- 6. RECENT QUIZ RESULTS SECTION (ATTACHED FLUSH) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 print-card">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-primary text-lg leading-none flex items-center justify-center">history</span>
                        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Recent Quiz Results</h3>
                    </div>
                </div>

                <% if (recQuizzes && recQuizzes.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                        <% recQuizzes.forEach(function(r) { %>
                            <% const pct = Math.round((r.score / Math.max(r.total || 1, 1)) * 100); %>
                            <div class="flex items-center justify-between p-2.5 bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-lg">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="size-8 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 <%= pct >= 70 ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 border border-emerald-200/50' : pct >= 50 ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-500 border border-amber-200/50' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-500 border border-rose-200/50' %>">
                                        <%= pct %>%
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate"><%= r.quiz?.title || 'Practice Quiz' %></p>
                                        <p class="text-[9px] font-medium text-slate-400">
                                            <%= new Date(r.date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="font-bold text-xs text-slate-800 dark:text-slate-200"><%= r.score %> / <%= r.total %></span>
                                    <span class="text-[9px] font-medium text-slate-400 block">Score</span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="py-6 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                        <p class="text-xs font-bold text-slate-400">No quiz attempts recorded yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- 7. ENROLLED SUBJECTS & ROUTINE SUMMARY GRID (ATTACHED FLUSH) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-y lg:divide-y-0 lg:divide-x divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a] print-card">
                <!-- Enrolled Subjects & Course Progress -->
                <div class="p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-blue-500 text-lg leading-none flex items-center justify-center">auto_stories</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Enrolled Subjects & Courses</h3>
                        </div>
                        <a href="/courses" class="text-xs font-bold text-primary hover:underline flex items-center gap-1 print-hide">
                            <span>All Courses</span>
                        </a>
                    </div>

                    <div class="space-y-2">
                        <% if (enrolled && enrolled.length > 0) { %>
                            <% enrolled.forEach(enroll => { %>
                                <div class="p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="size-8 rounded bg-white dark:bg-slate-800 flex items-center justify-center text-primary border border-slate-200/60 dark:border-slate-700/60 shrink-0">
                                            <span class="material-symbols-rounded text-base leading-none flex items-center justify-center">menu_book</span>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-slate-800 dark:text-white truncate"><%= enroll.course ? enroll.course.title : 'Enrolled Subject' %></p>
                                            <p class="text-[10px] font-medium text-slate-400 truncate"><%= enroll.course ? (enroll.course.subject || 'General Subject') : 'Active Subject' %></p>
                                        </div>
                                    </div>
                                    <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold border border-emerald-200/50 dark:border-emerald-500/20 shrink-0">Active</span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="p-4 rounded-lg bg-slate-50 dark:bg-slate-800/30 border border-dashed border-slate-200 dark:border-slate-800 text-center">
                                <span class="material-symbols-rounded text-slate-400 text-2xl mb-1">auto_stories</span>
                                <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No enrolled subjects found</p>
                                <a href="/courses" class="text-xs font-bold text-primary hover:underline mt-1 inline-block">Explore Courses</a>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Study Routine & Targets Summary -->
                <div class="p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-indigo-500 text-lg leading-none flex items-center justify-center">calendar_month</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Study Routine & Planner Summary</h3>
                        </div>
                        <a href="/routine" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 print-hide">
                            <span>Open Routine</span>
                        </a>
                    </div>

                    <div class="space-y-2">
                        <% if (rTasks && rTasks.length > 0) { %>
                            <% rTasks.slice(0, 4).forEach(task => { %>
                                <div class="p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="size-8 rounded bg-white dark:bg-slate-800 flex items-center justify-center text-indigo-500 border border-slate-200/60 dark:border-slate-700/60 shrink-0">
                                            <span class="material-symbols-rounded text-base leading-none flex items-center justify-center">check_circle</span>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-slate-800 dark:text-white truncate"><%= task.title || 'Study Task' %></p>
                                            <p class="text-[10px] font-medium text-slate-400 truncate"><%= task.subject || 'General' %> • <%= task.date ? new Date(task.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Today' %></p>
                                        </div>
                                    </div>
                                    <% if (task.isCompleted) { %>
                                        <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold border border-emerald-200/50 dark:border-emerald-500/20 shrink-0">Completed</span>
                                    <% } else { %>
                                        <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[10px] font-bold border border-amber-200/50 dark:border-amber-500/20 shrink-0">Pending</span>
                                    <% } %>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="size-8 rounded bg-white dark:bg-slate-800 flex items-center justify-center text-indigo-500 border border-slate-200/60 dark:border-slate-700/60 shrink-0">
                                        <span class="material-symbols-rounded text-base leading-none flex items-center justify-center">edit_calendar</span>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-bold text-slate-800 dark:text-white truncate">Daily Chapter Practice</p>
                                        <p class="text-[10px] font-medium text-slate-400 truncate">General Study Routine</p>
                                    </div>
                                </div>
                                <a href="/routine" class="px-2 py-0.5 rounded bg-primary/10 text-primary text-[10px] font-bold border border-primary/20 shrink-0 print-hide">Add Plan</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Performance Insight Alert Banner (Attached Flush) -->
            <% if (st.totalQuizzes > 0) { %>
                <div class="w-full bg-white dark:bg-[#0f172a] border-l-4 <%= st.avgScore >= 70 ? 'border-l-emerald-500 bg-emerald-50/40 dark:bg-emerald-500/5' : st.avgScore >= 50 ? 'border-l-amber-500 bg-amber-50/40 dark:bg-amber-500/5' : 'border-l-rose-500 bg-rose-50/40 dark:bg-rose-500/5' %> border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 print-card">
                    <div class="flex items-center gap-3">
                        <div class="size-9 rounded-lg flex items-center justify-center shrink-0 <%= st.avgScore >= 70 ? 'bg-emerald-100 text-emerald-600' : st.avgScore >= 50 ? 'bg-amber-100 text-amber-600' : 'bg-rose-100 text-rose-600' %>">
                            <span class="material-symbols-rounded text-xl">
                                <%= st.avgScore >= 70 ? 'emoji_events' : st.avgScore >= 50 ? 'trending_up' : 'school' %>
                            </span>
                        </div>
                        <div>
                            <h3 class="font-bold text-xs text-slate-800 dark:text-white leading-tight">
                                <%= st.avgScore >= 70 ? 'Outstanding Performance! 🎉' : st.avgScore >= 50 ? 'Good Progress - Keep Going! 💪' : 'Needs Practice & Revision 📚' %>
                            </h3>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">
                                Your current average score is <%= st.avgScore %>%. Continue taking quizzes and reviewing lecture notes for maximum mastery.
                            </p>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- 8. FOOTER SUMMARY INFO (ATTACHED FLUSH) -->
            <div class="p-3.5 text-center bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 print-card">
                <p class="text-[10px] font-medium text-slate-400">Digitally Tracked Academic Progress Hub • ODDHAY</p>
            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'progress' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>