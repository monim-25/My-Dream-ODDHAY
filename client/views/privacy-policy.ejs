<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>গোপনীয়তা নীতি | ODDHAY</title>
    <meta name="description"
        content="ODDHAY-এর গোপনীয়তা নীতি — আমরা কীভাবে আপনার তথ্য সংগ্রহ, ব্যবহার ও সুরক্ষিত রাখি।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">
    <%- include('partials/nav') %>

        <main>
            <!-- Hero Banner -->
            <section
                class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-50 to-white dark:from-slate-950 dark:to-slate-900">
                <div class="absolute inset-0 pointer-events-none">
                    <div
                        class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-indigo-500/5 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3">
                    </div>
                    <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
                                <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid)" />
                    </svg>
                </div>
                <div class="relative z-10 text-center px-6 pt-32 pb-16">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary/8 text-primary font-bold text-[11px] mb-6 border border-primary/15 uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[14px]">shield</span>
                        আইনি দলিল
                    </div>
                    <h1 class="font-black tracking-tight leading-tight mb-4"
                        style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
                        গোপনীয়তা <span class="text-primary">নীতি</span>
                    </h1>
                    <p class="text-slate-500 dark:text-slate-400 text-base max-w-xl mx-auto">
                        সর্বশেষ আপডেট: ফেব্রুয়ারি ২০, ২০২৬
                    </p>
                </div>
            </section>

            <!-- Content -->
            <section class="py-20 px-6">
                <div class="max-w-3xl mx-auto space-y-16">

                    <!-- Intro -->
                    <div class="p-8 rounded-3xl bg-primary/5 border border-primary/10 reveal">
                        <div class="flex items-start gap-4">
                            <div
                                class="size-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-1">
                                <span class="material-symbols-outlined">info</span>
                            </div>
                            <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-[15px]">
                                ODDHAY ("আমরা", "আমাদের") আপনার গোপনীয়তাকে অত্যন্ত গুরুত্বের সাথে দেখে। এই নীতিটি
                                ব্যাখ্যা করে যে আমরা কীভাবে আপনার ব্যক্তিগত তথ্য সংগ্রহ, ব্যবহার ও রক্ষা করি। আমাদের
                                প্ল্যাটফর্ম ব্যবহার করে আপনি এই নীতিতে সম্মতি দিচ্ছেন।
                            </p>
                        </div>
                    </div>

                    <!-- Sections -->
                    <% const sections=[ { icon: 'database' , title: '১. আমরা কী তথ্য সংগ্রহ করি' , color: 'primary' ,
                        items: [ { label: 'ব্যক্তিগত তথ্য' ,
                        desc: 'নাম, ইমেইল ঠিকানা, ফোন নম্বর, যা রেজিস্ট্রেশনের সময় প্রদান করা হয়।' }, {
                        label: 'একাডেমিক তথ্য' , desc: 'আপনার শ্রেণি, বিভাগ এবং পড়াশোনার অগ্রগতি সম্পর্কিত তথ্য।' }, {
                        label: 'পেমেন্ট তথ্য' ,
                        desc: 'কোর্স কেনার সময় পেমেন্ট গেটওয়ের মাধ্যমে প্রদানকৃত তথ্য (কার্ড নম্বর আমাদের কাছে সংরক্ষিত হয় না)।'
                        }, { label: 'ব্যবহারের তথ্য' ,
                        desc: 'আপনি কোন পেজ ভিজিট করেছেন, কত সময় কাটিয়েছেন — ব্যানার ও অ্যানালিটিক্স ডেটা।' } ] }, {
                        icon: 'manage_accounts' , title: '২. তথ্য কীভাবে ব্যবহার করা হয়' , color: 'indigo-500' , items:
                        [ { label: 'সেবা প্রদান' , desc: 'আপনার অ্যাকাউন্ট পরিচালনা ও কোর্স অ্যাক্সেস নিশ্চিত করতে।' },
                        { label: 'উন্নতি' , desc: 'প্ল্যাটফর্মের ফিচার ও ব্যবহারকারীর অভিজ্ঞতা উন্নত করতে।' }, {
                        label: 'যোগাযোগ' , desc: 'গুরুত্বপূর্ণ আপডেট, নতুন কোর্স ও অফার সম্পর্কে জানাতে।' }, {
                        label: 'নিরাপত্তা' , desc: 'প্রতারণা ও অননুমোদিত অ্যাক্সেস প্রতিরোধ করতে।' } ] }, { icon: 'lock'
                        , title: '৩. তথ্যের সুরক্ষা' , color: 'emerald-500' , items: [ { label: 'এনক্রিপশন' ,
                        desc: 'সমস্ত ডেটা ট্রান্সমিশন SSL/TLS এনক্রিপশনের মাধ্যমে সুরক্ষিত।' }, {
                        label: 'সীমিত অ্যাক্সেস' , desc: 'শুধুমাত্র অনুমোদিত কর্মীরা আপনার তথ্যে প্রবেশ করতে পারেন।' },
                        { label: 'নিয়মিত অডিট' ,
                        desc: 'আমাদের সিস্টেম নিয়মিতভাবে নিরাপত্তা পর্যালোচনার মধ্য দিয়ে যায়।' } ] }, { icon: 'share'
                        , title: '৪. তৃতীয় পক্ষের সাথে তথ্য শেয়ার' , color: 'amber-500' , items: [ {
                        label: 'পেমেন্ট প্রসেসর' , desc: 'লেনদেন সম্পন্ন করতে নির্ভরযোগ্য পেমেন্ট গেটওয়ের সাথে।' }, {
                        label: 'কোনো বিক্রি নেই' ,
                        desc: 'আমরা কখনো আপনার ব্যক্তিগত তথ্য তৃতীয় পক্ষের কাছে বিক্রি করি না।' }, {
                        label: 'আইনি প্রয়োজনে' , desc: 'আদালতের নির্দেশ বা আইন অনুযায়ী তথ্য প্রদান করা হতে পারে।' } ]
                        }, { icon: 'person_check' , title: '৫. আপনার অধিকার' , color: 'rose-500' , items: [ {
                        label: 'তথ্য দেখার অধিকার' , desc: 'আপনার সম্পর্কে কোন তথ্য আমাদের কাছে আছে তা জানার অধিকার।' },
                        { label: 'সংশোধনের অধিকার' , desc: 'ভুল বা অসম্পূর্ণ তথ্য সংশোধন করার অনুরোধ করার অধিকার।' }, {
                        label: 'মুছে ফেলার অধিকার' , desc: 'আপনার অ্যাকাউন্ট ও তথ্য মুছে ফেলার জন্য আবেদন করার অধিকার।'
                        } ] } ]; sections.forEach((sec, i)=> { %>
                        <div class="reveal" style="transition-delay: <%= i * 60 %>ms">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="size-10 rounded-2xl bg-<%= sec.color %>/10 text-<%= sec.color %> flex items-center justify-center">
                                    <span class="material-symbols-outlined text-xl">
                                        <%= sec.icon %>
                                    </span>
                                </div>
                                <h2 class="text-xl font-black text-slate-900 dark:text-white">
                                    <%= sec.title %>
                                </h2>
                            </div>
                            <div class="space-y-4 pl-2">
                                <% sec.items.forEach(item=> { %>
                                    <div
                                        class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-primary/20 transition-all">
                                        <p class="font-black text-sm text-slate-900 dark:text-white mb-1">
                                            <%= item.label %>
                                        </p>
                                        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                                            <%= item.desc %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% }) %>

                            <!-- Cookies -->
                            <div class="reveal">
                                <div class="flex items-center gap-3 mb-6">
                                    <div
                                        class="size-10 rounded-2xl bg-purple-500/10 text-purple-500 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-xl">cookie</span>
                                    </div>
                                    <h2 class="text-xl font-black text-slate-900 dark:text-white">৬. কুকিজ</h2>
                                </div>
                                <div
                                    class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                                    <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">আমরা লগইন সেশন
                                        ও পছন্দ মনে রাখতে কুকিজ ব্যবহার করি। ব্রাউজার সেটিং থেকে কুকিজ বন্ধ করা যাবে,
                                        তবে কিছু ফিচার তখন কাজ নাও করতে পারে।</p>
                                </div>
                            </div>

                            <!-- Contact -->
                            <div
                                class="reveal p-8 rounded-3xl bg-gradient-to-br from-primary/5 to-indigo-500/5 border border-primary/10">
                                <h2 class="text-xl font-black mb-4">যোগাযোগ করুন</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4">গোপনীয়তা
                                    সংক্রান্ত যেকোনো প্রশ্নের জন্য আমাদের সাথে যোগাযোগ করুন:</p>
                                <div class="flex flex-wrap gap-4">
                                    <a href="mailto:support@oddhay.com"
                                        class="btn-primary !py-2.5 !px-6 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">alternate_email</span>
                                        support@oddhay.com
                                    </a>
                                    <a href="/#contact"
                                        class="btn-secondary !py-2.5 !px-6 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">chat</span>
                                        যোগাযোগ ফর্ম
                                    </a>
                                </div>
                            </div>

                </div>
            </section>
        </main>

        <!-- Footer removed -->

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
                    }, { threshold: 0.08 });
                    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
                });
            </script>
</body>

</html>