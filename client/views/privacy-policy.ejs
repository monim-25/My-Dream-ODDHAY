<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>গোপনীয়তা নীতি (Privacy Policy) | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়)-এর গোপনীয়তা নীতি — শিক্ষার্থীদের তথ্যের সুরক্ষা, ব্যবহার এবং নিরাপত্তা সংক্রান্ত নীতিমালা।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans">
    <%- include('partials/nav') %>

    <main class="flex-1">
        <!-- Hero Banner -->
        <section class="relative min-h-[38vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-500/5 via-slate-50 to-white dark:from-emerald-950/20 dark:via-slate-950 dark:to-slate-900">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-emerald-500/8 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/8 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3"></div>
                <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
                            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#grid)" />
                </svg>
            </div>
            <div class="relative z-10 text-center px-6 pt-32 pb-14">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] mb-5 border border-emerald-500/20 uppercase tracking-wider">
                    <span class="material-symbols-rounded text-sm">security</span>
                    আইনি দলিল ও ডেটা সুরক্ষা
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
                    গোপনীয়তা <span class="text-emerald-600 dark:text-emerald-400">নীতি (Privacy Policy)</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
                    সর্বশেষ আপডেট: ২০২৬ | ODDHAY (অধ্যায়)
                </p>
            </div>
        </section>

        <!-- Content Section -->
        <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto space-y-12">

                <!-- Introduction Callout -->
                <div class="p-6 sm:p-8 rounded-3xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-800/40 reveal">
                    <div class="flex items-start gap-4">
                        <div class="size-11 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                            <span class="material-symbols-rounded text-2xl">verified_user</span>
                        </div>
                        <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-xs sm:text-sm font-normal">
                            ODDHAY ("অধ্যায়", "আমরা", "আমাদের") প্ল্যাটফর্ম ব্যবহারকারী শিক্ষার্থী ও অভিভাবকদের ব্যক্তিগত তথ্যের সুরক্ষাকে সর্বোচ্চ অগ্রাধিকার প্রদান করে। এই নীতিমালায় আমরা কীভাবে আপনার তথ্য সংগ্রহ, সংরক্ষণ ও ব্যবহার করি তা বিশদভাবে বর্ণনা করা হলো। আমাদের সেবা ব্যবহারের মাধ্যমে আপনি এই নীতিমালায় সম্মতি দিচ্ছেন।
                        </p>
                    </div>
                </div>

                <!-- Privacy Sections -->
                <% 
                const sections = [
                    { 
                        icon: 'database', 
                        title: '১. আমরা কী কী তথ্য সংগ্রহ করি', 
                        color: 'emerald-500', 
                        items: [
                            { label: 'ব্যক্তিগত পরিচিতি', desc: 'নাম, মোবাইল নম্বর, ইমেইল ঠিকানা — যা রেজিস্ট্রেশন ও প্রোফাইল তৈরির সময় প্রদান করা হয়।' },
                            { label: 'একাডেমিক তথ্য', desc: 'আপনার অধ্যায়নরত শ্রেণি (Class 9-12), বিভাগ, শিক্ষা বোর্ড এবং বিভিন্ন টেস্টে আপনার অর্জিত নম্বর ও প্রগ্রেস রিপোর্ট।' },
                            { label: 'পেমেন্ট ও ট্রানজ্যাকশন ডেটা', desc: 'কোর্স এনরোলমেন্টের সময় পেমেন্ট গেটওয়ের মাধ্যমে লেনদেন সংক্রান্ত রেকর্ড (কার্ড নম্বর বা পাসওয়ার্ড আমাদের সার্ভারে কখনো সংরক্ষিত হয় না)।' },
                            { label: 'প্রযুক্তিগত ও লগ তথ্য', desc: 'ব্রাউজার টাইপ, ডিভাইস মডেল, আইপি এড্রেস এবং প্ল্যাটফর্মে সক্রিয় থাকার সময়কাল।' }
                        ] 
                    },
                    { 
                        icon: 'manage_accounts', 
                        title: '২. তথ্যের ব্যবহার ও উদ্দেশ্য', 
                        color: 'indigo-500', 
                        items: [
                            { label: 'সেবা পরিচালনা', desc: 'একাউন্ট ভেরিফিকেশন, লগইন সুবিধা ও আপনার শ্রেণির উপযোগী কোর্স ও পরীক্ষা প্রদান।' },
                            { label: 'ফলাফল বিশ্লেষণ', desc: 'মডেল টেস্টের স্কোরকার্ড তৈরি, লিডারবোর্ড এবং দুর্বল বিষয়গুলোর সঠিক এনালাইসিস প্রস্তুত।' },
                            { label: 'যোগাযোগ ও সাপোর্ট', desc: 'পরীক্ষার শিডিউল, ফলাফল এবং কোনো টেকনিক্যাল জটিলতায় সহায়তা দিতে এসএমএস বা ইমেইল পাঠানো।' },
                            { label: 'নিরাপত্তা নিশ্চিতকরণ', desc: 'অননুমোদিত একাউন্ট শেয়ারিং বা সাইবার প্রতারণা রোধ।' }
                        ] 
                    },
                    { 
                        icon: 'lock', 
                        title: '৩. ডেটা সুরক্ষা ও এনক্রিপশন', 
                        color: 'emerald-600', 
                        items: [
                            { label: 'SSL/TLS এনক্রিপশন', desc: 'প্ল্যাটফর্মের সকল তথ্য আদান-প্রদান আধুনিক ২৫৬-বিট SSL/TLS সিকিউর প্রোটোকলের মাধ্যমে সুরক্ষিত।' },
                            { label: 'নিয়ন্ত্রিত অ্যাক্সেস', desc: 'শুধুমাত্র অনুমোদিত টেকনিক্যাল ও সাপোর্ট স্টাফ নির্দিষ্ট নীতিমালার আওতায় তথ্যে অ্যাক্সেস করতে পারেন।' },
                            { label: 'নিয়মিত ব্যাকআপ', desc: 'সার্ভার ও ডেটাবেজে নিয়মিত এনক্রিপ্টেড ব্যাকআপ নেওয়া হয় যাতে কোনো তথ্য বিনষ্ট না হয়।' }
                        ] 
                    },
                    { 
                        icon: 'share', 
                        title: '৪. তৃতীয় পক্ষের সাথে তথ্য বিনিময় নীতি', 
                        color: 'amber-500', 
                        items: [
                            { label: 'কোনো বিজ্ঞাপন বা বাণিজ্যিক বিক্রি নেই', desc: 'আমরা কখনো কোনো বাণিজ্যিক উদ্দেশ্যে বা থার্ড-পার্টির বিজ্ঞাপনের কাছে শিক্ষার্থীদের ফোন নম্বর বা ব্যক্তিগত তথ্য বিক্রি করি না।' },
                            { label: 'অনুমোদিত গেটওয়ে সেবা', desc: 'কেবলমাত্র পেমেন্ট প্রসেসিং এবং ভেরিফিকেশন সম্পন্ন করতে সরকারি রেজিস্টার্ড পেমেন্ট গেটওয়ের সাথে প্রয়োজনীয় ট্রানজ্যাকশন ডেটা আদান-প্রদান করা হয়।' },
                            { label: 'আইনি বাধ্যবাধকতা', desc: 'দেশের প্রচলিত আইন অনুযায়ী আদালত বা আইন প্রয়োগকারী সংস্থার বৈধ নির্দেশে তথ্য প্রকাশ করা হতে পারে।' }
                        ] 
                    },
                    { 
                        icon: 'person_check', 
                        title: '৫. শিক্ষার্থীর অধিকার ও নিয়ন্ত্রণ', 
                        color: 'rose-500', 
                        items: [
                            { label: 'তথ্য সংশোধনের সুযোগ', desc: 'আপনার প্রোফাইল পেজ থেকে যেকোনো সময় নাম, শিক্ষা প্রতিষ্ঠান বা অন্যান্য তথ্য সংশোধন করতে পারবেন।' },
                            { label: 'একাউন্ট মুছে ফেলা', desc: 'প্রয়োজনে হেল্পডেস্কে লিখিত আবেদনের মাধ্যমে আপনার একাউন্ট ও সম্পর্কিত সকল ডেটা সম্পূর্ণ ডিলিট করার আবেদন করতে পারবেন।' }
                        ] 
                    }
                ]; 
                %>

                <% sections.forEach((sec, i) => { %>
                    <div class="reveal space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="size-9 rounded-xl bg-<%= sec.color %>/10 text-<%= sec.color %> flex items-center justify-center">
                                <span class="material-symbols-rounded text-lg"><%= sec.icon %></span>
                            </div>
                            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                                <%= sec.title %>
                            </h2>
                        </div>
                        <div class="space-y-3">
                            <% sec.items.forEach(item => { %>
                                <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                                    <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white mb-1">
                                        <%= item.label %>
                                    </h3>
                                    <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed font-normal">
                                        <%= item.desc %>
                                    </p>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>

                <!-- Contact & Questions Box -->
                <div class="reveal p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-3">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">গোপনীয়তা বিষয়ক যেকোনো জিজ্ঞাসা</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        আমাদের ডেটা প্রটেকশন নীতি সম্পর্কে কোনো প্রশ্ন থাকলে নির্দ্বিধায় আমাদের সাপোর্ট টিমের সাথে যোগাযোগ করুন:
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3">
                        <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#18a957] text-white text-xs font-semibold hover:bg-[#148e49] transition-all shadow-xs">
                            <span class="material-symbols-rounded text-sm">mail</span>
                            <span><%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %></span>
                        </a>
                        <a href="/contact" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all border border-slate-200 dark:border-slate-700">
                            <span class="material-symbols-rounded text-sm">support_agent</span>
                            <span>সাপোর্ট পাতা</span>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        });
    </script>
</body>

</html>
