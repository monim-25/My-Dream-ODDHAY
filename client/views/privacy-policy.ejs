<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title><%= (locals.siteSettings && siteSettings.privacyPolicy && siteSettings.privacyPolicy.metaTitle) ? siteSettings.privacyPolicy.metaTitle : 'Privacy Policy | ODDHAY' %></title>
    <meta name="description" content="Official Privacy Policy for ODDHAY digital education platform. Learn how ODDHAY protects student data, ensures security, and complies with legal standards.">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-10 sm:py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto space-y-7">

            <!-- Simple Clean Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
                <nav class="flex items-center gap-2 text-sm text-slate-400 dark:text-slate-500 mb-2 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">Privacy Policy</span>
                </nav>
                <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    Privacy Policy
                </h1>
            </div>

            <!-- Custom Content from SuperAdmin if provided -->
            <% const customPrivacy = (locals.siteSettings && siteSettings.policiesAndLegal && siteSettings.policiesAndLegal.privacyPolicy) ? siteSettings.policiesAndLegal.privacyPolicy : ((locals.siteSettings && siteSettings.privacyPolicy && siteSettings.privacyPolicy.customContent) ? siteSettings.privacyPolicy.customContent : ''); %>
            <% if (customPrivacy && customPrivacy.trim().length > 0) { %>
                <div class="prose dark:prose-invert max-w-none text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed space-y-4">
                    <%- customPrivacy %>
                </div>
            <% } else { %>
                <!-- Standard Concise English Policy -->
                <div class="space-y-6 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
                    
                    <!-- Overview -->
                    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
                        <p>
                            ODDHAY prioritizes student privacy and personal data protection. This Privacy Policy describes how ODDHAY collects, uses, and safeguards information when learners, educators, and guardians interact with the ODDHAY online learning platform, live model tests, and academic question banks.
                        </p>
                    </div>

                    <!-- 1. Information ODDHAY Collects -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">database</span>
                            <span>1. Information ODDHAY Collects</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <p><strong>Account Information:</strong> Name, email address, and contact number supplied during registration.</p>
                            <p><strong>Academic Data:</strong> Class level (Class 9 to 12), academic department, board exam preparation details, quiz scores, and subject progress analytics.</p>
                            <p><strong>Payment Records:</strong> Transaction IDs and payment confirmations provided by authorized gateway partners. ODDHAY never records or retains credit card details or mobile banking PIN numbers.</p>
                            <p><strong>Device Information:</strong> Device type, browser environment, and platform activity logs gathered to maintain consistent session performance.</p>
                        </div>
                    </div>

                    <!-- 2. How ODDHAY Uses Information -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">tune</span>
                            <span>2. How ODDHAY Uses Information</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <p><strong>Academic Delivery:</strong> Granting course access, verifying enrollments, and scheduling live model tests.</p>
                            <p><strong>Assessment & Feedback:</strong> Calculating timer-based test rankings, performance curves, and personalized weak-topic reports.</p>
                            <p><strong>Support & Service:</strong> Delivering password recovery notices, examination reminders, and resolving technical queries.</p>
                            <p><strong>Account Security:</strong> Preventing unauthorized simultaneous logins, platform abuse, or fraudulent activities.</p>
                        </div>
                    </div>

                    <!-- 3. How ODDHAY Protects Your Data -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">lock</span>
                            <span>3. How ODDHAY Protects Data</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <p><strong>Encryption:</strong> All platform data transfers are encrypted with 256-bit SSL/TLS security protocols.</p>
                            <p><strong>Access Control:</strong> Administrative access to student data is restricted strictly to authorized staff on a role-verified basis.</p>
                            <p><strong>Data Backups:</strong> Automated encrypted backups protect against data loss and ensure service reliability.</p>
                        </div>
                    </div>

                    <!-- 4. Third-Party Sharing & Safeguards -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">verified_user</span>
                            <span>4. Third-Party Sharing Policy</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <p><strong>No Commercial Sale:</strong> ODDHAY does not sell, rent, or trade student personal records or phone numbers to external marketing entities.</p>
                            <p><strong>Payment Gateways:</strong> Necessary transaction references are processed solely with licensed payment gateways (such as bKash, Nagad, or bank card providers) to complete enrollments.</p>
                            <p><strong>Legal Obligations:</strong> ODDHAY may disclose records only where required by applicable law, statutory regulation, or valid court directive.</p>
                        </div>
                    </div>

                    <!-- 5. User Rights & Account Control -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">manage_accounts</span>
                            <span>5. Your Rights & Account Control</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <p><strong>Access & Updates:</strong> Users can inspect and modify profile details directly within account settings.</p>
                            <p><strong>Account Closure:</strong> Users may request account deactivation or data removal by submitting a request to the ODDHAY helpdesk.</p>
                        </div>
                    </div>

                    <!-- 6. Privacy Inquiries & Contact -->
                    <div class="space-y-2.5">
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-xl">mail</span>
                            <span>6. Contact ODDHAY on Privacy</span>
                        </h2>
                        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2 shadow-2xs">
                            <p>For questions regarding this policy or personal data handling, reach out to ODDHAY:</p>
                            <div class="pt-1.5 flex flex-wrap items-center gap-3 text-sm">
                                <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>"
                                    class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                    <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                                </a>
                                <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                                <a href="/contact" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                    Contact Support Desk
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer', { lang: 'en' }) %>
</body>

</html>