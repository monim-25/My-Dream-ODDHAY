<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Terms & Conditions | ODDHAY</title>
    <meta name="description" content="Official Terms & Conditions for ODDHAY digital education platform. Learn about user agreements, academic guidelines, and platform terms.">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
                <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 mb-1.5 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">Terms & Conditions</span>
                </nav>
                <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    Terms & Conditions
                </h1>
            </div>

            <!-- Custom Content from SuperAdmin if provided -->
            <% const customTerms = (locals.siteSettings && siteSettings.policiesAndLegal && siteSettings.policiesAndLegal.termsConditions) ? siteSettings.policiesAndLegal.termsConditions : ''; %>
            <% if (customTerms && customTerms.trim().length > 0) { %>
                <div class="prose dark:prose-invert max-w-none text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed space-y-4">
                    <%- customTerms %>
                </div>
            <% } else { %>
                <!-- Standard Concise English Terms -->
                <div class="space-y-4 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    
                    <!-- Intro Box -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
                        <p>
                            By accessing or using the ODDHAY website and digital learning services, you agree to comply with and be bound by these Terms & Conditions. These terms constitute a legally binding agreement between you and ODDHAY.
                        </p>
                    </div>

                    <!-- 1. Account Responsibilities -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-1.5 shadow-2xs">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-base">person</span>
                            <span>1. Account Registration & Security</span>
                        </h2>
                        <ul class="list-disc list-inside space-y-1 pl-1 font-normal">
                            <li>Users must provide accurate, up-to-date identification during registration.</li>
                            <li>You are solely responsible for maintaining the confidentiality of your login credentials.</li>
                            <li>An ODDHAY student account is strictly personal and non-transferable. Commercial reselling or sharing of account credentials is strictly prohibited.</li>
                        </ul>
                    </div>

                    <!-- 2. Academic Intellectual Property -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-1.5 shadow-2xs">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-base">school</span>
                            <span>2. Intellectual Property Rights</span>
                        </h2>
                        <ul class="list-disc list-inside space-y-1 pl-1 font-normal">
                            <li>All live tests, board question bank archives, explanations, notes, and software features are the exclusive intellectual property of ODDHAY.</li>
                            <li>Recording, scraping, reproducing, or redistributing ODDHAY materials without written consent constitutes a violation of copyright law.</li>
                        </ul>
                    </div>

                    <!-- 3. Payment & Subscription Terms -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-1.5 shadow-2xs">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-base">payments</span>
                            <span>3. Fees, Payments & Refunds</span>
                        </h2>
                        <p class="font-normal">
                            Course fees are payable in Bangladeshi Taka (BDT) through authorized payment channels. Refund requests are subject to the guidelines outlined in the ODDHAY Refund Policy.
                        </p>
                    </div>

                    <!-- 4. Prohibited Conduct -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-1.5 shadow-2xs">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-amber-500 text-base">block</span>
                            <span>4. Prohibited Conduct</span>
                        </h2>
                        <p class="font-normal">
                            Attempting to bypass platform security measures, utilizing automated testing bots, or engaging in harassment within community spaces will result in immediate termination of account privileges without refund.
                        </p>
                    </div>

                    <!-- 5. Contact & Questions -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2 shadow-2xs">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-base">support_agent</span>
                            <span>5. Inquiries & Assistance</span>
                        </h2>
                        <p class="font-normal">
                            For questions regarding these Terms & Conditions, please reach out to ODDHAY:
                        </p>
                        <div class="pt-1 flex flex-wrap gap-3 text-xs">
                            <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>"
                                class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                            </a>
                            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                            <a href="/privacy-policy" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                Privacy Policy
                            </a>
                        </div>
                    </div>

                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer', { lang: 'en' }) %>
</body>

</html>
