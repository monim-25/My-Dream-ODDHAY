<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>ব্যবহারের শর্তাবলী (Terms & Conditions) | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়)-এর ব্যবহারের শর্তাবলী — আমাদের ডিজিটাল শিক্ষা প্ল্যাটফর্ম ব্যবহারের নিয়মাবলী ও আইনি চুক্তি।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans">
    <%- include('partials/nav') %>

    <main class="flex-1">
        <!-- Hero Banner -->
        <section class="relative min-h-[38vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-500/5 via-slate-50 to-white dark:from-emerald-950/20 dark:via-slate-950 dark:to-slate-900">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-indigo-500/8 rounded-full blur-[120px] -translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-emerald-500/8 rounded-full blur-[100px] translate-x-1/3 translate-y-1/3"></div>
                <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="grid2" width="60" height="60" patternUnits="userSpaceOnUse">
                            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#grid2)" />
                </svg>
            </div>
            <div class="relative z-10 text-center px-6 pt-32 pb-14">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold text-[11px] mb-5 border border-indigo-500/20 uppercase tracking-wider">
                    <span class="material-symbols-rounded text-sm">gavel</span>
                    আইনি চুক্তি ও ব্যবহারের নিয়মাবলী
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
                    ব্যবহারের <span class="text-emerald-600 dark:text-emerald-400">শর্তাবলী (Terms)</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
                    সর্বশেষ আপডেট: ২০২৬ | ODDHAY (অধ্যায়)
                </p>
            </div>
        </section>

        <!-- Terms Content -->
        <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto space-y-12">

                <!-- Intro Card -->
                <div class="p-6 sm:p-8 rounded-3xl bg-indigo-50/70 dark:bg-indigo-950/20 border border-indigo-200/80 dark:border-indigo-800/40 reveal">
                    <div class="flex items-start gap-4">
                        <div class="size-11 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 mt-0.5">
                            <span class="material-symbols-rounded text-2xl">info</span>
                        </div>
                        <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-xs sm:text-sm font-normal">
                            ODDHAY (অধ্যায়) প্ল্যাটফর্মের ওয়েবসাইট ও ডিজিটাল সেবা ব্যবহারের মাধ্যমে আপনি এই শর্তাবলী ও নিয়মনীতির সাথে একমত পোষণ করছেন। এই শর্তাবলী আপনার এবং ODDHAY-এর মধ্যে একটি বাধ্যতামূলক আইনি চুক্তি হিসেবে গণ্য হবে।
                        </p>
                    </div>
                </div>

                <!-- Terms Sections -->
                <% 
                const terms = [
                    { 
                        icon: 'verified_user', 
                        title: '১. একাউন্ট ও ব্যবহারকারীর দায়িত্ব', 
                        color: 'emerald-500', 
                        items: [
                            { label: 'সঠিক তথ্য প্রদান', desc: 'রেজিস্ট্রেশনের সময় আপনার নাম, ফোন নম্বর ও একাডেমিক তথ্যের সত্যতা নিশ্চিত করতে হবে। মিথ্যা তথ্য দিলে একাউন্ট স্থগিত হতে পারে।' },
                            { label: 'লগইন তথ্যের সুরক্ষা', desc: 'আপনার একাউন্টের পাসওয়ার্ড ও লগইন ক্রেডেনশিয়াল সম্পূর্ণ গোপন রাখবেন। আপনার একাউন্টের মাধ্যমে ঘটিত যেকোনো কার্যক্রমের দায়ভার আপনার।' },
                            { label: 'একাউন্ট শেয়ারিং নিষিদ্ধ', desc: 'একটি একাউন্ট শুধুমাত্র একজন শিক্ষার্থীর ব্যবহারের জন্য। বাণিজ্যিক উদ্দেশ্যে বা একাধিক ব্যক্তির মাঝে শেয়ার করা আইনত দণ্ডনীয়।' }
                        ] 
                    },
                    { 
                        icon: 'school', 
                        title: '২. কোর্স উপাদান ও মেধা সম্পদ অধিকার', 
                        color: 'indigo-500', 
                        items: [
                            { label: 'ব্যক্তিগত শিক্ষা উদ্দেশ্যে ব্যবহার', desc: 'ODDHAY-এর সকল লাইভ টেস্ট, বিগত বছরের বোর্ড প্রশ্নব্যাংক, লেকচার ও শিট শুধুমাত্র ব্যক্তিগত পড়াশোনার উদ্দেশ্যে ব্যবহার্য।' },
                            { label: 'কপিরাইট ও পাইরেসি বিরোধী নীতি', desc: 'প্ল্যাটফর্মের কোনো প্রশ্ন, উত্তরপত্র, সফটওয়্যার কোড বা ভিডিও রেকর্ড করে অন্য কোথাও বিতরণ, বিক্রি বা আপলোড করা কঠোরভাবে নিষিদ্ধ।' },
                            { label: 'আইনি সুরক্ষার আওতায়', desc: 'কপিরাইট লঙ্ঘনের যেকোনো ঘটনার বিরুদ্ধে কপিরাইট আইন ও ডিজিটাল নিরাপত্তা আইনে তাৎক্ষণিক ব্যবস্থা গ্রহণ করা হবে।' }
                        ] 
                    },
                    { 
                        icon: 'payments', 
                        title: '৩. পেমেন্ট, রিফান্ড ও সাবস্ক্রিপশন', 
                        color: 'amber-500', 
                        items: [
                            { label: 'পেমেন্ট মাধ্যম', desc: 'সকল পেমেন্ট বাংলাদেশী টাকায় (BDT) বিকাশ, নগদ, রকেট, কার্ড বা অনলাইন ব্যাংকিংয়ের মাধ্যমে সম্পন্ন করতে হবে।' },
                            { label: 'স্বচ্ছ রিফান্ড নিয়ম', desc: 'কোর্স এনরোলের ৪৮ ঘণ্টার মধ্যে যৌক্তিক কারণে রিফান্ডের আবেদন করা যাবে। বিস্তারিত শর্তাবলীর জন্য রিফান্ড পলিসি পাতা অনুসরণ করুন।' },
                            { label: 'অফার ও কুপন কোড', desc: 'ডিসকাউন্ট কুপন শুধুমাত্র নির্ধারিত মেয়াদের মধ্যে ব্যবহারযোগ্য এবং হস্তান্তরযোগ্য নয়।' }
                        ] 
                    },
                    { 
                        icon: 'block', 
                        title: '৪. নিষিদ্ধ কার্যক্রম ও আচরণবিধি', 
                        color: 'rose-500', 
                        items: [
                            { label: 'হ্যাকিং ও কারসাজি', desc: 'প্ল্যাটফর্মের সিকিউরিটি ভাঙা, স্বয়ংক্রিয় বট বা স্ক্রিপ্ট চালানো সম্পূর্ণ নিষিদ্ধ।' },
                            { label: 'শালীনতা রক্ষা', desc: 'ফোরাম, কমেন্ট সেকশন বা লাইভ চ্যাটে কোনো শিক্ষক বা শিক্ষার্থীর সাথে অশোভন মন্তব্য করা হলে তাৎক্ষণিক স্থায়ী বহিষ্কার করা হবে।' }
                        ] 
                    },
                    { 
                        icon: 'policy', 
                        title: '৫. শর্তাবলীর হালনাগাদ ও পরিবর্তন', 
                        color: 'purple-500', 
                        items: [
                            { label: 'পরিবর্তনের অধিকার', desc: 'ODDHAY যেকোনো সময় এই শর্তাবলীতে পরিবর্তন বা পরিমার্জন আনার অধিকার সংরক্ষণ করে। পরিবর্তনের পর সাইটে প্রকাশের সাথে সাথে তা কার্যকর হবে।' }
                        ] 
                    }
                ]; 
                %>

                <% terms.forEach((term, i) => { %>
                    <div class="reveal space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="size-9 rounded-xl bg-<%= term.color %>/10 text-<%= term.color %> flex items-center justify-center">
                                <span class="material-symbols-rounded text-lg"><%= term.icon %></span>
                            </div>
                            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                                <%= term.title %>
                            </h2>
                        </div>
                        <div class="space-y-3">
                            <% term.items.forEach(item => { %>
                                <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                                    <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white mb-1">
                                        <%= item.label %>
                                    </h3>
                                    <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed font-normal">
                                        <%= item.desc %>
                                    </p>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>

                <!-- Disclaimer Box -->
                <div class="reveal p-6 sm:p-8 rounded-3xl bg-amber-50/70 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-800/40">
                    <div class="flex items-start gap-4">
                        <div class="size-11 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                            <span class="material-symbols-rounded text-2xl">warning</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-slate-900 dark:text-white mb-1">দায়মুক্তি (Disclaimer)</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed font-normal">
                                ODDHAY সর্বদা সর্বাধুনিক প্রযুক্তি ও নির্ভুল শিক্ষা উপাদান সরবরাহে সচেষ্ট। তবে ইন্টারনেট সংযোগের বিঘ্ন বা প্রযুক্তিগত ত্রুটির কারণে সাময়িক বিভ্রাটের ক্ষেত্রে আমরা দ্রুত সমাধানের অঙ্গীকার করছি।
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Contact Box -->
                <div class="reveal p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-3">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">শর্তাবলী সংক্রান্ত প্রশ্ন?</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                        আমাদের সাথে যোগাযোগ করতে পারেন:
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3">
                        <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#18a957] text-white text-xs font-semibold hover:bg-[#148e49] transition-all shadow-xs">
                            <span class="material-symbols-rounded text-sm">mail</span>
                            <span><%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %></span>
                        </a>
                        <a href="/privacy-policy" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all border border-slate-200 dark:border-slate-700">
                            <span class="material-symbols-rounded text-sm">shield</span>
                            <span>গোপনীয়তা নীতি</span>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        });
    </script>
</body>

</html>
