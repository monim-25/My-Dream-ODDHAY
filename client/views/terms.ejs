<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>শর্তাবলী | ODDHAY</title>
    <meta name="description"
        content="ODDHAY-এর ব্যবহারের শর্তাবলী — আমাদের প্ল্যাটফর্ম ব্যবহার করার আগে অনুগ্রহ করে পড়ুন।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">
    <%- include('partials/nav') %>

        <main>
            <!-- Hero Banner -->
            <section
                class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-50 to-white dark:from-slate-950 dark:to-slate-900">
                <div class="absolute inset-0 pointer-events-none">
                    <div
                        class="absolute top-0 left-0 w-[500px] h-[500px] bg-indigo-500/5 rounded-full blur-[120px] -translate-x-1/3 -translate-y-1/3">
                    </div>
                    <div
                        class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-primary/5 rounded-full blur-[100px] translate-x-1/3 translate-y-1/3">
                    </div>
                    <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="grid2" width="60" height="60" patternUnits="userSpaceOnUse">
                                <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid2)" />
                    </svg>
                </div>
                <div class="relative z-10 text-center px-6 pt-32 pb-16">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-500/8 text-indigo-600 dark:text-indigo-400 font-bold text-[11px] mb-6 border border-indigo-500/15 uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[14px]">gavel</span>
                        আইনি দলিল
                    </div>
                    <h1 class="font-black tracking-tight leading-tight mb-4"
                        style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
                        ব্যবহারের <span class="text-primary">শর্তাবলী</span>
                    </h1>
                    <p class="text-slate-500 dark:text-slate-400 text-base max-w-xl mx-auto">
                        সর্বশেষ আপডেট: ফেব্রুয়ারি ২০, ২০২৬
                    </p>
                </div>
            </section>

            <!-- Content -->
            <section class="py-20 px-6">
                <div class="max-w-3xl mx-auto space-y-16">

                    <!-- Intro -->
                    <div class="p-8 rounded-3xl bg-indigo-500/5 border border-indigo-500/10 reveal">
                        <div class="flex items-start gap-4">
                            <div
                                class="size-12 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center shrink-0 mt-1">
                                <span class="material-symbols-outlined">info</span>
                            </div>
                            <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-[15px]">
                                ODDHAY প্ল্যাটফর্ম ব্যবহার করে আপনি এই শর্তাবলীতে সম্মতি দিচ্ছেন। এই শর্তাবলী আপনার এবং
                                ODDHAY-এর মধ্যে একটি আইনি চুক্তি। অনুগ্রহ করে মনোযোগ দিয়ে পড়ুন।
                            </p>
                        </div>
                    </div>

                    <!-- Terms Sections -->
                    <% const terms=[ { icon: 'verified_user' , title: '১. অ্যাকাউন্ট ও রেজিস্ট্রেশন' , color: 'primary'
                        , items: [ { label: 'বয়সসীমা' ,
                        desc: 'আমাদের প্ল্যাটফর্ম ব্যবহার করতে আপনার বয়স কমপক্ষে ১৩ বছর হতে হবে। অপ্রাপ্তবয়স্ক শিক্ষার্থীদের ক্ষেত্রে অভিভাবকের অনুমতি প্রয়োজন।'
                        }, { label: 'সঠিক তথ্য' ,
                        desc: 'রেজিস্ট্রেশনের সময় আপনাকে সঠিক ও সম্পূর্ণ তথ্য প্রদান করতে হবে। মিথ্যা তথ্য দিলে অ্যাকাউন্ট বাতিল হতে পারে।'
                        }, { label: 'পাসওয়ার্ড সুরক্ষা' ,
                        desc: 'আপনার পাসওয়ার্ড গোপন রাখুন। অ্যাকাউন্টের যেকোনো কার্যক্রমের দায়িত্ব আপনার।' } ] }, {
                        icon: 'school' , title: '২. কোর্স ও কন্টেন্ট' , color: 'emerald-500' , items: [ {
                        label: 'ব্যক্তিগত ব্যবহার' ,
                        desc: 'কোনো কোর্স শুধুমাত্র ব্যক্তিগত ব্যবহারের জন্য। কোনো বাণিজ্যিক উদ্দেশ্যে ব্যবহার করা যাবে না।'
                        }, { label: 'শেয়ারিং নিষিদ্ধ' ,
                        desc: 'আপনার লগইন তথ্য বা কোর্স কন্টেন্ট অন্যের সাথে শেয়ার করা কঠোরভাবে নিষিদ্ধ।' }, {
                        label: 'কন্টেন্ট পরিবর্তন' ,
                        desc: 'ODDHAY যেকোনো সময় কোর্সের বিষয়বস্তু আপডেট বা সরিয়ে নিতে পারে।' } ] }, {
                        icon: 'payments' , title: '৩. পেমেন্ট ও রিফান্ড' , color: 'amber-500' , items: [ {
                        label: 'পেমেন্ট' ,
                        desc: 'সমস্ত পেমেন্ট বাংলাদেশী টাকায় (BDT) সম্পন্ন হবে। পেমেন্ট সফল হলে কোর্স অ্যাক্সেস তৎক্ষণাৎ প্রদান করা হবে।'
                        }, { label: 'রিফান্ড নীতি' ,
                        desc: 'কোর্স কেনার ৭ দিনের মধ্যে কন্টেন্টের ৩০% এর কম দেখলে রিফান্ড এর আবেদন করা যাবে।' }, {
                        label: 'কুপন ও ছাড়' ,
                        desc: 'প্রচার কুপন শুধুমাত্র নির্দিষ্ট মেয়াদে বৈধ। একটি অ্যাকাউন্টে একটি কুপন একবার ব্যবহার করা যাবে।'
                        } ] }, { icon: 'block' , title: '৪. নিষিদ্ধ কার্যক্রম' , color: 'rose-500' , items: [ {
                        label: 'হ্যাকিং নিষিদ্ধ' ,
                        desc: 'প্ল্যাটফর্মের নিরাপত্তা লঙ্ঘন, হ্যাকিং বা ম্যালওয়্যার ছড়ানোর চেষ্টা করলে আইনি ব্যবস্থা নেওয়া হবে।'
                        }, { label: 'অপমানজনক আচরণ' ,
                        desc: 'অন্য ব্যবহারকারী বা শিক্ষকদের সাথে অপমানজনক বা হেনস্তামূলক আচরণ সম্পূর্ণ নিষিদ্ধ।' }, {
                        label: 'কপিরাইট লঙ্ঘন' ,
                        desc: 'কোর্সের ভিডিও, নোটস বা অন্য কন্টেন্ট রেকর্ড, কপি বা বিতরণ করা কঠোরভাবে নিষিদ্ধ।' } ] }, {
                        icon: 'copyright' , title: '৫. মেধাস্বত্ব' , color: 'purple-500' , items: [ {
                        label: 'সমস্ত অধিকার সংরক্ষিত' ,
                        desc: 'ODDHAY প্ল্যাটফর্মের সমস্ত কন্টেন্ট, ডিজাইন ও ব্র্যান্ড আমাদের মেধাস্বত্বের অধীনে।' }, {
                        label: 'ব্যবহারকারীর কন্টেন্ট' ,
                        desc: 'আপনি যদি কোনো কন্টেন্ট (যেমন, প্রশ্ন বা উত্তর) আপলোড করেন, তবে আমাদের তা প্রদর্শনের অনুমতি দিচ্ছেন।'
                        } ] } ]; terms.forEach((term, i)=> { %>
                        <div class="reveal" style="transition-delay: <%= i * 60 %>ms">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="size-10 rounded-2xl bg-<%= term.color %>/10 text-<%= term.color %> flex items-center justify-center">
                                    <span class="material-symbols-outlined text-xl">
                                        <%= term.icon %>
                                    </span>
                                </div>
                                <h2 class="text-xl font-black text-slate-900 dark:text-white">
                                    <%= term.title %>
                                </h2>
                            </div>
                            <div class="space-y-4 pl-2">
                                <% term.items.forEach(item=> { %>
                                    <div
                                        class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-primary/20 transition-all">
                                        <p class="font-black text-sm text-slate-900 dark:text-white mb-1">
                                            <%= item.label %>
                                        </p>
                                        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                                            <%= item.desc %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% }) %>

                            <!-- Disclaimer -->
                            <div class="reveal p-8 rounded-3xl bg-amber-500/5 border border-amber-500/15">
                                <div class="flex items-start gap-4">
                                    <div
                                        class="size-10 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined">warning</span>
                                    </div>
                                    <div>
                                        <h3 class="font-black text-slate-900 dark:text-white mb-2">দায়মুক্তি</h3>
                                        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">ODDHAY
                                            শিক্ষার্থীদের সর্বোত্তম অভিজ্ঞতা প্রদানের চেষ্টা করে, কিন্তু প্ল্যাটফর্মের
                                            নিরবচ্ছিন্ন পরিষেবা বা নির্ভুলতার কোনো গ্যারান্টি দেয় না। প্রযুক্তিগত
                                            সমস্যার জন্য আমরা ক্ষমাপ্রার্থী।</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Contact -->
                            <div
                                class="reveal p-8 rounded-3xl bg-gradient-to-br from-primary/5 to-indigo-500/5 border border-primary/10">
                                <h2 class="text-xl font-black mb-4">প্রশ্ন আছে?</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4">শর্তাবলী
                                    সম্পর্কিত যেকোনো প্রশ্নের জন্য যোগাযোগ করুন:</p>
                                <div class="flex flex-wrap gap-4">
                                    <a href="mailto:support@oddhay.com"
                                        class="btn-primary !py-2.5 !px-6 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">alternate_email</span>
                                        support@oddhay.com
                                    </a>
                                    <a href="/privacy-policy"
                                        class="btn-secondary !py-2.5 !px-6 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">shield</span>
                                        গোপনীয়তা নীতি
                                    </a>
                                </div>
                            </div>

                </div>
            </section>
        </main>

        <!-- Footer removed -->

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
                    }, { threshold: 0.08 });
                    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
                });
            </script>
</body>

</html>