<!DOCTYPE html>
<html lang="bn" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>পেমেন্ট জমা হয়েছে | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'dashboard' }) %>

        <main class="flex-1 w-full overflow-y-auto p-4 sm:p-6 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] flex items-center justify-center">
            <div class="max-w-xl w-full text-center py-6 sm:py-10">
                <!-- Animated checkmark / Status Icon -->
                <div class="relative mx-auto mb-8 size-32 sm:size-36 reveal-up">
                    <div
                        class="size-32 sm:size-36 rounded-3xl bg-amber-500/10 flex items-center justify-center border-2 border-amber-500/10">
                        <span
                            class="material-symbols-rounded text-6xl text-amber-500 animate-pulse">hourglass_top</span>
                    </div>
                    <div
                        class="absolute -top-2 -right-2 size-11 bg-emerald-500 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/30 border-2 border-white dark:border-slate-900">
                        <span class="material-symbols-rounded text-white text-2xl">check_circle</span>
                    </div>

                    <!-- Floating particles/circles for flair -->
                    <div
                        class="absolute -bottom-1 -left-1 size-5 bg-primary/20 rounded-full animate-bounce">
                    </div>
                    <div
                        class="absolute top-1/2 -right-4 size-3 bg-amber-500/20 rounded-full animate-ping">
                    </div>
                </div>

                <% const isNoteItem = payment.itemType === 'note' || payment.note; %>
                <% const isSuccess = payment.status === 'success' || payment.status === 'approved'; %>

                <h1 class="text-2xl sm:text-3xl font-black text-slate-800 dark:text-white mb-3 reveal-up"
                    style="animation-delay: 0.1s">পেমেন্ট জমা হয়েছে!</h1>
                <p class="text-slate-500 dark:text-slate-400 font-medium text-xs sm:text-sm mb-8 leading-relaxed reveal-up"
                    style="animation-delay: 0.2s">
                    <%= isNoteItem ? 'আপনার পেমেন্ট সফলভাবে জমা হয়েছে এবং নোটটি সাথে সাথেই আনলক হয়ে গেছে।' : 'আপনার পেমেন্ট রিকোয়েস্ট সফলভাবে জমা হয়েছে। অ্যাডমিন ভেরিফাই করার পর আপনার পছন্দের কোর্সটি আনলক হয়ে যাবে।' %>
                </p>

                <!-- Payment details card -->
                <div class="glass-card p-6 sm:p-7 mb-8 text-left rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs reveal-up" style="animation-delay: 0.3s">
                    <h3
                        class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-4 flex items-center gap-2">
                        <span class="material-symbols-rounded text-base text-primary">receipt_long</span> পেমেন্ট
                        সামারি
                    </h3>
                    <div class="space-y-3">
                        <div
                            class="flex justify-between items-center py-2.5 border-b border-slate-100 dark:border-slate-800/60">
                            <span
                                class="text-xs font-bold text-slate-400 uppercase tracking-widest"><%= isNoteItem ? 'নোট' : 'কোর্স' %></span>
                            <span class="text-xs sm:text-sm font-black text-slate-800 dark:text-white">
                                <%= isNoteItem ? (payment.note?.title || 'Note') : (payment.course?.title || 'N/A') %>
                            </span>
                        </div>
                        <div
                            class="flex justify-between items-center py-2.5 border-b border-slate-100 dark:border-slate-800/60">
                            <span
                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">পরিমাণ</span>
                            <span class="text-base sm:text-lg font-black text-primary">৳<%= payment.amount %></span>
                        </div>
                        <div
                            class="flex justify-between items-center py-2.5 border-b border-slate-100 dark:border-slate-800/60">
                            <span
                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">মেথড</span>
                            <span
                                class="text-xs font-black text-slate-800 dark:text-white capitalize px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60">
                                <%= payment.paymentMethod %>
                            </span>
                        </div>
                        <div
                            class="flex justify-between items-center py-2.5 border-b border-slate-100 dark:border-slate-800/60">
                            <span
                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">TrxID</span>
                            <span class="text-xs sm:text-sm font-black font-mono text-emerald-600">
                                <%= payment.transactionId %>
                            </span>
                        </div>
                        <div class="flex justify-between items-center py-2.5">
                            <span
                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">স্ট্যাটাস</span>
                            <% if (isSuccess) { %>
                                <span
                                    class="px-3 py-1 bg-emerald-500/10 text-emerald-500 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-500/20 flex items-center gap-1.5">
                                    <span class="size-2 rounded-full bg-emerald-500"></span>
                                    সফল (Unlocked)
                                </span>
                            <% } else { %>
                                <span
                                    class="px-3 py-1 bg-amber-500/10 text-amber-500 rounded-full text-[10px] font-black uppercase tracking-widest border border-amber-500/20 flex items-center gap-1.5">
                                    <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                                    অপেক্ষমান
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Info box -->
                <div class="p-5 bg-primary/5 rounded-2xl border border-primary/10 mb-8 text-left flex gap-4 reveal-up"
                    style="animation-delay: 0.4s">
                    <div
                        class="size-10 rounded-xl bg-white dark:bg-slate-800 flex items-center justify-center shrink-0 shadow-xs border border-primary/10">
                        <span class="material-symbols-rounded text-primary text-xl">info</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black text-primary uppercase tracking-widest mb-1">
                            পরবর্তী ধাপ</p>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-relaxed">
                            <%= isNoteItem ? 'আপনার নোটটি এখনই খোলা সম্ভব। নোট পেজে গিয়ে "View" অথবা "Download" বাটন চেপে নোটটি পড়তে পারেন।' : 'সাধারণত ১-২৪ ঘণ্টার মধ্যে আপনার পেমেন্ট ভেরিফাই করা হয়। ভেরিফিকেশন সম্পন্ন হলে আপনার ড্যাশবোর্ডে কোর্সটি সয়ংক্রিয়ভাবে একটিভ হয়ে যাবে।' %>
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center reveal-up"
                    style="animation-delay: 0.5s">
                    <% if (isNoteItem) { %>
                        <a href="/notes"
                            class="px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-md shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-1.5">
                            <span class="material-symbols-rounded text-base">description</span>
                            নোট পেজে যান
                        </a>
                        <a href="/dashboard"
                            class="px-6 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-white border border-slate-200 dark:border-slate-700 rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-95 transition-all">ড্যাশবোর্ডে
                            যান</a>
                    <% } else { %>
                        <a href="/dashboard"
                            class="px-6 py-3 bg-slate-900 dark:bg-slate-700 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-md shadow-slate-900/20 hover:bg-primary active:scale-95 transition-all">ড্যাশবোর্ডে
                            যান</a>
                        <a href="/courses"
                            class="px-6 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-white border border-slate-200 dark:border-slate-700 rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-95 transition-all">আরো
                            কোর্স দেখুন</a>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'dashboard' }) %>
    <%- include('partials/app-scripts') %>
</body>

</html>