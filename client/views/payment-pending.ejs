<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>পেমেন্ট জমা হয়েছে | ODDHAY</title>
    <%- include('partials/head') %>
        <%- include('partials/app-styles') %>
</head>

<body class="dark:text-white">
    <div class="app-container">
        <%- include('partials/app-header', { showSearch: false }) %>

            <div class="main-wrapper">
                <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
                <div id="notif-overlay" class="notif-overlay" onclick="toggleNotifications()"></div>

                <%- include('partials/app-sidebar', { activePage: 'dashboard' }) %>
                    <%- include('partials/app-notif-panel') %>

                        <main class="content-panel no-scrollbar flex items-center justify-center p-6">
                            <div class="max-w-xl w-full text-center py-12">
                                <!-- Animated checkmark / Status Icon -->
                                <div class="relative mx-auto mb-10 size-40 reveal-up">
                                    <div
                                        class="size-40 rounded-[3rem] bg-amber-500/10 flex items-center justify-center border-2 border-amber-500/5">
                                        <span
                                            class="material-symbols-rounded text-7xl text-amber-500 animate-pulse">hourglass_top</span>
                                    </div>
                                    <div
                                        class="absolute -top-3 -right-3 size-14 bg-emerald-500 rounded-[1.25rem] flex items-center justify-center shadow-xl shadow-emerald-500/30 border-4 border-white dark:border-slate-900">
                                        <span class="material-symbols-rounded text-white text-3xl">check_circle</span>
                                    </div>

                                    <!-- Floating particles/circles for flair -->
                                    <div
                                        class="absolute -bottom-2 -left-2 size-6 bg-primary/20 rounded-full animate-bounce">
                                    </div>
                                    <div
                                        class="absolute top-1/2 -right-6 size-4 bg-amber-500/20 rounded-full animate-ping">
                                    </div>
                                </div>

                                <% const isNoteItem = payment.itemType === 'note' || payment.note; %>
                                <% const isSuccess = payment.status === 'success' || payment.status === 'approved'; %>

                                <h1 class="text-4xl font-black text-slate-800 dark:text-white mb-4 reveal-up"
                                    style="animation-delay: 0.1s">পেমেন্ট জমা হয়েছে!</h1>
                                <p class="text-slate-500 font-bold mb-10 leading-relaxed reveal-up"
                                    style="animation-delay: 0.2s">
                                    <%= isNoteItem ? 'আপনার পেমেন্ট সফলভাবে জমা হয়েছে এবং নোটটি সাথে সাথেই আনলক হয়ে গেছে।' : 'আপনার পেমেন্ট রিকোয়েস্ট সফলভাবে জমা হয়েছে। অ্যাডমিন ভেরিফাই করার পর আপনার পছন্দের কোর্সটি আনলক হয়ে যাবে।' %>
                                </p>

                                <!-- Payment details card -->
                                <div class="glass-card p-8 mb-10 text-left reveal-up" style="animation-delay: 0.3s">
                                    <h3
                                        class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-6 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-lg">receipt_long</span> পেমেন্ট
                                        সামারি
                                    </h3>
                                    <div class="space-y-4">
                                        <div
                                            class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-800/50">
                                            <span
                                                class="text-xs font-bold text-slate-400 uppercase tracking-widest"><%= isNoteItem ? 'নোট' : 'কোর্স' %></span>
                                            <span class="text-sm font-black text-slate-800 dark:text-white">
                                                <%= isNoteItem ? (payment.note?.title || 'Note') : (payment.course?.title || 'N/A') %>
                                            </span>
                                        </div>
                                        <div
                                            class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-800/50">
                                            <span
                                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">পরিমাণ</span>
                                            <span class="text-lg font-black text-primary">৳<%= payment.amount %></span>
                                        </div>
                                        <div
                                            class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-800/50">
                                            <span
                                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">মেথড</span>
                                            <span
                                                class="text-sm font-black text-slate-800 dark:text-white capitalize badge bg-slate-100 dark:bg-slate-800 border-none">
                                                <%= payment.paymentMethod %>
                                            </span>
                                        </div>
                                        <div
                                            class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-800/50">
                                            <span
                                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">TrxID</span>
                                            <span class="text-sm font-black font-mono text-emerald-600">
                                                <%= payment.transactionId %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between items-center py-3">
                                            <span
                                                class="text-xs font-bold text-slate-400 uppercase tracking-widest">স্ট্যাটাস</span>
                                            <% if (isSuccess) { %>
                                                <span
                                                    class="px-4 py-1.5 bg-emerald-500/10 text-emerald-500 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-500/10 flex items-center gap-2">
                                                    <span class="size-2 rounded-full bg-emerald-500"></span>
                                                    সফল (Unlocked)
                                                </span>
                                            <% } else { %>
                                                <span
                                                    class="px-4 py-1.5 bg-amber-500/10 text-amber-500 rounded-full text-[10px] font-black uppercase tracking-widest border border-amber-500/10 flex items-center gap-2">
                                                    <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                                                    অপেক্ষমান
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Info box -->
                                <div class="p-6 bg-primary/5 rounded-[2rem] border border-primary/10 mb-12 text-left flex gap-5 reveal-up"
                                    style="animation-delay: 0.4s">
                                    <div
                                        class="size-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center shrink-0 shadow-sm border border-primary/10">
                                        <span class="material-symbols-rounded text-primary">info</span>
                                    </div>
                                    <div>
                                        <p class="text-[10px] font-black text-primary uppercase tracking-widest mb-1.5">
                                            পরবর্তী ধাপ</p>
                                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 leading-relaxed">
                                            <%= isNoteItem ? 'আপনার নোটটি এখনই খোলা সম্ভব। নোট পেজে গিয়ে "View" অথবা "Download" বাটন চেপে নোটটি পড়তে পারেন।' : 'সাধারণত ১-২৪ ঘণ্টার মধ্যে আপনার পেমেন্ট ভেরিফাই করা হয়। ভেরিফিকেশন সম্পন্ন হলে আপনার ড্যাশবোর্ডে কোর্সটি সয়ংক্রিয়ভাবে একটিভ হয়ে যাবে।' %>
                                        </p>
                                    </div>
                                </div>

                                <div class="flex flex-col sm:flex-row gap-4 justify-center reveal-up"
                                    style="animation-delay: 0.5s">
                                    <% if (isNoteItem) { %>
                                        <a href="/notes"
                                            class="px-10 py-5 bg-amber-500 hover:bg-amber-600 text-white rounded-[1.5rem] font-black text-xs uppercase tracking-widest shadow-xl shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-2">
                                            <span class="material-symbols-rounded text-base">description</span>
                                            নোট পেজে যান
                                        </a>
                                        <a href="/dashboard"
                                            class="px-10 py-5 bg-white dark:bg-slate-800 text-slate-700 dark:text-white border-2 border-slate-100 dark:border-slate-700 rounded-[1.5rem] font-black text-xs uppercase tracking-widest active:scale-95 transition-all">ড্যাশবোর্ডে
                                            যান</a>
                                    <% } else { %>
                                        <a href="/dashboard"
                                            class="px-10 py-5 bg-slate-900 dark:bg-slate-700 text-white rounded-[1.5rem] font-black text-xs uppercase tracking-widest shadow-xl shadow-slate-900/20 active:scale-95 transition-all">ড্যাশবোর্ডে
                                            যান</a>
                                        <a href="/courses"
                                            class="px-10 py-5 bg-white dark:bg-slate-800 text-slate-700 dark:text-white border-2 border-slate-100 dark:border-slate-700 rounded-[1.5rem] font-black text-xs uppercase tracking-widest active:scale-95 transition-all">আরো
                                            কোর্স দেখুন</a>
                                    <% } %>
                                </div>
                            </div>
                        </main>
            </div>
    </div>

    <%- include('partials/app-scripts') %>
</body>

</html>