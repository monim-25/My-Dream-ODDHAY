<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Leaderboard | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'dashboard' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120] relative">
            <div class="w-full m-0 p-0 space-y-0 flex flex-col">

                <!-- Page Header -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 rounded-none shadow-none px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 w-full">
                    <div class="flex items-start gap-2">
                        <span class="material-symbols-rounded text-[#F43F5E] text-xl">military_tech</span>
                        <div>
                            <h1 class="font-bold text-sm text-slate-800 dark:text-slate-200 leading-tight mb-0.5">Leaderboard</h1>
                            <p class="text-[11px] font-bold text-slate-400">
                                <%= totalStudents %> students &bull; Ranked by Total XP
                            </p>
                        </div>
                    </div>

                    <!-- My Position Button -->
                    <button onclick="findMyPosition()" id="findMyBtn"
                        class="flex items-center justify-center gap-2 px-3 py-1.5 bg-[#F43F5E] hover:bg-rose-600 text-white text-xs font-bold rounded-md transition-all active:scale-95 shrink-0">
                        <span class="material-symbols-rounded text-[14px]">my_location</span>
                        My Position
                    </button>
                </div>

                <!-- Student List -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 rounded-none shadow-none overflow-hidden w-full">
                    <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-1.5 text-slate-800 dark:text-slate-200">
                            <span class="material-symbols-rounded text-[16px] text-slate-400">format_list_numbered</span>
                            <span class="font-bold text-sm">Rank</span>
                        </div>
                        <span class="font-bold text-sm text-slate-800 dark:text-slate-200">XP</span>
                    </div>

                    <div id="studentList" class="divide-y divide-slate-100 dark:divide-slate-800/60">
                        <% students.forEach((student, index) => {
                            const rank = index + 1;
                            const isMe = myId && student._id && student._id.toString() === myId;
                        %>
                            <div id="student-<%= student._id %>"
                                class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors <%= isMe ? 'bg-rose-50 dark:bg-rose-900/10 border-l-2 border-[#F43F5E]' : '' %>">

                                <!-- Rank -->
                                <div class="w-8 text-center shrink-0">
                                    <% if (rank === 1) { %>
                                        <span class="text-xl">🥇</span>
                                    <% } else if (rank === 2) { %>
                                        <span class="text-xl">🥈</span>
                                    <% } else if (rank === 3) { %>
                                        <span class="text-xl">🥉</span>
                                    <% } else { %>
                                        <span class="text-xs font-black text-slate-400">#<%= rank %></span>
                                    <% } %>
                                </div>

                                <!-- Avatar -->
                                <div class="size-5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-[9px] text-slate-500 border border-slate-200/60 dark:border-slate-700/60 shrink-0">
                                    <% if (student.profileImage) { %>
                                        <img src="<%= student.profileImage %>" class="size-full object-cover">
                                    <% } else { %>
                                        <%= student.name ? student.name[0].toUpperCase() : 'S' %>
                                    <% } %>
                                </div>

                                <!-- Info -->
                                <div class="flex-1 min-w-0">
                                    <p class="font-bold text-sm text-slate-800 dark:text-slate-200 truncate <%= isMe ? 'text-[#F43F5E]' : '' %>">
                                        <%= student.name %>
                                        <% if (isMe) { %>
                                            <span class="text-[9px] font-black text-white bg-[#F43F5E] px-1.5 py-0.5 rounded-full ml-1 align-middle">You</span>
                                        <% } %>
                                    </p>
                                    <div class="flex items-center gap-2 mt-0.5">
                                        <% if (student.streak && student.streak > 0) { %>
                                            <span class="text-[10px] font-bold text-orange-500 flex items-center gap-0.5">
                                                <span class="material-symbols-rounded text-xs">local_fire_department</span><%= student.streak %>d
                                            </span>
                                        <% } %>
                                        <span class="text-[10px] text-slate-400 font-semibold"><%= student.classLevel || '' %></span>
                                    </div>
                                </div>

                                <!-- XP -->
                                <div class="text-right shrink-0">
                                    <p class="font-bold text-sm <%= isMe ? 'text-[#F43F5E]' : 'text-slate-700 dark:text-slate-300' %>"><%= (student.totalXP || 0).toLocaleString() %></p>
                                    <p class="text-[10px] text-slate-400 font-bold uppercase mt-0.5">XP</p>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Load More -->
                    <% if (hasMore) { %>
                        <div id="loadMoreContainer" class="p-4 border-t border-slate-100 dark:border-slate-800">
                            <button id="loadMoreBtn" onclick="loadMore()" class="w-full py-2.5 text-xs font-bold text-[#F43F5E] bg-rose-50 dark:bg-rose-900/10 hover:bg-rose-100 dark:hover:bg-rose-900/20 rounded-xl border border-rose-100 dark:border-rose-900/30 transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-rounded text-sm">expand_more</span>
                                Load More Students
                            </button>
                        </div>
                    <% } else { %>
                        <div class="p-4 text-center border-t border-slate-100 dark:border-slate-800">
                            <p class="text-xs text-slate-400 font-bold">All <%= totalStudents %> students shown</p>
                        </div>
                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'dashboard' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        let currentPage = <%= currentPage %>;
        let loading = false;
        const myId = '<%= myId %>';

        function findMyPosition() {
            const myEl = document.getElementById('student-' + myId);
            if (myEl) {
                myEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                myEl.classList.add('ring-2', 'ring-[#F43F5E]', 'ring-offset-1');
                setTimeout(() => myEl.classList.remove('ring-2', 'ring-[#F43F5E]', 'ring-offset-1'), 2000);
            } else {
                // Not loaded yet — fetch their page
                const btn = document.getElementById('findMyBtn');
                if (btn) {
                    btn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">refresh</span> Loading...';
                    btn.disabled = true;
                }
                fetchUntilFound();
            }
        }

        async function fetchUntilFound() {
            let page = currentPage + 1;
            while (true) {
                const res = await fetch('/api/leaderboard?page=' + page);
                const data = await res.json();
                if (!data.success || data.students.length === 0) break;
                appendStudents(data.students, (page - 1) * 50);
                currentPage = page;
                if (!data.hasMore) {
                    document.getElementById('loadMoreContainer')?.remove();
                    break;
                }
                const myEl = document.getElementById('student-' + myId);
                if (myEl) {
                    myEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    myEl.classList.add('ring-2', 'ring-[#F43F5E]', 'ring-offset-1');
                    setTimeout(() => myEl.classList.remove('ring-2', 'ring-[#F43F5E]', 'ring-offset-1'), 2000);
                    break;
                }
                page++;
            }
            const btn = document.getElementById('findMyBtn');
            if (btn) {
                btn.innerHTML = '<span class="material-symbols-rounded text-[14px]">my_location</span> My Position';
                btn.disabled = false;
            }
        }

        async function loadMore() {
            if (loading) return;
            loading = true;
            const btn = document.getElementById('loadMoreBtn');
            if (btn) { btn.innerHTML = '<span class="material-symbols-rounded animate-spin text-sm">refresh</span> Loading...'; btn.disabled = true; }

            try {
                const res = await fetch('/api/leaderboard?page=' + (currentPage + 1));
                const data = await res.json();
                if (data.success) {
                    appendStudents(data.students, currentPage * 50);
                    currentPage++;
                    if (!data.hasMore) {
                        document.getElementById('loadMoreContainer').innerHTML = '<p class="text-xs text-slate-400 font-bold text-center py-3">All students shown</p>';
                    } else {
                        if (btn) { btn.innerHTML = '<span class="material-symbols-rounded text-sm">expand_more</span> Load More Students'; btn.disabled = false; }
                    }
                }
            } catch(e) {
                if (btn) { btn.innerHTML = '<span class="material-symbols-rounded text-sm">expand_more</span> Load More Students'; btn.disabled = false; }
            }
            loading = false;
        }

        function appendStudents(students, startIndex) {
            const list = document.getElementById('studentList');
            students.forEach((s, i) => {
                const rank = startIndex + i + 1;
                const isMe = s._id === myId;
                const rankEmoji = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : `<span class="text-xs font-black text-slate-400">#${rank}</span>`;
                const avatar = s.profileImage
                    ? `<img src="${s.profileImage}" class="size-full object-cover">`
                    : `<span class="font-black text-sm text-slate-500">${s.name ? s.name[0].toUpperCase() : 'S'}</span>`;
                const streakBadge = s.streak > 0
                    ? `<span class="text-[10px] font-bold text-orange-500 flex items-center gap-0.5"><span class="material-symbols-rounded text-xs">local_fire_department</span>${s.streak}d</span>`
                    : '';
                const youBadge = isMe ? `<span class="text-[9px] font-black text-white bg-[#F43F5E] px-1.5 py-0.5 rounded-full ml-1 align-middle">You</span>` : '';
                const xp = (s.totalXP || 0).toLocaleString();

                const row = document.createElement('div');
                row.id = 'student-' + s._id;
                row.className = `flex items-center gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors divide-y-0 ${isMe ? 'bg-rose-50 dark:bg-rose-900/10 border-l-2 border-[#F43F5E]' : ''}`;
                row.innerHTML = `
                    <div class="w-8 text-center shrink-0">${rankEmoji}</div>
                    <div class="size-5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center border border-slate-200/60 dark:border-slate-700/60 shrink-0">${avatar}</div>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-sm truncate ${isMe ? 'text-[#F43F5E]' : 'text-slate-800 dark:text-slate-200'}">${s.name}${youBadge}</p>
                        <div class="flex items-center gap-2 mt-0.5">${streakBadge}<span class="text-[10px] text-slate-400 font-semibold">${s.classLevel || ''}</span></div>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="font-bold text-sm ${isMe ? 'text-[#F43F5E]' : 'text-slate-700 dark:text-slate-300'}">${xp}</p>
                        <p class="text-[10px] text-slate-400 font-bold uppercase mt-0.5">XP</p>
                    </div>`;
                list.appendChild(row);
            });
        }

        // Theme init
        if (localStorage.theme === 'dark') document.documentElement.classList.add('dark');
    </script>
</body>
</html>
