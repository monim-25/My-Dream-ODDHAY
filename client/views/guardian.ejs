<!DOCTYPE html>
<html lang="bn" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>গার্ডিয়ান প্রোফাইল | ODDHAY</title>
    <style>
        .guardian-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: white;
            border: 1px solid #f1f5f9;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .guardian-card:hover {
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
            border-color: #e2e8f0;
        }

        .dark .guardian-card {
            background: #1e293b;
            border-color: #334155;
            box-shadow: none;
        }

        .dark .guardian-card:hover {
            border-color: #475569;
        }

        .info-pill {
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            transition: all 0.2s ease;
        }

        .dark .info-pill {
            background: #0f172a;
            border-color: #1e293b;
        }

        .info-pill:hover {
            background: #f1f5f9;
            border-color: #e2e8f0;
        }

        .dark .info-pill:hover {
            background: #1e293b;
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'profile' }) %>

        <main class="flex-1 w-full overflow-y-auto p-4 sm:p-8 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            <!-- Page Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 reveal-up">
                <div class="flex items-center gap-4">
                    <a href="/profile"
                        class="size-11 rounded-xl bg-white dark:bg-slate-900 shadow-xs border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-all group">
                        <span
                            class="material-symbols-rounded text-slate-400 group-hover:text-primary transition-colors text-xl">arrow_back</span>
                    </a>
                    <div>
                        <h1
                            class="text-2xl lg:text-3xl font-black text-slate-800 dark:text-white mb-0.5 tracking-tight">
                            গার্ডিয়ান ড্রাইভ</h1>
                        <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">
                            ASSOCIATED FAMILY MEMBERS</p>
                    </div>
                </div>
            </div>

            <div class="max-w-4xl mx-auto px-2 md:px-0">
                <% if(guardians && guardians.length> 0) { %>
                    <div class="space-y-6">
                        <% guardians.forEach((guardian, index)=> { %>
                            <div class="guardian-card p-6 md:p-8 rounded-3xl flex flex-col md:flex-row gap-6 items-center reveal-up"
                                style="animation-delay: <%= index * 0.1 %>s">

                                <div
                                    class="size-20 md:size-24 rounded-2xl bg-slate-50 dark:bg-slate-800/50 flex items-center justify-center shrink-0 border border-slate-100 dark:border-slate-700 shadow-inner">
                                    <span
                                        class="material-symbols-rounded text-4xl md:text-5xl text-slate-300 dark:text-slate-600">supervisor_account</span>
                                </div>

                                <div class="flex-1 text-center md:text-left">
                                    <div class="mb-4">
                                        <h3
                                            class="text-xl md:text-2xl font-black text-slate-800 dark:text-white tracking-tight mb-1.5">
                                            <%= guardian.name %>
                                        </h3>
                                        <div
                                            class="inline-flex px-3 py-1 bg-primary/10 rounded-lg border border-primary/10">
                                            <p
                                                class="text-primary font-bold text-[10px] uppercase tracking-widest leading-none">
                                                <%= guardian.relationship || 'Guardian' %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap justify-center md:justify-start gap-2.5">
                                        <a href="tel:<%= guardian.phoneNumber %>"
                                            class="info-pill flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400">
                                            <span
                                                class="material-symbols-rounded text-base text-primary">call</span>
                                            <%= guardian.phoneNumber %>
                                        </a>
                                        <% if(guardian.email) { %>
                                            <div
                                                class="info-pill flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400">
                                                <span
                                                    class="material-symbols-rounded text-base text-primary">mail</span>
                                                <%= guardian.email %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <div
                                    class="flex flex-row md:flex-col gap-2.5 w-full md:w-auto mt-4 md:mt-0 pt-4 md:pt-0 border-t md:border-t-0 border-slate-50 dark:border-slate-800">
                                    <button
                                        class="flex-1 md:flex-none px-6 py-3 bg-slate-900 dark:bg-slate-700 text-white rounded-xl font-bold text-[11px] uppercase tracking-widest hover:bg-primary transition-all active:scale-95 shadow-md shadow-slate-900/10">বিস্তারিত</button>
                                    <button
                                        class="flex-1 md:flex-none px-6 py-3 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-xl font-bold text-[11px] uppercase tracking-widest border border-slate-200 dark:border-slate-700 hover:bg-slate-50 transition-all active:scale-95">ম্যাসেজ</button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div
                        class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-12 text-center rounded-3xl shadow-xs reveal-up">
                        <div
                            class="size-20 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-inner flex items-center justify-center mx-auto mb-6">
                            <span
                                class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600">family_restroom</span>
                        </div>
                        <h3
                            class="text-xl font-black text-slate-800 dark:text-white mb-2 tracking-tight">
                            কোনো অভিভাবক সংযুক্ত নেই</h3>
                        <p
                            class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed mb-8 max-w-sm mx-auto font-medium">
                            আপনার অভিভাবক আপনাকে অধ্যায় প্ল্যাটফর্মে মনিটর করতে পারবেন। তাদের বলুন
                            অভিভাবক হিসেবে রেজিস্ট্রেশন করতে।</p>

                        <div
                            class="inline-flex items-center gap-2.5 px-5 py-3 bg-primary/5 dark:bg-primary/10 rounded-xl border border-primary/10">
                            <span class="material-symbols-rounded text-primary text-lg">info</span>
                            <p class="text-[10px] font-bold text-primary uppercase tracking-widest">
                                রেজিস্ট্রেশনের সময় আপনার ইমেইল ব্যবহার করতে হবে</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'profile' }) %>
    <%- include('partials/app-scripts') %>
</body>

</html>