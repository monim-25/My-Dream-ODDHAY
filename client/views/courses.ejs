<!DOCTYPE html>
<html lang="bn" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <title>সকল কোর্স ও ব্যাচসমূহ | অধ্যায় - ODDHAY</title>
    <%- include('partials/head') %>
</head>
<body class="bg-[#F8FAFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans min-h-screen flex flex-col antialiased transition-colors duration-300">

    <!-- Unified Header Navigation -->
    <%- include('partials/nav') %>

    <!-- Main Content Area -->
    <main class="flex-1 pt-4 sm:pt-6 pb-12 sm:pb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-3.5 sm:space-y-6">

            <!-- Breadcrumbs & Header Section -->
            <div class="border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-5">
                <!-- Breadcrumbs & Count Row (Placed on the same line at the right side) -->
                <div class="flex items-center justify-between gap-2 mb-2 sm:mb-2.5">
                    <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 font-medium" aria-label="Breadcrumb">
                        <a href="/" class="hover:text-[#18a957] transition-colors flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm">home</span>
                            <span>হোম</span>
                        </a>
                        <span class="material-symbols-rounded text-xs text-slate-300 dark:text-slate-600">chevron_right</span>
                        <span class="text-slate-700 dark:text-slate-300 font-semibold">কোর্সসমূহ</span>
                    </nav>

                    <!-- Available Courses Count Pill (Placed on the same line) -->
                    <div class="shrink-0 flex items-center">
                        <span id="catalogCountBadge" class="inline-flex items-center px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-[#18a957]/10 text-[#18a957] border border-[#18a957]/20 shadow-2xs">
                            <span id="catalogCountText"><%= (courses && courses.length > 0) ? courses.length : 0 %>টি কোর্স উপলব্ধ</span>
                        </span>
                    </div>
                </div>

                <!-- Title & Description (Matching landing page typography) -->
                <div>
                    <h1 class="text-[22px] xs:text-[24px] sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-100">
                        কোর্স ও ব্যাচসমূহ
                    </h1>
                    <p class="text-[14.5px] xs:text-[15.5px] sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 font-normal leading-relaxed mt-1 max-w-2xl">
                        আপনার শ্রেণী ও পছন্দের বিষয় অনুযায়ী উপলব্ধ সকল একাডেমিক ও প্রস্তুতি কোর্স এক জায়গায়
                    </p>
                </div>
            </div>

            <!-- Filter Control Bar -->
            <div class="bg-transparent sm:bg-white/95 dark:sm:bg-slate-900/90 sm:backdrop-blur-md rounded-none sm:rounded-2xl border-0 sm:border border-slate-200/80 dark:border-slate-800 p-0 sm:p-5 shadow-none sm:shadow-xs space-y-2.5 sm:space-y-4">
                
                <!-- Top Row: Search Input & Sort Selector (Placed half/half on small screens, flex on larger screens) -->
                <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center sm:gap-3 w-full">
                    <!-- Search Input (50% on mobile, flex-1 on desktop) -->
                    <div class="relative w-full min-w-0 sm:flex-1">
                        <div class="absolute left-2.5 sm:left-3 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none text-slate-400 dark:text-slate-500 select-none">
                            <span class="material-symbols-rounded text-[17px] sm:text-lg">search</span>
                        </div>
                        <input type="text" id="coursesSearchInput"
                            value="<%= locals.search || '' %>"
                            placeholder="কোর্স খুঁজুন..."
                            class="w-full h-10.5 sm:h-11 pl-8 sm:pl-10 pr-7 sm:pr-9 bg-white sm:bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-xl text-[13.5px] xs:text-[14px] sm:text-sm font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 outline-none focus:border-[#18a957] focus:ring-2 focus:ring-[#18a957]/20 transition-all shadow-2xs sm:shadow-none">
                        <button type="button" id="coursesClearSearchBtn" onclick="clearCoursesSearch()"
                            class="hidden absolute right-2 sm:right-2.5 top-1/2 -translate-y-1/2 size-5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center transition-colors">
                            <span class="material-symbols-rounded text-sm">close</span>
                        </button>
                    </div>

                    <!-- Sort Selector (Custom Dropdown System, 50% on mobile, fixed width on desktop) -->
                    <div class="relative w-full min-w-0 sm:w-52 sm:shrink-0" id="coursesSortDropdownWrapper">
                        <input type="hidden" id="coursesSortSelect" value="<%= locals.sort || 'newest' %>">
                        <button type="button" id="coursesSortDropdownBtn" onclick="toggleCoursesDropdown('coursesSortDropdown')"
                            class="w-full h-10.5 sm:h-11 px-3 bg-white sm:bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-xl text-[13px] xs:text-[13.5px] sm:text-sm font-medium text-slate-700 dark:text-slate-200 outline-none flex items-center justify-between cursor-pointer shadow-2xs sm:shadow-none hover:border-[#18a957]/60 transition-all select-none">
                            <div class="flex items-center gap-1.5 min-w-0 truncate">
                                <span class="material-symbols-rounded text-[17px] sm:text-base text-slate-400 shrink-0">sort</span>
                                <span id="coursesSortDropdownLabel" class="truncate font-semibold">
                                    <% 
                                        const sortLabels = {
                                            'newest': 'নতুন (Newest)',
                                            'price_low': 'ফি: কম-বেশি',
                                            'price_high': 'ফি: বেশি-কম',
                                            'title_asc': 'নাম (A-Z)'
                                        };
                                    %>
                                    <%= sortLabels[locals.sort] || 'নতুন (Newest)' %>
                                </span>
                            </div>
                            <span id="coursesSortDropdownArrow" class="material-symbols-rounded text-sm sm:text-base text-slate-400 shrink-0 transition-transform duration-200">expand_more</span>
                        </button>
                        
                        <div id="coursesSortDropdownMenu" class="hidden absolute left-0 right-0 sm:right-auto sm:w-52 top-full mt-1.5 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 rounded-xl shadow-xl py-1 z-50 divide-y divide-slate-100 dark:divide-slate-800/60 no-scrollbar">
                            <div class="py-1">
                                <% const sortOpts = [
                                    { val: 'newest', label: 'নতুন (Newest)' },
                                    { val: 'price_low', label: 'ফি: কম-বেশি' },
                                    { val: 'price_high', label: 'ফি: বেশি-কম' },
                                    { val: 'title_asc', label: 'নাম (A-Z)' }
                                ]; %>
                                <% sortOpts.forEach(opt => { 
                                    const isSel = (locals.sort === opt.val || (!locals.sort && opt.val === 'newest'));
                                %>
                                    <button type="button" onclick="selectCoursesSortOption('<%= opt.val %>', '<%= opt.label %>')"
                                        class="courses-sort-opt w-full px-3.5 py-2 text-left text-xs sm:text-[13px] font-semibold transition-colors flex items-center justify-between gap-2 <%= isSel ? 'text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60' %>"
                                        data-value="<%= opt.val %>">
                                        <span><%= opt.label %></span>
                                        <span class="material-symbols-rounded text-sm text-[#18a957] check-icon <%= isSel ? '' : 'hidden' %>">check</span>
                                    </button>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Row: Class, Subject, Access Type & Reset Controls -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-slate-200/70 dark:border-slate-800/80 sm:border-slate-100 sm:dark:border-slate-800/70">
                    
                    <!-- Class Selector (Custom Dropdown System) -->
                    <div class="relative flex-1 min-w-[140px] sm:min-w-[180px]" id="coursesClassDropdownWrapper">
                        <input type="hidden" id="coursesClassFilter" value="<%= locals.activeClass || 'all' %>">
                        <button type="button" id="coursesClassDropdownBtn" onclick="toggleCoursesDropdown('coursesClassDropdown')"
                            class="w-full h-10 px-3 bg-white sm:bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-xl text-[13px] xs:text-[13.5px] sm:text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none flex items-center justify-between cursor-pointer shadow-2xs sm:shadow-none hover:border-[#18a957]/60 transition-all select-none">
                            <div class="flex items-center gap-1.5 min-w-0 truncate">
                                <span class="material-symbols-rounded text-base sm:text-lg text-[#18a957] shrink-0">school</span>
                                <span id="coursesClassDropdownLabel" class="truncate">
                                    <%= (locals.activeClass && locals.activeClass !== 'all') ? ('শ্রেণী: ' + locals.activeClass) : 'শ্রেণী: সকল শ্রেণী' %>
                                </span>
                            </div>
                            <span id="coursesClassDropdownArrow" class="material-symbols-rounded text-sm text-slate-400 shrink-0 transition-transform duration-200">expand_more</span>
                        </button>

                        <div id="coursesClassDropdownMenu" class="hidden absolute left-0 top-full mt-1.5 w-full min-w-[190px] max-h-60 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 rounded-xl shadow-xl py-1 z-50 no-scrollbar divide-y divide-slate-100 dark:divide-slate-800/60">
                            <div class="py-1">
                                <button type="button" onclick="selectCoursesClassOption('all', 'শ্রেণী: সকল শ্রেণী')"
                                    class="courses-class-opt w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors flex items-center justify-between gap-2 <%= (!locals.activeClass || locals.activeClass === 'all') ? 'text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60' %>"
                                    data-value="all">
                                    <span>শ্রেণী: সকল শ্রেণী</span>
                                    <span class="material-symbols-rounded text-sm text-[#18a957] check-icon <%= (!locals.activeClass || locals.activeClass === 'all') ? '' : 'hidden' %>">check</span>
                                </button>
                                <% 
                                    const classList = (locals.activeClasses && activeClasses.length > 0) ? activeClasses : [{ name: 'Class 9' }, { name: 'Class 10' }, { name: 'HSC 25' }, { name: 'HSC 26' }];
                                    classList.forEach(cls => {
                                        const isSel = (locals.activeClass && (locals.activeClass.toLowerCase() === cls.name.toLowerCase() || locals.activeClass.toLowerCase() === cls.name.toLowerCase().replace(/\s+/g, '')));
                                %>
                                    <button type="button" onclick="selectCoursesClassOption('<%= cls.name %>', 'শ্রেণী: <%= cls.name %>')"
                                        class="courses-class-opt w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors flex items-center justify-between gap-2 <%= isSel ? 'text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60' %>"
                                        data-value="<%= cls.name %>">
                                        <span>শ্রেণী: <%= cls.name %></span>
                                        <span class="material-symbols-rounded text-sm text-[#18a957] check-icon <%= isSel ? '' : 'hidden' %>">check</span>
                                    </button>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Subject Selector (Custom Dropdown System) -->
                    <div class="relative flex-1 min-w-[140px] sm:min-w-[180px]" id="coursesSubjectDropdownWrapper">
                        <input type="hidden" id="coursesSubjectFilter" value="<%= locals.activeSubject || 'all' %>">
                        <button type="button" id="coursesSubjectDropdownBtn" onclick="toggleCoursesDropdown('coursesSubjectDropdown')"
                            class="w-full h-10 px-3 bg-white sm:bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-xl text-[13px] xs:text-[13.5px] sm:text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none flex items-center justify-between cursor-pointer shadow-2xs sm:shadow-none hover:border-[#18a957]/60 transition-all select-none">
                            <div class="flex items-center gap-1.5 min-w-0 truncate">
                                <span class="material-symbols-rounded text-base sm:text-lg text-indigo-500 shrink-0">menu_book</span>
                                <span id="coursesSubjectDropdownLabel" class="truncate">
                                    <%= (locals.activeSubject && locals.activeSubject !== 'all') ? ('বিষয়: ' + locals.activeSubject) : 'বিষয়: সকল বিষয়' %>
                                </span>
                            </div>
                            <span id="coursesSubjectDropdownArrow" class="material-symbols-rounded text-sm text-slate-400 shrink-0 transition-transform duration-200">expand_more</span>
                        </button>

                        <div id="coursesSubjectDropdownMenu" class="hidden absolute left-0 top-full mt-1.5 w-full min-w-[190px] max-h-60 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 rounded-xl shadow-xl py-1 z-50 no-scrollbar divide-y divide-slate-100 dark:divide-slate-800/60">
                            <div class="py-1">
                                <button type="button" onclick="selectCoursesSubjectOption('all', 'বিষয়: সকল বিষয়')"
                                    class="courses-subject-opt w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors flex items-center justify-between gap-2 <%= (!locals.activeSubject || locals.activeSubject === 'all') ? 'text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60' %>"
                                    data-value="all">
                                    <span>বিষয়: সকল বিষয়</span>
                                    <span class="material-symbols-rounded text-sm text-[#18a957] check-icon <%= (!locals.activeSubject || locals.activeSubject === 'all') ? '' : 'hidden' %>">check</span>
                                </button>
                                <% 
                                    const subjectsList = (locals.allSubjects && allSubjects.length > 0) 
                                        ? allSubjects 
                                        : ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'Bangla', 'English'];
                                    subjectsList.forEach(sub => {
                                        const isSubSelected = (locals.activeSubject && activeSubject.toLowerCase() === sub.toLowerCase());
                                %>
                                    <button type="button" onclick="selectCoursesSubjectOption('<%= sub %>', 'বিষয়: <%= sub %>')"
                                        class="courses-subject-opt w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors flex items-center justify-between gap-2 <%= isSubSelected ? 'text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60' %>"
                                        data-value="<%= sub %>">
                                        <span>বিষয়: <%= sub %></span>
                                        <span class="material-symbols-rounded text-sm text-[#18a957] check-icon <%= isSubSelected ? '' : 'hidden' %>">check</span>
                                    </button>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Access Type Filter (Pills) -->
                    <div class="flex items-center gap-1 bg-slate-200/60 dark:bg-slate-800/90 sm:bg-slate-100/90 p-1 rounded-xl shrink-0">
                        <button type="button" onclick="handleTypeFilterChange('all')"
                            data-type-btn="all"
                            class="type-filter-btn px-3 py-1.5 rounded-lg text-[13px] sm:text-xs font-semibold transition-all shadow-2xs bg-white dark:bg-slate-700 text-[#18a957] font-bold">
                            সকল
                        </button>
                        <button type="button" onclick="handleTypeFilterChange('free')"
                            data-type-btn="free"
                            class="type-filter-btn px-3 py-1.5 rounded-lg text-[13px] sm:text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white">
                            ফ্রি কোর্স
                        </button>
                        <button type="button" onclick="handleTypeFilterChange('paid')"
                            data-type-btn="paid"
                            class="type-filter-btn px-3 py-1.5 rounded-lg text-[13px] sm:text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white">
                            পেইড কোর্স
                        </button>
                    </div>

                    <!-- Reset Filters Button -->
                    <button type="button" id="coursesResetBtn" onclick="resetAllCoursesFilters()"
                        class="hidden items-center gap-1 px-3 py-2 text-[13px] sm:text-xs font-semibold text-rose-500 hover:text-rose-600 hover:bg-rose-50/80 dark:hover:bg-rose-950/30 rounded-xl transition-colors ml-auto shrink-0 cursor-pointer">
                        <span class="material-symbols-rounded text-sm">restart_alt</span>
                        <span>রিসেট</span>
                    </button>
                </div>

                <!-- Active Filter Tags (Chips Strip) -->
                <div id="activeFilterChipsContainer" class="hidden flex-wrap items-center gap-2 pt-2 border-t border-slate-200/70 dark:border-slate-800/80 sm:border-slate-100 sm:dark:border-slate-800/50">
                    <span class="text-[12px] sm:text-[11px] text-slate-400 font-semibold select-none">ফিল্টারসমূহ:</span>
                    <div id="filterChipsList" class="flex flex-wrap items-center gap-1.5"></div>
                </div>

            </div>

            <!-- Courses Grid Section -->
            <div id="coursesCatalogGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <% 
                            let courseClassStr = Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '');
                            let courseSubjectStr = Array.isArray(course.subject) ? course.subject.join(' ') : (course.subject || '');
                            let primaryPrice = 0;
                            let originalPrice = 0;
                            if (course.plans && course.plans.length > 0) {
                                primaryPrice = course.plans[0].price || 0;
                            } else if (course.price) {
                                primaryPrice = course.discountPrice || course.price;
                                originalPrice = course.price;
                            }
                            let isFree = course.accessType === 'free' || primaryPrice === 0;
                            let subjectName = (course.subject && Array.isArray(course.subject) ? course.subject[0] : course.subject) || 'একাডেমিক';
                            let className = (course.classLevel && Array.isArray(course.classLevel) ? course.classLevel[0] : course.classLevel) || 'সকল শ্রেণী';
                            let instructorName = course.instructor ? (course.instructor.name || '') : '';
                        %>
                        <div class="course-card-item group rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900/90 hover:border-[#18a957]/50 dark:hover:border-[#18a957]/40 shadow-xs hover:shadow-md dark:shadow-none overflow-hidden flex flex-col justify-between transition-all duration-300"
                             data-id="<%= course._id %>"
                             data-title="<%= (course.title || '').toLowerCase() %>"
                             data-class="<%= courseClassStr.toLowerCase() %>"
                             data-subject="<%= courseSubjectStr.toLowerCase() %>"
                             data-type="<%= isFree ? 'free' : 'paid' %>"
                             data-instructor="<%= instructorName.toLowerCase() %>"
                             data-price="<%= primaryPrice %>"
                             data-date="<%= new Date(course.createdAt || 0).getTime() %>">
                            
                            <!-- Thumbnail Area -->
                            <div class="relative aspect-[16/9] w-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <% if (course.thumbnail) { %>
                                    <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-slate-400 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                                        <span class="material-symbols-rounded text-3xl text-slate-400">auto_stories</span>
                                    </div>
                                <% } %>
                                
                                <!-- Subtle Gradient Scrim at bottom of thumbnail -->
                                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

                                <!-- Floating Badges -->
                                <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between gap-1.5 pointer-events-none">
                                    <% if (isFree) { %>
                                        <span class="px-2.5 py-1 rounded-lg text-[11px] xs:text-[11.5px] font-bold bg-[#18a957] text-white shadow-sm flex items-center gap-1">
                                            <span class="size-1.5 rounded-full bg-white animate-pulse"></span>
                                            <span>ফ্রি কোর্স</span>
                                        </span>
                                    <% } else if (course.category && Array.isArray(course.category) && course.category.length > 0 && course.category[0] && course.category[0].toLowerCase() !== 'academic' && course.category[0].toLowerCase() !== 'সাধারণ') { %>
                                        <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-950/80 text-white backdrop-blur-md shadow-sm truncate max-w-[120px]">
                                            <%= course.category[0] %>
                                        </span>
                                    <% } else { %>
                                        <span></span>
                                    <% } %>
                                    <span class="px-2.5 py-1 rounded-lg text-[11px] xs:text-[11.5px] font-bold bg-white/95 dark:bg-slate-900/95 text-slate-800 dark:text-slate-100 backdrop-blur-md shadow-sm truncate max-w-[130px] border border-white/20">
                                        <%= className %>
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3.5 xs:p-4 sm:p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <!-- Subject Tag Pill -->
                                    <div class="flex items-center gap-1.5 mb-2">
                                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-[#18a957] dark:text-emerald-400 text-[12px] xs:text-[12.5px] font-bold border border-emerald-200/50 dark:border-emerald-800/40">
                                            <span class="size-1.5 rounded-full bg-[#18a957]"></span>
                                            <span><%= subjectName %></span>
                                        </span>
                                        <span class="text-slate-300 dark:text-slate-700 text-xs">•</span>
                                        <span class="text-slate-500 dark:text-slate-400 text-[12px] xs:text-[12.5px] font-medium truncate"><%= className %></span>
                                    </div>

                                    <!-- Course Title -->
                                    <h3 class="text-[15.5px] xs:text-[16.5px] sm:text-base font-bold text-slate-800 dark:text-slate-100 line-clamp-2 leading-snug group-hover:text-[#18a957] transition-colors">
                                        <%= course.title %>
                                    </h3>

                                    <!-- Instructor Row -->
                                    <% if (course.instructor && course.instructor.name) { %>
                                        <div class="flex items-center gap-2 mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                                            <div class="size-6 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0">
                                                <span class="material-symbols-rounded text-[15px]">person</span>
                                            </div>
                                            <p class="text-[13px] xs:text-[13.5px] sm:text-[13px] text-slate-600 dark:text-slate-300 font-medium truncate">
                                                <%= course.instructor.name %>
                                                <% if (course.instructor.designation) { %>
                                                    <span class="text-slate-400 font-normal text-xs xs:text-[12.5px]">• <%= course.instructor.designation %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Footer: Price, Details & Enroll Buttons -->
                                <div class="mt-3.5 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
                                    <div class="num-font shrink-0 min-w-0">
                                        <% if (isFree) { %>
                                            <span class="text-[16px] xs:text-[17px] sm:text-base font-bold text-[#18a957]">ফ্রি</span>
                                        <% } else { %>
                                            <div class="flex items-baseline gap-1.5 truncate">
                                                <span class="text-[16px] xs:text-[17.5px] sm:text-base font-bold text-slate-900 dark:text-white truncate">৳<%= Number(primaryPrice).toLocaleString() %></span>
                                                <% if (originalPrice > primaryPrice) { %>
                                                    <span class="text-xs text-slate-400 line-through hidden xs:inline">৳<%= Number(originalPrice).toLocaleString() %></span>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="flex items-center gap-1.5 xs:gap-2 shrink-0">
                                        <a href="/course-details/<%= course._id %>?tab=details" class="px-3 xs:px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/80 active:scale-[0.98] text-slate-700 dark:text-slate-200 text-[13px] xs:text-[13.5px] sm:text-xs font-semibold transition-all shadow-2xs">
                                            বিস্তারিত
                                        </a>
                                        <% 
                                            const enrollDest = isFree ? ('/course-details/' + course._id) : ('/checkout/' + course._id);
                                            const enrollHref = locals.user ? enrollDest : ('/login?redirect=' + encodeURIComponent(enrollDest));
                                        %>
                                        <a href="<%= enrollHref %>" class="px-3.5 xs:px-4 py-2 rounded-xl bg-[#18a957] hover:bg-[#158f4a] active:scale-[0.98] text-white text-[13px] xs:text-[13.5px] sm:text-xs font-bold transition-all shadow-xs inline-flex items-center gap-1">
                                            <span>এনরোল</span>
                                            <span class="material-symbols-rounded text-sm">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Empty State (When no course matches filters) -->
            <div id="coursesEmptyState" class="<%= (!courses || courses.length === 0) ? 'flex' : 'hidden' %> col-span-full py-16 px-4 flex-col items-center justify-center text-center space-y-3 bg-white/50 dark:bg-slate-900/30 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800">
                <div class="size-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-500 shadow-2xs">
                    <span class="material-symbols-rounded text-3xl">filter_alt_off</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-200">কোনো কোর্স পাওয়া যায়নি</h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md">
                    আপনার নির্বাচিত ফিল্টারের সাথে মিলে এমন কোনো কোর্স বর্তমানে নেই। অন্য শ্রেণী, বিষয় বা কীওয়ার্ড চেষ্টা করুন।
                </p>
                <button type="button" onclick="resetAllCoursesFilters()" class="mt-2 px-4 py-2 rounded-xl bg-[#18a957] hover:bg-[#158f4a] text-white text-xs sm:text-sm font-semibold shadow-xs transition-colors cursor-pointer inline-flex items-center gap-1.5">
                    <span class="material-symbols-rounded text-sm">restart_alt</span>
                    <span>সকল কোর্স দেখুন</span>
                </button>
            </div>

        </div>
    </main>

    <!-- Unified Footer -->
    <%- include('partials/footer') %>

    <!-- Client-Side Instant Filtering & Synchronization Script -->
    <script>
        // State variables
        let currentClass = '<%= (locals.activeClass || "all") %>';
        let currentSubject = '<%= (locals.activeSubject || "all") %>';
        let currentType = '<%= (locals.activeType || "all") %>';
        let currentSearch = '<%= (locals.search || "") %>';
        let currentSort = '<%= (locals.sort || "newest") %>';

        // Apply filters instantaneously across all course cards
        function applyCoursesFilters() {
            const cards = document.querySelectorAll('.course-card-item');
            const emptyState = document.getElementById('coursesEmptyState');
            const countDisplay = document.getElementById('catalogCountText');
            const resetBtn = document.getElementById('coursesResetBtn');
            const chipsContainer = document.getElementById('activeFilterChipsContainer');
            const chipsList = document.getElementById('filterChipsList');
            const searchClearBtn = document.getElementById('coursesClearSearchBtn');

            const sQuery = currentSearch.trim().toLowerCase();
            const clsQuery = currentClass.trim().toLowerCase();
            const subQuery = currentSubject.trim().toLowerCase();
            const typQuery = currentType.trim().toLowerCase();

            // Toggle clear search button
            if (searchClearBtn) {
                if (sQuery.length > 0) searchClearBtn.classList.remove('hidden');
                else searchClearBtn.classList.add('hidden');
            }

            // Sync with navbar class filter
            const navSelect = document.getElementById('navbarClassFilter');
            const mobSelect = document.getElementById('mobileClassFilter');
            if (navSelect && navSelect.value !== currentClass) navSelect.value = currentClass;
            if (mobSelect && mobSelect.value !== currentClass) mobSelect.value = currentClass;
            if (window.syncNavClassDropdown) window.syncNavClassDropdown(currentClass);

            // Sync on-page controls
            const pageClassSelect = document.getElementById('coursesClassFilter');
            if (pageClassSelect && pageClassSelect.value !== currentClass) pageClassSelect.value = currentClass;

            const pageSubSelect = document.getElementById('coursesSubjectFilter');
            if (pageSubSelect && pageSubSelect.value !== currentSubject) pageSubSelect.value = currentSubject;

            const pageSortSelect = document.getElementById('coursesSortSelect');
            if (pageSortSelect && pageSortSelect.value !== currentSort) pageSortSelect.value = currentSort;

            updateCoursesDropdownUI();

            // Sync type buttons
            document.querySelectorAll('.type-filter-btn').forEach(btn => {
                const bType = btn.getAttribute('data-type-btn');
                if (bType === currentType) {
                    btn.className = 'type-filter-btn px-3 py-1.5 rounded-lg text-[13px] sm:text-xs font-bold transition-all shadow-2xs bg-white dark:bg-slate-700 text-[#18a957]';
                } else {
                    btn.className = 'type-filter-btn px-3 py-1.5 rounded-lg text-[13px] sm:text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
                }
            });

            let visibleCount = 0;
            const visibleCards = [];

            cards.forEach(card => {
                const cTitle = card.getAttribute('data-title') || '';
                const cClass = card.getAttribute('data-class') || '';
                const cSub = card.getAttribute('data-subject') || '';
                const cType = card.getAttribute('data-type') || '';
                const cInst = card.getAttribute('data-instructor') || '';

                // Class Match
                let classMatch = (clsQuery === 'all');
                if (!classMatch) {
                    const cleanCls = clsQuery.replace(/\s+/g, '');
                    const cleanCardCls = cClass.replace(/\s+/g, '');
                    classMatch = cleanCardCls.includes(cleanCls) || cleanCls.includes(cleanCardCls);
                }

                // Subject Match
                let subjectMatch = (subQuery === 'all') || cSub.includes(subQuery);

                // Type Match
                let typeMatch = (typQuery === 'all') || (cType === typQuery);

                // Search Match
                let searchMatch = true;
                if (sQuery.length > 0) {
                    searchMatch = cTitle.includes(sQuery) || cSub.includes(sQuery) || cClass.includes(sQuery) || cInst.includes(sQuery);
                }

                if (classMatch && subjectMatch && typeMatch && searchMatch) {
                    card.style.display = 'flex';
                    visibleCount++;
                    visibleCards.push(card);
                } else {
                    card.style.display = 'none';
                }
            });

            // Sorting visible cards
            const grid = document.getElementById('coursesCatalogGrid');
            if (grid && visibleCards.length > 1) {
                visibleCards.sort((a, b) => {
                    if (currentSort === 'price_low') {
                        return parseFloat(a.getAttribute('data-price') || 0) - parseFloat(b.getAttribute('data-price') || 0);
                    } else if (currentSort === 'price_high') {
                        return parseFloat(b.getAttribute('data-price') || 0) - parseFloat(a.getAttribute('data-price') || 0);
                    } else if (currentSort === 'title_asc') {
                        return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
                    } else {
                        // Newest
                        return parseFloat(b.getAttribute('data-date') || 0) - parseFloat(a.getAttribute('data-date') || 0);
                    }
                });
                visibleCards.forEach(c => grid.appendChild(c));
            }

            // Update Count text
            if (countDisplay) {
                countDisplay.textContent = visibleCount + 'টি কোর্স উপলব্ধ';
            }

            // Show or hide empty state
            if (emptyState) {
                if (visibleCount === 0) {
                    emptyState.classList.remove('hidden');
                    emptyState.classList.add('flex');
                } else {
                    emptyState.classList.add('hidden');
                    emptyState.classList.remove('flex');
                }
            }

            // Manage active filter chips and reset button
            const isAnyFilterActive = (currentClass !== 'all' || currentSubject !== 'all' || currentType !== 'all' || currentSearch.trim().length > 0);
            if (resetBtn) {
                if (isAnyFilterActive) resetBtn.classList.remove('hidden'), resetBtn.classList.add('flex');
                else resetBtn.classList.add('hidden'), resetBtn.classList.remove('flex');
            }

            if (chipsContainer && chipsList) {
                if (isAnyFilterActive) {
                    chipsContainer.classList.remove('hidden');
                    chipsContainer.classList.add('flex');
                    chipsList.innerHTML = '';

                    if (currentClass !== 'all') {
                        chipsList.appendChild(createChip('শ্রেণী: ' + currentClass, () => {
                            handleClassFilterChange('all');
                        }));
                    }
                    if (currentSubject !== 'all') {
                        chipsList.appendChild(createChip('বিষয়: ' + currentSubject, () => {
                            handleSubjectFilterChange('all');
                        }));
                    }
                    if (currentType !== 'all') {
                        chipsList.appendChild(createChip(currentType === 'free' ? 'ফ্রি কোর্স' : 'পেইড কোর্স', () => {
                            handleTypeFilterChange('all');
                        }));
                    }
                    if (currentSearch.trim().length > 0) {
                        chipsList.appendChild(createChip('অনুসন্ধান: "' + currentSearch.trim() + '"', () => {
                            clearCoursesSearch();
                        }));
                    }
                } else {
                    chipsContainer.classList.add('hidden');
                    chipsContainer.classList.remove('flex');
                    chipsList.innerHTML = '';
                }
            }

            // Update browser URL query string without reloading
            updateUrlParams();
        }

        function createChip(text, onRemove) {
            const span = document.createElement('span');
            span.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[12.5px] sm:text-xs font-semibold bg-white sm:bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/90 dark:border-slate-700/80 select-none shadow-2xs sm:shadow-none';
            span.innerHTML = `<span>${text}</span><button type="button" class="text-slate-400 hover:text-rose-500 flex items-center justify-center size-3.5 rounded-full"><span class="material-symbols-rounded text-xs">close</span></button>`;
            span.querySelector('button').addEventListener('click', onRemove);
            return span;
        }

        function updateUrlParams() {
            try {
                const params = new URLSearchParams();
                if (currentClass && currentClass !== 'all') params.set('class', currentClass);
                if (currentSubject && currentSubject !== 'all') params.set('subject', currentSubject);
                if (currentType && currentType !== 'all') params.set('type', currentType);
                if (currentSearch && currentSearch.trim().length > 0) params.set('search', currentSearch.trim());
                if (currentSort && currentSort !== 'newest') params.set('sort', currentSort);

                const newUrl = window.location.pathname + (params.toString() ? ('?' + params.toString()) : '');
                window.history.replaceState({}, '', newUrl);
            } catch (e) {}
        }

        // Custom Dropdown System Handlers
        function toggleCoursesDropdown(id) {
            const menu = document.getElementById(id + 'Menu');
            const arrow = document.getElementById(id + 'Arrow');
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            closeAllCoursesDropdowns();
            if (isHidden) {
                menu.classList.remove('hidden');
                if (arrow) arrow.classList.add('rotate-180');
            }
        }

        function closeAllCoursesDropdowns() {
            ['coursesSortDropdown', 'coursesClassDropdown', 'coursesSubjectDropdown'].forEach(id => {
                const m = document.getElementById(id + 'Menu');
                const a = document.getElementById(id + 'Arrow');
                if (m) m.classList.add('hidden');
                if (a) a.classList.remove('rotate-180');
            });
        }

        function selectCoursesSortOption(val, label) {
            closeAllCoursesDropdowns();
            currentSort = val || 'newest';
            const inp = document.getElementById('coursesSortSelect');
            if (inp) inp.value = currentSort;
            handleSortChange(currentSort);
        }

        function selectCoursesClassOption(val, label) {
            closeAllCoursesDropdowns();
            currentClass = val || 'all';
            const inp = document.getElementById('coursesClassFilter');
            if (inp) inp.value = currentClass;
            handleClassFilterChange(currentClass);
        }

        function selectCoursesSubjectOption(val, label) {
            closeAllCoursesDropdowns();
            currentSubject = val || 'all';
            const inp = document.getElementById('coursesSubjectFilter');
            if (inp) inp.value = currentSubject;
            handleSubjectFilterChange(currentSubject);
        }

        function updateCoursesDropdownUI() {
            // Sort dropdown UI
            const sortLabels = {
                'newest': 'নতুন (Newest)',
                'price_low': 'ফি: কম-বেশি',
                'price_high': 'ফি: বেশি-কম',
                'title_asc': 'নাম (A-Z)'
            };
            const sortLbl = document.getElementById('coursesSortDropdownLabel');
            if (sortLbl && sortLabels[currentSort]) sortLbl.textContent = sortLabels[currentSort];
            updateOptionState('.courses-sort-opt', currentSort);

            // Class dropdown UI
            const classLbl = document.getElementById('coursesClassDropdownLabel');
            if (classLbl) {
                classLbl.textContent = (!currentClass || currentClass === 'all') ? 'শ্রেণী: সকল শ্রেণী' : ('শ্রেণী: ' + currentClass);
            }
            updateOptionState('.courses-class-opt', currentClass);

            // Subject dropdown UI
            const subLbl = document.getElementById('coursesSubjectDropdownLabel');
            if (subLbl) {
                subLbl.textContent = (!currentSubject || currentSubject === 'all') ? 'বিষয়: সকল বিষয়' : ('বিষয়: ' + currentSubject);
            }
            updateOptionState('.courses-subject-opt', currentSubject);
        }

        function updateOptionState(selector, activeVal) {
            document.querySelectorAll(selector).forEach(btn => {
                const val = btn.getAttribute('data-value');
                const check = btn.querySelector('.check-icon');
                const isMatch = (val === activeVal) || (!activeVal && val === 'all');
                if (isMatch) {
                    btn.classList.add('text-[#18a957]', 'font-bold', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
                    btn.classList.remove('text-slate-700', 'dark:text-slate-200');
                    if (check) check.classList.remove('hidden');
                } else {
                    btn.classList.remove('text-[#18a957]', 'font-bold', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
                    btn.classList.add('text-slate-700', 'dark:text-slate-200');
                    if (check) check.classList.add('hidden');
                }
            });
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#coursesSortDropdownWrapper') &&
                !e.target.closest('#coursesClassDropdownWrapper') &&
                !e.target.closest('#coursesSubjectDropdownWrapper')) {
                closeAllCoursesDropdowns();
            }
        });

        // Filter Handlers
        function handleClassFilterChange(val) {
            currentClass = val || 'all';
            applyCoursesFilters();
        }

        // Bridge function called by nav.ejs handleNavClassFilter
        function filterCoursesPageByClass(val) {
            handleClassFilterChange(val);
        }

        function handleSubjectFilterChange(val) {
            currentSubject = val || 'all';
            applyCoursesFilters();
        }

        function handleTypeFilterChange(val) {
            currentType = val || 'all';
            applyCoursesFilters();
        }

        function handleSortChange(val) {
            currentSort = val || 'newest';
            applyCoursesFilters();
        }

        function clearCoursesSearch() {
            const inp = document.getElementById('coursesSearchInput');
            if (inp) inp.value = '';
            currentSearch = '';
            applyCoursesFilters();
        }

        function resetAllCoursesFilters() {
            const inp = document.getElementById('coursesSearchInput');
            if (inp) inp.value = '';
            currentSearch = '';
            currentClass = 'all';
            currentSubject = 'all';
            currentType = 'all';
            currentSort = 'newest';

            const clsSel = document.getElementById('coursesClassFilter');
            if (clsSel) clsSel.value = 'all';
            const subSel = document.getElementById('coursesSubjectFilter');
            if (subSel) subSel.value = 'all';
            const sortSel = document.getElementById('coursesSortSelect');
            if (sortSel) sortSel.value = 'newest';

            applyCoursesFilters();
        }

        // Real-time search with debounce
        let searchDebounceTimer = null;
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('coursesSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(() => {
                        currentSearch = e.target.value;
                        applyCoursesFilters();
                    }, 200);
                });
            }

            // Read URL params on load if present
            try {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has('class')) currentClass = urlParams.get('class');
                if (urlParams.has('subject')) currentSubject = urlParams.get('subject');
                if (urlParams.has('type')) currentType = urlParams.get('type');
                if (urlParams.has('search')) currentSearch = urlParams.get('search');
                if (urlParams.has('sort')) currentSort = urlParams.get('sort');
            } catch (e) {}

            applyCoursesFilters();
        });
    </script>
</body>
</html>
