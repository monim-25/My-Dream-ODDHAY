<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <% 
    function getImg(path) {
        if(!path) return '';
        if(path.startsWith('http')) return path;
        let normalized = path.replace(/\\/g, '/');
        if (!normalized.startsWith('/')) normalized = '/' + normalized;
        return normalized;
    }

    function getPrice(c) {
        if (!c) return 'Free';
        if (c.accessType === 'paid' || c.accessType === 'Paid') {
            if (c.discountPrice > 0) return '৳' + c.discountPrice;
            if (c.price > 0) return '৳' + c.price;
            if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
            return '৳' + (c.price || 0);
        }
        if (c.accessType === 'free' || c.accessType === 'Free') return 'Free';
        if (c.accessType === 'trial' || c.accessType === 'Trial') return 'Free';
        
        // Fallback
        if (c.discountPrice > 0) return '৳' + c.discountPrice;
        if (c.price > 0) return '৳' + c.price;
        if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
        return 'Free';
    }

    function getPriceIcon(c) {
        const p = getPrice(c);
        if (p === 'Free') return 'auto_awesome';
        return 'payments';
    }
    %>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Courses | ODDHAY</title>
    <style>
        /* Teacher Panel Studio Theme Overrides */
        .course-card-studio {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        .course-card-studio:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
            border-color: #cbd5e1;
        }
        .dark .course-card-studio {
            background: #1e293b;
            border-color: #334155;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
        }
        .dark .course-card-studio:hover {
            border-color: #475569;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
        }
        .course-card-inner {
            background: transparent;
        }
        .meta-badge {
            background: #f1f5f9;
            color: #64748b;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 700;
            border-radius: 3px;
            border: 1px solid #e2e8f0;
        }
        .dark .meta-badge {
            background: #0f172a;
            color: #94a3b8;
            border-color: #334155;
        }
        .btn-studio {
            background: #0f172a;
            color: #fff;
            border-radius: 4px;
            font-weight: 700;
            letter-spacing: 0.02em;
            transition: all 0.3s ease;
        }
        .btn-studio:hover {
            background: #334155;
            transform: translateY(-1px);
        }
        .dark .btn-studio {
            background: #f8fafc;
            color: #0f172a;
        }
        .dark .btn-studio:hover {
            background: #e2e8f0;
        }
        .btn-continue {
            background: #10b981 !important;
            color: #fff !important;
        }
        .btn-continue:hover {
            background: #059669 !important;
        }
        .btn-view {
            background: #3b82f6 !important;
            color: #fff !important;
        }
        .btn-view:hover {
            background: #2563eb !important;
        }
        /* Stacked 3D Carousel Card Animation */
        #courseCarouselContainer {
            perspective: 1200px;
            perspective-origin: center center;
            transform-style: preserve-3d;
        }
        .carousel-card-item {
            transition: transform 0.65s cubic-bezier(0.25, 1, 0.35, 1),
                        opacity 0.65s cubic-bezier(0.25, 1, 0.35, 1),
                        filter 0.65s cubic-bezier(0.25, 1, 0.35, 1),
                        box-shadow 0.65s ease;
            will-change: transform, opacity, filter;
            transform-origin: center center;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }
        .carousel-card-item.carousel-active {
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.14), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
        }
        .carousel-card-item:not(.carousel-active):hover {
            opacity: 0.85 !important;
            filter: blur(0px) !important;
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'courses' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <!-- CONTENT AREA -->
            <div id="hub-content" class="w-full m-0 p-0 space-y-0 flex flex-col">

                    <!-- Mobile On-Screen Search & Filter Bar (< lg only, placed above the carousel) -->
                    <div class="lg:hidden w-full px-3.5 pt-3 pb-3 bg-white dark:bg-[#0b1120] border-b border-slate-200/80 dark:border-slate-800/80 space-y-2.5">
                        <!-- Search Input -->
                        <div class="relative flex items-center w-full">
                            <span class="material-symbols-rounded absolute left-3 text-slate-400 dark:text-slate-500 text-lg leading-none pointer-events-none select-none">search</span>
                            <input type="text" id="mobile-courses-search-input"
                                oninput="handleMobileCoursesSearch(this.value)"
                                onkeyup="handleMobileCoursesSearch(this.value)"
                                placeholder="Search courses, topics, teachers..."
                                value="<%= locals.search || '' %>"
                                class="w-full pl-9.5 pr-8 py-2 bg-slate-50 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 rounded-xl outline-none focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/10 shadow-2xs transition-all">
                            <button type="button" id="mobile-courses-clear-search-btn" onclick="clearMobileCoursesSearch()"
                                class="<%= (locals.search && locals.search.trim().length > 0) ? '' : 'hidden' %> absolute right-2.5 size-5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center transition-colors cursor-pointer select-none">
                                <span class="material-symbols-rounded text-sm">cancel</span>
                            </button>
                        </div>

                        <!-- Subject Filter Horizontal Pills Scroll -->
                        <div class="w-full flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 -mx-1 px-1">
                            <!-- All Subjects Chip -->
                            <button type="button" onclick="handleMobileCoursesSubject('all')"
                                data-subject-pill="all"
                                class="mobile-subject-pill shrink-0 px-3 py-1 rounded-full text-[11px] font-semibold transition-all active:scale-95 <%= (!locals.activeSubject || locals.activeSubject === 'all') ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-200 dark:hover:bg-slate-700/60' %>">
                                All Subjects
                            </button>
                            <% 
                                const allAvailableSubjects = (locals.subjects && locals.subjects.length > 0) 
                                    ? locals.subjects 
                                    : ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic'];
                            allAvailableSubjects.forEach(sub => { 
                                const isSelected = locals.activeSubject === sub;
                            %>
                            <button type="button" onclick="handleMobileCoursesSubject('<%= sub %>')"
                                data-subject-pill="<%= sub %>"
                                class="mobile-subject-pill shrink-0 px-3 py-1 rounded-full text-[11px] font-semibold transition-all active:scale-95 <%= isSelected ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-200 dark:hover:bg-slate-700/60' %>">
                                <%= sub %>
                            </button>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Featured Courses Carousel -->
                    <% if(locals.exploreCourses && exploreCourses.length > 0) { %>

                    <!-- Mobile Courses Carousel (< lg only, matching student-dashboard) -->
                    <div id="coursesMobileCarouselBox" class="w-full mt-1 mb-2 relative z-20 lg:hidden font-['Plus_Jakarta_Sans',sans-serif] select-none">
                        <!-- Header with title & My Courses button -->
                        <div class="flex items-center justify-between w-full mb-3 px-3.5 pt-2">
                            <div class="flex items-center gap-1.5">
                                <div class="size-6 rounded-lg bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-base leading-none">stars</span>
                                </div>
                                <span class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 tracking-tight">Featured Courses</span>
                            </div>
                            <a href="/my-courses" class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-rose-500 hover:bg-rose-600 text-white text-[11px] font-bold shadow-xs active:scale-95 transition-all">
                                <span class="material-symbols-rounded text-[14px] leading-none">school</span>
                                <span>My Courses</span>
                                <span class="px-1 py-0.2 rounded-full text-[9px] font-black bg-white/20 text-white leading-none"><%= (locals.enrolledCourses || []).filter(ec => ec && ec.course).length %></span>
                            </a>
                        </div>

                        <!-- Swipeable Cards Track Centered with snap-center -->
                        <div id="coursesMobileCarouselTrack" class="flex items-stretch gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar pb-1.5 w-full px-[6vw] sm:px-[calc((100%-295px)/2)]">
                            <% exploreCourses.forEach((c, cIdx) => { 
                                const cImg = getImg(c.thumbnail);
                                const isFree = c.accessType === 'free' || c.accessType === 'Free';
                                const subName = (Array.isArray(c.subject) && c.subject.length > 0) ? c.subject[0] : (c.subject || 'Academic');
                                const instructorName = c.instructor?.name || 'Oddhay Specialist';
                                const hasDiscount = !isFree && c.discountPrice && c.discountPrice > 0 && c.price && c.price > c.discountPrice;
                                const displayPrice = isFree ? 'Free' : (c.discountPrice > 0 ? '৳' + c.discountPrice : (c.price > 0 ? '৳' + c.price : 'Free'));

                                let itemType = 'Course';
                                const titleLower = (c.title || '').toLowerCase();
                                const catStr = Array.isArray(c.category) ? c.category.join(' ').toLowerCase() : (c.category || '').toLowerCase();
                                const tagStr = Array.isArray(c.tags) ? c.tags.join(' ').toLowerCase() : (c.tags || '').toLowerCase();
                                if (c.isPackage || /package|bundle|প্যাকেজ|বান্ডেল/.test(titleLower) || /package|bundle|প্যাকেজ|বান্ডেল/.test(catStr) || /package|bundle/.test(tagStr)) {
                                    itemType = 'Package';
                                }

                                let lessonCount = 0;
                                if (c.chapters && Array.isArray(c.chapters)) {
                                    c.chapters.forEach(ch => {
                                        if (ch.recordedClasses) lessonCount += ch.recordedClasses.length;
                                        if (ch.liveClasses) lessonCount += ch.liveClasses.length;
                                    });
                                }
                                if (c.curriculumNodes && Array.isArray(c.curriculumNodes)) {
                                    c.curriculumNodes.forEach(node => {
                                        if (node.type === 'video' || node.type === 'liveClass') lessonCount++;
                                    });
                                }

                                const isCardActive = cIdx === 0;
                            %>
                            <div class="mobile-carousel-course-card snap-center shrink-0 w-[84vw] max-w-[295px] min-w-[250px] rounded-2xl bg-white dark:bg-[#131d31] border border-slate-200/90 dark:border-slate-800/90 transition-all duration-500 ease-out flex flex-col overflow-hidden group cursor-pointer <%= isCardActive ? 'opacity-100 scale-100 shadow-md ring-1 ring-indigo-500/25 dark:ring-indigo-400/20' : 'opacity-40 dark:opacity-35 scale-[0.92] brightness-75 shadow-none' %>" data-card-idx="<%= cIdx %>">
                                <!-- Card Thumbnail Container -->
                                <div class="w-full h-28 sm:h-32 relative overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0">
                                    <% if (cImg) { %>
                                        <img src="<%= cImg %>" alt="<%= c.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <% } %>
                                    <div class="w-full h-full <%= cImg ? 'hidden' : 'flex' %> items-center justify-center bg-gradient-to-br from-indigo-500/20 via-sky-500/15 to-purple-500/20">
                                        <span class="material-symbols-rounded text-3xl text-indigo-500/60 dark:text-indigo-400/60">school</span>
                                    </div>
                                    
                                    <!-- Gradient Overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

                                    <!-- Top Badges -->
                                    <div class="absolute top-2 left-2 right-2 flex items-center justify-between z-10 pointer-events-none">
                                        <span class="px-2 py-0.5 rounded-lg text-xs font-medium bg-slate-900/70 text-white backdrop-blur-md border border-white/10 truncate max-w-[140px]">
                                            <%= subName %>
                                        </span>
                                        <% if (isFree) { %>
                                            <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-emerald-500 text-white shadow-xs">
                                                Free <%= itemType %>
                                            </span>
                                        <% } else if (hasDiscount) { %>
                                            <span class="px-1.5 py-0.5 rounded-lg text-[10px] font-bold bg-rose-500 text-white shadow-xs flex items-center gap-0.5">
                                                <span class="material-symbols-rounded text-xs leading-none">local_offer</span>
                                                <span>Save ৳<%= c.price - c.discountPrice %></span>
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-indigo-600 text-white shadow-xs">
                                                <%= itemType %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Card Content -->
                                <div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between gap-2">
                                    <div>
                                        <h4 class="text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-100 line-clamp-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                            <%= c.title %>
                                        </h4>
                                        <div class="flex items-center gap-1.5 mt-1 text-xs text-slate-500 dark:text-slate-400">
                                            <span class="material-symbols-rounded text-xs text-indigo-500 leading-none">person</span>
                                            <span class="truncate max-w-[110px]"><%= instructorName %></span>
                                            <span class="text-slate-300 dark:text-slate-600">•</span>
                                            <span class="px-1.5 py-0.2 rounded-md text-[9.5px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60"><%= Array.isArray(c.classLevel) ? (c.classLevel[0] || itemType) : (c.classLevel || itemType) %></span>
                                            <% if (lessonCount > 0) { %>
                                                <span class="text-slate-300 dark:text-slate-600">•</span>
                                                <span class="material-symbols-rounded text-xs text-sky-500 leading-none">play_circle</span>
                                                <span><%= lessonCount %> Lessons</span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Price & CTA Button Row -->
                                    <div class="flex items-center justify-between gap-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
                                        <div class="flex items-baseline gap-1">
                                            <span class="text-xs sm:text-sm font-black <%= isFree ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-900 dark:text-white' %>">
                                                <%= displayPrice %>
                                            </span>
                                            <% if (hasDiscount) { %>
                                                <span class="text-[10px] font-medium text-slate-400 line-through">
                                                    ৳<%= c.price %>
                                                </span>
                                            <% } %>
                                        </div>

                                        <a href="/course-details/<%= c._id %>" onclick="event.stopPropagation()" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 hover:from-indigo-700 hover:to-sky-700 text-white text-xs font-semibold flex items-center gap-1 shadow-xs active:scale-95 transition-all shrink-0">
                                            <span><%= isFree ? 'Enroll Free' : 'View Details' %></span>
                                            <span class="material-symbols-rounded text-xs leading-none">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>

                        <!-- Mini Dot Indicators for Mobile Carousel -->
                        <% if (exploreCourses.length > 1) { %>
                        <div class="flex items-center justify-center gap-1 mt-2.5" id="coursesMobileCarouselDots">
                            <% exploreCourses.forEach((_, dIdx) => { %>
                                <button type="button" class="courses-mobile-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer <%= dIdx === 0 ? 'bg-indigo-600 w-3.5' : 'bg-slate-300 dark:bg-slate-700 w-1.5' %>" data-dot-idx="<%= dIdx %>" title="Slide <%= dIdx + 1 %>"></button>
                            <% }) %>
                        </div>
                        <% } %>
                    </div>

                    <!-- Desktop Featured Courses Carousel (>= lg only) -->
                    <div id="featuredCarouselBox" class="hidden lg:block w-full relative text-white pt-4 sm:pt-5 pb-12 sm:pb-14 px-0 group/carousel select-none overflow-hidden bg-[#FFFFFF] dark:bg-[#0b1120] border-b border-slate-200/80 dark:border-slate-800/80">

                        <!-- Subtle diagonal shimmer stripe -->
                        <div class="absolute inset-0 pointer-events-none z-0 opacity-30" style="background: linear-gradient(120deg, transparent 30%, rgba(99,102,241,0.12) 50%, transparent 70%);"></div>

                        <!-- Top-Right Floating My Courses Button (Responsive on small screens) -->
                        <div class="w-full sm:w-auto flex justify-end px-3 sm:px-0 sm:absolute sm:top-3 sm:right-5 z-30 mb-2 sm:mb-0">
                            <a href="/my-courses" class="flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold transition-all active:scale-95 shadow-md">
                                <span class="material-symbols-rounded text-[15px] leading-none">school</span>
                                <span>My Courses</span>
                                <span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-white/20 text-white leading-none"><%= (locals.enrolledCourses || []).filter(ec => ec && ec.course).length %></span>
                            </a>
                        </div>

                        <!-- Left + Right edge fade masks (clips the ghost cards smoothly in light & dark mode) -->
                        <div class="absolute top-0 left-0 bottom-0 w-16 sm:w-28 pointer-events-none z-20 bg-gradient-to-r from-white dark:from-[#0b1120] to-transparent"></div>
                        <div class="absolute top-0 right-0 bottom-0 w-16 sm:w-28 pointer-events-none z-20 bg-gradient-to-l from-white dark:from-[#0b1120] to-transparent"></div>

                        <!-- Carousel Track (stacked 3D card layout) -->
                        <% const totalExplore = exploreCourses.length; %>
                        <div id="courseCarouselContainer" class="relative w-full z-10 overflow-visible flex items-center justify-center" style="min-height:220px">
                            <% exploreCourses.forEach((c, idx) => { 
                                let initDiff = idx;
                                if (totalExplore > 2) {
                                    if (initDiff > totalExplore / 2) initDiff -= totalExplore;
                                    if (initDiff < -totalExplore / 2) initDiff += totalExplore;
                                }
                                let initTransform = 'translateX(-50%) translateY(0px) translateZ(0px) scale(1)';
                                let initOpacity = '1';
                                let initFilter = 'blur(0px)';
                                let initZIndex = '30';
                                let initPointer = 'auto';
                                let initCursor = 'default';

                                if (initDiff === 1) {
                                    initTransform = 'translateX(calc(-50% + 50px)) translateY(5px) translateZ(-40px) scale(0.93)';
                                    initOpacity = '0.65';
                                    initFilter = 'blur(0.8px)';
                                    initZIndex = '25';
                                    initPointer = 'auto';
                                    initCursor = 'pointer';
                                } else if (initDiff === -1) {
                                    initTransform = 'translateX(calc(-50% - 50px)) translateY(5px) translateZ(-40px) scale(0.93)';
                                    initOpacity = '0.65';
                                    initFilter = 'blur(0.8px)';
                                    initZIndex = '25';
                                    initPointer = 'auto';
                                    initCursor = 'pointer';
                                } else if (initDiff === 2) {
                                    initTransform = 'translateX(calc(-50% + 95px)) translateY(10px) translateZ(-80px) scale(0.86)';
                                    initOpacity = '0.25';
                                    initFilter = 'blur(1.8px)';
                                    initZIndex = '20';
                                    initPointer = 'none';
                                } else if (initDiff === -2) {
                                    initTransform = 'translateX(calc(-50% - 95px)) translateY(10px) translateZ(-80px) scale(0.86)';
                                    initOpacity = '0.25';
                                    initFilter = 'blur(1.8px)';
                                    initZIndex = '20';
                                    initPointer = 'none';
                                } else if (initDiff !== 0) {
                                    const sign = initDiff > 0 ? 1 : -1;
                                    initTransform = `translateX(calc(-50% + ${sign * 140}px)) translateY(15px) translateZ(-120px) scale(0.80)`;
                                    initOpacity = '0';
                                    initFilter = 'blur(3px)';
                                    initZIndex = '10';
                                    initPointer = 'none';
                                }
                            %>
                                <div id="carousel-card-<%= idx %>" class="carousel-card-item absolute flex flex-col md:flex-row items-center gap-5 lg:gap-6 p-4 sm:p-5 pb-6 sm:pb-7 rounded-2xl bg-white dark:bg-[#1e293b] border border-rose-100/90 dark:border-slate-800 <%= idx === 0 ? 'carousel-active' : '' %>"
                                     onclick="onCarouselCardClick(<%= idx %>)"
                                     style="width:min(92%, 740px); left:50%; transform:<%= initTransform %>; opacity:<%= initOpacity %>; filter:<%= initFilter %>; pointer-events:<%= initPointer %>; cursor:<%= initCursor %>; z-index:<%= initZIndex %>;">

                                    <!-- Left: Course Thumbnail -->
                                    <div class="w-full md:w-[240px] lg:w-[260px] xl:w-[280px] h-40 sm:h-44 lg:h-48 rounded-xl overflow-hidden relative shadow-xl border border-slate-600/50 ring-1 ring-white/10 shrink-0 bg-[#1e293b]">
                                        <% if (c.thumbnail && c.thumbnail.trim() !== '') { %>
                                            <img src="<%= getImg(c.thumbnail) %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" alt="<%= c.title %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="hidden w-full h-full bg-[#1e293b] items-center justify-center">
                                                <span class="material-symbols-rounded text-4xl text-slate-500">school</span>
                                            </div>
                                        <% } else { %>
                                            <div class="w-full h-full bg-[#1e293b] flex items-center justify-center">
                                                <span class="material-symbols-rounded text-4xl text-slate-500">school</span>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Right: Course Info -->
                                    <div class="carousel-card-info w-full md:flex-1 flex flex-col justify-between gap-3 sm:gap-3.5">

                                        <!-- Title & Description -->
                                        <div class="space-y-2 sm:space-y-2.5">
                                            <h3 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-slate-100 leading-snug tracking-tight line-clamp-1" title="<%= c.title || 'Untitled Course' %>">
                                                <%= c.title || 'Untitled Course' %>
                                            </h3>
                                            <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed font-normal">
                                                <%= c.description ? c.description.replace(/(\<([^>]+)>)/gi, "") : 'Master your curriculum with comprehensive lessons, live support, and interactive quizzes.' %>
                                            </p>
                                        </div>

                                        <!-- Resource Badges (only shown if > 0) -->
                                        <% 
                                            let vCount = 0, lCount = 0, nCount = 0, qCount = 0;
                                            if (c.chapters && Array.isArray(c.chapters)) {
                                                c.chapters.forEach(ch => {
                                                    if (ch.recordedClasses) vCount += ch.recordedClasses.length;
                                                    if (ch.liveClasses) lCount += ch.liveClasses.length;
                                                    if (ch.notes) nCount += ch.notes.length;
                                                    if (ch.quizzes) qCount += ch.quizzes.length;
                                                });
                                            }
                                            if (c.curriculumNodes && Array.isArray(c.curriculumNodes)) {
                                                c.curriculumNodes.forEach(node => {
                                                    if (node.type === 'video') vCount++;
                                                    else if (node.type === 'liveClass') lCount++;
                                                    else if (node.type === 'note') nCount++;
                                                    else if (node.type === 'quiz') qCount++;
                                                });
                                            }
                                        %>
                                        <div class="flex flex-wrap items-center gap-1">
                                            <% if (vCount > 0) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/80 text-[10px] font-medium text-slate-300">
                                                <span class="material-symbols-rounded text-[13px] leading-none text-cyan-400">play_circle</span><span><%= vCount %> Video<%= vCount > 1 ? 's' : '' %></span>
                                            </span>
                                            <% } %>
                                            <% if (lCount > 0) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/80 text-[10px] font-medium text-slate-300">
                                                <span class="material-symbols-rounded text-[13px] leading-none text-rose-400">live_tv</span><span><%= lCount %> Live</span>
                                            </span>
                                            <% } %>
                                            <% if (nCount > 0) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/80 text-[10px] font-medium text-slate-300">
                                                <span class="material-symbols-rounded text-[13px] leading-none text-amber-400">description</span><span><%= nCount %> Note<%= nCount > 1 ? 's' : '' %></span>
                                            </span>
                                            <% } %>
                                            <% if (qCount > 0) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/80 text-[10px] font-medium text-slate-300">
                                                <span class="material-symbols-rounded text-[13px] leading-none text-violet-400">quiz</span><span><%= qCount %> Quiz<%= qCount > 1 ? 'zes' : '' %></span>
                                            </span>
                                            <% } %>
                                            <% if (vCount === 0 && lCount === 0 && nCount === 0 && qCount === 0) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/80 text-[10px] font-medium text-slate-500 italic">Content being added...</span>
                                            <% } %>
                                        </div>

                                        <!-- Footer: all in one continuous row with even gaps -->
                                        <div class="flex flex-wrap items-center gap-3 sm:gap-3.5 pt-3.5 mt-1 relative">
                                            <div class="absolute top-0 left-0 w-1/2 h-px bg-slate-200 dark:bg-slate-700/60"></div>

                                            <!-- Price -->
                                            <span class="text-sm font-bold text-emerald-600 flex items-center gap-1.5 leading-none">
                                                <span class="material-symbols-rounded text-[16px] leading-none select-none text-emerald-600"><%= getPriceIcon(c) %></span>
                                                <span class="leading-none"><%= getPrice(c) %></span>
                                            </span>

                                            <!-- Student count -->
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-[10px] font-semibold text-emerald-700 dark:text-emerald-300 leading-none">
                                                <span class="material-symbols-rounded text-[13px] leading-none select-none">group</span>
                                                <span class="leading-none"><%= c.studentCount || 0 %></span>
                                            </span>

                                            <!-- Details button -->
                                            <a href="/course-details/<%= c._id %>" onclick="event.stopPropagation()" class="px-3.5 py-1.5 text-[11px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition-all flex items-center gap-1 active:scale-95">
                                                <span class="material-symbols-rounded text-[14px] leading-none text-slate-500 dark:text-slate-400 pointer-events-none">visibility</span>
                                                <span>Details</span>
                                            </a>

                                            <!-- Enroll button -->
                                            <a href="<%= (c.accessType === 'free' || c.accessType === 'Free') ? '/course-details/' + c._id : '/checkout/course/' + c._id %>" onclick="event.stopPropagation()" class="px-5 py-1.5 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 active:scale-95 min-w-[92px]" style="background:#299A48; color:#fff; box-shadow:0 2px 10px rgba(41,154,72,0.25);" onmouseover="this.style.background='#227d3b'" onmouseout="this.style.background='#299A48'">
                                                <span class="material-symbols-rounded text-[14px] leading-none pointer-events-none">how_to_reg</span>
                                                <span>Enroll</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Left & Right Arrow Buttons -->
                        <button type="button" id="carouselPrevBtn" onclick="event.stopPropagation(); prevFeaturedSlide()" class="carousel-arrow absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 size-9 sm:size-10 rounded-full bg-white/90 dark:bg-slate-800/90 hover:bg-white dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 shadow-md backdrop-blur-xs flex items-center justify-center transition-all duration-300 active:scale-90 cursor-pointer z-40 opacity-0 pointer-events-none border border-slate-200/50 dark:border-slate-700" title="Previous Course">
                            <span class="material-symbols-rounded text-xl leading-none select-none">chevron_left</span>
                        </button>
                        <button type="button" id="carouselNextBtn" onclick="event.stopPropagation(); nextFeaturedSlide()" class="carousel-arrow absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 size-9 sm:size-10 rounded-full bg-white/90 dark:bg-slate-800/90 hover:bg-white dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 shadow-md backdrop-blur-xs flex items-center justify-center transition-all duration-300 active:scale-90 cursor-pointer z-40 opacity-0 pointer-events-none border border-slate-200/50 dark:border-slate-700" title="Next Course">
                            <span class="material-symbols-rounded text-xl leading-none select-none">chevron_right</span>
                        </button>

                        <!-- Circle Dot Indicators -->
                        <div class="absolute bottom-3.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-30 select-none">
                            <% exploreCourses.forEach((_, i) => { %>
                                <button id="dot-<%= i %>" onclick="goToFeaturedSlide(<%= i %>)"
                                    class="transition-all duration-300 cursor-pointer <%= i === 0 ? 'w-6 h-2 bg-slate-800 dark:bg-rose-500 rounded-full shadow-xs' : 'w-2 h-2 bg-slate-300 dark:bg-slate-700 hover:bg-slate-400 dark:hover:bg-slate-500 rounded-full' %>"
                                    title="Slide <%= i+1 %>"></button>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <!-- Explore Courses Section -->
                    <section id="section-explore" class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 rounded-none shadow-none p-3.5 lg:p-4 min-h-[400px]">
                        
                        <!-- Explore Courses Title Bar -->
                        <div class="flex items-center justify-between gap-2 pb-3 mb-3.5 border-b border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2">
                                <span class="size-8 rounded-md bg-[#F43F5E] hover:bg-rose-600 text-white flex items-center justify-center transition-all active:scale-95 shrink-0 shadow-sm" title="Explore Courses">
                                    <span class="material-symbols-rounded text-[18px]">explore</span>
                                </span>
                                <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100 tracking-tight">Explore Courses</h2>
                            </div>
                            <span id="explore-course-count-badge" class="text-xs font-bold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/40 px-2 py-1 rounded-md shrink-0">
                                <%= (locals.exploreCourses || []).length %> Course<%= (locals.exploreCourses || []).length !== 1 ? 's' : '' %>
                            </span>
                        </div>

                        <div class="bg-[#FFFFFF] dark:bg-[#0f172a] p-3 sm:p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-2xs">
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 lg:gap-4">
                                <% if(locals.exploreCourses && exploreCourses.length > 0) { %>
                                    <% exploreCourses.forEach(course => { %>
                                        <div class="p-1 course-card-studio course-item group cursor-pointer" 
                                            data-title="<%= course.title ? course.title.toLowerCase() : '' %>" 
                                            data-subject="<%= Array.isArray(course.subject) ? course.subject.join(' ') : (course.subject || '') %>" 
                                            data-instructor="<%= (course.instructor?.name || '').toLowerCase() %>"
                                            data-class="<%= (Array.isArray(course.classLevel) ? course.classLevel.join(' ') : (course.classLevel || '')).toLowerCase() %>"
                                            data-desc="<%= (course.description ? course.description.replace(/(\<([^>]+)>)/gi, '') : '').toLowerCase() %>"
                                            onclick="window.location.href='/course-details/<%= course._id %>'">
                                            <div class="course-card-inner h-full flex flex-col relative overflow-hidden">

                                                <!-- Thumbnail -->
                                                <div class="w-full h-28 bg-slate-50 dark:bg-slate-800/30 relative overflow-hidden border-b border-slate-100 dark:border-slate-800/50 shrink-0">
                                                    <% if (course.thumbnail) { %>
                                                        <img src="<%= getImg(course.thumbnail) %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                        <div class="hidden w-full h-full items-center justify-center text-slate-300 dark:text-slate-700">
                                                            <span class="material-symbols-rounded text-4xl">auto_stories</span>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-700">
                                                            <span class="material-symbols-rounded text-4xl opacity-50">auto_stories</span>
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <!-- Content Wrapper -->
                                                <div class="p-3 flex flex-col flex-1">

                                                    <!-- Core Info -->
                                                    <div class="flex-1">
                                                        <div class="flex items-start justify-between gap-2 mb-2">
                                                            <h4 class="text-[13px] font-semibold text-slate-800 dark:text-slate-200 line-clamp-2 leading-tight flex-1"><%= course.title || 'Untitled Course' %></h4>
                                                            
                                                            <!-- Enrolled Count -->
                                                            <div class="flex flex-col items-center shrink-0" title="Enrolled Students">
                                                                <span class="material-symbols-rounded text-[16px] text-slate-400 dark:text-slate-500 leading-none mb-0.5">group</span>
                                                                <span class="text-[10px] font-black text-slate-700 dark:text-slate-300 leading-none"><%= course.studentCount || 0 %></span>
                                                            </div>
                                                        </div>

                                                        <!-- Tags -->
                                                        <div class="flex flex-wrap gap-1 mb-2">
                                                            <span class="meta-badge text-[8px] px-1.5 py-0.5"><%= Array.isArray(course.classLevel) ? course.classLevel.join(', ') : (course.classLevel || 'N/A') %></span>
                                                            <span class="meta-badge text-[8px] px-1.5 py-0.5"><%= Array.isArray(course.subject) ? course.subject.join(', ') : (course.subject || 'General') %></span>
                                                        </div>

                                                        <!-- Description -->
                                                        <p class="text-[10px] font-medium text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                                            <%= course.description ? course.description.replace(/(\<([^>]+)>)/gi, "") : 'Explore this course to enhance your skills and knowledge.' %>
                                                        </p>
                                                    </div>

                                                    <!-- Action Footer -->
                                                    <div class="pt-2.5 mt-2.5 border-t border-slate-100 dark:border-slate-800/60 flex flex-col gap-2">
                                                        <div class="flex items-center justify-between">
                                                            <span class="text-[12px] font-black text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1">
                                                                <span class="material-symbols-rounded text-[14px] text-slate-400"><%= getPriceIcon(course) %></span>
                                                                <%= getPrice(course) %>
                                                            </span>
                                                            <% if (course.accessType === 'free' || course.accessType === 'Free') { %>
                                                                <span class="text-[8px] font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/50 px-1.5 py-0.5 rounded-sm">FREE</span>
                                                            <% } else { %>
                                                                <span class="text-[8px] font-extrabold text-rose-700 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/50 px-1.5 py-0.5 rounded-sm">PAID</span>
                                                            <% } %>
                                                        </div>

                                                        <% 
                                                            const isEnrolled = locals.enrolledCourses && enrolledCourses.some(ec => ec && (ec.course?._id?.toString() === course._id.toString() || ec.course?.toString() === course._id.toString()));
                                                        %>
                                                        
                                                        <div class="grid grid-cols-2 gap-1 sm:gap-1.5">
                                                            <a href="/course-details/<%= course._id %>" class="h-7 px-1.5 sm:px-2 btn-studio btn-view flex items-center justify-center gap-1 text-[10px] font-bold truncate" onclick="event.stopPropagation()">
                                                                <span class="material-symbols-rounded text-[13px] leading-none shrink-0">visibility</span>
                                                                <span class="truncate">View</span>
                                                            </a>
                                                            <% if (isEnrolled) { %>
                                                                <a href="/course-details/<%= course._id %>" class="h-7 px-1.5 sm:px-2 btn-studio btn-continue flex items-center justify-center gap-1 text-[10px] font-bold truncate" onclick="event.stopPropagation()">
                                                                    <span class="material-symbols-rounded text-[13px] leading-none shrink-0">check_circle</span>
                                                                    <span class="truncate">Enrolled</span>
                                                                </a>
                                                            <% } else { %>
                                                                <a href="<%= (course.accessType === 'free' || course.accessType === 'Free') ? '/course-details/' + course._id : '/checkout/course/' + course._id %>" class="h-7 px-1.5 sm:px-2 btn-studio btn-continue flex items-center justify-center gap-1 text-[10px] font-bold truncate" onclick="event.stopPropagation()">
                                                                    <span class="material-symbols-rounded text-[13px] leading-none shrink-0">how_to_reg</span>
                                                                    <span class="truncate">Enroll</span>
                                                                </a>
                                                            <% } %>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                    <div id="courses-grid-empty-state" class="hidden col-span-full py-12 px-4 text-center">
                                        <div class="size-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 mx-auto flex items-center justify-center mb-2.5">
                                            <span class="material-symbols-rounded text-2xl">search_off</span>
                                        </div>
                                        <h3 class="text-sm font-bold text-slate-700 dark:text-slate-200">No courses found</h3>
                                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 max-w-xs mx-auto">Try adjusting your search terms or selecting a different subject filter.</p>
                                        <button type="button" onclick="resetAllCoursesFilters()" class="mt-3 px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-900/50 text-xs font-semibold hover:bg-indigo-100 dark:hover:bg-indigo-900/40 active:scale-95 transition-all">
                                            Clear Filters
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="col-span-full py-16 text-center text-xs font-bold text-slate-400 italic">No courses found</div>
                                <% } %>
                            </div>
                        </div>
                    </section>
                
                    <!-- Safe clearance for mobile bottom navigation -->
                    <div class="h-20 sm:h-24 lg:h-4 w-full shrink-0"></div>
            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'courses' }) %>
    <%- include('partials/app-scripts') %>
    <script>
        let currentCoursesSearch = '<%= locals.search || "" %>';
        let currentCoursesSubject = '<%= locals.activeSubject || "all" %>';

        function updateMobileSubjectPillsUI(selectedSubject) {
            const pills = document.querySelectorAll('.mobile-subject-pill');
            const target = (selectedSubject || 'all').toLowerCase();
            pills.forEach(pill => {
                const sub = (pill.getAttribute('data-subject-pill') || '').toLowerCase();
                if (sub === target) {
                    pill.className = 'mobile-subject-pill shrink-0 px-3 py-1 rounded-full text-[11px] font-semibold transition-all active:scale-95 bg-indigo-600 text-white shadow-xs';
                } else {
                    pill.className = 'mobile-subject-pill shrink-0 px-3 py-1 rounded-full text-[11px] font-semibold transition-all active:scale-95 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-200 dark:hover:bg-slate-700/60';
                }
            });
        }

        window.handleMobileCoursesSearch = function(val) {
            currentCoursesSearch = (val || '').toLowerCase().trim();
            const clearBtn = document.getElementById('mobile-courses-clear-search-btn');
            if (clearBtn) {
                if (currentCoursesSearch.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }
            // Sync desktop header input if present
            const headerInput = document.getElementById('courses-search-input-header');
            if (headerInput && headerInput.value !== val) headerInput.value = val;
            const headerClearBtn = document.getElementById('courses-clear-search-btn');
            if (headerClearBtn) {
                if (currentCoursesSearch.length > 0) headerClearBtn.classList.remove('hidden');
                else headerClearBtn.classList.add('hidden');
            }
            filterCourses();
        };

        window.clearMobileCoursesSearch = function() {
            const mInput = document.getElementById('mobile-courses-search-input');
            if (mInput) mInput.value = '';
            handleMobileCoursesSearch('');
        };

        window.handleMobileCoursesSubject = function(sub) {
            currentCoursesSubject = sub || 'all';
            updateMobileSubjectPillsUI(currentCoursesSubject);
            // Sync desktop header select if present
            const headerSelect = document.getElementById('courses-header-subject');
            if (headerSelect && headerSelect.value !== sub) headerSelect.value = sub;
            filterCourses();
        };

        window.resetAllCoursesFilters = function() {
            clearMobileCoursesSearch();
            handleMobileCoursesSubject('all');
        };

        window.filterCoursesWithSearch = function(query) {
            currentCoursesSearch = (query || '').toLowerCase().trim();
            const mInput = document.getElementById('mobile-courses-search-input');
            if (mInput && mInput.value !== query) mInput.value = query || '';
            const clearBtn = document.getElementById('mobile-courses-clear-search-btn');
            if (clearBtn) {
                if (currentCoursesSearch.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }
            filterCourses();
        };

        window.filterCoursesWithSubject = function(subject) {
            currentCoursesSubject = subject || 'all';
            updateMobileSubjectPillsUI(currentCoursesSubject);
            filterCourses();
        };

        function filterCourses() {
            const searchVal = (currentCoursesSearch || '').toLowerCase().trim();
            const subjectVal = (currentCoursesSubject || 'all').toLowerCase().trim();
            
            const items = document.querySelectorAll('.course-item');
            let exploreVisible = 0;

            items.forEach(item => {
                const title = (item.getAttribute('data-title') || '').toLowerCase();
                const subject = (item.getAttribute('data-subject') || '').toLowerCase();
                const instructor = (item.getAttribute('data-instructor') || '').toLowerCase();
                const classLevel = (item.getAttribute('data-class') || '').toLowerCase();
                const desc = (item.getAttribute('data-desc') || '').toLowerCase();
                
                const matchSearch = !searchVal || 
                    title.includes(searchVal) || 
                    subject.includes(searchVal) || 
                    instructor.includes(searchVal) || 
                    classLevel.includes(searchVal) || 
                    desc.includes(searchVal);

                const matchSubject = subjectVal === 'all' || subject === subjectVal || subject.includes(subjectVal);
                
                if (matchSearch && matchSubject) {
                    item.style.display = '';
                    exploreVisible++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Dynamic count badge
            const badge = document.getElementById('explore-course-count-badge');
            if (badge) {
                badge.textContent = `${exploreVisible} Course${exploreVisible !== 1 ? 's' : ''}`;
            }

            // Empty state container
            const emptyState = document.getElementById('courses-grid-empty-state');
            if (emptyState) {
                if (exploreVisible === 0) {
                    emptyState.classList.remove('hidden');
                } else {
                    emptyState.classList.add('hidden');
                }
            }
        }

        function isDesktopView() {
            return window.innerWidth >= 1024;
        }

        // ── Mobile Courses Carousel Controller (< lg only, matching student-dashboard) ──
        function initCoursesMobileCarousel() {
            const mTrack = document.getElementById('coursesMobileCarouselTrack');
            if (!mTrack) return;
            const mCards = mTrack.querySelectorAll('.mobile-carousel-course-card');
            const mDots = document.querySelectorAll('.courses-mobile-dot');
            if (!mCards || mCards.length === 0) return;

            let mCurrentIndex = 0;
            let mAutoTimer = null;
            let mIsInteracting = false;

            function getClosestMobileIndex() {
                const trackCenter = mTrack.scrollLeft + mTrack.offsetWidth / 2;
                let closest = 0;
                let minDiff = Infinity;
                mCards.forEach((card, idx) => {
                    const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                    const diff = Math.abs(trackCenter - cardCenter);
                    if (diff < minDiff) {
                        minDiff = diff;
                        closest = idx;
                    }
                });
                return closest;
            }

            function updateMobileCardStates(activeIdx) {
                mCards.forEach((card, idx) => {
                    if (idx === activeIdx) {
                        card.classList.remove('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                        card.classList.add('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                    } else {
                        card.classList.remove('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                        card.classList.add('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                    }
                });
            }

            function updateMobileDots(activeIdx) {
                mDots.forEach((dot, idx) => {
                    if (idx === activeIdx) {
                        dot.classList.add('bg-indigo-600', 'w-3.5');
                        dot.classList.remove('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                    } else {
                        dot.classList.remove('bg-indigo-600', 'w-3.5');
                        dot.classList.add('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                    }
                });
            }

            function scrollMobileToCard(index) {
                if (!mCards[index]) return;
                const card = mCards[index];
                const targetScroll = card.offsetLeft - (mTrack.offsetWidth - card.offsetWidth) / 2;
                mTrack.scrollTo({ left: Math.max(0, targetScroll), behavior: 'smooth' });
                mCurrentIndex = index;
                updateMobileDots(index);
                updateMobileCardStates(index);
            }

            function startMobileAutoPlay() {
                stopMobileAutoPlay();
                if (mCards.length <= 1 || isDesktopView()) return;
                mAutoTimer = setInterval(() => {
                    if (mIsInteracting) return;
                    mCurrentIndex = (getClosestMobileIndex() + 1) % mCards.length;
                    scrollMobileToCard(mCurrentIndex);
                }, 4500);
            }

            function stopMobileAutoPlay() {
                if (mAutoTimer) {
                    clearInterval(mAutoTimer);
                    mAutoTimer = null;
                }
            }

            // Scroll detection to sync dots & active states
            mTrack.addEventListener('scroll', () => {
                const closest = getClosestMobileIndex();
                mCurrentIndex = closest;
                updateMobileDots(closest);
                updateMobileCardStates(closest);
            }, { passive: true });

            // Touch interaction handling
            mTrack.addEventListener('touchstart', () => {
                mIsInteracting = true;
                stopMobileAutoPlay();
            }, { passive: true });

            mTrack.addEventListener('touchend', () => {
                mIsInteracting = false;
                startMobileAutoPlay();
            }, { passive: true });

            // Dot navigation
            mDots.forEach((dot, idx) => {
                dot.addEventListener('click', (e) => {
                    e.stopPropagation();
                    scrollMobileToCard(idx);
                    startMobileAutoPlay();
                });
            });

            // Card click behavior: if inactive, snap center first
            mCards.forEach((card, idx) => {
                card.addEventListener('click', (e) => {
                    if (getClosestMobileIndex() !== idx) {
                        e.preventDefault();
                        scrollMobileToCard(idx);
                    }
                });
            });

            startMobileAutoPlay();

            window.addEventListener('resize', () => {
                if (isDesktopView()) {
                    stopMobileAutoPlay();
                } else if (!mAutoTimer) {
                    startMobileAutoPlay();
                }
            });
        }

        // ── Desktop Stacked Carousel State (>= lg only) ──────────────────────
        let currentSlide = 0;
        const totalSlides = <%= (locals.exploreCourses || []).length %>;
        let slideTimer = null;

        // ── Carousel arrow auto-hide logic ──────────────────────────────────
        const carouselBox = document.getElementById('featuredCarouselBox');
        const prevBtn = document.getElementById('carouselPrevBtn');
        const nextBtn = document.getElementById('carouselNextBtn');
        let arrowHideTimer = null;

        function showArrows() {
            if (totalSlides <= 1) return;
            [prevBtn, nextBtn].forEach(b => {
                if (!b) return;
                b.classList.remove('opacity-0', 'pointer-events-none');
                b.classList.add('opacity-100');
            });
            clearTimeout(arrowHideTimer);
            arrowHideTimer = setTimeout(hideArrows, 2500);
        }

        function hideArrows() {
            [prevBtn, nextBtn].forEach(b => {
                if (!b) return;
                b.classList.add('opacity-0', 'pointer-events-none');
                b.classList.remove('opacity-100');
            });
        }

        if (carouselBox) {
            carouselBox.addEventListener('mouseenter', () => {
                showArrows();
                if (slideTimer) clearInterval(slideTimer);
            });
            carouselBox.addEventListener('mousemove', showArrows);
            carouselBox.addEventListener('mouseleave', () => {
                hideArrows();
                resetTimer();
            });
        }

        // ── Dot indicators ───────────────────────────────────────────────────
        function updateDots() {
            for (let i = 0; i < totalSlides; i++) {
                const dot = document.getElementById('dot-' + i);
                if (!dot) continue;
                if (i === currentSlide) {
                    dot.className = 'w-6 h-2 bg-slate-800 dark:bg-rose-500 rounded-full shadow-xs transition-all duration-300 cursor-pointer';
                } else {
                    dot.className = 'w-2 h-2 bg-slate-300 dark:bg-slate-700 hover:bg-slate-400 dark:hover:bg-slate-500 rounded-full transition-all duration-300 cursor-pointer';
                }
            }
        }

        function getCardLayout(diff) {
            const isMobile = window.innerWidth < 640;
            const step1 = isMobile ? 26 : 50;
            const step2 = isMobile ? 50 : 95;
            const far = isMobile ? 75 : 140;

            if (diff === 0) {
                return {
                    transform: 'translateX(-50%) translateY(0px) translateZ(0px) scale(1)',
                    opacity: '1',
                    filter: 'blur(0px)',
                    pointerEvents: 'auto',
                    cursor: 'default',
                    zIndex: '30',
                    isActive: true
                };
            } else if (diff === 1) {
                return {
                    transform: `translateX(calc(-50% + ${step1}px)) translateY(5px) translateZ(-40px) scale(0.93)`,
                    opacity: '0.65',
                    filter: 'blur(0.8px)',
                    pointerEvents: 'auto',
                    cursor: 'pointer',
                    zIndex: '25',
                    isActive: false
                };
            } else if (diff === -1) {
                return {
                    transform: `translateX(calc(-50% - ${step1}px)) translateY(5px) translateZ(-40px) scale(0.93)`,
                    opacity: '0.65',
                    filter: 'blur(0.8px)',
                    pointerEvents: 'auto',
                    cursor: 'pointer',
                    zIndex: '25',
                    isActive: false
                };
            } else if (diff === 2) {
                return {
                    transform: `translateX(calc(-50% + ${step2}px)) translateY(10px) translateZ(-80px) scale(0.86)`,
                    opacity: '0.25',
                    filter: 'blur(1.8px)',
                    pointerEvents: 'none',
                    cursor: 'default',
                    zIndex: '20',
                    isActive: false
                };
            } else if (diff === -2) {
                return {
                    transform: `translateX(calc(-50% - ${step2}px)) translateY(10px) translateZ(-80px) scale(0.86)`,
                    opacity: '0.25',
                    filter: 'blur(1.8px)',
                    pointerEvents: 'none',
                    cursor: 'default',
                    zIndex: '20',
                    isActive: false
                };
            } else {
                const sign = diff > 0 ? 1 : -1;
                return {
                    transform: `translateX(calc(-50% + ${sign * far}px)) translateY(15px) translateZ(-120px) scale(0.80)`,
                    opacity: '0',
                    filter: 'blur(3px)',
                    pointerEvents: 'none',
                    cursor: 'default',
                    zIndex: '10',
                    isActive: false
                };
            }
        }

        function updateSlide() {
            if (totalSlides === 0) return;
            for (let i = 0; i < totalSlides; i++) {
                const card = document.getElementById('carousel-card-' + i);
                if (!card) continue;
                
                let diff = (i - currentSlide) % totalSlides;
                if (totalSlides > 2) {
                    if (diff > totalSlides / 2) diff -= totalSlides;
                    if (diff < -totalSlides / 2) diff += totalSlides;
                }

                const layout = getCardLayout(diff);
                if (layout.isActive) {
                    card.classList.add('carousel-active');
                } else {
                    card.classList.remove('carousel-active');
                }
                card.style.transform = layout.transform;
                card.style.opacity = layout.opacity;
                card.style.filter = layout.filter;
                card.style.pointerEvents = layout.pointerEvents;
                card.style.cursor = layout.cursor;
                card.style.zIndex = layout.zIndex;
            }
            updateDots();
        }

        function onCarouselCardClick(idx) {
            if (idx === currentSlide) return;
            goToFeaturedSlide(idx);
        }

        function nextFeaturedSlide() {
            if (totalSlides <= 1) return;
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlide();
            resetTimer();
        }

        function prevFeaturedSlide() {
            if (totalSlides <= 1) return;
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlide();
            resetTimer();
        }

        function goToFeaturedSlide(idx) {
            if (idx === currentSlide || idx < 0 || idx >= totalSlides) return;
            currentSlide = idx;
            updateSlide();
            resetTimer();
        }

        function resetTimer() {
            if (slideTimer) clearInterval(slideTimer);
            if (totalSlides > 1 && isDesktopView()) slideTimer = setInterval(nextFeaturedSlide, 5000);
        }

        document.addEventListener('DOMContentLoaded', () => {
            initCoursesMobileCarousel();

            const firstCard = document.getElementById('carousel-card-0');
            const container = document.getElementById('courseCarouselContainer');
            if (firstCard && container) {
                setTimeout(() => {
                    container.style.minHeight = (firstCard.offsetHeight + 16) + 'px';
                }, 60);
            }
            if (totalSlides > 1 && isDesktopView()) slideTimer = setInterval(nextFeaturedSlide, 5000);
            updateSlide();

            // Touch Swipe Support for Desktop 3D Stacked Carousel
            if (container) {
                let touchStartX = 0;
                let touchStartY = 0;
                container.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 1) {
                        touchStartX = e.touches[0].clientX;
                        touchStartY = e.touches[0].clientY;
                        if (slideTimer) clearInterval(slideTimer);
                    }
                }, { passive: true });

                container.addEventListener('touchend', (e) => {
                    if (e.changedTouches.length === 1) {
                        const touchEndX = e.changedTouches[0].clientX;
                        const touchEndY = e.changedTouches[0].clientY;
                        const dx = touchEndX - touchStartX;
                        const dy = touchEndY - touchStartY;
                        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                            if (dx < 0) nextFeaturedSlide();
                            else prevFeaturedSlide();
                        }
                        resetTimer();
                    }
                }, { passive: true });
            }

            // Window resize adjustment for desktop carousel
            window.addEventListener('resize', () => {
                updateSlide();
                if (firstCard && container) {
                    container.style.minHeight = (firstCard.offsetHeight + 16) + 'px';
                }
            });

            // Initial filter run if query params exist
            if (currentCoursesSearch || (currentCoursesSubject && currentCoursesSubject !== 'all')) {
                filterCourses();
            }
        });
    </script>
</body>
</html>