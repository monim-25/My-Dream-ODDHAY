<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Student ID Card | ODDHAY</title>
    <style>
        .id-card-wrapper {
            perspective: 1000px;
        }

        .id-card {
            width: 100%;
            max-width: 520px;
            aspect-ratio: 1.586;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
            margin: 0 auto;
        }

        .dark .id-card {
            background: #0f172a;
            border-color: #1e293b;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .card-accent {
            position: absolute;
            top: 0;
            left: 0;
            width: 10px;
            height: 100%;
            background: linear-gradient(to bottom, #137fec, #6366f1);
        }

        .card-content {
            height: 100%;
            padding: 24px 24px 24px 34px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .identity-label {
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: #94a3b8;
        }

        .institution-name {
            font-size: 16px;
            font-weight: 900;
            color: #137fec;
            letter-spacing: -0.02em;
        }

        .student-main {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .photo-box {
            width: 84px;
            height: 84px;
            border-radius: 14px;
            overflow: hidden;
            border: 2px solid #e2e8f0;
            flex-shrink: 0;
        }

        .dark .photo-box {
            border-color: #334155;
        }

        .student-name {
            font-size: 18px;
            font-weight: 900;
            color: #1e293b;
            margin-bottom: 6px;
            line-height: 1.1;
        }

        .dark .student-name {
            color: white;
        }

        .info-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 16px;
        }

        .info-field label {
            display: block;
            font-size: 8px;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 1px;
        }

        .info-field p {
            font-size: 11px;
            font-weight: 800;
            color: #334155;
        }

        .dark .info-field p {
            color: #cbd5e1;
        }

        .card-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-t: 1px solid #f1f5f9;
            padding-top: 10px;
        }

        .dark .card-bottom {
            border-color: #1e293b;
        }

        .validity-tag {
            font-size: 9px;
            font-weight: 800;
            color: #137fec;
            text-transform: uppercase;
        }

        .qr-wrapper {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            padding: 2px;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
        }

        .dark .qr-wrapper {
            background: #0f172a;
            border-color: #334155;
        }

        @media print {
            header, aside, nav, .print-btn-container, .page-header-nav {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .id-card {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }
        }
    </style>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'id-card' }) %>

        <main class="flex-1 overflow-y-auto p-2 lg:p-3 space-y-2.5 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120]">
            
            <!-- Page Header Nav -->
            <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 page-header-nav bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 shadow-sm">
                <div class="flex items-center gap-3">
                    <a href="/profile" class="size-9 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <span class="material-symbols-rounded text-lg">arrow_back</span>
                    </a>
                    <div>
                        <h1 class="text-base font-black text-slate-800 dark:text-white leading-tight">Digital Student ID Card</h1>
                        <p class="text-[10px] font-semibold text-slate-400">Verified Identity Card</p>
                    </div>
                </div>
                <button onclick="window.print()" class="px-4 py-1.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-sm transition-colors">
                    <span class="material-symbols-rounded text-base">print</span> Print Card
                </button>
            </div>

            <!-- Card View Area -->
            <div class="max-w-4xl mx-auto id-card-wrapper py-2 space-y-3">
                <div class="id-card">
                    <div class="card-accent"></div>
                    <div class="card-content">
                        <div class="card-top">
                            <div>
                                <p class="identity-label">Student Identity</p>
                                <h2 class="institution-name">ODDHAY</h2>
                            </div>
                            <div class="text-right">
                                <p class="identity-label">Status</p>
                                <p class="text-xs font-bold text-emerald-500 flex items-center gap-1 justify-end">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span> Verified User
                                </p>
                            </div>
                        </div>

                        <div class="student-main">
                            <div class="photo-box">
                                <img src="<%= locals.user.profileImage || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=random` %>" class="w-full h-full object-cover">
                            </div>
                            <div class="student-details min-w-0">
                                <h3 class="student-name truncate"><%= user.name %></h3>
                                <div class="info-row">
                                    <div class="info-field">
                                        <label>Class Level</label>
                                        <p><%= user.classLevel || 'Student' %></p>
                                    </div>
                                    <div class="info-field">
                                        <label>Student ID</label>
                                        <p>#<%= user._id.toString().slice(-6).toUpperCase() %></p>
                                    </div>
                                    <div class="info-field">
                                        <label>Roll Number</label>
                                        <p><%= user.rollNumber || 'N/A' %></p>
                                    </div>
                                    <div class="info-field">
                                        <label>Blood Group</label>
                                        <p><%= user.bloodGroup || 'O+' %></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-bottom">
                            <p class="validity-tag">Academic Session 2025-26</p>
                            <div class="qr-wrapper">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= user._id %>" class="w-full h-full object-contain dark:invert dark:opacity-80">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Controls & Info -->
                <div class="text-center print-btn-container mx-auto max-w-[520px] space-y-2">
                    <div class="flex items-center gap-3 p-3 bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl shadow-sm">
                        <div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
                            <span class="material-symbols-rounded text-base">info</span>
                        </div>
                        <p class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 text-left leading-tight">
                            This digital student identity card is an official credential generated by ODDHAY.
                        </p>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'id-card' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>