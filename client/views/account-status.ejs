<!DOCTYPE html>
<html lang="bn" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <title><%= (locals.type === 'suspended') ? 'অ্যাকাউন্ট স্থগিত | ODDHAY' : 'অ্যাকাউন্ট মুছে ফেলা হয়েছে | ODDHAY' %></title>
    <style>
        html, body {
            overflow-x: hidden;
            width: 100%;
            min-height: 100dvh;
        }
    </style>
</head>

<body class="min-h-dvh sm:min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-3 sm:p-5 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow Accents -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <% if (locals.type === 'suspended') { %>
            <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-amber-500/10 dark:bg-amber-500/5 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-rose-500/10 dark:bg-rose-500/5 rounded-full blur-3xl"></div>
        <% } else { %>
            <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-rose-500/10 dark:bg-rose-500/5 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-red-600/10 dark:bg-red-600/5 rounded-full blur-3xl"></div>
        <% } %>
    </div>

    <!-- Top Simple Nav Logo -->
    <header class="w-full max-w-5xl mx-auto flex items-center justify-between py-2 sm:py-3 relative z-10">
        <a href="/" class="flex items-center gap-2.5 select-none group">
            <div class="size-9 sm:size-10 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                <span class="material-symbols-rounded text-xl sm:text-2xl pointer-events-none">menu_book</span>
            </div>
            <div class="flex flex-col">
                <span class="font-semibold text-lg sm:text-xl tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                <span class="text-[10px] sm:text-[10.5px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
            </div>
        </a>

        <!-- Dark/Light Mode Toggle -->
        <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')" class="size-9 rounded-xl hover:bg-slate-200/60 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer" title="Theme Toggle">
            <span class="material-symbols-rounded text-xl dark:hidden">dark_mode</span>
            <span class="material-symbols-rounded text-xl hidden dark:block text-amber-400">light_mode</span>
        </button>
    </header>

    <!-- Main Alert Card Container -->
    <main class="w-full flex-1 flex items-center justify-center py-6 sm:py-10 relative z-10">
        <div class="w-full max-w-[480px] mx-auto">
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-slate-200/50 dark:shadow-black/40 text-center relative overflow-hidden">
                
                <!-- Ambient Card Corner Lighting -->
                <% if (locals.type === 'suspended') { %>
                    <div class="absolute -top-12 -right-12 size-36 bg-amber-500/15 dark:bg-amber-500/20 rounded-full blur-2xl pointer-events-none"></div>
                <% } else { %>
                    <div class="absolute -top-12 -right-12 size-36 bg-rose-500/15 dark:bg-rose-500/20 rounded-full blur-2xl pointer-events-none"></div>
                <% } %>

                <!-- Status Visual Icon -->
                <div class="relative mb-5 inline-block">
                    <% if (locals.type === 'suspended') { %>
                        <div class="size-18 sm:size-20 rounded-2xl bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/30 dark:border-amber-400/30 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto shadow-inner">
                            <span class="material-symbols-rounded text-4xl sm:text-5xl leading-none">block</span>
                        </div>
                    <% } else { %>
                        <div class="size-18 sm:size-20 rounded-2xl bg-rose-500/10 dark:bg-rose-400/10 border border-rose-500/30 dark:border-rose-400/30 text-rose-600 dark:text-rose-400 flex items-center justify-center mx-auto shadow-inner">
                            <span class="material-symbols-rounded text-4xl sm:text-5xl leading-none">person_off</span>
                        </div>
                    <% } %>
                </div>

                <!-- Status Badge -->
                <div class="mb-3">
                    <% if (locals.type === 'suspended') { %>
                        <span class="px-3 py-1 rounded-full bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/20 dark:border-amber-400/20 text-amber-700 dark:text-amber-400 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            Account Suspended
                        </span>
                    <% } else { %>
                        <span class="px-3 py-1 rounded-full bg-rose-500/10 dark:bg-rose-400/10 border border-rose-500/20 dark:border-rose-400/20 text-rose-700 dark:text-rose-400 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-rose-500"></span>
                            Account Deleted
                        </span>
                    <% } %>
                </div>

                <!-- Header Title -->
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white leading-tight mb-2">
                    <%= (locals.type === 'suspended') ? 'অ্যাকাউন্ট স্থগিত করা হয়েছে' : 'অ্যাকাউন্ট মুছে ফেলা হয়েছে' %>
                </h1>

                <!-- Body Message -->
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-5">
                    <% if (locals.type === 'suspended') { %>
                        প্ল্যাটফর্মের নীতিমালা পর্যালোচনা বা এডমিন প্যানেল থেকে আপনার অ্যাকাউন্টটির অ্যাক্সেস সাময়িকভাবে স্থগিত (Suspended) করা হয়েছে।
                    <% } else { %>
                        আপনার অ্যাকাউন্টটি এডমিন প্যানেল থেকে মুছে ফেলা হয়েছে। আপনি চাইলে যেকোনো সময় নতুন অ্যাকাউন্ট তৈরি করতে পারেন অথবা হোমপেজে ফিরে যেতে পারেন।
                    <% } %>
                </p>

                <!-- Detailed Suspension Box (if suspended) -->
                <% if (locals.type === 'suspended') { %>
                    <div class="p-3.5 mb-5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-800/40 text-left text-xs space-y-1.5">
                        <div class="flex items-start gap-2">
                            <span class="font-bold text-amber-900 dark:text-amber-300 shrink-0">কারণ (Reason):</span>
                            <span class="text-amber-800 dark:text-amber-400 font-medium"><%= (locals.reason && String(reason).trim()) ? reason : 'Administrative review / Policy violation' %></span>
                        </div>
                        <% if (locals.expires) { %>
                            <div class="flex items-start gap-2 pt-1 border-t border-amber-200/50 dark:border-amber-800/30">
                                <span class="font-bold text-amber-900 dark:text-amber-300 shrink-0">মেয়াদ:</span>
                                <span class="text-amber-800 dark:text-amber-400 font-medium"><%= new Date(expires).toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' }) %> পর্যন্ত</span>
                            </div>
                        <% } %>
                    </div>
                <% } %>

                <!-- Action Buttons Grid -->
                <div class="flex flex-col gap-2.5 w-full">
                    <!-- Primary Button: Landing Page -->
                    <a href="/" class="w-full py-3 px-4 rounded-xl bg-[#18a957] hover:bg-[#138745] active:scale-[0.99] text-white font-bold text-xs sm:text-sm shadow-md shadow-[#18a957]/20 flex items-center justify-center gap-2 transition-all">
                        <span class="material-symbols-rounded text-lg leading-none">home</span>
                        <span>হোমপেজে যান (Go to Landing Page)</span>
                    </a>

                    <!-- Secondary Button: Login / Register -->
                    <a href="/login" class="w-full py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700/80 active:scale-[0.99] text-slate-800 dark:text-slate-100 font-bold text-xs sm:text-sm border border-slate-200 dark:border-slate-700/80 flex items-center justify-center gap-2 transition-all">
                        <span class="material-symbols-rounded text-lg leading-none">login</span>
                        <span><%= (locals.type === 'suspended') ? 'অন্য অ্যাকাউন্টে লগইন করুন' : 'লগইন বা নতুন অ্যাকাউন্ট (Login / Register)' %></span>
                    </a>
                </div>

                <!-- Footer Support Link -->
                <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-[11px] sm:text-xs text-slate-500 dark:text-slate-400">
                    কোনো ভুল মনে হলে বা সাহায্যের প্রয়োজনে?
                    <a href="mailto:support@oddhay.com" class="text-[#18a957] hover:underline font-bold inline-flex items-center gap-1 ml-1">
                        সাপোর্টে যোগাযোগ করুন
                        <span class="material-symbols-rounded text-xs">arrow_forward</span>
                    </a>
                </div>

            </div>
        </div>
    </main>

    <!-- Bottom Simple Footer -->
    <footer class="w-full max-w-5xl mx-auto py-2 text-center text-xs text-slate-400 dark:text-slate-500 relative z-10">
        &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
    </footer>

</body>
</html>

