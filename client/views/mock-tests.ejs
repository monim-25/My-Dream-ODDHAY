<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Mock Test | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header', { pageTitle: 'Mock Test', activePage: 'exams', backUrl: '/exams' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <main class="flex-1 w-full overflow-y-auto px-3 sm:px-5 py-3 sm:py-5 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-3.5 pb-24 sm:pb-28 lg:pb-8">
            
            <% 
               const testSubjects = Array.from(new Set(mockTests.map(t => (t.subject || '').trim()).filter(Boolean)));
               const allFilterSubjects = Array.from(new Set([...(assignedSubjects || []), ...testSubjects])).filter(Boolean);
            %>

            <!-- TOP CONTROLS & SEARCH BAR (MOBILE FIRST) -->
            <div class="max-w-6xl w-full mx-auto space-y-2.5">
                
                <!-- TOP HEADER ROW -->
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="size-7 sm:size-8 rounded-xl bg-sky-500/10 dark:bg-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none">assignment</span>
                        </span>
                        <div>
                            <h1 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight flex items-center gap-1.5">
                                <span>Mock Tests</span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200/80 dark:border-sky-500/20">
                                    <%= userClassLevel %>
                                </span>
                            </h1>
                        </div>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0 ml-auto">
                        <a href="/exams" class="h-7.5 px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-[11px] sm:text-xs font-medium flex items-center gap-1 transition-all border border-slate-200/60 dark:border-slate-700/60" title="Back to Exams">
                            <span class="material-symbols-rounded text-xs leading-none">arrow_back</span>
                            <span>All Exams</span>
                        </a>

                        <span id="mockTestCountBadge" class="h-7.5 px-2.5 rounded-lg bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-500/20 text-[11px] sm:text-xs font-semibold flex items-center gap-1">
                            <span class="material-symbols-rounded text-xs leading-none">verified</span>
                            <span id="mockCountText"><%= mockTests.length %> Available</span>
                        </span>
                    </div>
                </div>

                <!-- LIVE SEARCH INPUT & RESET BAR -->
                <div class="flex items-center gap-2">
                    <div class="relative flex-1">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base leading-none pointer-events-none select-none">search</span>
                        <input type="text" id="mockSearchInput" oninput="handleMockSearch(this.value)" placeholder="Search mock tests, subjects, courses..."
                            class="w-full pl-9 pr-8 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-medium text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-sky-500 dark:focus:border-sky-500 transition-all shadow-2xs">
                        <button type="button" id="clearMockSearchBtn" onclick="clearMockSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 size-4.5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center transition-colors">
                            <span class="material-symbols-rounded text-sm">cancel</span>
                        </button>
                    </div>
                </div>

                <!-- HORIZONTALLY SCROLLABLE SUBJECT FILTER PILLS -->
                <% if (allFilterSubjects.length > 0) { %>
                    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 select-none -mx-1 px-1">
                        <button type="button" onclick="selectMockSubject('all')" data-subject-pill="all"
                            class="mock-subject-pill px-3 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition-all shadow-2xs shrink-0 bg-sky-600 text-white">
                            All
                        </button>
                        <% allFilterSubjects.forEach(function(sub) { %>
                            <button type="button" onclick="selectMockSubject('<%= sub.replace(/'/g, "\\'") %>')" data-subject-pill="<%= sub %>"
                                class="mock-subject-pill px-3 py-1 rounded-lg text-[11px] font-medium whitespace-nowrap transition-all shadow-2xs shrink-0 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60">
                                <%= sub %>
                            </button>
                        <% }); %>
                    </div>
                <% } %>

            </div>

            <!-- MOCK TESTS GRID -->
            <div class="max-w-6xl w-full mx-auto">
                <div id="mockTestsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
                    <% if (mockTests.length === 0) { %>
                        <div class="col-span-full py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                            <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">event_busy</span>
                            <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Mock Tests Available</h3>
                            <p class="text-[11px] text-slate-400">There are no mock tests uploaded for your class level yet.</p>
                        </div>
                    <% } else { %>
                        <% mockTests.forEach(function(mk) { %>
                            <% 
                               const mkSubject = (mk.subject || 'General').trim();
                               const mkTitle = mk.title ? mk.title.trim() : `${mkSubject} Mock Test`;
                               const mkCourseTitle = (mk.course && mk.course.title) ? mk.course.title.trim() : '';
                            %>
                            <div class="mock-card bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/70 rounded-xl sm:rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-2.5 shadow-2xs" 
                                 data-subject="<%= mkSubject %>" 
                                 data-title="<%= mkTitle.toLowerCase() %>"
                                 data-course="<%= mkCourseTitle.toLowerCase() %>">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-1.5">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-500/20">
                                                <%= mkSubject %>
                                            </span>
                                            <% if (mk.duration && mk.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                                    <%= mk.duration %> Mins
                                                </span>
                                            <% } %>
                                            <% if (mkCourseTitle) { %>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60 truncate max-w-[120px]">
                                                    <%= mkCourseTitle %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                                        <%= mkTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/50">
                                    <div class="flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400 font-medium truncate">
                                        <span class="material-symbols-rounded text-sm text-sky-500 leading-none select-none">quiz</span>
                                        <span><%= (mk.questions && mk.questions.length) ? mk.questions.length : (mk.totalQuestions || 0) %> Qs</span>
                                    </div>

                                    <a href="/quiz/<%= mk._id %>?from=exams" class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-[11px] sm:text-xs font-semibold transition-all shadow-2xs active:scale-95 flex items-center gap-1 shrink-0">
                                        <span class="material-symbols-rounded text-xs sm:text-sm leading-none">play_arrow</span>
                                        <span>Start Exam</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- EMPTY SEARCH RESULT STATE -->
                <div id="noResultsState" class="hidden py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2.5">
                    <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">search_off</span>
                    <h3 class="text-xs font-bold text-slate-700 dark:text-slate-300">No Matching Mock Tests</h3>
                    <p class="text-[11px] text-slate-400 max-w-xs mx-auto">We couldn't find any mock tests matching your filter. Try adjusting your subject or search term.</p>
                    <button type="button" onclick="resetMockFilters()" class="px-3.5 py-1.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-xs transition-all active:scale-95 inline-flex items-center gap-1">
                        <span class="material-symbols-rounded text-sm">refresh</span>
                        <span>Reset Filters</span>
                    </button>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'exams' }) %>

    <script>
        let currentMockSubject = 'all';
        let currentMockSearch = '';

        function selectMockSubject(subject) {
            currentMockSubject = subject || 'all';
            
            // Update active styling on subject pills
            document.querySelectorAll('.mock-subject-pill').forEach(btn => {
                const pillSubject = btn.getAttribute('data-subject-pill');
                if (pillSubject === currentMockSubject) {
                    btn.className = 'mock-subject-pill px-3 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition-all shadow-2xs shrink-0 bg-sky-600 text-white';
                } else {
                    btn.className = 'mock-subject-pill px-3 py-1 rounded-lg text-[11px] font-medium whitespace-nowrap transition-all shadow-2xs shrink-0 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60';
                }
            });

            filterMockTests();
        }

        function handleMockSearch(val) {
            currentMockSearch = (val || '').toLowerCase().trim();
            const clearBtn = document.getElementById('clearMockSearchBtn');
            if (clearBtn) {
                if (currentMockSearch.length > 0) {
                    clearBtn.classList.remove('hidden');
                } else {
                    clearBtn.classList.add('hidden');
                }
            }
            filterMockTests();
        }

        function clearMockSearch() {
            const input = document.getElementById('mockSearchInput');
            if (input) input.value = '';
            handleMockSearch('');
        }

        function resetMockFilters() {
            clearMockSearch();
            selectMockSubject('all');
        }

        window.filterMockWithSubject = function(subject) {
            selectMockSubject(subject);
        };

        window.filterMockWithSearch = function(search) {
            const input = document.getElementById('mockSearchInput');
            if (input) input.value = search || '';
            handleMockSearch(search);
        };

        function filterMockTests() {
            const cards = document.querySelectorAll('.mock-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject') || '';
                const cardTitle = card.getAttribute('data-title') || '';
                const cardCourse = card.getAttribute('data-course') || '';

                const matchesSubject = (currentMockSubject === 'all' || cardSubject === currentMockSubject);
                const matchesSearch = (
                    currentMockSearch === '' || 
                    cardTitle.includes(currentMockSearch) || 
                    cardSubject.toLowerCase().includes(currentMockSearch) ||
                    cardCourse.includes(currentMockSearch)
                );

                if (matchesSubject && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const countTextEl = document.getElementById('mockCountText');
            if (countTextEl) {
                countTextEl.textContent = `${visibleCount} Available`;
            }

            const noResults = document.getElementById('noResultsState');
            if (noResults) {
                if (visibleCount === 0 && cards.length > 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
        }
    </script>
</body>
</html>