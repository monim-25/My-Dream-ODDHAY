<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Mock Test | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header', { pageTitle: 'Mock Test', activePage: 'exams', backUrl: '/exams' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <main class="flex-1 w-full overflow-y-auto px-3 sm:px-5 py-3 sm:py-5 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-3.5 pb-24 sm:pb-28 lg:pb-8">
            
            <% 
               const testSubjects = Array.from(new Set(mockTests.map(t => (t.subject || '').trim()).filter(Boolean)));
               const allFilterSubjects = Array.from(new Set([...(assignedSubjects || []), ...testSubjects])).filter(Boolean);
            %>

            <!-- TOP CONTROLS & ON-SCREEN SEARCH BAR (MOBILE FIRST) -->
            <div class="max-w-6xl w-full mx-auto space-y-2.5">
                
                <!-- TOP HEADER ROW (Without Class Level and Without All Exams Button) -->
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="size-7 sm:size-8 rounded-xl bg-sky-500/10 dark:bg-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none">assignment</span>
                        </span>
                        <div>
                            <h1 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight">
                                Mock Tests
                            </h1>
                        </div>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0 ml-auto">
                        <span id="mockTestCountBadge" class="h-7.5 px-2.5 rounded-lg bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200/80 dark:border-sky-500/20 text-[11px] sm:text-xs font-semibold flex items-center gap-1">
                            <span class="material-symbols-rounded text-xs leading-none">verified</span>
                            <span id="mockCountText"><%= mockTests.length %> Available</span>
                        </span>
                    </div>
                </div>

                <!-- LIVE SEARCH INPUT & SUBJECT DROPDOWN (BESIDE SEARCH BAR WITH PERFECT MOBILE HEIGHT) -->
                <div class="flex items-center gap-2 w-full">
                    <!-- Search Input -->
                    <div class="relative flex-1 min-w-0">
                        <div class="absolute left-3 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none select-none text-slate-400 dark:text-slate-500">
                            <span class="material-symbols-rounded text-[19px] leading-none">search</span>
                        </div>
                        <input type="text" id="screenMockSearchInput"
                            oninput="handleScreenMockSearch(this.value)"
                            onkeyup="handleScreenMockSearch(this.value)"
                            placeholder="Search mock tests, subjects, courses..."
                            class="w-full h-11 pl-10 pr-9 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 rounded-xl outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 shadow-2xs transition-all">
                        <button type="button" id="screenMockClearSearchBtn" onclick="clearScreenMockSearch()"
                            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 size-5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 items-center justify-center transition-colors cursor-pointer select-none">
                            <span class="material-symbols-rounded text-sm">cancel</span>
                        </button>
                    </div>

                    <!-- Custom Subject Filter Dropdown beside search bar -->
                    <div class="relative shrink-0" id="screenMockSubjectDropdownContainer">
                        <button type="button" id="screenMockSubjectDropdownBtn" onclick="toggleScreenMockSubjectDropdown(event)"
                            class="h-11 px-3 sm:px-3.5 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all active:scale-95 shadow-2xs"
                            title="Filter by Subject">
                            <span class="material-symbols-rounded text-sky-600 dark:text-sky-400 text-lg leading-none shrink-0">tune</span>
                            <span id="screenMockSubjectSelectedLabel" class="truncate max-w-[85px] sm:max-w-[130px] font-bold">All Subjects</span>
                            <span id="screenMockSubjectDropdownArrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                        </button>

                        <!-- Custom Popover Menu -->
                        <div id="screenMockSubjectDropdownMenu"
                            class="hidden absolute right-0 top-full mt-1.5 w-52 sm:w-60 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                            <!-- All Subjects Option -->
                            <button type="button" onclick="selectScreenMockSubject('all')"
                                data-screen-mock-opt="all"
                                class="screen-mock-sub-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 font-bold">
                                <span class="flex items-center gap-2">
                                    <span class="opt-dot size-1.5 rounded-full bg-sky-500"></span>
                                    <span>All Subjects</span>
                                </span>
                                <span class="opt-check material-symbols-rounded text-base text-sky-600 dark:text-sky-400 inline">check</span>
                            </button>

                            <% allFilterSubjects.forEach(sub => { %>
                                <button type="button" onclick="selectScreenMockSubject('<%= sub.replace(/'/g, "\\'") %>')"
                                    data-screen-mock-opt="<%= sub %>"
                                    class="screen-mock-sub-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                    <span class="flex items-center gap-2">
                                        <span class="opt-dot size-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                        <span class="truncate"><%= sub %></span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-sky-600 dark:text-sky-400 hidden">check</span>
                                </button>
                            <% }); %>
                        </div>
                    </div>
                </div>

            </div>

            <!-- MOCK TESTS GRID -->
            <div class="max-w-6xl w-full mx-auto">
                <div id="mockTestsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
                    <% if (mockTests.length === 0) { %>
                        <div class="col-span-full py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                            <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">event_busy</span>
                            <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Mock Tests Available</h3>
                            <p class="text-[11px] text-slate-400">There are no mock tests uploaded for your class level yet.</p>
                        </div>
                    <% } else { %>
                        <% mockTests.forEach(function(mk) { %>
                            <% 
                               const mkSubject = (mk.subject || 'General').trim();
                               const mkTitle = mk.title ? mk.title.trim() : `${mkSubject} Mock Test`;
                               const mkCourseTitle = (mk.course && mk.course.title) ? mk.course.title.trim() : '';
                            %>
                            <div class="mock-card bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/70 rounded-xl sm:rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-2.5 shadow-2xs" 
                                 data-subject="<%= mkSubject %>" 
                                 data-title="<%= mkTitle.toLowerCase() %>"
                                 data-course="<%= mkCourseTitle.toLowerCase() %>">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-1.5">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-500/20">
                                                <%= mkSubject %>
                                            </span>
                                            <% if (mk.duration && mk.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                                    <%= mk.duration %> Mins
                                                </span>
                                            <% } %>
                                            <% if (mkCourseTitle) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-medium bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60 truncate max-w-[120px]">
                                                    <%= mkCourseTitle %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                                        <%= mkTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/50">
                                    <div class="flex items-center gap-1 text-[10px] font-medium text-slate-400 truncate">
                                        <span class="material-symbols-rounded text-xs text-sky-500 leading-none select-none">quiz</span>
                                        <span><%= (mk.questions && mk.questions.length) ? mk.questions.length : (mk.totalQuestions || 0) %> Qs</span>
                                    </div>

                                    <a href="/quiz/<%= mk._id %>?from=exams" class="px-2.5 sm:px-3 py-1 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-semibold transition-all shadow-2xs active:scale-95 flex items-center gap-1 shrink-0">
                                        <span>Start Exam</span>
                                        <span class="material-symbols-rounded text-xs leading-none">play_arrow</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- EMPTY SEARCH RESULT STATE -->
                <div id="noResultsState" class="hidden py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2.5">
                    <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">search_off</span>
                    <h3 class="text-xs font-bold text-slate-700 dark:text-slate-300">No Matching Mock Tests</h3>
                    <p class="text-[11px] text-slate-400 max-w-xs mx-auto">We couldn't find any mock tests matching your filter. Try adjusting your subject or search term.</p>
                    <button type="button" onclick="resetMockFilters()" class="px-3.5 py-1.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-xs transition-all active:scale-95 inline-flex items-center gap-1">
                        <span class="material-symbols-rounded text-sm">refresh</span>
                        <span>Reset Filters</span>
                    </button>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'exams' }) %>

    <script>
        let currentMockSubject = 'all';
        let currentMockSearch = '';

        // Toggle custom dropdown
        function toggleScreenMockSubjectDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('screenMockSubjectDropdownMenu');
            const arrow = document.getElementById('screenMockSubjectDropdownArrow');
            if (menu) {
                const isOpen = !menu.classList.contains('hidden');
                if (isOpen) {
                    menu.classList.add('hidden');
                    if (arrow) arrow.style.transform = 'rotate(0deg)';
                } else {
                    menu.classList.remove('hidden');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }

        // Close dropdown when tapping outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('screenMockSubjectDropdownContainer');
            const menu = document.getElementById('screenMockSubjectDropdownMenu');
            const arrow = document.getElementById('screenMockSubjectDropdownArrow');
            if (container && menu && !container.contains(e.target)) {
                menu.classList.add('hidden');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
            }
        });

        // Select subject from dropdown or chips
        function selectScreenMockSubject(subject) {
            currentMockSubject = subject || 'all';

            // Close dropdown
            const menu = document.getElementById('screenMockSubjectDropdownMenu');
            const arrow = document.getElementById('screenMockSubjectDropdownArrow');
            if (menu) menu.classList.add('hidden');
            if (arrow) arrow.style.transform = 'rotate(0deg)';

            // Update dropdown trigger label
            const labelEl = document.getElementById('screenMockSubjectSelectedLabel');
            if (labelEl) {
                labelEl.textContent = (currentMockSubject === 'all') ? 'All Subjects' : currentMockSubject;
            }

            // Update dropdown options checkmarks and colors
            document.querySelectorAll('.screen-mock-sub-opt').forEach(opt => {
                const optSub = opt.getAttribute('data-screen-mock-opt');
                const dot = opt.querySelector('.opt-dot');
                const check = opt.querySelector('.opt-check');
                if (optSub === currentMockSubject) {
                    opt.classList.add('bg-sky-50', 'dark:bg-sky-950/40', 'text-sky-600', 'dark:text-sky-400', 'font-bold');
                    opt.classList.remove('text-slate-700', 'dark:text-slate-300', 'font-medium');
                    if (dot) dot.classList.replace('bg-slate-300', 'bg-sky-500');
                    if (check) check.classList.remove('hidden');
                } else {
                    opt.classList.remove('bg-sky-50', 'dark:bg-sky-950/40', 'text-sky-600', 'dark:text-sky-400', 'font-bold');
                    opt.classList.add('text-slate-700', 'dark:text-slate-300', 'font-medium');
                    if (dot) dot.classList.replace('bg-sky-500', 'bg-slate-300');
                    if (check) check.classList.add('hidden');
                }
            });

            // Update dropdown trigger button active style
            const triggerBtn = document.getElementById('screenMockSubjectDropdownBtn');
            if (triggerBtn) {
                if (currentMockSubject !== 'all') {
                    triggerBtn.classList.add('bg-sky-50/80', 'dark:bg-sky-950/40', 'border-sky-300', 'dark:border-sky-500/40', 'text-sky-700', 'dark:text-sky-300');
                    triggerBtn.classList.remove('bg-slate-50', 'dark:bg-slate-800/90', 'border-slate-200/90', 'dark:border-slate-700/80', 'text-slate-700', 'dark:text-slate-200');
                } else {
                    triggerBtn.classList.remove('bg-sky-50/80', 'dark:bg-sky-950/40', 'border-sky-300', 'dark:border-sky-500/40', 'text-sky-700', 'dark:text-sky-300');
                    triggerBtn.classList.add('bg-slate-50', 'dark:bg-slate-800/90', 'border-slate-200/90', 'dark:border-slate-700/80', 'text-slate-700', 'dark:text-slate-200');
                }
            }

            // Synchronize desktop nav select if present
            const headerSelect = document.getElementById('mock-header-subject');
            if (headerSelect && headerSelect.value !== currentMockSubject) {
                headerSelect.value = currentMockSubject;
            }

            filterMockTests();
        }

        // Live Search Handler
        function handleScreenMockSearch(val) {
            currentMockSearch = (val || '').toLowerCase().trim();
            const clearBtn = document.getElementById('screenMockClearSearchBtn');
            if (clearBtn) {
                if (currentMockSearch.length > 0) {
                    clearBtn.classList.remove('hidden');
                    clearBtn.classList.add('flex');
                } else {
                    clearBtn.classList.add('hidden');
                    clearBtn.classList.remove('flex');
                }
            }

            // Synchronize desktop header search input if present
            const headerInput = document.getElementById('mock-search-input-header');
            if (headerInput && headerInput.value !== val) {
                headerInput.value = val;
            }

            filterMockTests();
        }

        function clearScreenMockSearch() {
            const input = document.getElementById('screenMockSearchInput');
            if (input) input.value = '';
            handleScreenMockSearch('');
        }

        function resetMockFilters() {
            clearScreenMockSearch();
            selectScreenMockSubject('all');
        }

        // Interop with desktop header
        window.filterMockWithSubject = function(subject) {
            selectScreenMockSubject(subject);
        };

        window.filterMockWithSearch = function(search) {
            const screenInput = document.getElementById('screenMockSearchInput');
            if (screenInput) screenInput.value = search;
            handleScreenMockSearch(search);
        };

        function filterMockTests() {
            const cards = document.querySelectorAll('.mock-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject') || '';
                const cardTitle = card.getAttribute('data-title') || '';
                const cardCourse = card.getAttribute('data-course') || '';

                const matchesSubject = (currentMockSubject === 'all' || cardSubject === currentMockSubject);
                const matchesSearch = (
                    currentMockSearch === '' || 
                    cardTitle.includes(currentMockSearch) || 
                    cardSubject.toLowerCase().includes(currentMockSearch) ||
                    cardCourse.includes(currentMockSearch)
                );

                if (matchesSubject && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const countTextEl = document.getElementById('mockCountText');
            if (countTextEl) {
                countTextEl.textContent = `${visibleCount} Available`;
            }

            const noResults = document.getElementById('noResultsState');
            if (noResults) {
                if (visibleCount === 0 && cards.length > 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
        }
    </script>
</body>
</html>