<!-- Mobile Bottom Navigation (Hidden on lg sizes) -->
<nav class="lg:hidden shrink-0 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-around z-40 px-2 py-1 shadow-[0_-4px_20px_rgba(0,0,0,0.03)] sticky bottom-0" style="padding-bottom: max(6px, env(safe-area-inset-bottom));">
    <% 
    const isStaffUser = locals.isSuperAdmin || (locals.user && (user.role === 'admin' || user.role === 'teacher'));
    const staffPanelLink = locals.isSuperAdmin ? '/superadmin' : (locals.user && user.role === 'teacher' ? '/teacher' : '/admin');
    const staffPanelLabel = locals.isSuperAdmin ? 'Super' : (locals.user && user.role === 'teacher' ? 'Teacher' : 'Admin');
    const mobileMenus = isStaffUser ? [
        { id: 'dashboard', icon: 'dashboard', label: 'Home', link: '/dashboard' }, 
        { id: 'courses', icon: 'auto_stories', label: 'Courses', link: '/courses' }, 
        { id: 'ai', icon: 'auto_awesome', label: 'Oddhay AI', link: '/student', isAi: true },
        { id: 'exams', icon: 'edit_note', label: 'Exams', link: '/exams' }, 
        { id: 'admin-panel', icon: 'admin_panel_settings', label: staffPanelLabel, link: staffPanelLink }
    ] : [
        { id: 'dashboard', icon: 'dashboard', label: 'Home', link: '/dashboard' }, 
        { id: 'courses', icon: 'auto_stories', label: 'Courses', link: '/courses' }, 
        { id: 'ai', icon: 'auto_awesome', label: 'Oddhay AI', link: '/student', isAi: true },
        { id: 'exams', icon: 'edit_note', label: 'Exams', link: '/exams' }, 
        { id: 'profile', icon: 'person', label: 'Profile', link: '/profile' } 
    ]; %>

    <% mobileMenus.forEach(menu => { 
        const isAiActive = (menu.id === 'ai') && (locals.activePage === 'ai' || locals.activePage === 'student');
        const isActive = isAiActive || (locals.activePage === menu.id);
    %>
        <% if (menu.isAi) { %>
            <a href="<%= menu.link %>"
                class="flex flex-col items-center -mt-3 group relative px-1" title="Oddhay AI">
                <div class="size-11 rounded-2xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-sky-400 p-0.5 shadow-md shadow-indigo-500/25 ring-4 ring-white dark:ring-[#0f172a] transition-transform duration-200 active:scale-95 <%= isAiActive ? 'scale-105 shadow-indigo-500/40 ring-indigo-50 dark:ring-indigo-950/60' : '' %>">
                    <div class="w-full h-full rounded-[14px] bg-gradient-to-tr from-indigo-600 to-sky-500 flex items-center justify-center text-white">
                        <span class="material-symbols-rounded text-[21px] leading-none animate-pulse">auto_awesome</span>
                    </div>
                </div>
                <span class="text-[9.5px] mt-0.5 font-bold tracking-tight <%= isAiActive ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300' %>">Oddhay AI</span>
            </a>
        <% } else { %>
            <a href="<%= menu.link %>"
                class="flex flex-col items-center px-3 py-1 rounded-xl transition-all duration-200 active:scale-95 <%= isActive ? 'text-primary bg-primary/10 font-bold' : (menu.id === 'admin-panel' ? 'text-rose-500 dark:text-rose-400 hover:text-rose-600 dark:hover:text-rose-300' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200') %>">
                <span class="material-symbols-rounded text-xl leading-none <%= isActive ? 'font-bold' : '' %>">
                    <%= menu.icon %>
                </span>
                <span class="text-[9.5px] mt-0.5 tracking-tight font-medium"><%= menu.label %></span>
            </a>
        <% } %>
    <% }); %>
</nav>
