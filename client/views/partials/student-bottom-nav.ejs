<!-- Mobile Bottom Navigation (Hidden on lg sizes) -->
<nav class="lg:hidden shrink-0 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-around z-40 px-2 py-1.5 shadow-[0_-4px_20px_rgba(0,0,0,0.03)] sticky bottom-0" style="padding-bottom: max(6px, env(safe-area-inset-bottom));">
    <% 
    const isStaffUser = locals.isSuperAdmin || (locals.user && (user.role === 'admin' || user.role === 'teacher'));
    const staffPanelLink = locals.isSuperAdmin ? '/superadmin' : (locals.user && user.role === 'teacher' ? '/teacher' : '/admin');
    const staffPanelLabel = locals.isSuperAdmin ? 'Super' : (locals.user && user.role === 'teacher' ? 'Teacher' : 'Admin');
    const mobileMenus = isStaffUser ? [
        { id: 'dashboard', icon: 'dashboard', label: 'Home', link: '/dashboard' }, 
        { id: 'courses', icon: 'auto_stories', label: 'Courses', link: '/courses' }, 
        { id: 'exams', icon: 'psychology', label: 'Exams', link: '/exams' }, 
        { id: 'profile', icon: 'person', label: 'Profile', link: '/profile' },
        { id: 'admin-panel', icon: 'admin_panel_settings', label: staffPanelLabel, link: staffPanelLink }
    ] : [
        { id: 'dashboard', icon: 'dashboard', label: 'Home', link: '/dashboard' }, 
        { id: 'courses', icon: 'auto_stories', label: 'Courses', link: '/courses' }, 
        { id: 'exams', icon: 'psychology', label: 'Exams', link: '/exams' }, 
        { id: 'routine', icon: 'calendar_month', label: 'Routine', link: '/routine' }, 
        { id: 'profile', icon: 'person', label: 'Profile', link: '/profile' } 
    ]; %>

    <% mobileMenus.forEach(menu => { %>
        <a href="<%= menu.link %>"
            class="flex flex-col items-center px-3 py-1 rounded-xl transition-all <%= locals.activePage === menu.id ? 'text-primary bg-primary/10 font-bold' : (menu.id === 'admin-panel' ? 'text-rose-500 dark:text-rose-400 hover:text-rose-600 dark:hover:text-rose-300' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200') %>">
            <span class="material-symbols-rounded text-xl <%= locals.activePage === menu.id ? 'font-bold' : '' %>">
                <%= menu.icon %>
            </span>
            <span class="text-[9px] mt-0.5 tracking-tight font-medium"><%= menu.label %></span>
        </a>
    <% }); %>
</nav>
