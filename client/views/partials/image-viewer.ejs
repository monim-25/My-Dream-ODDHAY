<!-- ================================================================= -->
<!-- ODDHAY PREMIER MEDIA & DOCUMENT STUDIO VIEWER (IMAGE & PDF) -->
<!-- ================================================================= -->
<div id="oddhayImageViewer" class="fixed inset-0 z-[9999] hidden flex flex-col bg-slate-950 text-white select-none transition-opacity duration-300 opacity-0 overflow-hidden">
    
    <!-- Top Toolbar (Header) -->
    <div id="imageViewerHeader" class="h-14 sm:h-16 px-3 sm:px-6 border-b border-white/10 flex items-center justify-between gap-3 bg-slate-900/90 backdrop-blur-md shrink-0 z-30">
        <!-- Left: Back Button & Title & Type Badge -->
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1">
            <button type="button" onclick="closeImageViewer()" class="size-9 rounded-xl bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white transition-all inline-flex items-center justify-center shrink-0 cursor-pointer select-none" title="Back / Close (Esc)">
                <span class="material-symbols-rounded text-xl leading-none shrink-0 flex items-center justify-center select-none">arrow_back</span>
            </button>
            <div class="size-9 rounded-xl bg-teal-500/20 text-teal-400 inline-flex items-center justify-center shrink-0 select-none" id="viewerModeIconBox">
                <span class="material-symbols-rounded text-xl leading-none shrink-0 flex items-center justify-center select-none" id="viewerModeIcon">picture_as_pdf</span>
            </div>
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h3 id="imageViewerTitle" class="text-xs sm:text-sm font-bold text-white tracking-tight truncate max-w-[180px] sm:max-w-md md:max-w-lg">
                        Document Viewer
                    </h3>
                    <span id="viewerTypeBadge" class="hidden sm:inline-flex px-2 py-0.5 text-[9px] font-black uppercase tracking-wider rounded bg-teal-500/20 text-teal-300 border border-teal-500/30">
                        PDF
                    </span>
                </div>
                <p id="imageViewerSubtitle" class="text-[10px] sm:text-[11px] font-medium text-slate-400 truncate mt-0.5">
                    ODDHAY Study Material
                </p>
            </div>
        </div>

        <!-- Right: Action Controls (Zoom, Rotate, Download, Fullscreen, Close) -->
        <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
            <!-- Image Specific Controls (Hidden in PDF mode) -->
            <div id="imageControlsGroup" class="flex items-center gap-1">
                <!-- Zoom In -->
                <button type="button" onclick="zoomInImageViewer()" class="size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors inline-flex items-center justify-center cursor-pointer select-none" title="Zoom In (+)">
                    <span class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">zoom_in</span>
                </button>

                <!-- Zoom Out -->
                <button type="button" onclick="zoomOutImageViewer()" class="size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors inline-flex items-center justify-center cursor-pointer select-none" title="Zoom Out (-)">
                    <span class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">zoom_out</span>
                </button>

                <!-- Reset Zoom -->
                <button type="button" onclick="resetImageViewerZoom()" class="hidden sm:inline-flex size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors items-center justify-center cursor-pointer select-none" title="Reset Zoom (0)">
                    <span class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">restart_alt</span>
                </button>

                <!-- Rotate -->
                <button type="button" onclick="rotateImageViewer()" class="size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors inline-flex items-center justify-center cursor-pointer select-none" title="Rotate 90° (R)">
                    <span class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">rotate_right</span>
                </button>
            </div>

            <!-- Download Button -->
            <button id="imageViewerDownloadBtn" type="button" onclick="downloadViewerImage()" class="px-2.5 sm:px-3 py-1.5 rounded-xl bg-teal-600/80 hover:bg-teal-600 text-white text-xs font-bold transition-all inline-flex items-center justify-center gap-1.5 cursor-pointer shadow-sm select-none" title="Download">
                <span class="material-symbols-rounded text-base sm:text-lg leading-none shrink-0 flex items-center justify-center select-none">download</span>
                <span class="hidden md:inline leading-none select-none">Download</span>
            </button>

            <!-- Open in New Tab Popout Button -->
            <a id="imageViewerOpenExternalBtn" href="#" target="_blank" class="size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors hidden sm:inline-flex items-center justify-center cursor-pointer select-none" title="Open in New Tab">
                <span class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">open_in_new</span>
            </a>

            <!-- Fullscreen Toggle -->
            <button id="imageViewerFullscreenBtn" type="button" onclick="toggleViewerFullscreen()" class="size-8.5 sm:size-9 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors hidden sm:inline-flex items-center justify-center cursor-pointer select-none" title="Fullscreen (F)">
                <span id="imageViewerFullscreenIcon" class="material-symbols-rounded text-lg sm:text-xl leading-none shrink-0 flex items-center justify-center select-none">fullscreen</span>
            </button>

            <div class="h-5 w-px bg-white/15 mx-1 hidden sm:block"></div>

            <!-- Close Button -->
            <button type="button" onclick="closeImageViewer()" class="size-8.5 sm:size-9 rounded-xl bg-white/10 hover:bg-rose-500 text-slate-300 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer select-none" title="Close (Esc)">
                <span class="material-symbols-rounded text-xl leading-none shrink-0 flex items-center justify-center select-none">close</span>
            </button>
        </div>
    </div>

    <!-- Main Canvas Viewport for Images (Edge-to-Edge) -->
    <div id="imageViewerCanvas" class="flex-1 w-full h-full relative overflow-hidden flex items-center justify-center cursor-grab active:cursor-grabbing p-0 m-0">
        <!-- Loading Spinner -->
        <div id="imageViewerLoading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 z-10 bg-slate-950/40 pointer-events-none">
            <div class="size-10 rounded-full border-2 border-teal-500 border-t-transparent animate-spin"></div>
            <span class="text-xs font-semibold text-slate-300 tracking-wide">Loading image...</span>
        </div>

        <!-- Image Element Wrapper -->
        <div id="imageViewerTransformContainer" class="max-w-full max-h-full flex items-center justify-center transition-transform duration-100 ease-out origin-center">
            <img id="imageViewerImg" src="" alt="View Image" class="max-w-full max-h-full object-contain pointer-events-none transition-shadow" draggable="false">
        </div>

        <!-- Left Navigation Arrow (Previous) -->
        <button id="imageViewerPrevBtn" type="button" onclick="prevViewerImage()" class="absolute left-4 top-1/2 -translate-y-1/2 size-12 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white border border-white/10 shadow-xl inline-flex items-center justify-center transition-all hover:scale-105 active:scale-95 z-20 hidden cursor-pointer select-none" title="Previous (Left Arrow)">
            <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none">chevron_left</span>
        </button>

        <!-- Right Navigation Arrow (Next) -->
        <button id="imageViewerNextBtn" type="button" onclick="nextViewerImage()" class="absolute right-4 top-1/2 -translate-y-1/2 size-12 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white border border-white/10 shadow-xl inline-flex items-center justify-center transition-all hover:scale-105 active:scale-95 z-20 hidden cursor-pointer select-none" title="Next (Right Arrow)">
            <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none">chevron_right</span>
        </button>
    </div>

    <!-- In-App Document Viewport (Edge-to-Edge Main Screen) -->
    <div id="pdfViewerContainer" class="flex-1 min-h-0 w-full h-full relative overflow-hidden hidden flex-col p-0 m-0 bg-slate-950">
        <!-- Floating Minimal Close Button for Fullscreen PDF Reader (Header is hidden in PDF mode) -->
        <button id="pdfFloatingCloseBtn" type="button" onclick="closeImageViewer()" class="hidden fixed top-1.5 right-1.5 sm:top-2 sm:right-2.5 z-50 size-8.5 sm:size-9 rounded-full bg-slate-900/90 hover:bg-rose-600 active:scale-95 text-white/90 hover:text-white backdrop-blur-md border border-white/20 shadow-2xl items-center justify-center transition-all cursor-pointer select-none" title="Close PDF (Esc)">
            <span class="material-symbols-rounded text-lg sm:text-xl leading-none flex items-center justify-center select-none font-normal">close</span>
        </button>
        <iframe id="pdfViewerIframe" class="w-full h-full border-none p-0 m-0 bg-white dark:bg-slate-900" style="width:100%;height:100%;border:none;min-height:100%;display:block;" src="about:blank"></iframe>
    </div>

    <!-- Bottom Thumbnail Strip / Gallery Bar (Shown when multiple images exist) -->
    <div id="imageViewerThumbnailsBar" class="h-20 border-t border-white/10 bg-slate-900/70 backdrop-blur-md px-4 flex items-center justify-center gap-2 overflow-x-auto no-scrollbar shrink-0 hidden z-20">
        <!-- Thumbnails injected dynamically -->
    </div>
</div>

<script>
    (function() {
        // Prevent multiple initialization if included multiple times
        if (window.__oddhayViewerInitialized) {
            // Remove duplicate DOM node if present
            const viewerElements = document.querySelectorAll('#oddhayImageViewer');
            if (viewerElements.length > 1) {
                for (let i = 1; i < viewerElements.length; i++) viewerElements[i].remove();
            }
            return;
        }
        window.__oddhayViewerInitialized = true;

        let viewerState = {
            isOpen: false,
            mode: 'image', // 'image' | 'pdf'
            pdfUrl: '',
            pdfTitle: '',
            zoom: 1,
            rotation: 0,
            panX: 0,
            panY: 0,
            isDragging: false,
            startX: 0,
            startY: 0,
            gallery: [],
            currentIndex: 0
        };

        const modal = document.getElementById('oddhayImageViewer');
        const img = document.getElementById('imageViewerImg');
        const transformContainer = document.getElementById('imageViewerTransformContainer');
        const canvas = document.getElementById('imageViewerCanvas');
        const pdfContainer = document.getElementById('pdfViewerContainer');
        const pdfIframe = document.getElementById('pdfViewerIframe');
        const downloadBtn = document.getElementById('imageViewerDownloadBtn');
        const loader = document.getElementById('imageViewerLoading');
        const prevBtn = document.getElementById('imageViewerPrevBtn');
        const nextBtn = document.getElementById('imageViewerNextBtn');
        const thumbsBar = document.getElementById('imageViewerThumbnailsBar');
        const titleEl = document.getElementById('imageViewerTitle');
        const subtitleEl = document.getElementById('imageViewerSubtitle');
        const modeIcon = document.getElementById('viewerModeIcon');
        const modeIconBox = document.getElementById('viewerModeIconBox');
        const typeBadge = document.getElementById('viewerTypeBadge');
        const imgControls = document.getElementById('imageControlsGroup');

        function normalizeMediaArgs(arg1, arg2, arg3, arg4) {
            let url = arg1;
            let title = arg2;
            let type = arg3;
            let subtitle = arg4;

            const isUrl = (val) => {
                if (!val || typeof val !== 'string') return false;
                const v = val.trim();
                return v.startsWith('/') ||
                       v.startsWith('http://') ||
                       v.startsWith('https://') ||
                       v.startsWith('blob:') ||
                       v.startsWith('data:') ||
                       /\.(pdf|png|jpe?g|webp|gif|svg|bmp)(\?.*)?$/i.test(v) ||
                       v.includes('/uploads/') ||
                       v.includes('/images/') ||
                       v.includes('/assets/') ||
                       v.includes('/public/');
            };

            // If arg1 is not a URL but arg2 is a URL, swap them
            if (!isUrl(arg1) && isUrl(arg2)) {
                url = arg2;
                title = arg1;
            }

            // Determine type if not specified
            let resolvedType = (typeof type === 'string') ? type.trim().toLowerCase() : '';
            const cleanUrl = (typeof url === 'string') ? url.trim() : '';
            const urlWithoutQuery = cleanUrl.toLowerCase().split('?')[0];

            if (!resolvedType) {
                if (urlWithoutQuery.endsWith('.pdf') || urlWithoutQuery.includes('.pdf')) {
                    resolvedType = 'pdf';
                } else if (/\.(png|jpe?g|webp|gif|svg|bmp)$/i.test(urlWithoutQuery)) {
                    resolvedType = 'image';
                }
            }

            return {
                url: cleanUrl,
                title: (typeof title === 'string') ? title.trim() : '',
                type: resolvedType,
                subtitle: (typeof subtitle === 'string') ? subtitle.trim() : ''
            };
        }

        function getViewerElements() {
            return {
                modal: document.getElementById('oddhayImageViewer'),
                header: document.getElementById('imageViewerHeader'),
                pdfCloseBtn: document.getElementById('pdfFloatingCloseBtn'),
                img: document.getElementById('imageViewerImg'),
                transformContainer: document.getElementById('imageViewerTransformContainer'),
                canvas: document.getElementById('imageViewerCanvas'),
                pdfContainer: document.getElementById('pdfViewerContainer'),
                pdfIframe: document.getElementById('pdfViewerIframe'),
                downloadBtn: document.getElementById('imageViewerDownloadBtn'),
                loader: document.getElementById('imageViewerLoading'),
                prevBtn: document.getElementById('imageViewerPrevBtn'),
                nextBtn: document.getElementById('imageViewerNextBtn'),
                thumbsBar: document.getElementById('imageViewerThumbnailsBar'),
                titleEl: document.getElementById('imageViewerTitle'),
                subtitleEl: document.getElementById('imageViewerSubtitle'),
                modeIcon: document.getElementById('viewerModeIcon'),
                modeIconBox: document.getElementById('viewerModeIconBox'),
                typeBadge: document.getElementById('viewerTypeBadge'),
                imgControls: document.getElementById('imageControlsGroup'),
                popoutBtn: document.getElementById('imageViewerOpenExternalBtn')
            };
        }

        function updateTransform() {
            const els = getViewerElements();
            if (!els.transformContainer) return;
            els.transformContainer.style.transform = `translate(${viewerState.panX}px, ${viewerState.panY}px) scale(${viewerState.zoom}) rotate(${viewerState.rotation}deg)`;
            if (els.canvas) {
                if (viewerState.zoom > 1) {
                    els.canvas.classList.remove('cursor-default');
                    els.canvas.classList.add('cursor-grab');
                } else {
                    els.canvas.classList.remove('cursor-grab', 'cursor-grabbing');
                    els.canvas.classList.add('cursor-default');
                }
            }
        }

        function updateDownloadBtnState() {
            const els = getViewerElements();
            if (!els.downloadBtn) return;
            const canDownload = (typeof window.canDownloadMaterial !== 'undefined') ? !!window.canDownloadMaterial : true;
            if (canDownload) {
                els.downloadBtn.classList.remove('hidden');
                els.downloadBtn.classList.add('inline-flex');
            } else {
                els.downloadBtn.classList.add('hidden');
                els.downloadBtn.classList.remove('inline-flex');
            }
        }

        function renderCurrentImage() {
            if (!viewerState.gallery || viewerState.gallery.length === 0) return;
            const item = viewerState.gallery[viewerState.currentIndex];
            if (!item) return;

            const els = getViewerElements();
            if (els.loader) els.loader.classList.remove('hidden');

            if (els.img) {
                els.img.onload = function() {
                    if (els.loader) els.loader.classList.add('hidden');
                };
                els.img.onerror = function() {
                    if (els.loader) els.loader.classList.add('hidden');
                };
                els.img.src = item.url;
            }

            if (els.titleEl) els.titleEl.textContent = item.title || 'Image Viewer';
            if (els.subtitleEl) {
                if (viewerState.gallery.length > 1) {
                    els.subtitleEl.textContent = `${viewerState.currentIndex + 1} of ${viewerState.gallery.length}`;
                } else {
                    els.subtitleEl.textContent = item.subtitle || 'ODDHAY Study Material';
                }
            }

            // Extract file extension for badge
            const ext = (item.url.split('.').pop() || '').split('?')[0].toUpperCase();
            if (els.typeBadge) {
                els.typeBadge.textContent = ['JPG', 'JPEG', 'PNG', 'WEBP', 'GIF', 'SVG'].includes(ext) ? ext : 'IMAGE';
            }

            updateDownloadBtnState();

            // Gallery navigation buttons
            if (viewerState.gallery.length > 1) {
                if (els.prevBtn) els.prevBtn.classList.remove('hidden');
                if (els.nextBtn) els.nextBtn.classList.remove('hidden');
            } else {
                if (els.prevBtn) els.prevBtn.classList.add('hidden');
                if (els.nextBtn) els.nextBtn.classList.add('hidden');
            }

            // Reset zoom & pan
            viewerState.zoom = 1;
            viewerState.rotation = 0;
            viewerState.panX = 0;
            viewerState.panY = 0;
            updateTransform();

            renderThumbnails();
        }

        function renderThumbnails() {
            const els = getViewerElements();
            if (!els.thumbsBar) return;
            if (viewerState.gallery.length <= 1) {
                els.thumbsBar.classList.add('hidden');
                return;
            }
            els.thumbsBar.classList.remove('hidden');
            els.thumbsBar.innerHTML = '';

            viewerState.gallery.forEach((it, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `size-14 rounded-lg overflow-hidden border-2 transition-all shrink-0 bg-slate-800 ${idx === viewerState.currentIndex ? 'border-teal-500 scale-105 shadow-md shadow-teal-500/20' : 'border-white/20 opacity-60 hover:opacity-100'}`;
                btn.innerHTML = `<img src="${it.url}" class="size-full object-cover" alt="Thumb">`;
                btn.onclick = function() {
                    viewerState.currentIndex = idx;
                    renderCurrentImage();
                };
                els.thumbsBar.appendChild(btn);
            });
        }

        // Open in Image Mode
        window.openImageViewer = function(arg1, arg2, galleryList = [], subtitle = '') {
            const { url, title, subtitle: normSubtitle } = normalizeMediaArgs(arg1, arg2, 'image', subtitle);
            const els = getViewerElements();
            if (!els.modal || !els.img) return;

            viewerState.mode = 'image';

            // Show studio header for image mode
            if (els.header) {
                els.header.classList.remove('hidden');
                els.header.style.display = 'flex';
            }
            if (els.pdfCloseBtn) {
                els.pdfCloseBtn.classList.add('hidden');
                els.pdfCloseBtn.style.display = 'none';
            }

            if (els.canvas) {
                els.canvas.classList.remove('hidden');
                els.canvas.style.display = 'flex';
            }
            if (els.pdfContainer) {
                els.pdfContainer.classList.add('hidden');
                els.pdfContainer.style.display = 'none';
            }
            if (els.pdfIframe) els.pdfIframe.src = 'about:blank';
            if (els.imgControls) {
                els.imgControls.classList.remove('hidden');
                els.imgControls.style.display = 'flex';
            }

            if (els.modeIcon) els.modeIcon.textContent = 'image';
            if (els.modeIconBox) {
                els.modeIconBox.className = 'size-9 rounded-xl bg-teal-500/20 text-teal-400 inline-flex items-center justify-center shrink-0 select-none';
            }
            if (els.typeBadge) els.typeBadge.textContent = 'IMAGE';

            const resolvedUrl = (typeof getImg === 'function') ? getImg(url) : url;

            if (els.popoutBtn) {
                els.popoutBtn.href = resolvedUrl;
                els.popoutBtn.classList.remove('hidden');
                els.popoutBtn.classList.add('inline-flex');
            }

            if (galleryList && galleryList.length > 0) {
                viewerState.gallery = galleryList.map(g => ({
                    url: (typeof getImg === 'function') ? getImg(g.url || g.filePath || g.path || g.fileUrl) : (g.url || g.filePath || g.path || g.fileUrl),
                    title: g.title || g.name || title || 'Image',
                    subtitle: g.subtitle || normSubtitle || 'ODDHAY Study Material'
                }));
                const foundIdx = viewerState.gallery.findIndex(g => g.url === resolvedUrl);
                viewerState.currentIndex = foundIdx >= 0 ? foundIdx : 0;
            } else {
                viewerState.gallery = [{
                    url: resolvedUrl,
                    title: title || 'Image Note',
                    subtitle: normSubtitle || 'ODDHAY Study Material'
                }];
                viewerState.currentIndex = 0;
            }

            els.modal.classList.remove('hidden');
            els.modal.style.display = 'flex';
            requestAnimationFrame(() => {
                els.modal.classList.remove('opacity-0');
            });
            viewerState.isOpen = true;
            document.body.style.overflow = 'hidden';

            renderCurrentImage();
        };

        // Open in Document Mode (PDF Viewer)
        window.openPdfViewer = function(arg1, arg2, arg3) {
            const { url, title, subtitle } = normalizeMediaArgs(arg1, arg2, 'pdf', arg3);
            if (!url) return;

            const els = getViewerElements();
            if (!els.modal || !els.pdfContainer || !els.pdfIframe) return;

            viewerState.mode = 'pdf';
            const resolvedUrl = (typeof getImg === 'function') ? getImg(url) : url;
            viewerState.pdfUrl = resolvedUrl;
            viewerState.pdfTitle = title || 'PDF Document';

            // Hide the top studio header in PDF view (edge-to-edge native reader)
            if (els.header) {
                els.header.classList.add('hidden');
                els.header.style.display = 'none';
            }
            // Show sleek floating close button in PDF view
            if (els.pdfCloseBtn) {
                els.pdfCloseBtn.classList.remove('hidden');
                els.pdfCloseBtn.style.display = 'flex';
            }

            if (els.canvas) {
                els.canvas.classList.add('hidden');
                els.canvas.style.display = 'none';
            }
            if (els.thumbsBar) {
                els.thumbsBar.classList.add('hidden');
                els.thumbsBar.style.display = 'none';
            }
            if (els.prevBtn) els.prevBtn.classList.add('hidden');
            if (els.nextBtn) els.nextBtn.classList.add('hidden');
            if (els.imgControls) {
                els.imgControls.classList.add('hidden');
                els.imgControls.style.display = 'none';
            }

            els.pdfContainer.classList.remove('hidden');
            els.pdfContainer.style.display = 'flex';

            const canDownload = (typeof window.canDownloadMaterial !== 'undefined') ? !!window.canDownloadMaterial : true;
            els.pdfIframe.src = resolvedUrl + (canDownload ? '' : '#toolbar=0');

            els.modal.classList.remove('hidden');
            els.modal.style.display = 'flex';
            requestAnimationFrame(() => {
                els.modal.classList.remove('opacity-0');
            });
            viewerState.isOpen = true;
            document.body.style.overflow = 'hidden';
        };

        // Universal Opener Helper
        window.openMediaViewer = function(arg1, arg2, arg3, arg4) {
            const { url, title, type, subtitle } = normalizeMediaArgs(arg1, arg2, arg3, arg4);
            if (!url || url === '#' || url === 'undefined') return;

            const cleanUrl = url;
            const lowerUrl = cleanUrl.toLowerCase().split('?')[0];
            const isPdf = (type === 'pdf') || lowerUrl.endsWith('.pdf') || lowerUrl.includes('.pdf');
            
            if (isPdf) {
                window.openPdfViewer(cleanUrl, title || 'PDF Document', subtitle);
            } else {
                window.openImageViewer(cleanUrl, title || 'Image Note', [{ url: cleanUrl, title: title || 'Image Note' }], subtitle);
            }
        };

        // Universal backwards-compatible alias for anywhere openReaderModal is called
        window.openReaderModal = function(arg1, arg2, arg3, arg4) {
            window.openMediaViewer(arg1, arg2, arg3, arg4);
        };

        window.closeImageViewer = function() {
            const els = getViewerElements();
            if (!els.modal || !viewerState.isOpen) return;
            els.modal.classList.add('opacity-0');
            setTimeout(() => {
                els.modal.classList.add('hidden');
                els.modal.style.display = 'none';
                if (els.pdfCloseBtn) {
                    els.pdfCloseBtn.classList.add('hidden');
                    els.pdfCloseBtn.style.display = 'none';
                }
                if (els.header) {
                    els.header.classList.remove('hidden');
                    els.header.style.display = '';
                }
                if (els.pdfContainer) {
                    els.pdfContainer.classList.add('hidden');
                    els.pdfContainer.style.display = 'none';
                }
                if (els.canvas) {
                    els.canvas.classList.remove('hidden');
                    els.canvas.style.display = '';
                }
                if (els.img) els.img.src = '';
                if (els.pdfIframe) els.pdfIframe.src = 'about:blank';
                document.body.style.overflow = '';
            }, 250);
            viewerState.isOpen = false;
        };

        window.closePdfViewer = window.closeImageViewer;

        window.zoomInImageViewer = function() {
            if (viewerState.mode !== 'image') return;
            viewerState.zoom = Math.min(5, Math.round((viewerState.zoom + 0.25) * 100) / 100);
            updateTransform();
        };

        window.zoomOutImageViewer = function() {
            if (viewerState.mode !== 'image') return;
            viewerState.zoom = Math.max(0.5, Math.round((viewerState.zoom - 0.25) * 100) / 100);
            if (viewerState.zoom <= 1) {
                viewerState.panX = 0;
                viewerState.panY = 0;
            }
            updateTransform();
        };

        window.resetImageViewerZoom = function() {
            if (viewerState.mode !== 'image') return;
            viewerState.zoom = 1;
            viewerState.rotation = 0;
            viewerState.panX = 0;
            viewerState.panY = 0;
            updateTransform();
        };

        window.rotateImageViewer = function() {
            if (viewerState.mode !== 'image') return;
            viewerState.rotation = (viewerState.rotation + 90) % 360;
            updateTransform();
        };

        window.prevViewerImage = function() {
            if (viewerState.mode !== 'image' || viewerState.gallery.length <= 1) return;
            viewerState.currentIndex = (viewerState.currentIndex - 1 + viewerState.gallery.length) % viewerState.gallery.length;
            renderCurrentImage();
        };

        window.nextViewerImage = function() {
            if (viewerState.mode !== 'image' || viewerState.gallery.length <= 1) return;
            viewerState.currentIndex = (viewerState.currentIndex + 1) % viewerState.gallery.length;
            renderCurrentImage();
        };

        window.downloadViewerImage = function() {
            const canDownload = (typeof window.canDownloadMaterial !== 'undefined') ? !!window.canDownloadMaterial : true;
            if (!canDownload) {
                alert('Download is only available for paid enrolled students or free items.');
                return;
            }

            if (viewerState.mode === 'pdf') {
                if (!viewerState.pdfUrl) return;
                const a = document.createElement('a');
                a.href = viewerState.pdfUrl;
                a.download = (viewerState.pdfTitle || 'document').replace(/[^a-zA-Z0-9_\u0980-\u09FF-]/g, '_') + '.pdf';
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                return;
            }

            const currentItem = viewerState.gallery[viewerState.currentIndex];
            if (!currentItem || !currentItem.url) return;
            const a = document.createElement('a');
            a.href = currentItem.url;
            a.download = (currentItem.title || 'image').replace(/[^a-zA-Z0-9_\u0980-\u09FF-]/g, '_');
            a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        };

        window.toggleViewerFullscreen = function() {
            const fsIcon = document.getElementById('imageViewerFullscreenIcon');
            if (!document.fullscreenElement) {
                if (modal.requestFullscreen) {
                    modal.requestFullscreen();
                    if (fsIcon) fsIcon.textContent = 'fullscreen_exit';
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                    if (fsIcon) fsIcon.textContent = 'fullscreen';
                }
            }
        };

        document.addEventListener('fullscreenchange', () => {
            const fsIcon = document.getElementById('imageViewerFullscreenIcon');
            if (fsIcon) {
                fsIcon.textContent = document.fullscreenElement ? 'fullscreen_exit' : 'fullscreen';
            }
        });

        // Panning and Dragging Handlers for Canvas
        if (canvas) {
            canvas.addEventListener('mousedown', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image') return;
                viewerState.isDragging = true;
                viewerState.startX = e.clientX - viewerState.panX;
                viewerState.startY = e.clientY - viewerState.panY;
                canvas.classList.add('cursor-grabbing');
            });

            window.addEventListener('mousemove', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image' || !viewerState.isDragging) return;
                e.preventDefault();
                viewerState.panX = e.clientX - viewerState.startX;
                viewerState.panY = e.clientY - viewerState.startY;
                updateTransform();
            });

            window.addEventListener('mouseup', () => {
                if (!viewerState.isOpen) return;
                viewerState.isDragging = false;
                if (canvas) canvas.classList.remove('cursor-grabbing');
            });

            // Double Click to toggle zoom
            canvas.addEventListener('dblclick', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image') return;
                if (viewerState.zoom > 1) {
                    resetImageViewerZoom();
                } else {
                    viewerState.zoom = 2;
                    updateTransform();
                }
            });

            // Wheel to Zoom
            canvas.addEventListener('wheel', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image') return;
                e.preventDefault();
                if (e.deltaY < 0) {
                    zoomInImageViewer();
                } else {
                    zoomOutImageViewer();
                }
            }, { passive: false });

            // Touch events for mobile
            let touchDist = 0;
            canvas.addEventListener('touchstart', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image') return;
                if (e.touches.length === 1) {
                    viewerState.isDragging = true;
                    viewerState.startX = e.touches[0].clientX - viewerState.panX;
                    viewerState.startY = e.touches[0].clientY - viewerState.panY;
                } else if (e.touches.length === 2) {
                    touchDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            });

            canvas.addEventListener('touchmove', (e) => {
                if (!viewerState.isOpen || viewerState.mode !== 'image') return;
                if (e.touches.length === 1 && viewerState.isDragging) {
                    viewerState.panX = e.touches[0].clientX - viewerState.startX;
                    viewerState.panY = e.touches[0].clientY - viewerState.startY;
                    updateTransform();
                } else if (e.touches.length === 2) {
                    const newDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    if (touchDist > 0) {
                        const factor = newDist / touchDist;
                        viewerState.zoom = Math.min(5, Math.max(0.5, viewerState.zoom * factor));
                        updateTransform();
                    }
                    touchDist = newDist;
                }
            }, { passive: false });

            canvas.addEventListener('touchend', () => {
                viewerState.isDragging = false;
                touchDist = 0;
            });
        }

        // Global Keyboard Navigation
        window.addEventListener('keydown', (e) => {
            if (!viewerState.isOpen) return;

            if (e.key === 'Escape') {
                closeImageViewer();
            } else if (viewerState.mode === 'image') {
                if (e.key === '+' || e.key === '=') {
                    zoomInImageViewer();
                } else if (e.key === '-' || e.key === '_') {
                    zoomOutImageViewer();
                } else if (e.key === '0') {
                    resetImageViewerZoom();
                } else if (e.key === 'r' || e.key === 'R') {
                    rotateImageViewer();
                } else if (e.key === 'ArrowLeft') {
                    prevViewerImage();
                } else if (e.key === 'ArrowRight') {
                    nextViewerImage();
                } else if (e.key === 'f' || e.key === 'F') {
                    toggleViewerFullscreen();
                }
            }
        });
    })();
</script>
