<aside id="notif-panel">
    <div class="p-8 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h3 class="text-xl font-black dark:text-white">নোটিফিকেশন</h3>
        <button onclick="toggleNotifications()"
            class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500">
            <span class="material-symbols-rounded">close</span>
        </button>
    </div>
    <div class="flex-1 overflow-y-auto p-6 space-y-4 no-scrollbar">
        <% if (locals.notifications && locals.notifications.length> 0) { %>
            <% locals.notifications.forEach(notif=> { %>
                <div onclick="handleNotifClick('<%= notif._id %>', '<%= notif.link || '#' %>')"
                    class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-transparent hover:border-primary/20 transition-all cursor-pointer group <%= notif.isRead ? 'opacity-60' : '' %>">
                    <div class="flex gap-4">
                        <div
                            class="size-10 rounded-xl <%= notif.isRead ? 'bg-slate-200 dark:bg-slate-700 text-slate-500' : 'bg-primary/10 text-primary' %> flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded text-lg">
                                <%= notif.type==='notice' ? 'campaign' : 'notifications' %>
                            </span>
                        </div>
                        <div class="flex-1">
                            <p
                                class="text-sm font-bold text-slate-700 dark:text-slate-300 leading-snug mb-1 <%= notif.isRead ? '' : 'text-primary' %>">
                                <%= notif.message %>
                            </p>
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                    <%= new Date(notif.createdAt).toLocaleTimeString('bn-BD', { hour: '2-digit' ,
                                        minute: '2-digit' }) %>
                                </span>
                                <% if(!notif.isRead) { %>
                                    <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-20 opacity-30">
                            <span class="material-symbols-rounded text-6xl mb-4">notifications_off</span>
                            <p class="text-sm font-black">কোনো নোটিফিকেশন নেই</p>
                        </div>
                        <% } %>
    </div>
</aside>