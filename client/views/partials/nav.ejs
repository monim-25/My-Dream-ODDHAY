<!-- 1. Sleek Navigation Bar with Class Filter Beside Options (Same as Main Landing Page) -->
<header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#091122]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors"
    <% if (locals.user) { %>
        data-user-id="<%= user._id %>"
        data-user-name="<%= user.name %>"
        data-user-role="<%= user.role %>"
    <% } %>>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[68px] flex items-center justify-between gap-3 sm:gap-4">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 shrink-0 select-none group">
            <div class="size-9.5 sm:size-10 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                <span class="material-symbols-rounded text-[21px] sm:text-[22px] pointer-events-none">menu_book</span>
            </div>
            <div class="flex flex-col">
                <span class="font-semibold text-xl sm:text-[22px] tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                <span class="text-[10px] sm:text-[11px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
            </div>
        </a>

        <!-- Desktop Middle: Nav Links + Class Filter Beside Options -->
        <div class="hidden md:flex items-center gap-2 lg:gap-3">
            <nav class="flex items-center gap-1 text-sm sm:text-[15px] font-medium text-slate-600 dark:text-slate-300">
                <a href="/#courses" class="px-3 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                <a href="/#video-tour" class="px-3 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম পরিচিতি</a>
                <a href="/#features" class="px-3 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                <a href="/#question-bank" class="px-3 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">বোর্ড প্রশ্ন</a>
                <a href="/#how-it-works" class="px-3 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
            </nav>

            <!-- Class Filter at Navbar -->
            <div class="relative flex items-center ml-1.5 pl-2.5 border-l border-slate-200 dark:border-slate-800">
                <label for="navbarClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                <div class="relative flex items-center">
                    <span class="material-symbols-rounded text-[#18a957] text-[18px] absolute left-2.5 pointer-events-none">tune</span>
                    <select id="navbarClassFilter" onchange="handleNavClassFilter(this.value)"
                        class="appearance-none h-9 pl-8 pr-7.5 py-1 text-xs sm:text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 outline-none focus:border-[#18a957] focus:ring-1 focus:ring-[#18a957]/20 transition-all cursor-pointer shadow-2xs">
                        <option value="all">শ্রেণী: সকল</option>
                        <% if (locals.activeClasses && activeClasses.length > 0) { %>
                            <% activeClasses.forEach(cls => { %>
                                <option value="<%= cls.name %>"><%= cls.name %></option>
                            <% }) %>
                        <% } else if (locals.globalAcademicClasses && globalAcademicClasses.length > 0) { %>
                            <% globalAcademicClasses.forEach(cls => { %>
                                <option value="<%= cls.name %>"><%= cls.name %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="Class 9">Class 9</option>
                            <option value="Class 10">Class 10</option>
                            <option value="HSC">HSC (Class 11-12)</option>
                        <% } %>
                    </select>
                    <span class="material-symbols-rounded text-slate-400 text-sm absolute right-2 pointer-events-none">expand_more</span>
                </div>
            </div>
        </div>

        <!-- Right Actions: Theme Toggle + Dashboard/Login/Signup -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                class="size-9 sm:size-9.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer select-none"
                title="ডার্ক / লাইট মোড পরিবর্তন">
                <span class="material-symbols-rounded text-[20px] dark:hidden">dark_mode</span>
                <span class="material-symbols-rounded text-[20px] hidden dark:block text-amber-400">light_mode</span>
            </button>

            <% if (locals.user) { %>
                <% 
                    let dashUrl = '/dashboard';
                    if (user.role === 'teacher') dashUrl = '/teacher';
                    else if (user.role === 'admin') dashUrl = '/admin';
                    else if (user.role === 'superadmin') dashUrl = '/superadmin';
                %>
                <a href="<%= dashUrl %>" class="px-4 py-2 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-xs sm:text-sm font-semibold transition-all flex items-center gap-1.5 shadow-xs active:scale-95">
                    <span class="material-symbols-rounded text-base">dashboard</span>
                    <span>ড্যাশবোর্ড</span>
                </a>
            <% } else { %>
                <a href="/login" class="px-4 py-2 text-xs sm:text-sm font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95">
                    লগইন
                </a>
                <a href="/register" class="px-4.5 py-2 bg-[#18a957] hover:bg-[#148e49] text-white text-xs sm:text-sm font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                    শুরু করুন
                </a>
            <% } %>
        </div>
    </div>

    <!-- Mobile Filter Bar (Visible only on mobile screens under header) -->
    <div class="md:hidden px-4 py-2.5 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/60 flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
            <span class="material-symbols-rounded text-sm text-[#18a957]">tune</span>
            <span>শ্রেণী ফিল্টার:</span>
        </span>
        <div class="relative flex items-center">
            <select id="mobileClassFilter" onchange="handleNavClassFilter(this.value)"
                class="appearance-none h-8 pl-3 pr-6 py-1 text-xs sm:text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 outline-none cursor-pointer">
                <option value="all">সকল শ্রেণী</option>
                <% if (locals.activeClasses && activeClasses.length > 0) { %>
                    <% activeClasses.forEach(cls => { %>
                        <option value="<%= cls.name %>"><%= cls.name %></option>
                    <% }) %>
                <% } else if (locals.globalAcademicClasses && globalAcademicClasses.length > 0) { %>
                    <% globalAcademicClasses.forEach(cls => { %>
                        <option value="<%= cls.name %>"><%= cls.name %></option>
                    <% }) %>
                <% } else { %>
                    <option value="Class 9">Class 9</option>
                    <option value="Class 10">Class 10</option>
                    <option value="HSC">HSC (Class 11-12)</option>
                <% } %>
            </select>
            <span class="material-symbols-rounded text-slate-400 text-xs sm:text-sm absolute right-1.5 pointer-events-none">expand_more</span>
        </div>
    </div>
</header>

<script>
    function handleNavClassFilter(val) {
        const navSel = document.getElementById('navbarClassFilter');
        const mobSel = document.getElementById('mobileClassFilter');
        if (navSel && navSel.value !== val) navSel.value = val;
        if (mobSel && mobSel.value !== val) mobSel.value = val;

        if (window.location.pathname === '/' || window.location.pathname === '') {
            if (typeof filterLandingByClass === 'function') {
                filterLandingByClass(val);
                const coursesElem = document.getElementById('courses');
                if (coursesElem) coursesElem.scrollIntoView({ behavior: 'smooth' });
            }
        } else {
            window.location.href = '/?class=' + encodeURIComponent(val) + '#courses';
        }
    }
</script>