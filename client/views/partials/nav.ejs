<% const isEn = (typeof lang !== 'undefined' && lang === 'en') || (locals.lang === 'en'); %>
<!-- ODDHAY Unified Navigation Bar -->
<header class="sticky top-0 z-50 w-full bg-white/90 dark:bg-[#091122]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors"
    <% if (locals.user) { %>
        data-user-id="<%= user._id %>"
        data-user-name="<%= user.name %>"
        data-user-role="<%= user.role %>"
    <% } %>>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2.5 shrink-0 select-none group">
            <div class="size-9 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                <span class="material-symbols-rounded text-[20px] pointer-events-none">menu_book</span>
            </div>
            <div class="flex flex-col">
                <span class="font-semibold text-lg sm:text-xl tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                <% if (!isEn) { %>
                    <span class="text-[9px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
                <% } %>
            </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-[13px] font-medium text-slate-600 dark:text-slate-300">
            <a href="/" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'Home' : 'হোম' %>
            </a>
            <a href="/courses" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'Courses' : 'কোর্সসমূহ' %>
            </a>
            <a href="/question-bank" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'Question Bank' : 'প্রশ্ন ব্যাংক' %>
            </a>
            <a href="/about" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'About' : 'আমাদের সম্পর্কে' %>
            </a>
            <a href="/faq" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'FAQ' : 'প্রশ্নোত্তর' %>
            </a>
            <a href="/contact" class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">
                <%= isEn ? 'Contact' : 'যোগাযোগ' %>
            </a>
        </nav>

        <!-- Right Side Actions: Theme Toggle & Auth Buttons -->
        <div class="flex items-center gap-2 sm:gap-2.5">
            <!-- Theme Toggle Button -->
            <button type="button" onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : toggleTheme()"
                class="theme-toggle-btn size-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700/80 flex items-center justify-center text-slate-600 dark:text-amber-400 transition-colors cursor-pointer select-none"
                title="Toggle Light/Dark Theme">
                <span class="material-symbols-rounded text-[19px] theme-icon-sun hidden dark:block">light_mode</span>
                <span class="material-symbols-rounded text-[19px] theme-icon-moon block dark:hidden">dark_mode</span>
            </button>

            <!-- Authentication Buttons -->
            <div class="flex items-center gap-2">
                <% if (locals.user) { %>
                    <% if (['superadmin', 'admin'].includes(locals.user.role)) { %>
                        <a href="/<%= locals.user.role === 'superadmin' ? 'superadmin' : 'admin' %>"
                            class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm">admin_panel_settings</span>
                            <span><%= locals.user.role === 'superadmin' ? 'SuperAdmin' : 'Admin' %></span>
                        </a>
                    <% } else if (locals.user.role === 'teacher') { %>
                        <a href="/teacher"
                            class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm">school</span>
                            <span><%= isEn ? 'Teacher' : 'শিক্ষক প্যানেল' %></span>
                        </a>
                    <% } else { %>
                        <a href="/dashboard"
                            class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm">dashboard</span>
                            <span><%= isEn ? 'Dashboard' : 'ড্যাশবোর্ড' %></span>
                        </a>
                    <% } %>
                    <a href="/logout"
                        class="px-2.5 py-1.5 rounded-xl text-xs font-medium text-slate-500 hover:text-rose-600 transition-colors">
                        <%= isEn ? 'Logout' : 'লগআউট' %>
                    </a>
                <% } else { %>
                    <!-- Login Button: Dark Emerald -->
                    <a href="/login"
                        class="px-3.5 py-1.5 text-xs font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95 cursor-pointer">
                        <%= isEn ? 'Login' : 'লগইন' %>
                    </a>
                    <!-- Register Button: Bright Emerald -->
                    <a href="/register"
                        class="px-3.5 py-1.5 bg-[#18a957] hover:bg-[#148e49] text-white text-xs font-semibold rounded-xl transition-all shadow-xs active:scale-95 cursor-pointer">
                        <%= isEn ? 'Get Started' : 'শুরু করুন' %>
                    </a>
                <% } %>
            </div>

            <!-- Mobile Hamburger Toggle -->
            <button type="button" onclick="toggleNavSidebar(true)"
                class="md:hidden size-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700/80 flex items-center justify-center text-slate-700 dark:text-slate-200 transition-colors cursor-pointer"
                aria-label="Open Navigation Menu">
                <span class="material-symbols-rounded text-[22px]">menu</span>
            </button>
        </div>

    </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div id="nav-sidebar-overlay"
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[2000] hidden opacity-0 transition-opacity duration-300"
    onclick="toggleNavSidebar(false)"></div>

<!-- Mobile Navigation Slide-over Sidebar -->
<aside id="nav-mobile-sidebar"
    class="fixed top-0 right-0 w-[82%] max-w-sm h-full bg-white dark:bg-[#091122] z-[2001] translate-x-full shadow-2xl transition-transform duration-300 p-6 flex flex-col justify-between overflow-y-auto">
    
    <div>
        <!-- Drawer Header -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
                <div class="size-8 rounded-xl bg-[#18a957] flex items-center justify-center text-white shadow-xs">
                    <span class="material-symbols-rounded text-lg">menu_book</span>
                </div>
                <span class="font-bold text-base text-slate-900 dark:text-white">ODDHAY</span>
                <% if (!isEn) { %>
                    <span class="text-[9px] font-semibold text-[#18a957]">অধ্যায়</span>
                <% } %>
            </div>
            <button type="button" onclick="toggleNavSidebar(false)"
                class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-slate-800 dark:hover:text-white">
                <span class="material-symbols-rounded text-lg">close</span>
            </button>
        </div>

        <!-- Drawer Navigation Links -->
        <nav class="flex flex-col gap-1.5 pt-5">
            <a href="/" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">home</span>
                <span><%= isEn ? 'Home' : 'হোম' %></span>
            </a>
            <a href="/courses" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">auto_stories</span>
                <span><%= isEn ? 'Courses' : 'কোর্সসমূহ' %></span>
            </a>
            <a href="/question-bank" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">quiz</span>
                <span><%= isEn ? 'Question Bank' : 'প্রশ্ন ব্যাংক' %></span>
            </a>
            <a href="/about" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">info</span>
                <span><%= isEn ? 'About' : 'আমাদের সম্পর্কে' %></span>
            </a>
            <a href="/faq" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">help_outline</span>
                <span><%= isEn ? 'FAQ' : 'সাধারণ প্রশ্নোত্তর (FAQ)' %></span>
            </a>
            <a href="/contact" class="px-3 py-2 rounded-xl font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors" onclick="toggleNavSidebar(false)">
                <span class="material-symbols-rounded text-slate-400 text-lg">support_agent</span>
                <span><%= isEn ? 'Contact' : 'যোগাযোগ' %></span>
            </a>
        </nav>
    </div>

    <!-- Drawer Bottom Actions -->
    <div class="pt-5 border-t border-slate-100 dark:border-slate-800 space-y-2">
        <% if (locals.user) { %>
            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 mb-2">
                <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block truncate"><%= locals.user.name %></span>
                <span class="text-[10px] text-slate-400 capitalize"><%= locals.user.role %></span>
            </div>
            <% if (['superadmin', 'admin'].includes(locals.user.role)) { %>
                <a href="/<%= locals.user.role === 'superadmin' ? 'superadmin' : 'admin' %>" class="w-full py-2 rounded-xl bg-indigo-600 text-white font-semibold text-xs text-center block shadow-xs">
                    Admin Dashboard
                </a>
            <% } else { %>
                <a href="/dashboard" class="w-full py-2 rounded-xl bg-emerald-600 text-white font-semibold text-xs text-center block shadow-xs">
                    <%= isEn ? 'Dashboard' : 'ড্যাশবোর্ড' %>
                </a>
            <% } %>
            <a href="/logout" class="w-full py-2 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 font-semibold text-xs text-center block">
                <%= isEn ? 'Logout' : 'লগআউট' %>
            </a>
        <% } else { %>
            <div class="grid grid-cols-2 gap-2">
                <a href="/login" class="py-2 rounded-xl bg-[#137a43] hover:bg-[#0e6336] text-white font-semibold text-xs text-center block shadow-xs">
                    <%= isEn ? 'Login' : 'লগইন' %>
                </a>
                <a href="/register" class="py-2 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs text-center block shadow-xs">
                    <%= isEn ? 'Get Started' : 'শুরু করুন' %>
                </a>
            </div>
        <% } %>
    </div>

</aside>

<script>
    function toggleNavSidebar(open) {
        const sidebar = document.getElementById('nav-mobile-sidebar');
        const overlay = document.getElementById('nav-sidebar-overlay');
        if (!sidebar || !overlay) return;
        
        if (open) {
            overlay.classList.remove('hidden');
            setTimeout(() => {
                overlay.classList.remove('opacity-0');
                sidebar.classList.remove('translate-x-full');
            }, 10);
            document.body.style.overflow = 'hidden';
        } else {
            overlay.classList.add('opacity-0');
            sidebar.classList.add('translate-x-full');
            setTimeout(() => overlay.classList.add('hidden'), 300);
            document.body.style.overflow = '';
        }
    }
</script>
