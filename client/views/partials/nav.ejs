<!-- 1. Sleek Navigation Bar with Class Filter Beside Options (Same as Main Landing Page) -->
<header
    class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#091122]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors"
    <% if (locals.user) { %>
    data-user-id="<%= user._id %>"
        data-user-name="<%= user.name %>"
            data-user-role="<%= user.role %>"
                <% } %>>
                    <div
                        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[66px] flex items-center justify-between gap-3 sm:gap-4">

                        <!-- Brand Logo (Only Logo on small screen, full text on larger screen) -->
                        <a href="/" class="flex items-center gap-2.5 shrink-0 select-none group">
                            <div
                                class="size-9 sm:size-10 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                                <span
                                    class="material-symbols-rounded text-[21px] sm:text-[22px] pointer-events-none">menu_book</span>
                            </div>
                            <div class="hidden sm:flex flex-col">
                                <span
                                    class="font-semibold text-xl sm:text-[21px] tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                                <span
                                    class="text-[10.5px] sm:text-[11px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
                            </div>
                        </a>

                        <!-- Desktop Middle: Nav Links + Class Filter Beside Options -->
                        <div class="hidden md:flex items-center gap-2 lg:gap-3">
                            <nav
                                class="flex items-center gap-1 text-[14.5px] sm:text-[15px] font-medium text-slate-600 dark:text-slate-300">
                                <a href="/#courses"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                                <a href="/#video-tour"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম
                                    পরিচিতি</a>
                                <a href="/#features"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                                <a href="/#question-bank"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">বোর্ড
                                    প্রশ্ন</a>
                                <a href="/#how-it-works"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
                            </nav>

                            <!-- Class Filter at Navbar -->
                            <div
                                class="relative flex items-center ml-1 pl-2 border-l border-slate-200 dark:border-slate-800">
                                <label for="navbarClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                                <div class="relative flex items-center">
                                    <span
                                        class="material-symbols-rounded text-[#18a957] text-[18px] absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none z-10 select-none">tune</span>
                                    <select id="navbarClassFilter" onchange="handleNavClassFilter(this.value)"
                                        class="appearance-none [background-image:none] h-9 py-1 text-xs sm:text-[13.5px] font-medium rounded-lg border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 outline-none focus:border-[#18a957] focus:ring-1 focus:ring-[#18a957]/20 transition-all cursor-pointer shadow-2xs"
                                        style="background-image: none !important; padding-left: 33px !important; padding-right: 28px !important;">
                                        <option value="all">শ্রেণী: সকল</option>
                                        <% if (locals.activeClasses && activeClasses.length> 0) { %>
                                            <% activeClasses.forEach(cls=> { %>
                                                <option value="<%= cls.name %>">
                                                    <%= cls.name %>
                                                </option>
                                                <% }) %>
                                                    <% } else if (locals.globalAcademicClasses &&
                                                        globalAcademicClasses.length> 0) { %>
                                                        <% globalAcademicClasses.forEach(cls=> { %>
                                                            <option value="<%= cls.name %>">
                                                                <%= cls.name %>
                                                            </option>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <option value="Class 9">Class 9</option>
                                                                    <option value="Class 10">Class 10</option>
                                                                    <option value="HSC">HSC (Class 11-12)</option>
                                                                    <% } %>
                                    </select>
                                    <span
                                        class="material-symbols-rounded text-slate-400 text-sm absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none z-10 select-none">expand_more</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Actions: Filter (Small screen) + Theme Toggle + Single Action (Small screen) / Dual Action (Large screen) -->
                        <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                            <!-- Mobile Class Filter: Placed right beside Dark/Light toggle on small screen only -->
                            <div class="md:hidden relative flex items-center">
                                <label for="mobileClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                                <div class="relative flex items-center">
                                    <span
                                        class="material-symbols-rounded text-[#18a957] text-[15px] absolute left-2 top-1/2 -translate-y-1/2 pointer-events-none z-10 select-none">tune</span>
                                    <select id="mobileClassFilter" onchange="handleNavClassFilter(this.value)"
                                        class="appearance-none [background-image:none] h-8 max-w-[105px] truncate text-[11px] font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 outline-none cursor-pointer shadow-2xs"
                                        style="background-image: none !important; padding-left: 22px !important; padding-right: 18px !important;">
                                        <option value="all">শ্রেণী: সকল</option>
                                        <% if (locals.activeClasses && activeClasses.length> 0) { %>
                                            <% activeClasses.forEach(cls=> { %>
                                                <option value="<%= cls.name %>">
                                                    <%= cls.name %>
                                                </option>
                                                <% }) %>
                                                    <% } else if (locals.globalAcademicClasses &&
                                                        globalAcademicClasses.length> 0) { %>
                                                        <% globalAcademicClasses.forEach(cls=> { %>
                                                            <option value="<%= cls.name %>">
                                                                <%= cls.name %>
                                                            </option>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <option value="Class 9">Class 9</option>
                                                                    <option value="Class 10">Class 10</option>
                                                                    <option value="HSC">HSC</option>
                                                                    <% } %>
                                    </select>
                                    <span
                                        class="material-symbols-rounded text-slate-400 text-xs absolute right-1 top-1/2 -translate-y-1/2 pointer-events-none z-10 select-none">expand_more</span>
                                </div>
                            </div>

                            <!-- Dark / Light Mode Toggle Button -->
                            <button type="button"
                                onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                                class="size-8 sm:size-9.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer select-none"
                                title="ডার্ক / লাইট মোড পরিবর্তন">
                                <span
                                    class="material-symbols-rounded text-[18px] sm:text-[20px] dark:hidden">dark_mode</span>
                                <span
                                    class="material-symbols-rounded text-[18px] sm:text-[20px] hidden dark:block text-amber-400">light_mode</span>
                            </button>

                            <% if (locals.user) { %>
                                <% let dashUrl='/dashboard' ; if (user.role==='teacher' ) dashUrl='/teacher' ; else if
                                    (user.role==='admin' ) dashUrl='/admin' ; else if (user.role==='superadmin' )
                                    dashUrl='/superadmin' ; %>
                                    <a href="<%= dashUrl %>"
                                        class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-xs sm:text-[13.5px] font-semibold transition-all flex items-center gap-1 sm:gap-1.5 shadow-xs active:scale-95">
                                        <span class="material-symbols-rounded text-sm sm:text-base">dashboard</span>
                                        <span>ড্যাশবোর্ড</span>
                                    </a>
                                    <% } else { %>
                                        <!-- Small Screen Only: Clean button 'শুরু করুন' without icon -->
                                        <a href="/register"
                                            class="md:hidden px-3.5 py-1.5 bg-[#18a957] hover:bg-[#148e49] text-white text-xs font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                                            শুরু করুন
                                        </a>

                                        <!-- Large Screen Only: Separate 'লগইন' and 'শুরু করুন' buttons -->
                                        <a href="/login"
                                            class="hidden md:inline-flex px-4 py-2 text-xs sm:text-[13.5px] font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95">
                                            লগইন
                                        </a>
                                        <a href="/register"
                                            class="hidden md:inline-flex px-4 py-2 bg-[#18a957] hover:bg-[#148e49] text-white text-xs sm:text-[13.5px] font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                                            শুরু করুন
                                        </a>
                                        <% } %>
                        </div>
                    </div>
</header>

<script>
    function handleNavClassFilter(val) {
        const navSel = document.getElementById('navbarClassFilter');
        const mobSel = document.getElementById('mobileClassFilter');
        if (navSel && navSel.value !== val) navSel.value = val;
        if (mobSel && mobSel.value !== val) mobSel.value = val;

        if (window.location.pathname === '/' || window.location.pathname === '') {
            window.dispatchEvent(new CustomEvent('oddhay-class-filter-changed', { detail: { className: val } }));
            if (typeof filterLandingByClass === 'function') {
                filterLandingByClass(val);
                const coursesElem = document.getElementById('courses');
                if (coursesElem && val !== 'all') coursesElem.scrollIntoView({ behavior: 'smooth' });
            }
        } else if (window.location.pathname === '/courses') {
            if (typeof filterCoursesPageByClass === 'function') {
                filterCoursesPageByClass(val);
            } else {
                window.location.href = (val === 'all') ? '/courses' : ('/courses?class=' + encodeURIComponent(val));
            }
        } else {
            window.location.href = (val === 'all') ? '/courses' : ('/courses?class=' + encodeURIComponent(val));
        }
    }
</script>