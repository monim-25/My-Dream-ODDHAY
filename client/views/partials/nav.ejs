<!-- 1. Sleek Navigation Bar with Class Filter Beside Options (Same as Main Landing Page) -->
<header
    id="mainHeader"
    class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#091122]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors mobile-nav-blended"
    <% if (locals.user) { %>
    data-user-id="<%= user._id %>"
        data-user-name="<%= user.name %>"
            data-user-role="<%= user.role %>"
                <% } %>>
                    <div
                        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[66px] flex items-center justify-between gap-3 sm:gap-4">

                        <!-- Left Group: Brand Logo + Mobile Dark/Light Toggle (Beside logo on small screen with comfortable gap) -->
                        <div class="flex items-center gap-2 xs:gap-2.5 shrink-0">
                            <!-- Brand Logo (Only Logo on small screen, full text on larger screen) -->
                            <a href="/" class="flex items-center gap-2.5 shrink-0 select-none group">
                                <div
                                    class="size-[38px] sm:size-10 rounded-xl bg-gradient-to-tr from-[#18a957] to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                                    <span
                                        class="material-symbols-rounded text-[22px] sm:text-[22px] pointer-events-none">menu_book</span>
                                </div>
                                <div class="hidden sm:flex flex-col">
                                    <span
                                        class="font-semibold text-xl sm:text-[21px] tracking-tight text-slate-800 dark:text-white leading-none font-sans">ODDHAY</span>
                                    <span
                                        class="text-[10.5px] sm:text-[11px] font-semibold text-[#18a957] tracking-wider leading-none mt-0.5">অধ্যায়</span>
                                </div>
                            </a>

                            <!-- Small Screen Only: Dark / Light Mode Toggle Button placed beside Logo with a nice gap -->
                            <button type="button"
                                onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                                class="md:hidden ml-1.5 xs:ml-2 size-9.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-colors cursor-pointer select-none"
                                title="ডার্ক / লাইট মোড পরিবর্তন">
                                <span
                                    class="material-symbols-rounded text-[23px] dark:hidden">dark_mode</span>
                                <span
                                    class="material-symbols-rounded text-[23px] hidden dark:block text-amber-400">light_mode</span>
                            </button>
                        </div>

                        <!-- Desktop Middle: Nav Links + Class Filter Beside Options -->
                        <div class="hidden md:flex items-center gap-2 lg:gap-3">
                            <nav
                                class="flex items-center gap-1 text-[14.5px] sm:text-[15px] font-medium text-slate-600 dark:text-slate-300">
                                <a href="/#courses"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">কোর্সসমূহ</a>
                                <a href="/#video-tour"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">প্ল্যাটফর্ম
                                    পরিচিতি</a>
                                <a href="/#features"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ফিচারসমূহ</a>
                                <a href="/#question-bank"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">বোর্ড
                                    প্রশ্ন</a>
                                <a href="/#how-it-works"
                                    class="px-2.5 py-1.5 rounded-lg hover:text-[#18a957] hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors">ধারাবাহিকতা</a>
                            </nav>

                            <!-- Class Filter at Navbar (Custom Dropdown System) -->
                            <div class="relative flex items-center ml-1 pl-2 border-l border-slate-200 dark:border-slate-800" id="navbarClassDropdownWrapper">
                                <label for="navbarClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                                <input type="hidden" id="navbarClassFilter" value="all">
                                
                                <button type="button" id="navbarClassDropdownBtn" onclick="toggleNavCustomDropdown('navbarClassDropdown')" 
                                    class="h-9 px-2.5 text-xs sm:text-[13.5px] font-medium rounded-lg border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-[#18a957]/60 outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs transition-all select-none">
                                    <span class="material-symbols-rounded text-[#18a957] text-[18px]">tune</span>
                                    <span id="navbarClassDropdownLabel" class="truncate max-w-[105px]">শ্রেণী: সকল</span>
                                    <span id="navbarClassDropdownArrow" class="material-symbols-rounded text-slate-400 text-sm transition-transform duration-200">expand_more</span>
                                </button>
                                
                                <!-- Custom Dropdown Menu -->
                                <div id="navbarClassDropdownMenu" class="hidden absolute left-2 top-full mt-1.5 w-48 max-h-64 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 rounded-xl shadow-xl py-1 z-50 no-scrollbar divide-y divide-slate-100 dark:divide-slate-800/60">
                                    <div class="py-1">
                                        <button type="button" onclick="selectNavClassOption('all', 'শ্রেণী: সকল')" class="nav-class-opt w-full px-3 py-2 text-left text-xs sm:text-[13px] font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors flex items-center justify-between gap-2 text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40" data-value="all">
                                            <span>শ্রেণী: সকল</span>
                                            <span class="material-symbols-rounded text-sm text-[#18a957] check-icon">check</span>
                                        </button>
                                        <% 
                                            const navClasses = (locals.activeClasses && activeClasses.length > 0) ? activeClasses : (locals.globalAcademicClasses && globalAcademicClasses.length > 0 ? globalAcademicClasses : [{ name: 'Class 9' }, { name: 'Class 10' }, { name: 'HSC' }]);
                                            navClasses.forEach(cls => { 
                                        %>
                                            <button type="button" onclick="selectNavClassOption('<%= cls.name %>', '<%= cls.name %>')" class="nav-class-opt w-full px-3 py-2 text-left text-xs sm:text-[13px] font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors flex items-center justify-between gap-2 text-slate-700 dark:text-slate-200" data-value="<%= cls.name %>">
                                                <span><%= cls.name %></span>
                                                <span class="material-symbols-rounded text-sm text-[#18a957] check-icon hidden">check</span>
                                            </button>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Actions: Mobile Filter + Action Button (and Desktop Theme Toggle) -->
                        <div class="flex items-center gap-2 xs:gap-2.5 sm:gap-2.5 shrink-0">
                            <!-- Desktop Only: Dark / Light Mode Toggle Button with comfortable gap to login button -->
                            <button type="button"
                                onclick="window.OddhayTheme ? window.OddhayTheme.toggle() : document.documentElement.classList.toggle('dark')"
                                class="hidden md:flex md:mr-2.5 lg:mr-3.5 size-9.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 items-center justify-center transition-colors cursor-pointer select-none"
                                title="ডার্ক / লাইট মোড পরিবর্তন">
                                <span
                                    class="material-symbols-rounded text-[22px] dark:hidden">dark_mode</span>
                                <span
                                    class="material-symbols-rounded text-[22px] hidden dark:block text-amber-400">light_mode</span>
                            </button>

                            <!-- Small Screen Only: Mobile Class Filter (Custom Dropdown System) -->
                            <div class="md:hidden relative flex items-center" id="mobileClassDropdownWrapper">
                                <label for="mobileClassFilter" class="sr-only">শ্রেণী নির্বাচন</label>
                                <input type="hidden" id="mobileClassFilter" value="all">
                                
                                <button type="button" id="mobileClassDropdownBtn" onclick="toggleNavCustomDropdown('mobileClassDropdown')" 
                                    class="h-9 px-2.5 text-[12.5px] xs:text-[13px] font-semibold rounded-xl border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-[#18a957]/60 outline-none flex items-center gap-1 cursor-pointer shadow-2xs transition-colors max-w-[125px] xs:max-w-[145px] select-none">
                                    <span class="material-symbols-rounded text-[#18a957] text-[16px]">tune</span>
                                    <span id="mobileClassDropdownLabel" class="truncate">শ্রেণী: সকল</span>
                                    <span id="mobileClassDropdownArrow" class="material-symbols-rounded text-slate-400 text-sm transition-transform duration-200">expand_more</span>
                                </button>

                                <!-- Custom Dropdown Menu -->
                                <div id="mobileClassDropdownMenu" class="hidden absolute right-0 top-full mt-1.5 w-48 max-h-64 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 rounded-xl shadow-xl py-1 z-50 no-scrollbar divide-y divide-slate-100 dark:divide-slate-800/60">
                                    <div class="py-1">
                                        <button type="button" onclick="selectNavClassOption('all', 'শ্রেণী: সকল')" class="mobile-class-opt w-full px-3 py-2 text-left text-xs xs:text-[13px] font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors flex items-center justify-between gap-2 text-[#18a957] font-bold bg-emerald-50/60 dark:bg-emerald-950/40" data-value="all">
                                            <span>শ্রেণী: সকল</span>
                                            <span class="material-symbols-rounded text-sm text-[#18a957] check-icon">check</span>
                                        </button>
                                        <% navClasses.forEach(cls => { %>
                                            <button type="button" onclick="selectNavClassOption('<%= cls.name %>', '<%= cls.name %>')" class="mobile-class-opt w-full px-3 py-2 text-left text-xs xs:text-[13px] font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors flex items-center justify-between gap-2 text-slate-700 dark:text-slate-200" data-value="<%= cls.name %>">
                                                <span><%= cls.name %></span>
                                                <span class="material-symbols-rounded text-sm text-[#18a957] check-icon hidden">check</span>
                                            </button>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>

                            <% if (locals.user) { %>
                                <% let dashUrl='/dashboard' ; if (user.role==='teacher' ) dashUrl='/teacher' ; else if
                                    (user.role==='admin' ) dashUrl='/admin' ; else if (user.role==='superadmin' )
                                    dashUrl='/superadmin' ; %>
                                    <a href="<%= dashUrl %>"
                                        class="h-9 px-3.5 sm:h-auto sm:px-4 sm:py-2 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-[13px] sm:text-[13.5px] font-semibold transition-all inline-flex items-center gap-1.5 shadow-xs active:scale-95">
                                        <span class="material-symbols-rounded text-base">dashboard</span>
                                        <span>ড্যাশবোর্ড</span>
                                    </a>
                                    <% } else { %>
                                        <!-- Small Screen Only: Clean button 'শুরু করুন' without icon, balanced height -->
                                        <a href="/register"
                                            class="md:hidden h-9 px-3.5 xs:px-4 inline-flex items-center justify-center bg-[#18a957] hover:bg-[#148e49] text-white text-[13px] font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                                            শুরু করুন
                                        </a>

                                        <!-- Large Screen Only: Separate 'লগইন' and 'শুরু করুন' buttons -->
                                        <a href="/login"
                                            class="hidden md:inline-flex px-4 py-2 text-xs sm:text-[13.5px] font-semibold bg-[#137a43] hover:bg-[#0e6336] text-white rounded-xl transition-all shadow-xs active:scale-95">
                                            লগইন
                                        </a>
                                        <a href="/register"
                                            class="hidden md:inline-flex px-4 py-2 bg-[#18a957] hover:bg-[#148e49] text-white text-xs sm:text-[13.5px] font-semibold rounded-xl transition-all shadow-xs active:scale-95">
                                            শুরু করুন
                                        </a>
                                        <% } %>
                        </div>
                    </div>
</header>

<style>
    /* Small screen mobile smart blend & reveal navbar (Colors match sections perfectly) */
    @media (max-width: 767px) {
        #mainHeader {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease !important;
            will-change: transform;
            background-color: #fafbfc !important;
            border-bottom-color: rgba(226, 232, 240, 0.8) !important;
        }
        html.dark #mainHeader {
            background-color: #0b1120 !important;
            border-bottom-color: rgba(30, 41, 59, 0.8) !important;
        }
        #mainHeader.mobile-nav-blended {
            background-color: #fafbfc !important;
            border-bottom-color: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            box-shadow: none !important;
        }
        html.dark #mainHeader.mobile-nav-blended {
            background-color: #0b1120 !important;
            border-bottom-color: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            box-shadow: none !important;
        }
        #mainHeader.mobile-nav-floating {
            background-color: rgba(250, 251, 252, 0.96) !important;
            border-bottom-color: rgba(226, 232, 240, 0.85) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.06) !important;
        }
        html.dark #mainHeader.mobile-nav-floating {
            background-color: rgba(11, 17, 32, 0.96) !important;
            border-bottom-color: rgba(30, 41, 59, 0.85) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.5) !important;
        }
    }
</style>

<script>
    function toggleNavCustomDropdown(id) {
        const menu = document.getElementById(id + 'Menu');
        const arrow = document.getElementById(id + 'Arrow');
        if (!menu) return;
        const isHidden = menu.classList.contains('hidden');
        closeAllNavDropdowns();
        if (isHidden) {
            menu.classList.remove('hidden');
            if (arrow) arrow.classList.add('rotate-180');
        }
    }

    function closeAllNavDropdowns() {
        ['navbarClassDropdown', 'mobileClassDropdown'].forEach(id => {
            const m = document.getElementById(id + 'Menu');
            const a = document.getElementById(id + 'Arrow');
            if (m) m.classList.add('hidden');
            if (a) a.classList.remove('rotate-180');
        });
    }

    function selectNavClassOption(val, label) {
        closeAllNavDropdowns();
        handleNavClassFilter(val);
    }

    function updateNavDropdownLabels(val) {
        const navLabel = document.getElementById('navbarClassDropdownLabel');
        const mobLabel = document.getElementById('mobileClassDropdownLabel');
        const displayLabel = (!val || val === 'all') ? 'শ্রেণী: সকল' : val;
        if (navLabel) navLabel.textContent = displayLabel;
        if (mobLabel) mobLabel.textContent = displayLabel;

        document.querySelectorAll('.nav-class-opt, .mobile-class-opt').forEach(item => {
            const itemVal = item.getAttribute('data-value');
            const check = item.querySelector('.check-icon');
            if (itemVal === val || (!val && itemVal === 'all')) {
                item.classList.add('text-[#18a957]', 'font-bold', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
                item.classList.remove('text-slate-700', 'dark:text-slate-200');
                if (check) check.classList.remove('hidden');
            } else {
                item.classList.remove('text-[#18a957]', 'font-bold', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
                item.classList.add('text-slate-700', 'dark:text-slate-200');
                if (check) check.classList.add('hidden');
            }
        });
    }

    // Expose globally so other scripts can synchronize the navbar dropdown UI
    window.syncNavClassDropdown = function(val) {
        const navSel = document.getElementById('navbarClassFilter');
        const mobSel = document.getElementById('mobileClassFilter');
        if (navSel) navSel.value = val;
        if (mobSel) mobSel.value = val;
        updateNavDropdownLabels(val);
    };

    document.addEventListener('click', function(e) {
        if (!e.target.closest('#navbarClassDropdownWrapper') && !e.target.closest('#mobileClassDropdownWrapper')) {
            closeAllNavDropdowns();
        }
    });

    function handleNavClassFilter(val) {
        const navSel = document.getElementById('navbarClassFilter');
        const mobSel = document.getElementById('mobileClassFilter');
        if (navSel) navSel.value = val;
        if (mobSel) mobSel.value = val;
        updateNavDropdownLabels(val);

        if (window.location.pathname === '/' || window.location.pathname === '') {
            window.dispatchEvent(new CustomEvent('oddhay-class-filter-changed', { detail: { className: val } }));
            if (typeof filterLandingByClass === 'function') {
                filterLandingByClass(val);
                const coursesElem = document.getElementById('courses');
                if (coursesElem && val !== 'all') coursesElem.scrollIntoView({ behavior: 'smooth' });
            }
        } else if (window.location.pathname === '/courses') {
            if (typeof filterCoursesPageByClass === 'function') {
                filterCoursesPageByClass(val);
            } else {
                window.location.href = (val === 'all') ? '/courses' : ('/courses?class=' + encodeURIComponent(val));
            }
        } else {
            window.location.href = (val === 'all') ? '/courses' : ('/courses?class=' + encodeURIComponent(val));
        }
    }

    // Smart mobile navbar reveal/hide on scroll (small screen only)
    (function initMobileSmartNav() {
        let lastScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
        let ticking = false;

        function updateMobileNav() {
            const header = document.getElementById('mainHeader');
            if (!header) return;

            const isMobile = window.innerWidth < 768;
            const currentScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;

            if (!isMobile) {
                // Desktop: reset to standard sticky navbar
                header.style.transform = '';
                header.classList.remove('mobile-nav-blended', 'mobile-nav-floating');
                lastScrollY = currentScrollY;
                ticking = false;
                return;
            }

            // Small screen behavior
            if (currentScrollY <= 15) {
                // Blended with main section at the top of the page
                header.style.transform = 'translateY(0)';
                header.classList.add('mobile-nav-blended');
                header.classList.remove('mobile-nav-floating');
            } else {
                const diff = currentScrollY - lastScrollY;
                if (diff > 8 && currentScrollY > 70) {
                    // Scrolling down: scroll/hide away naturally
                    header.style.transform = 'translateY(-100%)';
                } else if (diff < -6) {
                    // Scrolling up: reveal like a sleek navbar
                    header.style.transform = 'translateY(0)';
                    header.classList.remove('mobile-nav-blended');
                    header.classList.add('mobile-nav-floating');
                }
            }

            lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY;
            ticking = false;
        }

        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(updateMobileNav);
                ticking = true;
            }
        }, { passive: true });

        window.addEventListener('resize', function() {
            if (!ticking) {
                window.requestAnimationFrame(updateMobileNav);
                ticking = true;
            }
        }, { passive: true });

        // Run once on initial execution / page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', updateMobileNav);
        } else {
            updateMobileNav();
        }
    })();
</script>