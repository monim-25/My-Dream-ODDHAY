<aside id="desktopSidebar" class="w-[260px] hidden lg:flex flex-col border-r border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#0f172a] shrink-0 z-40 h-full transition-all duration-300">

    <!-- Navigation Menu Items (Scrollbar Hidden) -->
    <div class="flex-1 overflow-y-auto px-3 py-4 space-y-5 sidebar-scroll-area">
        <!-- Navigation Section -->
        <div>
            <p class="sidebar-section-title text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-2 px-3 select-none">Navigation</p>
            <nav class="space-y-1">
                <a href="/dashboard" class="student-nav-link <%= locals.activePage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
                    <span class="material-symbols-rounded">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/courses" class="student-nav-link <%= locals.activePage === 'courses' ? 'active' : '' %>" title="Courses">
                    <span class="material-symbols-rounded">auto_stories</span>
                    <span>Courses</span>
                </a>
                <a href="/messages" class="student-nav-link <%= locals.activePage === 'messages' ? 'active' : '' %>" title="Messages">
                    <span class="material-symbols-rounded">chat</span>
                    <span>Messages</span>
                </a>
                <a href="/library" class="student-nav-link <%= locals.activePage === 'library' ? 'active' : '' %>" title="Library">
                    <span class="material-symbols-rounded">local_library</span>
                    <span>Library</span>
                </a>
            </nav>
        </div>

        <!-- Learning Section -->
        <div>
            <p class="sidebar-section-title text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-2 px-3 select-none">Learning</p>
            <nav class="space-y-1">
                <a href="/student" class="student-nav-link <%= locals.activePage === 'ai' || locals.activePage === 'student' ? 'active' : '' %>" title="Oddhay AI">
                    <span class="material-symbols-rounded text-indigo-500">auto_awesome</span>
                    <span>Oddhay AI</span>
                </a>
                <a href="/exams" class="student-nav-link <%= locals.activePage === 'exams' ? 'active' : '' %>" title="Exams & Quizzes">
                    <span class="material-symbols-rounded">edit_note</span>
                    <span>Exams & Quizzes</span>
                </a>
                <a href="/routine" class="student-nav-link <%= locals.activePage === 'routine' ? 'active' : '' %>" title="Routine & Plan">
                    <span class="material-symbols-rounded">calendar_month</span>
                    <span>Routine & Plan</span>
                </a>
                <a href="/notes" class="student-nav-link <%= locals.activePage === 'notes' ? 'active' : '' %>" title="Notes">
                    <span class="material-symbols-rounded">sticky_note_2</span>
                    <span>Notes</span>
                </a>
                <a href="/question-bank" class="student-nav-link <%= locals.activePage === 'questions' || locals.activePage === 'question-bank' ? 'active' : '' %>" title="Question Bank">
                    <span class="material-symbols-rounded">live_help</span>
                    <span>Question Bank</span>
                </a>
                <a href="/qa-forum" class="student-nav-link <%= locals.activePage === 'qa' || locals.activePage === 'qa-forum' ? 'active' : '' %>" title="Q&A Community">
                    <span class="material-symbols-rounded">forum</span>
                    <span>Q&A Community</span>
                </a>
            </nav>
        </div>

        <!-- Account Section -->
        <div>
            <p class="sidebar-section-title text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-2 px-3 select-none">Account</p>
            <nav class="space-y-1">
                <a href="/report-card" class="student-nav-link <%= locals.activePage === 'progress' || locals.activePage === 'analytics' || locals.activePage === 'report-card' ? 'active' : '' %>" title="Progress Report">
                    <span class="material-symbols-rounded">monitoring</span>
                    <span>Progress Report</span>
                </a>
                <a href="/my-payments" class="student-nav-link <%= locals.activePage === 'payments' ? 'active' : '' %>" title="Payment History">
                    <span class="material-symbols-rounded">payments</span>
                    <span>Payment History</span>
                </a>
                <a href="/profile" class="student-nav-link <%= locals.activePage === 'profile' ? 'active' : '' %>" title="My Profile">
                    <span class="material-symbols-rounded">person</span>
                    <span>My Profile</span>
                </a>
            </nav>
        </div>
    </div>

    <!-- Sidebar Footer -->
    <div class="p-3 border-t border-slate-100 dark:border-slate-800/60 mt-auto">
        <% if (locals.isSuperAdmin || (locals.user && (user.role === 'admin' || user.role === 'teacher'))) { %>
        <% 
            const sidePanelUrl = locals.isSuperAdmin ? '/superadmin' : (user.role === 'teacher' ? '/teacher' : '/admin');
            const sidePanelLabel = locals.isSuperAdmin ? 'Super Admin Panel' : (user.role === 'teacher' ? 'Teacher Panel' : 'Admin Panel');
        %>
        <a href="<%= sidePanelUrl %>"
            class="sidebar-footer-link flex items-center gap-3 px-3 py-2.5 rounded-xl <%= locals.isSuperAdmin ? 'bg-purple-50/70 dark:bg-purple-500/10 hover:bg-purple-100 text-purple-600 dark:text-purple-400' : 'bg-indigo-50/70 dark:bg-indigo-500/10 hover:bg-indigo-100 text-indigo-600 dark:text-indigo-400' %> font-bold transition-all group text-xs mb-2"
            title="<%= sidePanelLabel %>">
            <span class="material-symbols-rounded text-[18px] group-hover:scale-110 transition-transform">admin_panel_settings</span>
            <span><%= sidePanelLabel %></span>
        </a>
        <% } %>
        <a href="/logout" class="sidebar-footer-link flex items-center gap-3 px-3 py-2.5 rounded-xl bg-rose-50/50 dark:bg-rose-500/10 hover:bg-rose-100/60 dark:hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 font-bold transition-all group text-xs" title="Sign Out">
            <span class="material-symbols-rounded text-[18px] group-hover:scale-110 transition-transform">logout</span>
            <span class="sidebar-logout-text">Sign Out</span>
        </a>
    </div>
</aside>

<style>
    .student-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.82rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        color: #1c3150;
        border: 1px solid transparent;
    }
    .dark .student-nav-link {
        color: #cbd5e1;
    }
    .student-nav-link:hover {
        background: #f1f5f9;
        color: #0284c7;
        transform: translateX(2px);
    }
    .dark .student-nav-link:hover {
        background: #1e293b;
        color: #38bdf8;
    }
    .student-nav-link.active {
        background: #e0f2fe;
        border: none !important;
        color: #0284c7 !important;
        font-weight: 700;
        box-shadow: none !important;
    }
    .dark .student-nav-link.active {
        background: rgba(14, 165, 233, 0.18);
        border: none !important;
        color: #38bdf8 !important;
        box-shadow: none !important;
    }
    .student-nav-link .material-symbols-rounded {
        font-size: 19px;
        flex-shrink: 0;
    }
    .sidebar-scroll-area::-webkit-scrollbar {
        display: none;
    }
    .sidebar-scroll-area {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
