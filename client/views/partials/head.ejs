<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<script>
    (function() {
        // ---- Professional Theme Management Engine ----
        window.OddhayTheme = {
            STORAGE_KEY: 'theme',
            
            getPreference: function() {
                try {
                    const saved = localStorage.getItem(this.STORAGE_KEY);
                    if (saved === 'dark' || saved === 'light') return saved;
                } catch (e) {}

                const serverUserTheme = "<%= (locals.user && user.theme && user.theme !== 'system') ? user.theme : '' %>";
                if (serverUserTheme === 'dark' || serverUserTheme === 'light') {
                    return serverUserTheme;
                }

                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    return 'dark';
                }
                return 'light';
            },

            isDark: function() {
                return document.documentElement.classList.contains('dark');
            },

            setTheme: function(theme, options) {
                options = options || {};
                const isDark = theme === 'dark';
                const html = document.documentElement;

                // Smooth CSS transition only when manually triggered
                if (options.animated && !html.classList.contains('theme-transitioning')) {
                    html.classList.add('theme-transitioning');
                    clearTimeout(window.__oddhayThemeTimer);
                    window.__oddhayThemeTimer = setTimeout(function() {
                        html.classList.remove('theme-transitioning');
                    }, 350);
                }

                if (isDark) {
                    html.classList.add('dark');
                    html.setAttribute('data-theme', 'dark');
                    html.style.colorScheme = 'dark';
                } else {
                    html.classList.remove('dark');
                    html.setAttribute('data-theme', 'light');
                    html.style.colorScheme = 'light';
                }

                if (!options.skipStorage) {
                    try {
                        localStorage.setItem(this.STORAGE_KEY, isDark ? 'dark' : 'light');
                    } catch (e) {}
                }

                this.syncButtons(isDark, options.animated);

                if (!options.skipServer) {
                    this.syncServer(isDark ? 'dark' : 'light');
                }

                window.dispatchEvent(new CustomEvent('themechanged', { 
                    detail: { theme: isDark ? 'dark' : 'light', isDark: isDark } 
                }));
            },

            toggle: function() {
                const nextTheme = this.isDark() ? 'light' : 'dark';
                this.setTheme(nextTheme, { animated: true });
            },

            syncButtons: function(isDark, animated) {
                if (typeof isDark === 'undefined') isDark = this.isDark();
                
                // Update #themeIcon and .theme-icon elements
                const icons = document.querySelectorAll('#themeIcon, .theme-icon');
                icons.forEach(function(icon) {
                    icon.textContent = isDark ? 'light_mode' : 'dark_mode';
                    if (animated) {
                        icon.classList.remove('theme-icon-spin');
                        void icon.offsetWidth; // trigger reflow
                        icon.classList.add('theme-icon-spin');
                    }
                });

                // Update #themeToggleBtn and .theme-toggle-btn elements
                const btns = document.querySelectorAll('#themeToggleBtn, .theme-toggle-btn');
                btns.forEach(function(btn) {
                    const title = isDark ? 'Switch to light mode' : 'Switch to dark mode';
                    btn.setAttribute('title', title);
                    btn.setAttribute('aria-label', title);
                    btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
                });
            },

            syncServer: function(theme) {
                clearTimeout(window.__oddhayThemeServerTimer);
                window.__oddhayThemeServerTimer = setTimeout(function() {
                    fetch('/api/user/theme', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: theme })
                    }).catch(function() {});
                }, 400);
            },

            init: function() {
                const theme = this.getPreference();
                const isDark = theme === 'dark';
                const html = document.documentElement;

                if (isDark) {
                    html.classList.add('dark');
                    html.setAttribute('data-theme', 'dark');
                    html.style.colorScheme = 'dark';
                } else {
                    html.classList.remove('dark');
                    html.setAttribute('data-theme', 'light');
                    html.style.colorScheme = 'light';
                }

                window.toggleTheme = function() {
                    window.OddhayTheme.toggle();
                };
            }
        };

        // Anti-flash initialization (instant synchronous execution)
        window.OddhayTheme.init();

        // Cross-tab synchronization
        window.addEventListener('storage', function(e) {
            if (e.key === window.OddhayTheme.STORAGE_KEY && (e.newValue === 'dark' || e.newValue === 'light')) {
                window.OddhayTheme.setTheme(e.newValue, { skipStorage: true, animated: true });
            }
        });

        // System theme preference listener
        if (window.matchMedia) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
                if (!localStorage.getItem(window.OddhayTheme.STORAGE_KEY)) {
                    window.OddhayTheme.setTheme(e.matches ? 'dark' : 'light', { animated: true });
                }
            });
        }

        // DOM Ready sync
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                window.OddhayTheme.syncButtons();
            });
        } else {
            window.OddhayTheme.syncButtons();
        }
    })();
</script>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
