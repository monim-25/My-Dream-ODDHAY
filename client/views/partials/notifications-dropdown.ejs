<div id="notificationDropdown" class="hidden absolute right-0 top-full mt-2 w-[340px] sm:w-[380px] bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-2xl shadow-slate-900/10 dark:shadow-black/60 z-[100] overflow-hidden transition-all duration-200">
    <!-- Dropdown Header -->
    <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/50">
        <div class="flex items-center gap-2">
            <span class="material-symbols-rounded text-primary text-[18px] leading-none shrink-0">notifications</span>
            <h4 class="text-[13px] font-bold text-slate-800 dark:text-white leading-none">Notifications</h4>
            <span id="dropdownUnreadPill" class="hidden text-[10px] font-bold bg-primary/10 text-primary px-1.5 py-0.5 rounded-full leading-none">0 new</span>
        </div>
        <button type="button" id="markAllReadBtn" onclick="markAllNotificationsRead()" class="text-[11px] font-semibold text-primary hover:text-blue-600 transition-colors cursor-pointer">
            Mark all read
        </button>
    </div>

    <!-- Filter Tabs (All / Unread) -->
    <div class="px-3 pt-2 pb-1 flex items-center gap-1 border-b border-slate-100 dark:border-slate-800/60 bg-white dark:bg-[#0f172a]">
        <button type="button" onclick="setDropdownFilter('all')" id="tabFilterAll" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white transition-colors cursor-pointer">
            All
        </button>
        <button type="button" onclick="setDropdownFilter('unread')" id="tabFilterUnread" class="px-2.5 py-1 text-[11px] font-semibold rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors cursor-pointer">
            Unread
        </button>
    </div>

    <!-- Notifications List -->
    <div id="notificationList" class="max-h-[360px] overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60">
        <!-- Injected via JavaScript -->
        <div id="dropdownLoadingState" class="py-10 text-center text-slate-400">
            <span class="material-symbols-rounded text-2xl animate-spin">progress_activity</span>
            <p class="text-[11px] font-medium mt-1">Loading notifications...</p>
        </div>
    </div>

    <!-- Empty State -->
    <div id="dropdownEmptyState" class="hidden py-10 px-4 text-center">
        <div class="size-11 mx-auto rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-400 flex items-center justify-center mb-2.5">
            <span class="material-symbols-rounded text-2xl leading-none">notifications_off</span>
        </div>
        <p class="text-[12px] font-bold text-slate-700 dark:text-slate-300">No notifications yet</p>
    </div>

    <!-- Dropdown Footer -->
    <div class="px-4 py-2.5 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/50 text-center">
        <a href="/notifications" class="text-[11px] font-bold text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-colors inline-flex items-center gap-1">
            <span>View All Notifications</span>
            <span class="material-symbols-rounded text-[14px] leading-none">arrow_forward</span>
        </a>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
    let cachedNotifications = [];
    let currentFilter = 'all';

    <% 
        const serverUserId = (locals.user && (locals.user._id || locals.user.id)) || '';
        const serverUserName = (locals.user && locals.user.name) || 'Student';
        const serverUserRole = (locals.user && locals.user.role) || 'student';
        const serverClassLevel = (locals.user && locals.user.classLevel) || 'none';
    %>

    window.currentUserId = window.currentUserId || "<%= serverUserId %>";
    window.currentUserName = window.currentUserName || "<%= serverUserName %>";
    window.currentUserRole = window.currentUserRole || "<%= serverUserRole %>";
    window.currentUserClass = window.currentUserClass || "<%= serverClassLevel %>";

    // Type styling configuration
    const TYPE_CONFIG = {
        payment: {
            icon: 'receipt_long',
            bg: 'bg-emerald-500/10 dark:bg-emerald-500/15',
            text: 'text-emerald-600 dark:text-emerald-400'
        },
        course: {
            icon: 'school',
            bg: 'bg-blue-500/10 dark:bg-blue-500/15',
            text: 'text-blue-600 dark:text-blue-400'
        },
        exam: {
            icon: 'quiz',
            bg: 'bg-amber-500/10 dark:bg-amber-500/15',
            text: 'text-amber-600 dark:text-amber-400'
        },
        announcement: {
            icon: 'campaign',
            bg: 'bg-purple-500/10 dark:bg-purple-500/15',
            text: 'text-purple-600 dark:text-purple-400'
        },
        reminder: {
            icon: 'alarm',
            bg: 'bg-rose-500/10 dark:bg-rose-500/15',
            text: 'text-rose-600 dark:text-rose-400'
        },
        message: {
            icon: 'chat',
            bg: 'bg-teal-500/10 dark:bg-teal-500/15',
            text: 'text-teal-600 dark:text-teal-400'
        },
        system: {
            icon: 'notifications',
            bg: 'bg-slate-500/10 dark:bg-slate-500/15',
            text: 'text-slate-600 dark:text-slate-400'
        }
    };

    function formatTimeAgo(dateStr) {
        if (!dateStr) return '';
        const date = new Date(dateStr);
        const now = new Date();
        const seconds = Math.floor((now - date) / 1000);
        if (seconds < 60) return 'Just now';
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours}h ago`;
        const days = Math.floor(hours / 24);
        if (days === 1) return 'Yesterday';
        if (days < 7) return `${days}d ago`;
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function updateBadge(count) {
        const num = parseInt(count, 10) || 0;
        const badgeEl = document.getElementById('notificationBadge');
        const pillEl = document.getElementById('dropdownUnreadPill');
        if (num > 0) {
            if (badgeEl) {
                badgeEl.textContent = num > 9 ? '9+' : String(num);
                badgeEl.classList.remove('hidden');
            }
            if (pillEl) {
                pillEl.textContent = `${num} new`;
                pillEl.classList.remove('hidden');
            }
        } else {
            if (badgeEl) badgeEl.classList.add('hidden');
            if (pillEl) pillEl.classList.add('hidden');
        }
    }
    window.updateNotificationBadge = updateBadge;

    function renderList() {
        const notificationList = document.getElementById('notificationList');
        const emptyState = document.getElementById('dropdownEmptyState');
        const loadingState = document.getElementById('dropdownLoadingState');

        if (loadingState) loadingState.classList.add('hidden');
        if (!notificationList || !emptyState) return;

        const filtered = currentFilter === 'unread'
            ? cachedNotifications.filter(n => !n.isRead)
            : cachedNotifications;

        if (filtered.length === 0) {
            notificationList.innerHTML = '';
            emptyState.classList.remove('hidden');
            return;
        }

        emptyState.classList.add('hidden');
        notificationList.innerHTML = filtered.map(notif => {
            const conf = TYPE_CONFIG[notif.type] || TYPE_CONFIG.system;
            const isUnread = !notif.isRead;
            const unreadClasses = isUnread 
                ? 'bg-blue-50/40 dark:bg-primary/5 hover:bg-blue-50/70 dark:hover:bg-primary/10' 
                : 'bg-transparent hover:bg-slate-50 dark:hover:bg-slate-800/40';

            return `
                <div class="notification-item flex items-start gap-3 p-3 transition-colors cursor-pointer relative ${unreadClasses}"
                     data-id="${notif._id}" data-link="${notif.link || '#'}" onclick="handleNotificationClick('${notif._id}', '${notif.link || '#'}')">
                    <!-- Icon Box -->
                    <div class="size-8.5 rounded-xl ${conf.bg} ${conf.text} flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-rounded text-[17px] leading-none">${conf.icon}</span>
                    </div>

                    <!-- Content -->
                    <div class="flex-1 min-w-0 pr-2">
                        <div class="flex items-baseline justify-between gap-1 mb-0.5">
                            <h5 class="text-[12px] font-bold text-slate-800 dark:text-slate-100 truncate">${escapeHtml(notif.title)}</h5>
                            <span class="text-[10px] font-medium text-slate-400 shrink-0">${formatTimeAgo(notif.createdAt)}</span>
                        </div>
                        <p class="text-[11px] font-normal text-slate-600 dark:text-slate-300 line-clamp-2 leading-snug">${escapeHtml(notif.message)}</p>
                    </div>

                    <!-- Unread Dot -->
                    ${isUnread ? '<span class="size-2 rounded-full bg-primary shrink-0 self-center"></span>' : ''}
                </div>
            `;
        }).join('');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    window.fetchNotifications = async function() {
        try {
            const res = await fetch('/api/notifications/latest');
            const data = await res.json();
            if (data.success) {
                cachedNotifications = data.notifications || [];
                const exactUnread = data.unreadCount !== undefined ? data.unreadCount : cachedNotifications.filter(n => !n.isRead).length;
                updateBadge(exactUnread);
                renderList();

                // If user id returned, ensure socket room is joined on this page
                if (data.userId) {
                    window.currentUserId = String(data.userId);
                    if (window.socket && window.socket.connected) {
                        window.socket.emit('user:join', {
                            userId: window.currentUserId,
                            name: window.currentUserName || 'Student',
                            role: window.currentUserRole || 'student'
                        });
                    }
                }
            }
        } catch (err) {
            console.error('Failed to load notifications:', err);
        }
    };

    window.setDropdownFilter = function(filter) {
        currentFilter = filter;
        const tabAll = document.getElementById('tabFilterAll');
        const tabUnread = document.getElementById('tabFilterUnread');
        if (filter === 'all') {
            if (tabAll) tabAll.className = 'px-2.5 py-1 text-[11px] font-bold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white transition-colors cursor-pointer';
            if (tabUnread) tabUnread.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors cursor-pointer';
        } else {
            if (tabUnread) tabUnread.className = 'px-2.5 py-1 text-[11px] font-bold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white transition-colors cursor-pointer';
            if (tabAll) tabAll.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors cursor-pointer';
        }
        renderList();
    };

    window.toggleNotifications = function(e) {
        if (e && e.stopPropagation) e.stopPropagation();
        const dd = document.getElementById('notificationDropdown');
        if (!dd) return;
        const isHidden = dd.classList.contains('hidden');
        if (isHidden) {
            dd.classList.remove('hidden');
            if (typeof window.fetchNotifications === 'function') window.fetchNotifications();
        } else {
            dd.classList.add('hidden');
        }
    };

    window.handleNotificationClick = async function(id, link) {
        const item = cachedNotifications.find(n => n._id === id);
        if (item && !item.isRead) {
            item.isRead = true;
            renderList();
            try {
                await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
                const countRes = await fetch('/api/notifications/unread-count');
                const countData = await countRes.json();
                if (countData.success) {
                    updateBadge(countData.count);
                }
            } catch (e) {}
        }

        if (link && link !== '#' && link !== '/') {
            window.location.href = link;
        }
    };

    window.markAllNotificationsRead = async function() {
        cachedNotifications.forEach(n => n.isRead = true);
        renderList();
        updateBadge(0);

        try {
            await fetch('/api/notifications/mark-all-read', { method: 'POST' });
            updateBadge(0);
        } catch (err) {
            console.error('Failed to mark all as read:', err);
        }
    };

    // Close on outside click
    window.addEventListener('click', (e) => {
        const dd = document.getElementById('notificationDropdown');
        const btn = document.getElementById('notificationBtn');
        if (dd && !dd.classList.contains('hidden')) {
            if (!dd.contains(e.target) && !btn?.contains(e.target)) {
                dd.classList.add('hidden');
            }
        }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const dd = document.getElementById('notificationDropdown');
            if (dd && !dd.classList.contains('hidden')) {
                dd.classList.add('hidden');
            }
        }
    });

    // Hook socket real-time events for live, instant notification delivery
    function setupSocketListener() {
        if (!window.socket && typeof io === 'function') {
            window.socket = io();
        }
        const socket = window.socket;
        if (!socket) {
            setTimeout(setupSocketListener, 500);
            return;
        }

        function emitJoin() {
            if (!socket || !window.currentUserId) return;
            socket.emit('user:join', {
                userId: window.currentUserId,
                name: window.currentUserName || 'Student',
                role: window.currentUserRole || 'student'
            });
        }

        emitJoin();
        socket.off('connect', emitJoin);
        socket.on('connect', emitJoin);

        function handleIncomingNotification(notif) {
            if (!notif) return;
            const item = {
                _id: notif._id || ('temp_' + Date.now()),
                title: notif.title || 'New Notification',
                message: notif.message || notif.body || '',
                type: notif.type || 'system',
                link: notif.link || notif.url || '/',
                isRead: false,
                createdAt: notif.createdAt || new Date().toISOString()
            };

            // Avoid duplicates
            const existingIdx = cachedNotifications.findIndex(n => n._id === item._id);
            if (existingIdx === -1) {
                cachedNotifications.unshift(item);
                renderList();
            }

            // Immediately refresh exact unread count from server
            fetch('/api/notifications/unread-count')
                .then(r => r.json())
                .then(d => {
                    if (d.success) {
                        updateBadge(d.count);
                    } else {
                        const badgeEl = document.getElementById('notificationBadge');
                        const cur = parseInt(badgeEl?.textContent, 10) || 0;
                        updateBadge(cur + 1);
                    }
                })
                .catch(() => {
                    const badgeEl = document.getElementById('notificationBadge');
                    const cur = parseInt(badgeEl?.textContent, 10) || 0;
                    updateBadge(cur + 1);
                });

            // Dispatch global event for /notifications page
            try {
                window.dispatchEvent(new CustomEvent('oddhay:live-notification', { detail: item }));
            } catch (e) {}

            // Subtle gentle audio chime (optional silent fallback)
            try {
                const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
                audio.volume = 0.3;
                audio.play().catch(() => {});
            } catch (e) {}
        }

        socket.off('notification:new');
        socket.on('notification:new', handleIncomingNotification);

        socket.off('new_notice');
        socket.on('new_notice', (data) => {
            let shouldShow = false;
            const role = window.currentUserRole || 'student';
            const classLevel = window.currentUserClass || 'none';
            const myId = window.currentUserId;

            if (data.target === 'all') shouldShow = true;
            else if (data.target === 'role' && data.role === role) shouldShow = true;
            else if (data.target === 'class' && data.classLevel === classLevel && role === 'student') shouldShow = true;
            else if (data.target === 'user' && data.userId === myId) shouldShow = true;

            if (shouldShow) {
                handleIncomingNotification({
                    _id: data._id || ('notice_' + Date.now()),
                    title: data.title,
                    message: data.body || data.message,
                    type: data.type || 'announcement',
                    link: data.url || data.link || '/notifications',
                    createdAt: new Date().toISOString()
                });
            }
        });
    }

    // Periodic heartbeat sync every 30 seconds
    setInterval(() => {
        fetch('/api/notifications/unread-count')
            .then(r => r.json())
            .then(d => { if (d.success) updateBadge(d.count); })
            .catch(() => {});
    }, 30000);

    // Initial load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            window.fetchNotifications();
            setupSocketListener();
        });
    } else {
        window.fetchNotifications();
        setupSocketListener();
    }
})();
</script>
