<script>
    function toggleSidebar() {
        const panel = document.getElementById('sidebar-panel');
        const overlay = document.querySelector('.sidebar-overlay');
        panel.classList.toggle('active');
        overlay.classList.toggle('active');
    }

    function toggleNotifications(e) {
        if (e && e.stopPropagation) e.stopPropagation();
        if (typeof window.toggleNotifications === 'function' && window.toggleNotifications !== toggleNotifications) {
            return window.toggleNotifications(e);
        }
        const dropdown = document.getElementById('notificationDropdown');
        if (dropdown) {
            const isHidden = dropdown.classList.contains('hidden');
            if (isHidden) {
                dropdown.classList.remove('hidden');
                if (typeof window.fetchNotifications === 'function') window.fetchNotifications();
            } else {
                dropdown.classList.add('hidden');
            }
            return;
        }
        const panel = document.getElementById('notif-panel');
        const overlay = document.getElementById('notif-overlay');
        if (panel) panel.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
        if (panel && !panel.classList.contains('active')) {
            updateUnreadCount();
        }
    }

    function toggleTheme() {
        if (window.OddhayTheme) {
            window.OddhayTheme.toggle();
        } else if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        }
    }

    async function updateUnreadCount() {
        try {
            const res = await fetch('/api/notifications/unread-count');
            const data = await res.json();
            if (data && data.success) {
                const count = parseInt(data.count, 10) || 0;
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    if (count > 0) {
                        badge.textContent = count > 9 ? '9+' : String(count);
                        badge.classList.remove('hidden');
                    } else {
                        badge.textContent = '0';
                        badge.classList.add('hidden');
                    }
                }
                const dot = document.getElementById('notif-dot');
                if (dot) {
                    if (count > 0) dot.classList.remove('hidden');
                    else dot.classList.add('hidden');
                }
            }
        } catch (e) {
            console.error('Unread count error:', e);
        }
    }

    async function handleNotifClick(notifId, link) {
        try {
            await fetch(`/api/notifications/${notifId}/read`, {
                method: 'POST'
            });
            window.location.href = link;
        } catch (e) {
            window.location.href = link;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateUnreadCount();
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }

        // --- Scroll Reveal Logic ---
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
</script>

