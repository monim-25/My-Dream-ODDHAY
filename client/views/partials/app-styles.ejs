<style>
    * {
        font-style: normal !important;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Hind Siliguri', 'Outfit', sans-serif;
        overflow-y: auto;
        height: 100vh;
        height: 100dvh;
        background: #F8FAFC;
    }

    .dark body {
        background: #020617;
    }

    .app-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .app-header {
        height: 72px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 150;
        padding: 0 2rem;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .dark .app-header {
        background: rgba(2, 6, 23, 0.9);
        border-color: rgba(255, 255, 255, 0.05);
    }

    .main-wrapper {
        display: flex;
        flex: 1;
        overflow: hidden;
        position: relative;
    }

    .sidebar-panel {
        width: 280px;
        height: 100%;
        border-right: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        background: #fff;
        z-index: 200;
        transition: transform 0.3s ease;
    }

    .dark .sidebar-panel {
        background: #0F172A;
        border-color: rgba(255, 255, 255, 0.05);
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 0 0.75rem;
    }

    .content-panel {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        scroll-behavior: smooth;
        background: #F8FAFC;
    }

    .dark .content-panel {
        background: #020617;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 1rem;
        font-weight: 700;
        font-size: 14px;
        transition: all 0.3s ease;
        color: #64748b;
        margin-bottom: 2px;
    }

    .nav-item:hover {
        background: #F1F5F9;
        color: #137fec;
    }

    .dark .nav-item:hover {
        background: #1E293B;
        color: #60a5fa;
    }

    .nav-active {
        background: #EFF6FF;
        color: #137fec;
    }

    .dark .nav-active {
        background: rgba(19, 127, 236, 0.1);
        color: #60a5fa;
    }

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.3);
        backdrop-filter: blur(4px);
        z-index: 190;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .sidebar-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .notif-overlay {
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.3);
        backdrop-filter: blur(4px);
        z-index: 450;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .notif-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    #notif-panel {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 350px;
        background: #fff;
        z-index: 500;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
    }

    .dark #notif-panel {
        background: #0f172a;
        border-left: 1px solid rgba(255, 255, 255, 0.05);
    }

    #notif-panel.active {
        transform: translateX(0);
    }

    @media (max-width: 1024px) {
        .sidebar-panel {
            position: fixed;
            top: 0;
            left: 0;
            height: 100dvh;
            transform: translateX(-100%);
            width: 280px;
            z-index: 300;
        }

        .sidebar-panel.active {
            transform: translateX(0);
        }

        .sidebar-overlay.active {
            display: block;
        }

        .app-header {
            padding: 0 1rem;
            height: 60px;
        }

        .content-panel {
            padding: 1.25rem;
            padding-bottom: 110px;
        }
    }

    /* --- Loading Overlay & Skeletons --- */
    #loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #F8FAFC;
        display: flex;
        flex-direction: column;
        padding: 4rem 2rem;
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .dark #loading-overlay {
        background: #020617;
    }

    #loading-overlay.loading-hidden {
        opacity: 0;
        visibility: hidden;
    }

    .skeleton {
        background: #e2e8f0;
        background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 0.75rem;
    }

    .dark .skeleton {
        background: #1e293b;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
    }

    @keyframes skeleton-loading {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    /* --- Visibility Fallback --- */
    .reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: opacity 0.5s ease, transform 0.5s ease !important;
        border: 1px solid red !important;
        /* DEBUG BORDER */
    }

    html,
    body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .app-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
</style>