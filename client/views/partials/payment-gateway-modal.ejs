<!-- DIRECT PAYMENT GATEWAY MODAL (bKash & Nagad Tokenized Checkout) -->
<div id="pgwModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 bg-slate-900/70 backdrop-blur-sm hidden transition-opacity duration-300">
    <div class="w-full max-w-sm rounded-2xl overflow-hidden shadow-2xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0" id="pgwCard">
        
        <!-- Gateway Header: Minimal, Clean, Direct -->
        <div id="pgwHeader" class="px-5 py-3.5 text-white flex items-center justify-between transition-colors bg-[#e2136e]">
            <div class="flex items-center gap-2 min-w-0">
                <span class="material-symbols-rounded text-lg text-white leading-none shrink-0 flex items-center justify-center">lock</span>
                <h3 id="pgwBrandTitle" class="text-sm font-bold tracking-tight text-white leading-none truncate">
                    bKash Payment
                </h3>
            </div>
            
            <div class="flex items-center gap-2 shrink-0">
                <span id="pgwAmountHeader" class="px-2.5 py-1 rounded-full bg-white/20 text-xs font-black text-white tracking-wide leading-none flex items-center justify-center">
                    ৳0
                </span>
                <button type="button" onclick="closePgwModal()" class="size-6 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center text-white transition-colors cursor-pointer" title="Close">
                    <span class="material-symbols-rounded text-sm leading-none shrink-0 flex items-center justify-center">close</span>
                </button>
            </div>
        </div>

        <!-- Gateway Content Body -->
        <div class="p-4 sm:p-5 space-y-3.5">
            
            <!-- Global Error Banner in Modal -->
            <div id="pgwError" class="p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 flex items-center gap-2 text-rose-700 dark:text-rose-300 text-xs hidden">
                <span class="material-symbols-rounded text-base shrink-0 leading-none flex items-center justify-center">error</span>
                <p id="pgwErrorMsg" class="font-medium text-[11px]"></p>
            </div>

            <!-- SCREEN 1: Enter Phone Number -->
            <div id="pgwScreenPhone" class="space-y-3.5">
                <div class="space-y-1.5">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Enter <span id="pgwMethodName1">bKash</span> Account Number
                    </label>
                    <div class="flex items-center rounded-xl bg-slate-100 dark:bg-slate-800/80 focus-within:ring-2 focus-within:ring-emerald-500/40 overflow-hidden transition-all h-12">
                        <span class="px-3.5 text-xs font-bold text-slate-400 font-mono bg-slate-200/50 dark:bg-slate-700/50 h-full flex items-center justify-center select-none shrink-0">
                            +88
                        </span>
                        <input type="tel" id="pgwPhoneInput" placeholder="01XXXXXXXXX" pattern="01[3-9][0-9]{8}" maxlength="11"
                            class="flex-1 h-full px-3.5 text-sm font-semibold font-mono text-slate-900 dark:text-white bg-transparent focus:outline-none border-none">
                    </div>
                </div>

                <button type="button" onclick="handlePgwPhoneSubmit()" id="pgwPhoneBtn"
                    class="w-full h-12.5 sm:h-13 rounded-xl text-white font-bold text-sm tracking-wide flex items-center justify-center gap-2 shadow-md shadow-pink-600/20 hover:shadow-lg hover:shadow-pink-600/30 transition-all duration-200 active:scale-[0.98] cursor-pointer bg-[#e2136e] hover:brightness-105">
                    <span id="pgwPhoneBtnText">Proceed</span>
                    <span class="material-symbols-rounded text-lg leading-none shrink-0 flex items-center justify-center">arrow_forward</span>
                </button>
            </div>

            <!-- SCREEN 2: Enter Verification Code (OTP) -->
            <div id="pgwScreenOtp" class="space-y-3.5 hidden">
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                            Enter Verification Code (OTP)
                        </label>
                        <span id="pgwTestOtpBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 hidden">
                            Test: 123456
                        </span>
                    </div>
                    <input type="text" id="pgwOtpInput" placeholder="123456" maxlength="6"
                        class="w-full h-12 px-3.5 text-center tracking-[0.6em] text-lg font-bold font-mono rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 border-none transition-all">
                </div>

                <div class="flex items-center justify-between text-[11px] pt-0.5">
                    <button type="button" onclick="resendPgwOtp()" id="pgwResendBtn" class="font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer">
                        Resend Code
                    </button>
                    <button type="button" onclick="changePgwPhone()" class="font-semibold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer">
                        Change Number
                    </button>
                </div>

                <button type="button" onclick="handlePgwOtpSubmit()" id="pgwOtpBtn"
                    class="w-full h-12.5 sm:h-13 rounded-xl text-white font-bold text-sm tracking-wide flex items-center justify-center gap-2 shadow-md shadow-pink-600/20 hover:shadow-lg hover:shadow-pink-600/30 transition-all duration-200 active:scale-[0.98] cursor-pointer bg-[#e2136e] hover:brightness-105">
                    <span id="pgwOtpBtnText">Verify Code</span>
                    <span class="material-symbols-rounded text-lg leading-none shrink-0 flex items-center justify-center">check</span>
                </button>
            </div>

            <!-- SCREEN 3: Enter PIN -->
            <div id="pgwScreenPin" class="space-y-3.5 hidden">
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                            Enter <span id="pgwMethodName2">bKash</span> PIN
                        </label>
                        <span id="pgwTestPinBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 hidden">
                            Test: 12121
                        </span>
                    </div>
                    <div class="relative flex items-center rounded-xl bg-slate-100 dark:bg-slate-800/80 focus-within:ring-2 focus-within:ring-emerald-500/40 overflow-hidden transition-all h-12">
                        <input type="password" id="pgwPinInput" placeholder="•••••" maxlength="5"
                            class="flex-1 h-full px-3.5 text-center tracking-[0.6em] text-lg font-bold font-mono text-slate-900 dark:text-white bg-transparent focus:outline-none border-none">
                        <button type="button" onclick="togglePgwPinVisibility()" class="pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center shrink-0">
                            <span id="pgwPinEyeIcon" class="material-symbols-rounded text-base leading-none shrink-0 flex items-center justify-center">visibility</span>
                        </button>
                    </div>
                </div>

                <button type="button" onclick="handlePgwPinSubmit()" id="pgwPinBtn"
                    class="w-full h-12.5 sm:h-13 rounded-xl text-white font-bold text-sm tracking-wide flex items-center justify-center gap-2 shadow-md shadow-pink-600/20 hover:shadow-lg hover:shadow-pink-600/30 transition-all duration-200 active:scale-[0.98] cursor-pointer bg-[#e2136e] hover:brightness-105">
                    <span class="material-symbols-rounded text-lg leading-none shrink-0 flex items-center justify-center">lock</span>
                    <span id="pgwPinBtnText">Confirm Payment</span>
                </button>
            </div>

            <!-- SCREEN 4: Payment Success Celebration -->
            <div id="pgwScreenSuccess" class="py-5 text-center space-y-2.5 hidden">
                <div class="size-14 rounded-full bg-emerald-100 dark:bg-emerald-950/60 border-2 border-emerald-500 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center animate-bounce">
                    <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center">check_circle</span>
                </div>
                <div class="space-y-0.5">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">
                        Payment Successful!
                    </h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Transaction ID: <span id="pgwSuccessTrx" class="font-mono font-bold text-slate-900 dark:text-white"></span>
                    </p>
                </div>
                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">
                    Redirecting to your course...
                </p>
            </div>

        </div>

    </div>
</div>

<script>
    let pgwState = {
        paymentID: null,
        amount: 0,
        method: 'bkash',
        phoneNumber: '',
        mode: 'sandbox',
        redirectUrl: ''
    };

    const pgwTheme = {
        bkash: { color: '#e2136e', name: 'bKash' },
        nagad: { color: '#f7931e', name: 'Nagad' },
        rocket: { color: '#8c3494', name: 'Rocket' }
    };

    function applyPgwBrandTheme(method) {
        const theme = pgwTheme[method] || pgwTheme.bkash;
        const header = document.getElementById('pgwHeader');
        const phoneBtn = document.getElementById('pgwPhoneBtn');
        const otpBtn = document.getElementById('pgwOtpBtn');
        const pinBtn = document.getElementById('pgwPinBtn');
        const brandTitle = document.getElementById('pgwBrandTitle');
        const methodName1 = document.getElementById('pgwMethodName1');
        const methodName2 = document.getElementById('pgwMethodName2');

        if (header) header.style.backgroundColor = theme.color;
        if (phoneBtn) phoneBtn.style.backgroundColor = theme.color;
        if (otpBtn) otpBtn.style.backgroundColor = theme.color;
        if (pinBtn) pinBtn.style.backgroundColor = theme.color;

        if (brandTitle) brandTitle.innerText = `${theme.name} Payment`;
        if (methodName1) methodName1.innerText = theme.name;
        if (methodName2) methodName2.innerText = theme.name;
    }

    function showPgwError(msg) {
        const errorEl = document.getElementById('pgwError');
        const msgEl = document.getElementById('pgwErrorMsg');
        if (errorEl && msgEl) {
            msgEl.innerText = msg;
            errorEl.classList.remove('hidden');
        }
    }

    function clearPgwError() {
        const errorEl = document.getElementById('pgwError');
        if (errorEl) errorEl.classList.add('hidden');
    }

    async function openPgwModal(initPayload) {
        clearPgwError();
        const modal = document.getElementById('pgwModal');
        const card = document.getElementById('pgwCard');
        if (!modal || !card) return;

        // Immediately set initial amount if passed so ৳0 is never shown
        if (initPayload && initPayload.amount) {
            const initialAmt = Number(initPayload.amount) || 0;
            pgwState.amount = initialAmt;
            document.getElementById('pgwAmountHeader').innerText = `৳${initialAmt.toLocaleString()}`;
            const pinBtnText = document.getElementById('pgwPinBtnText');
            if (pinBtnText) pinBtnText.innerText = `Confirm Payment • ৳${initialAmt.toLocaleString()}`;
        }

        if (initPayload && initPayload.paymentMethod) {
            pgwState.method = initPayload.paymentMethod;
            applyPgwBrandTheme(pgwState.method);
        }

        // Reset screens
        document.getElementById('pgwScreenPhone').classList.remove('hidden');
        document.getElementById('pgwScreenOtp').classList.add('hidden');
        document.getElementById('pgwScreenPin').classList.add('hidden');
        document.getElementById('pgwScreenSuccess').classList.add('hidden');

        // Open modal with smooth transition immediately
        modal.classList.remove('hidden');
        setTimeout(() => {
            card.classList.remove('scale-95', 'opacity-0');
            card.classList.add('scale-100', 'opacity-100');
            const phoneInput = document.getElementById('pgwPhoneInput');
            if (phoneInput) phoneInput.focus();
        }, 10);

        // Create session on server
        try {
            const res = await fetch('/payment/gateway/create-session', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(initPayload)
            });

            if (res.status === 401) {
                alert('Please log in to continue.');
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }

            const data = await res.json();

            if (!data.success) {
                showPgwError(data.error || 'Failed to initialize payment session.');
                return;
            }

            pgwState.paymentID = data.paymentID;
            pgwState.amount = data.amount || pgwState.amount;
            pgwState.method = data.method || pgwState.method;
            pgwState.mode = data.mode || 'sandbox';

            applyPgwBrandTheme(pgwState.method);

            document.getElementById('pgwAmountHeader').innerText = `৳${pgwState.amount.toLocaleString()}`;
            const pinBtnText = document.getElementById('pgwPinBtnText');
            if (pinBtnText) pinBtnText.innerText = `Confirm Payment • ৳${pgwState.amount.toLocaleString()}`;

            // Show test badges if in sandbox mode
            const testOtpBadge = document.getElementById('pgwTestOtpBadge');
            const testPinBadge = document.getElementById('pgwTestPinBadge');
            if (data.mode === 'sandbox') {
                if (testOtpBadge) testOtpBadge.classList.remove('hidden');
                if (testPinBadge) testPinBadge.classList.remove('hidden');
            } else {
                if (testOtpBadge) testOtpBadge.classList.add('hidden');
                if (testPinBadge) testPinBadge.classList.add('hidden');
            }
        } catch (err) {
            console.error('Failed to create payment session:', err);
            showPgwError('Error initializing payment session. Please try again.');
        }
    }

    function closePgwModal() {
        const modal = document.getElementById('pgwModal');
        const card = document.getElementById('pgwCard');
        if (!modal || !card) return;

        card.classList.remove('scale-100', 'opacity-100');
        card.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    async function handlePgwPhoneSubmit() {
        clearPgwError();
        const phone = (document.getElementById('pgwPhoneInput')?.value || '').trim();

        if (!/^01[3-9]\d{8}$/.test(phone)) {
            showPgwError('Please enter a valid 11-digit Bangladeshi mobile number.');
            return;
        }

        pgwState.phoneNumber = phone;
        const btn = document.getElementById('pgwPhoneBtn');
        const btnText = document.getElementById('pgwPhoneBtnText');
        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-75');
            if (btnText) btnText.innerText = 'Sending OTP...';
        }

        try {
            const res = await fetch('/payment/gateway/send-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    paymentID: pgwState.paymentID,
                    phoneNumber: phone
                })
            });
            const data = await res.json();

            if (data.success) {
                document.getElementById('pgwScreenPhone').classList.add('hidden');
                document.getElementById('pgwScreenOtp').classList.remove('hidden');
                const otpInput = document.getElementById('pgwOtpInput');
                if (otpInput) {
                    otpInput.value = data.demoOtp || '';
                    otpInput.focus();
                }
            } else {
                showPgwError(data.error || 'Failed to send verification code.');
            }
        } catch (err) {
            showPgwError('Network error while requesting OTP.');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                if (btnText) btnText.innerText = 'Proceed';
            }
        }
    }

    async function handlePgwOtpSubmit() {
        clearPgwError();
        const otp = (document.getElementById('pgwOtpInput')?.value || '').trim();

        if (otp.length < 6) {
            showPgwError('Please enter the 6-digit verification code.');
            return;
        }

        const btn = document.getElementById('pgwOtpBtn');
        const btnText = document.getElementById('pgwOtpBtnText');
        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-75');
            if (btnText) btnText.innerText = 'Verifying...';
        }

        try {
            const res = await fetch('/payment/gateway/verify-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    paymentID: pgwState.paymentID,
                    otp: otp
                })
            });
            const data = await res.json();

            if (data.success) {
                document.getElementById('pgwScreenOtp').classList.add('hidden');
                document.getElementById('pgwScreenPin').classList.remove('hidden');
                const pinInput = document.getElementById('pgwPinInput');
                if (pinInput) {
                    if (pgwState.mode === 'sandbox') pinInput.value = '12121';
                    pinInput.focus();
                }
            } else {
                showPgwError(data.error || 'Invalid verification code.');
            }
        } catch (err) {
            showPgwError('Network error while verifying OTP.');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                if (btnText) btnText.innerText = 'Verify Code';
            }
        }
    }

    async function handlePgwPinSubmit() {
        clearPgwError();
        const pin = (document.getElementById('pgwPinInput')?.value || '').trim();

        if (pin.length < 4) {
            showPgwError('Please enter your account PIN (4-5 digits).');
            return;
        }

        const btn = document.getElementById('pgwPinBtn');
        const btnText = document.getElementById('pgwPinBtnText');
        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-75');
            if (btnText) btnText.innerText = 'Authorizing...';
        }

        try {
            const res = await fetch('/payment/gateway/execute', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    paymentID: pgwState.paymentID,
                    pin: pin
                })
            });
            const data = await res.json();

            if (data.success) {
                document.getElementById('pgwSuccessTrx').innerText = data.transactionId;
                document.getElementById('pgwScreenPin').classList.add('hidden');
                document.getElementById('pgwScreenSuccess').classList.remove('hidden');

                // Redirect smoothly to unlocked course after 1.5 seconds
                setTimeout(() => {
                    window.location.href = data.redirectUrl || '/my-courses';
                }, 1500);
            } else {
                showPgwError(data.error || 'Payment execution failed. Please check your PIN.');
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-75');
                    if (btnText) btnText.innerText = `Confirm Payment • ৳${pgwState.amount.toLocaleString()}`;
                }
            }
        } catch (err) {
            showPgwError('Network error during payment execution.');
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                if (btnText) btnText.innerText = `Confirm Payment • ৳${pgwState.amount.toLocaleString()}`;
            }
        }
    }

    function changePgwPhone() {
        clearPgwError();
        document.getElementById('pgwScreenOtp').classList.add('hidden');
        document.getElementById('pgwScreenPhone').classList.remove('hidden');
        const phoneInput = document.getElementById('pgwPhoneInput');
        if (phoneInput) phoneInput.focus();
    }

    function resendPgwOtp() {
        handlePgwPhoneSubmit();
    }

    function togglePgwPinVisibility() {
        const pinInput = document.getElementById('pgwPinInput');
        const icon = document.getElementById('pgwPinEyeIcon');
        if (!pinInput || !icon) return;

        if (pinInput.type === 'password') {
            pinInput.type = 'text';
            icon.innerText = 'visibility_off';
        } else {
            pinInput.type = 'password';
            icon.innerText = 'visibility';
        }
    }
</script>
