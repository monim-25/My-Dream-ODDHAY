        const options = document.querySelectorAll('.lib-sub-option');
        options.forEach(opt => {
            const optSub = opt.getAttribute('data-subject');
            const chk = opt.querySelector('.checkmark-icon');
            if (optSub === subject) {
                opt.className = 'lib-sub-option w-full px-2.5 py-1.5 rounded-lg text-left text-xs font-semibold text-primary bg-primary/10 flex items-center justify-between transition-colors';
                if (chk) chk.classList.remove('hidden');
