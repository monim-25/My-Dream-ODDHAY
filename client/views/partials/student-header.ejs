                if (librarySearchBox) librarySearchBox.classList.remove('hidden');
                if (coursesSubjectBox) coursesSubjectBox.classList.add('hidden');
                if (coursesSearchBox) coursesSearchBox.classList.add('hidden');
            } else if (isCoursesPage) {
                headerTools.classList.remove('hidden');
                headerTools.classList.add('flex');
                if (qaSubjectBox) qaSubjectBox.classList.add('hidden');
                if (qaSearchBox) qaSearchBox.classList.add('hidden');
                if (qbSearchBox) qbSearchBox.classList.add('hidden');
                if (notesSearchBox) notesSearchBox.classList.add('hidden');
                if (historySearchBox) historySearchBox.classList.add('hidden');
                if (mockSubjectBox) mockSubjectBox.classList.add('hidden');
                if (mockSearchBox) mockSearchBox.classList.add('hidden');
                if (modelSubjectBox) modelSubjectBox.classList.add('hidden');
