<script>
    function toggleMobileSidebar() {
        const backdrop = document.getElementById('mobileSidebarBackdrop');
        const drawer = document.getElementById('mobileSidebarDrawer');
        if (!backdrop || !drawer) return;
        
        if (drawer.classList.contains('-translate-x-full')) {
            backdrop.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                drawer.classList.remove('-translate-x-full');
            }, 10);
        } else {
            backdrop.classList.add('opacity-0');
            drawer.classList.add('-translate-x-full');
            setTimeout(() => {
                backdrop.classList.add('hidden');
            }, 300);
        }
    }

    // Handle Form Submit In-Place (No Page Redirect)
    function handleHeaderSearchSubmit(event) {
        event.preventDefault();
        const searchInput = document.getElementById('studentSearchInput');
        if (searchInput && searchInput.value.trim()) {
            searchInput.dispatchEvent(new Event('input'));
        }
    }

    // Live Instant Search Logic
    (function initLiveStudentSearch() {
        const searchInput = document.getElementById('studentSearchInput');
        const searchDropdown = document.getElementById('studentSearchDropdown');
        const searchResults = document.getElementById('studentSearchResults');
        let debounceTimer;

        if (!searchInput || !searchDropdown || !searchResults) return;

        searchInput.addEventListener('focus', function() {
            if (this.value.trim().length >= 1) {
                this.dispatchEvent(new Event('input'));
            }
        });

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            const query = this.value.trim();

            if (!query) {
                searchDropdown.classList.add('hidden');
                return;
            }

            searchResults.innerHTML = `
                <div class="p-4 text-center text-xs font-bold text-slate-400 flex items-center justify-center gap-2">
                    <span class="material-symbols-rounded text-base animate-spin text-primary">sync</span> Searching resources...
                </div>
            `;
            searchDropdown.classList.remove('hidden');

            debounceTimer = setTimeout(() => {
                fetch('/api/search?q=' + encodeURIComponent(query))
                    .then(res => res.json())
                    .then(data => {
                        renderLiveResults(data, query);
                    })
                    .catch(err => {
                        searchResults.innerHTML = `<div class="p-3 text-center text-xs font-bold text-rose-500">Search error</div>`;
                    });
            }, 180);
        });

        function renderLiveResults(data, query) {
            const hasCourses = data.courses && data.courses.length > 0;
            const hasNotes = data.notes && data.notes.length > 0;
            const hasVideos = data.videos && data.videos.length > 0;
            const hasBooks = data.books && data.books.length > 0;
            const hasQuestionBanks = data.questionBanks && data.questionBanks.length > 0;
            const hasQuizzes = data.quizzes && data.quizzes.length > 0;
            const hasQA = data.qa && data.qa.length > 0;

            if (!hasCourses && !hasNotes && !hasVideos && !hasBooks && !hasQuestionBanks && !hasQuizzes && !hasQA) {
                searchResults.innerHTML = `
                    <div class="p-4 text-center text-xs font-bold text-slate-400">
                        No resources found matching "${query}"
                    </div>
                `;
                return;
            }

            let html = '';

            if (hasCourses) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-1 pb-0.5">Courses (${data.courses.length})</div>`;
                data.courses.forEach(c => {
                    html += `
                        <a href="/courses" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">auto_stories</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${c.title}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${c.subject || 'General'} ${c.classLevel ? '• ' + c.classLevel : ''}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasNotes) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Notes (${data.notes.length})</div>`;
                data.notes.forEach(n => {
                    html += `
                        <a href="/note/${n._id}" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-blue-50 dark:bg-slate-800 text-blue-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">description</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${n.title}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${n.subject || 'Note'} ${n.classLevel ? '• ' + n.classLevel : ''}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasVideos) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Video Lessons (${data.videos.length})</div>`;
                data.videos.forEach(v => {
                    html += `
                        <a href="/courses" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-rose-50 dark:bg-slate-800 text-rose-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">play_circle</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${v.title}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${v.subject || 'Video'} ${v.classLevel ? '• ' + v.classLevel : ''}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasQuizzes) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Exams & Quizzes (${data.quizzes.length})</div>`;
                data.quizzes.forEach(q => {
                    html += `
                        <a href="/exams" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-amber-50 dark:bg-slate-800 text-amber-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">psychology</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${q.title}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${q.subject || 'Quiz'} ${q.classLevel ? '• ' + q.classLevel : ''}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasQuestionBanks) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Question Bank (${data.questionBanks.length})</div>`;
                data.questionBanks.forEach(q => {
                    html += `
                        <a href="/question-bank" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-purple-50 dark:bg-slate-800 text-purple-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">archive</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${q.subject} (${q.board || ''} ${q.year || ''})</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${q.classLevel || 'Paper'}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasBooks) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Library (${data.books.length})</div>`;
                data.books.forEach(b => {
                    html += `
                        <a href="/library" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-emerald-50 dark:bg-slate-800 text-emerald-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">local_library</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${b.title}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">${b.category || 'Book'}</p>
                            </div>
                        </a>
                    `;
                });
            }

            if (hasQA) {
                html += `<div class="text-[9px] font-bold uppercase text-primary tracking-wider px-2 pt-2 pb-0.5">Q&A Forum (${data.qa.length})</div>`;
                data.qa.forEach(q => {
                    html += `
                        <a href="/qa-forum" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                            <div class="size-7 rounded bg-rose-50 dark:bg-slate-800 text-rose-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm">forum</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary">${q.question}</p>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase">By ${q.askedByName || 'Member'}</p>
                            </div>
                        </a>
                    `;
                });
            }

            searchResults.innerHTML = html;
        }

        // Close on click outside
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                searchDropdown.classList.add('hidden');
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                searchDropdown.classList.add('hidden');
            }
        });
    })();

    // Dynamic Page Title Controller (Guarantees exact title matching the current page URL)
    (function() {
        const titleElem = document.getElementById('headerPageTitle');
        if (!titleElem) return;
        if (titleElem.getAttribute('data-custom-title') === 'true') return;

        const path = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/dashboard';
        const pathToTitle = {
            '': 'Dashboard',
            '/dashboard': 'Dashboard',
            '/student': 'Oddhay AI',
            '/ai': 'Oddhay AI',
            '/courses': 'Courses',
            '/my-courses': 'My Courses',
            '/messages': 'Messages',
            '/library': 'Library',
            '/exams': 'Exams & Quizzes',
            '/routine': 'Routine & Plan',
            '/notes': 'Notes',
            '/question-bank': 'Question Bank',
            '/questions': 'Question Bank',
            '/qa-forum': 'Q&A Community',
            '/qa': 'Q&A Community',
            '/report-card': 'Progress Report',
            '/analytics': 'Progress Report',
            '/progress': 'Progress Report',
            '/progress-report': 'Progress Report',
            '/my-payments': 'Payment History',
            '/payments': 'Payment History',
            '/payment/history': 'Payment History',
            '/profile': 'My Profile',
            '/profile/edit': 'Edit Profile',
            '/profile/security': 'Security Settings',
            '/security': 'Security Settings',
            '/leaderboard': 'Leaderboard',
            '/subject-tests': 'Subject Tests',
            '/exams/subject-tests': 'Subject Tests',
            '/mock-tests': 'Mock Test',
            '/exams/mock-tests': 'Mock Test',
            '/model-tests': 'Model Test',
            '/exams/model-tests': 'Model Test',
            '/custom-test': 'Custom Quiz',
            '/exams/custom-test': 'Custom Quiz',
            '/exams/custom-start': 'Custom Quiz',
            '/exams/written-results': 'Written Results',
            '/exams/history': 'Exam History',
            '/exam/history': 'Exam History',
            '/notices': 'Notices & Updates'
        };

        const urlParams = new URLSearchParams(window.location.search);
        const subParam = urlParams.get('subject');

        if (path === '/exams/subject-tests' || path === '/subject-tests') {
            if (subParam && subParam !== 'all') {
                titleElem.textContent = `Subject Tests / ${decodeURIComponent(subParam)}`;
            } else {
                titleElem.textContent = 'Subject Tests';
            }
        } else if (pathToTitle[path]) {
            titleElem.textContent = pathToTitle[path];
        } else {
            const currentTxt = titleElem.textContent ? titleElem.textContent.trim() : '';
            if (path.includes('/exams/written-results')) {
                titleElem.textContent = 'Written Results';
            } else if (path.includes('/exams/subject-tests') || path.includes('/subject-tests')) {
                if (subParam && subParam !== 'all') {
                    titleElem.textContent = `Subject Tests / ${decodeURIComponent(subParam)}`;
                } else {
                    titleElem.textContent = 'Subject Tests';
                }
            } else if (path.includes('/exams/model-tests') || path.includes('/model-tests')) {
                titleElem.textContent = 'Model Test';
            } else if (path.includes('/exams/mock-tests') || path.includes('/mock-tests')) {
                titleElem.textContent = 'Mock Test';
            } else if (path.includes('/exams/history') || path.includes('/exam/history')) {
                titleElem.textContent = 'Exam History';
            } else if (path.includes('/exams/custom-test') || path.includes('/custom-test')) {
                titleElem.textContent = 'Custom Quiz';
            } else if (path.includes('/question-bank/view/') || path.includes('/question-bank/solve/') || path.includes('/question-bank/result/') || path.includes('/question-bank/review/') || path.includes('/question-bank/written')) {
                if (!currentTxt || currentTxt === 'Dashboard') {
                    titleElem.textContent = 'Question Bank Result';
                }
            } else if (!currentTxt || currentTxt === 'Dashboard') {
                if (path.includes('/course/')) {
                    titleElem.textContent = 'Course Details';
                } else if (path.includes('/note/')) {
                    titleElem.textContent = 'Note Viewer';
                } else if (path.includes('/exam/')) {
                    titleElem.textContent = 'Exam & Quiz';
                } else if (path.includes('/notice/')) {
                    titleElem.textContent = 'Notice Details';
                }
            }
        }
    })();

    // =========================================================================
    // UNIFIED STUDENT PORTAL NAVIGATION ENGINE (Loop-Free & Context-Aware)
    // =========================================================================
    (function() {
        const STACK_KEY = 'oddhay_student_nav_stack_v3';
        const IS_BACK_KEY = 'oddhay_nav_going_back';

        // Root sidebar pages where the arrow_back button is hidden
        const mainSidebarPages = [
            '/',
            '/dashboard',
            '/dashboard/',
            '/courses',
            '/courses/',
            '/messages',
            '/messages/',
            '/library',
            '/library/',
            '/student',
            '/student/',
            '/student-ai',
            '/student-ai/',
            '/ai',
            '/ai/',
            '/exams',
            '/exams/',
            '/routine',
            '/routine/',
            '/notes',
            '/notes/',
            '/question-bank',
            '/question-bank/',
            '/questions',
            '/questions/',
            '/qa-forum',
            '/qa-forum/',
            '/qa',
            '/qa/',
            '/report-card',
            '/report-card/',
            '/analytics',
            '/analytics/',
            '/progress',
            '/progress/',
            '/progress-report',
            '/progress-report/',
            '/my-payments',
            '/my-payments/',
            '/payments',
            '/payments/',
            '/payment/history',
            '/payment/history/',
            '/profile',
            '/profile/',
            '/leaderboard',
            '/leaderboard/'
        ];

        // Map subpage to deterministic fallback parent if no history exists
        function getLogicalParentUrl(pathname) {
            const path = (pathname || window.location.pathname).toLowerCase().replace(/\/+$/, '') || '/';

            // Written Evaluation -> Written Results
            if (path.includes('/question-bank/written-evaluation') || path.includes('/written-evaluation')) {
                return '/exams/written-results';
            }

            // Question Bank / Exam solve & result subpages -> Exams & Quizzes
            if (path.startsWith('/question-bank/result') || path.startsWith('/question-bank/review') || path.startsWith('/question-bank/solve')) {
                return '/exams';
            }
            if (path.startsWith('/question-bank/') && path !== '/question-bank') {
                return '/question-bank';
            }

            // Exam subpages -> Exams
            if (
                path.startsWith('/exams/written-results') || 
                path.startsWith('/exams/history') || 
                path.startsWith('/exams/mock-tests') || 
                path.startsWith('/exams/model-tests') || 
                path.startsWith('/exams/subject-tests') || 
                path.startsWith('/exams/custom-test') || 
                path.startsWith('/exams/custom-start') ||
                path.startsWith('/exam/take') || 
                path.startsWith('/quiz/') ||
                (path.startsWith('/exams/') && path !== '/exams') ||
                path.startsWith('/mock-tests') ||
                path.startsWith('/model-tests') ||
                path.startsWith('/subject-tests') ||
                path.startsWith('/custom-test') ||
                path.startsWith('/exam/history')
            ) {
                return '/exams';
            }

            // Course subpages -> Courses
            if (path.startsWith('/course-details') || path.startsWith('/course/') || path.startsWith('/lesson-player') || path.startsWith('/lecture') || path.startsWith('/checkout/')) {
                return '/courses';
            }

            // Library & Notes subpages -> Notes / Library
            if (path.startsWith('/checkout-note')) {
                return '/library';
            }
            if (path.startsWith('/note-viewer') || (path.startsWith('/notes/') && path !== '/notes')) {
                return '/notes';
            }

            // QA Forum subpages -> QA Forum
            if (path.startsWith('/qa-forum/') || (path.startsWith('/qa/') && path !== '/qa')) {
                return '/qa-forum';
            }

            // Profile subpages -> Profile
            if (path.startsWith('/profile/') || path === '/profile-edit' || path === '/security' || path.startsWith('/security/')) {
                return '/profile';
            }

            // Routine & Notices -> Routine
            if (path.startsWith('/routine/') && path !== '/routine') {
                return '/routine';
            }
            if (path.startsWith('/notice') || path.startsWith('/notices')) {
                return '/dashboard';
            }

            return '/dashboard';
        }

        // Detect transient URLs that should NEVER be recorded or returned to
        function isTransientUrl(urlStr) {
            if (!urlStr) return true;
            try {
                const u = new URL(urlStr, window.location.origin);
                const p = u.pathname.toLowerCase();
                if (
                    p.includes('/solve') || 
                    p.includes('/take/') || 
                    p.includes('/quiz/') ||
                    p.includes('/login') || 
                    p.includes('/register') || 
                    p.includes('/logout') || 
                    p.includes('/auth') || 
                    p.includes('/forgot-password') || 
                    p.includes('/payment/callback') || 
                    p.includes('/payment/verify') || 
                    p.includes('/enroll-trial') ||
                    p.includes('/submit')
                ) {
                    return true;
                }
                return false;
            } catch(e) {
                return true;
            }
        }

        // Initialize and update the session navigation stack
        function initNavStack() {
            try {
                const currentHref = window.location.href;
                const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';
                const isBackNav = sessionStorage.getItem(IS_BACK_KEY) === 'true';
                sessionStorage.removeItem(IS_BACK_KEY);

                // Never record transient URLs
                if (isTransientUrl(currentHref)) {
                    return;
                }

                let stack = [];
                try {
                    const raw = sessionStorage.getItem(STACK_KEY);
                    if (raw) stack = JSON.parse(raw);
                } catch(e) {
                    stack = [];
                }
                if (!Array.isArray(stack)) stack = [];

                if (isBackNav) {
                    // Back navigation occurred: locate current URL in stack and truncate forward entries
                    let foundIdx = -1;
                    for (let i = stack.length - 1; i >= 0; i--) {
                        try {
                            const entryUrl = new URL(stack[i], window.location.origin);
                            if (entryUrl.pathname.toLowerCase().replace(/\/+$/, '') === currentPath) {
                                foundIdx = i;
                                break;
                            }
                        } catch(e) {}
                    }
                    if (foundIdx >= 0) {
                        stack = stack.slice(0, foundIdx + 1);
                        stack[foundIdx] = currentHref;
                    } else {
                        stack.push(currentHref);
                    }
                } else {
                    // Forward navigation: check if current page is already earlier in the stack (loop elimination)
                    let loopIdx = -1;
                    for (let i = stack.length - 1; i >= 0; i--) {
                        try {
                            const entryUrl = new URL(stack[i], window.location.origin);
                            if (entryUrl.pathname.toLowerCase().replace(/\/+$/, '') === currentPath) {
                                loopIdx = i;
                                break;
                            }
                        } catch(e) {}
                    }

                    if (loopIdx >= 0) {
                        // User returned to a page already in stack: trim forward entries
                        stack = stack.slice(0, loopIdx + 1);
                        stack[loopIdx] = currentHref;
                    } else {
                        // Fresh forward page
                        stack.push(currentHref);
                    }

                    if (stack.length > 25) {
                        stack = stack.slice(stack.length - 25);
                    }
                }

                sessionStorage.setItem(STACK_KEY, JSON.stringify(stack));
            } catch(e) {}
        }

        // Execute navigation to destination URL
        function navigateToUrl(targetUrl) {
            try {
                sessionStorage.setItem(IS_BACK_KEY, 'true');
            } catch(e) {}
            window.location.href = targetUrl;
        }

        // Global Back Button Handler
        window.handleHeaderNavBack = function(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }

            // 1. Close any open dialogs / modals / fullscreen viewers first
            if (typeof Swal !== 'undefined' && Swal.isVisible && Swal.isVisible()) {
                Swal.close();
                return;
            }
            const evalOverlay = document.getElementById('evalImageFullscreenOverlay');
            if (evalOverlay && !evalOverlay.classList.contains('hidden')) {
                if (typeof window.closeEvaluationImageFullscreen === 'function') {
                    window.closeEvaluationImageFullscreen();
                } else {
                    evalOverlay.classList.add('hidden');
                }
                return;
            }
            const generalOverlay = document.getElementById('oddhayImageViewer');
            if (generalOverlay && !generalOverlay.classList.contains('hidden') && typeof window.closeImageViewer === 'function') {
                window.closeImageViewer();
                return;
            }
            const proceedModal = document.getElementById('proceedModal');
            if (proceedModal && !proceedModal.classList.contains('hidden')) {
                if (typeof window.closeProceedModal === 'function') {
                    window.closeProceedModal();
                } else {
                    proceedModal.classList.add('hidden');
                }
                return;
            }
            const customTestModal = document.getElementById('customTestModal');
            if (customTestModal && !customTestModal.classList.contains('hidden')) {
                if (typeof window.closeCustomTestModal === 'function') {
                    window.closeCustomTestModal();
                } else if (typeof toggleCustomTestModal === 'function') {
                    toggleCustomTestModal();
                } else {
                    customTestModal.classList.add('hidden');
                }
                return;
            }
            const pgwModal = document.getElementById('pgwModal');
            if (pgwModal && !pgwModal.classList.contains('hidden')) {
                if (typeof window.closePgwModal === 'function') {
                    window.closePgwModal();
                } else {
                    pgwModal.classList.add('hidden');
                }
                return;
            }

            // 2. Check if the current page registered an interceptor hook (e.g. leave exam confirmation or step back)
            if (typeof window.onBeforeHeaderNavBack === 'function') {
                const handled = window.onBeforeHeaderNavBack(function() {
                    executeCoreBackNavigation();
                });
                // true = hook handled it (e.g. closed video player, closed folder) — stop here
                // false/undefined = hook did NOT handle it — fall through to executeCoreBackNavigation
                if (handled === true) {
                    return;
                }
            }

            // 3. Perform core back navigation
            executeCoreBackNavigation();
        };

        function executeCoreBackNavigation() {
            const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';

            // 1. Check explicit URL query param for previous origin (e.g. ?from=dashboard, ?from=courses)
            try {
                const searchParams = new URLSearchParams(window.location.search);
                const fromSource = searchParams.get('from');
                if (fromSource) {
                    if (fromSource.startsWith('/')) {
                        navigateToUrl(fromSource);
                        return;
                    }
                    if (['dashboard', 'courses', 'exams', 'library', 'messages', 'routine', 'notes', 'questions', 'qa-forum', 'progress'].includes(fromSource)) {
                        navigateToUrl('/' + fromSource);
                        return;
                    }
                }
            } catch(e) {}

            // 2. Check explicit data-back-url on #navBackBtn (explicit view author destination)
            const backBtn = document.getElementById('navBackBtn');
            if (backBtn && backBtn.getAttribute('data-back-url')) {
                const target = backBtn.getAttribute('data-back-url');
                if (target && target !== window.location.pathname) {
                    navigateToUrl(target);
                    return;
                }
            }

            // 3. Check Session Navigation Stack
            let stack = [];
            try {
                const raw = sessionStorage.getItem(STACK_KEY);
                if (raw) stack = JSON.parse(raw);
            } catch(e) {}

            if (Array.isArray(stack) && stack.length > 1) {
                // Search backwards for the true previous entry that is different from current page
                for (let i = stack.length - 2; i >= 0; i--) {
                    const candidateUrl = stack[i];
                    try {
                        const cand = new URL(candidateUrl, window.location.origin);
                        const candPath = cand.pathname.toLowerCase().replace(/\/+$/, '') || '/';
                        if (candPath !== currentPath && !isTransientUrl(cand.href)) {
                            stack = stack.slice(0, i + 1);
                            sessionStorage.setItem(STACK_KEY, JSON.stringify(stack));
                            navigateToUrl(candidateUrl);
                            return;
                        }
                    } catch(err) {}
                }
            }

            // 4. Check Safe In-Domain Referrer
            if (document.referrer && document.referrer !== window.location.href) {
                try {
                    const refUrl = new URL(document.referrer);
                    const refPath = refUrl.pathname.toLowerCase().replace(/\/+$/, '') || '/';
                    if (refUrl.origin === window.location.origin && refPath !== currentPath && !isTransientUrl(document.referrer)) {
                        navigateToUrl(document.referrer);
                        return;
                    }
                } catch(err) {}
            }

            // 5. Guaranteed Hierarchical Parent Fallback
            const parentUrl = getLogicalParentUrl(currentPath);
            navigateToUrl(parentUrl);
        }

        // Initialize stack on page load
        initNavStack();

        // Control back button visibility and binding
        function bindNavBackButton() {
            const backBtn = document.getElementById('navBackBtn');
            if (backBtn) {
                const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';
