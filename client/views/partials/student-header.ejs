    function selectLibrarySubject(subject) {
        const sel = document.getElementById('library-header-subject');
        if (sel && sel.value !== subject) {
            sel.value = subject;
        }
        window.currentSelectedLibrarySubject = subject;

        const label = document.getElementById('library-filter-label');
        if (label) {
            label.textContent = subject === 'all' ? 'All Subjects' : subject;
        }
        const options = document.querySelectorAll('.lib-sub-option');
        options.forEach(opt => {
            const optSub = opt.getAttribute('data-subject');
            const chk = opt.querySelector('.checkmark-icon');
            if (optSub === subject) {
                opt.className = 'lib-sub-option w-full px-2.5 py-1.5 rounded-lg text-left text-xs font-semibold text-primary bg-primary/10 flex items-center justify-between transition-colors';
                if (chk) chk.classList.remove('hidden');
            } else {
                opt.className = 'lib-sub-option w-full px-2.5 py-1.5 rounded-lg text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-between transition-colors';
                if (chk) chk.classList.add('hidden');
            }
        });
        const popover = document.getElementById('library-filter-popover');
        if (popover) popover.classList.add('hidden');

        if (typeof window.filterLibraryWithSubject === 'function') {
            window.filterLibraryWithSubject(subject);
        }
    }

    function toggleLibraryFilterDropdown(e) {
