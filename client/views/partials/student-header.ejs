            '/notices': 'Notices & Updates'
        };

        const urlParams = new URLSearchParams(window.location.search);
        const subParam = urlParams.get('subject');

        if (path === '/exams/subject-tests' || path === '/subject-tests') {
            if (subParam && subParam !== 'all') {
                titleElem.textContent = `Subject Tests / ${decodeURIComponent(subParam)}`;
            } else {
                titleElem.textContent = 'Subject Tests';
            }
        } else if (pathToTitle[path]) {
            titleElem.textContent = pathToTitle[path];
        } else {
            const currentTxt = titleElem.textContent ? titleElem.textContent.trim() : '';
            if (path.includes('/exams/subject-tests') || path.includes('/subject-tests')) {
                if (subParam && subParam !== 'all') {
                    titleElem.textContent = `Subject Tests / ${decodeURIComponent(subParam)}`;
                } else {
                    titleElem.textContent = 'Subject Tests';
                }
            } else if (path.includes('/exams/model-tests') || path.includes('/model-tests')) {
                titleElem.textContent = 'Model Test';
            } else if (path.includes('/exams/mock-tests') || path.includes('/mock-tests')) {
                titleElem.textContent = 'Mock Test';
            } else if (path.includes('/exams/history') || path.includes('/exam/history')) {
                titleElem.textContent = 'Exam History';
            } else if (path.includes('/exams/custom-test') || path.includes('/custom-test')) {
                titleElem.textContent = 'Custom Quiz';
            } else if (path.includes('/question-bank/view/') || path.includes('/question-bank/solve/') || path.includes('/question-bank/result/') || path.includes('/question-bank/review/') || path.includes('/question-bank/written')) {
                if (!currentTxt || currentTxt === 'Dashboard') {
                    titleElem.textContent = 'Question Bank Result';
                }
            } else if (!currentTxt || currentTxt === 'Dashboard') {
                if (path.includes('/course/')) {
                    titleElem.textContent = 'Course Details';
                } else if (path.includes('/note/')) {
                    titleElem.textContent = 'Note Viewer';
                } else if (path.includes('/exam/')) {
                    titleElem.textContent = 'Exam & Quiz';
                } else if (path.includes('/notice/')) {
                    titleElem.textContent = 'Notice Details';
                }
            }
        }
    })();

