                if (librarySearchBox) librarySearchBox.classList.add('hidden');
                if (coursesSubjectBox) coursesSubjectBox.classList.remove('hidden');
                if (coursesSearchBox) coursesSearchBox.classList.remove('hidden');
            } else {
                headerTools.classList.add('hidden');
                headerTools.classList.remove('flex');
            }
        }
    })();

