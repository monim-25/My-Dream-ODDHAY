    function submitQaSubject(val) {
        const form = document.getElementById('qa-filter-form');
        if (form) {
            let subInput = form.querySelector('input[name="subject"]');
            if (!subInput) {
                subInput = document.createElement('input');
                subInput.type = 'hidden';
                subInput.name = 'subject';
                form.appendChild(subInput);
            }
            subInput.value = val;
            form.submit();
        } else {
            const url = new URL(window.location.href);
            url.searchParams.set('subject', val);
            window.location.href = url.toString();
        }
    }
