<header class="h-[52px] sm:h-[54px] shrink-0 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md flex items-center justify-between p-0 z-50 relative">
    <!-- Left Controls (Mobile Menu Toggle & Student Profile Box) -->
    <div id="headerLeftBox" class="flex items-center gap-2 sm:gap-2.5 shrink-0 lg:w-[260px] px-2.5 sm:px-3.5 h-full min-w-0 transition-all duration-300 lg:border-r border-slate-200/50 dark:border-slate-800/50 border-b border-slate-200/80 dark:border-slate-800/80 lg:border-b-0">
        <!-- Mobile Menu Toggle Button -->
        <button onclick="toggleMobileSidebar()" class="lg:hidden p-1 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center justify-center shrink-0" title="Menu">
            <span class="material-symbols-rounded text-xl leading-none">menu</span>
        </button>

        <!-- Student Profile Widget (Avatar + 1st Line Name, 2nd Line Class) -->
        <a href="/profile" class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1 hover:opacity-90 transition-all group py-1 select-none" title="My Profile">
            <!-- Profile Avatar -->
            <div class="size-8 sm:size-[34px] rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0 overflow-hidden ring-1 ring-slate-200/80 dark:ring-slate-700/80 transition-transform group-hover:scale-105">
                <% if (locals.user && user.profilePicture) { %>
                    <img src="<%= user.profilePicture %>" alt="<%= user.name || 'Profile' %>" class="size-full object-cover" />
                <% } else { %>
                    <span class="material-symbols-rounded text-lg sm:text-[20px] text-slate-600 dark:text-slate-300">person</span>
                <% } %>
            </div>
            <!-- 1st line Name, 2nd line Class -->
            <div class="min-w-0 flex-1 flex flex-col justify-center leading-none">
                <span class="text-xs sm:text-[13px] font-bold text-slate-800 dark:text-slate-100 truncate leading-snug group-hover:text-primary transition-colors">
                    <%= (locals.user && user.name) ? user.name : 'Student' %>
                </span>
                <span class="text-[10.5px] sm:text-[11px] font-semibold text-indigo-600 dark:text-indigo-400 truncate leading-tight mt-0.5 tracking-wide">
                    <% if (locals.user && user.role === 'superadmin') { %>
                        Super Admin
                    <% } else if (locals.user && user.role === 'admin') { %>
                        Admin
                    <% } else if (locals.user && user.role === 'teacher') { %>
                        Teacher
                    <% } else if (locals.user && user.role === 'parent') { %>
                        Parent
                    <% } else { %>
                        <%= (locals.user && user.classLevel) ? user.classLevel : 'Class 9' %>
                    <% } %>
                </span>
            </div>
        </a>
    </div>

    <!-- Main Header Right Area (Active Page Title, Dynamic Tools & Right Actions with Bottom Border) -->
    <div class="flex items-center justify-between min-w-0 flex-1 h-full border-b border-slate-200/80 dark:border-slate-800/80">
        <!-- Active Page Title & Back Arrow -->
        <div class="flex items-center justify-between gap-1.5 sm:gap-2 px-3 sm:px-4 min-w-0 flex-1 h-full">
            <div class="flex items-center gap-1.5 sm:gap-2 min-w-0 shrink-0">
                <!-- Back Arrow Navigation Button (Shown on subpages) -->
                <button id="navBackBtn" onclick="handleHeaderNavBack(event)" <% if (locals.backUrl) { %>data-back-url="<%= locals.backUrl %>"<% } %>
                class="p-1 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors items-center justify-center shrink-0 leading-none hidden" title="Go Back">
                <span class="material-symbols-rounded text-base sm:text-lg leading-none shrink-0 flex items-center justify-center -mt-0.5 p-0 m-0">arrow_back</span>
            </button>

            <% 
            let pageTitleText = 'Dashboard';
            let hasCustomTitle = false;
            if (locals.pageTitle) {
                pageTitleText = locals.pageTitle;
                hasCustomTitle = true;
            } else if (locals.course && locals.course.title) {
                pageTitleText = locals.course.title;
                hasCustomTitle = true;
            } else if (locals.bank && locals.bank.title) {
                pageTitleText = locals.bank.title;
                hasCustomTitle = true;
            } else if (locals.activePage) {
                const pageTitles = {
                    'dashboard': 'Dashboard',
                    'ai': 'Oddhay AI',
                    'student': 'Oddhay AI',
                    'courses': 'Courses',
                    'messages': 'Messages',
                    'library': 'Library',
                    'exams': 'Exams & Quizzes',
                    'routine': 'Routine & Plan',
                    'notes': 'Notes',
                    'questions': 'Question Bank',
                    'question-bank': 'Question Bank',
                    'qa': 'Q&A Community',
                    'qa-forum': 'Q&A Community',
                    'progress': 'Progress Report',
                    'analytics': 'Progress Report',
                    'report-card': 'Progress Report',
                    'payments': 'Payment History',
                    'profile': 'My Profile'
                };
                pageTitleText = pageTitles[locals.activePage] || (locals.activePage.charAt(0).toUpperCase() + locals.activePage.slice(1));
            }
            %>
            <h1 id="headerPageTitle" <%= hasCustomTitle ? 'data-custom-title="true"' : '' %> class="text-[13px] sm:text-[14px] font-medium antialiased text-slate-600 dark:text-slate-300 truncate leading-none tracking-tight flex items-center p-0 m-0 shrink-0">
                <%= pageTitleText %>
            </h1>
            <!-- Dynamic AI Conversation Title Breadcrumb (Beside Oddhay AI) -->
            <div id="headerAiConversationBox" class="hidden flex items-center gap-1.5 min-w-0">
                <span class="text-slate-300 dark:text-slate-700 text-xs select-none">/</span>
                <span id="headerAiConversationTitle" class="text-xs sm:text-[13px] font-semibold text-slate-800 dark:text-slate-200 truncate max-w-[130px] sm:max-w-[240px] md:max-w-[360px] lg:max-w-[480px]"></span>
            </div>
        </div>

        <!-- Dynamic Navbar Tools Slot (Subject Filter & Live Search Bar for Q&A Community & Question Bank) -->
        <div id="headerToolsSlot" class="hidden flex items-center gap-1.5 sm:gap-2 ml-auto shrink-0">
            <!-- Q&A Subject Filter Dropdown -->
            <div id="qa-header-subject-box" class="flex items-center gap-1 shrink-0">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 hidden lg:inline select-none">Subject:</span>
                <select id="qa-header-subject" onchange="submitQaSubject(this.value)"
                    class="px-2 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none cursor-pointer shrink-0">
                    <option value="all">All Subjects</option>
                    <% (locals.availableSubjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                        <option value="<%= sub %>" <%= (locals.filters && locals.filters.subject === sub) ? 'selected' : '' %>><%= sub %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Q&A Live Search Input Bar -->
            <div id="qa-header-search-box" class="relative flex items-center shrink-0">
                <input type="text" id="qa-search-input" name="search" value="<%= (locals.filters && locals.filters.search) || '' %>" placeholder="Live search questions..."
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="clear-search-btn" onclick="clearLiveSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Question Bank Live Search Bar -->
            <div id="qb-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="qb-search-input-header" 
                    oninput="submitQbHeaderSearch(this.value)" 
                    onkeyup="submitQbHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitQbHeaderSearch(this.value);}"
                    placeholder="Search archive..." value="<%= locals.search || '' %>"
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="qb-clear-search-btn" onclick="clearQbHeaderSearch()" class="<%= (locals.search && locals.search.trim().length > 0) ? '' : 'hidden' %> absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Notes Live Search Bar -->
            <div id="notes-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="notes-search-input-header" 
                    oninput="submitNotesHeaderSearch(this.value)" 
                    onkeyup="submitNotesHeaderSearch(this.value)"
                    onchange="submitNotesHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitNotesHeaderSearch(this.value);}"
                    placeholder="Search notes & folders..." value="<%= locals.search || '' %>"
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="notes-clear-search-btn" onclick="clearNotesHeaderSearch()" class="<%= (locals.search && locals.search.trim().length > 0) ? '' : 'hidden' %> absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Exam History Live Search Bar -->
            <div id="exam-history-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="history-search-input-header" 
                    oninput="submitHistoryHeaderSearch(this.value)" 
                    onkeyup="submitHistoryHeaderSearch(this.value)"
                    onchange="submitHistoryHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitHistoryHeaderSearch(this.value);}"
                    placeholder="Search exam history..."
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="history-clear-search-btn" onclick="clearHistoryHeaderSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Mock Tests Subject Filter Dropdown -->
            <div id="mock-header-subject-box" class="hidden flex items-center gap-1 shrink-0">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 hidden lg:inline select-none">Subject:</span>
                <select id="mock-header-subject" onchange="submitMockSubject(this.value)"
                    class="px-2 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none cursor-pointer shrink-0">
                    <option value="all">All Subjects</option>
                    <% (locals.assignedSubjects || locals.availableSubjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                        <option value="<%= sub %>"><%= sub %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Mock Tests Live Search Bar -->
            <div id="mock-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="mock-search-input-header" 
                    oninput="submitMockHeaderSearch(this.value)" 
                    onkeyup="submitMockHeaderSearch(this.value)"
                    onchange="submitMockHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitMockHeaderSearch(this.value);}"
                    placeholder="Search mock tests..."
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="mock-clear-search-btn" onclick="clearMockHeaderSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Model Tests Subject Filter Dropdown -->
            <div id="model-header-subject-box" class="hidden flex items-center gap-1 shrink-0">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 hidden lg:inline select-none">Subject:</span>
                <select id="model-header-subject" onchange="submitModelSubject(this.value)"
                    class="px-2 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none cursor-pointer shrink-0">
                    <option value="all">All Subjects</option>
                    <% (locals.assignedSubjects || locals.availableSubjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                        <option value="<%= sub %>"><%= sub %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Model Tests Live Search Bar -->
            <div id="model-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="model-search-input-header" 
                    oninput="submitModelHeaderSearch(this.value)" 
                    onkeyup="submitModelHeaderSearch(this.value)"
                    onchange="submitModelHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitModelHeaderSearch(this.value);}"
                    placeholder="Search model tests..."
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="model-clear-search-btn" onclick="clearModelHeaderSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Subject Tests Topic Filter Dropdown -->
            <div id="subject-tests-header-topic-box" class="hidden flex items-center gap-1 shrink-0">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 hidden lg:inline select-none">Topic:</span>
                <select id="subject-tests-header-topic" onchange="submitSubjectTestsTopic(this.value)"
                    class="px-2 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none cursor-pointer shrink-0">
                    <option value="all">All Topics</option>
                    <% (locals.subjectTopics || []).forEach(tp => { %>
                        <option value="<%= tp %>"><%= tp %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Subject Tests Live Search Bar -->
            <div id="subject-tests-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="subject-tests-search-input-header" 
                    oninput="submitSubjectTestsHeaderSearch(this.value)" 
                    onkeyup="submitSubjectTestsHeaderSearch(this.value)"
                    onchange="submitSubjectTestsHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitSubjectTestsHeaderSearch(this.value);}"
                    placeholder="Search exams or topics..."
                    class="w-28 sm:w-40 md:w-52 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="subject-tests-clear-search-btn" onclick="clearSubjectTestsHeaderSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Library Subject Filter Dropdown -->
            <div id="library-header-subject-box" class="hidden relative flex items-center shrink-0">
                <select id="library-header-subject" onchange="selectLibrarySubject(this.value)"
                    style="-webkit-appearance: none; -moz-appearance: none; appearance: none; background-image: none;"
                    class="pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none focus:border-primary transition-all cursor-pointer shadow-2xs">
                    <option value="all">All Subjects</option>
                    <% (locals.subjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                        <option value="<%= sub %>"><%= sub %></option>
                    <% }) %>
                </select>
                <span class="material-symbols-rounded absolute left-1.5 text-primary text-xs leading-none flex items-center justify-center pointer-events-none select-none">tune</span>
                <span class="material-symbols-rounded absolute right-1.5 text-slate-400 text-xs leading-none flex items-center justify-center pointer-events-none select-none">expand_more</span>
            </div>

            <!-- Library Live Search Bar -->
            <div id="library-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="library-search-input-header" 
                    oninput="submitLibraryHeaderSearch(this.value)" 
                    onkeyup="submitLibraryHeaderSearch(this.value)"
                    onchange="submitLibraryHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitLibraryHeaderSearch(this.value);}"
                    placeholder="Search books, guides, authors..."
                    class="w-28 sm:w-44 md:w-56 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="library-clear-search-btn" onclick="clearLibraryHeaderSearch()" class="hidden absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>

            <!-- Courses Subject Filter Dropdown -->
            <div id="courses-header-subject-box" class="hidden relative flex items-center shrink-0">
                <select id="courses-header-subject" onchange="submitCoursesSubject(this.value)"
                    style="-webkit-appearance: none; -moz-appearance: none; appearance: none; background-image: none;"
                    class="pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-slate-200 rounded-md outline-none focus:border-primary transition-all cursor-pointer shadow-2xs">
                    <option value="all">All Subjects</option>
                    <% (locals.subjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                        <option value="<%= sub %>" <%= (locals.activeSubject === sub) ? 'selected' : '' %>><%= sub %></option>
                    <% }) %>
                </select>
                <span class="material-symbols-rounded absolute left-1.5 text-primary text-xs leading-none flex items-center justify-center pointer-events-none select-none">tune</span>
                <span class="material-symbols-rounded absolute right-1.5 text-slate-400 text-xs leading-none flex items-center justify-center pointer-events-none select-none">expand_more</span>
            </div>

            <!-- Courses Live Search Bar -->
            <div id="courses-header-search-box" class="hidden relative flex items-center shrink-0">
                <input type="text" id="courses-search-input-header" 
                    oninput="submitCoursesHeaderSearch(this.value)" 
                    onkeyup="submitCoursesHeaderSearch(this.value)"
                    onchange="submitCoursesHeaderSearch(this.value)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault(); submitCoursesHeaderSearch(this.value);}"
                    placeholder="Find Course..." value="<%= locals.search || '' %>"
                    class="w-28 sm:w-44 md:w-56 pl-6 pr-6 py-0.5 sm:py-1 bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-[11px] font-semibold text-slate-800 dark:text-white rounded-md outline-none focus:border-primary transition-all">
                <span class="material-symbols-rounded absolute left-1.5 text-slate-400 text-xs flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                <button type="button" id="courses-clear-search-btn" onclick="clearCoursesHeaderSearch()" class="<%= (locals.search && locals.search.trim().length > 0) ? '' : 'hidden' %> absolute right-1.5 size-4 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Right Controls (Notifications, Dark Mode Toggle & ODDHAY Logo) -->
    <div class="flex items-center gap-0.5 sm:gap-1 shrink-0 pr-3 sm:pr-6">
        <%
            let notifCount = 0;
            if (locals.unreadNotificationCount !== undefined && locals.unreadNotificationCount !== null) {
                notifCount = parseInt(locals.unreadNotificationCount, 10) || 0;
            } else if (locals.stats && locals.stats.unread !== undefined) {
                notifCount = parseInt(locals.stats.unread, 10) || 0;
            }
            const notifText = notifCount > 9 ? '9+' : notifCount;
        %>
        <!-- Notifications Dropdown -->
