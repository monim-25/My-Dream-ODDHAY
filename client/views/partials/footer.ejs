<% const isEn = (typeof lang !== 'undefined' && lang === 'en') || (locals.lang === 'en'); %>
<!-- ODDHAY Official Unified Footer Partial -->
<footer class="mt-auto border-t border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-[#080e1a] backdrop-blur-md transition-colors">
    <!-- Main Footer Navigation & Legal Info -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-14">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8">

            <!-- Column 1: Brand & Official Legal Credentials (lg:col-span-4) -->
            <div class="lg:col-span-4 space-y-3.5">
                <a href="/" class="inline-flex items-center gap-2 group">
                    <div class="size-7.5 rounded-lg bg-[#18a957] flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                        <span class="material-symbols-rounded text-base">menu_book</span>
                    </div>
                    <span class="font-bold text-lg text-slate-900 dark:text-white tracking-wide">ODDHAY</span>
                    <% if (!isEn) { %>
                        <span class="text-[11px] px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-semibold border border-emerald-200/60 dark:border-emerald-800/60 font-bangla">অধ্যায়</span>
                    <% } %>
                </a>

                <!-- Social Media Links (Placed immediately after the logo) -->
                <div class="flex items-center gap-2 pt-0.5">
                    <!-- Facebook -->
                    <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.facebook) ? siteSettings.socialLinks.facebook : 'https://facebook.com/oddhay' %>" target="_blank" rel="noopener" title="Facebook Page" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#1877f2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                        <i class="fa-brands fa-facebook-f text-xs"></i>
                    </a>

                    <!-- YouTube -->
                    <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.youtube) ? siteSettings.socialLinks.youtube : 'https://youtube.com/@oddhay' %>" target="_blank" rel="noopener" title="YouTube Channel" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#ff0000] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                        <i class="fa-brands fa-youtube text-xs"></i>
                    </a>

                    <!-- WhatsApp Community -->
                    <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" title="WhatsApp Community" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#25d366] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                        <i class="fa-brands fa-whatsapp text-xs"></i>
                    </a>

                    <!-- LinkedIn -->
                    <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.linkedin) ? siteSettings.socialLinks.linkedin : 'https://linkedin.com/company/oddhay' %>" target="_blank" rel="noopener" title="LinkedIn Profile" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#0a66c2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                        <i class="fa-brands fa-linkedin-in text-xs"></i>
                    </a>

                    <!-- Instagram -->
                    <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.instagram) ? siteSettings.socialLinks.instagram : 'https://instagram.com/oddhay.official' %>" target="_blank" rel="noopener" title="Instagram Profile" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-xs">
                        <i class="fa-brands fa-instagram text-xs"></i>
                    </a>
                </div>

                <!-- Official Legal & Regulatory Registration (Clean, uncarded presentation) -->
                <div class="space-y-1.5 pt-1">
                    <h4 class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-emerald-500 text-sm">verified</span>
                        <span>Official Legal & Regulatory Registration</span>
                    </h4>

                    <div class="text-xs space-y-1 text-slate-600 dark:text-slate-400">
                        <div class="flex items-center gap-2">
                            <span class="text-slate-500 dark:text-slate-400">Trade License No:</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tradeLicense) ? siteSettings.legalInfo.tradeLicense : 'TRAD/DNCC/041285/2026' %></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-500 dark:text-slate-400">e-TIN Certificate No:</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tinNumber) ? siteSettings.legalInfo.tinNumber : '8491-7302-6194' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Column 2: Academic Programs (lg:col-span-2) - Swapped with Corporate Office -->
            <div class="lg:col-span-2 space-y-3">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
                    Academic Programs
                </h4>
                <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 font-normal">
                    <li>
                        <a href="/?class=class9#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class9');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Class 9 (SSC Prep)
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class10#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class10');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Class 10 & SSC Final
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class11#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class11');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Class 11 (HSC Foundation)
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class12#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class12');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Class 12 & HSC Final
                        </a>
                    </li>
                    <li>
                        <a href="/question-bank" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Board Question Bank
                        </a>
                    </li>
                    <li>
                        <a href="/?class=all#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('all');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400">chevron_right</span>
                            Live Model Tests & Courses
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Column 3: Policies & Compliance (lg:col-span-2) -->
            <div class="lg:col-span-2 space-y-3">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
                    Policies & Legal
                </h4>
                <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 font-normal">
                    <li>
                        <a href="/privacy-policy" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">security</span>
                            Privacy Policy
                        </a>
                    </li>
                    <li>
                        <a href="/refund-policy" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">currency_exchange</span>
                            Refund Policy
                        </a>
                    </li>
                    <li>
                        <a href="/terms" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">gavel</span>
                            Terms & Conditions
                        </a>
                    </li>
                    <li>
                        <a href="/faq" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">help_outline</span>
                            FAQ & Help
                        </a>
                    </li>
                    <li>
                        <a href="/about" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">info</span>
                            About ODDHAY
                        </a>
                    </li>
                    <li>
                        <a href="/contact" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-slate-400">contact_support</span>
                            Contact Support
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Column 4: Address, Hotline & Contact (lg:col-span-4) - Swapped with Academic Programs -->
            <div class="lg:col-span-4 space-y-3">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
                    Corporate Office & Contact
                </h4>

                <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
                    <!-- Office Address -->
                    <div class="flex items-start gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-sm shrink-0 mt-0.5">location_on</span>
                        <span class="leading-relaxed">
                            <%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.address) ? siteSettings.legalInfo.address : 'House #12, Road #04, Dhanmondi, Dhaka - 1209, Bangladesh' %>
                        </span>
                    </div>

                    <!-- Hotline Call -->
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-sm shrink-0">call</span>
                        <a href="tel:<%= ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+8809638789012').replace(/\s+/g, '') %>" class="hover:text-[#18a957] transition-colors font-medium num-font">
                            <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+880 9638-789012' %>
                        </a>
                        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium">
                            <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.supportHours) ? siteSettings.contactInfo.supportHours : '9:00 AM - 11:00 PM' %>
                        </span>
                    </div>

                    <!-- Official Email -->
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-sm shrink-0">mail</span>
                        <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="hover:text-[#18a957] transition-colors font-sans">
                            <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                        </a>
                    </div>

                    <!-- WhatsApp Direct -->
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-sm shrink-0">chat</span>
                        <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" class="hover:text-[#18a957] transition-colors font-medium flex items-center gap-1">
                            <span>Direct WhatsApp Support</span>
                            <span class="material-symbols-rounded text-xs text-slate-400">open_in_new</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="border-t border-slate-200/80 dark:border-slate-800/80 py-4 bg-slate-50/80 dark:bg-slate-950/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-xs text-slate-500 dark:text-slate-400 font-normal">
                &copy; 2026 <strong class="text-slate-700 dark:text-slate-300 font-semibold"><%= (locals.siteSettings && siteSettings.footerInfo && siteSettings.footerInfo.copyrightText && !siteSettings.footerInfo.copyrightText.includes('শিক্ষাপ্রযুক্তি') && !siteSettings.footerInfo.copyrightText.includes('EdTech')) ? siteSettings.footerInfo.copyrightText : 'ODDHAY. All Rights Reserved.' %></strong>
            </p>
        </div>
    </div>
</footer>