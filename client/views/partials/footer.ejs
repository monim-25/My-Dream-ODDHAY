<% 
    const isEn = (typeof lang !== 'undefined' && lang === 'en') || (locals.lang === 'en'); 
    const settings = locals.siteSettings || {};
    const footer = settings.footerInfo || {};
    const legal = settings.legalInfo || {};
    const contact = settings.contactInfo || {};
    const social = settings.socialLinks || {};

    const tradeLic = (legal.tradeLicense && typeof legal.tradeLicense === 'string' && legal.tradeLicense.trim() !== '' && legal.tradeLicense.trim() !== 'N/A') ? legal.tradeLicense.trim() : '';
    const tinNum = (legal.tinNumber && typeof legal.tinNumber === 'string' && legal.tinNumber.trim() !== '' && legal.tinNumber.trim() !== 'N/A') ? legal.tinNumber.trim() : '';

    const fbUrl = (social.facebook && typeof social.facebook === 'string') ? social.facebook.trim() : '';
    const ytUrl = (social.youtube && typeof social.youtube === 'string') ? social.youtube.trim() : '';
    const waUrl = (social.whatsapp && typeof social.whatsapp === 'string' && social.whatsapp.trim()) 
        ? social.whatsapp.trim() 
        : (contact.whatsapp && typeof contact.whatsapp === 'string' && contact.whatsapp.trim() && contact.whatsapp.trim() !== '+8801XXXXXXXXX' ? ('https://wa.me/' + contact.whatsapp.replace(/[^0-9]/g, '')) : '');
    const liUrl = (social.linkedin && typeof social.linkedin === 'string') ? social.linkedin.trim() : '';
    const igUrl = (social.instagram && typeof social.instagram === 'string') ? social.instagram.trim() : '';

    const officeAddr = (legal.address && typeof legal.address === 'string' && legal.address.trim()) ? legal.address.trim() : 'House #12, Road #04, Dhanmondi, Dhaka - 1209, Bangladesh';
    const hotlinePhone = (contact.phone && typeof contact.phone === 'string' && contact.phone.trim() && contact.phone.trim() !== '+8801XXXXXXXXX') ? contact.phone.trim() : '+880 9638-789012';
    const supportHours = (contact.supportHours && typeof contact.supportHours === 'string' && contact.supportHours.trim()) ? contact.supportHours.trim() : '';
    const officialEmail = (contact.email && typeof contact.email === 'string' && contact.email.trim()) ? contact.email.trim() : 'support@oddhay.com';
    const bioText = (footer.bioText && typeof footer.bioText === 'string' && footer.bioText.trim()) ? footer.bioText.trim() : '';
    
    let copyright = (footer.copyrightText && typeof footer.copyrightText === 'string' && footer.copyrightText.trim()) ? footer.copyrightText.trim() : 'ODDHAY. All Rights Reserved.';
%>
<!-- ODDHAY Official Unified Footer Partial -->
<footer class="mt-auto border-t border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-[#080e1a] backdrop-blur-md transition-colors">
    <!-- Main Footer Navigation & Legal Info -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-14">
        <div class="grid grid-cols-2 lg:grid-cols-12 gap-x-4 sm:gap-x-6 gap-y-6 sm:gap-y-8 lg:gap-8">

            <!-- Column 1: Brand & Official Legal Credentials (Full-width on mobile, 4-col on desktop) -->
            <div class="col-span-2 lg:col-span-4 lg:order-1 space-y-3 sm:space-y-3.5">
                <a href="/" class="inline-flex items-center gap-2 sm:gap-2.5 group">
                    <div class="size-7 sm:size-8 rounded-lg bg-[#18a957] flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
                        <span class="material-symbols-rounded text-base sm:text-lg">menu_book</span>
                    </div>
                    <span class="font-bold text-lg sm:text-xl text-slate-900 dark:text-white tracking-wide">ODDHAY</span>
                    <% if (!isEn) { %>
                        <span class="text-[11px] sm:text-xs px-1.5 sm:px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-semibold border border-emerald-200/60 dark:border-emerald-800/60 font-bangla">অধ্যায়</span>
                    <% } %>
                </a>

                <!-- Bio Text from SuperAdmin -->
                <% if (bioText) { %>
                    <p class="text-[12.5px] xs:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
                        <%= bioText %>
                    </p>
                <% } %>

                <!-- Social Media Links (Placed immediately after the logo / bio) -->
                <% const hasAnySocialLink = Boolean(fbUrl || ytUrl || waUrl || liUrl || igUrl); %>
                <div class="flex items-center gap-2 sm:gap-2.5 pt-0.5 sm:pt-1">
                    <% if (fbUrl || !hasAnySocialLink) { %>
                        <!-- Facebook -->
                        <a href="<%= fbUrl || 'https://facebook.com/oddhay' %>" target="_blank" rel="noopener" title="Facebook Page" class="w-8 h-8 sm:w-[38px] sm:h-[38px] rounded-lg sm:rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 hover:bg-[#1877f2] hover:border-[#1877f2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-2xs hover:scale-105">
                            <i class="fa-brands fa-facebook-f text-xs sm:text-[15px]"></i>
                        </a>
                    <% } %>

                    <% if (ytUrl || !hasAnySocialLink) { %>
                        <!-- YouTube -->
                        <a href="<%= ytUrl || 'https://youtube.com/@oddhay' %>" target="_blank" rel="noopener" title="YouTube Channel" class="w-8 h-8 sm:w-[38px] sm:h-[38px] rounded-lg sm:rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 hover:bg-[#ff0000] hover:border-[#ff0000] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-2xs hover:scale-105">
                            <i class="fa-brands fa-youtube text-xs sm:text-[15px]"></i>
                        </a>
                    <% } %>

                    <% if (waUrl || !hasAnySocialLink) { %>
                        <!-- WhatsApp Community / Channel -->
                        <a href="<%= waUrl || 'https://wa.me/8801712345678' %>" target="_blank" rel="noopener" title="WhatsApp Support" class="w-8 h-8 sm:w-[38px] sm:h-[38px] rounded-lg sm:rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 hover:bg-[#25d366] hover:border-[#25d366] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-2xs hover:scale-105">
                            <i class="fa-brands fa-whatsapp text-xs sm:text-[15px]"></i>
                        </a>
                    <% } %>

                    <% if (liUrl) { %>
                        <!-- LinkedIn -->
                        <a href="<%= liUrl %>" target="_blank" rel="noopener" title="LinkedIn Profile" class="w-8 h-8 sm:w-[38px] sm:h-[38px] rounded-lg sm:rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 hover:bg-[#0a66c2] hover:border-[#0a66c2] hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-2xs hover:scale-105">
                            <i class="fa-brands fa-linkedin-in text-xs sm:text-[15px]"></i>
                        </a>
                    <% } %>

                    <% if (igUrl) { %>
                        <!-- Instagram -->
                        <a href="<%= igUrl %>" target="_blank" rel="noopener" title="Instagram Profile" class="w-8 h-8 sm:w-[38px] sm:h-[38px] rounded-lg sm:rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 hover:border-transparent hover:text-white text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all shadow-2xs hover:scale-105">
                            <i class="fa-brands fa-instagram text-xs sm:text-[15px]"></i>
                        </a>
                    <% } %>
                </div>

                <!-- Official Legal & Regulatory Registration (Shown if configured in superadmin) -->
                <% if (tradeLic || tinNum) { %>
                    <!-- Desktop View -->
                    <div class="hidden sm:block space-y-1.5 pt-1">
                        <h4 class="text-[14.5px] sm:text-[15px] font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base">verified</span>
                            <span>Official Legal & Regulatory Registration</span>
                        </h4>

                        <div class="text-[13px] sm:text-[13.5px] space-y-1 text-slate-600 dark:text-slate-400">
                            <% if (tradeLic) { %>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-slate-500 dark:text-slate-400">Trade License No:</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= tradeLic %></span>
                                </div>
                            <% } %>
                            <% if (tinNum) { %>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-slate-500 dark:text-slate-400">e-TIN Certificate No:</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= tinNum %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Mobile Compact 2-Column -->
                    <div class="sm:hidden pt-1">
                        <h4 class="text-[13px] font-semibold text-slate-900 dark:text-white flex items-center gap-1 mb-1.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base">verified</span>
                            <span>Official Registration</span>
                        </h4>
                        <div class="grid <%= (tradeLic && tinNum) ? 'grid-cols-2' : 'grid-cols-1' %> gap-2 text-[12px]">
                            <% if (tradeLic) { %>
                                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-850/80 border border-slate-200/70 dark:border-slate-800/80">
                                    <span class="text-slate-400 dark:text-slate-500 text-[10.5px] block">Trade License</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200 num-font text-[12px] block truncate" title="<%= tradeLic %>"><%= tradeLic %></span>
                                </div>
                            <% } %>
                            <% if (tinNum) { %>
                                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-850/80 border border-slate-200/70 dark:border-slate-800/80">
                                    <span class="text-slate-400 dark:text-slate-500 text-[10.5px] block">e-TIN Cert</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200 num-font text-[12px] block truncate" title="<%= tinNum %>"><%= tinNum %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Column 2 in DOM / Column 3 on Desktop: Policies & Compliance (1 col on mobile, 2 col on desktop) -->
            <div class="col-span-1 lg:col-span-2 lg:order-3 space-y-2.5 sm:space-y-3">
                <h4 class="text-[13.5px] sm:text-[14.5px] lg:text-[15px] font-bold text-slate-900 dark:text-white">
                    Policies & Legal
                </h4>
                <ul class="space-y-1.5 sm:space-y-2 text-[12.5px] xs:text-[13px] sm:text-[13.5px] text-slate-600 dark:text-slate-400 font-normal">
                    <li>
                        <a href="/privacy-policy" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">security</span>
                            <span class="truncate">Privacy Policy</span>
                        </a>
                    </li>
                    <li>
                        <a href="/refund-policy" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">currency_exchange</span>
                            <span class="truncate">Refund Policy</span>
                        </a>
                    </li>
                    <li>
                        <a href="/terms" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">gavel</span>
                            <span class="truncate">Terms of Service</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faq" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">help_outline</span>
                            <span class="truncate">FAQ & Help</span>
                        </a>
                    </li>
                    <li>
                        <a href="/about" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">info</span>
                            <span class="truncate">About Us</span>
                        </a>
                    </li>
                    <li>
                        <a href="/contact" class="hover:text-[#18a957] transition-colors flex items-center gap-1.5 py-0.5">
                            <span class="material-symbols-rounded text-base text-slate-400 shrink-0">contact_support</span>
                            <span class="truncate">Contact Support</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Column 3 in DOM / Column 4 on Desktop: Academic Programs (1 col on mobile, 2 col on desktop) -->
            <div class="col-span-1 lg:col-span-2 lg:order-4 space-y-2.5 sm:space-y-3">
                <h4 class="text-[13.5px] sm:text-[14.5px] lg:text-[15px] font-bold text-slate-900 dark:text-white">
                    Academic Programs
                </h4>
                <ul class="space-y-1.5 sm:space-y-2 text-[12.5px] xs:text-[13px] sm:text-[13.5px] text-slate-600 dark:text-slate-400 font-normal">
                    <li>
                        <a href="/?class=class9#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class9');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Class 9 (SSC Prep)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class10#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class10');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Class 10 & SSC Final</span>
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class11#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class11');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Class 11 (HSC Foundation)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/?class=class12#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('class12');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Class 12 & HSC Final</span>
                        </a>
                    </li>
                    <li>
                        <a href="/question-bank" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Board Question Bank</span>
                        </a>
                    </li>
                    <li>
                        <a href="/?class=all#courses" onclick="if(window.location.pathname==='/'||window.location.pathname===''){if(typeof scrollToClassAndFilter==='function'){scrollToClassAndFilter('all');return false;}}" class="hover:text-[#18a957] transition-colors flex items-center gap-1 py-0.5 cursor-pointer">
                            <span class="material-symbols-rounded text-xs text-slate-400 shrink-0">chevron_right</span>
                            <span class="truncate">Model Tests & Courses</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Column 4 in DOM / Column 2 on Desktop: Address, Hotline & Contact (Full-width on mobile, 4-col on desktop) -->
            <div class="col-span-2 lg:col-span-4 lg:order-2 space-y-2.5 sm:space-y-3 pt-3 sm:pt-0 border-t border-slate-100 dark:border-slate-800/80 lg:border-0">
                <h4 class="text-[13.5px] sm:text-[14.5px] lg:text-[15px] font-bold text-slate-900 dark:text-white">
                    Corporate Office & Contact
                </h4>

                <div class="space-y-2 sm:space-y-2.5 text-[12.5px] xs:text-[13px] sm:text-[13.5px] text-slate-600 dark:text-slate-400">
                    <!-- Office Address -->
                    <div class="flex items-start gap-1.5 sm:gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-base shrink-0 mt-0.5">location_on</span>
                        <span class="leading-relaxed">
                            <%= officeAddr %>
                        </span>
                    </div>

                    <!-- Hotline Call -->
                    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">call</span>
                        <a href="tel:<%= hotlinePhone.replace(/\s+/g, '') %>" class="hover:text-[#18a957] transition-colors font-medium num-font text-[13px] sm:text-[14px]">
                            <%= hotlinePhone %>
                        </a>
                        <% if (supportHours) { %>
                            <span class="text-[11px] sm:text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium">
                                <%= supportHours %>
                            </span>
                        <% } %>
                    </div>

                    <!-- Official Email -->
                    <div class="flex items-center gap-1.5 sm:gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">mail</span>
                        <a href="mailto:<%= officialEmail %>" class="hover:text-[#18a957] transition-colors font-sans">
                            <%= officialEmail %>
                        </a>
                    </div>

                    <!-- WhatsApp Direct -->
                    <div class="flex items-center gap-1.5 sm:gap-2">
                        <span class="material-symbols-rounded text-emerald-500 text-base shrink-0">chat</span>
                        <a href="<%= waUrl || 'https://wa.me/8801740335172' %>" target="_blank" rel="noopener" class="hover:text-[#18a957] transition-colors font-medium flex items-center gap-1">
                            <span>Direct WhatsApp Support</span>
                            <span class="material-symbols-rounded text-xs text-slate-400">open_in_new</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="border-t border-slate-200/80 dark:border-slate-800/80 py-4 bg-slate-50/80 dark:bg-slate-950/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <% 
                const hasCopy = copyright.includes('©') || copyright.includes('&copy;');
                const hasYearNum = /\b20\d\d\b/.test(copyright);
            %>
            <p class="text-[13px] text-slate-500 dark:text-slate-400 font-normal">
                <% if (!hasCopy) { %>&copy; <% } %><% if (!hasYearNum) { %>2026 <% } %><%= copyright %>
            </p>
        </div>
    </div>
</footer>
