<!DOCTYPE html>
<html lang="en" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">

<head>
    <title>Refund Policy | ODDHAY</title>
    <meta name="description"
        content="Official Refund Policy for ODDHAY digital education platform. Read our transparent and student-friendly refund guidelines.">
    <%- include('partials/head') %>
</head>

<body
    class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
                <nav class="flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 mb-1.5 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">Refund Policy</span>
                </nav>
                <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    Refund Policy
                </h1>
            </div>

            <!-- Custom Content from SuperAdmin if provided -->
            <% const customRefund = (locals.siteSettings && siteSettings.policiesAndLegal && siteSettings.policiesAndLegal.refundPolicy) ? siteSettings.policiesAndLegal.refundPolicy : ''; %>
            <% if (customRefund && customRefund.trim().length > 0) { %>
                <div class="prose dark:prose-invert max-w-none text-sm sm:text-[15px] text-slate-600 dark:text-slate-300 leading-relaxed space-y-4">
                    <%- customRefund %>
                </div>
            <% } else { %>
                <!-- Standard Concise English Policy -->
                <div class="space-y-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    
                    <!-- Intro Box -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
                        <p>
                            ODDHAY is committed to delivering quality digital education and transparent learning experiences. In the event of technical difficulties or enrollment errors, ODDHAY provides a straightforward, student-friendly refund mechanism.
                        </p>
                    </div>

                    <!-- 1. Eligibility Window -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg">schedule</span>
                            <span>1. Eligibility Window</span>
                        </h2>
                        <p class="font-normal">
                            Students can request a refund within <strong>48 hours (2 business days)</strong> of course enrollment if the course does not meet academic expectations or if accidental enrollment occurred.
                        </p>
                    </div>

                    <!-- 2. Applicable Refund Cases -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg">check_circle</span>
                            <span>2. Valid Grounds for Refund</span>
                        </h2>
                        <ul class="list-disc list-inside space-y-1.5 pl-1 font-normal">
                            <li>Duplicate transactions or billing errors where the user was charged more than once for the same course.</li>
                            <li>Payment successfully deducted, but course access remained inactivated for over 24 hours without technical resolution.</li>
                            <li>Less than 5% of course content viewed within 48 hours, subject to valid reason submitted to the helpdesk.</li>
                        </ul>
                    </div>

                    <!-- 3. Non-Refundable Situations -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-amber-500 text-lg">cancel</span>
                            <span>3. Non-Refundable Circumstances</span>
                        </h2>
                        <ul class="list-disc list-inside space-y-1.5 pl-1 font-normal">
                            <li>Requests submitted after the 48-hour eligibility period has elapsed.</li>
                            <li>Courses where significant video lessons were watched, tests attempted, or lecture sheets downloaded.</li>
                            <li>Account suspension resulting from unauthorized credential sharing or violations of platform rules.</li>
                        </ul>
                    </div>

                    <!-- 4. Payout Process -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg">payments</span>
                            <span>4. Payout Timeframe</span>
                        </h2>
                        <p class="font-normal">
                            Approved refunds are issued within <strong>5 to 7 business days</strong> back to the original payment channel (such as bKash, Nagad, Rocket, or Bank Card).
                        </p>
                    </div>

                    <!-- 5. How to Submit a Refund Claim -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg">support_agent</span>
                            <span>5. How to Claim a Refund</span>
                        </h2>
                        <p class="font-normal">
                            Contact ODDHAY support with your registered email, transaction reference ID (TrxID), and reason for refund:
                        </p>
                        <div class="pt-1 flex flex-wrap items-center gap-2.5 text-xs">
                            <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>"
                                class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                            </a>
                            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                            <a href="/contact" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                Contact Helpdesk
                            </a>
                        </div>
                    </div>

                                <!-- 4. Payout Process -->
                                <div
                                    class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-1.5 shadow-2xs">
                                    <h2
                                        class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                                        <span
                                            class="material-symbols-rounded text-emerald-500 text-base">payments</span>
                                        <span>4. Payout Timeframe</span>
                                    </h2>
                                    <p class="font-normal">
                                        Approved refunds are issued within <strong>5 to 7 business days</strong> back to
                                        the original payment channel (such as bKash, Nagad, Rocket, or Bank Card).
                                    </p>
                                </div>

                                <!-- 5. How to Submit a Refund Claim -->
                                <div
                                    class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2 shadow-2xs">
                                    <h2
                                        class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                                        <span
                                            class="material-symbols-rounded text-emerald-500 text-base">support_agent</span>
                                        <span>5. How to Claim a Refund</span>
                                    </h2>
                                    <p class="font-normal">
                                        Contact ODDHAY support with your registered email, transaction reference ID
                                        (TrxID), and reason for refund:
                                    </p>
                                    <div class="pt-1 flex flex-wrap gap-3 text-xs">
                                        <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>"
                                            class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                            <%= (locals.siteSettings && siteSettings.contactInfo &&
                                                siteSettings.contactInfo.email) ? siteSettings.contactInfo.email
                                                : 'support@oddhay.com' %>
                                        </a>
                                        <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                                        <a href="/contact"
                                            class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                                            Contact Helpdesk
                                        </a>
                                    </div>
                                </div>

                            </div>
                            <% } %>

            </div>
        </main>

        <%- include('partials/footer', { lang: 'en' }) %>
</body>

</html>