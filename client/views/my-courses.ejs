<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <% 
    function getImg(path) {
        if(!path) return '';
        if(path.startsWith('http')) return path;
        let normalized = path.replace(/\\/g, '/');
        if (!normalized.startsWith('/')) normalized = '/' + normalized;
        return normalized;
    }

    function getPrice(c) {
        if (!c) return 'Free';
        if (c.accessType === 'paid' || c.accessType === 'Paid') {
            if (c.discountPrice > 0) return '৳' + c.discountPrice;
            if (c.price > 0) return '৳' + c.price;
            if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
            return 'Paid';
        }
        if (c.accessType === 'free' || c.accessType === 'Free') return 'Free';
        if (c.accessType === 'trial' || c.accessType === 'Trial') return 'Trial';
        
        if (c.discountPrice > 0) return '৳' + c.discountPrice;
        if (c.price > 0) return '৳' + c.price;
        if (c.plans && c.plans.length > 0 && c.plans[0].price > 0) return '৳' + c.plans[0].price;
        return 'Free';
    }

    function getPriceIcon(c) {
        const p = getPrice(c);
        if (p === 'Free') return 'auto_awesome';
        return 'sell';
    }
    %>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>My Courses | ODDHAY</title>
    <style>
        .course-card-studio {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .course-card-studio:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            border-color: #cbd5e1;
        }
        .dark .course-card-studio {
            background: #1e293b;
            border-color: #334155;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }
        .dark .course-card-studio:hover {
            border-color: #475569;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }
        .course-card-inner {
            background: transparent;
        }
        .meta-badge {
            background: #f1f5f9;
            color: #64748b;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 800;
            border-radius: 0;
            border: 1px solid #e2e8f0;
            text-transform: uppercase;
        }
        .dark .meta-badge {
            background: #0f172a;
            color: #94a3b8;
            border-color: #334155;
        }
        .btn-studio {
            background: #0f172a;
            color: #fff;
            border-radius: 0;
            font-weight: 800;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }
        .btn-studio:hover {
            background: #334155;
            transform: translateY(-1px);
        }
        .btn-continue {
            background: #10b981 !important;
            color: #fff !important;
        }
        .btn-continue:hover {
            background: #059669 !important;
        }
    </style>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'courses' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120] relative">
            
            <!-- Top Action Bar -->
            <div class="relative w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-3.5 sm:px-4 py-2.5 sm:py-2 m-0 gap-2 shadow-2xs">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="size-8 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-[18px]">school</span>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-sm font-bold text-slate-800 dark:text-slate-100 truncate leading-tight">My Courses</h1>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 truncate hidden sm:block">All your enrolled learning programs</p>
                    </div>
                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/40 px-2 py-0.5 rounded-md shrink-0">
                        <%= (locals.courses || []).length %> Owned
                    </span>
                </div>

                <a href="/courses" class="h-8 px-2.5 sm:px-3 rounded-lg bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center gap-1 text-xs font-bold transition-all active:scale-95 shrink-0 shadow-xs" title="Explore More Courses">
                    <span class="material-symbols-rounded text-sm">explore</span>
                    <span class="text-xs">Explore</span>
                </a>
            </div>

            <!-- CONTENT AREA -->
            <div id="hub-content" class="w-full m-0 p-0 space-y-0 flex flex-col">

                <!-- MY COURSES SECTION -->
                <section id="section-enrolled" class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 rounded-none shadow-none p-3 sm:p-3.5 lg:p-4 min-h-[400px]">

                    <div class="bg-slate-50/70 dark:bg-slate-900/40 lg:bg-[#DCFFF0] lg:dark:bg-[#064e3b]/35 p-2.5 sm:p-3.5 lg:p-4 rounded-2xl lg:rounded-xl border border-slate-200/80 dark:border-slate-800/80 lg:border-[#a7f3d0]/60 lg:dark:border-[#064e3b]/50">
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-3.5 lg:gap-4">
                            <% if(locals.courses && courses.length > 0) { %>
                                <% courses.forEach(ec => { %>
                                    <div class="p-1 course-card-studio course-item group cursor-pointer rounded-2xl lg:rounded-none" data-title="<%= ec.course?.title ? ec.course.title.toLowerCase() : '' %>" data-subject="<%= ec.course?.subject || '' %>" onclick="window.location.href='/course-details/<%= ec.course?._id %>'">
                                        <div class="course-card-inner h-full flex flex-col relative overflow-hidden">
                                            
                                            <!-- Thumbnail -->
                                            <div class="w-full h-36 sm:h-32 md:h-28 bg-slate-50 dark:bg-slate-800/30 relative overflow-hidden rounded-t-xl lg:rounded-none border-b border-slate-100 dark:border-slate-800/50 shrink-0">
                                                <% if (ec.course?.thumbnail) { %>
                                                    <img src="<%= getImg(ec.course.thumbnail) %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                    <div class="hidden w-full h-full items-center justify-center text-slate-300 dark:text-slate-700">
                                                        <span class="material-symbols-rounded text-4xl">auto_stories</span>
                                                    </div>
                                                <% } else { %>
                                                    <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-700">
                                                        <span class="material-symbols-rounded text-4xl opacity-50">auto_stories</span>
                                                    </div>
                                                <% } %>

                                                <!-- Mobile Thumbnail Overlay: Badges -->
                                                <div class="absolute top-2 left-2 right-2 flex items-center justify-between z-10 md:hidden pointer-events-none">
                                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-900/75 text-white backdrop-blur-md border border-white/10 truncate max-w-[130px]">
                                                        <%= ec.course?.subject || 'Course' %>
                                                    </span>
                                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-500 text-white shadow-xs">
                                                        <%= ec.progress || 0 %>% Done
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Content Wrapper -->
                                            <div class="p-3 sm:p-3 flex flex-col flex-1 justify-between">
                                                
                                                <!-- Core Info -->
                                                <div class="flex-1">
                                                    <div class="flex items-start justify-between gap-2 mb-1.5 sm:mb-2">
                                                        <h4 class="text-sm sm:text-[13px] font-bold text-slate-800 dark:text-slate-200 line-clamp-2 leading-snug flex-1"><%= ec.course?.title || 'Untitled Course' %></h4>
                                                        
                                                        <!-- Desktop Donut Progress (md and up) -->
                                                        <div class="hidden md:flex flex-col items-center shrink-0" title="Progress">
                                                            <span class="material-symbols-rounded text-[16px] text-emerald-500 leading-none mb-0.5">donut_large</span>
                                                            <span class="text-[10px] font-black text-slate-700 dark:text-slate-300 leading-none"><%= ec.progress || 0 %>%</span>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="flex flex-wrap gap-1 mb-2">
                                                        <span class="meta-badge text-[9px] sm:text-[8px] px-1.5 py-0.5 rounded-sm lg:rounded-none"><%= ec.course?.classLevel || 'Academic' %></span>
                                                        <span class="meta-badge text-[9px] sm:text-[8px] px-1.5 py-0.5 rounded-sm lg:rounded-none"><%= ec.course?.subject || 'General' %></span>
                                                    </div>

                                                    <!-- Short Details -->
                                                    <p class="text-xs sm:text-[10px] font-medium text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                                        <%= ec.course?.description ? ec.course.description.replace(/(<([^>]+)>)/gi, "") : 'Continue learning and track your progress through this course.' %>
                                                    </p>
                                                </div>

                                                <!-- Mobile Dedicated Progress Bar (< md) -->
                                                <div class="w-full mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/60 md:hidden">
                                                    <div class="flex items-center justify-between text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1">
                                                        <span>কোর্স অগ্রগতি</span>
                                                        <span class="font-bold text-emerald-600 dark:text-emerald-400"><%= ec.progress || 0 %>% সম্পন্ন</span>
                                                    </div>
                                                    <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                        <div class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: <%= Math.min(100, Math.max(0, ec.progress || 0)) %>%"></div>
                                                    </div>
                                                </div>

                                                <!-- Mobile Footer Actions (< md) -->
                                                <div class="mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between gap-2 md:hidden">
                                                    <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                                                        <span class="material-symbols-rounded text-sm">verified</span>
                                                        <span>Enrolled</span>
                                                    </div>
                                                    
                                                    <a href="/course-details/<%= ec.course?._id %>" class="h-8 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white font-bold text-xs flex items-center gap-1 shadow-xs transition-all">
                                                        <span>চালিয়ে যান</span>
                                                        <span class="material-symbols-rounded text-sm leading-none">play_arrow</span>
                                                    </a>
                                                </div>

                                                <!-- Desktop Action Footer (md: and up, exactly preserved) -->
                                                <div class="hidden md:flex pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/50 items-center justify-between">
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-[12px] font-black text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1">
                                                            <span class="material-symbols-rounded text-[14px] text-slate-400"><%= getPriceIcon(ec.course) %></span>
                                                            <%= getPrice(ec.course) %>
                                                        </span>
                                                    </div>
                                                    
                                                    <a href="/course-details/<%= ec.course?._id %>" class="h-7 px-4 btn-studio btn-continue flex items-center justify-center text-[10px]">
                                                        Continue
                                                    </a>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-span-full py-16 sm:py-20 flex flex-col items-center justify-center border border-dashed border-slate-200 dark:border-slate-700 rounded-2xl lg:rounded-none bg-white/60 dark:bg-slate-900/60 p-4 text-center">
                                    <div class="size-14 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center mb-3">
                                        <span class="material-symbols-rounded text-3xl">school</span>
                                    </div>
                                    <h3 class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-200 mb-1">You are not enrolled in any courses yet</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mb-4">Explore our wide selection of academic courses and test preparation bundles to start learning.</p>
                                    <a href="/courses" class="h-9 px-5 rounded-xl lg:rounded-none btn-studio flex items-center justify-center text-xs font-bold gap-1.5 shadow-sm">
                                        <span class="material-symbols-rounded text-sm">explore</span>
                                        <span>Explore Courses</span>
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>

                <!-- Safe clearance for mobile bottom navigation -->
                <div class="h-20 sm:h-24 lg:h-4 w-full shrink-0"></div>
            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'courses' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>