<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Sign In & Register | ODDHAY</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.05);
        }
        .dark input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.1);
        }
        input[name="role"]:checked + .role-card .role-check {
            opacity: 1;
            transform: scale(1);
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Main Auth Card Container (Vertically centered) -->
    <main class="w-full flex-1 flex items-center justify-center my-auto py-6 sm:py-8 relative z-10">
        <div id="authContainer" class="w-full max-w-[410px] mx-auto transition-all duration-300">
            
            <!-- The Form Card -->
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text on Form -->
                <div class="text-center mb-4 sm:mb-5">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- Segmented Tabs: Sign In vs Register -->
                <div class="flex p-1 bg-slate-100 dark:bg-slate-900/90 rounded-xl mb-5 border border-slate-200/80 dark:border-slate-800/80">
                    <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')"
                        class="flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white">
                        <span class="material-symbols-outlined text-base">login</span>
                        <span>Sign In</span>
                    </button>
                    <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')"
                        class="flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
                        <span class="material-symbols-outlined text-base">person_add</span>
                        <span>Register</span>
                    </button>
                </div>

                <!-- Alert: Password Reset Success -->
                <div id="resetSuccessMsg"
                    class="hidden mb-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-base shrink-0 text-emerald-600 dark:text-emerald-400">check_circle</span>
                    <span>Password changed successfully. Please sign in.</span>
                </div>

                <!-- Alert: Server Error -->
                <% if (locals.error) { %>
                    <div id="serverErrorMsg"
                        class="mb-4 p-3.5 rounded-xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- ================= SIGN IN SECTION ================= -->
                <div id="loginSection" class="transition-all duration-200">
                    <h1 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-4 text-center">
                        Sign In
                    </h1>

                    <form action="/login" method="POST" id="loginForm" class="space-y-3.5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Identifier -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email or Phone
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    account_circle
                                </span>
                                <input type="text" name="email" id="loginEmail" placeholder="Email or phone number"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="username">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5 ml-0.5">
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400">
                                    Password
                                </label>
                                <a href="/forgot-password" class="text-xs font-medium text-[#18a957] hover:underline transition-colors">
                                    Forgot?
                                </a>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock
                                </span>
                                <input type="password" name="password" id="loginPasswordInput" placeholder="••••••••"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="current-password">
                                <button type="button" onclick="toggleLoginPassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span id="loginEyeIcon" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center pt-0.5">
                            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" name="remember" class="size-4 rounded text-[#18a957] focus:ring-[#18a957] border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                                <span class="text-xs sm:text-sm font-normal text-slate-600 dark:text-slate-400">Remember me</span>
                            </label>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" id="loginSubmitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="loginBtnText">Sign In</span>
                            <span id="loginBtnIcon" class="material-symbols-outlined text-lg">login</span>
                        </button>
                    </form>

                    <!-- Switch to Register -->
                    <div class="mt-5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Don't have an account? 
                            <a href="/register" onclick="switchAuthTab('register'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign up
                            </a>
                        </p>
                    </div>
                </div>

                <!-- ================= REGISTER SECTION (Single Clean Form, No Steps) ================= -->
                <div id="registerSection" class="hidden transition-all duration-200">
                    <h2 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-4 text-center">
                        Create Account
                    </h2>

                    <form id="registerForm" class="space-y-3.5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Full Name -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Full Name
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    badge
                                </span>
                                <input type="text" name="name" id="regName" placeholder="Full name"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="name">
                            </div>
                        </div>

                        <!-- Email or Phone -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email or Phone
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    contact_phone
                                </span>
                                <input type="text" name="identifier" id="regIdentifier" placeholder="Email or phone number"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="username">
                            </div>
                        </div>

                        <!-- Role & Class -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Role
                            </label>
                            <div class="grid grid-cols-2 gap-2.5">
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="role" value="student" class="hidden" checked>
                                    <div class="role-card p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex items-center justify-center gap-1.5 relative">
                                        <span class="material-symbols-outlined text-lg text-[#18a957]">school</span>
                                        <span class="font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100">Student</span>
                                        <span class="role-check absolute top-1.5 right-1.5 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                    </div>
                                </label>

                                <label class="cursor-pointer relative">
                                    <input type="radio" name="role" value="parent" class="hidden">
                                    <div class="role-card p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex items-center justify-center gap-1.5 relative">
                                        <span class="material-symbols-outlined text-lg text-blue-500">family_restroom</span>
                                        <span class="font-medium text-xs sm:text-sm text-slate-800 dark:text-slate-100">Parent</span>
                                        <span class="role-check absolute top-1.5 right-1.5 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Class Selector -->
                        <div id="classGroup" class="transition-all duration-200">
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Class / Level
                            </label>
                            <%
                                const defaultClassesList = [
                                    'Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'
                                ];
                                let renderedClasses = [];
                                const sourceList = (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0)
                                    ? academicClasses
                                    : ((typeof globalAcademicClasses !== 'undefined' && Array.isArray(globalAcademicClasses) && globalAcademicClasses.length > 0)
                                        ? globalAcademicClasses
                                        : []);
                                if (sourceList.length > 0) {
                                    renderedClasses = sourceList.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                }
                                if (renderedClasses.length === 0) {
                                    renderedClasses = defaultClassesList;
                                }
                            %>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    auto_stories
                                </span>
                                <select name="classLevel" id="classSelect"
                                    class="w-full pl-10 pr-9 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-xs sm:text-sm transition-all outline-none appearance-none cursor-pointer">
                                    <% renderedClasses.forEach(clsName => { %>
                                        <option value="<%= clsName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 py-1.5">
                                            <%= clsName %>
                                        </option>
                                    <% }) %>
                                </select>
                                <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                    <span class="material-symbols-outlined text-base">unfold_more</span>
                                </div>
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Password (min 6 characters)
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock
                                </span>
                                <input type="password" name="password" id="regPassword" placeholder="••••••••" minlength="6"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="new-password">
                                <button type="button" onclick="togglePasswordVisibility('regPassword', 'regEyeIcon1')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span id="regEyeIcon1" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Confirm Password
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock_reset
                                </span>
                                <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="••••••••" minlength="6"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="new-password">
                                <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', 'regEyeIcon2')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span id="regEyeIcon2" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Direct Submit Button -->
                        <button type="submit" id="regSubmitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="regSubmitText">Create Account</span>
                            <span id="regSubmitIcon" class="material-symbols-outlined text-base">how_to_reg</span>
                        </button>
                    </form>

                    <!-- Switch to Sign In -->
                    <div class="mt-5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Already have an account? 
                            <a href="/login" onclick="switchAuthTab('login'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign in
                            </a>
                        </p>
                    </div>
                </div>

            </div>

            <!-- OUT OF THE FORM: Social Login Options (Google & Facebook) -->
            <div class="mt-4 px-1">
                <div class="relative my-3">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-200/80 dark:border-slate-800"></div>
                    </div>
                    <div class="relative flex justify-center text-[11px] sm:text-xs">
                        <span class="bg-slate-50 dark:bg-[#0b1120] px-3 text-slate-400 font-medium">or continue with</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2.5 mt-3">
                    <a href="/auth/google"
                        class="flex items-center justify-center gap-2 h-10 sm:h-10.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-medium transition-all shadow-2xs active:scale-[0.99]"
                        title="Sign in with Google">
                        <svg class="size-4 shrink-0" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span>Google</span>
                    </a>
                    <a href="/auth/facebook"
                        class="flex items-center justify-center gap-2 h-10 sm:h-10.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-medium transition-all shadow-2xs active:scale-[0.99]"
                        title="Sign in with Facebook">
                        <svg class="size-4 shrink-0 fill-[#1877F2]" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        <span>Facebook</span>
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer Copyright (Strictly placed at the very bottom) -->
    <footer class="w-full text-center py-4 mt-auto relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-4 py-2.5 rounded-full bg-red-500 text-white font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-base">error</span>
            <span id="toast-msg">Error occurred</span>
        </div>
    </div>

    <!-- Page Scripts -->
    <script>
        // Tab switching logic
        function switchAuthTab(tab) {
            const loginSection = document.getElementById('loginSection');
            const registerSection = document.getElementById('registerSection');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                loginSection.classList.add('hidden');
                registerSection.classList.remove('hidden');

                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login?tab=register' + (window.location.search.includes('redirect=') ? '&' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            } else {
                registerSection.classList.add('hidden');
                loginSection.classList.remove('hidden');

                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login' + (window.location.search.includes('redirect=') ? '?' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            }
        }

        // Show reset success message if redirected from password reset
        if (new URLSearchParams(window.location.search).get('reset') === 'success') {
            const resetMsg = document.getElementById('resetSuccessMsg');
            if (resetMsg) resetMsg.classList.remove('hidden');
        }

        // Check if opened with register intent
        const urlParams = new URLSearchParams(window.location.search);
        const serverActiveTab = "<%= (typeof activeTab !== 'undefined' ? activeTab : 'login') %>";
        if (urlParams.get('tab') === 'register' || window.location.hash === '#register' || serverActiveTab === 'register') {
            switchAuthTab('register');
        }

        // Password visibility toggle helpers
        function toggleLoginPassword() {
            const input = document.getElementById('loginPasswordInput');
            const icon = document.getElementById('loginEyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // Toast Helper
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-4 py-2.5 rounded-full font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm ${type === 'success' ? 'bg-[#18a957]' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 3500);
        }

        // Login Form Spinner on Submit
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                const btn = document.getElementById('loginSubmitBtn');
                const text = document.getElementById('loginBtnText');
                const icon = document.getElementById('loginBtnIcon');
                if (btn && text) {
                    btn.disabled = true;
                    btn.classList.add('opacity-80', 'cursor-not-allowed');
                    text.textContent = 'Signing in...';
                    if (icon) icon.textContent = 'sync';
                    if (icon) icon.classList.add('animate-spin');
                }
            });
        }

        // Single Registration Form Logic (No Steps)
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('registerForm');
            if (!form) return;

            const submitBtn = document.getElementById('regSubmitBtn');
            const roleRadios = form.querySelectorAll('input[name="role"]');
            const classGroup = document.getElementById('classGroup');
            const classSelect = document.getElementById('classSelect');

            roleRadios.forEach(radio => {
                radio.addEventListener('change', () => {
                    const isParent = radio.value === 'parent';
                    if (classGroup) {
                        if (isParent) {
                            classGroup.classList.add('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = true;
                        } else {
                            classGroup.classList.remove('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = false;
                        }
                    }
                });
            });

            form.onsubmit = async (e) => {
                e.preventDefault();

                const nameInput = document.getElementById('regName');
                const idInput = document.getElementById('regIdentifier');
                const passwordInput = document.getElementById('regPassword');
                const confirmInput = document.getElementById('regConfirmPassword');

                if (!nameInput.value.trim()) {
                    nameInput.classList.add('!border-red-500');
                    return showToast('Please enter your full name');
                } else {
                    nameInput.classList.remove('!border-red-500');
                }

                if (!idInput.value.trim()) {
                    idInput.classList.add('!border-red-500');
                    return showToast('Please enter an email or phone number');
                } else {
                    const raw = idInput.value.trim();
                    const isEmail = raw.includes('@');
                    const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                    const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                    const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;

                    if (isEmail) {
                        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        if (!emailRegex.test(raw)) {
                            idInput.classList.add('!border-red-500');
                            return showToast('Please enter a valid email address');
                        } else {
                            idInput.classList.remove('!border-red-500');
                        }
                    } else {
                        if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                            idInput.classList.add('!border-red-500');
                            return showToast('Please enter a valid 11-digit phone number');
                        } else {
                            idInput.classList.remove('!border-red-500');
                        }
                    }
                }

                if (!passwordInput.value || passwordInput.value.length < 6) {
                    passwordInput.classList.add('!border-red-500');
                    return showToast('Password must be at least 6 characters');
                } else {
                    passwordInput.classList.remove('!border-red-500');
                }

                if (passwordInput.value !== confirmInput.value) {
                    confirmInput.classList.add('!border-red-500');
                    return showToast('Passwords do not match');
                } else {
                    confirmInput.classList.remove('!border-red-500');
                }

                const formData = Object.fromEntries(new FormData(form));

                const submitText = document.getElementById('regSubmitText');
                const submitIcon = document.getElementById('regSubmitIcon');
                const origText = submitText.textContent;

                submitText.textContent = 'Processing...';
                if (submitIcon) {
                    submitIcon.textContent = 'sync';
                    submitIcon.classList.add('animate-spin');
                }
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (typeof confetti === 'function') {
                            confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 }, colors: ['#18a957', '#ffffff', '#3b82f6'] });
                        }
                        showToast('Account created successfully! Redirecting...', 'success');
                        setTimeout(() => {
                            window.location.href = (result.redirect || '/dashboard');
                        }, 1200);
                    } else {
                        showToast(result.error || 'Registration failed');
                        submitText.textContent = origText;
                        if (submitIcon) {
                            submitIcon.textContent = 'how_to_reg';
                            submitIcon.classList.remove('animate-spin');
                        }
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    showToast('Server error, please try again');
                    submitText.textContent = origText;
                    if (submitIcon) {
                        submitIcon.textContent = 'how_to_reg';
                        submitIcon.classList.remove('animate-spin');
                    }
                    submitBtn.disabled = false;
                }
            };
        });
    </script>
</body>

</html>
