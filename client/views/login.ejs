<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Sign In & Register | ODDHAY</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        #authContainer {
            transition: max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.05);
        }
        .dark input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.1);
        }
        input[name="role"]:checked + .role-card .role-check {
            opacity: 1;
            transform: scale(1);
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between py-6 px-4 sm:px-6 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Top Navigation Bar -->
    <header class="w-full max-w-md mx-auto flex items-center justify-between mb-4 sm:mb-6 relative z-20">
        <!-- Back to Home -->
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 backdrop-blur-md shadow-2xs transition-all active:scale-95">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            <span>Home</span>
        </a>

        <!-- Theme Toggle -->
        <button type="button" onclick="if(window.OddhayTheme){window.OddhayTheme.toggle();}"
            class="size-8 sm:size-9 rounded-xl flex items-center justify-center bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white backdrop-blur-md shadow-2xs transition-all active:scale-95"
            title="Toggle theme">
            <span class="material-symbols-outlined theme-icon text-base sm:text-lg">dark_mode</span>
        </button>
    </header>

    <!-- Main Auth Card Container -->
    <main class="w-full flex-1 flex items-center justify-center py-2 relative z-10">
        <div id="authContainer" class="w-full max-w-md mx-auto transition-all duration-300">
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Segmented Tabs: Sign In vs Register -->
                <div class="flex p-1 bg-slate-100 dark:bg-slate-900/90 rounded-xl mb-6 border border-slate-200/80 dark:border-slate-800/80">
                    <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')"
                        class="flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white">
                        <span class="material-symbols-outlined text-base">login</span>
                        <span>Sign In</span>
                    </button>
                    <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')"
                        class="flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
                        <span class="material-symbols-outlined text-base">person_add</span>
                        <span>Register</span>
                    </button>
                </div>

                <!-- Alert: Password Reset Success -->
                <div id="resetSuccessMsg"
                    class="hidden mb-5 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-base shrink-0 text-emerald-600 dark:text-emerald-400">check_circle</span>
                    <span>Password changed successfully. Please sign in.</span>
                </div>

                <!-- Alert: Server Error -->
                <% if (locals.error) { %>
                    <div id="serverErrorMsg"
                        class="mb-5 p-3.5 rounded-xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- ================= SIGN IN SECTION ================= -->
                <div id="loginSection" class="transition-all duration-200">
                    <h1 class="text-xl sm:text-2xl font-semibold text-slate-800 dark:text-white tracking-tight mb-5 text-center">
                        Sign In
                    </h1>

                    <form action="/login" method="POST" id="loginForm" class="space-y-4">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Identifier -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email or Phone
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    account_circle
                                </span>
                                <input type="text" name="email" id="loginEmail" placeholder="Email or phone number"
                                    class="w-full pl-10 pr-3.5 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="username">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5 ml-0.5">
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400">
                                    Password
                                </label>
                                <a href="/forgot-password" class="text-xs font-medium text-[#18a957] hover:underline transition-colors">
                                    Forgot password?
                                </a>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock
                                </span>
                                <input type="password" name="password" id="loginPasswordInput" placeholder="••••••••"
                                    class="w-full pl-10 pr-10 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="current-password">
                                <button type="button" onclick="toggleLoginPassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span id="loginEyeIcon" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center pt-0.5">
                            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" name="remember" class="size-4 rounded text-[#18a957] focus:ring-[#18a957] border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                                <span class="text-xs sm:text-sm font-normal text-slate-600 dark:text-slate-400">Remember me</span>
                            </label>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" id="loginSubmitBtn"
                            class="w-full h-11 sm:h-12 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm sm:text-base flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="loginBtnText">Sign In</span>
                            <span id="loginBtnIcon" class="material-symbols-outlined text-lg">login</span>
                        </button>
                    </form>

                    <!-- Switch to Register -->
                    <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Don't have an account? 
                            <a href="/register" onclick="switchAuthTab('register'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign up
                            </a>
                        </p>
                    </div>
                </div>

                <!-- ================= REGISTER SECTION ================= -->
                <div id="registerSection" class="hidden transition-all duration-200">
                    <!-- Progress Stepper -->
                    <div class="mb-6 px-1">
                        <div class="flex justify-between items-center relative">
                            <div class="absolute h-0.5 w-full bg-slate-200 dark:bg-slate-800 top-1/2 -translate-y-1/2 z-0 rounded-full"></div>
                            <div id="registerProgressBar" class="absolute h-0.5 w-0 bg-[#18a957] top-1/2 -translate-y-1/2 z-0 rounded-full transition-all duration-300"></div>

                            <div class="reg-step-indicator active relative z-10 size-7 sm:size-8 rounded-full bg-[#18a957] text-white border border-[#18a957] flex items-center justify-center font-semibold text-xs transition-all shadow-xs">
                                <span class="step-num">1</span>
                            </div>
                            <div class="reg-step-indicator relative z-10 size-7 sm:size-8 rounded-full bg-white dark:bg-slate-900 text-slate-400 border border-slate-200 dark:border-slate-800 flex items-center justify-center font-semibold text-xs transition-all">
                                <span class="step-num">2</span>
                            </div>
                            <div class="reg-step-indicator relative z-10 size-7 sm:size-8 rounded-full bg-white dark:bg-slate-900 text-slate-400 border border-slate-200 dark:border-slate-800 flex items-center justify-center font-semibold text-xs transition-all">
                                <span class="step-num">3</span>
                            </div>
                        </div>

                        <!-- Step Labels -->
                        <div class="flex justify-between text-[11px] font-medium text-slate-400 dark:text-slate-500 mt-2 px-0.5">
                            <span id="stepLabel1" class="text-[#18a957]">Account</span>
                            <span id="stepLabel2">Role & Class</span>
                            <span id="stepLabel3">Security</span>
                        </div>
                    </div>

                    <h2 id="registerStepTitle" class="text-xl sm:text-2xl font-semibold text-slate-800 dark:text-white tracking-tight mb-5 text-center">
                        Create Account
                    </h2>

                    <form id="registerForm" class="space-y-4">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Step 1: Personal Info -->
                        <div id="regStep1" class="reg-step-content space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Full Name
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        badge
                                    </span>
                                    <input type="text" name="name" id="regName" placeholder="Full name"
                                        class="w-full pl-10 pr-3.5 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Email or Phone
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        contact_phone
                                    </span>
                                    <input type="text" name="identifier" id="regIdentifier" placeholder="Email or phone number"
                                        class="w-full pl-10 pr-3.5 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Role & Class -->
                        <div id="regStep2" class="reg-step-content hidden space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-2 ml-0.5">
                                    Select Role
                                </label>
                                <div class="grid grid-cols-2 gap-3">
                                    <label class="cursor-pointer relative">
                                        <input type="radio" name="role" value="student" class="hidden" checked>
                                        <div class="role-card p-3 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1 relative">
                                            <span class="material-symbols-outlined text-xl text-[#18a957]">school</span>
                                            <span class="font-medium text-sm text-slate-800 dark:text-slate-100">Student</span>
                                            <span class="role-check absolute top-1.5 right-1.5 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                        </div>
                                    </label>

                                    <label class="cursor-pointer relative">
                                        <input type="radio" name="role" value="parent" class="hidden">
                                        <div class="role-card p-3 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1 relative">
                                            <span class="material-symbols-outlined text-xl text-blue-500">family_restroom</span>
                                            <span class="font-medium text-sm text-slate-800 dark:text-slate-100">Parent</span>
                                            <span class="role-check absolute top-1.5 right-1.5 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Class Selector -->
                            <div id="classGroup" class="transition-all duration-200">
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Class / Level
                                </label>
                                <%
                                    const defaultClassesList = [
                                        'Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'
                                    ];
                                    let renderedClasses = [];
                                    const sourceList = (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0)
                                        ? academicClasses
                                        : ((typeof globalAcademicClasses !== 'undefined' && Array.isArray(globalAcademicClasses) && globalAcademicClasses.length > 0)
                                            ? globalAcademicClasses
                                            : []);
                                    if (sourceList.length > 0) {
                                        renderedClasses = sourceList.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                    }
                                    if (renderedClasses.length === 0) {
                                        renderedClasses = defaultClassesList;
                                    }
                                %>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        auto_stories
                                    </span>
                                    <select name="classLevel" id="classSelect"
                                        class="w-full pl-10 pr-9 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base transition-all outline-none appearance-none cursor-pointer">
                                        <% renderedClasses.forEach(clsName => { %>
                                            <option value="<%= clsName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 py-1.5">
                                                <%= clsName %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-lg">unfold_more</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Security / Password -->
                        <div id="regStep3" class="reg-step-content hidden space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Password (min 6 characters)
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        lock
                                    </span>
                                    <input type="password" name="password" id="regPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-10 pr-10 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regPassword', 'regEyeIcon1')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                        title="Show or hide password">
                                        <span id="regEyeIcon1" class="material-symbols-outlined text-lg">visibility</span>
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Confirm Password
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        lock_reset
                                    </span>
                                    <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-10 pr-10 h-11 sm:h-12 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', 'regEyeIcon2')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                        title="Show or hide password">
                                        <span id="regEyeIcon2" class="material-symbols-outlined text-lg">visibility</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Stepper Navigation Buttons -->
                        <div class="flex items-center gap-2.5 pt-2">
                            <button type="button" id="regPrevBtn"
                                class="hidden flex-1 h-11 sm:h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-1 text-xs sm:text-sm active:scale-95">
                                <span class="material-symbols-outlined text-base">west</span>
                                <span>Back</span>
                            </button>

                            <button type="button" id="regNextBtn"
                                class="flex-[2] h-11 sm:h-12 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm sm:text-base flex items-center justify-center gap-1 shadow-sm active:scale-[0.99] transition-all">
                                <span>Next</span>
                                <span class="material-symbols-outlined text-base">east</span>
                            </button>

                            <button type="submit" id="regSubmitBtn"
                                class="hidden flex-[2] h-11 sm:h-12 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm sm:text-base flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.99] transition-all">
                                <span id="regSubmitText">Create Account</span>
                                <span id="regSubmitIcon" class="material-symbols-outlined text-lg">how_to_reg</span>
                            </button>
                        </div>
                    </form>

                    <!-- Switch to Sign In -->
                    <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Already have an account? 
                            <a href="/login" onclick="switchAuthTab('login'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign in
                            </a>
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="w-full max-w-md mx-auto text-center py-4 relative z-10">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-4 py-2.5 rounded-full bg-red-500 text-white font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-base">error</span>
            <span id="toast-msg">Error occurred</span>
        </div>
    </div>

    <!-- Page Scripts -->
    <script>
        // Tab switching logic
        function switchAuthTab(tab) {
            const container = document.getElementById('authContainer');
            const loginSection = document.getElementById('loginSection');
            const registerSection = document.getElementById('registerSection');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                loginSection.classList.add('hidden');
                registerSection.classList.remove('hidden');
                container.classList.remove('max-w-md');
                container.classList.add('max-w-lg');

                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login?tab=register' + (window.location.search.includes('redirect=') ? '&' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            } else {
                registerSection.classList.add('hidden');
                loginSection.classList.remove('hidden');
                container.classList.remove('max-w-lg');
                container.classList.add('max-w-md');

                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login' + (window.location.search.includes('redirect=') ? '?' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            }
        }

        // Show reset success message if redirected from password reset
        if (new URLSearchParams(window.location.search).get('reset') === 'success') {
            const resetMsg = document.getElementById('resetSuccessMsg');
            if (resetMsg) resetMsg.classList.remove('hidden');
        }

        // Check if opened with register intent
        const urlParams = new URLSearchParams(window.location.search);
        const serverActiveTab = "<%= (typeof activeTab !== 'undefined' ? activeTab : 'login') %>";
        if (urlParams.get('tab') === 'register' || window.location.hash === '#register' || serverActiveTab === 'register') {
            switchAuthTab('register');
        }

        // Password visibility toggle helpers
        function toggleLoginPassword() {
            const input = document.getElementById('loginPasswordInput');
            const icon = document.getElementById('loginEyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // Toast Helper
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-4 py-2.5 rounded-full font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm ${type === 'success' ? 'bg-[#18a957]' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 3500);
        }

        // Login Form Spinner on Submit
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                const btn = document.getElementById('loginSubmitBtn');
                const text = document.getElementById('loginBtnText');
                const icon = document.getElementById('loginBtnIcon');
                if (btn && text) {
                    btn.disabled = true;
                    btn.classList.add('opacity-80', 'cursor-not-allowed');
                    text.textContent = 'Signing in...';
                    if (icon) icon.textContent = 'sync';
                    if (icon) icon.classList.add('animate-spin');
                }
            });
        }

        // Multi-Step Registration Logic
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            const form = document.getElementById('registerForm');
            if (!form) return;

            const stepContents = [
                document.getElementById('regStep1'),
                document.getElementById('regStep2'),
                document.getElementById('regStep3')
            ];
            const stepIndicators = document.querySelectorAll('.reg-step-indicator');
            const progressBar = document.getElementById('registerProgressBar');

            const nextBtn = document.getElementById('regNextBtn');
            const prevBtn = document.getElementById('regPrevBtn');
            const submitBtn = document.getElementById('regSubmitBtn');

            const stepLabels = [
                document.getElementById('stepLabel1'),
                document.getElementById('stepLabel2'),
                document.getElementById('stepLabel3')
            ];

            function updateStepUI() {
                stepContents.forEach((sc, idx) => {
                    if (sc) sc.classList.toggle('hidden', idx !== currentStep - 1);
                });

                stepIndicators.forEach((ind, idx) => {
                    const numSpan = ind.querySelector('.step-num');
                    if (idx < currentStep - 1) {
                        ind.className = "reg-step-indicator relative z-10 size-7 sm:size-8 rounded-full bg-[#18a957] text-white border border-[#18a957] flex items-center justify-center font-semibold text-xs transition-all shadow-2xs";
                        if (numSpan) numSpan.innerHTML = '<span class="material-symbols-outlined text-xs">check</span>';
                    } else if (idx === currentStep - 1) {
                        ind.className = "reg-step-indicator active relative z-10 size-7 sm:size-8 rounded-full bg-[#18a957] text-white border border-[#18a957] flex items-center justify-center font-semibold text-xs transition-all shadow-sm ring-2 ring-[#18a957]/20";
                        if (numSpan) numSpan.textContent = String(idx + 1);
                    } else {
                        ind.className = "reg-step-indicator relative z-10 size-7 sm:size-8 rounded-full bg-white dark:bg-slate-900 text-slate-400 border border-slate-200 dark:border-slate-800 flex items-center justify-center font-semibold text-xs transition-all";
                        if (numSpan) numSpan.textContent = String(idx + 1);
                    }
                });

                stepLabels.forEach((label, idx) => {
                    if (label) {
                        if (idx <= currentStep - 1) {
                            label.className = "text-[#18a957] font-semibold";
                        } else {
                            label.className = "text-slate-400 dark:text-slate-500 font-normal";
                        }
                    }
                });

                if (progressBar) {
                    progressBar.style.width = `${((currentStep - 1) / 2) * 100}%`;
                }

                if (prevBtn) prevBtn.classList.toggle('hidden', currentStep === 1);
                if (nextBtn) nextBtn.classList.toggle('hidden', currentStep === 3);
                if (submitBtn) submitBtn.classList.toggle('hidden', currentStep !== 3);
            }

            form.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    if (currentStep < 3) {
                        e.preventDefault();
                        nextBtn.click();
                    }
                }
            });

            if (nextBtn) {
                nextBtn.onclick = () => {
                    let valid = true;
                    let errorMsg = '';

                    if (currentStep === 1) {
                        const nameInput = document.getElementById('regName');
                        const idInput = document.getElementById('regIdentifier');

                        if (!nameInput.value.trim()) {
                            valid = false;
                            nameInput.classList.add('!border-red-500');
                            errorMsg = 'Please enter your full name';
                        } else {
                            nameInput.classList.remove('!border-red-500');
                        }

                        if (!idInput.value.trim()) {
                            valid = false;
                            idInput.classList.add('!border-red-500');
                            errorMsg = errorMsg || 'Please enter an email or phone number';
                        } else {
                            const raw = idInput.value.trim();
                            const isEmail = raw.includes('@');
                            const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                            const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                            const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;

                            if (isEmail) {
                                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                                if (!emailRegex.test(raw)) {
                                    valid = false;
                                    idInput.classList.add('!border-red-500');
                                    errorMsg = 'Please enter a valid email address';
                                } else {
                                    idInput.classList.remove('!border-red-500');
                                }
                            } else {
                                if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                                    valid = false;
                                    idInput.classList.add('!border-red-500');
                                    errorMsg = 'Please enter a valid 11-digit phone number';
                                } else {
                                    idInput.classList.remove('!border-red-500');
                                }
                            }
                        }
                    }

                    if (!valid) {
                        showToast(errorMsg || 'Please complete the required fields');
                        return;
                    }

                    currentStep++;
                    updateStepUI();
                };
            }

            if (prevBtn) {
                prevBtn.onclick = () => {
                    if (currentStep > 1) {
                        currentStep--;
                        updateStepUI();
                    }
                };
            }

            const roleRadios = form.querySelectorAll('input[name="role"]');
            const classGroup = document.getElementById('classGroup');
            const classSelect = document.getElementById('classSelect');

            roleRadios.forEach(radio => {
                radio.addEventListener('change', () => {
                    const isParent = radio.value === 'parent';
                    if (classGroup) {
                        if (isParent) {
                            classGroup.classList.add('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = true;
                        } else {
                            classGroup.classList.remove('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = false;
                        }
                    }
                });
            });

            form.onsubmit = async (e) => {
                e.preventDefault();
                if (currentStep !== 3) {
                    nextBtn.click();
                    return;
                }

                const passwordInput = document.getElementById('regPassword');
                const confirmInput = document.getElementById('regConfirmPassword');

                if (!passwordInput.value || passwordInput.value.length < 6) {
                    passwordInput.classList.add('!border-red-500');
                    return showToast('Password must be at least 6 characters');
                } else {
                    passwordInput.classList.remove('!border-red-500');
                }

                if (passwordInput.value !== confirmInput.value) {
                    confirmInput.classList.add('!border-red-500');
                    return showToast('Passwords do not match');
                } else {
                    confirmInput.classList.remove('!border-red-500');
                }

                const formData = Object.fromEntries(new FormData(form));

                const submitText = document.getElementById('regSubmitText');
                const submitIcon = document.getElementById('regSubmitIcon');
                const origText = submitText.textContent;

                submitText.textContent = 'Processing...';
                if (submitIcon) {
                    submitIcon.textContent = 'sync';
                    submitIcon.classList.add('animate-spin');
                }
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (typeof confetti === 'function') {
                            confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 }, colors: ['#18a957', '#ffffff', '#3b82f6'] });
                        }
                        showToast('Account created successfully! Redirecting...', 'success');
                        setTimeout(() => {
                            window.location.href = (result.redirect || '/dashboard');
                        }, 1200);
                    } else {
                        showToast(result.error || 'Registration failed');
                        submitText.textContent = origText;
                        if (submitIcon) {
                            submitIcon.textContent = 'how_to_reg';
                            submitIcon.classList.remove('animate-spin');
                        }
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    showToast('Server error, please try again');
                    submitText.textContent = origText;
                    if (submitIcon) {
                        submitIcon.textContent = 'how_to_reg';
                        submitIcon.classList.remove('animate-spin');
                    }
                    submitBtn.disabled = false;
                }
            };
        });
    </script>
</body>

</html>
