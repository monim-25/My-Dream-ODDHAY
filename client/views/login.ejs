<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Sign In & Register | ODDHAY</title>
    <%- include('partials/head') %>
        <style>
        #authContainer {
            transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.05);
        }
        .dark input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.1);
        }
        input[name="role"]:checked + .role-card .role-check {
            opacity: 1;
            transform: scale(1);
        }
    
        input[name="group"]:checked + .group-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            font-weight: 600;
        }
        .subject-chip.selected {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            color: #18a957;
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Main Auth Card Container (Vertically centered) -->
    <main class="w-full flex-1 flex items-center justify-center my-auto py-3 sm:py-5 relative z-10">
        <div id="authContainer" class="w-full max-w-[405px] mx-auto transition-all duration-300">
            
            <!-- The Form Card -->
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-5 sm:p-6 pb-4 sm:pb-4.5 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text on Form -->
                <div class="text-center mb-4 sm:mb-5">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- Segmented Tabs: Sign In vs Register -->
                <div class="flex p-1 bg-slate-100 dark:bg-slate-900/90 rounded-xl mb-5 border border-slate-200/80 dark:border-slate-800/80">
                    <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')"
                        class="flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white">
                        <span class="material-symbols-outlined text-base">login</span>
                        <span>Sign In</span>
                    </button>
                    <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')"
                        class="flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
                        <span class="material-symbols-outlined text-base">person_add</span>
                        <span>Register</span>
                    </button>
                </div>

                
                <!-- Alert: Server Error -->
                <% if (locals.error) { %>
                    <div id="serverErrorMsg"
                        class="mb-4 p-3.5 rounded-xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- ================= SIGN IN SECTION ================= -->
                <div id="loginSection" class="transition-all duration-200">
                    <h1 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-4 text-center">
                        Sign In
                    </h1>

                    <form action="/login" method="POST" id="loginForm" class="space-y-3.5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Identifier -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email or Phone
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    account_circle
                                </span>
                                <input type="text" name="email" id="loginEmail" placeholder="Email or phone number"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="username">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5 ml-0.5">
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400">
                                    Password
                                </label>
                                <a href="/forgot-password" class="text-xs font-medium text-[#18a957] hover:underline transition-colors">
                                    Forgot?
                                </a>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock
                                </span>
                                <input type="password" name="password" id="loginPasswordInput" placeholder="••••••••"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="current-password">
                                <button type="button" onclick="toggleLoginPassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span id="loginEyeIcon" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center pt-0.5">
                            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" name="remember" class="size-4 rounded text-[#18a957] focus:ring-[#18a957] border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                                <span class="text-xs sm:text-sm font-normal text-slate-600 dark:text-slate-400">Remember me</span>
                            </label>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" id="loginSubmitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="loginBtnText">Sign In</span>
                            <span id="loginBtnIcon" class="material-symbols-outlined text-lg">login</span>
                        </button>
                    </form>

                    <!-- Switch to Register -->
                    <div class="mt-3.5 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Don't have an account? 
                            <a href="/register" onclick="switchAuthTab('register'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign up
                            </a>
                        </p>
                    </div>
                </div>

                <!-- ================= REGISTER SECTION (Step-by-Step Student Flow) ================= -->
                <div id="registerSection" class="hidden transition-all duration-200">
                    <!-- Subtle Progress Bar (No circles, no text labels) -->
                    <div class="h-1 w-full bg-slate-100 dark:bg-slate-800 rounded-full mb-4 overflow-hidden">
                        <div id="regProgressBar" class="h-full bg-[#18a957] transition-all duration-300" style="width: 20%;"></div>
                    </div>

                    <h2 id="regSectionTitle" class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-1 text-center">
                        Create Account
                    </h2>
                    <p id="regSectionSubtitle" class="text-xs text-slate-500 dark:text-slate-400 mb-4 text-center">
                        Enter your personal details to get started.
                    </p>

                    <form id="registerForm" class="space-y-3.5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- ================= Step 1: Personal Info ================= -->
                        <div id="regStep1" class="reg-step space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Full Name
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        badge
                                    </span>
                                    <input type="text" name="name" id="regName" placeholder="Full name"
                                        class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="name">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Email or Phone
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        contact_phone
                                    </span>
                                    <input type="text" name="identifier" id="regIdentifier" placeholder="Email or phone number"
                                        class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="username">
                                </div>
                            </div>
                        </div>

                        <!-- ================= Step 2: Class & Group (Group appears ONLY if available for class) ================= -->
                        <div id="regStep2" class="reg-step hidden space-y-3.5">
                            <!-- Class Selector -->
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Class / Level
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        auto_stories
                                    </span>
                                    <select name="classLevel" id="classSelect"
                                        class="w-full pl-10 pr-9 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-xs sm:text-sm transition-all outline-none appearance-none cursor-pointer">
                                        <% 
                                            const defaultClasses = ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12'];
                                            let classesList = defaultClasses;
                                            if (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0) {
                                                classesList = academicClasses.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                            }
                                            classesList.forEach(cName => {
                                        %>
                                            <option value="<%= cName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 py-1.5">
                                                <%= cName %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-base">unfold_more</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Group Selector (Appears ONLY if class has groups configured by Superadmin) -->
                            <div id="regGroupContainer" class="hidden transition-all duration-200">
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Study Group <span class="text-red-500">*</span>
                                </label>
                                <div class="grid grid-cols-3 gap-2" id="groupCardsContainer">
                                    <!-- Rendered dynamically based on Superadmin class groups -->
                                </div>
                            </div>
                        </div>

                        <!-- ================= Step 3: Subject Selection (Dedicated Separate Step) ================= -->
                        <div id="regStep3" class="reg-step hidden space-y-3.5">
                            <div class="flex items-center justify-between mb-1.5 ml-0.5">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                    Choose Group Subjects (<span id="selectedSubCount">0</span> selected)
                                </label>
                                <button type="button" onclick="toggleAllSubjects()" id="selectAllBtn" class="text-[11px] text-[#18a957] hover:underline font-medium">
                                    Select All
                                </button>
                            </div>
                            <div id="subjectsListWrapper" class="max-h-52 overflow-y-auto p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-wrap gap-1.5">
                                <!-- ONLY group subjects added by Superadmin for this group appear here -->
                            </div>
                        </div>

                        <!-- ================= Step 4: OTP Verification ================= -->
                        <div id="regStep4" class="reg-step hidden space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    6-Digit OTP Code
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        pin
                                    </span>
                                    <input type="text" id="regOtpInput" placeholder="••••••" maxlength="6" inputmode="numeric" pattern="[0-9]*"
                                        class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-mono text-center text-lg tracking-[0.4em] placeholder:tracking-normal placeholder:font-normal placeholder:text-slate-400 transition-all outline-none"
                                        autocomplete="one-time-code">
                                </div>
                            </div>

                            <div class="flex items-center justify-between text-xs pt-1 text-slate-500 dark:text-slate-400">
                                <span>Didn't receive OTP?</span>
                                <button type="button" id="regResendOtpBtn" onclick="resendRegOtp()" disabled
                                    class="text-slate-400 font-medium transition-colors disabled:cursor-not-allowed">
                                    <span>Resend OTP</span>
                                    <span id="regCountdownText" class="ml-1 text-slate-400 font-mono">(60s)</span>
                                </button>
                            </div>
                        </div>

                        <!-- ================= Step 5: Password & Complete ================= -->
                        <div id="regStep5" class="reg-step hidden space-y-3.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Password (min 6 characters)
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        lock
                                    </span>
                                    <input type="password" name="password" id="regPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regPassword', 'regEyeIcon1')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                        title="Show or hide password">
                                        <span id="regEyeIcon1" class="material-symbols-outlined text-lg">visibility</span>
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                    Confirm Password
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                        lock_reset
                                    </span>
                                    <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', 'regEyeIcon2')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                        title="Show or hide password">
                                        <span id="regEyeIcon2" class="material-symbols-outlined text-lg">visibility</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Step Navigation Action Buttons -->
                        <div class="flex items-center gap-2.5 pt-2">
                            <button type="button" id="regPrevBtn"
                                class="hidden flex-1 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-1 text-xs sm:text-sm active:scale-95">
                                <span class="material-symbols-outlined text-base">west</span>
                                <span>Back</span>
                            </button>

                            <button type="button" id="regNextBtn"
                                class="flex-[2] h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-1 shadow-sm active:scale-[0.99] transition-all">
                                <span id="regNextBtnText">Next</span>
                                <span id="regNextBtnIcon" class="material-symbols-outlined text-base">east</span>
                            </button>

                            <button type="submit" id="regSubmitBtn"
                                class="hidden flex-[2] h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.99] transition-all">
                                <span id="regSubmitText">Create Account</span>
                                <span id="regSubmitIcon" class="material-symbols-outlined text-base">how_to_reg</span>
                            </button>
                        </div>
                    </form>

                    <!-- Switch to Sign In -->
                    <div class="mt-3.5 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Already have an account? 
                            <a href="/login" onclick="switchAuthTab('login'); return false;" class="text-[#18a957] hover:underline font-medium ml-1">
                                Sign in
                            </a>
                        </p>
                    </div>
                </div>

            </div>

            <!-- Social Login Options: Downside the Form (Minimal Gap) -->
            <div class="mt-2 px-0.5">
                <div class="relative my-1.5">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-200/80 dark:border-slate-800"></div>
                    </div>
                    <div class="relative flex justify-center text-[11px]">
                        <span class="bg-slate-50 dark:bg-[#0b1120] px-2.5 text-slate-400 font-normal">or continue with</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 mt-1.5">
                    <a href="/auth/google"
                        class="flex items-center justify-center gap-1.5 h-9 sm:h-9.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-medium transition-all shadow-2xs active:scale-[0.99]"
                        title="Sign in with Google">
                        <svg class="size-3.5 sm:size-4 shrink-0" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span>Google</span>
                    </a>
                    <a href="/auth/facebook"
                        class="flex items-center justify-center gap-1.5 h-9 sm:h-9.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-medium transition-all shadow-2xs active:scale-[0.99]"
                        title="Sign in with Facebook">
                        <svg class="size-3.5 sm:size-4 shrink-0 fill-[#1877F2]" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        <span>Facebook</span>
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer Copyright (Strictly placed at the very bottom) -->
    <footer class="w-full text-center py-3 mt-auto relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-4 py-2.5 rounded-full bg-red-500 text-white font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-base">error</span>
            <span id="toast-msg">Error occurred</span>
        </div>
    </div>

    
    <!-- Academic Data from Superadmin -->
    <script id="academicClassesData" type="application/json">
        <%- JSON.stringify(academicClasses || []) %>
    </script>
<!-- Page Scripts -->
    <script>
        // Tab switching logic
        function switchAuthTab(tab) {
            const loginSection = document.getElementById('loginSection');
            const registerSection = document.getElementById('registerSection');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                loginSection.classList.add('hidden');
                registerSection.classList.remove('hidden');

                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login?tab=register' + (window.location.search.includes('redirect=') ? '&' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            } else {
                registerSection.classList.add('hidden');
                loginSection.classList.remove('hidden');

                tabBtnLogin.className = "flex-1 py-2 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 shadow-xs bg-[#18a957] text-white";
                tabBtnRegister.className = "flex-1 py-2 rounded-lg font-medium text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login' + (window.location.search.includes('redirect=') ? '?' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            }
        }

        
        // Check if opened with register intent
        const urlParams = new URLSearchParams(window.location.search);
        const serverActiveTab = "<%= (typeof activeTab !== 'undefined' ? activeTab : 'login') %>";
        if (urlParams.get('tab') === 'register' || window.location.hash === '#register' || serverActiveTab === 'register') {
            switchAuthTab('register');
        }

        // Password visibility toggle helpers
        function toggleLoginPassword() {
            const input = document.getElementById('loginPasswordInput');
            const icon = document.getElementById('loginEyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // Toast Helper
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-4 py-2.5 rounded-full font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm ${type === 'success' ? 'bg-[#18a957]' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 3500);
        }

        // Login Form Spinner on Submit
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                const btn = document.getElementById('loginSubmitBtn');
                const text = document.getElementById('loginBtnText');
                const icon = document.getElementById('loginBtnIcon');
                if (btn && text) {
                    btn.disabled = true;
                    btn.classList.add('opacity-80', 'cursor-not-allowed');
                    text.textContent = 'Signing in...';
                    if (icon) icon.textContent = 'sync';
                    if (icon) icon.classList.add('animate-spin');
                }
            });
        }

        // Step-by-Step Registration Logic (Student, Class/Group, Dedicated Subjects Step, OTP, Password)
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            let otpSent = false;
            let otpVerified = false;
            let regCountdownTimer = null;
            let regCountdownSeconds = 60;
            let currentIdentifier = '';
            let currentMaskedTarget = '';
            let currentCompulsorySubjects = [];

            const form = document.getElementById('registerForm');
            if (!form) return;

            const steps = [
                document.getElementById('regStep1'),
                document.getElementById('regStep2'),
                document.getElementById('regStep3'),
                document.getElementById('regStep4'),
                document.getElementById('regStep5')
            ];
            const progressBar = document.getElementById('regProgressBar');
            const nextBtn = document.getElementById('regNextBtn');
            const nextBtnText = document.getElementById('regNextBtnText');
            const nextBtnIcon = document.getElementById('regNextBtnIcon');
            const prevBtn = document.getElementById('regPrevBtn');
            const submitBtn = document.getElementById('regSubmitBtn');

            const sectionTitle = document.getElementById('regSectionTitle');
            const sectionSubtitle = document.getElementById('regSectionSubtitle');

            // Parse Academic Data from Superadmin
            let academicClasses = [];
            try {
                const rawAcademic = document.getElementById('academicClassesData');
                if (rawAcademic) {
                    academicClasses = JSON.parse(rawAcademic.textContent || '[]');
                }
            } catch (e) {
                console.error('Error parsing academic classes data:', e);
            }

            // Fallback default curricula if DB classes are minimal
            const sscCommon = ['Bangla', 'English', 'Mathematics', 'ICT', 'Religion', 'Bangladesh & Global Studies'];
            const sscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Finance & Banking', 'Business Entrepreneurship', 'General Science'],
                'Humanities': ['History of Bangladesh & World Civilization', 'Geography & Environment', 'Civics & Citizenship', 'Economics', 'General Science']
            };
            const hscCommon = ['Bangla', 'English', 'ICT'];
            const hscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Business Organization & Management', 'Finance, Banking & Insurance', 'Economics'],
                'Humanities': ['Economics', 'Civics & Good Governance', 'History', 'Logic', 'Sociology']
            };

            const classSelect = document.getElementById('classSelect');
            const groupContainer = document.getElementById('regGroupContainer');
            const groupCardsContainer = document.getElementById('groupCardsContainer');
            const subjectsWrapper = document.getElementById('subjectsListWrapper');
            const selectedSubCount = document.getElementById('selectedSubCount');

            // Determine if selected class has groups configured by Superadmin
            function classHasGroups(clsName) {
                if (!clsName) return false;
                const matchDoc = academicClasses.find(c => c.name === clsName);
                if (matchDoc && typeof matchDoc.hasGroups === 'boolean') {
                    return matchDoc.hasGroups;
                }
                // Fallback for Class 9, 10, 11, 12
                return /\b(9|10|11|12)\b/.test(clsName) || /(ssc|hsc)/i.test(clsName);
            }

            // Render group cards based on Superadmin data
            function updateGroupCards() {
                if (!groupCardsContainer) return;
                const selectedClass = classSelect ? classSelect.value : '';
                const hasGroups = classHasGroups(selectedClass);

                if (!hasGroups) {
                    if (groupContainer) groupContainer.classList.add('hidden');
                    return;
                }

                if (groupContainer) groupContainer.classList.remove('hidden');

                const classDoc = academicClasses.find(c => c.name === selectedClass);
                let groupsList = [];

                if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                    groupsList = classDoc.groups.map(g => g.name).filter(Boolean);
                }

                if (groupsList.length === 0) {
                    groupsList = ['Science', 'Commerce', 'Humanities'];
                }

                // Render radio cards for groups
                const currentChecked = form.querySelector('input[name="group"]:checked')?.value || groupsList[0];
                groupCardsContainer.innerHTML = '';
                groupCardsContainer.className = `grid grid-cols-${Math.min(groupsList.length, 3)} gap-2`;

                groupsList.forEach((grpName, i) => {
                    const isChecked = grpName.toLowerCase() === currentChecked.toLowerCase() || (i === 0 && !currentChecked);
                    const iconName = grpName.toLowerCase().includes('sci') ? 'biotech'
                        : grpName.toLowerCase().includes('comm') || grpName.toLowerCase().includes('bus') ? 'trending_up'
                        : 'menu_book';
                    const iconColor = grpName.toLowerCase().includes('sci') ? 'text-[#18a957]'
                        : grpName.toLowerCase().includes('comm') ? 'text-blue-500'
                        : 'text-amber-500';

                    const label = document.createElement('label');
                    label.className = 'cursor-pointer relative';
                    label.innerHTML = `
                        <input type="radio" name="group" value="${grpName}" class="hidden group-radio" ${isChecked ? 'checked' : ''}>
                        <div class="group-card p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-lg ${iconColor}">${iconName}</span>
                            <span class="font-medium text-[11px] sm:text-xs text-slate-800 dark:text-slate-200">${grpName}</span>
                        </div>
                    `;
                    groupCardsContainer.appendChild(label);
                });

                // Attach change listeners to new group radios
                const newRadios = groupCardsContainer.querySelectorAll('input[name="group"]');
                newRadios.forEach(r => {
                    r.addEventListener('change', () => {
                        updateSubjectsList();
                    });
                });
            }

            // Render subjects in Step 3: Compulsory auto-added in background, ONLY group subjects selectable
            function updateSubjectsList() {
                if (!subjectsWrapper) return;
                const selectedClass = classSelect ? classSelect.value : 'Class 10';
                const hasGroups = classHasGroups(selectedClass);
                const activeGroupRadio = form.querySelector('input[name="group"]:checked');
                const selectedGroup = (activeGroupRadio ? activeGroupRadio.value : 'Science').trim();

                let groupSubsToRender = [];
                currentCompulsorySubjects = [];
                const classDoc = academicClasses.find(c => c.name === selectedClass);

                if (hasGroups) {
                    // 1. Resolve Compulsory Subjects (Auto-Enrolled from Superadmin in background)
                    if (classDoc && Array.isArray(classDoc.commonSubjects) && classDoc.commonSubjects.length > 0) {
                        currentCompulsorySubjects = classDoc.commonSubjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        const isHsc = /11|12/i.test(selectedClass);
                        currentCompulsorySubjects = isHsc ? hscCommon : sscCommon;
                    }

                    // 2. Resolve ONLY Group Subjects added by Superadmin for this group
                    if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                        const grp = classDoc.groups.find(g => (g.name || '').toLowerCase() === selectedGroup.toLowerCase());
                        if (grp && Array.isArray(grp.subjects) && grp.subjects.length > 0) {
                            groupSubsToRender = grp.subjects.map(s => String(s).trim()).filter(Boolean);
                        }
                    }

                    if (groupSubsToRender.length === 0) {
                        const isHsc = /11|12/i.test(selectedClass);
                        const groupPool = isHsc ? hscGroupsData : sscGroupsData;
                        groupSubsToRender = groupPool[selectedGroup] || groupPool['Science'] || [];
                    }

                    // Remove any compulsory subjects from the group choices
                    const compSet = new Set(currentCompulsorySubjects.map(s => s.toLowerCase()));
                    groupSubsToRender = groupSubsToRender.filter(s => !compSet.has(s.toLowerCase()));

                } else {
                    // Class without groups (Class 6-8): All class subjects are compulsory / auto-assigned
                    if (classDoc && Array.isArray(classDoc.subjects) && classDoc.subjects.length > 0) {
                        currentCompulsorySubjects = classDoc.subjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        currentCompulsorySubjects = ['Bangla', 'English', 'Mathematics', 'Science', 'ICT', 'Religion', 'General Science'];
                    }
                    groupSubsToRender = [];
                }

                // Render ONLY Group Elective Subjects as Interactive Checkbox Chips
                subjectsWrapper.innerHTML = '';
                if (groupSubsToRender.length === 0) {
                    if (hasGroups) {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-400">No elective group subjects configured.</div>';
                    } else {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-500 dark:text-slate-400">All subjects for this class are compulsory and auto-assigned. Click Next to continue.</div>';
                    }
                } else {
                    groupSubsToRender.forEach(sub => {
                        const label = document.createElement('label');
                        label.className = 'subject-chip selected inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[#18a957] bg-[#18a957]/10 text-slate-800 dark:text-slate-100 text-xs font-medium cursor-pointer transition-all select-none hover:opacity-90';
                        label.innerHTML = `
                            <input type="checkbox" name="subjects" value="${sub}" checked class="hidden subject-checkbox">
                            <span class="material-symbols-outlined text-xs text-[#18a957] chip-icon">check</span>
                            <span>${sub}</span>
                        `;

                        const checkbox = label.querySelector('.subject-checkbox');
                        const icon = label.querySelector('.chip-icon');

                        label.addEventListener('click', (e) => {
                            e.preventDefault();
                            checkbox.checked = !checkbox.checked;
                            if (checkbox.checked) {
                                label.className = 'subject-chip selected inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[#18a957] bg-[#18a957]/10 text-slate-800 dark:text-slate-100 text-xs font-medium cursor-pointer transition-all select-none hover:opacity-90';
                                icon.textContent = 'check';
                                icon.className = 'material-symbols-outlined text-xs text-[#18a957] chip-icon';
                            } else {
                                label.className = 'subject-chip inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60 text-slate-500 dark:text-slate-400 text-xs font-normal cursor-pointer transition-all select-none hover:border-slate-400';
                                icon.textContent = 'add';
                                icon.className = 'material-symbols-outlined text-xs text-slate-400 chip-icon';
                            }
                            updateSelectedCount();
                        });

                        subjectsWrapper.appendChild(label);
                    });
                }

                updateSelectedCount();
            }

            function updateSelectedCount() {
                const checked = form.querySelectorAll('input[name="subjects"]:checked');
                if (selectedSubCount) {
                    selectedSubCount.textContent = checked.length;
                }
            }

            window.toggleAllSubjects = function () {
                const checkboxes = form.querySelectorAll('.subject-checkbox');
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                checkboxes.forEach(cb => {
                    cb.checked = !allChecked;
                    const label = cb.closest('.subject-chip');
                    const icon = label.querySelector('.chip-icon');
                    if (cb.checked) {
                        label.className = 'subject-chip selected inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[#18a957] bg-[#18a957]/10 text-slate-800 dark:text-slate-100 text-xs font-medium cursor-pointer transition-all select-none hover:opacity-90';
                        icon.textContent = 'check';
                        icon.className = 'material-symbols-outlined text-xs text-[#18a957] chip-icon';
                    } else {
                        label.className = 'subject-chip inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60 text-slate-500 dark:text-slate-400 text-xs font-normal cursor-pointer transition-all select-none hover:border-slate-400';
                        icon.textContent = 'add';
                        icon.className = 'material-symbols-outlined text-xs text-slate-400 chip-icon';
                    }
                });
                updateSelectedCount();
            };

            // On class change
            if (classSelect) {
                classSelect.addEventListener('change', () => {
                    updateGroupCards();
                    updateSubjectsList();
                });
            }

            // Initial setup
            if (classSelect) {
                updateGroupCards();
                updateSubjectsList();
            }

            // Real-time numeric sanitizer for 6-digit OTP input
            const regOtpEl = document.getElementById('regOtpInput');
            if (regOtpEl) {
                regOtpEl.addEventListener('input', function () {
                    const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                    this.value = this.value.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/\D/g, '').slice(0, 6);
                    if (this.value.length === 6) {
                        this.classList.remove('!border-red-500');
                    }
                });
            }

            function updateStepUI() {
                steps.forEach((s, idx) => {
                    if (s) s.classList.toggle('hidden', idx !== currentStep - 1);
                });

                if (progressBar) {
                    progressBar.style.width = (currentStep / 5 * 100) + '%';
                }

                // Update headers per step
                if (currentStep === 1) {
                    sectionTitle.textContent = 'Create Account';
                    sectionSubtitle.textContent = 'Enter your personal details to get started.';
                } else if (currentStep === 2) {
                    sectionTitle.textContent = 'Class & Group';
                    const hasGroups = classHasGroups(classSelect ? classSelect.value : '');
                    sectionSubtitle.textContent = hasGroups ? 'Select your academic class and study group.' : 'Select your academic class.';
                } else if (currentStep === 3) {
                    sectionTitle.textContent = 'Select Subjects';
                    const selectedClass = classSelect ? classSelect.value : '';
                    const activeGroupRadio = form.querySelector('input[name="group"]:checked');
                    const hasGroups = classHasGroups(selectedClass);
                    sectionSubtitle.textContent = hasGroups && activeGroupRadio 
                        ? `Choose your ${activeGroupRadio.value} group subjects for ${selectedClass}`
                        : `Subjects for ${selectedClass}`;
                } else if (currentStep === 4) {
                    sectionTitle.textContent = 'Verify OTP';
                    sectionSubtitle.innerHTML = currentMaskedTarget 
                        ? `Enter the 6-digit OTP sent to <span class="font-medium text-slate-800 dark:text-slate-200">${currentMaskedTarget}</span>.`
                        : 'Enter the 6-digit OTP sent to your contact.';
                } else if (currentStep === 5) {
                    sectionTitle.textContent = 'Set Password';
                    sectionSubtitle.textContent = 'Create a strong password to secure your account.';
                }

                if (prevBtn) prevBtn.classList.toggle('hidden', currentStep === 1);
                if (nextBtn) nextBtn.classList.toggle('hidden', currentStep === 5);
                if (submitBtn) submitBtn.classList.toggle('hidden', currentStep !== 5);

                if (currentStep === 4) {
                    nextBtnText.textContent = 'Verify OTP';
                    nextBtnIcon.textContent = 'verified';
                } else {
                    nextBtnText.textContent = 'Next';
                    nextBtnIcon.textContent = 'east';
                }
            }

            // Countdown timer for registration OTP
            function startRegCountdown() {
                clearInterval(regCountdownTimer);
                regCountdownSeconds = 60;
                const resendBtn = document.getElementById('regResendOtpBtn');
                const countdownText = document.getElementById('regCountdownText');
                if (!resendBtn || !countdownText) return;
                resendBtn.disabled = true;
                resendBtn.className = 'text-slate-400 font-medium transition-colors cursor-not-allowed';
                countdownText.textContent = `(${regCountdownSeconds}s)`;

                regCountdownTimer = setInterval(() => {
                    regCountdownSeconds--;
                    if (regCountdownSeconds <= 0) {
                        clearInterval(regCountdownTimer);
                        resendBtn.disabled = false;
                        resendBtn.className = 'text-[#18a957] hover:underline font-medium cursor-pointer transition-colors';
                        countdownText.textContent = '';
                    } else {
                        countdownText.textContent = `(${regCountdownSeconds}s)`;
                    }
                }, 1000);
            }

            // Resend OTP handler
            window.resendRegOtp = async function () {
                const resendBtn = document.getElementById('regResendOtpBtn');
                if (!currentIdentifier) return;
                if (resendBtn) resendBtn.disabled = true;

                try {
                    const res = await fetch('/register/send-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                            name: document.getElementById('regName').value.trim(),
                            identifier: currentIdentifier
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        currentMaskedTarget = data.maskedTarget || currentIdentifier;
                        showToast('A new OTP has been sent!', 'success');
                        updateStepUI();
                        startRegCountdown();
                    } else {
                        showToast(data.error || 'Failed to resend OTP');
                        if (resendBtn) resendBtn.disabled = false;
                    }
                } catch (e) {
                    showToast('Network error while resending');
                    if (resendBtn) resendBtn.disabled = false;
                }
            };

            // Keyboard Enter navigation
            form.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    if (currentStep < 5) {
                        e.preventDefault();
                        nextBtn.click();
                    }
                }
            });

            // Next button handler
            if (nextBtn) {
                nextBtn.onclick = async () => {
                    // STEP 1 VALIDATION: Personal Info
                    if (currentStep === 1) {
                        const nameInput = document.getElementById('regName');
                        const idInput = document.getElementById('regIdentifier');

                        if (!nameInput.value.trim()) {
                            nameInput.classList.add('!border-red-500');
                            return showToast('Please enter your full name');
                        } else {
                            nameInput.classList.remove('!border-red-500');
                        }

                        if (!idInput.value.trim()) {
                            idInput.classList.add('!border-red-500');
                            return showToast('Please enter an email or phone number');
                        }

                        const raw = idInput.value.trim();
                        const isEmail = raw.includes('@');
                        const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                        const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                        const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;

                        if (isEmail) {
                            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                            if (!emailRegex.test(raw)) {
                                idInput.classList.add('!border-red-500');
                                return showToast('Please enter a valid email address');
                            } else {
                                idInput.classList.remove('!border-red-500');
                            }
                        } else {
                            if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                                idInput.classList.add('!border-red-500');
                                return showToast('Please enter a valid 11-digit phone number');
                            } else {
                                idInput.classList.remove('!border-red-500');
                            }
                        }

                        currentIdentifier = raw;
                        currentStep = 2;
                        updateGroupCards();
                        updateStepUI();
                        return;
                    }

                    // STEP 2 VALIDATION: Class & Group (if group available) -> Move to Subject Selection in Another Step
                    if (currentStep === 2) {
                        const selectedClass = classSelect ? classSelect.value : '';
                        if (!selectedClass) {
                            return showToast('Please select your class');
                        }

                        const hasGroups = classHasGroups(selectedClass);
                        const activeGroupRadio = form.querySelector('input[name="group"]:checked');
                        if (hasGroups && !activeGroupRadio) {
                            return showToast('Please select your study group (Science, Commerce, or Humanities)');
                        }

                        // Prepare Subjects for Step 3
                        updateSubjectsList();
                        currentStep = 3;
                        updateStepUI();
                        return;
                    }

                    // STEP 3 VALIDATION: Subject Selection -> Send OTP Code
                    if (currentStep === 3) {
                        const selectedClass = classSelect ? classSelect.value : '';
                        const hasGroups = classHasGroups(selectedClass);
                        const groupCheckboxes = form.querySelectorAll('input[name="subjects"]');
                        const checkedGroupSubjects = form.querySelectorAll('input[name="subjects"]:checked');

                        // If class has groups and has group subjects, ensure student picks at least one group subject
                        if (hasGroups && groupCheckboxes.length > 0 && checkedGroupSubjects.length === 0) {
                            return showToast('Please select at least one group subject');
                        }

                        // Send OTP via API before moving to Step 4
                        const origText = nextBtnText.textContent;
                        nextBtn.disabled = true;
                        nextBtnText.textContent = 'Sending OTP...';
                        nextBtnIcon.textContent = 'sync';
                        nextBtnIcon.classList.add('animate-spin');

                        try {
                            const res = await fetch('/register/send-otp', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({
                                    name: document.getElementById('regName').value.trim(),
                                    identifier: currentIdentifier
                                })
                            });

                            const data = await res.json();
                            if (data.success) {
                                otpSent = true;
                                currentMaskedTarget = data.maskedTarget || currentIdentifier;
                                showToast('OTP sent successfully!', 'success');
                                currentStep = 4;
                                updateStepUI();
                                startRegCountdown();
                                const otpField = document.getElementById('regOtpInput');
                                if (otpField) {
                                    otpField.value = '';
                                    otpField.focus();
                                }
                            } else {
                                showToast(data.error || 'Failed to send OTP');
                            }
                        } catch (err) {
                            showToast('Network error, please try again');
                        } finally {
                            nextBtn.disabled = false;
                            nextBtnText.textContent = origText;
                            nextBtnIcon.textContent = 'east';
                            nextBtnIcon.classList.remove('animate-spin');
                        }
                        return;
                    }

                    // STEP 4 VALIDATION: Prove / Verify OTP Only
                    if (currentStep === 4) {
                        const otpInput = document.getElementById('regOtpInput');
                        const otp = otpInput ? otpInput.value.trim() : '';

                        if (!otp || otp.length !== 6) {
                            otpInput.classList.add('!border-red-500');
                            return showToast('Please enter the 6-digit OTP');
                        } else {
                            otpInput.classList.remove('!border-red-500');
                        }

                        const origText = nextBtnText.textContent;
                        nextBtn.disabled = true;
                        nextBtnText.textContent = 'Verifying OTP...';
                        nextBtnIcon.textContent = 'sync';
                        nextBtnIcon.classList.add('animate-spin');

                        try {
                            const res = await fetch('/register/verify-otp', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({
                                    identifier: currentIdentifier,
                                    otp: otp
                                })
                            });

                            const data = await res.json();
                            if (data.success) {
                                otpVerified = true;
                                showToast('OTP confirmed successfully!', 'success');
                                currentStep = 5;
                                updateStepUI();
                                const pwField = document.getElementById('regPassword');
                                if (pwField) pwField.focus();
                            } else {
                                otpInput.classList.add('!border-red-500');
                                showToast(data.error || 'Invalid or expired OTP');
                            }
                        } catch (err) {
                            showToast('Network error, please try again');
                        } finally {
                            nextBtn.disabled = false;
                            nextBtnText.textContent = origText;
                            nextBtnIcon.textContent = 'verified';
                            nextBtnIcon.classList.remove('animate-spin');
                        }
                        return;
                    }
                };
            }

            // Previous button handler
            if (prevBtn) {
                prevBtn.onclick = () => {
                    if (currentStep > 1) {
                        currentStep--;
                        updateStepUI();
                    }
                };
            }

            // STEP 5: Form Submit (Password & Create Account)
            form.onsubmit = async (e) => {
                e.preventDefault();
                if (currentStep !== 5) {
                    nextBtn.click();
                    return;
                }

                const passwordInput = document.getElementById('regPassword');
                const confirmInput = document.getElementById('regConfirmPassword');

                if (!passwordInput.value || passwordInput.value.length < 6) {
                    passwordInput.classList.add('!border-red-500');
                    return showToast('Password must be at least 6 characters');
                } else {
                    passwordInput.classList.remove('!border-red-500');
                }

                if (passwordInput.value !== confirmInput.value) {
                    confirmInput.classList.add('!border-red-500');
                    return showToast('Passwords do not match');
                } else {
                    confirmInput.classList.remove('!border-red-500');
                }

                // Gather compulsory + checked group subjects
                const checkedGroupSubs = Array.from(form.querySelectorAll('input[name="subjects"]:checked')).map(cb => cb.value);
                const allSelectedSubjects = Array.from(new Set([...currentCompulsorySubjects, ...checkedGroupSubs]));
                const activeGroup = form.querySelector('input[name="group"]:checked');

                const payload = {
                    name: document.getElementById('regName').value.trim(),
                    identifier: currentIdentifier,
                    classLevel: classSelect ? classSelect.value : '',
                    group: activeGroup ? activeGroup.value : 'General',
                    subjects: allSelectedSubjects,
                    password: passwordInput.value,
                    confirmPassword: confirmInput.value
                };

                const submitText = document.getElementById('regSubmitText');
                const submitIcon = document.getElementById('regSubmitIcon');
                const origText = submitText.textContent;

                submitText.textContent = 'Creating account...';
                if (submitIcon) {
                    submitIcon.textContent = 'sync';
                    submitIcon.classList.add('animate-spin');
                }
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast('Account created successfully! Redirecting...', 'success');
                        setTimeout(() => {
                            window.location.href = (result.redirect || '/dashboard');
                        }, 1000);
                    } else {
                        showToast(result.error || 'Registration failed');
                        submitText.textContent = origText;
                        if (submitIcon) {
                            submitIcon.textContent = 'how_to_reg';
                            submitIcon.classList.remove('animate-spin');
                        }
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    showToast('Server error, please try again');
                    submitText.textContent = origText;
                    if (submitIcon) {
                        submitIcon.textContent = 'how_to_reg';
                        submitIcon.classList.remove('animate-spin');
                    }
                    submitBtn.disabled = false;
                }
            };
        });
    </script>
</body>

</html>
