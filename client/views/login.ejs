<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>লগইন ও রেজিস্ট্রেশন | অধ্যায়</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        /* Smooth transitions for container width */
        #authContainer {
            transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        /* Custom radio card checked states */
        input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.06);
        }
        .dark input[name="role"]:checked + .role-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.12);
        }
        input[name="role"]:checked + .role-card .role-check {
            opacity: 1;
            transform: scale(1);
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between py-6 px-4 sm:px-6 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Glowing Background Accents -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/15 dark:bg-[#18a957]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="w-full max-w-4xl mx-auto flex items-center justify-between gap-3 mb-6 sm:mb-8 relative z-20">
        <!-- Back to Home -->
        <a href="/" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white bg-white/90 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 backdrop-blur-md shadow-2xs hover:shadow-xs transition-all active:scale-95" title="হোমপেজে ফিরে যান">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            <span class="hidden xs:inline">হোমপেজ</span>
        </a>

        <!-- Center Brand Logo -->
        <a href="/" class="inline-flex items-center gap-2.5 group transition-transform active:scale-95" title="অধ্যায় হোমপেজ">
            <div class="size-9 sm:size-10 rounded-xl bg-[#18a957] text-white flex items-center justify-center font-black shadow-md shadow-[#18a957]/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-xl sm:text-2xl font-bold">menu_book</span>
            </div>
            <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-800 dark:text-white">
                অধ্যায়<span class="text-[#18a957]">.</span>
            </span>
        </a>

        <!-- Dark / Light Theme Toggle Button -->
        <button type="button" onclick="if(window.OddhayTheme){window.OddhayTheme.toggle();}"
            class="size-9 sm:size-10 rounded-xl flex items-center justify-center bg-white/90 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white backdrop-blur-md shadow-2xs transition-all active:scale-95"
            title="থিম পরিবর্তন করুন">
            <span class="material-symbols-outlined theme-icon text-lg sm:text-xl">dark_mode</span>
        </button>
    </header>

    <!-- Main Auth Card Container -->
    <main class="w-full flex-1 flex items-center justify-center py-2 relative z-10">
        <div id="authContainer" class="w-full max-w-md mx-auto transition-all duration-300">
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-3xl p-6 sm:p-9 shadow-xl shadow-slate-200/50 dark:shadow-none">

                <!-- Segmented Tabs: Login vs Register -->
                <div class="flex p-1.5 bg-slate-100 dark:bg-slate-900/90 rounded-2xl mb-6 sm:mb-8 border border-slate-200/80 dark:border-slate-800/80">
                    <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')"
                        class="flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 shadow-sm bg-[#18a957] text-white">
                        <span class="material-symbols-outlined text-lg">login</span>
                        <span>লগইন</span>
                    </button>
                    <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')"
                        class="flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
                        <span class="material-symbols-outlined text-lg">person_add</span>
                        <span>নতুন একাউন্ট</span>
                    </button>
                </div>

                <!-- Alert: Password Reset Success -->
                <div id="resetSuccessMsg"
                    class="hidden mb-5 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm font-semibold flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-lg shrink-0 text-emerald-600 dark:text-emerald-400">check_circle</span>
                    <span>পাসওয়ার্ড সফলভাবে পরিবর্তন হয়েছে! নতুন পাসওয়ার্ড দিয়ে লগইন করুন।</span>
                </div>

                <!-- Alert: Server Error -->
                <% if (locals.error) { %>
                    <div id="serverErrorMsg"
                        class="mb-5 p-4 rounded-2xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-semibold flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-lg shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- ================= 1. LOGIN SECTION ================= -->
                <div id="loginSection" class="transition-all duration-300">
                    <div class="text-center mb-6 sm:mb-7">
                        <h1 class="text-2xl sm:text-3xl font-black text-slate-800 dark:text-white tracking-tight mb-2">স্বাগতম!</h1>
                        <p class="text-slate-500 dark:text-slate-400 font-medium text-xs sm:text-sm">পড়াশোনা চালিয়ে যেতে আপনার অ্যাকাউন্টে প্রবেশ করুন</p>
                    </div>

                    <form action="/login" method="POST" id="loginForm" class="space-y-4 sm:space-y-5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Identifier (Email or Phone) -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                ইমেইল অথবা মোবাইল নম্বর
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                    account_circle
                                </span>
                                <input type="text" name="email" id="loginEmail" placeholder="017XXXXXXXX অথবা email@example.com"
                                    class="w-full pl-11 pr-4 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="username">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5 ml-1">
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                    পাসওয়ার্ড
                                </label>
                                <a href="/forgot-password" class="text-xs font-bold text-[#18a957] hover:underline transition-colors">
                                    পাসওয়ার্ড ভুলে গেছেন?
                                </a>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                    lock
                                </span>
                                <input type="password" name="password" id="loginPasswordInput" placeholder="••••••••"
                                    class="w-full pl-11 pr-11 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="current-password">
                                <button type="button" onclick="toggleLoginPassword()"
                                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-1"
                                    title="পাসওয়ার্ড দেখুন বা লুকান">
                                    <span id="loginEyeIcon" class="material-symbols-outlined text-xl">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me Checkbox -->
                        <div class="flex items-center pt-1">
                            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" name="remember" class="size-4 rounded text-[#18a957] focus:ring-[#18a957] border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                                <span class="text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400">আমাকে মনে রাখুন</span>
                            </label>
                        </div>

                        <!-- Login Submit CTA -->
                        <button type="submit" id="loginSubmitBtn"
                            class="w-full h-12 sm:h-13 rounded-2xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-lg shadow-[#18a957]/20 hover:shadow-[#18a957]/30 active:scale-[0.98] transition-all">
                            <span id="loginBtnText">লগইন করুন</span>
                            <span id="loginBtnIcon" class="material-symbols-outlined text-xl">login</span>
                        </button>
                    </form>

                    <!-- Switch to Register Link -->
                    <div class="mt-8 pt-5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-semibold">
                            এখনও অ্যাকাউন্ট নেই? 
                            <a href="/register" onclick="switchAuthTab('register'); return false;" class="text-[#18a957] hover:underline font-black ml-1">
                                নতুন অ্যাকাউন্ট খুলুন
                            </a>
                        </p>
                    </div>
                </div>

                <!-- ================= 2. REGISTER SECTION ================= -->
                <div id="registerSection" class="hidden transition-all duration-300">
                    <!-- Progress Stepper -->
                    <div class="mb-6 sm:mb-8 px-2 sm:px-4">
                        <div class="flex justify-between items-center relative">
                            <!-- Background track line -->
                            <div class="absolute h-1 w-full bg-slate-200 dark:bg-slate-800 top-1/2 -translate-y-1/2 z-0 rounded-full"></div>
                            <!-- Filled progress bar -->
                            <div id="registerProgressBar" class="absolute h-1 w-0 bg-[#18a957] top-1/2 -translate-y-1/2 z-0 rounded-full transition-all duration-300"></div>

                            <!-- Step 1 Indicator -->
                            <div class="reg-step-indicator active relative z-10 size-8 sm:size-9 rounded-full bg-[#18a957] text-white border-2 border-[#18a957] flex items-center justify-center font-black text-xs sm:text-sm transition-all shadow-sm">
                                <span class="step-num">1</span>
                            </div>
                            <!-- Step 2 Indicator -->
                            <div class="reg-step-indicator relative z-10 size-8 sm:size-9 rounded-full bg-white dark:bg-slate-900 text-slate-400 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center font-black text-xs sm:text-sm transition-all">
                                <span class="step-num">2</span>
                            </div>
                            <!-- Step 3 Indicator -->
                            <div class="reg-step-indicator relative z-10 size-8 sm:size-9 rounded-full bg-white dark:bg-slate-900 text-slate-400 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center font-black text-xs sm:text-sm transition-all">
                                <span class="step-num">3</span>
                            </div>
                        </div>

                        <!-- Step Labels -->
                        <div class="flex justify-between text-[11px] font-bold text-slate-400 dark:text-slate-500 mt-2 px-1">
                            <span id="stepLabel1" class="text-[#18a957]">তথ্য</span>
                            <span id="stepLabel2">শ্রেণী ও ভূমিকা</span>
                            <span id="stepLabel3">নিরাপত্তা</span>
                        </div>
                    </div>

                    <!-- Step Title & Subtitle -->
                    <div class="text-center mb-6">
                        <h2 id="registerStepTitle" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight mb-1">
                            নতুন রেজিস্ট্রেশন
                        </h2>
                        <p id="registerStepDesc" class="text-slate-500 dark:text-slate-400 font-medium text-xs sm:text-sm">
                            প্রাথমিক তথ্য দিয়ে শুরু করুন
                        </p>
                    </div>

                    <form id="registerForm" class="space-y-4 sm:space-y-5">
                        <input type="hidden" name="redirect" value="<%= locals.redirect || '' %>">

                        <!-- Step 1: Personal Info -->
                        <div id="regStep1" class="reg-step-content space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                    পুরো নাম
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                        badge
                                    </span>
                                    <input type="text" name="name" id="regName" placeholder="আপনার পুরো নাম লিখুন"
                                        class="w-full pl-11 pr-4 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                    মোবাইল নম্বর অথবা ইমেইল
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                        contact_phone
                                    </span>
                                    <input type="text" name="identifier" id="regIdentifier" placeholder="১১ ডিজিটের মোবাইল নম্বর বা ইমেইল"
                                        class="w-full pl-11 pr-4 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1 ml-1">যেমন: 017XXXXXXXX অথবা student@example.com</p>
                            </div>
                        </div>

                        <!-- Step 2: Role & Class -->
                        <div id="regStep2" class="reg-step-content hidden space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2 ml-1">
                                    আপনার ভূমিকা নির্বাচন করুন
                                </label>
                                <div class="grid grid-cols-2 gap-3">
                                    <!-- Student Option -->
                                    <label class="cursor-pointer relative">
                                        <input type="radio" name="role" value="student" class="hidden" checked>
                                        <div class="role-card p-3.5 rounded-2xl border-2 border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1.5 relative">
                                            <span class="material-symbols-outlined text-2xl text-[#18a957]">school</span>
                                            <span class="font-bold text-sm text-slate-800 dark:text-slate-100">শিক্ষার্থী</span>
                                            <span class="text-[10px] text-slate-400 leading-tight">পড়াশোনা করার জন্য</span>
                                            <span class="role-check absolute top-2 right-2 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                        </div>
                                    </label>

                                    <!-- Parent Option -->
                                    <label class="cursor-pointer relative">
                                        <input type="radio" name="role" value="parent" class="hidden">
                                        <div class="role-card p-3.5 rounded-2xl border-2 border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1.5 relative">
                                            <span class="material-symbols-outlined text-2xl text-blue-500">family_restroom</span>
                                            <span class="font-bold text-sm text-slate-800 dark:text-slate-100">অভিভাবক</span>
                                            <span class="text-[10px] text-slate-400 leading-tight">তদারকি করার জন্য</span>
                                            <span class="role-check absolute top-2 right-2 text-xs material-symbols-outlined text-[#18a957] opacity-0 transition-all">check_circle</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Academic Class Selector -->
                            <div id="classGroup" class="transition-all duration-300">
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                    শ্রেণী / স্তর
                                </label>
                                <%
                                    const defaultClassesList = [
                                        'Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'
                                    ];
                                    let renderedClasses = [];
                                    const sourceList = (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0)
                                        ? academicClasses
                                        : ((typeof globalAcademicClasses !== 'undefined' && Array.isArray(globalAcademicClasses) && globalAcademicClasses.length > 0)
                                            ? globalAcademicClasses
                                            : []);
                                    if (sourceList.length > 0) {
                                        renderedClasses = sourceList.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                    }
                                    if (renderedClasses.length === 0) {
                                        renderedClasses = defaultClassesList;
                                    }
                                %>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                        auto_stories
                                    </span>
                                    <select name="classLevel" id="classSelect"
                                        class="w-full pl-11 pr-10 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-bold text-sm sm:text-base transition-all outline-none appearance-none cursor-pointer">
                                        <% renderedClasses.forEach(clsName => { %>
                                            <option value="<%= clsName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-semibold py-2">
                                                <%= clsName %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-xl">unfold_more</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Security / Password -->
                        <div id="regStep3" class="reg-step-content hidden space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                    পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর)
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                        lock
                                    </span>
                                    <input type="password" name="password" id="regPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-11 pr-11 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regPassword', 'regEyeIcon1')"
                                        class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-1"
                                        title="পাসওয়ার্ড দেখুন বা লুকান">
                                        <span id="regEyeIcon1" class="material-symbols-outlined text-xl">visibility</span>
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 ml-1">
                                    পাসওয়ার্ড নিশ্চিত করুন
                                </label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xl">
                                        lock_reset
                                    </span>
                                    <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="••••••••" minlength="6"
                                        class="w-full pl-11 pr-11 h-12 sm:h-13 rounded-2xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm sm:text-base placeholder:text-slate-400 transition-all outline-none"
                                        required autocomplete="new-password">
                                    <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', 'regEyeIcon2')"
                                        class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-1"
                                        title="পাসওয়ার্ড দেখুন বা লুকান">
                                        <span id="regEyeIcon2" class="material-symbols-outlined text-xl">visibility</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Stepper Navigation Buttons -->
                        <div class="flex items-center gap-3 pt-3">
                            <button type="button" id="regPrevBtn"
                                class="hidden flex-1 h-12 sm:h-13 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-1.5 text-xs sm:text-sm active:scale-95">
                                <span class="material-symbols-outlined text-lg">west</span>
                                <span>পিছনে</span>
                            </button>

                            <button type="button" id="regNextBtn"
                                class="flex-[2] h-12 sm:h-13 rounded-2xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-1.5 shadow-lg shadow-[#18a957]/20 hover:shadow-[#18a957]/30 active:scale-[0.98] transition-all">
                                <span>পরবর্তী</span>
                                <span class="material-symbols-outlined text-lg">east</span>
                            </button>

                            <button type="submit" id="regSubmitBtn"
                                class="hidden flex-[2] h-12 sm:h-13 rounded-2xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-lg shadow-[#18a957]/20 hover:shadow-[#18a957]/30 active:scale-[0.98] transition-all">
                                <span id="regSubmitText">নিবন্ধন সম্পন্ন করুন</span>
                                <span id="regSubmitIcon" class="material-symbols-outlined text-xl">how_to_reg</span>
                            </button>
                        </div>
                    </form>

                    <!-- Switch to Login Link -->
                    <div class="mt-8 pt-5 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-semibold">
                            ইতিমধ্যে একাউন্ট আছে? 
                            <a href="/login" onclick="switchAuthTab('login'); return false;" class="text-[#18a957] hover:underline font-black ml-1">
                                লগইন করুন
                            </a>
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="w-full max-w-4xl mx-auto text-center py-4 relative z-10">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-medium">
            &copy; <%= new Date().getFullYear() %> অধ্যায় (ODDHAY) — সর্বস্বত্ব সংরক্ষিত
        </p>
        <div class="flex items-center justify-center gap-4 mt-2 text-[11px] text-slate-400 dark:text-slate-500 font-medium">
            <a href="/terms" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">শর্তাবলী</a>
            <span>•</span>
            <a href="/privacy" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">গোপনীয়তা নীতি</a>
            <span>•</span>
            <a href="/contact" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">সহায়তা ডেস্ক</a>
        </div>
    </footer>

    <!-- Interactive Toast Notification -->
    <div id="toast" class="fixed top-8 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-5 py-3 rounded-full bg-red-500 text-white font-bold shadow-2xl flex items-center gap-2 text-xs sm:text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-lg">error</span>
            <span id="toast-msg">ত্রুটি দেখা দিয়েছে</span>
        </div>
    </div>

    <!-- Page Scripts -->
    <script>
        // Tab switching logic
        function switchAuthTab(tab) {
            const container = document.getElementById('authContainer');
            const loginSection = document.getElementById('loginSection');
            const registerSection = document.getElementById('registerSection');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                loginSection.classList.add('hidden');
                registerSection.classList.remove('hidden');
                container.classList.remove('max-w-md');
                container.classList.add('max-w-lg');

                tabBtnRegister.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 shadow-sm bg-[#18a957] text-white";
                tabBtnLogin.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login?tab=register' + (window.location.search.includes('redirect=') ? '&' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            } else {
                registerSection.classList.add('hidden');
                loginSection.classList.remove('hidden');
                container.classList.remove('max-w-lg');
                container.classList.add('max-w-md');

                tabBtnLogin.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 shadow-sm bg-[#18a957] text-white";
                tabBtnRegister.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login' + (window.location.search.includes('redirect=') ? '?' + window.location.search.split('?')[1].replace(/tab=[^&]*&?/, '') : '')); } catch(e) {}
            }
        }

        // Show reset success message if redirected from password reset
        if (new URLSearchParams(window.location.search).get('reset') === 'success') {
            const resetMsg = document.getElementById('resetSuccessMsg');
            if (resetMsg) resetMsg.classList.remove('hidden');
        }

        // Check if opened with register intent
        const urlParams = new URLSearchParams(window.location.search);
        const serverActiveTab = "<%= (typeof activeTab !== 'undefined' ? activeTab : 'login') %>";
        if (urlParams.get('tab') === 'register' || window.location.hash === '#register' || serverActiveTab === 'register') {
            switchAuthTab('register');
        }

        // Password visibility toggle helpers
        function toggleLoginPassword() {
            const input = document.getElementById('loginPasswordInput');
            const icon = document.getElementById('loginEyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // Toast Helper
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-5 py-3 rounded-full font-bold shadow-2xl flex items-center gap-2 text-xs sm:text-sm ${type === 'success' ? 'bg-[#18a957]' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 3500);
        }

        // Login Form Spinner on Submit
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                const btn = document.getElementById('loginSubmitBtn');
                const text = document.getElementById('loginBtnText');
                const icon = document.getElementById('loginBtnIcon');
                if (btn && text) {
                    btn.disabled = true;
                    btn.classList.add('opacity-80', 'cursor-not-allowed');
                    text.textContent = 'লগইন করা হচ্ছে...';
                    if (icon) icon.textContent = 'sync';
                    if (icon) icon.classList.add('animate-spin');
                }
            });
        }

        // Multi-Step Registration Logic
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            const form = document.getElementById('registerForm');
            if (!form) return;

            const stepContents = [
                document.getElementById('regStep1'),
                document.getElementById('regStep2'),
                document.getElementById('regStep3')
            ];
            const stepIndicators = document.querySelectorAll('.reg-step-indicator');
            const progressBar = document.getElementById('registerProgressBar');

            const nextBtn = document.getElementById('regNextBtn');
            const prevBtn = document.getElementById('regPrevBtn');
            const submitBtn = document.getElementById('regSubmitBtn');

            const stepTitle = document.getElementById('registerStepTitle');
            const stepDesc = document.getElementById('registerStepDesc');

            const stepTitles = [
                'নতুন রেজিস্ট্রেশন',
                'ভূমিকা ও শ্রেণী নির্বাচন',
                'পাসওয়ার্ড সেট করুন'
            ];
            const stepDescs = [
                'প্রাথমিক তথ্য দিয়ে শুরু করুন',
                'আপনি শিক্ষার্থী নাকি অভিভাবক নির্বাচন করুন',
                'আপনার অ্যাকাউন্টের সুরক্ষার জন্য পাসওয়ার্ড দিন'
            ];

            const stepLabels = [
                document.getElementById('stepLabel1'),
                document.getElementById('stepLabel2'),
                document.getElementById('stepLabel3')
            ];

            function updateStepUI() {
                // Show active step container
                stepContents.forEach((sc, idx) => {
                    if (sc) sc.classList.toggle('hidden', idx !== currentStep - 1);
                });

                // Update indicators
                stepIndicators.forEach((ind, idx) => {
                    const numSpan = ind.querySelector('.step-num');
                    if (idx < currentStep - 1) {
                        // Completed step
                        ind.className = "reg-step-indicator relative z-10 size-8 sm:size-9 rounded-full bg-[#18a957] text-white border-2 border-[#18a957] flex items-center justify-center font-black text-xs sm:text-sm transition-all shadow-xs";
                        if (numSpan) numSpan.innerHTML = '<span class="material-symbols-outlined text-sm font-bold">check</span>';
                    } else if (idx === currentStep - 1) {
                        // Current active step
                        ind.className = "reg-step-indicator active relative z-10 size-8 sm:size-9 rounded-full bg-[#18a957] text-white border-2 border-[#18a957] flex items-center justify-center font-black text-xs sm:text-sm transition-all shadow-md shadow-[#18a957]/30 ring-4 ring-[#18a957]/15";
                        if (numSpan) numSpan.textContent = String(idx + 1);
                    } else {
                        // Future step
                        ind.className = "reg-step-indicator relative z-10 size-8 sm:size-9 rounded-full bg-white dark:bg-slate-900 text-slate-400 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center font-black text-xs sm:text-sm transition-all";
                        if (numSpan) numSpan.textContent = String(idx + 1);
                    }
                });

                // Update step labels
                stepLabels.forEach((label, idx) => {
                    if (label) {
                        if (idx <= currentStep - 1) {
                            label.className = "text-[#18a957] font-bold";
                        } else {
                            label.className = "text-slate-400 dark:text-slate-500 font-semibold";
                        }
                    }
                });

                // Progress bar fill width
                if (progressBar) {
                    progressBar.style.width = `${((currentStep - 1) / 2) * 100}%`;
                }

                // Update title & subtitle
                if (stepTitle) stepTitle.textContent = stepTitles[currentStep - 1];
                if (stepDesc) stepDesc.textContent = stepDescs[currentStep - 1];

                // Buttons visibility
                if (prevBtn) prevBtn.classList.toggle('hidden', currentStep === 1);
                if (nextBtn) nextBtn.classList.toggle('hidden', currentStep === 3);
                if (submitBtn) submitBtn.classList.toggle('hidden', currentStep !== 3);
            }

            // Keyboard enter handler
            form.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    if (currentStep < 3) {
                        e.preventDefault();
                        nextBtn.click();
                    }
                }
            });

            // Next button click validation
            if (nextBtn) {
                nextBtn.onclick = () => {
                    const currentContainer = stepContents[currentStep - 1];
                    let valid = true;
                    let errorMsg = '';

                    if (currentStep === 1) {
                        const nameInput = document.getElementById('regName');
                        const idInput = document.getElementById('regIdentifier');

                        if (!nameInput.value.trim()) {
                            valid = false;
                            nameInput.classList.add('!border-red-500');
                            errorMsg = 'দয়া করে আপনার নাম লিখুন';
                        } else {
                            nameInput.classList.remove('!border-red-500');
                        }

                        if (!idInput.value.trim()) {
                            valid = false;
                            idInput.classList.add('!border-red-500');
                            errorMsg = errorMsg || 'মোবাইল নম্বর অথবা ইমেইল এড্রেস লিখুন';
                        } else {
                            const raw = idInput.value.trim();
                            const isEmail = raw.includes('@');
                            const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                            const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                            const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;

                            if (isEmail) {
                                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                                if (!emailRegex.test(raw)) {
                                    valid = false;
                                    idInput.classList.add('!border-red-500');
                                    errorMsg = 'সঠিক ইমেইল এড্রেস লিখুন';
                                } else {
                                    idInput.classList.remove('!border-red-500');
                                }
                            } else {
                                if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                                    valid = false;
                                    idInput.classList.add('!border-red-500');
                                    errorMsg = 'সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন (যেমন: 017XXXXXXXX)';
                                } else {
                                    idInput.classList.remove('!border-red-500');
                                }
                            }
                        }
                    }

                    if (!valid) {
                        showToast(errorMsg || 'তথ্য সঠিকভাবে পূরণ করুন');
                        return;
                    }

                    currentStep++;
                    updateStepUI();
                };
            }

            // Previous button click
            if (prevBtn) {
                prevBtn.onclick = () => {
                    if (currentStep > 1) {
                        currentStep--;
                        updateStepUI();
                    }
                };
            }

            // Role selection change
            const roleRadios = form.querySelectorAll('input[name="role"]');
            const classGroup = document.getElementById('classGroup');
            const classSelect = document.getElementById('classSelect');

            roleRadios.forEach(radio => {
                radio.addEventListener('change', () => {
                    const isParent = radio.value === 'parent';
                    if (classGroup) {
                        if (isParent) {
                            classGroup.classList.add('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = true;
                        } else {
                            classGroup.classList.remove('opacity-40', 'pointer-events-none');
                            if (classSelect) classSelect.disabled = false;
                        }
                    }
                });
            });

            // Form Submit (Step 3)
            form.onsubmit = async (e) => {
                e.preventDefault();
                if (currentStep !== 3) {
                    nextBtn.click();
                    return;
                }

                const passwordInput = document.getElementById('regPassword');
                const confirmInput = document.getElementById('regConfirmPassword');

                if (!passwordInput.value || passwordInput.value.length < 6) {
                    passwordInput.classList.add('!border-red-500');
                    return showToast('পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে');
                } else {
                    passwordInput.classList.remove('!border-red-500');
                }

                if (passwordInput.value !== confirmInput.value) {
                    confirmInput.classList.add('!border-red-500');
                    return showToast('পাসওয়ার্ড দুটি মিলছে না');
                } else {
                    confirmInput.classList.remove('!border-red-500');
                }

                const formData = Object.fromEntries(new FormData(form));

                const submitText = document.getElementById('regSubmitText');
                const submitIcon = document.getElementById('regSubmitIcon');
                const origText = submitText.textContent;

                submitText.textContent = 'প্রসেসিং হচ্ছে...';
                if (submitIcon) {
                    submitIcon.textContent = 'sync';
                    submitIcon.classList.add('animate-spin');
                }
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (typeof confetti === 'function') {
                            confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 }, colors: ['#18a957', '#ffffff', '#3b82f6'] });
                        }
                        showToast('নিবন্ধন সফল হয়েছে! ড্যাশবোর্ডে নিয়ে যাওয়া হচ্ছে...', 'success');
                        setTimeout(() => {
                            window.location.href = (result.redirect || '/dashboard');
                        }, 1400);
                    } else {
                        showToast(result.error || 'নিবন্ধন ব্যর্থ হয়েছে');
                        submitText.textContent = origText;
                        if (submitIcon) {
                            submitIcon.textContent = 'how_to_reg';
                            submitIcon.classList.remove('animate-spin');
                        }
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    showToast('সার্ভারে সমস্যা হয়েছে, আবার চেষ্টা করুন');
                    submitText.textContent = origText;
                    if (submitIcon) {
                        submitIcon.textContent = 'how_to_reg';
                        submitIcon.classList.remove('animate-spin');
                    }
                    submitBtn.disabled = false;
                }
            };
        });
    </script>
</body>

</html>
