<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>লগইন ও রেজিস্ট্রেশন | অধ্যায়</title>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen flex items-center justify-center p-4 sm:p-6 relative">
    <!-- Decorative Blobs -->
    <div class="bg-blob -top-20 -left-20 opacity-50 pointer-events-none"></div>
    <div class="bg-blob -bottom-20 -right-20 opacity-40 pointer-events-none" style="animation-delay: -5s;"></div>

    <div id="authContainer" class="max-w-md w-full glass-card reveal active p-8 sm:p-12 text-center relative z-10 transition-all duration-300"
        style="border-radius: 2.5rem;">

        <!-- Auth Navigation Tabs -->
        <div class="flex p-1.5 bg-slate-100 dark:bg-slate-900/80 rounded-2xl mb-8 border border-slate-200/50 dark:border-slate-800">
            <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')"
                class="flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 shadow-sm bg-white dark:bg-slate-800 text-primary">
                লগইন
            </button>
            <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')"
                class="flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">
                নতুন একাউন্ট
            </button>
        </div>

        <!-- Success / Error Messages for Login -->
        <div id="resetSuccessMsg"
            class="hidden mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-bold flex items-center gap-2 text-left">
            <span class="material-symbols-outlined text-[18px] shrink-0">check_circle</span>
            পাসওয়ার্ড সফলভাবে পরিবর্তন হয়েছে! এখন লগইন করুন।
        </div>
        <% if (locals.error) { %>
            <div id="serverErrorMsg"
                class="mb-6 p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm font-bold flex items-center gap-2 text-left">
                <span class="material-symbols-outlined text-[18px] shrink-0">error</span>
                <%= error %>
            </div>
        <% } %>

        <!-- ================= LOGIN SECTION ================= -->
        <div id="loginSection" class="transition-all duration-300">
            <div class="mb-8">
                <h1 class="h2-section !text-3xl sm:!text-4xl mb-2">লগইন</h1>
                <p class="text-slate-500 font-bold text-sm">পড়াশোনা শুরু করতে আপনার একাউন্টে প্রবেশ করুন</p>
            </div>

            <form action="/login" method="POST" class="space-y-6 text-left">
                <div class="space-y-5">
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">ইমেইল অথবা ফোন নম্বর</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">person</span>
                            <input type="text" name="email" placeholder="ইমেইল বা ফোন নম্বর লিখুন"
                                class="w-full pl-12 pr-4 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                                required>
                        </div>
                    </div>
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">পাসওয়ার্ড</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">lock</span>
                            <input type="password" name="password" id="passwordInput" placeholder="••••••••"
                                class="w-full pl-12 pr-12 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                                required>
                            <button type="button" onclick="togglePassword()"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors">
                                <span id="eyeIcon" class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end">
                    <a href="/forgot-password" class="text-xs font-bold text-slate-400 hover:text-primary transition-colors">পাসওয়ার্ড ভুলে গেছেন?</a>
                </div>

                <button type="submit" class="btn-primary w-full !py-4 !text-base sm:!text-lg !rounded-2xl mt-4 flex items-center justify-center gap-2">
                    লগইন করুন
                    <span class="material-symbols-outlined">login</span>
                </button>
            </form>

            <div class="mt-10 pt-6 border-t border-slate-100 dark:border-slate-800">
                <p class="body-main !text-sm text-slate-500 font-bold">
                    অ্যাকাউন্ট নেই? 
                    <a href="/register" onclick="switchAuthTab('register'); return false;" class="text-primary hover:underline font-black ml-1">
                        নতুন অ্যাকাউন্ট খুলুন
                    </a>
                </p>
            </div>
        </div>

        <!-- ================= REGISTER SECTION ================= -->
        <div id="registerSection" class="hidden transition-all duration-300">
            <!-- Progress Stepper -->
            <div class="mb-8 px-4">
                <div class="flex justify-between items-center relative">
                    <div class="absolute h-1 w-full bg-slate-200 dark:bg-slate-800 top-1/2 -translate-y-1/2 z-0 rounded-full"></div>
                    <div id="progress-bar" class="absolute h-1 w-0 bg-primary top-1/2 -translate-y-1/2 z-0 rounded-full transition-all duration-500"></div>

                    <div class="step-icon active z-10 size-9 rounded-full bg-primary text-white border-2 border-primary flex items-center justify-center font-black text-xs transition-colors">1</div>
                    <div class="step-icon z-10 size-9 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center font-black text-xs transition-colors duration-500">2</div>
                    <div class="step-icon z-10 size-9 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center font-black text-xs transition-colors duration-500">3</div>
                </div>
            </div>

            <div class="text-center mb-8">
                <h2 id="step-title" class="h2-section !text-2xl sm:!text-3xl mb-1">রেজিস্ট্রেশন</h2>
                <p id="step-desc" class="text-slate-500 font-bold text-xs sm:text-sm">প্রাথমিক তথ্য দিয়ে শুরু করুন</p>
            </div>

            <form id="register-form" class="space-y-6 text-left">
                <!-- Step 1: Personal Info -->
                <div id="step-1" class="step-content space-y-5">
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">পুরো নাম</label>
                        <input type="text" name="name" placeholder="আপনার নাম লিখুন"
                            class="w-full px-5 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                            required>
                    </div>
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">ইমেইল অথবা মোবাইল নম্বর</label>
                        <input type="text" name="identifier" placeholder="নাম্বার বা ইমেইল লিখুন"
                            class="w-full px-5 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                            required>
                    </div>
                </div>

                <!-- Step 2: Role & Class -->
                <div id="step-2" class="step-content hidden space-y-5">
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">আপনি একজন</label>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="role" value="student" class="hidden peer" checked>
                                <div class="p-3.5 text-center rounded-2xl border-2 border-slate-200/80 dark:border-slate-800 peer-checked:border-primary peer-checked:bg-primary/5 font-black text-sm transition-all">
                                    শিক্ষার্থী
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="role" value="parent" class="hidden peer">
                                <div class="p-3.5 text-center rounded-2xl border-2 border-slate-200/80 dark:border-slate-800 peer-checked:border-primary peer-checked:bg-primary/5 font-black text-sm transition-all">
                                    অভিভাবক
                                </div>
                            </label>
                        </div>
                    </div>
                    <div id="class-group" class="group transition-all duration-300">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">শ্রেণী / স্তর</label>
                        <%
                            const defaultClassesList = [
                                'Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'
                            ];
                            let renderedClasses = [];
                            const sourceList = (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0)
                                ? academicClasses
                                : ((typeof globalAcademicClasses !== 'undefined' && Array.isArray(globalAcademicClasses) && globalAcademicClasses.length > 0)
                                    ? globalAcademicClasses
                                    : []);
                            if (sourceList.length > 0) {
                                renderedClasses = sourceList.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                            }
                            if (renderedClasses.length === 0) {
                                renderedClasses = defaultClassesList;
                            }
                        %>
                        <div class="relative">
                            <select name="classLevel" id="class-select"
                                class="w-full px-5 pr-12 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base text-slate-800 dark:text-slate-100 shadow-sm appearance-none cursor-pointer">
                                <% renderedClasses.forEach(clsName => { %>
                                    <option value="<%= clsName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-semibold py-2">
                                        <%= clsName %>
                                    </option>
                                <% }) %>
                            </select>
                            <div class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined text-xl">unfold_more</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Security -->
                <div id="step-3" class="step-content hidden space-y-5">
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর)</label>
                        <input type="password" name="password" placeholder="••••••••" minlength="6"
                            class="w-full px-5 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                            required>
                    </div>
                    <div class="group">
                        <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">পাসওয়ার্ড নিশ্চিত করুন</label>
                        <input type="password" name="confirmPassword" placeholder="••••••••" minlength="6"
                            class="w-full px-5 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm text-slate-800 dark:text-slate-100"
                            required>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex gap-3 pt-4">
                    <button type="button" id="prev-btn"
                        class="hidden flex-1 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-extrabold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-1.5 text-sm">
                        <span class="material-symbols-outlined text-xl">west</span> পিছনে
                    </button>
                    <button type="button" id="next-btn"
                        class="flex-[2] h-14 rounded-2xl bg-primary text-white font-extrabold shadow-lg shadow-primary/20 hover:shadow-primary/40 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 text-base">
                        <span id="btn-text">পরবর্তী</span>
                        <span class="material-symbols-outlined text-xl">east</span>
                    </button>
                    <button type="submit" id="submit-btn"
                        class="hidden flex-[2] h-14 rounded-2xl bg-primary text-white font-extrabold shadow-lg shadow-primary/20 hover:shadow-primary/40 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 text-base">
                        <span id="finish-text">সম্পন্ন করুন</span>
                        <span class="material-symbols-outlined text-xl">task_alt</span>
                    </button>
                </div>
            </form>

            <div class="mt-10 pt-6 border-t border-slate-100 dark:border-slate-800">
                <p class="body-main !text-sm text-slate-500 font-bold">
                    ইতিমধ্যে অ্যাকাউন্ট আছে? 
                    <a href="/login" onclick="switchAuthTab('login'); return false;" class="text-primary hover:underline font-black ml-1">
                        লগইন করুন
                    </a>
                </p>
            </div>
        </div>
    </div>

    <!-- Custom Toast Notification -->
    <div id="toast" class="fixed top-8 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-6 py-3.5 rounded-full bg-red-500 text-white font-black shadow-2xl flex items-center gap-2.5 text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-lg">error</span>
            <span id="toast-msg">ত্রুটি দেখা দিয়েছে</span>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        // Tab switching logic
        function switchAuthTab(tab) {
            const container = document.getElementById('authContainer');
            const loginSection = document.getElementById('loginSection');
            const registerSection = document.getElementById('registerSection');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                loginSection.classList.add('hidden');
                registerSection.classList.remove('hidden');
                container.classList.remove('max-w-md');
                container.classList.add('max-w-xl');

                tabBtnRegister.className = "flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 shadow-sm bg-white dark:bg-slate-800 text-primary";
                tabBtnLogin.className = "flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login?tab=register'); } catch(e) {}
            } else {
                registerSection.classList.add('hidden');
                loginSection.classList.remove('hidden');
                container.classList.remove('max-w-xl');
                container.classList.add('max-w-md');

                tabBtnLogin.className = "flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 shadow-sm bg-white dark:bg-slate-800 text-primary";
                tabBtnRegister.className = "flex-1 py-2.5 rounded-xl font-black text-sm transition-all duration-300 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200";

                try { history.replaceState(null, '', '/login'); } catch(e) {}
            }
        }

        // Show reset success message if redirected from password reset
        if (new URLSearchParams(window.location.search).get('reset') === 'success') {
            document.getElementById('resetSuccessMsg').classList.remove('hidden');
        }

        // Check if opened with register intent
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('tab') === 'register' || window.location.hash === '#register') {
            switchAuthTab('register');
        }

        // Password visibility toggle
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // Toast Helper
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-6 py-3.5 rounded-full font-black shadow-2xl flex items-center gap-2.5 text-sm ${type === 'success' ? 'bg-emerald-500' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 4000);
        }

        // Register Multi-step Form Logic
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            const form = document.getElementById('register-form');
            const steps = form.querySelectorAll('.step-content');
            const icons = document.querySelectorAll('.step-icon');
            const bar = document.getElementById('progress-bar');

            const nextBtn = document.getElementById('next-btn');
            const prevBtn = document.getElementById('prev-btn');
            const submitBtn = document.getElementById('submit-btn');

            const stepTitles = [
                'রেজিস্ট্রেশন',
                'আপনার অবস্থান জানান',
                'নিরাপত্তা নিশ্চিত করুন'
            ];
            const stepDescs = [
                'প্রাথমিক তথ্য দিয়ে শুরু করুন',
                'আপনি শিক্ষার্থী নাকি অভিভাবক?',
                'একটি শক্তিশালী পাসওয়ার্ড দিন'
            ];

            function updateStep() {
                steps.forEach((s, idx) => s.classList.toggle('hidden', idx !== currentStep - 1));
                icons.forEach((ic, idx) => {
                    if (idx < currentStep) {
                        ic.classList.add('border-primary', 'bg-primary', 'text-white');
                        ic.classList.remove('border-slate-200', 'dark:border-slate-800');
                    } else {
                        ic.classList.remove('border-primary', 'bg-primary', 'text-white');
                        ic.classList.add('border-slate-200', 'dark:border-slate-800');
                    }
                });

                bar.style.width = `${((currentStep - 1) / 2) * 100}%`;

                document.getElementById('step-title').textContent = stepTitles[currentStep - 1];
                document.getElementById('step-desc').textContent = stepDescs[currentStep - 1];

                prevBtn.classList.toggle('hidden', currentStep === 1);
                nextBtn.classList.toggle('hidden', currentStep === 3);
                submitBtn.classList.toggle('hidden', currentStep !== 3);
            }

            form.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    if (currentStep < 3) {
                        e.preventDefault();
                        nextBtn.click();
                    }
                }
            });

            nextBtn.onclick = () => {
                const currentStepContainer = steps[currentStep - 1];
                const stepInputs = currentStepContainer.querySelectorAll('input:not([type="radio"]), select');
                let valid = true;
                let errorMsg = '';

                stepInputs.forEach(input => {
                    if (input.disabled) return;
                    const val = input.value.trim();
                    if (input.hasAttribute('required') && !val) {
                        valid = false;
                        input.classList.add('!border-red-500');
                    } else {
                        input.classList.remove('!border-red-500');
                    }
                });

                if (currentStep === 1) {
                    const idInput = currentStepContainer.querySelector('input[name="identifier"]');
                    if (idInput) {
                        const raw = idInput.value.trim();
                        const isEmail = raw.includes('@');
                        const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                        const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                        const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;

                        if (isEmail) {
                            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                            if (!emailRegex.test(raw)) {
                                valid = false;
                                idInput.classList.add('!border-red-500');
                                errorMsg = 'সঠিক ইমেইল এড্রেস লিখুন';
                            }
                        } else {
                            if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                                valid = false;
                                idInput.classList.add('!border-red-500');
                                errorMsg = 'সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন (যেমন: 017XXXXXXXX)';
                            }
                        }
                    }
                }

                if (!valid) {
                    showToast(errorMsg || 'দয়া করে সব তথ্য সঠিকভাবে পূরণ করুন');
                    return;
                }

                currentStep++;
                updateStep();
            };

            prevBtn.onclick = () => {
                currentStep--;
                updateStep();
            };

            const roleInputs = form.querySelectorAll('input[name="role"]');
            const classGroup = document.getElementById('class-group');
            const classSelect = document.getElementById('class-select');

            roleInputs.forEach(input => {
                input.onchange = () => {
                    const isParent = input.value === 'parent';
                    if (classGroup) classGroup.classList.toggle('hidden', isParent);
                    if (classSelect) classSelect.disabled = isParent;
                };
            });

            form.onsubmit = async (e) => {
                e.preventDefault();
                if (currentStep !== 3) {
                    nextBtn.click();
                    return;
                }

                const formData = Object.fromEntries(new FormData(form));

                if (!formData.password || formData.password.length < 6) {
                    return showToast('পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে');
                }

                if (formData.password !== formData.confirmPassword) {
                    return showToast('পাসওয়ার্ড দুটি মিলছে না');
                }

                const finishText = document.getElementById('finish-text');
                const origText = finishText.textContent;
                finishText.textContent = 'প্রসেসিং...';
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (typeof confetti === 'function') {
                            confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 }, colors: ['#137fec', '#ffffff'] });
                        }
                        showToast('নিবন্ধন সফল হয়েছে! ড্যাশবোর্ডে নিয়ে যাওয়া হচ্ছে...', 'success');
                        setTimeout(() => window.location.href = (result.redirect || '/dashboard'), 1500);
                    } else {
                        showToast(result.error || 'নিবন্ধন ব্যর্থ হয়েছে');
                        finishText.textContent = origText;
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    showToast('সার্ভারে সমস্যা হয়েছে, আবার চেষ্টা করুন');
                    finishText.textContent = origText;
                    submitBtn.disabled = false;
                }
            };
        });
    </script>
</body>

</html>