<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>লগইন | অধ্যায়</title>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen flex items-center justify-center p-6 relative">
    <!-- Decorative Blobs -->
    <div class="bg-blob -top-20 -left-20 opacity-50"></div>
    <div class="bg-blob -bottom-20 -right-20 opacity-40" style="animation-delay: -5s;"></div>

    <div class="max-w-md w-full glass-card reveal active p-10 md:p-14 text-center relative z-10"
        style="border-radius: 3rem;">

        <!-- Success / Error Messages -->
        <div id="resetSuccessMsg"
            class="hidden mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-bold flex items-center gap-2 text-left">
            <span class="material-symbols-outlined text-[18px] shrink-0">check_circle</span>
            পাসওয়ার্ড সফলভাবে পরিবর্তন হয়েছে! এখন লগইন করুন।
        </div>
        <% if (locals.error) { %>
            <div
                class="mb-4 p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm font-bold flex items-center gap-2 text-left">
                <span class="material-symbols-outlined text-[18px] shrink-0">error</span>
                <%= error %>
            </div>
            <% } %>

                <div class="mb-10">
                    <h1 class="h2-section !text-4xl mb-2">লগইন</h1>
                    <p class="text-slate-500 font-bold text-sm">পড়াশোনা শুরু করুন</p>
                </div>

                <form action="/login" method="POST" class="space-y-6 text-left">
                    <div class="space-y-5">
                        <div class="group">
                            <label
                                class="block text-[12px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">ইমেইল
                                অথবা ফোন নম্বর</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">person</span>
                                <input type="text" name="email" placeholder="ইমেইল বা ফোন নম্বর লিখুন"
                                    class="w-full pl-12 pr-4 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm"
                                    required>
                            </div>
                        </div>
                        <div class="group">
                            <label
                                class="block text-[12px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2">পাসওয়ার্ড</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">lock</span>
                                <input type="password" name="password" id="passwordInput" placeholder="••••••••"
                                    class="w-full pl-12 pr-12 h-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-base shadow-sm"
                                    required>
                                <button type="button" onclick="togglePassword()"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors">
                                    <span id="eyeIcon" class="material-symbols-outlined text-[20px]">visibility</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <a href="/forgot-password"
                            class="text-xs font-bold text-slate-400 hover:text-primary transition-colors">পাসওয়ার্ড
                            ভুলে
                            গেছেন?</a>
                    </div>

                    <button type="submit" class="btn-primary w-full !py-4 !text-lg !rounded-2xl mt-4">
                        লগইন করুন
                        <span class="material-symbols-outlined">login</span>
                    </button>
                </form>

                <div class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-800">
                    <p class="body-main !text-sm text-slate-500 font-bold">
                        অ্যাকাউন্ট নেই? <a href="/register" class="text-primary hover:underline font-black ml-1">নতুন
                            অ্যাকাউন্ট
                            খুলুন</a>
                    </p>
                </div>
    </div>

    <script>
        // Show reset success message if redirected from password reset
        if (new URLSearchParams(window.location.search).get('reset') === 'success') {
            document.getElementById('resetSuccessMsg').classList.remove('hidden');
        }

        // Password visibility toggle
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>

</body>

</html>