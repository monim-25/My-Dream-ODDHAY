<!DOCTYPE html>
<html lang="en" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Q&A Community | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'qa' }) %>

        <main id="qa-main-scroll" class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 flex flex-col no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative scroll-smooth">
            
            <% const u = locals.user || {}; %>
            <% const qList = locals.qas || []; %>
            <% const st = locals.stats || { totalCount: 0, resolvedCount: 0, openCount: 0, myCount: 0 }; %>
            <% 
                const rawStatus = (locals.filters && locals.filters.status) || 'all'; 
                const rawSubject = (locals.filters && locals.filters.subject) || 'all'; 
                const searchVal = (locals.filters && locals.filters.search) || ''; 
                const activeStatuses = (rawStatus !== 'all') ? rawStatus.split(',').map(s => s.trim().toLowerCase()).filter(Boolean) : [];
                const activeSubjects = (rawSubject !== 'all') ? rawSubject.split(',').map(s => s.trim().toLowerCase()).filter(Boolean) : [];
                const totalActiveFilters = activeStatuses.length + activeSubjects.length;
            %>

            <!-- Auto-dismissing Flash Notification Banner -->
            <% if (locals.success) { %>
                <div id="flash-alert" class="w-full p-3 bg-emerald-50 dark:bg-emerald-500/10 border-b border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold flex items-center gap-2 transition-all duration-300 shrink-0">
                    <span class="material-symbols-rounded text-base flex items-center justify-center leading-none select-none">check_circle</span>
                    <span><%= locals.success === 'asked' ? 'Your question has been posted!' : (locals.success === 'replied' ? 'Your discussion reply was submitted!' : 'Action completed.') %></span>
                </div>
            <% } %>

            <!-- Hidden form state for filters -->
            <form action="/qa" method="GET" id="qa-filter-form" class="hidden">
                <input type="hidden" name="status" value="<%= rawStatus %>">
                <input type="hidden" name="subject" value="<%= rawSubject %>">
            </form>

            <!-- Top Controls Toolbar (Search Input & Multiple Filter Dropdown in ONE LINE) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 p-2.5 sm:p-3 shrink-0 space-y-2">
                <div class="flex items-center gap-2 w-full">
                    <!-- Live Search Box -->
                    <div class="relative flex-1 min-w-0">
                        <div class="absolute left-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none select-none text-slate-400 dark:text-slate-500">
                            <span class="material-symbols-rounded text-[19px] leading-none">search</span>
                        </div>
                        <input type="text" id="qa-screen-search-input"
                            oninput="filterLiveQuestions()"
                            onkeyup="filterLiveQuestions()"
                            placeholder="Search questions, topics, mentors..."
                            value="<%= searchVal %>"
                            class="w-full h-11 pl-10 pr-9 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 rounded-xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 shadow-2xs transition-all">
                        <button type="button" id="qa-screen-clear-btn" onclick="clearQaScreenSearch()"
                            class="<%= (searchVal && searchVal.trim().length > 0) ? 'flex' : 'hidden' %> absolute right-2.5 top-1/2 -translate-y-1/2 size-6 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white items-center justify-center transition-colors cursor-pointer select-none">
                            <span class="material-symbols-rounded text-base">cancel</span>
                        </button>
                    </div>

                    <!-- Filter Dropdown Trigger Button (In the SAME LINE as Search) -->
                    <div class="relative shrink-0" id="qa-filter-dropdown-container">
                        <button type="button" id="qa-filter-dropdown-btn" onclick="toggleQaFilterDropdown(event)"
                            class="h-11 px-3 sm:px-3.5 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 rounded-xl flex items-center gap-1.5 sm:gap-2 text-xs sm:text-[13px] font-bold transition-all shadow-2xs cursor-pointer select-none active:scale-95 <%= (totalActiveFilters > 0) ? 'border-primary/60 text-primary dark:text-primary ring-1 ring-primary/20 bg-primary/5 dark:bg-primary/10' : '' %>">
                            <span class="material-symbols-rounded text-base sm:text-lg text-primary leading-none shrink-0">tune</span>
                            <span>Filter</span>
                            <% if (totalActiveFilters > 0) { %>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-primary text-white shrink-0 shadow-xs"><%= totalActiveFilters %></span>
                            <% } %>
                            <span class="material-symbols-rounded text-slate-400 text-sm leading-none shrink-0">expand_more</span>
                        </button>

                        <!-- Mobile Backdrop Overlay -->
                        <div id="qa-filter-backdrop" class="hidden fixed inset-0 bg-black/40 backdrop-blur-2xs z-40 sm:hidden" onclick="toggleQaFilterDropdown(event)"></div>

                        <!-- Multiple Filter Dropdown Panel -->
                        <div id="qa-filter-dropdown-menu" class="hidden fixed inset-x-3 bottom-20 max-h-[75vh] sm:absolute sm:inset-auto sm:right-0 sm:top-full sm:mt-2 w-auto sm:w-96 bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl z-50 p-3.5 sm:p-4 space-y-3.5 overflow-y-auto no-scrollbar">
                            <!-- Dropdown Header -->
                            <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
                                <div class="flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-800 dark:text-white">
                                    <span class="material-symbols-rounded text-base text-primary">tune</span>
                                    <span>Multiple Filtering</span>
                                    <% if (totalActiveFilters > 0) { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary/15 text-primary"><%= totalActiveFilters %> active</span>
                                    <% } %>
                                </div>
                                <button type="button" onclick="clearAllFiltersModal()" class="text-[11px] font-bold text-slate-400 hover:text-rose-500 transition-colors cursor-pointer">
                                    Reset
                                </button>
                            </div>

                            <!-- SECTION 1: Status Filters (Multi-Selectable) -->
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Filter By Status</span>
                                    <span class="text-[10px] font-medium text-slate-400">Multi-select</span>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <!-- Answered Tab -->
                                    <button type="button" onclick="toggleStatusFilterItem('resolved')" id="modal-status-resolved"
                                        class="modal-status-btn p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer <%= activeStatuses.includes('resolved') ? 'bg-emerald-500/15 border-emerald-500 text-emerald-600 dark:text-emerald-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60' %>">
                                        <span class="flex items-center gap-1.5 truncate">
                                            <span class="material-symbols-rounded text-base <%= activeStatuses.includes('resolved') ? 'text-emerald-500' : 'text-slate-400' %>">verified</span>
                                            <span class="truncate">Answered</span>
                                        </span>
                                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold <%= activeStatuses.includes('resolved') ? 'bg-emerald-600 text-white' : 'bg-slate-200/70 dark:bg-slate-700 text-slate-600 dark:text-slate-400' %>"><%= st.resolvedCount %></span>
                                    </button>

                                    <!-- Pending Tab -->
                                    <button type="button" onclick="toggleStatusFilterItem('open')" id="modal-status-open"
                                        class="modal-status-btn p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer <%= activeStatuses.includes('open') ? 'bg-amber-500/15 border-amber-500 text-amber-600 dark:text-amber-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60' %>">
                                        <span class="flex items-center gap-1.5 truncate">
                                            <span class="material-symbols-rounded text-base <%= activeStatuses.includes('open') ? 'text-amber-500' : 'text-slate-400' %>">schedule</span>
                                            <span class="truncate">Pending</span>
                                        </span>
                                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold <%= activeStatuses.includes('open') ? 'bg-amber-600 text-white' : 'bg-slate-200/70 dark:bg-slate-700 text-slate-600 dark:text-slate-400' %>"><%= st.openCount %></span>
                                    </button>

                                    <!-- My Questions Tab -->
                                    <button type="button" onclick="toggleStatusFilterItem('my')" id="modal-status-my"
                                        class="modal-status-btn col-span-2 p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer <%= activeStatuses.includes('my') ? 'bg-indigo-500/15 border-indigo-500 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60' %>">
                                        <span class="flex items-center gap-1.5 truncate">
                                            <span class="material-symbols-rounded text-base <%= activeStatuses.includes('my') ? 'text-indigo-500' : 'text-slate-400' %>">person</span>
                                            <span class="truncate">My Questions Only</span>
                                        </span>
                                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold <%= activeStatuses.includes('my') ? 'bg-indigo-600 text-white' : 'bg-slate-200/70 dark:bg-slate-700 text-slate-600 dark:text-slate-400' %>"><%= st.myCount %></span>
                                    </button>
                                </div>
                            </div>

                            <!-- SECTION 2: Subject Filters (Multi-Selectable Grid) -->
                            <div class="space-y-2 pt-2.5 border-t border-slate-100 dark:border-slate-800">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Filter By Subject</span>
                                    <span class="text-[10px] font-medium text-slate-400">Select multiple</span>
                                </div>
                                <div class="grid grid-cols-2 gap-1.5 max-h-48 overflow-y-auto no-scrollbar pr-0.5">
                                    <% (locals.availableSubjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']).forEach(sub => { %>
                                        <% const isSubActive = activeSubjects.includes(sub.toLowerCase()); %>
                                        <button type="button" onclick="toggleSubjectFilterItem('<%= sub.toLowerCase() %>')" id="modal-sub-<%= sub.toLowerCase().replace(/\s+/g, '-') %>"
                                            class="modal-sub-btn px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between border transition-all active:scale-95 cursor-pointer <%= isSubActive ? 'bg-primary/10 border-primary text-primary font-bold shadow-2xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100' %>">
                                            <span class="truncate"><%= sub %></span>
                                            <span class="material-symbols-rounded text-sm <%= isSubActive ? 'text-primary' : 'text-slate-300 dark:text-slate-600' %>">
                                                <%= isSubActive ? 'check_box' : 'check_box_outline_blank' %>
                                            </span>
                                        </button>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- SECTION 3: Modal Actions Footer -->
                            <div class="pt-2.5 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
                                <button type="button" onclick="clearAllFiltersModal()" class="h-10 px-3.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold transition-all active:scale-95">
                                    Clear
                                </button>
                                <button type="button" onclick="applyMultipleFilters()" class="h-10 flex-1 rounded-xl bg-primary hover:bg-primary/90 text-white text-xs sm:text-[13px] font-bold transition-all shadow-md shadow-primary/25 active:scale-95 flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-rounded text-base">done_all</span>
                                    <span>Apply Filters</span>
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Active Filter Chips (Instant dismissal for each filter) -->
                <% if (totalActiveFilters > 0) { %>
                    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider shrink-0 mr-0.5">Active:</span>
                        
                        <% activeStatuses.forEach(st => { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-primary/10 text-primary border border-primary/20 text-[11px] font-bold shrink-0">
                                <span><%= st === 'resolved' ? 'Answered' : (st === 'open' ? 'Pending' : 'My Questions') %></span>
                                <button type="button" onclick="removeSingleFilter('status', '<%= st %>')" class="hover:text-primary/70 cursor-pointer flex items-center">
                                    <span class="material-symbols-rounded text-xs leading-none">close</span>
                                </button>
                            </span>
                        <% }) %>

                        <% activeSubjects.forEach(sub => { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-[11px] font-bold shrink-0 capitalize">
                                <span><%= sub %></span>
                                <button type="button" onclick="removeSingleFilter('subject', '<%= sub %>')" class="hover:text-slate-500 cursor-pointer flex items-center">
                                    <span class="material-symbols-rounded text-xs leading-none">close</span>
                                </button>
                            </span>
                        <% }) %>

                        <button type="button" onclick="clearAllFiltersModal(); applyMultipleFilters();" class="text-[11px] font-bold text-rose-500 hover:text-rose-600 underline shrink-0 ml-1 cursor-pointer">
                            Clear all
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Live No Matches Fallback -->
            <div id="no-live-results" class="hidden bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-8 text-center shadow-none w-full">
                <span class="material-symbols-rounded text-4xl text-slate-300 mb-2 flex items-center justify-center leading-none select-none">search_off</span>
                <h3 class="text-sm font-bold text-slate-800 dark:text-white">No Matching Questions Found</h3>
                <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                    No questions or subjects match your live search query.
                </p>
                <button onclick="clearQaScreenSearch()" class="mt-3 px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded text-xs font-bold inline-flex items-center gap-1">
                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">refresh</span> Reset Live Search
                </button>
            </div>

            <!-- Scrollable Questions Feed (Dashboard-Aligned Card System) -->
            <div id="questions-feed" class="flex-1 space-y-2.5 w-full p-2.5 sm:p-4 pb-28 sm:pb-32">
                <% if (qList.length === 0) { %>
                    <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-2xl p-10 text-center shadow-none w-full">
                        <span class="material-symbols-rounded text-5xl text-slate-300 mb-3 flex items-center justify-center leading-none select-none">help_outline</span>
                        <h3 class="text-base font-bold text-slate-800 dark:text-white">No Questions Found</h3>
                        <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                            No academic questions match your current class feed. Ask your question in the composer above!
                        </p>
                    </div>
                <% } else { %>
                    <% qList.forEach(function(item) { %>
                        <% 
                           const asker = item.askedBy || {};
                           const mentor = item.answeredBy || {};
                           const isResolved = item.status === 'resolved' || item.answer;
                           const upvotesArr = item.upvotes || [];
                           const hasUpvoted = u._id && upvotesArr.some(id => id.toString() === u._id.toString());
                           const replies = item.replies || [];
                           
                           const searchableText = [
                                item.question || '',
                                item.subject || '',
                                asker.name || item.askedByName || '',
                                asker.classLevel || '',
                                item.answer || '',
                                mentor.name || '',
                                replies.map(r => r.text || '').join(' ')
                           ].join(' ').toLowerCase();
                        %>
                        <div id="qa-<%= item._id %>" 
                             class="qa-card bg-white dark:bg-[#0f172a] border border-slate-200/90 dark:border-slate-800 rounded-2xl p-3.5 sm:p-5 shadow-2xs transition-all flex flex-col justify-between"
                             data-search="<%= searchableText.replace(/"/g, '&quot;') %>"
                             data-subject="<%= (item.subject || 'general').toLowerCase() %>">
                            
                            <div>
                                <!-- Question Header: Asker Avatar, Name & Status -->
                                <div class="flex items-center justify-between gap-2.5 mb-2.5">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="size-9 rounded-full border border-slate-200 dark:border-slate-700 overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-800">
                                            <img src="<%= (asker.profileImage || asker.profilePicture) ? (asker.profileImage || asker.profilePicture) : `https://ui-avatars.com/api/?name=${encodeURIComponent(asker.name || item.askedByName || 'Student')}&background=random` %>" class="w-full h-full object-cover">
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-tight truncate">
                                                    <%= asker.name || item.askedByName || 'Student' %>
                                                </h4>
                                                <% if (asker.classLevel) { %>
                                                    <span class="px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-[9px] font-bold text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60">
                                                        <%= asker.classLevel %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] font-medium text-slate-400 mt-0.5 truncate">
                                                Posted <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1.5 shrink-0 flex-wrap justify-end">
                                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold border <%= isResolved ? 'bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400' : 'bg-amber-50 dark:bg-amber-500/10 border-amber-200 dark:border-amber-500/20 text-amber-600 dark:text-amber-400' %> flex items-center gap-1">
                                            <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center select-none"><%= isResolved ? 'verified' : 'schedule' %></span>
                                            <span><%= isResolved ? 'Answered' : 'Pending' %></span>
                                        </span>
                                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            <%= item.subject || 'General' %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Question Content Box -->
                                <div class="p-3 sm:p-4 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 mb-2.5">
                                    <p class="text-xs sm:text-[13px] font-semibold text-slate-800 dark:text-slate-100 leading-relaxed">
                                        "<%= item.question %>"
                                    </p>

                                    <!-- Attached Question Image (In-Page Lightbox Trigger) -->
                                    <% if (item.image) { %>
                                        <div class="mt-2.5 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700/80 max-w-md bg-black/5">
                                            <img src="<%= item.image %>" class="w-full max-h-80 object-contain cursor-pointer hover:opacity-95 transition-opacity" onclick="openImageModal(this.src)">
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Verified Mentor Answer Box -->
                                <% if (item.answer) { %>
                                    <div class="p-3 sm:p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/25 border border-emerald-200/90 dark:border-emerald-500/30 border-l-4 border-l-emerald-600 dark:border-l-emerald-500 mb-2.5 relative">
                                        <div class="flex items-center gap-2 mb-2">
                                            <div class="size-7 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-xs">
                                                <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">verified_user</span>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <h5 class="text-xs font-bold text-emerald-900 dark:text-emerald-300 truncate">
                                                        <%= mentor.name || 'Academic Mentor' %>
                                                    </h5>
                                                    <span class="px-1.5 py-0.2 bg-emerald-600 text-white rounded text-[9px] font-bold tracking-wide">Verified Answer</span>
                                                </div>
                                                <% if (item.answeredAt) { %>
                                                    <p class="text-[9px] font-medium text-emerald-700/80 dark:text-emerald-400/80 mt-0.5">
                                                        Answered <%= new Date(item.answeredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        </div>
                                        <p class="text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-200 leading-relaxed pl-9">
                                            <%= item.answer %>
                                        </p>
                                    </div>
                                <% } %>

                                <!-- Discussion / Reply Thread Box -->
                                <div id="reply-drawer-<%= item._id %>" class="hidden mt-2.5 p-3 sm:p-4 rounded-xl bg-slate-100/80 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 space-y-2.5">
                                    <h5 class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-base text-primary">forum</span>
                                        Discussion Replies (<%= replies.length %>)
                                    </h5>

                                    <!-- Replies List -->
                                    <% if (replies.length > 0) { %>
                                        <div class="space-y-2 max-h-60 overflow-y-auto pr-1 no-scrollbar">
                                            <% replies.forEach(function(rep) { %>
                                                <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 flex items-start gap-2.5">
                                                    <div class="size-7 rounded-full border border-slate-200 dark:border-slate-700 overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-800 mt-0.5">
                                                        <img src="<%= rep.user?.profileImage ? rep.user.profileImage : `https://ui-avatars.com/api/?name=${encodeURIComponent(rep.userName || 'Student')}&background=random` %>" class="w-full h-full object-cover">
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center justify-between gap-2">
                                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                                <span class="text-xs font-bold text-slate-800 dark:text-white truncate"><%= rep.userName || 'Student' %></span>
                                                                <% if (rep.role === 'teacher' || rep.role === 'admin') { %>
                                                                    <span class="px-1.5 py-0.2 rounded bg-primary/10 text-primary text-[8px] font-bold">Teacher</span>
                                                                <% } %>
                                                            </div>
                                                            <span class="text-[9px] font-medium text-slate-400 shrink-0">
                                                                <%= new Date(rep.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                            </span>
                                                        </div>
                                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mt-1 leading-relaxed">
                                                            <%= rep.text %>
                                                        </p>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <p class="text-[11px] font-medium text-slate-400 italic">No discussion replies yet. Start the conversation!</p>
                                    <% } %>

                                    <!-- Discussion Reply Form (Text Only) -->
                                    <form action="/qa/reply/<%= item._id %>" method="POST" class="space-y-2 pt-1">
                                        <textarea id="reply-input-<%= item._id %>" name="replyText" rows="2" placeholder="Write your discussion reply here..."
                                            class="w-full px-3 py-2 bg-white dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700/70 text-xs font-semibold text-slate-800 dark:text-white rounded-xl outline-none focus:border-primary transition-all resize-none shadow-2xs"></textarea>
                                        
                                        <div class="flex items-center justify-end gap-2">
                                            <button type="submit" class="h-8.5 px-3.5 bg-primary hover:bg-primary/90 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 shadow-xs active:scale-95">
                                                <span class="material-symbols-rounded text-base flex items-center justify-center leading-none select-none">reply</span>
                                                <span>Reply</span>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Card Footer Bar: Touch-Friendly Helpful & Discussions Buttons -->
                            <div class="flex items-center justify-between gap-2 pt-2.5 mt-2 border-t border-slate-100 dark:border-slate-800/80">
                                <div class="flex items-center gap-2">
                                    <button onclick="toggleUpvote('<%= item._id %>', this)" 
                                            class="upvote-btn h-8.5 sm:h-9 px-3 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 active:scale-95 <%= hasUpvoted ? 'bg-rose-50 dark:bg-rose-500/15 border border-rose-200 dark:border-rose-500/30 text-rose-600 dark:text-rose-400 shadow-2xs' : 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60' %>">
                                        <span class="material-symbols-rounded text-base flex items-center justify-center leading-none select-none <%= hasUpvoted ? 'text-rose-500 fill-1' : 'text-slate-400' %>">thumb_up</span>
                                        <span>Helpful (<span class="upvote-count"><%= upvotesArr.length %></span>)</span>
                                    </button>

                                    <button onclick="toggleReplyDrawer('<%= item._id %>')" class="h-8.5 sm:h-9 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60 transition-colors flex items-center gap-1.5 active:scale-95">
                                        <span class="material-symbols-rounded text-base flex items-center justify-center leading-none text-slate-400 select-none">chat_bubble</span>
                                        <span>Discussions (<%= replies.length %>)</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Sticky Bottom Ask Question Composer Field (Sticky, auto-hides on scroll-down, reveals on scroll-up) -->
            <div id="ask-question-box" class="sticky bottom-0 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-t border-slate-200/90 dark:border-slate-800 p-2 sm:p-3 shrink-0 z-30 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] dark:shadow-[0_-4px_16px_rgba(0,0,0,0.35)] transition-all duration-300 ease-in-out translate-y-0 opacity-100 pointer-events-auto lg:translate-y-0 lg:opacity-100 lg:pointer-events-auto">
                <form action="/qa-ask" method="POST" enctype="multipart/form-data" class="w-full max-w-4xl mx-auto flex flex-col gap-1.5">
                    
                    <!-- Selected Image Preview Badge -->
                    <div id="ask-img-preview" class="hidden flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary/10 border border-primary/20 text-xs font-semibold text-primary max-w-xs self-start">
                        <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none shrink-0">image</span>
                        <span class="truncate flex-1" id="ask-img-name">Photo attached</span>
                        <button type="button" onclick="clearAskImage()" class="text-rose-500 hover:text-rose-700 text-xs font-bold flex items-center justify-center leading-none select-none shrink-0 cursor-pointer">
                            <span class="material-symbols-rounded text-base flex items-center justify-center leading-none">cancel</span>
                        </button>
                    </div>

                    <!-- Main Composer Row: Integrated Text Box (Contains Textarea + Ask Button) -->
                    <div class="flex items-start gap-2 w-full">
                        <div class="size-8 rounded-full border border-slate-200 dark:border-slate-700 overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-800 hidden sm:block mt-1">
                            <img src="<%= (u.profileImage || u.profilePicture) ? (u.profileImage || u.profilePicture) : `https://ui-avatars.com/api/?name=${encodeURIComponent(u.name || 'Student')}&background=random` %>" class="w-full h-full object-cover">
                        </div>

                        <div class="flex-1 min-w-0 flex flex-col gap-1.5">
                            <!-- Text Box Container with Ask Button inside -->
                            <div class="w-full relative flex items-end gap-1.5 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 rounded-2xl focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/15 transition-all p-1.5 pl-3 shadow-2xs">
                                <textarea id="ask-question-textarea" name="question" rows="1" required placeholder="Ask your question or academic doubt..."
                                    oninput="this.style.height = ''; this.style.height = Math.min(this.scrollHeight, 110) + 'px'"
                                    class="flex-1 min-h-[38px] max-h-[110px] py-1.5 bg-transparent text-xs sm:text-[13px] font-semibold text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 outline-none resize-none leading-relaxed border-none pr-1"></textarea>

                                <!-- Ask Question Submit Button (Placed inside the text box) -->
                                <button type="submit" class="h-9 px-3.5 sm:px-4 bg-primary hover:bg-primary/90 text-white text-xs sm:text-[13px] font-bold rounded-xl transition-all flex items-center gap-1.5 shadow-md shadow-primary/25 shrink-0 active:scale-95 cursor-pointer select-none" title="Ask Question">
                                    <span>Ask</span>
                                    <span class="material-symbols-rounded text-base leading-none select-none">send</span>
                                </button>
                            </div>

                            <!-- Filter & Photo Attachment Row (Minimal gap with the text box) -->
                            <div class="flex items-center gap-1.5 w-full">
                                <!-- Attach Photo Button -->
                                <label class="h-8.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold flex items-center gap-1.5 cursor-pointer transition-all active:scale-95 border border-slate-200/90 dark:border-slate-700/80 shadow-2xs shrink-0 select-none" title="Attach Photo">
                                    <span class="material-symbols-rounded text-primary text-base leading-none select-none">add_a_photo</span>
                                    <span>Photo</span>
                                    <input type="file" name="image" id="ask-file-input" accept="image/*" class="hidden" onchange="previewAskImage(this)">
                                </label>

                                <!-- Hidden input for form submission -->
                                <input type="hidden" name="subject" id="ask-subject-input" value="<%= (locals.availableSubjects && locals.availableSubjects[0]) || 'Physics' %>">

                                <!-- Custom Platform Subject Selector Dropdown Trigger -->
                                <div class="relative shrink-0" id="ask-subject-picker-container">
                                    <button type="button" id="ask-subject-picker-btn" onclick="toggleAskSubjectPicker(event)"
                                        class="h-8.5 px-3 max-w-[170px] sm:max-w-[210px] bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200/90 dark:border-slate-700/80 text-xs font-bold text-slate-700 dark:text-slate-200 rounded-xl flex items-center gap-1.5 cursor-pointer shadow-2xs transition-all active:scale-95 select-none"
                                        title="Select Subject">
                                        <span class="material-symbols-rounded text-primary text-base leading-none select-none">auto_stories</span>
                                        <span id="ask-subject-selected-text" class="truncate"><%= (locals.availableSubjects && locals.availableSubjects[0]) || 'Physics' %></span>
                                        <span class="material-symbols-rounded text-slate-400 text-sm leading-none shrink-0 select-none">expand_more</span>
                                    </button>

                                    <!-- Mobile Backdrop Overlay -->
                                    <div id="ask-subject-backdrop" class="hidden fixed inset-0 bg-black/40 backdrop-blur-2xs z-40 sm:hidden" onclick="toggleAskSubjectPicker(event)"></div>

                                    <!-- Platform Dropdown Menu / Bottom Sheet -->
                                    <div id="ask-subject-menu" class="hidden fixed inset-x-4 bottom-24 max-h-[65vh] sm:absolute sm:inset-auto sm:left-0 sm:bottom-full sm:mb-2 w-auto sm:w-64 bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl z-50 p-2.5 space-y-1.5 overflow-y-auto no-scrollbar">
                                        <!-- Header -->
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 px-1">
                                            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white">
                                                <span class="material-symbols-rounded text-base text-primary">auto_stories</span>
                                                <span>Select Subject</span>
                                            </div>
                                            <button type="button" onclick="toggleAskSubjectPicker(event)" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 flex items-center justify-center cursor-pointer">
                                                <span class="material-symbols-rounded text-base">close</span>
                                            </button>
                                        </div>

                                        <!-- Subject Options List -->
                                        <div class="space-y-1 max-h-52 overflow-y-auto no-scrollbar py-0.5">
                                            <% const subsList = (locals.availableSubjects || ['Physics', 'Chemistry', 'Higher Math', 'General Math', 'Biology', 'ICT', 'English', 'Bangla', 'General Academic']); %>
                                            <% subsList.forEach((sub, idx) => { %>
                                                <button type="button" onclick="selectAskSubject('<%= sub %>')" id="ask-sub-opt-<%= sub.toLowerCase().replace(/\s+/g, '-') %>"
                                                    class="ask-subject-item w-full px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer <%= idx === 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-transparent' %>">
                                                    <span class="truncate"><%= sub %></span>
                                                    <span class="material-symbols-rounded text-base <%= idx === 0 ? 'text-primary' : 'text-transparent' %> ask-sub-check">
                                                        check
                                                    </span>
                                                </button>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </main>
    </div>

    <!-- Fullscreen In-Page Lightbox Image Viewer Modal -->
    <div id="image-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-200" onclick="closeImageModal()">
        <div class="relative max-w-4xl max-h-[90vh] flex flex-col items-center justify-center" onclick="event.stopPropagation()">
            <button type="button" onclick="closeImageModal()" class="absolute -top-10 right-0 text-white/80 hover:text-white text-xs font-bold flex items-center gap-1 bg-black/60 px-3 py-1 rounded-full border border-white/20 transition-colors shadow-md">
                <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">close</span>
                <span>Close</span>
            </button>
            <img id="image-modal-img" src="" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl border border-white/10">
        </div>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'qa' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        // In-Page Lightbox Image Modal Handlers
        function openImageModal(src) {
            const modal = document.getElementById('image-modal');
            const modalImg = document.getElementById('image-modal-img');
            if (modal && modalImg) {
                modalImg.src = src;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeImageModal() {
            const modal = document.getElementById('image-modal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // Preview Ask Image
        function previewAskImage(input) {
            const preview = document.getElementById('ask-img-preview');
            const nameSpan = document.getElementById('ask-img-name');
            if (input.files && input.files[0]) {
                nameSpan.textContent = input.files[0].name;
                preview.classList.remove('hidden');
            }
        }

        function clearAskImage() {
            const input = document.getElementById('ask-file-input');
            const preview = document.getElementById('ask-img-preview');
            if (input) input.value = '';
            if (preview) preview.classList.add('hidden');
        }

        // Preview Reply Image
        function previewReplyImage(qaId, input) {
            const preview = document.getElementById('reply-img-preview-' + qaId);
            const nameSpan = document.getElementById('reply-img-name-' + qaId);
            if (input.files && input.files[0]) {
                nameSpan.textContent = input.files[0].name;
                preview.classList.remove('hidden');
            }
        }

        function clearReplyImage(qaId) {
            const input = document.getElementById('reply-file-' + qaId);
            const preview = document.getElementById('reply-img-preview-' + qaId);
            if (input) input.value = '';
            if (preview) preview.classList.add('hidden');
        }

        // Live client-side search functionality
        function filterLiveQuestions() {
            const screenInput = document.getElementById('qa-screen-search-input');
            const headerInput = document.getElementById('qa-search-input');
            
            // Prefer whichever input was typed into, or screen input by default
            let query = '';
            if (screenInput && screenInput.value.trim().length > 0) {
                query = screenInput.value.trim().toLowerCase();
            } else if (headerInput && headerInput.value.trim().length > 0) {
                query = headerInput.value.trim().toLowerCase();
            }

            // Keep both inputs in sync if both exist
            if (screenInput && headerInput) {
                if (document.activeElement === screenInput) headerInput.value = screenInput.value;
                else if (document.activeElement === headerInput) screenInput.value = headerInput.value;
            }

            const screenClearBtn = document.getElementById('qa-screen-clear-btn');
            const headerClearBtn = document.getElementById('clear-search-btn');
            
            if (screenClearBtn) {
                if (query.length > 0) screenClearBtn.classList.remove('hidden');
                else screenClearBtn.classList.add('hidden');
            }
            if (headerClearBtn) {
                if (query.length > 0) headerClearBtn.classList.remove('hidden');
                else headerClearBtn.classList.add('hidden');
            }

            const cards = document.querySelectorAll('.qa-card');
            const noResultsBox = document.getElementById('no-live-results');
            let visibleCount = 0;

            cards.forEach(card => {
                const searchable = card.getAttribute('data-search') || '';
                if (!query || searchable.includes(query)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            if (noResultsBox) {
                if (visibleCount === 0 && cards.length > 0) {
                    noResultsBox.classList.remove('hidden');
                } else {
                    noResultsBox.classList.add('hidden');
                }
            }
        }

        function clearQaScreenSearch() {
            const screenInput = document.getElementById('qa-screen-search-input');
            const headerInput = document.getElementById('qa-search-input');
            if (screenInput) screenInput.value = '';
            if (headerInput) headerInput.value = '';
            filterLiveQuestions();
            if (screenInput) screenInput.focus();
        }

        function clearLiveSearch() {
            clearQaScreenSearch();
        }

        // Multiple Filtering State & Handlers
        let currentSelectedStatuses = <%- JSON.stringify(activeStatuses) %>;
        let currentSelectedSubjects = <%- JSON.stringify(activeSubjects) %>;

        function toggleQaFilterDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('qa-filter-dropdown-menu');
            const backdrop = document.getElementById('qa-filter-backdrop');
            if (menu) {
                const isHidden = menu.classList.contains('hidden');
                if (isHidden) {
                    menu.classList.remove('hidden');
                    if (backdrop) backdrop.classList.remove('hidden');
                } else {
                    menu.classList.add('hidden');
                    if (backdrop) backdrop.classList.add('hidden');
                }
            }
        }

        function toggleStatusFilterItem(statusVal) {
            statusVal = statusVal.toLowerCase();
            const idx = currentSelectedStatuses.indexOf(statusVal);
            if (idx > -1) {
                currentSelectedStatuses.splice(idx, 1);
            } else {
                currentSelectedStatuses.push(statusVal);
            }
            renderFilterModalDOM();
        }

        function toggleSubjectFilterItem(subVal) {
            subVal = subVal.toLowerCase();
            const idx = currentSelectedSubjects.indexOf(subVal);
            if (idx > -1) {
                currentSelectedSubjects.splice(idx, 1);
            } else {
                currentSelectedSubjects.push(subVal);
            }
            renderFilterModalDOM();
        }

        function clearAllFiltersModal() {
            currentSelectedStatuses = [];
            currentSelectedSubjects = [];
            renderFilterModalDOM();
        }

        function renderFilterModalDOM() {
            // Update status buttons in modal
            const statusBtns = document.querySelectorAll('.modal-status-btn');
            statusBtns.forEach(btn => {
                const id = btn.id.replace('modal-status-', '');
                const isActive = currentSelectedStatuses.includes(id);
                if (id === 'resolved') {
                    btn.className = "modal-status-btn p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer " + 
                        (isActive ? 'bg-emerald-500/15 border-emerald-500 text-emerald-600 dark:text-emerald-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100');
                    const icon = btn.querySelector('.material-symbols-rounded');
                    if (icon) icon.className = "material-symbols-rounded text-base " + (isActive ? 'text-emerald-500' : 'text-slate-400');
                } else if (id === 'open') {
                    btn.className = "modal-status-btn p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer " + 
                        (isActive ? 'bg-amber-500/15 border-amber-500 text-amber-600 dark:text-amber-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100');
                    const icon = btn.querySelector('.material-symbols-rounded');
                    if (icon) icon.className = "material-symbols-rounded text-base " + (isActive ? 'text-amber-500' : 'text-slate-400');
                } else if (id === 'my') {
                    btn.className = "modal-status-btn col-span-2 p-2.5 rounded-xl border text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer " + 
                        (isActive ? 'bg-indigo-500/15 border-indigo-500 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100');
                    const icon = btn.querySelector('.material-symbols-rounded');
                    if (icon) icon.className = "material-symbols-rounded text-base " + (isActive ? 'text-indigo-500' : 'text-slate-400');
                }
            });

            // Update subject buttons in modal
            const subBtns = document.querySelectorAll('.modal-sub-btn');
            subBtns.forEach(btn => {
                const subKey = btn.id.replace('modal-sub-', '').replace(/-/g, ' ');
                const isActive = currentSelectedSubjects.includes(subKey);
                btn.className = "modal-sub-btn px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between border transition-all active:scale-95 cursor-pointer " +
                    (isActive ? 'bg-primary/10 border-primary text-primary font-bold shadow-2xs' : 'bg-slate-50 dark:bg-slate-800/80 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100');
                const icon = btn.querySelector('.material-symbols-rounded');
                if (icon) {
                    icon.textContent = isActive ? 'check_box' : 'check_box_outline_blank';
                    icon.className = "material-symbols-rounded text-sm " + (isActive ? 'text-primary' : 'text-slate-300 dark:text-slate-600');
                }
            });
        }

        function applyMultipleFilters() {
            const menu = document.getElementById('qa-filter-dropdown-menu');
            const backdrop = document.getElementById('qa-filter-backdrop');
            if (menu) menu.classList.add('hidden');
            if (backdrop) backdrop.classList.add('hidden');

            const url = new URL(window.location.href);
            if (currentSelectedStatuses.length > 0) {
                url.searchParams.set('status', currentSelectedStatuses.join(','));
            } else {
                url.searchParams.set('status', 'all');
            }

            if (currentSelectedSubjects.length > 0) {
                url.searchParams.set('subject', currentSelectedSubjects.join(','));
            } else {
                url.searchParams.set('subject', 'all');
            }

            const screenInput = document.getElementById('qa-screen-search-input');
            const headerInput = document.getElementById('qa-search-input');
            const query = (screenInput && screenInput.value.trim()) || (headerInput && headerInput.value.trim()) || '';
            if (query) {
                url.searchParams.set('search', query);
            } else {
                url.searchParams.delete('search');
            }
            window.location.href = url.toString();
        }

        function removeSingleFilter(type, value) {
            const url = new URL(window.location.href);
            value = value.toLowerCase();
            if (type === 'status') {
                const list = currentSelectedStatuses.filter(s => s !== value);
                url.searchParams.set('status', list.length > 0 ? list.join(',') : 'all');
            } else if (type === 'subject') {
                const list = currentSelectedSubjects.filter(s => s !== value);
                url.searchParams.set('subject', list.length > 0 ? list.join(',') : 'all');
            }
            window.location.href = url.toString();
        }

        let lastQaScrollTop = 0;

        function showComposer(composer) {
            composer.classList.remove('translate-y-[120%]', 'opacity-0', 'pointer-events-none');
            composer.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        }

        function hideComposer(composer) {
            composer.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
            composer.classList.add('translate-y-[120%]', 'opacity-0', 'pointer-events-none');
        }

        function focusAskComposer() {
            const composer = document.getElementById('ask-question-box');
            const textarea = document.getElementById('ask-question-textarea');
            if (composer) {
                showComposer(composer);
            }
            if (textarea) {
                textarea.focus();
            }
        }

        // Sticky Bottom Composer Scroll Listener (Hides on scroll-down, reveals on scroll-up / top / bottom)
        function handleQaScroll() {
            const scrollContainer = document.getElementById('qa-main-scroll');
            const composer = document.getElementById('ask-question-box');
            const textarea = document.getElementById('ask-question-textarea');
            if (!scrollContainer || !composer) return;

            // If user is currently typing in the input, never hide it
            if (document.activeElement === textarea) {
                showComposer(composer);
                return;
            }

            const currentScrollTop = scrollContainer.scrollTop;
            const scrollHeight = scrollContainer.scrollHeight;
            const clientHeight = scrollContainer.clientHeight;
            const distanceFromBottom = scrollHeight - (currentScrollTop + clientHeight);
            const scrollDelta = currentScrollTop - lastQaScrollTop;

            // 1. At the very top (scrollTop <= 50): Keep visible
            if (currentScrollTop <= 50) {
                showComposer(composer);
            }
            // 2. Near the very bottom (within 50px): Keep visible
            else if (distanceFromBottom <= 50) {
                showComposer(composer);
            }
            // 3. Scrolling DOWN (reading questions): hide composer
            else if (scrollDelta > 6) {
                hideComposer(composer);
            }
            // 4. Scrolling UP (navigating or wanting to write): reveal composer
            else if (scrollDelta < -6) {
                showComposer(composer);
            }

            lastQaScrollTop = Math.max(0, currentScrollTop);
        }

        function toggleReplyDrawer(qaId) {
            const drawer = document.getElementById('reply-drawer-' + qaId);
            if (drawer) drawer.classList.toggle('hidden');
        }

        function mentionUser(qaId, userName) {
            const drawer = document.getElementById('reply-drawer-' + qaId);
            if (drawer && drawer.classList.contains('hidden')) {
                drawer.classList.remove('hidden');
            }
            const input = document.getElementById('reply-input-' + qaId);
            if (input) {
                input.value = `@${userName} ` + input.value;
                input.focus();
            }
        }

        function toggleUpvote(qaId, btn) {
            fetch('/qa/upvote/' + qaId, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const countSpan = btn.querySelector('.upvote-count');
                        const iconSpan = btn.querySelector('.material-symbols-rounded');
                        if (countSpan) countSpan.textContent = data.count;
                        
                        if (data.upvoted) {
                            btn.className = "upvote-btn h-8.5 sm:h-9 px-3 rounded-xl bg-rose-50 dark:bg-rose-500/15 border border-rose-200 dark:border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs active:scale-95";
                            if (iconSpan) {
                                iconSpan.classList.add('text-rose-500', 'fill-1');
                                iconSpan.classList.remove('text-slate-400');
                            }
                        } else {
                            btn.className = "upvote-btn h-8.5 sm:h-9 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60 transition-all flex items-center gap-1.5 active:scale-95";
                            if (iconSpan) {
                                iconSpan.classList.remove('text-rose-500', 'fill-1');
                                iconSpan.classList.add('text-slate-400');
                            }
                        }
                    }
                })
                .catch(err => console.error('Upvote error:', err));
        }

        // Platform Subject Picker Handlers for Composer
        function toggleAskSubjectPicker(e) {
            if (e) {
                e.stopPropagation();
                e.preventDefault();
            }
            const menu = document.getElementById('ask-subject-menu');
            const backdrop = document.getElementById('ask-subject-backdrop');
            if (menu) {
                const isHidden = menu.classList.contains('hidden');
                if (isHidden) {
                    menu.classList.remove('hidden');
                    if (backdrop) backdrop.classList.remove('hidden');
                } else {
                    menu.classList.add('hidden');
                    if (backdrop) backdrop.classList.add('hidden');
                }
            }
        }

        function selectAskSubject(subName) {
            const input = document.getElementById('ask-subject-input');
            const label = document.getElementById('ask-subject-selected-text');
            const menu = document.getElementById('ask-subject-menu');
            const backdrop = document.getElementById('ask-subject-backdrop');

            if (input) input.value = subName;
            if (label) label.textContent = subName;

            // Update item highlights and checkmarks
            const items = document.querySelectorAll('.ask-subject-item');
            items.forEach(btn => {
                const btnText = btn.querySelector('span:first-child')?.textContent?.trim();
                const checkIcon = btn.querySelector('.ask-sub-check');
                if (btnText === subName) {
                    btn.className = "ask-subject-item w-full px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer bg-primary/10 text-primary border border-primary/20";
                    if (checkIcon) {
                        checkIcon.classList.remove('text-transparent');
                        checkIcon.classList.add('text-primary');
                    }
                } else {
                    btn.className = "ask-subject-item w-full px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition-all active:scale-95 cursor-pointer text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-transparent";
                    if (checkIcon) {
                        checkIcon.classList.add('text-transparent');
                        checkIcon.classList.remove('text-primary');
                    }
                }
            });

            if (menu) menu.classList.add('hidden');
            if (backdrop) backdrop.classList.add('hidden');
        }

        // Close dropdowns when tapping outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('qa-filter-dropdown-container');
            const menu = document.getElementById('qa-filter-dropdown-menu');
            const backdrop = document.getElementById('qa-filter-backdrop');
            if (container && menu && !container.contains(e.target)) {
                menu.classList.add('hidden');
                if (backdrop) backdrop.classList.add('hidden');
            }

            const subContainer = document.getElementById('ask-subject-picker-container');
            const subMenu = document.getElementById('ask-subject-menu');
            const subBackdrop = document.getElementById('ask-subject-backdrop');
            if (subContainer && subMenu && !subContainer.contains(e.target)) {
                subMenu.classList.add('hidden');
                if (subBackdrop) subBackdrop.classList.add('hidden');
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const screenInput = document.getElementById('qa-screen-search-input');
            const headerInput = document.getElementById('qa-search-input');
            
            if (screenInput) {
                screenInput.addEventListener('input', filterLiveQuestions);
                if (screenInput.value.trim().length > 0) {
                    filterLiveQuestions();
                }
            }
            if (headerInput) {
                headerInput.addEventListener('input', filterLiveQuestions);
                if (headerInput.value.trim().length > 0) {
                    filterLiveQuestions();
                }
            }

            const alertBox = document.getElementById('flash-alert');
            if (alertBox) {
                setTimeout(function() {
                    alertBox.style.opacity = '0';
                    setTimeout(function() { alertBox.remove(); }, 300);
                }, 3000);
            }

            if (window.location.search) {
                const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + window.location.hash;
                window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
            }

            // Close image modal on Escape key press
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeImageModal();
            });

            // Attach Scroll Listener for Floating Write Button
            const scrollContainer = document.getElementById('qa-main-scroll');
            if (scrollContainer) {
                scrollContainer.addEventListener('scroll', handleQaScroll, { passive: true });
            }
            window.addEventListener('scroll', handleQaScroll, { passive: true });
            handleQaScroll();
        });
    </script>
</body>
</html>