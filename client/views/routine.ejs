<!DOCTYPE html>
<html lang="en" class="<%= (locals.user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Routine & Study Plan | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full">
        <%- include('partials/student-sidebar', { activePage: 'routine' }) %>
        
        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative font-['Plus_Jakarta_Sans',sans-serif]">
            
            <!-- Page Header Bar (Left: Title & Subtitle, Right: AI Planner & Add Task) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800 px-3.5 sm:px-4 py-2.5 flex items-center justify-between gap-2 shrink-0">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="size-8 sm:size-9 rounded-xl bg-gradient-to-tr from-rose-500/15 via-rose-500/10 to-indigo-500/15 text-rose-500 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-500/20">
                        <span class="material-symbols-rounded text-lg sm:text-xl leading-none">calendar_month</span>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-tight truncate">Routine & Plan</h1>
                        <p class="text-[10px] text-slate-400 font-medium leading-none hidden sm:block">Track daily tasks, exams & live classes</p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    <button onclick="openAiModal()" class="h-8.5 sm:h-9 px-2.5 sm:px-3.5 bg-gradient-to-r from-rose-500 via-rose-600 to-indigo-600 hover:opacity-95 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm shadow-rose-500/20 transition-all cursor-pointer select-none">
                        <span class="material-symbols-rounded text-base leading-none shrink-0">auto_awesome</span>
                        <span class="hidden xs:inline sm:inline">AI Planner</span>
                        <span class="xs:hidden sm:hidden">AI</span>
                    </button>
                    <button onclick="openAddTaskModal()" class="h-8.5 sm:h-9 px-2.5 sm:px-3.5 bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer select-none">
                        <span class="material-symbols-rounded text-base leading-none shrink-0">add_circle</span>
                        <span class="hidden xs:inline sm:inline">Add Task</span>
                        <span class="xs:hidden sm:hidden">Add</span>
                    </button>
                </div>
            </div>

            <!-- Weekly 7-Day Interactive Calendar Strip (Saturday to Friday) -->
            <% 
                const now = new Date();
                const currDayOfWeek = now.getDay(); // 0 = Sun, 6 = Sat
                const saturdayOffset = currDayOfWeek === 6 ? 0 : -(currDayOfWeek + 1);
                const saturdayDate = new Date(now);
                saturdayDate.setDate(now.getDate() + saturdayOffset);
                
                const dayNames = ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
                const fullDayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const todayName = fullDayNames[now.getDay()];

                const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                const todayFormattedDate = `${todayName}, ${now.getDate()} ${monthNames[now.getMonth()]}`;
                
                const weekDates = [];
                for (let i = 0; i < 7; i++) {
                    const d = new Date(saturdayDate);
                    d.setDate(saturdayDate.getDate() + i);
                    let iso = '';
                    try { iso = d.toISOString().split('T')[0]; } catch(e){}
                    const isToday = (iso === now.toISOString().split('T')[0]);
                    
                    const dayTasks = (locals.tasks || []).filter(t => {
                        try {
                            if (!t || !t.date) return false;
                            return new Date(t.date).toISOString().split('T')[0] === iso;
                        } catch(e) { return false; }
                    });
                    
                    weekDates.push({
                        name: dayNames[i],
                        dateNum: d.getDate(),
                        iso: iso,
                        isToday: isToday,
                        taskCount: dayTasks.length,
                        completedCount: dayTasks.filter(t => t && t.isCompleted).length
                    });
                }

                // Compute Other Dates Serial List outside current Saturday-Friday week
                const currentWeekISOs = weekDates.map(w => w.iso);
                const otherTaskDatesMap = {};
                (locals.tasks || []).forEach(t => {
                    try {
                        if (t && t.date) {
                            const iso = new Date(t.date).toISOString().split('T')[0];
                            if (!currentWeekISOs.includes(iso)) {
                                if (!otherTaskDatesMap[iso]) {
                                    otherTaskDatesMap[iso] = { iso: iso, count: 0 };
                                }
                                otherTaskDatesMap[iso].count++;
                            }
                        }
                    } catch(e){}
                });
                const otherTaskDates = Object.values(otherTaskDatesMap).sort((a,b) => a.iso.localeCompare(b.iso));
            %>
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800 p-2.5 sm:p-3 shrink-0">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 mb-2 gap-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <span class="material-symbols-rounded text-primary text-base leading-none shrink-0">event_repeat</span>
                        <h2 class="text-xs font-bold text-slate-800 dark:text-white truncate">Weekly Schedule</h2>
                    </div>
                    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                        <button onclick="filterByDate('all')" id="btn-date-all" class="date-filter-btn px-2 sm:px-2.5 py-1 text-[10px] font-bold rounded-lg bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-primary/40 transition-colors cursor-pointer select-none">
                            All
                        </button>
                        <button onclick="filterByDate('<%= now.toISOString().split('T')[0] %>')" id="btn-date-today" class="date-filter-btn px-2 sm:px-2.5 py-1 text-[10px] font-bold rounded-lg bg-primary text-white border border-primary shadow-sm transition-colors cursor-pointer select-none">
                            Today
                        </button>
                        
                        <!-- Other Dates Serial List Dropdown -->
                        <div class="relative">
                            <button onclick="toggleOtherDatesDropdown(event)" id="btn-date-other" class="date-filter-btn px-2 sm:px-2.5 py-1 text-[10px] font-bold rounded-lg bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-primary/40 transition-colors flex items-center gap-0.5 cursor-pointer select-none">
                                <span class="material-symbols-rounded text-xs leading-none shrink-0">calendar_month</span>
                                <span id="otherDateBtnLabel">Other</span>
                                <span class="material-symbols-rounded text-xs leading-none shrink-0">expand_more</span>
                            </button>

                            <div id="otherDatesMenu" class="absolute right-0 top-full mt-1 w-48 bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl hidden z-50 p-1.5 max-h-48 overflow-y-auto no-scrollbar">
                                <% if (otherTaskDates && otherTaskDates.length > 0) { %>
                                    <% otherTaskDates.forEach(od => { %>
                                        <button onclick="filterByDate('<%= od.iso %>'); hideOtherDatesDropdown();" class="w-full text-left px-2.5 py-1.5 text-[10px] font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg flex items-center justify-between">
                                            <span>📅 <%= od.iso %></span>
                                            <span class="px-1.5 py-0.5 text-[9px] rounded-full bg-primary/10 text-primary border border-primary/20"><%= od.count %> tasks</span>
                                        </button>
                                    <% }); %>
                                <% } else { %>
                                    <div class="px-2.5 py-2 text-[10px] font-semibold text-slate-400 text-center">No other task dates set</div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Compact Weekly Days Cards (Saturday to Friday) -->
                <div class="grid grid-cols-7 gap-1 sm:gap-1.5 text-center w-full">
                    <% weekDates.forEach(wd => { %>
                        <button onclick="filterByDate('<%= wd.iso %>')" id="date-strip-<%= wd.iso %>" 
                            class="date-strip-card flex flex-col items-center justify-center py-1.5 sm:py-2 px-0.5 sm:px-1 rounded-xl border transition-all cursor-pointer group <%= wd.isToday ? 'bg-rose-50/80 dark:bg-rose-950/40 border-rose-500 shadow-sm' : 'bg-slate-50/60 dark:bg-slate-900/60 border-slate-200/70 dark:border-slate-800 hover:border-primary/40' %>">
                            <span class="text-[9px] font-bold <%= wd.isToday ? 'text-rose-500' : 'text-slate-400' %> uppercase leading-none"><%= wd.name %></span>
                            <span class="text-xs sm:text-sm font-black <%= wd.isToday ? 'text-rose-500' : 'text-slate-800 dark:text-white' %> leading-none my-1"><%= wd.dateNum %></span>
                            <% if (wd.taskCount > 0) { %>
                                <span class="px-1 py-0.5 text-[8px] font-extrabold rounded <%= wd.completedCount === wd.taskCount ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-primary/10 text-primary border border-primary/20' %> leading-none">
                                    <%= wd.completedCount %>/<%= wd.taskCount %>
                                </span>
                            <% } else { %>
                                <span class="text-[9px] text-slate-300 dark:text-slate-600 font-semibold leading-none">•</span>
                            <% } %>
                        </button>
                    <% }); %>
                </div>
            </div>

            <!-- Two-Column Layout Attached Seamlessly (Left: Tasks & Routine, Right: XP, Exams & Quotes) -->
            <div class="flex-1 grid grid-cols-1 lg:grid-cols-5 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800 w-full min-h-0 bg-white dark:bg-[#0b1120]">

                <!-- LEFT COLUMN: Task Tracker + Course Routine (col-span-3) -->
                <div class="lg:col-span-3 flex flex-col divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-[#0b1120]">

                    <!-- 1. Today's Tasks & Learning Goals Widget -->
                    <div class="w-full flex flex-col bg-white dark:bg-[#0f172a]/50">
                        
                        <!-- Header Bar -->
                        <div class="flex items-center justify-between px-3.5 sm:px-4 py-2 sm:py-2.5 border-b border-slate-100 dark:border-slate-800 gap-2 bg-slate-50/50 dark:bg-[#0f172a]">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="material-symbols-rounded text-[#F43F5E] text-lg shrink-0 leading-none">task_alt</span>
                                <h2 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-200 leading-tight truncate" id="taskSectionTitle">Today's Tasks</h2>
                            </div>

                            <!-- Progress Indicator & Clear Completed Action -->
                            <% 
                                const todayStr = now.toISOString().split('T')[0];
                                const todayTasks = (locals.tasks || []).filter(t => {
                                    try { return t && t.date && new Date(t.date).toISOString().split('T')[0] === todayStr; } catch(e) { return false; }
                                });
                                const completedToday = todayTasks.filter(t => t && t.isCompleted).length;
                                const progressPct = todayTasks.length > 0 ? Math.round((completedToday / todayTasks.length) * 100) : 0;
                            %>
                            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                                <button id="clearCompletedBtn" onclick="promptClearCompleted()" class="hidden px-2 py-0.5 text-[10px] font-bold text-rose-500 hover:text-white bg-rose-50 hover:bg-rose-500 dark:bg-rose-950/40 dark:hover:bg-rose-600 border border-rose-200 dark:border-rose-900 rounded-lg transition-colors flex items-center gap-1 cursor-pointer select-none">
                                    <span class="material-symbols-rounded text-xs leading-none shrink-0">delete_sweep</span> Delete All
                                </button>
                                <span id="taskProgressBadge" class="px-2 py-0.5 rounded-lg text-[10px] font-extrabold bg-rose-500/10 text-[#F43F5E] border border-rose-500/20 flex items-center gap-1">
                                    <span class="material-symbols-rounded text-xs leading-none shrink-0">bolt</span>
                                    <span id="taskProgressText"><%= completedToday %>/<%= todayTasks.length %> (<%= progressPct %>%)</span>
                                </span>
                            </div>
                        </div>

                        <!-- Sub Filter Bar (Smooth Pill Tabs) -->
                        <div class="flex items-center gap-1.5 px-3.5 sm:px-4 py-2 bg-slate-50/60 dark:bg-slate-900/40 border-b border-slate-100 dark:border-slate-800/80 overflow-x-auto no-scrollbar">
                            <button onclick="filterTaskType('all', this)" class="type-filter-btn active px-3 py-1 rounded-xl text-xs font-bold bg-primary text-white border border-primary transition-all whitespace-nowrap cursor-pointer select-none">All Tasks</button>
                            <button onclick="filterTaskType('class', this)" class="type-filter-btn px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all whitespace-nowrap cursor-pointer select-none">Class</button>
                            <button onclick="filterTaskType('exam', this)" class="type-filter-btn px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all whitespace-nowrap cursor-pointer select-none">Exams</button>
                            <button onclick="filterTaskType('task', this)" class="type-filter-btn px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all whitespace-nowrap cursor-pointer select-none">Reading</button>
                            <button onclick="filterTaskType('completed', this)" class="type-filter-btn px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all whitespace-nowrap cursor-pointer select-none">Completed</button>
                        </div>

                        <!-- Task List Container -->
                        <div class="p-3.5 sm:p-4 flex-1 flex flex-col">
                            <div class="space-y-2 flex-1" id="tasksListContainer">
                                <% if (locals.tasks && tasks.length > 0) { %>
                                    <% tasks.forEach(task => { 
                                        let taskDateStr = '';
                                        try { 
                                            if (task && task.date) {
                                                taskDateStr = new Date(task.date).toISOString().split('T')[0]; 
                                            }
                                        } catch(e){}
                                    %>
                                        <div class="routine-task-row flex items-center justify-between p-2.5 sm:p-3 rounded-xl border bg-slate-50/70 dark:bg-slate-900/60 border-slate-200/70 dark:border-slate-800 transition-all gap-2.5 sm:gap-3 group hover:border-primary/40 cursor-pointer"
                                            id="task-row-<%= task._id %>"
                                            data-date="<%= taskDateStr %>"
                                            data-type="<%= task.type || 'task' %>"
                                            data-completed="<%= task.isCompleted ? 'true' : 'false' %>"
                                            onclick="toggleTask('<%= task._id %>')">
                                            
                                            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1">
                                                <!-- Checkbox Box -->
                                                <div class="task-checkbox-box size-5 sm:size-5.5 rounded-lg border-2 flex items-center justify-center transition-all shrink-0 <%= task.isCompleted ? 'bg-primary border-primary' : 'border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800' %>">
                                                    <span class="material-symbols-rounded text-white text-xs font-bold leading-none flex items-center justify-center shrink-0 <%= task.isCompleted ? '' : 'hidden' %>">check</span>
                                                </div>
                                                
                                                <!-- Title & Badges -->
                                                <div class="min-w-0 flex-1">
                                                    <h3 class="task-title-text text-xs sm:text-[13px] font-bold text-slate-800 dark:text-slate-200 truncate <%= task.isCompleted ? 'line-through opacity-50' : '' %>">
                                                        <%= task.title %>
                                                    </h3>
                                                    <div class="flex items-center gap-1.5 sm:gap-2 mt-0.5 text-[9.5px] sm:text-[10px] font-semibold text-slate-400 flex-wrap">
                                                        <% if (task.time) { %>
                                                            <span class="flex items-center gap-0.5">
                                                                <span class="material-symbols-rounded text-xs shrink-0 leading-none">schedule</span>
                                                                <%= task.time %>
                                                            </span>
                                                        <% } %>
                                                        <span class="px-1.5 py-0.5 rounded text-[8.5px] font-extrabold uppercase tracking-wider <%= task.type === 'exam' ? 'bg-rose-50 dark:bg-rose-500/10 text-rose-500 border border-rose-200/50' : (task.type === 'class' ? 'bg-indigo-50 dark:bg-indigo-500/10 text-indigo-500 border border-indigo-200/50' : 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 border border-emerald-200/50') %>">
                                                            <%= task.type === 'exam' ? 'Exams' : (task.type === 'class' ? 'Class' : 'Reading') %>
                                                        </span>
                                                        <span class="text-[9px] text-slate-400 font-medium hidden xs:inline sm:inline">
                                                            📅 <%= taskDateStr %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Actions: Go to Resource & Delete -->
                                            <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                                                <% 
                                                    let resourceUrl = task.link;
                                                    if (!resourceUrl || resourceUrl === '') {
                                                        if (task.type === 'exam') resourceUrl = '/exams';
                                                        else if (task.type === 'class') resourceUrl = '/courses';
                                                        else resourceUrl = '/library';
                                                    }
                                                %>
                                                <a href="<%= resourceUrl %>" target="_blank" rel="noopener noreferrer" 
                                                    onclick="event.stopPropagation(); handleResourceClick('<%= task._id %>', <%= task.isCompleted %>);" 
                                                    class="h-7 px-2 bg-rose-500/10 hover:bg-[#F43F5E] text-[#F43F5E] hover:text-white rounded-lg border border-rose-500/20 text-[10px] font-extrabold flex items-center gap-1 transition-all shrink-0">
                                                    <span class="material-symbols-rounded text-xs leading-none shrink-0">open_in_new</span>
                                                    <span class="hidden xs:inline">Resource</span>
                                                </a>
                                                
                                                <button onclick="event.stopPropagation(); promptDeleteSingleTask('<%= task._id %>')"
                                                    class="size-7 rounded-lg flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors shrink-0 opacity-80 sm:opacity-0 group-hover:opacity-100" title="Delete Task">
                                                    <span class="material-symbols-rounded text-base leading-none shrink-0">delete</span>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>

                                <!-- Cute Encouraging Empty State Notice -->
                                <div class="flex flex-col items-center justify-center text-center py-8 px-4 gap-2 my-auto" id="no-tasks-placeholder">
                                    <div class="size-12 rounded-2xl bg-gradient-to-tr from-rose-100 to-indigo-100 dark:from-rose-950/40 dark:to-indigo-950/40 flex items-center justify-center text-rose-500 shadow-sm shrink-0 border border-rose-200/50 dark:border-rose-900/40">
                                        <span class="material-symbols-rounded text-2xl leading-none flex items-center justify-center shrink-0">celebration</span>
                                    </div>
                                    <h3 class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-slate-100">No tasks</h3>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold max-w-xs leading-relaxed">Add new tasks to elevate your academic performance and track your daily progress.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Enrolled Class Routine (Shows Today's Routine Only with Date Badge) -->
                    <% 
                        const todayRoutines = [];
                        if (locals.enrolledCourses && enrolledCourses.length > 0) {
                            enrolledCourses.forEach(ec => {
                                if (ec && ec.course && ec.course.routine && ec.course.routine.length > 0) {
                                    ec.course.routine.forEach(r => {
                                        if (r && r.day && r.day.toLowerCase().trim() === todayName.toLowerCase().trim()) {
                                            let isLiveStarted = false;
                                            let liveJoinUrl = `/course/${ec.course._id}`;

                                            if (ec.course.isLive) {
                                                isLiveStarted = true;
                                            }

                                            if (!isLiveStarted && ec.course.curriculumNodes && ec.course.curriculumNodes.length > 0) {
                                                const activeLive = ec.course.curriculumNodes.find(n => n && n.type === 'liveClass' && (n.isLive === true || (n.meetingUrl && n.isLive !== false && n.date && Math.abs(new Date(n.date).getTime() - Date.now()) < 10800000)));
                                                if (activeLive) {
                                                    isLiveStarted = true;
                                                    if (activeLive.meetingUrl) {
                                                        liveJoinUrl = activeLive.meetingUrl.startsWith('http') ? activeLive.meetingUrl : `/live/${activeLive.meetingUrl}`;
                                                    }
                                                }
                                            }

                                            if (!isLiveStarted && ec.course.chapters && ec.course.chapters.length > 0) {
                                                for (const ch of ec.course.chapters) {
                                                    if (ch.liveClasses && ch.liveClasses.length > 0) {
                                                        const activeLive = ch.liveClasses.find(lc => lc && (lc.isLive === true || (lc.meetingUrl && lc.isLive !== false && lc.date && Math.abs(new Date(lc.date).getTime() - Date.now()) < 10800000)));
                                                        if (activeLive) {
                                                            isLiveStarted = true;
                                                            if (activeLive.meetingUrl) {
                                                                liveJoinUrl = activeLive.meetingUrl.startsWith('http') ? activeLive.meetingUrl : `/live/${activeLive.meetingUrl}`;
                                                            }
                                                            break;
                                                        }
                                                    }
                                                }
                                            }

                                            todayRoutines.push({
                                                courseTitle: ec.course.title,
                                                subject: ec.course.subject,
                                                time: r.time || '10:00 AM',
                                                topic: r.topic || 'Regular Class',
                                                courseId: ec.course._id,
                                                isLiveStarted: isLiveStarted,
                                                liveJoinUrl: liveJoinUrl
                                            });
                                        }
                                    });
                                }
                            });
                        }
                    %>
                    <div class="w-full flex flex-col bg-white dark:bg-[#0f172a]/50">
                        <div class="flex items-center justify-between px-3.5 sm:px-4 py-2 sm:py-2.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-[#0f172a]">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-[#F43F5E] text-lg shrink-0 flex items-center justify-center leading-none -mt-0.5">school</span>
                                <h2 class="font-bold text-sm text-slate-800 dark:text-slate-200 leading-tight">Today's Class Routine</h2>
                            </div>
                            <span class="text-[10px] font-extrabold text-[#F43F5E] bg-rose-500/10 px-2.5 py-0.5 rounded border border-rose-500/20 flex items-center gap-1">
                                <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center shrink-0">today</span>
                                <%= todayFormattedDate %>
                            </span>
                        </div>

                        <div class="p-3.5 sm:p-4 space-y-2.5">
                            <% if (todayRoutines.length > 0) { %>
                                <% todayRoutines.forEach(tr => { %>
                                    <div class="p-3 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800 flex items-center justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
