    <script>
        let currentDateFilter = 'all';
        let currentTypeFilter = 'all';
        let confirmActionCallback = null;

        // Exam suggestions rotation array
        const allExamsList = <%- JSON.stringify((locals.boardQuizzes && boardQuizzes.length > 0) ? boardQuizzes : [
            { _id: 'e1', title: 'HSC Physics Model Exam', subject: 'Physics', accessType: 'Free' },
            { _id: 'e2', title: 'SSC Chemistry Board Quiz', subject: 'Chemistry', accessType: 'Paid' },
            { _id: 'e3', title: 'General Math Model Test', subject: 'Mathematics', accessType: 'Free' },
            { _id: 'e4', title: 'Biology Chapter 4 Evaluation', subject: 'Biology', accessType: 'Free' },
            { _id: 'e5', title: 'Higher Math MCQ Practice', subject: 'Higher Math', accessType: 'Paid' },
            { _id: 'e6', title: 'English Grammar Board Paper', subject: 'English', accessType: 'Free' }
        ]) %>;

        let currentExamOffset = 0;

        function renderExamsList() {
            const container = document.getElementById('examsListContainer');
            if (!container || !allExamsList.length) return;
            container.innerHTML = '';

            const countToDisplay = Math.min(3, allExamsList.length);
            for (let i = 0; i < countToDisplay; i++) {
                const exam = allExamsList[(currentExamOffset + i) % allExamsList.length];
                const div = document.createElement('div');
                div.className = 'p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800 flex items-center justify-between gap-2.5 transition-all duration-300 group hover:border-rose-500/40';
                div.innerHTML = `
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="size-7.5 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded text-base leading-none">quiz</span>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-xs font-bold text-slate-800 dark:text-white truncate">${exam.title}</h3>
                            <div class="flex items-center gap-1.5 text-[9.5px] text-slate-400 font-semibold mt-0.5">
                                <span>${exam.subject || 'General'}</span>
                                <span>• ${exam.accessType || 'Free'}</span>
                            </div>
                        </div>
                    </div>
                    <a href="/exams" onclick="rotateExamSuggestion()" class="h-7 px-2.5 bg-gradient-to-r from-rose-500 to-indigo-600 hover:from-rose-600 hover:to-indigo-700 active:scale-95 text-white text-[10px] font-bold rounded-lg transition-all shrink-0 flex items-center justify-center shadow-2xs">
                        Start
                    </a>
                `;
                container.appendChild(div);
            }
        }

        function rotateExamSuggestion() {
            currentExamOffset = (currentExamOffset + 1) % allExamsList.length;
            renderExamsList();
        }

        // Custom Confirm Modal Helpers
        function openConfirmModal(title, message, onConfirm) {
            document.getElementById('confirmModalTitle').innerText = title;
            document.getElementById('confirmModalMessage').innerText = message;
            confirmActionCallback = onConfirm;
            const actionBtn = document.getElementById('confirmModalActionBtn');
            actionBtn.onclick = async () => {
                if (confirmActionCallback) await confirmActionCallback();
                closeConfirmModal();
            };
            document.getElementById('customConfirmModal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('customConfirmModal').classList.add('hidden');
            confirmActionCallback = null;
        }

        function updateSelectedTime() {
            const h = document.getElementById('taskTimeHour')?.value || '06';
            const m = document.getElementById('taskTimeMinute')?.value || '00';
            const p = document.getElementById('taskTimePeriod')?.value || 'PM';
            const timeInput = document.getElementById('taskTimeInput');
            if (timeInput) {
                timeInput.value = `${h}:${m} ${p}`;
            }
        }

        function setQuickTime(hour, min, period) {
            const hEl = document.getElementById('taskTimeHour');
            const mEl = document.getElementById('taskTimeMinute');
            const pEl = document.getElementById('taskTimePeriod');
            if (hEl) hEl.value = hour;
            if (mEl) mEl.value = min;
            if (pEl) pEl.value = period;
            updateSelectedTime();
        }

        function updateAiSelectedTime() {
            const h = document.getElementById('aiTimeHour')?.value || '07';
            const m = document.getElementById('aiTimeMinute')?.value || '00';
            const p = document.getElementById('aiTimePeriod')?.value || 'PM';
            const timeInput = document.getElementById('aiTimeInput');
            if (timeInput) {
                timeInput.value = `${h}:${m} ${p}`;
            }
        }

        function openAddTaskModal() {
            const dateIn = document.getElementById('taskDateInput');
            if (dateIn && !dateIn.value) {
                dateIn.value = new Date().toISOString().split('T')[0];
            }
            updateSelectedTime();

            // Reset validation errors
            const titleError = document.getElementById('titleErrorMsg');
            const dateError = document.getElementById('dateErrorMsg');
            const timeError = document.getElementById('timeErrorMsg');
            const typeError = document.getElementById('typeErrorMsg');
            [titleError, dateError, timeError, typeError].forEach(el => el && el.classList.add('hidden'));

            const titleInput = document.getElementById('taskTitleInput');
            const dateInput = document.getElementById('taskDateInput');
            const timeInput = document.getElementById('taskTimeInput');
            const typeInput = document.getElementById('taskTypeInput');
            [titleInput, dateInput, timeInput, typeInput].forEach(el => el && el.classList.remove('border-rose-500'));

            document.getElementById('addTaskModal').classList.remove('hidden');
        }

        function closeAddTaskModal() {
            document.getElementById('addTaskModal').classList.add('hidden');
        }

        function openAiModal() {
            document.getElementById('aiModal').classList.remove('hidden');
        }

        function closeAiModal() {
            document.getElementById('aiModal').classList.add('hidden');
        }

        function toggleOtherDatesDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('otherDatesMenu');
            if (menu) menu.classList.toggle('hidden');
        }

        function hideOtherDatesDropdown() {
            const menu = document.getElementById('otherDatesMenu');
            if (menu) menu.classList.add('hidden');
        }

        document.addEventListener('click', () => hideOtherDatesDropdown());

        function filterByDate(dateIso) {
            currentDateFilter = dateIso;
            
            // Highlight date strip buttons
            document.querySelectorAll('.date-filter-btn').forEach(btn => {
                btn.classList.remove('bg-primary', 'text-white', 'border-primary');
                btn.classList.add('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
            });

            const todayIso = new Date().toISOString().split('T')[0];
            const title = document.getElementById('taskSectionTitle');

            if (dateIso === 'all') {
                const btnAll = document.getElementById('btn-date-all');
                if (btnAll) {
                    btnAll.classList.add('bg-primary', 'text-white', 'border-primary');
                    btnAll.classList.remove('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                }
                if (title) title.innerText = 'All Scheduled Tasks';
            } else if (dateIso === todayIso) {
                const btnToday = document.getElementById('btn-date-today');
                if (btnToday) {
                    btnToday.classList.add('bg-primary', 'text-white', 'border-primary');
                    btnToday.classList.remove('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                }
                if (title) title.innerText = "Today's Tasks";
            } else {
                const btnOther = document.getElementById('btn-date-other');
                const labelOther = document.getElementById('otherDateBtnLabel');
                if (btnOther) {
                    btnOther.classList.add('bg-primary', 'text-white', 'border-primary');
                    btnOther.classList.remove('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                }
                if (labelOther) labelOther.innerText = dateIso;
                if (title) title.innerText = `Tasks for ${dateIso}`;
            }

            applyTaskFilters();
        }

        function filterTaskType(type, btnEl) {
            currentTypeFilter = type;
            document.querySelectorAll('.type-filter-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                btn.classList.add('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
            });
            if (btnEl) {
                btnEl.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                btnEl.classList.remove('bg-slate-100', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
            }

            const clearBtn = document.getElementById('clearCompletedBtn');
            if (clearBtn) {
                if (type === 'completed') clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            applyTaskFilters();
        }

        function applyTaskFilters() {
            const rows = document.querySelectorAll('.routine-task-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowDate = row.getAttribute('data-date');
                const rowType = row.getAttribute('data-type');
                const rowCompleted = row.getAttribute('data-completed') === 'true';

                const matchesDate = (currentDateFilter === 'all' || rowDate === currentDateFilter);
                
                let matchesType = false;
                if (currentTypeFilter === 'completed') {
                    matchesType = rowCompleted;
                } else if (currentTypeFilter === 'all') {
                    matchesType = !rowCompleted; // HIDE completed tasks from All Tasks tab!
                } else {
                    matchesType = (!rowCompleted && rowType === currentTypeFilter); // HIDE completed tasks from Category tabs too!
                }

                if (matchesDate && matchesType) {
                    row.style.display = 'flex';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const placeholder = document.getElementById('no-tasks-placeholder');
            if (placeholder) {
                if (visibleCount === 0) placeholder.classList.remove('hidden');
                else placeholder.classList.add('hidden');
            }

            updateProgressBadge();
            updateDateStripCounts();
        }

        function updateProgressBadge() {
            const rows = document.querySelectorAll('.routine-task-row');
            let total = 0;
            let completed = 0;

            rows.forEach(row => {
                const rowDate = row.getAttribute('data-date');
                const isCompleted = row.getAttribute('data-completed') === 'true';

                if (currentDateFilter === 'all' || rowDate === currentDateFilter) {
                    total++;
                    if (isCompleted) completed++;
                }
            });

            const pct = total > 0 ? Math.round((completed / total) * 100) : 0;
            const progressText = document.getElementById('taskProgressText');
            if (progressText) {
                progressText.textContent = `${completed}/${total} (${pct}%)`;
            }
        }

        function updateDateStripCounts() {
            const rows = document.querySelectorAll('.routine-task-row');
            const countsByDate = {};

            rows.forEach(row => {
                const d = row.getAttribute('data-date');
                const c = row.getAttribute('data-completed') === 'true';
                if (d) {
                    if (!countsByDate[d]) countsByDate[d] = { total: 0, completed: 0 };
                    countsByDate[d].total++;
                    if (c) countsByDate[d].completed++;
                }
            });

            Object.keys(countsByDate).forEach(d => {
                const stripBtn = document.getElementById('date-strip-' + d);
                if (stripBtn) {
                    const badge = stripBtn.querySelector('span:last-child');
                    if (badge) {
                        const { total, completed } = countsByDate[d];
                        badge.textContent = `${completed}/${total}`;
                        if (completed === total && total > 0) {
                            badge.className = 'px-1 py-0.5 text-[8px] font-extrabold rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 leading-none';
                        } else {
                            badge.className = 'px-1 py-0.5 text-[8px] font-extrabold rounded bg-primary/10 text-primary border border-primary/20 leading-none';
                        }
                    }
                }
            });
        }

        async function toggleTask(taskId) {
            try {
                const res = await fetch('/routine/toggle/' + taskId, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    const row = document.getElementById('task-row-' + taskId);
                    if (row) {
                        const checkIcon = row.querySelector('.task-checkbox-box span');
                        const checkBox = row.querySelector('.task-checkbox-box');
                        const titleText = row.querySelector('.task-title-text');

                        row.setAttribute('data-completed', data.isCompleted ? 'true' : 'false');

                        if (data.isCompleted) {
                            if (checkIcon) checkIcon.classList.remove('hidden');
                            if (checkBox) {
                                checkBox.classList.add('bg-primary', 'border-primary');
                                checkBox.classList.remove('border-slate-300', 'dark:border-slate-600', 'bg-white', 'dark:bg-slate-800');
                            }
                            if (titleText) titleText.classList.add('line-through', 'opacity-50');
                        } else {
                            if (checkIcon) checkIcon.classList.add('hidden');
                            if (checkBox) {
                                checkBox.classList.remove('bg-primary', 'border-primary');
                                checkBox.classList.add('border-slate-300', 'dark:border-slate-600', 'bg-white', 'dark:bg-slate-800');
                            }
                            if (titleText) titleText.classList.remove('line-through', 'opacity-50');
                        }
                    }
                    if (data.currentXP !== undefined) {
                        const xpText = document.getElementById('headerXpText');
                        if (xpText) xpText.innerText = `${data.currentXP} XP`;
                        const xpBar = document.getElementById('headerXpBar');
                        if (xpBar) xpBar.style.width = `${(data.currentXP % 1000) / 10}%`;
                        const lvlBadge = document.getElementById('headerLevelBadge');
                        if (lvlBadge && data.level) lvlBadge.innerText = `Level ${data.level}`;
                    }

                    // Re-apply live task filter so Completed tasks hide from All Tasks immediately
                    applyTaskFilters();
                }
            } catch (err) {
                console.error('Error toggling task:', err);
            }
        }

        function handleResourceClick(taskId, isCompleted) {
            if (!isCompleted) {
                toggleTask(taskId);
            }
        }

        function promptDeleteSingleTask(taskId) {
            openConfirmModal(
                'Delete Task',
                'Are you sure you want to delete this routine task?',
                async () => {
                    try {
                        const res = await fetch('/routine/delete/' + taskId, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            const row = document.getElementById('task-row-' + taskId);
                            if (row) row.remove();
                            applyTaskFilters();
                        }
                    } catch (err) {
                        console.error('Error deleting task:', err);
                    }
                }
            );
        }

        function promptClearCompleted() {
            openConfirmModal(
                'Clear Completed Tasks',
                'Are you sure you want to delete all completed tasks permanently?',
                async () => {
                    try {
                        const res = await fetch('/routine/clear-completed', {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            document.querySelectorAll('.routine-task-row[data-completed="true"]').forEach(el => el.remove());
                            applyTaskFilters();
                        }
                    } catch (err) {
                        console.error('Error clearing completed tasks:', err);
                    }
                }
            );
        }

        async function handleAddTaskSubmit(e) {
            e.preventDefault();
            const titleInput = document.getElementById('taskTitleInput');
            const dateInput = document.getElementById('taskDateInput');
            const timeInput = document.getElementById('taskTimeInput');
            const typeInput = document.getElementById('taskTypeInput');

            const titleError = document.getElementById('titleErrorMsg');
            const dateError = document.getElementById('dateErrorMsg');
            const timeError = document.getElementById('timeErrorMsg');
            const typeError = document.getElementById('typeErrorMsg');

            let isValid = true;

            // Reset error states
            [titleError, dateError, timeError, typeError].forEach(el => el && el.classList.add('hidden'));
            [titleInput, dateInput, timeInput, typeInput].forEach(el => el && el.classList.remove('border-rose-500'));

            if (!titleInput.value.trim()) {
                titleError.classList.remove('hidden');
                titleInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!dateInput.value) {
                dateError.classList.remove('hidden');
                dateInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!timeInput.value.trim()) {
                timeError.classList.remove('hidden');
                timeInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!typeInput.value) {
                typeError.classList.remove('hidden');
                typeInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!isValid) return;

            const title = titleInput.value.trim();
            const date = dateInput.value;
            const time = timeInput.value.trim();
            const type = typeInput.value;

            try {
                const res = await fetch('/routine/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ title, date, time, type })
                });
                const data = await res.json();
                if (data.success) {
                    closeAddTaskModal();
                    window.location.reload();
                }
            } catch (err) {
                console.error('Error adding task:', err);
            }
        }

        function openAiModal() {
            const courseInput = document.getElementById('aiCourseSelect');
            const daysInput = document.getElementById('aiDaysInput');
            const timeInput = document.getElementById('aiTimeInput');

            const courseError = document.getElementById('aiCourseErrorMsg');
            const daysError = document.getElementById('aiDaysErrorMsg');
            const timeError = document.getElementById('aiTimeErrorMsg');

            [courseError, daysError, timeError].forEach(el => el && el.classList.add('hidden'));
            [courseInput, daysInput, timeInput].forEach(el => el && el.classList.remove('border-rose-500'));

            document.getElementById('aiModal').classList.remove('hidden');
        }

        async function handleAiSubmit(e) {
            e.preventDefault();
            const courseInput = document.getElementById('aiCourseSelect');
            const daysInput = document.getElementById('aiDaysInput');
            const timeInput = document.getElementById('aiTimeInput');

            const courseError = document.getElementById('aiCourseErrorMsg');
            const daysError = document.getElementById('aiDaysErrorMsg');
            const timeError = document.getElementById('aiTimeErrorMsg');

            let isValid = true;

            [courseError, daysError, timeError].forEach(el => el && el.classList.add('hidden'));
            [courseInput, daysInput, timeInput].forEach(el => el && el.classList.remove('border-rose-500'));

            if (!courseInput.value) {
                courseError.classList.remove('hidden');
                courseInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!daysInput.value || parseInt(daysInput.value) <= 0) {
                daysError.classList.remove('hidden');
                daysInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!timeInput.value.trim()) {
                timeError.classList.remove('hidden');
                timeInput.classList.add('border-rose-500');
                isValid = false;
            }

            if (!isValid) return;

            const courseId = courseInput.value;
            const targetDays = daysInput.value;
            const studyTime = timeInput.value.trim();

            try {
                const res = await fetch('/routine/generate-ai', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ courseId, targetDays, studyTime })
                });
                const data = await res.json();
                if (data.success) {
                    closeAiModal();
                    window.location.reload();
                } else {
                    alert(data.error || 'Failed to generate AI Routine.');
                }
            } catch (err) {
                console.error('Error generating AI routine:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderExamsList();
            filterByDate('all');
        });
    </script>
</body>
</html>