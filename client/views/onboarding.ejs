<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Complete Student Setup | ODDHAY</title>
    <%- include('partials/head') %>
    <style>
        #onboardingContainer {
            transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        input[name="group"]:checked + .group-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            font-weight: 600;
        }
        .subject-chip.selected {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            color: #18a957;
        }
        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
        }
        @media (max-width: 640px) {
            body {
                overscroll-behavior-y: contain;
            }
        }
    </style>
</head>

<body class="min-h-dvh sm:min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-3 sm:p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Card Container -->
    <main class="w-full flex-1 flex items-center justify-center py-3 sm:py-6 relative z-10">
        <div id="onboardingContainer" class="w-full max-w-[450px] mx-auto transition-all duration-300">
            
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text -->
                <div class="text-center mb-3">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- User Welcome Header -->
                <div class="text-center mb-5">
                    <div class="relative inline-block mb-2">
                        <% if (user && user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" alt="<%= user.name %>" class="size-16 rounded-full object-cover border-2 border-[#18a957] shadow-sm mx-auto">
                        <% } else { %>
                            <div class="size-16 rounded-full bg-[#18a957]/10 text-[#18a957] flex items-center justify-center mx-auto border-2 border-[#18a957]/30">
                                <span class="material-symbols-outlined text-3xl">school</span>
                            </div>
                        <% } %>
                        <div class="absolute -bottom-1 -right-1 bg-[#18a957] text-white size-5 rounded-full flex items-center justify-center shadow-xs text-xs">
                            <span class="material-symbols-outlined text-xs">check</span>
                        </div>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                        Welcome, <%= (user && user.name) ? user.name.split(' ')[0] : 'Student' %>! 👋
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Select your academic level and subjects to unlock your personalized study dashboard.
                    </p>
                </div>

                <!-- Alert: Server Error -->
                <% if (locals.error) { %>
                    <div id="serverErrorMsg"
                        class="mb-4 p-3.5 rounded-xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Onboarding Form -->
                <form id="onboardingForm" action="/onboarding" method="POST" class="space-y-4">
                    
                    <!-- 1. Class / Level Selector -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                            Class / Academic Level <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                auto_stories
                            </span>
                            <select name="classLevel" id="classSelect" required
                                class="w-full pl-10 pr-9 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm transition-all outline-none appearance-none cursor-pointer">
                                <% 
                                    const defaultClasses = ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'];
                                    let classesList = defaultClasses;
                                    if (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0) {
                                        classesList = academicClasses.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                    }
                                    classesList.forEach((cName, idx) => {
                                %>
                                    <option value="<%= cName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 py-1.5" <%= idx === 0 ? 'selected' : '' %>>
                                        <%= cName %>
                                    </option>
                                <% }) %>
                            </select>
                            <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined text-base">unfold_more</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Study Group (Appears ONLY if class has groups) -->
                    <div id="groupContainer" class="hidden transition-all duration-200">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                            Study Group <span class="text-red-500">*</span>
                        </label>
                        <div class="grid grid-cols-3 gap-2" id="groupCardsContainer">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- 3. Group Subjects Selection -->
                    <div id="subjectsSection" class="space-y-2">
                        <div class="flex items-center justify-between ml-0.5">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                Elective Group Subjects (<span id="selectedSubCount">0</span> selected)
                            </label>
                            <button type="button" onclick="toggleAllSubjects()" id="selectAllBtn" class="text-xs text-[#18a957] hover:underline font-semibold cursor-pointer">
                                Select All
                            </button>
                        </div>
                        <div id="subjectsListWrapper" class="max-h-48 overflow-y-auto p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-wrap gap-1.5">
                            <!-- Populated dynamically via JS -->
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 ml-1">
                            * Core compulsory subjects (Bangla, English, Math, ICT, etc.) are included automatically.
                        </p>
                    </div>

                    <!-- 4. Phone Number (Optional / Recommended if missing) -->
                    <% if (!user.phone) { %>
                        <div class="pt-1">
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                                Mobile Number <span class="text-slate-400 text-xs font-normal">(Recommended for SMS alerts)</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    call
                                </span>
                                <input type="tel" name="phone" id="phoneInput" placeholder="017XXXXXXXX"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none">
                            </div>
                        </div>
                    <% } %>

                    <!-- 5. Submit Button -->
                    <div class="pt-2">
                        <button type="submit" id="onboardingSubmitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-base flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all cursor-pointer">
                            <span id="onboardingBtnText">Save & Enter Dashboard</span>
                            <span id="onboardingBtnIcon" class="material-symbols-outlined text-lg">arrow_forward</span>
                        </button>
                    </div>

                </form>

            </div>

        </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="w-full text-center py-2 sm:py-3 relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-8 sm:top-6 left-1/2 -translate-x-1/2 z-[100] transition-all duration-300 pointer-events-none w-max max-w-[92vw] opacity-0 -translate-y-3 scale-95">
        <div id="toast-body" class="px-4.5 py-2.5 sm:px-5 sm:py-3 rounded-2xl sm:rounded-full font-semibold shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm border border-white/20 backdrop-blur-md bg-red-500 text-white">
            <span id="toast-icon" class="material-symbols-outlined text-lg sm:text-xl shrink-0">error</span>
            <span id="toast-msg" class="leading-snug font-semibold text-center">Error occurred</span>
        </div>
    </div>

    <!-- Academic Data from Superadmin -->
    <script id="academicClassesData" type="application/json">
        <%- JSON.stringify(academicClasses || []) %>
    </script>

    <!-- Dynamic Selection & Submission Script -->
    <script>
        // Toast Helper
        let toastTimer = null;
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            const bgClass = type === 'success' 
                ? 'bg-[#18a957] text-white border-emerald-400/30 shadow-emerald-500/25' 
                : 'bg-red-500 text-white border-red-400/30 shadow-red-500/25';

            body.className = `px-4.5 py-2.5 sm:px-5 sm:py-3 rounded-2xl sm:rounded-full font-semibold shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm border backdrop-blur-md transition-colors ${bgClass}`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('opacity-0', '-translate-y-3', 'scale-95');
            toast.classList.add('opacity-100', 'translate-y-0', 'scale-100');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
                toast.classList.add('opacity-0', '-translate-y-3', 'scale-95');
            }, 3500);
        }

        document.addEventListener('DOMContentLoaded', function() {
            let academicClasses = [];
            try {
                const rawAcademic = document.getElementById('academicClassesData');
                if (rawAcademic) {
                    academicClasses = JSON.parse(rawAcademic.textContent || '[]');
                }
            } catch (e) {
                console.error('Error parsing academic classes data:', e);
            }

            const sscCommon = ['Bangla', 'English', 'Mathematics', 'ICT', 'Religion', 'Bangladesh & Global Studies'];
            const sscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Finance & Banking', 'Business Entrepreneurship', 'General Science'],
                'Humanities': ['History of Bangladesh & World Civilization', 'Geography & Environment', 'Civics & Citizenship', 'Economics', 'General Science']
            };
            const hscCommon = ['Bangla', 'English', 'ICT'];
            const hscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Business Organization & Management', 'Finance, Banking & Insurance', 'Economics'],
                'Humanities': ['Economics', 'Civics & Good Governance', 'History', 'Logic', 'Sociology']
            };

            const form = document.getElementById('onboardingForm');
            const classSelect = document.getElementById('classSelect');
            const groupContainer = document.getElementById('groupContainer');
            const groupCardsContainer = document.getElementById('groupCardsContainer');
            const subjectsWrapper = document.getElementById('subjectsListWrapper');
            const selectedSubCount = document.getElementById('selectedSubCount');

            function classHasGroups(clsName) {
                if (!clsName) return false;
                const matchDoc = academicClasses.find(c => c.name === clsName);
                if (matchDoc && typeof matchDoc.hasGroups === 'boolean') {
                    return matchDoc.hasGroups;
                }
                return /\b(9|10|11|12)\b/.test(clsName) || /(ssc|hsc)/i.test(clsName);
            }

            function updateGroupCards() {
                if (!groupCardsContainer) return;
                const selectedClass = classSelect ? classSelect.value : '';
                const hasGroups = classHasGroups(selectedClass);

                if (!hasGroups) {
                    if (groupContainer) groupContainer.classList.add('hidden');
                    updateSubjectsList();
                    return;
                }

                if (groupContainer) groupContainer.classList.remove('hidden');

                const classDoc = academicClasses.find(c => c.name === selectedClass);
                let groupsList = [];

                if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                    groupsList = classDoc.groups.map(g => g.name).filter(Boolean);
                }

                if (groupsList.length === 0) {
                    groupsList = ['Science', 'Commerce', 'Humanities'];
                }

                const currentChecked = form.querySelector('input[name="group"]:checked')?.value || groupsList[0];
                groupCardsContainer.innerHTML = '';
                groupCardsContainer.className = `grid grid-cols-${Math.min(groupsList.length, 3)} gap-2`;

                groupsList.forEach((grpName, i) => {
                    const isChecked = grpName.toLowerCase() === currentChecked.toLowerCase() || (i === 0 && !currentChecked);
                    const iconName = grpName.toLowerCase().includes('sci') ? 'biotech'
                        : grpName.toLowerCase().includes('comm') || grpName.toLowerCase().includes('bus') ? 'trending_up'
                        : 'menu_book';
                    const iconColor = grpName.toLowerCase().includes('sci') ? 'text-[#18a957]'
                        : grpName.toLowerCase().includes('comm') ? 'text-blue-500'
                        : 'text-amber-500';

                    const label = document.createElement('label');
                    label.className = 'cursor-pointer relative';
                    label.innerHTML = `
                        <input type="radio" name="group" value="${grpName}" class="hidden group-radio" ${isChecked ? 'checked' : ''}>
                        <div class="group-card p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-lg ${iconColor}">${iconName}</span>
                            <span class="font-medium text-[11px] sm:text-xs text-slate-800 dark:text-slate-200">${grpName}</span>
                        </div>
                    `;
                    groupCardsContainer.appendChild(label);
                });

                const newRadios = groupCardsContainer.querySelectorAll('input[name="group"]');
                newRadios.forEach(r => {
                    r.addEventListener('change', () => {
                        updateSubjectsList();
                    });
                });

                updateSubjectsList();
            }

            function updateSubjectsList() {
                if (!subjectsWrapper) return;
                const selectedClass = classSelect ? classSelect.value : 'Class 10';
                const hasGroups = classHasGroups(selectedClass);
                const activeGroupRadio = form.querySelector('input[name="group"]:checked');
                const selectedGroup = (activeGroupRadio ? activeGroupRadio.value : 'Science').trim();

                let groupSubsToRender = [];
                let currentCompulsory = [];
                const classDoc = academicClasses.find(c => c.name === selectedClass);

                if (hasGroups) {
                    if (classDoc && Array.isArray(classDoc.commonSubjects) && classDoc.commonSubjects.length > 0) {
                        currentCompulsory = classDoc.commonSubjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        const isHsc = /11|12/i.test(selectedClass);
                        currentCompulsory = isHsc ? hscCommon : sscCommon;
                    }

                    if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                        const grp = classDoc.groups.find(g => (g.name || '').toLowerCase() === selectedGroup.toLowerCase());
                        if (grp && Array.isArray(grp.subjects) && grp.subjects.length > 0) {
                            groupSubsToRender = grp.subjects.map(s => String(s).trim()).filter(Boolean);
                        }
                    }

                    if (groupSubsToRender.length === 0) {
                        const isHsc = /11|12/i.test(selectedClass);
                        const groupPool = isHsc ? hscGroupsData : sscGroupsData;
                        groupSubsToRender = groupPool[selectedGroup] || groupPool['Science'] || [];
                    }

                    const compSet = new Set(currentCompulsory.map(s => s.toLowerCase()));
                    groupSubsToRender = groupSubsToRender.filter(s => !compSet.has(s.toLowerCase()));

                } else {
                    if (classDoc && Array.isArray(classDoc.subjects) && classDoc.subjects.length > 0) {
                        currentCompulsory = classDoc.subjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        currentCompulsory = ['Bangla', 'English', 'Mathematics', 'Science', 'ICT', 'Religion', 'General Science'];
                    }
                    groupSubsToRender = [];
                }

                subjectsWrapper.innerHTML = '';
                if (groupSubsToRender.length === 0) {
                    if (hasGroups) {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-400">No elective group subjects required.</div>';
                    } else {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-500 dark:text-slate-400">All subjects for this class are core curriculum and will be auto-assigned.</div>';
                    }
                    if (selectedSubCount) selectedSubCount.textContent = '0';
                } else {
                    groupSubsToRender.forEach(sub => {
                        const label = document.createElement('label');
                        label.className = 'subject-chip selected inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[#18a957] bg-[#18a957]/10 text-slate-800 dark:text-slate-100 text-xs font-medium cursor-pointer transition-all select-none hover:opacity-90';
                        label.innerHTML = `
                            <input type="checkbox" name="subjects" value="${sub}" checked class="hidden subject-checkbox">
                            <span class="material-symbols-outlined text-xs text-[#18a957] chip-icon">check</span>
                            <span>${sub}</span>
                        `;

                        const checkbox = label.querySelector('.subject-checkbox');
                        const icon = label.querySelector('.chip-icon');

                        label.addEventListener('click', (e) => {
                            if (e.target !== checkbox) {
                                checkbox.checked = !checkbox.checked;
                            }
                            if (checkbox.checked) {
                                label.classList.add('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                                label.classList.remove('border-slate-200', 'dark:border-slate-800');
                                icon.textContent = 'check';
                                icon.classList.remove('hidden');
                            } else {
                                label.classList.remove('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                                label.classList.add('border-slate-200', 'dark:border-slate-800');
                                icon.textContent = '';
                                icon.classList.add('hidden');
                            }
                            updateSelectedCount();
                        });

                        subjectsWrapper.appendChild(label);
                    });
                    updateSelectedCount();
                }
            }

            function updateSelectedCount() {
                if (!selectedSubCount) return;
                const checked = subjectsWrapper.querySelectorAll('input[type="checkbox"]:checked');
                selectedSubCount.textContent = checked.length;
            }

            window.toggleAllSubjects = function() {
                if (!subjectsWrapper) return;
                const checkboxes = subjectsWrapper.querySelectorAll('input[type="checkbox"]');
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                const targetState = !allChecked;

                checkboxes.forEach(c => {
                    c.checked = targetState;
                    const label = c.closest('.subject-chip');
                    const icon = label.querySelector('.chip-icon');
                    if (targetState) {
                        label.classList.add('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                        label.classList.remove('border-slate-200', 'dark:border-slate-800');
                        if (icon) {
                            icon.textContent = 'check';
                            icon.classList.remove('hidden');
                        }
                    } else {
                        label.classList.remove('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                        label.classList.add('border-slate-200', 'dark:border-slate-800');
                        if (icon) {
                            icon.textContent = '';
                            icon.classList.add('hidden');
                        }
                    }
                });
                updateSelectedCount();
            };

            if (classSelect) {
                classSelect.addEventListener('change', updateGroupCards);
            }

            updateGroupCards();

            // Handle AJAX submission
            if (form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const submitBtn = document.getElementById('onboardingSubmitBtn');
                    const btnText = document.getElementById('onboardingBtnText');
                    const btnIcon = document.getElementById('onboardingBtnIcon');

                    const selectedClass = classSelect ? classSelect.value.trim() : '';
                    if (!selectedClass) {
                        showToast('Please select your Class / Level.');
                        return;
                    }

                    const activeGroupRadio = form.querySelector('input[name="group"]:checked');
                    const group = activeGroupRadio ? activeGroupRadio.value : '';

                    const selectedSubjects = Array.from(subjectsWrapper.querySelectorAll('input[name="subjects"]:checked')).map(c => c.value);
                    const phoneInput = document.getElementById('phoneInput');
                    const phone = phoneInput ? phoneInput.value.trim() : '';

                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
                    btnText.textContent = 'Setting up dashboard...';
                    if (btnIcon) {
                        btnIcon.textContent = 'sync';
                        btnIcon.classList.add('animate-spin');
                    }

                    try {
                        const res = await fetch('/onboarding', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                classLevel: selectedClass,
                                group: group,
                                subjects: selectedSubjects,
                                phone: phone
                            })
                        });

                        const data = await res.json();

                        if (!res.ok || !data.success) {
                            showToast(data.error || 'Failed to complete setup.');
                            submitBtn.disabled = false;
                            submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                            btnText.textContent = 'Save & Enter Dashboard';
                            if (btnIcon) {
                                btnIcon.textContent = 'arrow_forward';
                                btnIcon.classList.remove('animate-spin');
                            }
                            return;
                        }

                        showToast('Setup complete! Welcome to ODDHAY.', 'success');
                        setTimeout(() => {
                            window.location.href = data.redirect || '/dashboard';
                        }, 400);

                    } catch (err) {
                        console.error('Onboarding submission error:', err);
                        showToast('Network error. Please try again.');
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                        btnText.textContent = 'Save & Enter Dashboard';
                        if (btnIcon) {
                            btnIcon.textContent = 'arrow_forward';
                            btnIcon.classList.remove('animate-spin');
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
