<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Complete Student Setup | ODDHAY</title>
    <%- include('partials/head') %>
    <style>
        #onboardingContainer {
            transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        input[name="group"]:checked + .group-card {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            font-weight: 600;
        }
        .subject-chip.selected {
            border-color: #18a957;
            background-color: rgba(24, 169, 87, 0.08);
            color: #18a957;
        }
        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
        }
        @media (max-width: 640px) {
            body {
                overscroll-behavior-y: contain;
            }
        }
    </style>
</head>

<body class="min-h-dvh sm:min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-3 sm:p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Card Container -->
    <main class="w-full flex-1 flex items-center justify-center py-2 sm:py-5 relative z-10">
        <div id="onboardingContainer" class="w-full max-w-[440px] mx-auto transition-all duration-300">
            
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-5 sm:p-6 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text -->
                <div class="text-center mb-3">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- User Welcome Header -->
                <div class="text-center mb-4">
                    <div class="relative inline-block mb-1.5">
                        <% if (user && user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" alt="<%= user.name %>" class="size-14 rounded-full object-cover border-2 border-[#18a957] shadow-sm mx-auto">
                        <% } else { %>
                            <div class="size-14 rounded-full bg-[#18a957]/10 text-[#18a957] flex items-center justify-center mx-auto border-2 border-[#18a957]/30">
                                <span class="material-symbols-outlined text-2xl">school</span>
                            </div>
                        <% } %>
                        <div class="absolute -bottom-1 -right-1 bg-[#18a957] text-white size-4.5 rounded-full flex items-center justify-center shadow-xs text-xs">
                            <span class="material-symbols-outlined text-xs">check</span>
                        </div>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                        Welcome, <%= (user && user.name) ? user.name.split(' ')[0] : 'Student' %>! 👋
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                        Choose your class and subjects to get started.
                    </p>
                </div>

                <!-- Subtle Progress Bar -->
                <div class="h-1 w-full bg-slate-100 dark:bg-slate-800 rounded-full mb-4 overflow-hidden">
                    <div id="onboardProgressBar" class="h-full bg-[#18a957] transition-all duration-300" style="width: 50%;"></div>
                </div>

                <!-- ================= Step 1: Class & Group Selection ================= -->
                <div id="onboardStep1" class="space-y-3.5 transition-all duration-200">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                            Class / Level <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                auto_stories
                            </span>
                            <select name="classLevel" id="classSelect"
                                class="w-full pl-10 pr-9 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-medium text-sm transition-all outline-none appearance-none cursor-pointer">
                                <% 
                                    const defaultClasses = ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12', 'Admission', 'Skill Development'];
                                    let classesList = defaultClasses;
                                    if (typeof academicClasses !== 'undefined' && Array.isArray(academicClasses) && academicClasses.length > 0) {
                                        classesList = academicClasses.map(c => typeof c === 'object' && c ? (c.name || '') : String(c)).filter(Boolean);
                                    }
                                    classesList.forEach((cName, idx) => {
                                %>
                                    <option value="<%= cName %>" class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 py-1.5" <%= idx === 0 ? 'selected' : '' %>>
                                        <%= cName %>
                                    </option>
                                <% }) %>
                            </select>
                            <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined text-base">unfold_more</span>
                            </div>
                        </div>
                    </div>

                    <!-- Study Group (Appears ONLY if class has groups) -->
                    <div id="groupContainer" class="hidden transition-all duration-200">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                            Study Group <span class="text-red-500">*</span>
                        </label>
                        <div class="grid grid-cols-3 gap-2" id="groupCardsContainer">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <div class="pt-1.5">
                        <button type="button" id="step1NextBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-base flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.99] transition-all cursor-pointer">
                            <span>Continue to Subjects</span>
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- ================= Step 2: Subjects & Optional Phone ================= -->
                <div id="onboardStep2" class="hidden space-y-3.5 transition-all duration-200">
                    <!-- Elective Group Subjects Selection -->
                    <div id="subjectsSection" class="space-y-2">
                        <div class="flex items-center justify-between ml-0.5">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                Elective Subjects (<span id="selectedSubCount">0</span> selected)
                            </label>
                            <button type="button" onclick="toggleAllSubjects()" id="selectAllBtn" class="text-xs text-[#18a957] hover:underline font-semibold cursor-pointer">
                                Select All
                            </button>
                        </div>
                        <div id="subjectsListWrapper" class="max-h-44 overflow-y-auto p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-wrap gap-1.5">
                            <!-- Populated dynamically via JS -->
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 ml-1">
                            * Core compulsory subjects (Bangla, English, Math, ICT) are included automatically.
                        </p>
                    </div>

                    <!-- Optional Mobile Number Input -->
                    <% if (!user.phone) { %>
                        <div class="pt-0.5">
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1 ml-0.5">
                                Mobile Number <span class="text-slate-400 text-xs font-normal">(Optional)</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    call
                                </span>
                                <input type="tel" name="phone" id="phoneInput" placeholder="017XXXXXXXX" maxlength="14"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none">
                            </div>
                            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1 ml-1">
                                If entered, a 6-digit OTP will be sent to verify your number.
                            </p>
                        </div>
                    <% } %>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2.5 pt-1.5">
                        <button type="button" id="step2BackBtn"
                            class="flex-1 h-11 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-sm transition-all flex items-center justify-center gap-1 active:scale-95 cursor-pointer">
                            <span class="material-symbols-outlined text-base">west</span>
                            <span>Back</span>
                        </button>

                        <button type="button" id="step2FinishBtn"
                            class="flex-[2] h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-base flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.99] transition-all cursor-pointer">
                            <span id="finishBtnText">Complete Setup</span>
                            <span id="finishBtnIcon" class="material-symbols-outlined text-lg">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- ================= Step 3: Phone OTP Verification (Only if phone entered) ================= -->
                <div id="onboardStep3" class="hidden space-y-3.5 transition-all duration-200">
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center size-11 rounded-2xl bg-[#18a957]/10 text-[#18a957] mb-2">
                            <span class="material-symbols-outlined text-2xl">sms</span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white tracking-tight mb-1">
                            Verify Mobile Number
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed px-1">
                            Enter the 6-digit OTP sent to <strong id="onboardPhoneTarget" class="text-slate-800 dark:text-white font-mono"></strong>
                        </p>
                    </div>

                    <form id="onboardPhoneOtpForm" class="space-y-3 sm:space-y-3.5">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1 ml-0.5 text-center">
                                6-Digit Verification OTP
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    pin
                                </span>
                                <input type="text" id="phoneOtpInput" placeholder="••••••" maxlength="6" inputmode="numeric" pattern="[0-9]*"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-mono text-center text-lg tracking-[0.4em] placeholder:tracking-normal placeholder:font-normal placeholder:text-slate-400 transition-all outline-none"
                                    autocomplete="one-time-code" required>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-0.5 text-slate-500 dark:text-slate-400">
                            <span>Didn't receive code?</span>
                            <button type="button" id="phoneResendOtpBtn" onclick="resendPhoneOtp()" disabled
                                class="text-slate-400 font-medium transition-colors disabled:cursor-not-allowed">
                                <span>Resend OTP</span>
                                <span id="phoneCountdownText" class="ml-1 text-slate-400 font-mono">(60s)</span>
                            </button>
                        </div>

                        <button type="submit" id="phoneOtpSubmitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-bold text-base flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all cursor-pointer">
                            <span id="phoneOtpBtnText">Verify & Enter Dashboard</span>
                            <span id="phoneOtpBtnIcon" class="material-symbols-outlined text-lg">verified</span>
                        </button>

                        <button type="button" onclick="skipPhoneVerification()"
                            class="w-full text-center text-xs text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-medium py-1">
                            Skip phone verification & go to dashboard →
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="w-full text-center py-2 sm:py-3 relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-8 sm:top-6 left-1/2 -translate-x-1/2 z-[100] transition-all duration-300 pointer-events-none w-max max-w-[92vw] opacity-0 -translate-y-3 scale-95">
        <div id="toast-body" class="px-4.5 py-2.5 sm:px-5 sm:py-3 rounded-2xl sm:rounded-full font-semibold shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm border border-white/20 backdrop-blur-md bg-red-500 text-white">
            <span id="toast-icon" class="material-symbols-outlined text-lg sm:text-xl shrink-0">error</span>
            <span id="toast-msg" class="leading-snug font-semibold text-center">Error occurred</span>
        </div>
    </div>

    <!-- Academic Data from Superadmin -->
    <script id="academicClassesData" type="application/json">
        <%- JSON.stringify(academicClasses || []) %>
    </script>

    <!-- Step-by-Step Interactive Logic -->
    <script>
        let toastTimer = null;
        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            const bgClass = type === 'success' 
                ? 'bg-[#18a957] text-white border-emerald-400/30 shadow-emerald-500/25' 
                : 'bg-red-500 text-white border-red-400/30 shadow-red-500/25';

            body.className = `px-4.5 py-2.5 sm:px-5 sm:py-3 rounded-2xl sm:rounded-full font-semibold shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm border backdrop-blur-md transition-colors ${bgClass}`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('opacity-0', '-translate-y-3', 'scale-95');
            toast.classList.add('opacity-100', 'translate-y-0', 'scale-100');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
                toast.classList.add('opacity-0', '-translate-y-3', 'scale-95');
            }, 3500);
        }

        let phoneCountdownTimer = null;
        let phoneCountdownSeconds = 60;

        function startPhoneCountdown() {
            if (phoneCountdownTimer) clearInterval(phoneCountdownTimer);
            phoneCountdownSeconds = 60;
            const btn = document.getElementById('phoneResendOtpBtn');
            const text = document.getElementById('phoneCountdownText');

            if (btn) {
                btn.disabled = true;
                btn.className = "text-slate-400 font-medium transition-colors disabled:cursor-not-allowed";
            }
            if (text) text.textContent = '(' + phoneCountdownSeconds + 's)';

            phoneCountdownTimer = setInterval(() => {
                phoneCountdownSeconds--;
                if (phoneCountdownSeconds <= 0) {
                    clearInterval(phoneCountdownTimer);
                    if (btn) {
                        btn.disabled = false;
                        btn.className = "text-[#18a957] font-semibold hover:underline cursor-pointer";
                    }
                    if (text) text.textContent = '';
                } else {
                    if (text) text.textContent = '(' + phoneCountdownSeconds + 's)';
                }
            }, 1000);
        }

        async function resendPhoneOtp() {
            const btn = document.getElementById('phoneResendOtpBtn');
            if (btn) btn.disabled = true;

            try {
                const res = await fetch('/onboarding/resend-phone-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'New OTP sent to your phone!', 'success');
                    startPhoneCountdown();
                } else {
                    showToast(data.error || 'Failed to resend OTP.');
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                showToast('Network error while resending OTP.');
                if (btn) btn.disabled = false;
            }
        }

        function skipPhoneVerification() {
            window.location.href = '/dashboard';
        }

        document.addEventListener('DOMContentLoaded', function() {
            let academicClasses = [];
            try {
                const rawAcademic = document.getElementById('academicClassesData');
                if (rawAcademic) {
                    academicClasses = JSON.parse(rawAcademic.textContent || '[]');
                }
            } catch (e) {
                console.error('Error parsing academic classes data:', e);
            }

            const sscCommon = ['Bangla', 'English', 'Mathematics', 'ICT', 'Religion', 'Bangladesh & Global Studies'];
            const sscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Finance & Banking', 'Business Entrepreneurship', 'General Science'],
                'Humanities': ['History of Bangladesh & World Civilization', 'Geography & Environment', 'Civics & Citizenship', 'Economics', 'General Science']
            };
            const hscCommon = ['Bangla', 'English', 'ICT'];
            const hscGroupsData = {
                'Science': ['Physics', 'Chemistry', 'Biology', 'Higher Mathematics'],
                'Commerce': ['Accounting', 'Business Organization & Management', 'Finance, Banking & Insurance', 'Economics'],
                'Humanities': ['Economics', 'Civics & Good Governance', 'History', 'Logic', 'Sociology']
            };

            const step1 = document.getElementById('onboardStep1');
            const step2 = document.getElementById('onboardStep2');
            const step3 = document.getElementById('onboardStep3');
            const progressBar = document.getElementById('onboardProgressBar');

            const classSelect = document.getElementById('classSelect');
            const groupContainer = document.getElementById('groupContainer');
            const groupCardsContainer = document.getElementById('groupCardsContainer');
            const subjectsWrapper = document.getElementById('subjectsListWrapper');
            const selectedSubCount = document.getElementById('selectedSubCount');

            const step1NextBtn = document.getElementById('step1NextBtn');
            const step2BackBtn = document.getElementById('step2BackBtn');
            const step2FinishBtn = document.getElementById('step2FinishBtn');
            const phoneInput = document.getElementById('phoneInput');

            function classHasGroups(clsName) {
                if (!clsName) return false;
                const matchDoc = academicClasses.find(c => c.name === clsName);
                if (matchDoc && typeof matchDoc.hasGroups === 'boolean') {
                    return matchDoc.hasGroups;
                }
                return /\b(9|10|11|12)\b/.test(clsName) || /(ssc|hsc)/i.test(clsName);
            }

            function updateGroupCards() {
                if (!groupCardsContainer) return;
                const selectedClass = classSelect ? classSelect.value : '';
                const hasGroups = classHasGroups(selectedClass);

                if (!hasGroups) {
                    if (groupContainer) groupContainer.classList.add('hidden');
                    updateSubjectsList();
                    return;
                }

                if (groupContainer) groupContainer.classList.remove('hidden');

                const classDoc = academicClasses.find(c => c.name === selectedClass);
                let groupsList = [];

                if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                    groupsList = classDoc.groups.map(g => g.name).filter(Boolean);
                }

                if (groupsList.length === 0) {
                    groupsList = ['Science', 'Commerce', 'Humanities'];
                }

                const currentChecked = document.querySelector('input[name="group"]:checked')?.value || groupsList[0];
                groupCardsContainer.innerHTML = '';
                groupCardsContainer.className = `grid grid-cols-${Math.min(groupsList.length, 3)} gap-2`;

                groupsList.forEach((grpName, i) => {
                    const isChecked = grpName.toLowerCase() === currentChecked.toLowerCase() || (i === 0 && !currentChecked);
                    const iconName = grpName.toLowerCase().includes('sci') ? 'biotech'
                        : grpName.toLowerCase().includes('comm') || grpName.toLowerCase().includes('bus') ? 'trending_up'
                        : 'menu_book';
                    const iconColor = grpName.toLowerCase().includes('sci') ? 'text-[#18a957]'
                        : grpName.toLowerCase().includes('comm') ? 'text-blue-500'
                        : 'text-amber-500';

                    const label = document.createElement('label');
                    label.className = 'cursor-pointer relative';
                    label.innerHTML = `
                        <input type="radio" name="group" value="${grpName}" class="hidden group-radio" ${isChecked ? 'checked' : ''}>
                        <div class="group-card p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-center transition-all flex flex-col items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-lg ${iconColor}">${iconName}</span>
                            <span class="font-medium text-[11px] sm:text-xs text-slate-800 dark:text-slate-200">${grpName}</span>
                        </div>
                    `;
                    groupCardsContainer.appendChild(label);
                });

                const newRadios = groupCardsContainer.querySelectorAll('input[name="group"]');
                newRadios.forEach(r => {
                    r.addEventListener('change', () => {
                        updateSubjectsList();
                    });
                });

                updateSubjectsList();
            }

            function updateSubjectsList() {
                if (!subjectsWrapper) return;
                const selectedClass = classSelect ? classSelect.value : 'Class 10';
                const hasGroups = classHasGroups(selectedClass);
                const activeGroupRadio = document.querySelector('input[name="group"]:checked');
                const selectedGroup = (activeGroupRadio ? activeGroupRadio.value : 'Science').trim();

                let groupSubsToRender = [];
                let currentCompulsory = [];
                const classDoc = academicClasses.find(c => c.name === selectedClass);

                if (hasGroups) {
                    if (classDoc && Array.isArray(classDoc.commonSubjects) && classDoc.commonSubjects.length > 0) {
                        currentCompulsory = classDoc.commonSubjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        const isHsc = /11|12/i.test(selectedClass);
                        currentCompulsory = isHsc ? hscCommon : sscCommon;
                    }

                    if (classDoc && Array.isArray(classDoc.groups) && classDoc.groups.length > 0) {
                        const grp = classDoc.groups.find(g => (g.name || '').toLowerCase() === selectedGroup.toLowerCase());
                        if (grp && Array.isArray(grp.subjects) && grp.subjects.length > 0) {
                            groupSubsToRender = grp.subjects.map(s => String(s).trim()).filter(Boolean);
                        }
                    }

                    if (groupSubsToRender.length === 0) {
                        const isHsc = /11|12/i.test(selectedClass);
                        const groupPool = isHsc ? hscGroupsData : sscGroupsData;
                        groupSubsToRender = groupPool[selectedGroup] || groupPool['Science'] || [];
                    }

                    const compSet = new Set(currentCompulsory.map(s => s.toLowerCase()));
                    groupSubsToRender = groupSubsToRender.filter(s => !compSet.has(s.toLowerCase()));

                } else {
                    if (classDoc && Array.isArray(classDoc.subjects) && classDoc.subjects.length > 0) {
                        currentCompulsory = classDoc.subjects.map(s => String(s).trim()).filter(Boolean);
                    } else {
                        currentCompulsory = ['Bangla', 'English', 'Mathematics', 'Science', 'ICT', 'Religion', 'General Science'];
                    }
                    groupSubsToRender = [];
                }

                subjectsWrapper.innerHTML = '';
                if (groupSubsToRender.length === 0) {
                    if (hasGroups) {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-400">No elective group subjects required.</div>';
                    } else {
                        subjectsWrapper.innerHTML = '<div class="w-full text-center py-2 text-xs text-slate-500 dark:text-slate-400">All subjects for this class are core curriculum and will be auto-assigned.</div>';
                    }
                    if (selectedSubCount) selectedSubCount.textContent = '0';
                } else {
                    groupSubsToRender.forEach(sub => {
                        const label = document.createElement('label');
                        label.className = 'subject-chip selected inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[#18a957] bg-[#18a957]/10 text-slate-800 dark:text-slate-100 text-xs font-medium cursor-pointer transition-all select-none hover:opacity-90';
                        label.innerHTML = `
                            <input type="checkbox" name="subjects" value="${sub}" checked class="hidden subject-checkbox">
                            <span class="material-symbols-outlined text-xs text-[#18a957] chip-icon">check</span>
                            <span>${sub}</span>
                        `;

                        const checkbox = label.querySelector('.subject-checkbox');
                        const icon = label.querySelector('.chip-icon');

                        label.addEventListener('click', (e) => {
                            if (e.target !== checkbox) {
                                checkbox.checked = !checkbox.checked;
                            }
                            if (checkbox.checked) {
                                label.classList.add('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                                label.classList.remove('border-slate-200', 'dark:border-slate-800');
                                icon.textContent = 'check';
                                icon.classList.remove('hidden');
                            } else {
                                label.classList.remove('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                                label.classList.add('border-slate-200', 'dark:border-slate-800');
                                icon.textContent = '';
                                icon.classList.add('hidden');
                            }
                            updateSelectedCount();
                        });

                        subjectsWrapper.appendChild(label);
                    });
                    updateSelectedCount();
                }
            }

            function updateSelectedCount() {
                if (!selectedSubCount) return;
                const checked = subjectsWrapper.querySelectorAll('input[type="checkbox"]:checked');
                selectedSubCount.textContent = checked.length;
            }

            window.toggleAllSubjects = function() {
                if (!subjectsWrapper) return;
                const checkboxes = subjectsWrapper.querySelectorAll('input[type="checkbox"]');
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                const targetState = !allChecked;

                checkboxes.forEach(c => {
                    c.checked = targetState;
                    const label = c.closest('.subject-chip');
                    const icon = label.querySelector('.chip-icon');
                    if (targetState) {
                        label.classList.add('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                        label.classList.remove('border-slate-200', 'dark:border-slate-800');
                        if (icon) {
                            icon.textContent = 'check';
                            icon.classList.remove('hidden');
                        }
                    } else {
                        label.classList.remove('selected', 'border-[#18a957]', 'bg-[#18a957]/10');
                        label.classList.add('border-slate-200', 'dark:border-slate-800');
                        if (icon) {
                            icon.textContent = '';
                            icon.classList.add('hidden');
                        }
                    }
                });
                updateSelectedCount();
            };

            if (classSelect) {
                classSelect.addEventListener('change', updateGroupCards);
            }

            updateGroupCards();

            // Step 1 -> Step 2 Navigation
            if (step1NextBtn) {
                step1NextBtn.addEventListener('click', function() {
                    const selectedClass = classSelect ? classSelect.value.trim() : '';
                    if (!selectedClass) {
                        showToast('Please select your Class / Level.');
                        return;
                    }

                    step1.classList.add('hidden');
                    step2.classList.remove('hidden');
                    if (progressBar) progressBar.style.width = '80%';
                });
            }

            // Step 2 -> Step 1 Back Navigation
            if (step2BackBtn) {
                step2BackBtn.addEventListener('click', function() {
                    step2.classList.add('hidden');
                    step1.classList.remove('hidden');
                    if (progressBar) progressBar.style.width = '50%';
                });
            }

            // Step 2 -> Finish or Phone Verification
            if (step2FinishBtn) {
                step2FinishBtn.addEventListener('click', async function() {
                    const selectedClass = classSelect ? classSelect.value.trim() : '';
                    const activeGroupRadio = document.querySelector('input[name="group"]:checked');
                    const group = activeGroupRadio ? activeGroupRadio.value : '';
                    const selectedSubjects = Array.from(subjectsWrapper.querySelectorAll('input[name="subjects"]:checked')).map(c => c.value);
                    const phoneVal = phoneInput ? phoneInput.value.trim() : '';

                    const btnText = document.getElementById('finishBtnText');
                    const btnIcon = document.getElementById('finishBtnIcon');

                    step2FinishBtn.disabled = true;
                    step2FinishBtn.classList.add('opacity-80', 'cursor-not-allowed');
                    btnText.textContent = 'Saving setup...';
                    if (btnIcon) {
                        btnIcon.textContent = 'sync';
                        btnIcon.classList.add('animate-spin');
                    }

                    // Save academic preferences first
                    try {
                        const saveRes = await fetch('/onboarding', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                classLevel: selectedClass,
                                group: group,
                                subjects: selectedSubjects
                            })
                        });

                        const saveData = await saveRes.json();
                        if (!saveRes.ok || !saveData.success) {
                            showToast(saveData.error || 'Failed to save setup.');
                            step2FinishBtn.disabled = false;
                            step2FinishBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                            btnText.textContent = 'Complete Setup';
                            if (btnIcon) {
                                btnIcon.textContent = 'arrow_forward';
                                btnIcon.classList.remove('animate-spin');
                            }
                            return;
                        }

                        // Check if phone number was entered
                        if (!phoneVal) {
                            // No phone number entered -> Direct to Dashboard!
                            showToast('Setup complete! Welcome to ODDHAY.', 'success');
                            setTimeout(() => {
                                window.location.href = saveData.redirect || '/dashboard';
                            }, 350);
                            return;
                        }

                        // Phone number entered -> Send OTP & go to Step 3!
                        btnText.textContent = 'Sending OTP...';
                        const otpRes = await fetch('/onboarding/send-phone-otp', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({ phone: phoneVal })
                        });

                        const otpData = await otpRes.json();
                        if (!otpRes.ok || !otpData.success) {
                            showToast(otpData.error || 'Failed to send phone OTP.');
                            step2FinishBtn.disabled = false;
                            step2FinishBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                            btnText.textContent = 'Complete Setup';
                            if (btnIcon) {
                                btnIcon.textContent = 'arrow_forward';
                                btnIcon.classList.remove('animate-spin');
                            }
                            return;
                        }

                        // Transition to Step 3 (Phone OTP)
                        step2.classList.add('hidden');
                        step3.classList.remove('hidden');
                        if (progressBar) progressBar.style.width = '100%';

                        const targetSpan = document.getElementById('onboardPhoneTarget');
                        if (targetSpan) targetSpan.textContent = otpData.maskedTarget || phoneVal;

                        const otpInput = document.getElementById('phoneOtpInput');
                        if (otpInput) {
                            otpInput.value = '';
                            setTimeout(() => otpInput.focus(), 150);
                        }

                        startPhoneCountdown();
                        showToast('Verification OTP sent to ' + (otpData.maskedTarget || phoneVal), 'success');

                    } catch (err) {
                        console.error('Onboarding step 2 error:', err);
                        showToast('Network error. Please try again.');
                        step2FinishBtn.disabled = false;
                        step2FinishBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                        btnText.textContent = 'Complete Setup';
                        if (btnIcon) {
                            btnIcon.textContent = 'arrow_forward';
                            btnIcon.classList.remove('animate-spin');
                        }
                    }
                });
            }

            // Step 3: Phone OTP Form Submission
            const phoneOtpForm = document.getElementById('onboardPhoneOtpForm');
            if (phoneOtpForm) {
                phoneOtpForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const otpInput = document.getElementById('phoneOtpInput');
                    const otpVal = otpInput ? otpInput.value.trim() : '';

                    if (!otpVal || otpVal.length !== 6) {
                        showToast('Please enter the 6-digit OTP code.');
                        if (otpInput) otpInput.focus();
                        return;
                    }

                    const submitBtn = document.getElementById('phoneOtpSubmitBtn');
                    const btnText = document.getElementById('phoneOtpBtnText');
                    const btnIcon = document.getElementById('phoneOtpBtnIcon');

                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
                    btnText.textContent = 'Verifying...';
                    if (btnIcon) {
                        btnIcon.textContent = 'sync';
                        btnIcon.classList.add('animate-spin');
                    }

                    try {
                        const res = await fetch('/onboarding/verify-phone-otp', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({ otp: otpVal })
                        });

                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            showToast(data.error || 'Invalid OTP code.');
                            submitBtn.disabled = false;
                            submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                            btnText.textContent = 'Verify & Enter Dashboard';
                            if (btnIcon) {
                                btnIcon.textContent = 'verified';
                                btnIcon.classList.remove('animate-spin');
                            }
                            if (otpInput) {
                                otpInput.select();
                                otpInput.focus();
                            }
                            return;
                        }

                        showToast('Phone verified! Entering dashboard...', 'success');
                        setTimeout(() => {
                            window.location.href = data.redirect || '/dashboard';
                        }, 350);

                    } catch (err) {
                        console.error('Phone OTP verify error:', err);
                        showToast('Network error. Please try again.');
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                        btnText.textContent = 'Verify & Enter Dashboard';
                        if (btnIcon) {
                            btnIcon.textContent = 'verified';
                            btnIcon.classList.remove('animate-spin');
                        }
                    }
                });
            }

            // Auto submit OTP on entering 6 digits
            const phoneOtpInputField = document.getElementById('phoneOtpInput');
            if (phoneOtpInputField) {
                phoneOtpInputField.addEventListener('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                    if (this.value.length === 6) {
                        if (phoneOtpForm) {
                            phoneOtpForm.dispatchEvent(new Event('submit', { cancelable: true }));
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
