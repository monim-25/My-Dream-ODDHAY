<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Frequently Asked Questions (FAQ) | ODDHAY</title>
    <meta name="description" content="Find answers to common questions about ODDHAY digital education platform — courses, live model tests, payments, and refunds.">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Clean Header & Search -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
                <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 mb-1.5 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">FAQ</span>
                </nav>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">
                            Frequently Asked Questions (FAQ)
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-normal">
                            Common questions and answers regarding ODDHAY learning services
                        </p>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                        <input type="text" id="faq-search" placeholder="Search questions..."
                            class="w-full h-9 pl-9 pr-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 shadow-2xs">
                    </div>
                </div>
            </div>

            <!-- Categories -->
            <% 
            const faqCategories = [
                { 
                    category: 'General Questions', 
                    icon: 'info', 
                    faqs: [
                        { q: 'What is ODDHAY?', a: 'ODDHAY is a specialized digital education platform tailored for secondary and higher secondary students (Class 9 to 12) preparing for SSC and HSC board examinations in Bangladesh.' },
                        { q: 'Which academic classes and streams are covered?', a: 'ODDHAY provides structured preparatory materials and model tests for SSC (Classes 9-10) and HSC (Classes 11-12) Science, Humanities, and Business Studies streams.' },
                        { q: 'Can students practice for free?', a: 'Yes. Free registration gives immediate access to demo model tests, previous years\' board question archives, and sample problem explanations.' }
                    ] 
                },
                { 
                    category: 'Accounts & Examination', 
                    icon: 'school', 
                    faqs: [
                        { q: 'How do I create an account?', a: 'Click the "Get Started" button in the navigation header, provide your name, phone number, and password, and your account is ready within seconds.' },
                        { q: 'How do smart timed model tests work?', a: 'Each model test counts down in real-time according to official board exam guidelines, automatically calculates negative markings, and delivers instant ranking reports.' },
                        { q: 'Are board questions verified?', a: 'Yes. All questions and answers are compiled directly from official education board examinations and verified by experienced faculty members.' }
                    ] 
                },
                { 
                    category: 'Payments & Refunds', 
                    icon: 'payments', 
                    faqs: [
                        { q: 'Which payment methods are accepted?', a: 'ODDHAY accepts all major mobile financial services including bKash, Nagad, Rocket, as well as local and international debit and credit cards.' },
                        { q: 'What is the refund process?', a: 'If a course does not meet expectations, students can apply for a refund within 48 hours of enrollment. Refer to the ODDHAY Refund Policy for detailed eligibility criteria.' }
                    ] 
                }
            ]; 
            %>

            <div class="space-y-5">
                <% faqCategories.forEach((cat) => { %>
                    <div class="space-y-2.5">
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-emerald-500 text-base"><%= cat.icon %></span>
                            <span><%= cat.category %></span>
                        </h2>

                        <div class="space-y-2">
                            <% cat.faqs.forEach((faq) => { %>
                                <div class="faq-item p-3.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs" data-question="<%= faq.q.toLowerCase() %>">
                                    <button type="button" class="faq-btn w-full text-left flex items-center justify-between gap-3 cursor-pointer group" onclick="toggleFaqItem(this)">
                                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-emerald-600 transition-colors">
                                            <%= faq.q %>
                                        </span>
                                        <span class="material-symbols-rounded text-slate-400 text-lg faq-icon transition-transform">expand_more</span>
                                    </button>
                                    <div class="faq-answer hidden pt-2 mt-2 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
                                        <%= faq.a %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- Still Have Question Box -->
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-2xs">
                <div>
                    <h3 class="text-xs font-semibold text-slate-900 dark:text-white">Haven't found your answer?</h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Reach out to the ODDHAY support team directly.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/contact" class="px-3.5 py-2 rounded-lg bg-[#18a957] hover:bg-[#148e49] text-white text-xs font-semibold shadow-xs">
                        Contact Support
                    </a>
                </div>
            </div>

        </div>
    </main>

    <%- include('partials/footer', { lang: 'en' }) %>

    <script>
        function toggleFaqItem(btn) {
            const item = btn.closest('.faq-item');
            const answer = item.querySelector('.faq-answer');
            const icon = item.querySelector('.faq-icon');
            const isHidden = answer.classList.contains('hidden');
            if (isHidden) {
                answer.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                answer.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }

        document.getElementById('faq-search')?.addEventListener('input', function() {
            const val = this.value.toLowerCase().trim();
            document.querySelectorAll('.faq-item').forEach(el => {
                const q = el.getAttribute('data-question') || '';
                const a = el.querySelector('.faq-answer')?.textContent.toLowerCase() || '';
                el.style.display = (val === '' || q.includes(val) || a.includes(val)) ? '' : 'none';
            });
        });
    </script>
</body>

</html>
