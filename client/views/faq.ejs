<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>সাধারণ প্রশ্নোত্তর (FAQ) | ODDHAY</title>
    <meta name="description" content="ODDHAY সম্পর্কে সাধারণ প্রশ্নের উত্তর — কোর্স, পেমেন্ট, রিফান্ড এবং আরও বিষয়ে।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">
    <%- include('partials/nav') %>

        <main>
            <!-- Hero Banner -->
            <section
                class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-50 to-white dark:from-slate-950 dark:to-slate-900">
                <div class="absolute inset-0 pointer-events-none">
                    <div
                        class="absolute top-0 right-0 w-[500px] h-[500px] bg-emerald-500/5 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/5 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3">
                    </div>
                    <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="grid3" width="60" height="60" patternUnits="userSpaceOnUse">
                                <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid3)" />
                    </svg>
                </div>
                <div class="relative z-10 text-center px-6 pt-32 pb-16">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/8 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] mb-6 border border-emerald-500/15 uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[14px]">help</span>
                        সাহায্য কেন্দ্র
                    </div>
                    <h1 class="font-black tracking-tight leading-tight mb-4"
                        style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
                        সাধারণ <span class="text-primary">প্রশ্নোত্তর</span>
                    </h1>
                    <p class="text-slate-500 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
                        আমাদের সম্পর্কে সবচেয়ে বেশি জিজ্ঞেস করা প্রশ্নের উত্তর এখানে পাবেন।
                    </p>
                </div>
            </section>

            <!-- Search Bar -->
            <section class="py-10 px-6">
                <div class="max-w-2xl mx-auto">
                    <div class="relative">
                        <span
                            class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
                        <input type="text" id="faq-search" placeholder="প্রশ্ন খুঁজুন..."
                            class="w-full h-14 bg-white dark:bg-slate-900 rounded-2xl pl-12 pr-6 border border-slate-100 dark:border-slate-800 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all font-bold text-sm shadow-sm">
                    </div>
                </div>
            </section>

            <!-- FAQ Content -->
            <section class="pb-24 px-6">
                <div class="max-w-3xl mx-auto">

                    <% const faqCategories=[ { category: 'সাধারণ প্রশ্ন' , icon: 'info' , color: 'primary' , faqs: [ {
                        q: 'ODDHAY কি?' ,
                        a: 'ODDHAY হলো বাংলাদেশের শিক্ষার্থীদের জন্য একটি আধুনিক অনলাইন লার্নিং প্ল্যাটফর্ম। এখানে ভিডিও ক্লাস, নোটস, কুইজ, Q&A ফোরাম সহ অনেক ফিচার রয়েছে।'
                        }, { q: 'কি কি ক্লাসের জন্য কোর্স আছে?' ,
                        a: 'বর্তমানে আমরা মূলত বাংলাদেশের মাধ্যমিক (SSC) ও উচ্চ মাধ্যমিক (HSC) শিক্ষার্থীদের জন্য কোর্স তৈরি করছি। শীঘ্রই আরও বিভিন্ন ক্লাসের কোর্স যোগ হবে।'
                        }, { q: 'কি ফ্রিতে ব্যবহার করা যায়?' ,
                        a: 'হ্যাঁ! কিছু কোর্স সম্পূর্ণ বিনামূল্যে আছে। আপনি রেজিস্ট্রেশন করে ফ্রি কন্টেন্ট অ্যাক্সেস করতে পারবেন। প্রিমিয়াম কোর্সের জন্য পেমেন্ট করতে হবে।'
                        }, { q: 'মোবাইলে কি ব্যবহার করা যাবে?' ,
                        a: 'অবশ্যই! ODDHAY সম্পূর্ণ রেসপন্সিভ। যেকোনো ডিভাইস — মোবাইল, ট্যাবলেট বা কম্পিউটারে ব্যবহার করা যাবে।'
                        } ] }, { category: 'একাউন্ট ও রেজিস্ট্রেশন' , icon: 'person' , color: 'indigo-500' , faqs: [ {
                        q: 'কিভাবে রেজিস্ট্রেশন করবো?' ,
                        a: 'উপরের "রেজিস্ট্রেশন" বাটনে ক্লিক করুন। নাম, ইমেইল ও পাসওয়ার্ড দিয়ে সহজেই অ্যাকাউন্ট তৈরি করুন।'
                        }, { q: 'পাসওয়ার্ড ভুলে গেলে কি করবো?' ,
                        a: 'লগইন পেজে "পাসওয়ার্ড ভুলে গেছি?" অপশনে ক্লিক করুন। আপনার ইমেইলে একটি রিসেট লিংক পাঠানো হবে।'
                        }, { q: 'একটি ইমেইলে কয়টি অ্যাকাউন্ট খোলা যাবে?' ,
                        a: 'একটি ইমেইল দিয়ে শুধুমাত্র একটি অ্যাকাউন্ট খোলা যাবে। একাধিক অ্যাকাউন্ট রাখা সাইটের নিয়মের পরিপন্থী।'
                        } ] }, { category: 'কোর্স ও কন্টেন্ট' , icon: 'school' , color: 'amber-500' , faqs: [ {
                        q: 'কোর্স কেনার পর কতদিন অ্যাক্সেস থাকবে?' ,
                        a: 'কোর্স একবার কিনলে আপনি সেই কোর্সে আজীবন অ্যাক্সেস পাবেন এবং যেকোনো সময় দেখতে পারবেন।' }, {
                        q: 'কোর্স ডাউনলোড করা যাবে?' ,
                        a: 'না, নিরাপত্তার কারণে ভিডিও ডাউনলোড করার অপশন নেই। তবে নোটস পিডিএফ হিসেবে ডাউনলোড করা যেতে পারে।'
                        }, { q: 'কোর্সে কি লাইভ ক্লাস আছে?' ,
                        a: 'বর্তমানে আমাদের রেকর্ডেড ক্লাস আছে। শীঘ্রই লাইভ ক্লাস ও ডাউট সেশনের সুবিধা যোগ করা হবে।' },
                        { q: 'কোর্সের মান কেমন?' ,
                        a: 'আমাদের সকল কোর্স অভিজ্ঞ ও দক্ষ শিক্ষকদের দ্বারা তৈরি করা হয়েছে। সিলেবাস অনুযায়ী সাজানো এবং নিয়মিত আপডেট করা হয়।'
                        } ] }, { category: 'পেমেন্ট ও রিফান্ড' , icon: 'payments' , color: 'emerald-500' , faqs: [ {
                        q: 'কি কি পেমেন্ট পদ্ধতি আছে?' ,
                        a: 'বিকাশ, নগদ, রকেট সহ সকল জনপ্রিয় মোবাইল ব্যাংকিং এবং ব্যাংক কার্ড দিয়ে পেমেন্ট করা যায়।'
                        }, { q: 'রিফান্ড পাওয়া যাবে?' ,
                        a: 'কোর্স কেনার ৭ দিনের মধ্যে যদি কন্টেন্টের ৩০%-এর কম দেখা হয়, তাহলে রিফান্ডের আবেদন করতে পারবেন। support@oddhay.com-এ ইমেইল করুন।'
                        }, { q: 'কুপন কোড কোথায় পাব?' ,
                        a: 'আমাদের সোশ্যাল মিডিয়া পেজ, নিউজলেটার এবং বিশেষ ইভেন্টে কুপন কোড দেওয়া হয়। আমাদের ফলো করুন।'
                        }, { q: 'পেমেন্ট সফল হয়নি, কিন্তু টাকা কেটেছে।' ,
                        a: 'এ ধরনের সমস্যায় ২৪ ঘন্টার মধ্যে টাকা ফেরত হয়। যদি না হয়, support@oddhay.com-এ পেমেন্ট স্লিপ সহ যোগাযোগ করুন।'
                        } ] }, { category: 'প্রযুক্তিগত সমস্যা' , icon: 'build' , color: 'rose-500' , faqs: [ {
                        q: 'ভিডিও লোড হচ্ছে না।' ,
                        a: 'ইন্টারনেট সংযোগ চেক করুন। ব্রাউজার রিফ্রেশ করুন বা ক্যাশ ক্লিয়ার করুন। সমস্যা থাকলে সাপোর্টে যোগাযোগ করুন।'
                        }, { q: 'কোন ব্রাউজার ভালো কাজ করে?' ,
                        a: 'সেরা অভিজ্ঞতার জন্য Google Chrome বা Microsoft Edge ব্যবহার করুন (সর্বশেষ সংস্করণ)।' }, {
                        q: 'কুইজ সাবমিট হচ্ছে না।' ,
                        a: 'পেজ রিলোড করবেন না। ব্রাউজার বন্ধ করে আবার খুলুন। স্থিতিশীল ইন্টারনেট সংযোগ নিশ্চিত করুন।' }
                        ] } ]; faqCategories.forEach((cat, ci)=> { %>

                        <!-- Category -->
                        <div class="mb-14 reveal" style="transition-delay: <%= ci * 80 %>ms">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="size-10 rounded-2xl bg-<%= cat.color %>/10 text-<%= cat.color %> flex items-center justify-center">
                                    <span class="material-symbols-outlined text-xl">
                                        <%= cat.icon %>
                                    </span>
                                </div>
                                <h2 class="text-lg font-black text-slate-900 dark:text-white">
                                    <%= cat.category %>
                                </h2>
                            </div>

                            <div class="space-y-3" data-category="<%= cat.category %>">
                                <% cat.faqs.forEach((faq, fi)=> { %>
                                    <div class="faq-item bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 overflow-hidden hover:border-primary/20 transition-all"
                                        data-question="<%= faq.q.toLowerCase() %>">
                                        <button
                                            class="faq-btn w-full text-left p-5 flex items-center justify-between gap-4 group"
                                            onclick="toggleFAQ(this)">
                                            <span
                                                class="font-black text-sm text-slate-800 dark:text-slate-100 group-hover:text-primary transition-colors">
                                                <%= faq.q %>
                                            </span>
                                            <span
                                                class="material-symbols-outlined text-slate-400 text-xl shrink-0 transition-transform duration-300 faq-icon">expand_more</span>
                                        </button>
                                        <div class="faq-answer hidden px-5 pb-5">
                                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                                                <p
                                                    class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed pt-3">
                                                    <%= faq.a %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% }) %>

                            <!-- Still have questions? -->
                            <div
                                class="reveal mt-10 p-8 rounded-3xl bg-gradient-to-br from-primary/5 to-indigo-500/5 border border-primary/10 text-center">
                                <div
                                    class="size-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-5">
                                    <span class="material-symbols-outlined text-2xl">support_agent</span>
                                </div>
                                <h3 class="text-lg font-black mb-3">এখনো প্রশ্ন আছে?</h3>
                                <p class="text-slate-500 dark:text-slate-400 text-sm mb-6 max-w-md mx-auto">আপনার
                                    প্রশ্নের উত্তর না পেলে সরাসরি আমাদের সাথে যোগাযোগ করুন। আমরা সর্বদা সাহায্য করতে
                                    প্রস্তুত।</p>
                                <div class="flex flex-wrap gap-4 justify-center">
                                    <a href="/#contact"
                                        class="btn-primary !py-2.5 !px-7 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">chat</span>
                                        মেসেজ করুন
                                    </a>
                                    <a href="mailto:support@oddhay.com"
                                        class="btn-secondary !py-2.5 !px-7 !text-sm !rounded-xl flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[16px]">alternate_email</span>
                                        ইমেইল করুন
                                    </a>
                                </div>
                            </div>

                </div>
            </section>
        </main>

        <!-- Footer removed -->

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    // Reveal animations
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
                    }, { threshold: 0.05 });
                    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

                    // FAQ Search
                    const searchInput = document.getElementById('faq-search');
                    searchInput.addEventListener('input', () => {
                        const query = searchInput.value.toLowerCase().trim();
                        document.querySelectorAll('.faq-item').forEach(item => {
                            const question = item.dataset.question || '';
                            const answer = item.querySelector('.faq-answer p')?.textContent.toLowerCase() || '';
                            item.style.display = (query === '' || question.includes(query) || answer.includes(query)) ? '' : 'none';
                        });
                    });
                });

                function toggleFAQ(btn) {
                    const item = btn.closest('.faq-item');
                    const answer = item.querySelector('.faq-answer');
                    const icon = btn.querySelector('.faq-icon');
                    const isOpen = !answer.classList.contains('hidden');

                    // Close all others
                    document.querySelectorAll('.faq-item').forEach(el => {
                        el.querySelector('.faq-answer').classList.add('hidden');
                        el.querySelector('.faq-icon').style.transform = 'rotate(0deg)';
                        el.classList.remove('border-primary/30');
                    });

                    if (!isOpen) {
                        answer.classList.remove('hidden');
                        icon.style.transform = 'rotate(180deg)';
                        item.classList.add('border-primary/30');
                    }
                }
            </script>
</body>

</html>