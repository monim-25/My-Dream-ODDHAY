<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>সাধারণ প্রশ্নোত্তর (FAQ) | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়) সম্পর্কে সাধারণ প্রশ্নের উত্তর — কোর্স, লাইভ এক্সাম, পেমেন্ট, রিফান্ড ও প্রযুক্তিগত সহায়তা।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans">
    <%- include('partials/nav') %>

    <main class="flex-1">
        <!-- Hero Banner -->
        <section class="relative min-h-[38vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-500/5 via-slate-50 to-white dark:from-emerald-950/20 dark:via-slate-950 dark:to-slate-900">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-emerald-500/8 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/8 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3"></div>
                <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="grid3" width="60" height="60" patternUnits="userSpaceOnUse">
                            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#grid3)" />
                </svg>
            </div>
            <div class="relative z-10 text-center px-6 pt-32 pb-14">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] mb-5 border border-emerald-500/20 uppercase tracking-wider">
                    <span class="material-symbols-rounded text-sm">help</span>
                    সাহায্য কেন্দ্র & সাধারণ জিজ্ঞাসা
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
                    সাধারণ <span class="text-emerald-600 dark:text-emerald-400">প্রশ্নোত্তর (FAQ)</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
                    ODDHAY প্ল্যাটফর্ম সম্পর্কে সবচেয়ে বেশি জিজ্ঞাসিত প্রশ্নের সমাধান এখানে পাওয়া যাবে।
                </p>
            </div>
        </section>

        <!-- Search Bar -->
        <section class="py-6 px-4 sm:px-6">
            <div class="max-w-2xl mx-auto">
                <div class="relative">
                    <span class="material-symbols-rounded absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
                    <input type="text" id="faq-search" placeholder="আপনার প্রশ্নটি খুঁজুন (উদা: রিফান্ড, পেমেন্ট, পাসওয়ার্ড)..."
                        class="w-full h-12 sm:h-13 bg-white dark:bg-slate-900 rounded-2xl pl-12 pr-4 border border-slate-200/90 dark:border-slate-800 text-xs sm:text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-xs">
                </div>
            </div>
        </section>

        <!-- FAQ Content -->
        <section class="pb-20 px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto space-y-10">

                <% 
                const faqCategories = [
                    { 
                        category: 'সাধারণ প্রশ্ন', 
                        icon: 'info', 
                        color: 'emerald-500', 
                        faqs: [
                            {
                                q: 'ODDHAY (অধ্যায়) কি?',
                                a: 'ODDHAY হলো বাংলাদেশের শিক্ষার্থীদের জন্য একটি আধুনিক ডিজিটাল লার্নিং প্ল্যাটফর্ম। এখানে নবম-দ্বাদশ শ্রেণির (SSC & HSC) শিক্ষার্থীদের জন্য বোর্ড স্ট্যান্ডার্ড লাইভ মডেল টেস্ট, স্মার্ট টাইমার ভিত্তিক পরীক্ষা, বিগত বছরের বোর্ড প্রশ্নব্যাংক এবং অধ্যায়ভিত্তিক অনুশীলনের ব্যবস্থা রয়েছে।'
                            },
                            { 
                                q: 'কি কি শ্রেণির জন্য কোর্স ও পরীক্ষা আছে?',
                                a: 'বর্তমানে আমরা মূলত নবম ও দশম শ্রেণির SSC প্রস্তুতি এবং একাদশ ও দ্বাদশ শ্রেণির HSC বিজ্ঞান, মানবিক ও ব্যবসায় শিক্ষা বিভাগের বোর্ড পরীক্ষার জন্য পূর্ণাঙ্গ কোর্স ও মডেল টেস্ট পরিচালনা করছি।'
                            },
                            { 
                                q: 'বিনামূল্যে কি অনুশীলন করা সম্ভব?',
                                a: 'হ্যাঁ! ODDHAY-তে ফ্রি একাউন্ট তৈরি করে বেশ কিছু ফ্রি টেস্ট, বিগত বছরের বোর্ড প্রশ্নব্যাংক এবং ডেমো কন্টেন্টে সরাসরি অংশ নেওয়া যায়। বিশেষায়িত মডেল টেস্ট সিরিজের জন্য এনরোলমেন্ট প্রয়োজন হয়।'
                            },
                            { 
                                q: 'মোবাইলে কি পরীক্ষা দেওয়া যাবে?',
                                a: 'অবশ্যই! ODDHAY সম্পূর্ণ মোবাইল ফ্রেন্ডলি ও রেসপন্সিভ। যেকোনো স্মার্টফোন, ট্যাবলেট, ল্যাপটপ বা ডেস্কটপ কম্পিউটারে ব্রাউজার দিয়ে নিরবচ্ছিন্নভাবে ব্যবহার করা যায়।'
                            }
                        ] 
                    },
                    { 
                        category: 'একাউন্ট ও রেজিস্ট্রেশন', 
                        icon: 'person', 
                        color: 'indigo-500', 
                        faqs: [
                            {
                                q: 'কীভাবে একাউন্ট খুলব?',
                                a: 'ওয়েবসাইটের উপরে বা নিচে থাকা "শুরু করো" বা "রেজিস্ট্রেশন" বাটনে ক্লিক করে নাম, মোবাইল নম্বর/ইমেইল এবং একটি নিরাপদ পাসওয়ার্ড দিয়ে কয়েক সেকেন্ডেই একাউন্ট তৈরি করা যায়।'
                            },
                            { 
                                q: 'পাসওয়ার্ড ভুলে গেলে কী করব?',
                                a: 'লগইন পেজে "পাসওয়ার্ড ভুলে গেছেন?" অপশনে ক্লিক করে আপনার নিবন্ধিত ইমেইল দিলে একটি ভেরিফিকেশন লিঙ্ক পাঠানো হবে, যার মাধ্যমে নতুন পাসওয়ার্ড সেট করা যাবে।'
                            },
                            { 
                                q: 'একটি একাউন্ট কি একাধিক ব্যক্তি ব্যবহার করতে পারে?',
                                a: 'না, পরীক্ষার সঠিক ফলাফল এনালাইসিস এবং একাউন্ট সুরক্ষার স্বার্থে একটি একাউন্ট কেবল একজন শিক্ষার্থীর জন্য প্রযোজ্য। একাধিক ব্যক্তি একই একাউন্ট ব্যবহার করলে সিস্টেম স্বয়ংক্রিয়ভাবে লক হতে পারে।'
                            }
                        ] 
                    },
                    { 
                        category: 'পরীক্ষা ও প্রশ্নব্যাংক', 
                        icon: 'school', 
                        color: 'amber-500', 
                        faqs: [
                            {
                                q: 'টাইমারভিত্তিক পরীক্ষা কীভাবে কাজ করে?',
                                a: 'পরীক্ষা শুরু করার পর প্রতিটি প্রশ্নের জন্য নির্দিষ্ট সময় গণনা করা হয় এবং বোর্ড পরীক্ষার নিয়মে নেগেটিভ মার্কিং হিসাব করে সাবমিট শেষে বিস্তারিত স্কোরকার্ড ও সঠিক উত্তর দেখানো হয়।'
                            },
                            { 
                                q: 'বিগত বছরের বোর্ড প্রশ্নব্যাংক কি নির্ভুল?',
                                a: 'হ্যাঁ! আমাদের প্রতিটি প্রশ্ন এনসিটিবি কারিকুলাম ও সকল সাধারণ শিক্ষা বোর্ডের মূল প্রশ্নপত্রের সাথে মিলিয়ে অভিজ্ঞ শিক্ষক প্যানেল দ্বারা যাচাইকৃত ও নির্ভুল ব্যাখ্যা সহ সংযোজিত।'
                            },
                            { 
                                q: 'পরীক্ষার পর কি র‍্যাঙ্কিং দেখতে পারব?',
                                a: 'হ্যাঁ! লাইভ মডেল টেস্টগুলোতে অংশগ্রহণকারী সকল শিক্ষার্থীর মধ্যে আপনার অবস্থান, গড় সময় এবং বিষয়ভিত্তিক দুর্বলতা লিডারবোর্ডে স্বয়ংক্রিয়ভাবে প্রদর্শিত হয়।'
                            }
                        ] 
                    },
                    { 
                        category: 'পেমেন্ট ও রিফান্ড পলিসি', 
                        icon: 'payments', 
                        color: 'emerald-600', 
                        faqs: [
                            {
                                q: 'কী কী মাধ্যমে পেমেন্ট করা যায়?',
                                a: 'বিকাশ (bKash), নগদ (Nagad), রকেট (Rocket), উপায়ের পাশাপাশি যেকোনো দেশি বা আন্তর্জাতিক ভিসা/মাস্টারকার্ড এবং অনলাইন ব্যাংকিংয়ের মাধ্যমে সম্পূর্ণ নিরাপদে পেমেন্ট করা যায়।'
                            },
                            { 
                                q: 'টাকা কেটে নিয়েছে কিন্তু কোর্স সক্রিয় হয়নি?',
                                a: 'সার্ভার বা ব্যাংকিং নেটওয়ার্কের কারণে কদাচিৎ বিলম্বে হলে চিন্তিত হওয়ার কারণ নেই। আপনার পেমেন্ট ট্রানজ্যাকশন আইডি সহ আমাদের হেল্পলাইন বা হোয়াটসঅ্যাপে যোগাযোগ করলে তাৎক্ষণিক ভেরিফাই করে সক্রিয় করে দেওয়া হয়।'
                            },
                            { 
                                q: 'রিফান্ডের নিয়ম কী?',
                                a: 'ভুল কোর্সে এনরোল করলে বা প্রযুক্তিগত ত্রুটির কারণে সেবা না পেলে প্রথম ৪৮ ঘণ্টার মধ্যে আমাদের সাথে যোগাযোগ করে রিফান্ডের আবেদন করা যায়। বিস্তারিত তথ্যের জন্য আমাদের রিফান্ড পলিসি পাতা দেখুন।'
                            }
                        ] 
                    },
                    { 
                        category: 'প্রযুক্তিগত সহায়তা ও হেল্পডেস্ক', 
                        icon: 'support_agent', 
                        color: 'rose-500', 
                        faqs: [
                            {
                                q: 'কোন ব্রাউজারে সাইটটি সবচেয়ে ভালো কাজ করে?',
                                a: 'Google Chrome, Microsoft Edge, Mozilla Firefox কিংবা Safari ব্রাউজারের সর্বশেষ সংস্করণ ব্যবহারে সর্বোত্তম অভিজ্ঞতা পাওয়া যায়।'
                            },
                            { 
                                q: 'সাপোর্টের সাথে কীভাবে যোগাযোগ করব?',
                                a: 'আমাদের সাপোর্ট হটলাইন, অফিসিয়াল ইমেইল support@oddhay.com কিংবা সাইটের নিচে থাকা "Direct WhatsApp Support" লিংকে ক্লিক করে সরাসরি আমাদের কাস্টমার কেয়ার প্রতিনিধির সাথে কথা বলতে পারেন।'
                            }
                        ] 
                    }
                ]; 
                %>

                <% faqCategories.forEach((cat, ci) => { %>
                    <div class="reveal space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="size-9 rounded-xl bg-<%= cat.color %>/10 text-<%= cat.color %> flex items-center justify-center">
                                <span class="material-symbols-rounded text-lg"><%= cat.icon %></span>
                            </div>
                            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                                <%= cat.category %>
                            </h2>
                        </div>

                        <div class="space-y-3">
                            <% cat.faqs.forEach((faq) => { %>
                                <div class="faq-item bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden hover:border-emerald-500/30 transition-all shadow-2xs"
                                    data-question="<%= faq.q.toLowerCase() %>">
                                    <button type="button" class="faq-btn w-full text-left p-5 flex items-center justify-between gap-4 group cursor-pointer" onclick="toggleFAQ(this)">
                                        <span class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 transition-colors leading-relaxed">
                                            <%= faq.q %>
                                        </span>
                                        <span class="material-symbols-rounded text-slate-400 text-xl shrink-0 transition-transform duration-300 faq-icon">expand_more</span>
                                    </button>
                                    <div class="faq-answer hidden px-5 pb-5">
                                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80">
                                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed font-normal">
                                                <%= faq.a %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>

                <!-- Still have questions? -->
                <div class="reveal mt-12 p-8 rounded-3xl bg-gradient-to-br from-emerald-500/10 via-white to-indigo-500/10 dark:from-emerald-950/40 dark:via-slate-900 dark:to-indigo-950/30 border border-emerald-500/20 text-center space-y-3">
                    <div class="size-12 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto">
                        <span class="material-symbols-rounded text-2xl">support_agent</span>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">আপনার উত্তর খুঁজে পাননি?</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
                        সরাসরি আমাদের সাপোর্ট টিমের সাথে কথা বলুন। আমরা দ্রুততম সময়ে আপনাকে সাহায্য করতে প্রস্তুত।
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3 justify-center">
                        <a href="/contact" class="px-5 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs transition-all shadow-xs flex items-center gap-2">
                            <span class="material-symbols-rounded text-sm">mail</span>
                            <span>মেসেজ পাঠান</span>
                        </a>
                        <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-xs transition-all border border-slate-200 dark:border-slate-700 flex items-center gap-2">
                            <i class="fa-brands fa-whatsapp text-emerald-500 text-sm"></i>
                            <span>হোয়াটসঅ্যাপে যোগাযোগ</span>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Reveal animations
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
            }, { threshold: 0.05 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

            // FAQ Search
            const searchInput = document.getElementById('faq-search');
            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    const query = searchInput.value.toLowerCase().trim();
                    document.querySelectorAll('.faq-item').forEach(item => {
                        const question = item.dataset.question || '';
                        const answer = item.querySelector('.faq-answer p')?.textContent.toLowerCase() || '';
                        item.style.display = (query === '' || question.includes(query) || answer.includes(query)) ? '' : 'none';
                    });
                });
            }
        });

        function toggleFAQ(btn) {
            const item = btn.closest('.faq-item');
            const answer = item.querySelector('.faq-answer');
            const icon = btn.querySelector('.faq-icon');
            const isOpen = !answer.classList.contains('hidden');

            // Close all others
            document.querySelectorAll('.faq-item').forEach(el => {
                el.querySelector('.faq-answer').classList.add('hidden');
                const i = el.querySelector('.faq-icon');
                if (i) i.style.transform = 'rotate(0deg)';
                el.classList.remove('border-emerald-500/50');
            });

            if (!isOpen) {
                answer.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
                item.classList.add('border-emerald-500/50');
            }
        }
    </script>
</body>

</html>
