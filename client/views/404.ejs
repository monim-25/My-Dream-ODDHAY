<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>পেজ পাওয়া যায়নি | ODDHAY</title>
    <%- include('partials/head') %>
        <style>
            .error-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: #f8fafc;
                padding: 2rem;
                transition: background-color 0.3s ease;
            }

            .dark .error-container {
                background-color: #0f172a;
            }

            .error-card {
                background: white;
                border: 1px solid #f1f5f9;
                border-radius: 3rem;
                padding: 4rem 2rem;
                max-width: 600px;
                width: 100%;
                text-align: center;
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
                position: relative;
                overflow: hidden;
            }

            .dark .error-card {
                background: #1e293b;
                border-color: #334155;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            }

            .stylized-404 {
                font-size: 10rem;
                font-weight: 900;
                line-height: 1;
                background: linear-gradient(135deg, #137fec 0%, #3b82f6 100%);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                opacity: 0.1;
                position: absolute;
                top: 2rem;
                left: 50%;
                transform: translateX(-50%);
                letter-spacing: -0.05em;
                user-select: none;
                pointer-events: none;
            }

            .dark .stylized-404 {
                opacity: 0.05;
            }

            .error-icon {
                position: relative;
                z-index: 10;
                margin-bottom: 2.5rem;
            }

            .icon-box {
                width: 100px;
                height: 100px;
                background: #f1f5f9;
                border-radius: 2.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
                border: 1px solid #e2e8f0;
                box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
            }

            .dark .icon-box {
                background: #0f172a;
                border-color: #1e293b;
            }
        </style>
</head>

<body>
    <div class="error-container">
        <div class="error-card reveal-up">
            <div class="stylized-404">404</div>

            <div class="error-icon">
                <div class="icon-box">
                    <span class="material-symbols-rounded text-6xl text-primary">browser_updated</span>
                </div>
            </div>

            <h1 class="text-4xl md:text-5xl font-black text-slate-800 dark:text-white mb-4 tracking-tight">দুঃখিত!</h1>
            <p class="text-slate-500 dark:text-slate-400 font-medium mb-12 text-lg max-w-sm mx-auto leading-relaxed">
                আপনি যে পেজটি খুঁজছেন তা পাওয়া যায়নি বা হয়তো অন্য কোথাও সরিয়ে ফেলা হয়েছে।
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/"
                    class="group flex items-center gap-3 px-10 py-4 bg-primary text-white rounded-[1.5rem] font-bold shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all">
                    <span class="material-symbols-rounded text-[22px]">home</span>
                    হোম পেজে ফিরে যান
                </a>
                <button onclick="window.history.back()"
                    class="flex items-center gap-3 px-10 py-4 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-[1.5rem] font-bold border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all active:scale-95">
                    <span class="material-symbols-rounded text-[22px]">arrow_back</span>
                    আগের পেজে যান
                </button>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/scrollreveal"></script>
    <script>
        // Simple entry animation
        window.addEventListener('load', () => {
            const el = document.querySelector('.reveal-up');
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.6s cubic-bezier(0.22, 1, 0.36, 1)';

            setTimeout(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            }, 100);
        });
    </script>
</body>

</html>