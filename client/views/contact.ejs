<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>যোগাযোগ | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়)-এর সাথে যোগাযোগ করুন — যেকোনো জিজ্ঞাসা, সহায়তা, বা মতামতের জন্য আমাদের হেল্পডেস্কে মেসেজ দিন।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans">
    <%- include('partials/nav') %>

    <main class="flex-1">
        <!-- Hero Banner -->
        <section class="relative min-h-[35vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-500/5 via-slate-50 to-white dark:from-emerald-950/20 dark:via-slate-950 dark:to-slate-900">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 right-0 w-[450px] h-[450px] bg-emerald-500/8 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-primary/8 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3"></div>
            </div>
            <div class="relative z-10 text-center px-6 pt-32 pb-14">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] mb-5 border border-emerald-500/20 uppercase tracking-wider">
                    <span class="material-symbols-rounded text-sm">support_agent</span>
                    সরাসরি সাপোর্ট হেল্পডেস্ক
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
                    আমাদের সাথে <span class="text-emerald-600 dark:text-emerald-400">যোগাযোগ করুন</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
                    আপনার যেকোনো প্রশ্ন, কোর্স সম্পর্কিত তথ্য বা মতামতের জন্য আমরা সর্বদা পাশে আছি।
                </p>
            </div>
        </section>

        <!-- Main Contact Grid -->
        <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
            
            <!-- Success Notification Alert (if submitted) -->
            <div id="contactSuccessAlert" class="hidden mb-8 p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 flex items-start gap-3 shadow-xs">
                <span class="material-symbols-rounded text-2xl text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5">check_circle</span>
                <div>
                    <h4 class="font-bold text-sm">আপনার বার্তা সফলভাবে পাঠানো হয়েছে!</h4>
                    <p class="text-xs text-emerald-700 dark:text-emerald-300 mt-0.5">আমাদের সাপোর্ট টিম দ্রুততম সময়ের মধ্যে আপনার সাথে ইমেইল বা ফোনে যোগাযোগ করবে। ধন্যবাদ।</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
                
                <!-- Left Column: Official Contact & Company Details (lg:col-span-5) -->
                <div class="lg:col-span-5 space-y-6">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                            সরাসরি যোগাযোগ
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                            নিচের মাধ্যমগুলোর যেকোনোটিতে আমাদের সাথে যোগাযোগ করতে পারেন।
                        </p>
                    </div>

                    <!-- Contact Cards List -->
                    <div class="space-y-3.5">
                        <!-- Office Address -->
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 flex items-start gap-4 transition-all hover:border-emerald-500/30 shadow-2xs">
                            <div class="size-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-xl">location_on</span>
                            </div>
                            <div>
                                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">কর্পোরেট অফিস</span>
                                <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 mt-0.5 leading-relaxed">
                                    <%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.address) ? siteSettings.legalInfo.address : 'House #12, Road #04, Dhanmondi, Dhaka - 1209, Bangladesh' %>
                                </p>
                            </div>
                        </div>

                        <!-- Hotline Phone -->
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 flex items-start gap-4 transition-all hover:border-emerald-500/30 shadow-2xs">
                            <div class="size-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-xl">call</span>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">হেল্পলাইন</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium">
                                        <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.supportHours) ? siteSettings.contactInfo.supportHours : '9:00 AM - 11:00 PM' %>
                                    </span>
                                </div>
                                <a href="tel:<%= ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+8809638789012').replace(/\s+/g, '') %>" class="text-sm font-bold text-slate-800 dark:text-slate-100 hover:text-emerald-600 transition-colors num-font block mt-0.5">
                                    <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+880 9638-789012' %>
                                </a>
                            </div>
                        </div>

                        <!-- Support Email -->
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 flex items-start gap-4 transition-all hover:border-emerald-500/30 shadow-2xs">
                            <div class="size-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-xl">mail</span>
                            </div>
                            <div>
                                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">ইমেইল সাপোর্ট</span>
                                <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 hover:text-emerald-600 transition-colors block mt-0.5 font-sans">
                                    <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                                </a>
                            </div>
                        </div>

                        <!-- Direct WhatsApp -->
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 flex items-start gap-4 transition-all hover:border-emerald-500/30 shadow-2xs">
                            <div class="size-10 rounded-xl bg-[#25d366]/10 text-[#25d366] flex items-center justify-center shrink-0">
                                <i class="fa-brands fa-whatsapp text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">হোয়াটসঅ্যাপ চ্যাট</span>
                                <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" class="text-xs sm:text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1.5 mt-0.5">
                                    <span>সরাসরি হোয়াটসঅ্যাপে কথা বলুন</span>
                                    <span class="material-symbols-rounded text-xs">open_in_new</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Official Credentials Info -->
                    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800 space-y-2">
                        <div class="flex items-center gap-2 text-xs font-semibold text-slate-800 dark:text-slate-200">
                            <span class="material-symbols-rounded text-emerald-500 text-base">verified</span>
                            <span>সরকারী নিবন্ধন ও লাইসেন্স</span>
                        </div>
                        <div class="text-xs space-y-1 text-slate-500 dark:text-slate-400">
                            <div class="flex items-center justify-between">
                                <span>ট্রেড লাইসেন্স নং:</span>
                                <span class="font-semibold text-slate-700 dark:text-slate-300 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tradeLicense) ? siteSettings.legalInfo.tradeLicense : 'TRAD/DNCC/041285/2026' %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span>ই-টিন সার্টিফিকেট নং:</span>
                                <span class="font-semibold text-slate-700 dark:text-slate-300 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tinNumber) ? siteSettings.legalInfo.tinNumber : '8491-7302-6194' %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Interactive Contact Form (lg:col-span-7) -->
                <div class="lg:col-span-7 bg-white dark:bg-slate-900 p-6 sm:p-8 lg:p-10 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm">
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-2">
                        আমাদের বার্তা পাঠান
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
                        নিচের ফরমটি পূরণ করুন। আমাদের টিম দ্রুত আপনার সাথে যোগাযোগ করবে।
                    </p>

                    <form action="/contact-submit" method="POST" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    আপনার নাম <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="name" required placeholder="উদা: সাহেদ আহমেদ"
                                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    ইমেইল ঠিকানা <span class="text-rose-500">*</span>
                                </label>
                                <input type="email" name="email" required placeholder="name@example.com"
                                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all font-sans">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    মোবাইল নম্বর
                                </label>
                                <input type="tel" name="phone" placeholder="01XXXXXXXXX"
                                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all num-font">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    বার্তার বিষয় <span class="text-rose-500">*</span>
                                </label>
                                <select name="subject" required
                                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all">
                                    <option value="general">সাধারণ জিজ্ঞাসা</option>
                                    <option value="course">কোর্স ও ক্লাস সংক্রান্ত</option>
                                    <option value="payment">পেমেন্ট ও রিফান্ড সহায়তা</option>
                                    <option value="technical">প্রযুক্তিগত সমস্যা</option>
                                    <option value="other">অন্যান্য</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                বিস্তারিত বার্তা <span class="text-rose-500">*</span>
                            </label>
                            <textarea name="message" required rows="4" placeholder="আপনার সমস্যা বা প্রশ্নের বিস্তারিত বিবরণ লিখুন..."
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all leading-relaxed"></textarea>
                        </div>

                        <button type="submit"
                            class="w-full py-3.5 px-6 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs sm:text-sm transition-all shadow-xs flex items-center justify-center gap-2 active:scale-[0.99] cursor-pointer">
                            <span class="material-symbols-rounded text-base">send</span>
                            <span>বার্তা পাঠান</span>
                        </button>
                    </form>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') === '1' || urlParams.get('contact') === 'success') {
                const alertEl = document.getElementById('contactSuccessAlert');
                if (alertEl) {
                    alertEl.classList.remove('hidden');
                    alertEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
    </script>
</body>

</html>
