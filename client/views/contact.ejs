<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Contact Support | ODDHAY</title>
    <meta name="description" content="Contact ODDHAY digital education platform — Customer support, corporate office, email, and live helpdesk.">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav', { lang: 'en' }) %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto space-y-6">

            <!-- Clean Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
                <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 mb-1.5 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">Contact</span>
                </nav>
                <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    Contact ODDHAY
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-normal">
                    Reach out to our support desk for academic assistance, enrollment queries, or platform feedback.
                </p>
            </div>

            <!-- Success Alert -->
            <div id="contactSuccessAlert" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 flex items-start gap-2.5 shadow-2xs">
                <span class="material-symbols-rounded text-xl text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5">check_circle</span>
                <div>
                    <h4 class="font-semibold text-xs sm:text-sm">Message Sent Successfully!</h4>
                    <p class="text-[11px] text-emerald-700 dark:text-emerald-300 mt-0.5">The ODDHAY support team will review your inquiry and get back to you promptly.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- Left: Contact Details (lg:col-span-5) -->
                <div class="lg:col-span-5 space-y-3">
                    
                    <!-- Office -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-start gap-3 shadow-2xs">
                        <span class="material-symbols-rounded text-emerald-500 text-lg shrink-0 mt-0.5">location_on</span>
                        <div class="text-xs">
                            <span class="text-[10px] text-slate-400 font-semibold uppercase block">Corporate Office</span>
                            <p class="font-medium text-slate-700 dark:text-slate-200 mt-0.5 leading-relaxed">
                                <%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.address) ? siteSettings.legalInfo.address : 'House #12, Road #04, Dhanmondi, Dhaka - 1209, Bangladesh' %>
                            </p>
                        </div>
                    </div>

                    <!-- Hotline -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-start gap-3 shadow-2xs">
                        <span class="material-symbols-rounded text-emerald-500 text-lg shrink-0 mt-0.5">call</span>
                        <div class="text-xs flex-1">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] text-slate-400 font-semibold uppercase">Hotline</span>
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 font-medium">
                                    <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.supportHours) ? siteSettings.contactInfo.supportHours : '9:00 AM - 11:00 PM' %>
                                </span>
                            </div>
                            <a href="tel:<%= ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+8809638789012').replace(/\s+/g, '') %>" class="font-semibold text-slate-800 dark:text-slate-100 hover:text-emerald-600 transition-colors num-font block mt-0.5">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.phone && siteSettings.contactInfo.phone !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.phone : '+880 9638-789012' %>
                            </a>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-start gap-3 shadow-2xs">
                        <span class="material-symbols-rounded text-emerald-500 text-lg shrink-0 mt-0.5">mail</span>
                        <div class="text-xs">
                            <span class="text-[10px] text-slate-400 font-semibold uppercase block">Official Email</span>
                            <a href="mailto:<%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>" class="font-semibold text-slate-800 dark:text-slate-100 hover:text-emerald-600 transition-colors block mt-0.5 font-sans">
                                <%= (locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.email) ? siteSettings.contactInfo.email : 'support@oddhay.com' %>
                            </a>
                        </div>
                    </div>

                    <!-- WhatsApp -->
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-start gap-3 shadow-2xs">
                        <i class="fa-brands fa-whatsapp text-emerald-500 text-lg shrink-0 mt-0.5"></i>
                        <div class="text-xs">
                            <span class="text-[10px] text-slate-400 font-semibold uppercase block">Direct WhatsApp</span>
                            <a href="<%= (locals.siteSettings && siteSettings.socialLinks && siteSettings.socialLinks.whatsapp) ? siteSettings.socialLinks.whatsapp : ('https://wa.me/' + ((locals.siteSettings && siteSettings.contactInfo && siteSettings.contactInfo.whatsapp && siteSettings.contactInfo.whatsapp !== '+8801XXXXXXXXX') ? siteSettings.contactInfo.whatsapp : '8801712345678').replace(/[^0-9]/g, '')) %>" target="_blank" rel="noopener" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1 mt-0.5">
                                <span>Chat with ODDHAY Support</span>
                                <span class="material-symbols-rounded text-xs">open_in_new</span>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Right: Form (lg:col-span-7) -->
                <div class="lg:col-span-7 p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
                    <h2 class="text-sm font-semibold text-slate-900 dark:text-white mb-1">
                        Send a Message
                    </h2>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-4">
                        Please fill in the details below. Our support team will get back to you shortly.
                    </p>

                    <form action="/contact-submit" method="POST" class="space-y-3.5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Name *</label>
                                <input type="text" name="name" required placeholder="e.g. Shahed Ahmed"
                                    class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500">
                            </div>
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Email Address *</label>
                                <input type="email" name="email" required placeholder="name@example.com"
                                    class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-sans">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Phone Number</label>
                                <input type="tel" name="phone" placeholder="+8801XXXXXXXXX"
                                    class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 num-font">
                            </div>
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Inquiry Subject *</label>
                                <select name="subject" required
                                    class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 focus:outline-none focus:border-emerald-500">
                                    <option value="general">General Inquiry</option>
                                    <option value="course">Courses & Live Tests</option>
                                    <option value="payment">Payment & Refunds</option>
                                    <option value="technical">Technical Assistance</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Message *</label>
                            <textarea name="message" required rows="3" placeholder="Describe your inquiry or question in detail..."
                                class="w-full p-3 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 leading-relaxed"></textarea>
                        </div>

                        <button type="submit"
                            class="w-full py-2.5 px-4 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-rounded text-base">send</span>
                            <span>Submit Message</span>
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </main>

    <%- include('partials/footer', { lang: 'en' }) %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') === '1' || urlParams.get('contact') === 'success') {
                const alertEl = document.getElementById('contactSuccessAlert');
                if (alertEl) alertEl.classList.remove('hidden');
            }
        });
    </script>
</body>

</html>
