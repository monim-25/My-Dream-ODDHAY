        // ------------------ SMART FLASHCARDS WITH TOPIC FILTER ------------------
        let currentFilteredCardIndices = [];
        let currentFilterStep = 0;
        let activeFlashcardTopic = 'সকল বিষয়';

        function initFlashcardsDeck() {
            const allCards = document.querySelectorAll('.fc-card-item');
            if (!allCards.length) return;
            currentFilteredCardIndices = Array.from(allCards).map((_, i) => i);
            currentFilterStep = 0;
            updateFlashcardDeckView();
        }

        function filterFlashcardsByTopic(topicName) {
            activeFlashcardTopic = topicName;

            const selectEl = document.getElementById('fcTopicSelect');
            if (selectEl && selectEl.value !== topicName) {
                selectEl.value = topicName;
            }

            // Filter matching indices
            const allCards = document.querySelectorAll('.fc-card-item');
            const matching = [];
            allCards.forEach((card, idx) => {
                const subj = (card.getAttribute('data-subject') || '').trim();
                const isWeak = card.getAttribute('data-is-weak') === 'true';
                let match = false;
                if (topicName === 'সকল বিষয়') {
                    match = true;
                } else if (topicName === 'দুর্বল অধ্যায়') {
                    match = isWeak;
                } else {
                    match = (subj === topicName);
                }
                if (match) matching.push(idx);
            });

            currentFilteredCardIndices = matching;
            currentFilterStep = 0;

            const emptyView = document.getElementById('fcTopicEmptyCard');
            const compView = document.getElementById('fcCompletionCard');
            if (compView) compView.classList.add('hidden');

            if (matching.length === 0) {
                allCards.forEach(c => c.classList.add('hidden'));
                if (emptyView) emptyView.classList.remove('hidden');
                const badge = document.getElementById('fcActiveNumBadge');
                if (badge) badge.innerText = '0';
                const totalBadge = document.getElementById('fcTotalNumBadge');
                if (totalBadge) totalBadge.innerText = '0';
            } else {
                if (emptyView) emptyView.classList.add('hidden');
                updateFlashcardDeckView();
            }
        }

        function updateFlashcardDeckView() {
            const allCards = document.querySelectorAll('.fc-card-item');
            allCards.forEach(c => c.classList.add('hidden'));

            if (!currentFilteredCardIndices.length) return;

            const activeCardIdx = currentFilteredCardIndices[currentFilterStep];
            const targetEl = document.getElementById('fcCardWrap-' + activeCardIdx);
            if (targetEl) targetEl.classList.remove('hidden');

            // Counter Badge
            const badge = document.getElementById('fcActiveNumBadge');
            if (badge) badge.innerText = (currentFilterStep + 1);
            const totalBadge = document.getElementById('fcTotalNumBadge');
            if (totalBadge) totalBadge.innerText = currentFilteredCardIndices.length;

            // Update Previous and Next buttons on the active card
            if (targetEl) {
                const prevBtn = targetEl.querySelector('.fc-prev-btn');
                if (prevBtn) {
                    prevBtn.disabled = (currentFilterStep === 0);
                }
                const nextLabel = targetEl.querySelector('.fc-next-label');
                if (nextLabel) {
                    nextLabel.innerText = (currentFilterStep === currentFilteredCardIndices.length - 1) ? 'সমাপ্ত করুন' : 'পরবর্তী প্রশ্ন';
                }
            }
        }

        // Interactive MCQ Option Evaluation
        function checkFlashcardAnswer(cardIdx, selectedIdx, correctIdx) {
            const cardWrap = document.getElementById('fcCardWrap-' + cardIdx);
            if (!cardWrap || cardWrap.getAttribute('data-answered') === 'true') return;
            
            cardWrap.setAttribute('data-answered', 'true');
            const optGroup = document.getElementById('fcOptionsGroup-' + cardIdx);
            const btns = optGroup ? optGroup.querySelectorAll('.fc-opt-btn') : [];
            const isCorrect = (selectedIdx === correctIdx);
            
            btns.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:bg-slate-100', 'dark:hover:bg-slate-700/80');
                const statusSpan = btn.querySelector('.fc-opt-status');
                
                if (idx === correctIdx) {
                    btn.classList.add('bg-emerald-500/15', 'border-emerald-500', 'text-emerald-800', 'dark:text-emerald-200', 'font-medium');
                    if (statusSpan) {
                        statusSpan.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400"></i>';
                        statusSpan.classList.remove('hidden');
                    }
                } else if (idx === selectedIdx && !isCorrect) {
                    btn.classList.add('bg-rose-500/15', 'border-rose-500', 'text-rose-800', 'dark:text-rose-200');
                    if (statusSpan) {
                        statusSpan.innerHTML = '<i class="fa-solid fa-circle-xmark text-rose-600 dark:text-rose-400"></i>';
                        statusSpan.classList.remove('hidden');
                    }
                } else {
                    btn.classList.add('opacity-45');
                }
            });

            const fb = document.getElementById('fcFeedback-' + cardIdx);
            const resMsg = document.getElementById('fcResultMsg-' + cardIdx);
            if (fb && resMsg) {
                if (isCorrect) {
                    resMsg.className = 'font-medium text-xs mb-1 text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5';
                    resMsg.innerHTML = '<i class="fa-solid fa-circle-check"></i> <span>সঠিক উত্তর! চমৎকার!</span>';
                } else {
                    resMsg.className = 'font-medium text-xs mb-1 text-rose-600 dark:text-rose-400 flex items-center gap-1.5';
                    const char = ['A', 'B', 'C', 'D'][correctIdx] || '';
                    resMsg.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> <span>ভুল উত্তর। সঠিক উত্তর: (${char})</span>`;
                }
                fb.classList.remove('hidden');
            }

            // Highlight next button
            const nextBtn = document.getElementById('fcNextBtn-' + cardIdx) || (cardWrap ? cardWrap.querySelector('.fc-next-btn') : null);
            if (nextBtn) {
                nextBtn.classList.add('ring-2', 'ring-indigo-400', 'ring-offset-1');
            }
        }

