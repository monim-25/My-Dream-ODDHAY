                                         <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                                             <div class="size-11 rounded-full bg-teal-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                                 <span class="material-symbols-rounded text-2xl leading-none">play_arrow</span>
                                             </div>
                                         </div>
                                     </a>

                                    <!-- RIGHT SIDE: Text Details & Resume Lesson Button -->
                                    <div class="flex-1 flex flex-col justify-start min-w-0 gap-2 sm:gap-2.5">
                                        <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-slate-100 leading-snug tracking-tight truncate antialiased" title="<%= lastLesson.lessonTitle %>"><%= formattedTitle %></h3>
                                        
                                        <!-- Short Description -->
                                        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-semibold line-clamp-2 leading-relaxed antialiased"><%= formattedDesc %></p>
                                        
                                        <!-- Stats with Sharp Text -->
                                        <div class="flex items-center gap-4 text-xs font-black text-slate-800 dark:text-slate-200 pt-0.5 antialiased">
                                            <span class="inline-flex items-center gap-1.5 leading-none" title="Views">
                                                <span class="material-symbols-rounded text-sm text-teal-700 dark:text-cyan-300 leading-none shrink-0 inline-flex items-center justify-center">visibility</span>
                                                <span class="leading-none text-slate-800 dark:text-slate-200 font-bold"><%= lastLesson.views || '1.2k' %></span>
                                            </span>
                                            <span class="inline-flex items-center gap-1.5 leading-none" title="Likes">
                                                <span class="material-symbols-rounded text-sm text-rose-500 leading-none shrink-0 inline-flex items-center justify-center">thumb_up</span>
                                                <span class="leading-none text-slate-800 dark:text-slate-200 font-bold"><%= lastLesson.likes || '245' %></span>
                                            </span>
                                            <span class="inline-flex items-center gap-1.5 leading-none" title="Comments">
                                                <span class="material-symbols-rounded text-sm text-emerald-600 dark:text-emerald-300 leading-none shrink-0 inline-flex items-center justify-center">chat_bubble</span>
                                                <span class="leading-none text-slate-800 dark:text-slate-200 font-bold"><%= lastLesson.commentsCount || '18' %></span>
                                            </span>
                                        </div>

                                        <!-- Course Name -->
                                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate inline-flex items-center gap-1.5 pt-0.5 leading-none antialiased">
                                            <span class="material-symbols-rounded text-amber-600 text-sm leading-none shrink-0 inline-flex items-center justify-center">auto_stories</span>
                                            <span class="truncate leading-none text-slate-800 dark:text-slate-200 font-bold"><%= lastLesson.course.title %></span>
                                        </p>

                                        <!-- Resume Lesson Button (Gray 500 Clean Text) -->
                                        <a href="/course-details/<%= lastLesson.course._id %>?lesson=<%= lastLesson.lessonId %>&time=<%= lastLesson.lastPosition || 0 %>&from=dashboard"
                                           class="mt-2 inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-extrabold text-xs sm:text-sm rounded-xl px-5 py-2.5 transition-all shrink-0 w-fit shadow-md hover:shadow-lg transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer antialiased">
                                            Resume Lesson
                                        </a>
                                    </div>
                                </div>
                            <% } else if (lastLesson && isWatchedFull) { %>
                                <!-- Fully Watched State: Short prompt to explore courses -->
                                <div class="flex items-center justify-between gap-4 w-full p-4 sm:p-5">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="size-10 shrink-0 rounded-xl bg-teal-800/15 dark:bg-teal-400/15 border border-teal-700/25 dark:border-teal-400/25 flex items-center justify-center text-teal-800 dark:text-teal-300">
                                            <span class="material-symbols-rounded text-xl leading-none">auto_stories</span>
                                        </div>
                                        <p class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 antialiased truncate">
                                            Ready for your next lesson? Explore courses to continue learning.
                                        </p>
                                    </div>
                                    <a href="/courses"
                                       class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-bold text-xs sm:text-sm rounded-xl px-4 py-2 transition-all shrink-0 shadow-sm hover:shadow">
                                        Explore Courses
                                    </a>
                                </div>
                            <% } else { %>
                                <!-- Empty state -->
                                <div class="flex items-center justify-between gap-4 w-full p-5 sm:p-6">
                                    <div class="flex items-center gap-3.5">
                                        <div class="size-11 shrink-0 rounded-xl bg-teal-800/20 border border-teal-700/30 flex items-center justify-center text-teal-900 shadow-sm">
                                            <span class="material-symbols-rounded text-2xl leading-none flex items-center justify-center">auto_stories</span>
                                        </div>
                                        <div class="flex flex-col justify-center min-w-0">
                                            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 leading-tight">No active lessons</h3>
                                            <p class="text-xs text-slate-600 dark:text-slate-300 font-medium mt-0.5">Pick a course today and start learning!</p>
                                        </div>
                                    </div>
                                    <a href="/courses" class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-extrabold text-xs sm:text-sm rounded-xl px-4.5 py-2.5 transition-all shrink-0 shadow-md">
                                        Browse Courses
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 2. Daily Goals & Unlimited Activity Widget (#DEFFF1 Color Theme, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] text-slate-800 dark:text-slate-200 rounded-none border-0 overflow-hidden flex flex-col my-0 transition-all">
                        <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-900/10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-teal-800 text-lg shrink-0 flex items-center justify-center -mt-0.5">task_alt</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Daily Goals</h2>
                            </div>
                            <span id="todayXpBadge" class="px-2.5 py-0.5 rounded text-[10px] font-extrabold bg-teal-800/15 text-teal-900 border border-teal-700/20 flex items-center gap-0.5">
                                <span class="material-symbols-rounded text-xs">bolt</span> +<%= locals.todayXpEarned || 0 %> XP Today
                            </span>
                        </div>

                        <div class="p-3.5 sm:p-4 space-y-3">
                            <!-- Unlimited Activities List -->
                            <div class="space-y-2 pt-0.5">
                                <% 
                                    const activitiesList = [
                                        { type: 'video', id: 'activity-count-video', title: 'ভিডিও লেসন ওয়াচ ট্র্যাকার', countText: `আজকে দেখা হয়েছে: ${locals.todayVideosCount || 0}টি ভিডিও`, xpText: '+30 XP প্রতি ভিডিও', icon: 'smart_display', actionUrl: '/courses', actionText: 'Watch Videos' },
                                        { type: 'quiz', id: 'activity-count-quiz', title: 'কুইজ ও মডেল টেস্ট ট্র্যাকার', countText: `আজকে দেওয়া হয়েছে: ${locals.todayQuizzesCount || 0}টি পরীক্ষা`, xpText: '+50 XP প্রতি কুইজ', icon: 'quiz', actionUrl: '/exams', actionText: 'Take Quizzes' },
                                        { type: 'note', id: 'activity-count-note', title: 'লেকচার নোটস ও প্রশ্ন ট্র্যাকার', countText: `আজকে পড়া হয়েছে: ${locals.todayNotesCount || 0}টি নোট/প্রশ্ন`, xpText: '+20 XP প্রতি নোট', icon: 'description', actionUrl: '/notes', actionText: 'Read Notes' }
                                    ];
                                    activitiesList.forEach(item => { 
                                %>
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between p-2.5 sm:p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 transition-all gap-2 group">
                                        <div class="flex items-center gap-2.5">
                                            <div class="size-7.5 rounded-lg bg-teal-700/15 border border-teal-700/30 flex items-center justify-center text-teal-900 dark:text-teal-300 shrink-0">
                                                <span class="material-symbols-rounded text-base flex items-center justify-center -mt-0.5"><%= item.icon %></span>
                                            </div>
                                            <div>
                                                <h3 class="text-xs font-semibold text-slate-700 dark:text-slate-300 antialiased"><%= item.title %></h3>
                                                <p id="<%= item.id %>" class="text-[9px] sm:text-[10px] text-slate-600 dark:text-slate-400 font-medium"><%= item.countText %></p>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-end gap-1.5 shrink-0">
                                            <span class="hidden sm:flex px-2 py-0.5 rounded-md text-[10px] font-bold text-amber-800 dark:text-amber-300 bg-amber-500/20 border border-amber-600/30 items-center gap-0.5">
                                                <span class="material-symbols-rounded text-xs">bolt</span> <%= item.xpText %>
                                            </span>
                                            <a href="<%= item.actionUrl %>" class="flex items-center justify-center gap-1 px-3 py-1.5 bg-teal-800 hover:bg-teal-900 text-white text-xs font-bold rounded-lg transition-colors min-w-[60px] sm:min-w-[84px]">
                                                <span><%= item.actionText %></span>
                                            </a>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>

                            <!-- Footer Motivation -->
                            <div class="pt-2 flex items-center justify-between text-xs sm:text-[13px] font-semibold text-slate-700 dark:text-slate-300 flex-wrap gap-2 leading-none">
                                <span class="inline-flex items-center gap-1.5 leading-none">
                                    <span class="material-symbols-rounded text-sm sm:text-base text-amber-600 shrink-0 flex items-center justify-center -mt-0.5 leading-none">local_fire_department</span>
                                    <span class="leading-none">আনলিমিটেড অ্যাক্টিভিটি ট্র্যাকার</span>
                                </span>
                                <span class="inline-flex items-center gap-1.5 leading-none">
                                    <span class="material-symbols-rounded text-sm sm:text-base text-amber-600 shrink-0 flex items-center justify-center -mt-0.5 leading-none">local_fire_department</span>
                                    <span class="leading-none">যত পড়ালেখা করবেন, তত অনবরত XP পয়েন্ট অর্জিত হবে!</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 3. Weekly XP Activity Chart (Luxury Midnight Indigo Background, Square Type) -->
                    <div class="w-full bg-gradient-to-br from-[#0F172A] via-[#161E36] to-[#0D1527] border-0 rounded-none shadow-none overflow-hidden flex flex-col my-0 transition-all relative">
                        <div class="flex items-center justify-between px-5 sm:px-6 py-3.5 border-b border-white/10">
                            <div class="flex items-center gap-2.5">
                                <div class="size-8 rounded-xl bg-indigo-500/20 flex items-center justify-center text-rose-400 shrink-0">
                                    <span class="material-symbols-rounded text-lg leading-none">show_chart</span>
                                </div>
                                <div>
                                    <h2 class="font-semibold text-sm sm:text-base text-white leading-tight antialiased">Weekly Activity</h2>
                                    <p class="text-[11px] text-indigo-200/80 font-medium">Momentum & XP Progress</p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-white/10 text-indigo-200 border border-white/10">
                                7 Days XP
                            </span>
                        </div>

                        <div class="px-3 sm:px-5 pt-3 pb-5 flex-1 flex flex-col justify-center">
                            <%
                                const weekLabels = locals.chartLabels || ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                                const weekData   = locals.chartData  || [0,0,0,0,0,0,0];
                                const wMax = Math.max(...weekData, 1);
                                const W = 500, H = 200, padL = 22, padR = 22, padT = 25, padB = 35;
                                const innerW = W - padL - padR;
                                const innerH = H - padT - padB;
                                const pts = weekData.map((v, i) => {
                                    const x = padL + (i / (weekLabels.length - 1)) * innerW;
                                    const y = padT + innerH - (v / wMax) * innerH;
                                    return { x, y, v, label: weekLabels[i] };
                                });

                                // Ultra smooth curved bezier path across 500px canvas
                                let pathD = `M ${pts[0].x} ${pts[0].y}`;
                                for (let i = 1; i < pts.length; i++) {
                                    const cp1x = (pts[i - 1].x + pts[i].x) / 2;
                                    const cp1y = pts[i - 1].y;
                                    const cp2x = (pts[i - 1].x + pts[i].x) / 2;
                                    const cp2y = pts[i].y;
                                    pathD += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${pts[i].x} ${pts[i].y}`;
                                }
                                const areaD = `${pathD} L ${pts[pts.length - 1].x} ${padT + innerH} L ${pts[0].x} ${padT + innerH} Z`;

                                // Colors for point node borders matching line gradient
                                const pointColors = [
                                    '#F43F5E', // Coral Pink
                                    '#FB7185', // Coral Pink
                                    '#A855F7', // Purple
                                    '#8B5CF6', // Purple
                                    '#6366F1', // Indigo / Blue-Purple
                                    '#0EA5E9', // Bright Light Blue
                                    '#38BDF8'  // Bright Light Blue
                                ];
                            %>
                            <div class="relative w-full flex-1">
                                <svg viewBox="0 0 500 200" class="w-full h-44 sm:h-52 overflow-visible" style="display:block;">
                                    <defs>
                                        <!-- Line Glow Filter -->
                                        <filter id="lineGlow" x="-20%" y="-20%" width="140%" height="140%">
                                            <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#8B5CF6" flood-opacity="0.45" />
                                        </filter>

                                        <!-- Continuous Line Gradient: Coral Pink -> Purple -> Bright Light Blue -->
                                        <linearGradient id="chartLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#F43F5E" />
                                            <stop offset="50%" stop-color="#8B5CF6" />
                                            <stop offset="100%" stop-color="#38BDF8" />
                                        </linearGradient>

                                        <!-- Soft Semi-Transparent Gradient Area Fill -->
                                        <linearGradient id="chartAreaGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#F43F5E" stop-opacity="0.32" />
                                            <stop offset="50%" stop-color="#8B5CF6" stop-opacity="0.28" />
                                            <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.32" />
                                        </linearGradient>
                                        
                                        <!-- Vertical Fade for Area Fill -->
                                        <linearGradient id="areaFade" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
                                        </linearGradient>

                                        <mask id="areaMask">
                                            <rect x="0" y="0" width="500" height="200" fill="url(#areaFade)" />
                                        </mask>
                                    </defs>

                                    <!-- Horizontal Grid Lines -->
                                    <% [0, 50, 100].forEach(pct => {
                                        const gy = padT + innerH - (pct / 100) * innerH;
                                    %>
                                        <line x1="<%= padL %>" y1="<%= gy %>" x2="<%= W - padR %>" y2="<%= gy %>"
                                              stroke="#ffffff" stroke-opacity="0.08" stroke-width="1" stroke-dasharray="4,4"/>
                                    <% }) %>

                                    <!-- Soft Semi-Transparent Gradient Area Fill -->
                                    <path d="<%= areaD %>" fill="url(#chartAreaGrad)" mask="url(#areaMask)" />

                                    <!-- Main Smooth Curved Line (Coral Pink -> Purple -> Bright Light Blue) -->
                                    <path d="<%= pathD %>" fill="none" stroke="url(#chartLineGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#lineGlow)"/>

                                    <!-- Interactive Data Points & Tooltips -->
                                    <% pts.forEach((p, i) => { 
                                        const pColor = pointColors[i] || '#8B5CF6';
                                    %>
                                        <g class="weekly-point-group" style="cursor:pointer;">
                                            <!-- Hover Trigger Zone -->
                                            <rect x="<%= p.x - (innerW / 12) %>" y="0" width="<%= innerW / 6 %>" height="200" fill="transparent" class="point-hover-strip" />
                                            
                                            <!-- Dotted Vertical Guide Line -->
                                            <line x1="<%= p.x %>" y1="<%= p.y %>" x2="<%= p.x %>" y2="<%= padT + innerH %>" stroke="#ffffff" stroke-opacity="0.25" opacity="0" class="guide-line transition-opacity" stroke-dasharray="2,2"/>
                                            
                                            <!-- Data Node: White Center + Border matching line gradient at point -->
                                            <circle cx="<%= p.x %>" cy="<%= p.y %>" r="6" fill="#FFFFFF" stroke="<%= pColor %>" stroke-width="3.5" class="point-dot transition-all duration-200 drop-shadow-md" />
                                            
                                            <!-- Tooltip -->
                                            <g class="weekly-tooltip" opacity="0" style="transition:all 0.2s">
                                                <rect x="<%= p.x - 28 %>" y="<%= p.y - 36 %>" width="56" height="25" rx="7" fill="#0f172a" class="shadow-xl"/>
                                                <polygon points="<%= p.x - 4 %>,<%= p.y - 11 %> <%= p.x + 4 %>,<%= p.y - 11 %> <%= p.x %>,<%= p.y - 6 %>" fill="#0f172a"/>
                                                <text x="<%= p.x %>" y="<%= p.y - 19 %>" text-anchor="middle"
                                                      font-size="11" font-weight="800" fill="#FFFFFF" font-family="sans-serif"><%= p.v %> XP</text>
                                            </g>
                                        </g>
                                    <% }) %>

                                    <!-- X-Axis Day Labels -->
                                    <% pts.forEach((p, i) => { %>
                                        <text x="<%= p.x %>" y="<%= H - 8 %>" text-anchor="middle"
                                              font-size="11" font-weight="700" fill="#cbd5e1" font-family="sans-serif">
                                            <%= p.label %>
                                        </text>
                                    <% }) %>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <style>
                        .weekly-point-group:hover .weekly-tooltip { opacity: 1 !important; transform: translateY(-2px); }
                        .weekly-point-group:hover .guide-line { opacity: 1 !important; }
                        .weekly-point-group:hover .point-dot { r: 8 !important; stroke-width: 4 !important; filter: brightness(1.2); }
                    </style>

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 4. Leaderboard (#DEFFF1 Background, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] border-0 rounded-none shadow-none overflow-hidden flex flex-col my-0 transition-all">
                        <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-[#b2edd3]/60 dark:border-emerald-900/40">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-[#F43F5E] text-lg shrink-0 flex items-center justify-center -mt-0.5">military_tech</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Leaderboard</h2>
                            </div>
                            <span class="text-[11px] font-bold text-slate-600 dark:text-slate-300"><%= (locals.leaderboard && leaderboard[0]) ? (leaderboard[0].classLevel || user.classLevel || '') : '' %> · XP Rankings</span>
                        </div>
                        <div class="p-3.5 sm:p-4 flex-1 flex flex-col gap-2.5">
                            <div class="rounded-xl overflow-hidden w-full divide-y divide-emerald-600/15 dark:divide-slate-800/60">
                                <% if (locals.leaderboard && leaderboard.length > 0) { %>
                                    <% leaderboard.slice(0, 10).forEach((entry, index) => { 
                                        const isMe = user && entry._id && entry._id.toString() === user._id.toString();
                                    %>
                                        <div class="flex items-center gap-2.5 px-3 py-2 hover:bg-white/60 dark:hover:bg-slate-800/40 transition-colors w-full <%= isMe ? 'bg-white dark:bg-emerald-900/30' : '' %>">
                                            <div class="size-5.5 rounded-full flex items-center justify-center font-bold text-xs shrink-0 <%= index === 0 ? 'bg-amber-100 text-amber-600 border border-amber-300' : index === 1 ? 'bg-slate-200 text-slate-600' : index === 2 ? 'bg-orange-100 text-orange-600' : 'bg-white/80 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">
                                                <%= index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : index + 1 %>
                                            </div>
                                            <div class="size-5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-[9px] shrink-0 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                                                <% if (entry.profileImage) { %>
                                                    <img src="<%= entry.profileImage %>" class="size-full object-cover">
                                                <% } else { %>
                                                    <%= entry.name ? entry.name[0].toUpperCase() : 'S' %>
                                                <% } %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate <%= isMe ? 'text-[#F43F5E]' : '' %>">
                                                    <%= entry.name %><% if (isMe) { %> <span class="text-[9px] font-black text-[#F43F5E] bg-rose-50 dark:bg-rose-900/20 px-1.5 py-0.5 rounded-full ml-1">You</span><% } %>
                                                </p>
                                                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold"><%= entry.classLevel || '' %></p>
                                            </div>
                                            <div class="text-right shrink-0">
                                                <p class="font-bold text-xs text-[#F43F5E]"><%= (entry.totalXP || 0) %> XP</p>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center text-center py-5 gap-1.5">
                                        <span class="material-symbols-rounded text-2xl text-slate-400">leaderboard</span>
                                        <p class="text-xs font-bold text-slate-500">No students found yet</p>
                                    </div>
                                <% } %>
                            </div>
                            <a href="/leaderboard" class="w-full py-2 px-4 text-center text-xs font-bold text-[#F43F5E] hover:text-rose-600 bg-white/80 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 rounded-xl border border-[#b2edd3] dark:border-slate-700 transition-all flex items-center justify-center gap-1.5 shadow-xs group">
                                <span>See Full Leaderboard</span>
                                <span class="material-symbols-rounded text-lg leading-none shrink-0 flex items-center justify-center -mt-0.5 transition-transform group-hover:translate-y-0.5">expand_more</span>
                            </a>
                        </div>
                    </div>

                </div><!-- /LEFT COLUMN -->

                <!-- RIGHT COLUMN: Weak Area Radar & Bookmarks -->
                <div class="lg:col-span-2 flex flex-col gap-3.5 sm:gap-4">

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 1. Weak Area Radar & Smart Revision Reminder Widget (#DEFFF1 Color Theme, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] text-slate-800 dark:text-slate-200 rounded-none border-0 overflow-hidden flex flex-col my-0 transition-all shadow-none">
                        <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-900/10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-rose-600 text-lg shrink-0 flex items-center justify-center select-none leading-none font-normal">radar</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Weak Area Radar</h2>
                            </div>
                            <% 
                                const focusCount = (locals.weakAreas && weakAreas.weakTopics && weakAreas.moderateTopics) 
                                    ? (weakAreas.weakTopics.length + weakAreas.moderateTopics.length) 
                                    : 0;
                                const hasRadarData = Boolean(locals.weakAreas && weakAreas.hasData);
                                const isMastered = hasRadarData && (weakAreas.overallAccuracy >= 70);
                            %>
                            <span id="weakAreaFocusBadge" class="px-2.5 py-1 rounded-md text-[10px] font-extrabold <%= focusCount > 0 ? 'bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30' : (hasRadarData && !isMastered ? 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30' : 'bg-teal-800/15 text-teal-900 dark:text-teal-300 border border-teal-700/20') %> inline-flex items-center justify-center gap-1.5 leading-none select-none">
                                <span class="material-symbols-rounded text-xs leading-none shrink-0 flex items-center justify-center select-none font-normal"><%= focusCount > 0 ? 'crisis_alert' : (hasRadarData && !isMastered ? 'trending_up' : 'verified') %></span>
                                <span class="leading-none select-none"><%= focusCount > 0 ? `${focusCount} Focus Areas` : (hasRadarData && !isMastered ? 'Needs Practice' : 'Optimal') %></span>
                            </span>
                        </div>

                        <div id="weakAreaRadarBody" class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                            <% if (locals.weakAreas && weakAreas.hasData && focusCount > 0) { %>
                                <!-- Top Mini Stats Row -->
                                <div class="grid grid-cols-3 gap-1.5 mb-3 text-center">
                                    <div class="p-1.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                                        <p class="text-[9px] text-slate-500 dark:text-slate-400 font-medium">Analyzed</p>
                                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= weakAreas.totalAnalyzed %> Qs</p>
                                    </div>
                                    <div class="p-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200/60 dark:border-rose-900/40">
                                        <p class="text-[9px] text-rose-600 dark:text-rose-400 font-medium">Mistakes</p>
                                        <p class="text-xs font-bold text-rose-700 dark:text-rose-300"><%= weakAreas.totalMistakes %></p>
                                    </div>
                                    <div class="p-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-900/40">
                                        <p class="text-[9px] text-emerald-600 dark:text-emerald-400 font-medium">Accuracy</p>
                                        <p class="text-xs font-bold text-emerald-700 dark:text-emerald-300"><%= weakAreas.overallAccuracy %>%</p>
                                    </div>
                                </div>

                                <!-- Weak Topics List -->
                                <div id="weakTopicsListContainer" class="space-y-2.5">
                                    <% 
                                        const displayTopics = [...weakAreas.weakTopics, ...weakAreas.moderateTopics].slice(0, 5);
                                        displayTopics.forEach((t, tIdx) => { 
                                             const isCrit = t.status === 'critical';
                                    %>
                                        <div data-topic="<%= t.topic.replace(/"/g, '&quot;') %>" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border <%= isCrit ? 'border-rose-300/80 dark:border-rose-800/60' : 'border-amber-300/80 dark:border-amber-800/60' %> transition-all shadow-2xs">
                                            <div class="flex items-start justify-between gap-1.5">
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-1.5 flex-wrap">
                                                        <span class="text-[9px] font-extrabold uppercase tracking-wide px-1.5 py-0.2 rounded <%= isCrit ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 border border-rose-200' : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border border-amber-200' %>">
                                                             <%= t.subject %>
                                                        </span>
                                                        <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">
                                                            Score: <%= (t.marksObtained !== undefined ? t.marksObtained : 0) %>/<%= (t.maxMarks !== undefined ? t.maxMarks : t.total) %> · <%= t.wrong > 0 ? ('Wrong: ' + t.wrong) : '' %><%= (t.wrong > 0 && t.skipped > 0) ? ', ' : '' %><%= t.skipped > 0 ? ('Skipped: ' + t.skipped) : '' %><% if (t.wrong === 0 && t.skipped === 0) { %>Correct: <%= t.correct %><% } %>
                                                        </span>
                                                    </div>
                                                    <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100 mt-1 truncate" title="<%= t.topic %>">
                                                        <%= t.topic %>
                                                    </h4>
                                                </div>
                                                <span class="text-[10px] font-black shrink-0 <%= isCrit ? 'text-rose-600 dark:text-rose-400' : 'text-amber-600 dark:text-amber-400' %>">
                                                    <%= t.accuracy %>%
                                                </span>
                                            </div>

                                            <!-- Mini Accuracy Progress Bar -->
                                            <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden mt-1.5">
                                                <div class="h-full rounded-full <%= isCrit ? 'bg-rose-500' : 'bg-amber-500' %>" style="width: <%= Math.min(100, Math.max(0, t.accuracy || 0)) %>%"></div>
                                            </div>

                                            <!-- Actions: Watch Lesson/Practice + Set Reminder -->
                                            <div class="flex items-center justify-between gap-1.5 mt-2 pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                                                <a href="<%= t.revisionLink %>" class="inline-flex items-center gap-1 text-[11px] font-bold text-teal-800 dark:text-teal-300 hover:text-teal-950 transition-colors">
                                                    <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal"><%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'play_circle' : 'quiz' %></span>
                                                    <span><%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'Revision Class' : 'Practice' %></span>
                                                </a>
                                                <button onclick="openReminderTimerModal('<%= t.topic %>', '<%= t.subject %>', '<%= t.revisionLink %>', this)" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-500/15 hover:bg-amber-500/25 text-amber-800 dark:text-amber-300 border border-amber-500/30 transition-colors cursor-pointer" title="Schedule revision reminder">
                                                    <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal">alarm_on</span>
                                                    <span>Reminder</span>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else if (locals.weakAreas && weakAreas.hasData) { %>
                                <% if (weakAreas.overallAccuracy < 70) { %>
                                    <!-- Needs More Practice State -->
                                    <div class="text-center py-5 my-auto flex flex-col items-center gap-2">
                                        <div class="size-11 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center shadow-xs">
                                            <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none font-normal">trending_up</span>
                                        </div>
                                        <div>
                                            <h4 class="text-xs font-black text-slate-800 dark:text-slate-100">Keep Practicing!</h4>
                                            <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[230px] mx-auto">Your recent accuracy is <%= weakAreas.overallAccuracy %>%. Consistent practice will help you improve.</p>
                                        </div>
                                        <a href="/exams" class="mt-1 inline-flex items-center gap-1 px-3 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition-colors shadow-xs">
                                            <span>Start Practice Exam</span>
                                            <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal">arrow_forward</span>
                                        </a>
                                    </div>
                                <% } else { %>
                                    <!-- Excellent Mastery State -->
                                    <div class="text-center py-5 my-auto flex flex-col items-center gap-2">
                                        <div class="size-11 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shadow-xs">
                                            <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none font-normal">verified</span>
                                        </div>
                                        <div>
                                            <h4 class="text-xs font-black text-slate-800 dark:text-slate-100">Excellent Mastery!</h4>
                                            <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[220px] mx-auto">No weak topics identified. Your recent accuracy is <%= weakAreas.overallAccuracy %>%, keep it up!</p>
                                        </div>
                                        <a href="/exams" class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-teal-800 dark:text-teal-300 hover:underline">
                                            <span>Take Model Test</span>
                                            <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal">arrow_forward</span>
                                        </a>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <!-- Onboarding State -->
                                <div class="text-center py-5 my-auto flex flex-col items-center gap-2">
                                    <div class="size-11 rounded-full bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shadow-xs">
                                        <span class="material-symbols-rounded text-2xl">insights</span>
                                    </div>
                                    <div>
                                        <h4 class="text-xs font-black text-slate-800 dark:text-slate-100">Smart Revision Radar</h4>
                                        <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[220px] mx-auto">Take exams to automatically track weak topics and receive revision suggestions.</p>
                                    </div>
                                    <a href="/exams" class="mt-1 inline-flex items-center gap-1 px-3 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition-colors">
                                        <span>Start Practice Exam</span>
                                        <span class="material-symbols-rounded text-xs">arrow_forward</span>
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 2. Bookmarks Widget (#DEFFF1 Color Theme, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] text-slate-800 dark:text-slate-200 rounded-none border-0 overflow-hidden flex flex-col my-0 transition-all">
                        <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-900/10 dark:border-slate-800/40">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-teal-800 dark:text-teal-400 text-lg shrink-0 flex items-center justify-center -mt-0.5">bookmark</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Bookmarks</h2>
                            </div>
                            <span class="text-[11px] font-extrabold text-teal-900 dark:text-teal-300" id="bookmarkCountBadge"><%= (locals.savedBookmarks || []).length %> Items</span>
                        </div>
                        
                        <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                            <div class="space-y-2" id="bookmarkListContainer">
                                <% if (locals.savedBookmarks && savedBookmarks.length > 0) { %>
                                    <% savedBookmarks.forEach(bm => { 
                                        const isNote = bm.itemType === 'note' || (bm.link && (bm.link.includes('note') || bm.link.includes('/note-viewer/')));
                                        const isBook = bm.itemType === 'book' || (bm.link && (bm.link.includes('library') || bm.link.includes('.pdf') || bm.link.includes('book')));
                                    %>
                                        <% 
                                            const linkStr = (bm.link || '').toLowerCase();
                                            const isDirectDoc = linkStr.endsWith('.pdf') || linkStr.endsWith('.jpg') || linkStr.endsWith('.jpeg') || linkStr.endsWith('.png');
                                        %>
                                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 backdrop-blur-xs group transition-all shadow-2xs" id="bm-item-<%= bm._id %>">
                                            <% if (isDirectDoc) { %>
                                                <div onclick="openMediaViewer('<%= bm.link.replace(/'/g, "\\'") %>', '<%= bm.title.replace(/'/g, "\\'") %>')" class="flex items-center gap-2 min-w-0 flex-1 cursor-pointer">
                                            <% } else { %>
                                                <a href="<%= bm.link %>" class="flex items-center gap-2 min-w-0 flex-1">
                                            <% } %>
                                                <span class="material-symbols-rounded text-sm <%= isNote ? 'text-amber-700 dark:text-amber-400' : (isBook ? 'text-emerald-700 dark:text-emerald-400' : 'text-sky-700 dark:text-sky-400') %> shrink-0 flex items-center justify-center -mt-0.5"><%= isNote ? 'description' : (isBook ? 'menu_book' : 'bookmark') %></span>
                                                <span class="text-xs font-extrabold text-slate-800 dark:text-slate-200 truncate group-hover:text-teal-900 dark:group-hover:text-teal-300 transition-colors"><%= bm.title %></span>
                                                <% if (isNote) { %>
                                                    <span class="text-[9px] font-black text-amber-900 dark:text-amber-300 bg-amber-500/25 border border-amber-600/30 px-1.5 py-0.2 rounded shrink-0 ml-auto mr-1">Note</span>
                                                <% } else if (isBook) { %>
                                                    <span class="text-[9px] font-black text-emerald-900 dark:text-emerald-300 bg-emerald-500/25 border border-emerald-600/30 px-1.5 py-0.2 rounded shrink-0 ml-auto mr-1">Book</span>
                                                <% } else { %>
                                                    <span class="text-[9px] font-black text-teal-900 dark:text-teal-300 bg-teal-500/25 border border-teal-600/30 px-1.5 py-0.2 rounded shrink-0 ml-auto mr-1">Saved</span>
                                                <% } %>
                                            <% if (isDirectDoc) { %>
                                                </div>
                                            <% } else { %>
                                                </a>
                                            <% } %>
                                            <button onclick="removeBookmark('<%= bm._id %>')" class="p-1 text-slate-500 hover:text-rose-600 rounded transition-colors shrink-0" title="Remove">
                                                <span class="material-symbols-rounded text-sm shrink-0 flex items-center justify-center -mt-0.5">delete</span>
                                            </button>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="text-center py-4 my-auto">
                                        <p class="text-xs text-slate-600 dark:text-slate-400 font-extrabold">No saved notes or library books yet</p>
                                        <div class="mt-2 flex items-center justify-center gap-3">
                                            <a href="/notes" class="text-xs font-black text-teal-900 dark:text-teal-400 hover:underline">Notes →</a>
                                            <span class="text-slate-400">•</span>
                                            <a href="/library" class="text-xs font-black text-teal-900 dark:text-teal-400 hover:underline">Library →</a>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                </div><!-- /RIGHT COLUMN -->

            </div><!-- /Two-column grid -->
            </div><!-- /Main Dashboard Content Container -->


        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'dashboard' }) %>
    <%- include('partials/app-scripts') %>
    <script>
        function attendNotice(noticeId) {
            if (!noticeId) return;
            try {
                fetch('/api/attend-notice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ noticeId }),
                    keepalive: true
                }).catch(err => {});
            } catch (e) {}
        }

        function toggleDailyGoal(goalId, btn) {
            fetch('/api/toggle-daily-goal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ goalId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    window.location.reload();
                }
            }).catch(e => console.error(e));
        }

        function refreshDailyStats() {
            fetch('/api/daily-stats')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const badge = document.getElementById('todayXpBadge');
                        if (badge) badge.innerHTML = `<span class="material-symbols-rounded text-xs">bolt</span> +${data.todayXpEarned} XP Today`;
                        
                        const text = document.getElementById('todayXpText');
                        if (text) text.innerText = `+${data.todayXpEarned} XP Earned Today`;

                        const xpTextPill = document.getElementById('today-xp-text');
                        if (xpTextPill) xpTextPill.innerText = `${data.todayXpEarned} XP`;
                        
                        const bar = document.getElementById('todayXpBar');
                        if (bar) {
                            const pct = Math.min(100, Math.round((data.todayXpEarned / 100) * 100));
                            bar.style.width = pct + '%';
                        }
                        
                        const v = document.getElementById('activity-count-video');
                        if (v) v.innerText = `আজকে দেখা হয়েছে: ${data.todayVideosCount}টি ভিডিও`;
                        const vPill = document.getElementById('today-videos-count-text');
                        if (vPill) vPill.innerText = `${data.todayVideosCount} Class`;
                        
                        const q = document.getElementById('activity-count-quiz');
                        if (q) q.innerText = `আজকে দেওয়া হয়েছে: ${data.todayQuizzesCount}টি পরীক্ষা`;
                        const qPill = document.getElementById('today-quizzes-count-text');
                        if (qPill) qPill.innerText = `${data.todayQuizzesCount} Solved`;
                        
                        const n = document.getElementById('activity-count-note');
                        if (n) n.innerText = `আজকে পড়া হয়েছে: ${data.todayNotesCount}টি নোট/প্রশ্ন`;
                        const nPill = document.getElementById('today-notes-count-text');
                        if (nPill) nPill.innerText = `${(data.todayNotesCount + (data.todaySavedNotesCount || 0))} Saved/Viewed`;

                        const timePill = document.getElementById('today-active-time-text');
                        if (timePill) timePill.innerText = `${data.todayActiveMinutes || 0}m`;
                    }
                })
                .catch(e => {});
        }

        function trackActivity(type) {
            fetch('/api/track-activity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        function removeBookmark(bookmarkId) {
            fetch('/api/remove-bookmark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookmarkId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    const el = document.getElementById('bm-item-' + bookmarkId);
                    if (el) el.remove();
                    
                    const badge = document.getElementById('bookmarkCountBadge');
                    const remaining = document.querySelectorAll('#bookmarkListContainer > div[id^="bm-item-"]').length;
                    if (badge) {
                        badge.textContent = `${remaining} Items`;
                    }
                    if (remaining === 0) {
                        const container = document.getElementById('bookmarkListContainer');
                        if (container) {
                            container.innerHTML = `
                                <div class="text-center py-4 my-auto">
                                    <p class="text-xs text-slate-600 dark:text-slate-400 font-extrabold">No saved notes or library books yet</p>
                                    <div class="mt-2 flex items-center justify-center gap-3">
                                        <a href="/notes" class="text-xs font-black text-teal-900 dark:text-teal-400 hover:underline">Notes →</a>
                                        <span class="text-slate-400">•</span>
                                        <a href="/library" class="text-xs font-black text-teal-900 dark:text-teal-400 hover:underline">Library →</a>
                                    </div>
                                </div>
                            `;
                        }
                    }
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        // Active Site Time Heartbeat Ping (Pings /api/active-heartbeat every 60 seconds when user is active)
        let isTabActive = true;
        window.addEventListener('focus', () => { isTabActive = true; refreshDailyStats(); });
        window.addEventListener('blur', () => { isTabActive = false; });

        setInterval(() => {
            if (isTabActive && !document.hidden) {
                fetch('/api/active-heartbeat', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            refreshDailyStats();
                        }
                    })
                    .catch(e => {});
            }
        }, 60000);

        function openReminderTimerModal(topic, subject, link, btn) {
            if (!window.Swal) {
                setRevisionReminder(topic, subject, link, 60, btn);
                return;
            }

            // Calculate minutes until 9:00 AM tomorrow
            const now = new Date();
            const morning = new Date();
            morning.setDate(morning.getDate() + 1);
            morning.setHours(9, 0, 0, 0);
            const morningMins = Math.max(1, Math.round((morning - now) / 60000));

            const htmlContent = `
                <div class="text-left font-sans text-xs space-y-3 pt-1">
                    <p class="text-slate-600 dark:text-slate-300 text-xs">
                        <strong>"${topic}"</strong> (${subject}) অধ্যায়টি পুনরায় রিভিশন দিতে কখন রিমাইন্ডার পেতে চান?
                    </p>
                    <div class="grid grid-cols-1 gap-2 text-slate-700 dark:text-slate-200">
                        <!-- Option: Custom Minutes (Recommended) -->
                        <label id="labelCustomTime" class="flex flex-col gap-2 p-2.5 rounded-xl border border-teal-300 dark:border-teal-700 bg-teal-50/60 dark:bg-teal-950/40 hover:bg-teal-50 dark:hover:bg-teal-950/60 cursor-pointer transition-all">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="reminderTime" value="custom" id="radioCustomTime" checked class="text-teal-600 focus:ring-teal-500 shrink-0">
                                <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                    <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                        <span class="material-symbols-rounded text-base text-teal-600 dark:text-teal-400 leading-none shrink-0 inline-flex items-center justify-center select-none">edit_calendar</span>
                                        <span class="truncate">নিজের মতো মিনিট নির্ধারণ করুন (প্রস্তাবিত)</span>
                                    </span>
                                    <span class="text-[10px] text-teal-700 dark:text-teal-300 font-bold px-2 py-0.5 rounded-md bg-teal-100/80 dark:bg-teal-900/60 shrink-0">প্রস্তাবিত</span>
                                </div>
                            </div>
                            <div id="customTimeBox" class="mt-1 pl-7">
                                <input type="number" id="customMinutesInput" min="1" max="10080" placeholder="কত মিনিট পর? (যেমন: ২০, ৪৫ বা ৬০)" class="w-full text-xs px-3 py-2 rounded-lg border border-teal-300 dark:border-teal-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 outline-none">
                            </div>
                        </label>

                        <!-- Option: 30 Minutes -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="30" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">hourglass_top</span>
                                    <span class="truncate">৩০ মিনিট পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৩০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 1 Hour -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="60" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-blue-500 dark:text-blue-400 leading-none shrink-0 inline-flex items-center justify-center select-none">schedule</span>
                                    <span class="truncate">১ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৬০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 2 Hours -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="120" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-indigo-500 dark:text-indigo-400 leading-none shrink-0 inline-flex items-center justify-center select-none">alarm</span>
                                    <span class="truncate">২ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">১২০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: Tomorrow Morning -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="${morningMins}" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">wb_sunny</span>
                                    <span class="truncate">আগামীকাল সকালে (সকাল ৯:০০)</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">সকাল ৯:০০</span>
                            </div>
                        </label>
                    </div>
                </div>
            `;

            Swal.fire({
                title: '<div class="flex items-center justify-center gap-2 text-base font-black"><span class="material-symbols-rounded text-teal-600 text-xl leading-none shrink-0 inline-flex items-center justify-center">alarm_on</span> রিভিশন রিমাইন্ডার শিডিউল</div>',
                html: htmlContent,
                showCancelButton: true,
                confirmButtonText: 'রিমাইন্ডার নিশ্চিত করুন',
                cancelButtonText: 'বাতিল',
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#94a3b8',
                customClass: {
                    popup: 'rounded-2xl dark:bg-slate-900 dark:text-slate-100',
                    confirmButton: 'rounded-xl text-xs font-bold px-4 py-2',
                    cancelButton: 'rounded-xl text-xs font-bold px-4 py-2'
                },
                didOpen: () => {
                    const radioButtons = document.querySelectorAll('input[name="reminderTime"]');
                    const customBox = document.getElementById('customTimeBox');
                    const customInput = document.getElementById('customMinutesInput');
                    const labelCustom = document.getElementById('labelCustomTime');

                    if (customInput) {
                        setTimeout(() => customInput.focus(), 150);
                    }

                    radioButtons.forEach(rb => {
                        rb.addEventListener('change', () => {
                            if (rb.value === 'custom') {
                                customBox.classList.remove('hidden');
                                labelCustom.classList.add('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                                customInput.focus();
                            } else {
                                customBox.classList.add('hidden');
                                labelCustom.classList.remove('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                            }
                        });
                    });
                },
                preConfirm: () => {
                    const selected = document.querySelector('input[name="reminderTime"]:checked');
                    if (!selected) {
                        Swal.showValidationMessage('দয়া করে একটি সময় নির্বাচন করুন');
                        return false;
                    }
                    if (selected.value === 'custom') {
                        const customVal = parseInt(document.getElementById('customMinutesInput').value, 10);
                        if (isNaN(customVal) || customVal < 1) {
                            Swal.showValidationMessage('দয়া করে সঠিক মিনিট (কমপক্ষে ১ মিনিট) লিখুন');
                            return false;
                        }
                        return customVal;
                    }
                    return parseInt(selected.value, 10);
                }
            }).then(result => {
                if (result.isConfirmed && typeof result.value === 'number') {
                    setRevisionReminder(topic, subject, link, result.value, btn);
                }
            });
        }

        async function setRevisionReminder(topic, subject, link, delayMinutes = 30, btn = null) {
            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs animate-spin shrink-0 inline-flex items-center justify-center leading-none">sync</span><span>সেট হচ্ছে...</span>';
                }
                const res = await fetch('/api/student/set-revision-reminder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topic, subject, link, delayMinutes })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'success',
                            title: 'রিভিশন রিমাইন্ডার সেট হয়েছে!',
                            text: data.message || `"${topic}" অধ্যায়ের জন্য রিমাইন্ডার সেট করা হয়েছে।`,
                            timer: 3500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        alert(data.message || `"${topic}"-এর জন্য রিমাইন্ডার সেট হয়েছে!`);
                    }
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-rounded text-xs text-emerald-500 shrink-0 inline-flex items-center justify-center leading-none">check</span><span>রিমাইন্ডার সেট</span>';
                        btn.classList.remove('bg-amber-500/15', 'text-amber-800', 'dark:text-amber-300');
                        btn.classList.add('bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-300');

                        const card = btn.closest('[data-topic]');
                        if (card) {
                            setTimeout(() => {
                                card.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(-8px) scale(0.96)';
                                card.style.maxHeight = card.offsetHeight + 'px';
                                requestAnimationFrame(() => {
                                    card.style.maxHeight = '0px';
                                    card.style.paddingTop = '0px';
                                    card.style.paddingBottom = '0px';
                                    card.style.marginTop = '0px';
                                    card.style.marginBottom = '0px';
                                    card.style.borderWidth = '0px';
                                    card.style.overflow = 'hidden';
                                });
                                setTimeout(() => {
                                    card.remove();

                                    // Update remaining topics and badge
                                    const container = document.getElementById('weakTopicsListContainer');
                                    const remainingCards = container ? container.querySelectorAll('[data-topic]').length : 0;

                                    const badge = document.getElementById('weakAreaFocusBadge');
                                    if (badge) {
                                        if (remainingCards > 0) {
                                            badge.className = 'px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                                            badge.innerHTML = `<span class="material-symbols-rounded text-xs leading-none shrink-0 flex items-center justify-center select-none font-normal">crisis_alert</span> <span class="leading-none select-none">${remainingCards} Focus Areas</span>`;
                                        } else {
                                            badge.className = 'px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                                            badge.innerHTML = '<span class="material-symbols-rounded text-xs leading-none shrink-0 flex items-center justify-center select-none font-normal">alarm_on</span> <span class="leading-none select-none">Reminded</span>';
                                        }
                                    }

                                    if (remainingCards === 0) {
                                        const body = document.getElementById('weakAreaRadarBody');
                                        if (body) {
                                            body.innerHTML = `
                                                <div class="text-center py-5 my-auto flex flex-col items-center gap-2">
                                                    <div class="size-11 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center shadow-xs">
                                                        <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none font-normal">alarm_on</span>
                                                    </div>
                                                    <div>
                                                        <h4 class="text-xs font-black text-slate-800 dark:text-slate-100">Keep Practicing!</h4>
                                                        <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[220px] mx-auto">Reminders have been set for your topics. Continue practicing more exams and quizzes to master your subjects!</p>
                                                    </div>
                                                    <a href="/exams" class="mt-1 inline-flex items-center gap-1 px-3 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition-colors shadow-xs">
                                                        <span>Start Practice Exam</span>
                                                        <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal">arrow_forward</span>
                                                    </a>
                                                </div>
                                            `;
                                        }
                                    }
                                }, 400);
                            }, 500);
                        }
                    }
                } else {
                    throw new Error(data.error || 'Failed to set reminder');
                }
            } catch (err) {
                console.error('Reminder error:', err);
                if (window.Swal) {
                    Swal.fire({
                        icon: 'error',
                        title: 'রিমাইন্ডার সেট করা যায়নি',
                        text: err.message,
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                } else {
                    alert('রিমাইন্ডার সেট করা যায়নি: ' + err.message);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs shrink-0 inline-flex items-center justify-center leading-none">alarm_on</span><span>রিমাইন্ডার</span>';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', refreshDailyStats);
    </script>
</body>
</html>