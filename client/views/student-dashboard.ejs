                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">স্মার্ট রিভিশন ট্র্যাকার</p>
                                    </div>
                                </div>
                                <% 
                                    const allRadarTopics = (locals.weakAreas && weakAreas.hasData) 
                                        ? [...(weakAreas.weakTopics || []), ...(weakAreas.moderateTopics || [])]
                                        : [];
                                    const fallbackTopics = (locals.weakAreas && weakAreas.hasData && allRadarTopics.length === 0)
                                        ? (weakAreas.strongTopics || [])
                                        : [];
                                    const displayTopicsList = [...allRadarTopics, ...fallbackTopics];
                                    const focusCount = displayTopicsList.length;
                                    const hasRadarData = Boolean(locals.weakAreas && weakAreas.hasData && (focusCount > 0 || weakAreas.totalAnalyzed > 0));
