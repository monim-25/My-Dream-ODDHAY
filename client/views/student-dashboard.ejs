                            <span id="todayXpBadge" class="px-2.5 py-0.5 rounded text-[10px] font-extrabold bg-teal-800/15 text-teal-900 border border-teal-700/20 flex items-center gap-0.5">
                                <span class="material-symbols-rounded text-xs">bolt</span> +<%= locals.todayXpEarned || 0 %> XP Today
