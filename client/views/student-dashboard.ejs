                </div>
            </div>
            <style>
                .ai-animated-orb { animation: aiFloat 4s ease-in-out infinite; }
                .ai-spin-cw { animation: aiSpinCW 16s linear infinite; }
                .ai-spin-ccw { animation: aiSpinCCW 10s linear infinite; }
                .ai-pulse-core { animation: aiPulseCore 3s ease-in-out infinite; }
                @keyframes aiFloat {
                    0%, 100% { transform: translateY(0px) scale(1); }
                    50% { transform: translateY(-8px) scale(1.04); }
                }
                @keyframes aiSpinCW { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                @keyframes aiSpinCCW { 0% { transform: rotate(360deg); } 100% { transform: rotate(-360deg); } }
                @keyframes aiPulseCore { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.12); opacity: 1; filter: drop-shadow(0 0 10px #38BDF8); } }
            </style>

            <!-- Physical Distinct Gap Divider between 1st Section and Lower Content Grid -->
            <div class="w-full h-3.5 sm:h-5 bg-[#FFFFFF] dark:bg-[#0b1120]"></div>

            <!-- Main Dashboard Content Container (Attached to Borders & Divided by Thin Lines) -->
            <div class="w-full p-0 m-0 pb-6 border-b border-slate-300 dark:border-slate-800">
                <!-- Two-column layout: Left content + Right panel -->
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-3.5 sm:gap-4 w-full">

                <!-- LEFT COLUMN: Keep Learning -> Daily Goals -> Weekly Activity -> Leaderboard -->
                <div class="lg:col-span-3 flex flex-col gap-3.5 sm:gap-4 lg:pr-3.5 lg:border-r border-slate-200/80 dark:border-slate-800/80">

                    <!-- Thin Section Divider Line (Attached Flush to Section) -->
                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 1. Keep Learning / Continue Watching Section (#DEFFF1 Background, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] text-slate-800 dark:text-slate-200 rounded-none border-0 shadow-none overflow-hidden my-0 relative group">
                        <!-- Section Header (Enlarged Header & Top Aligned) -->
                        <div class="relative z-10 flex items-center justify-between px-4 sm:px-6 pt-3 pb-0.5 border-b border-slate-900/10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-rose-500 text-xl sm:text-2xl shrink-0 flex items-center justify-center -mt-0.5">play_circle</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Keep Learning</h2>
                            </div>
                        </div>

                        <!-- Content Area (Comfortable Gap below Header) -->
                        <div class="relative z-10 w-full">
                            <% 
                                const lastLesson = (locals.user && user.lastWatchedLesson && user.lastWatchedLesson.course) ? user.lastWatchedLesson : null;
                                const dur = Number(lastLesson && lastLesson.duration) || 0;
                                const pos = Number(lastLesson && lastLesson.lastPosition) || 0;
                                
                                // Proper full completion detection:
                                // 1. Watched >= 92% or (for long videos >= 5 mins) remaining <= 25 seconds
                                const isProgressFull = Boolean(dur > 0 && pos > 0 && ((pos / dur >= 0.92) || (dur >= 300 && dur - pos <= 25)));
                                // 2. Actively in progress: has watched some seconds (> 0) but not reached near completion threshold
                                const isActivelyInProgress = Boolean(pos > 0 && !isProgressFull && (pos < 60 || (dur > 0 && pos / dur < 0.92)));
                                // 3. Fully completed IF AND ONLY IF it is NOT actively in progress AND (isProgressFull OR explicitly marked complete)
                                const isWatchedFull = Boolean(!isActivelyInProgress && (isProgressFull || (lastLesson && lastLesson.isCompleted === true)));
                            %>
                            <% if (lastLesson && !isWatchedFull) { %>
                                <% 
                                    const titleWords = (lastLesson.lessonTitle || '').split(' ');
                                    const formattedTitle = titleWords.length > 4 ? titleWords.slice(0, 4).join(' ') + '...' : lastLesson.lessonTitle;
                                    const rawDesc = lastLesson.description || 'Watch and learn key topics step by step';
                                    const descWords = rawDesc.split(' ');
                                    const formattedDesc = descWords.length > 10 ? descWords.slice(0, 10).join(' ') + '...' : rawDesc;
                                %>
                                <div class="flex flex-col sm:flex-row items-start justify-between gap-3 sm:gap-6 w-full px-4 sm:px-6 lg:px-7 pt-3 sm:pt-4 lg:pt-4.5 pb-4 sm:pb-7 lg:pb-8">
                                    <!-- LEFT SIDE: Thumbnail Frame (Clickable) -->
                                     <a href="/course-details/<%= lastLesson.course._id %>?lesson=<%= lastLesson.lessonId %>&time=<%= lastLesson.lastPosition || 0 %>&from=dashboard" 
