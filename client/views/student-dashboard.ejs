                        // Proper full completion detection:
                        // 1. Watched >= 92% or (for long videos >= 5 mins) remaining <= 25 seconds
                        const isProgressFull = Boolean(dur > 0 && pos > 0 && ((pos / dur >= 0.92) || (dur >= 300 && dur - pos <= 25)));
                        // 2. Actively in progress: has watched some seconds (> 0) but not reached near completion threshold
                        const isActivelyInProgress = Boolean(pos > 0 && !isProgressFull && (pos < 60 || (dur > 0 && pos / dur < 0.92)));
                        // 3. Fully completed IF AND ONLY IF it is NOT actively in progress AND (isProgressFull OR explicitly marked complete)
                        const isWatchedFull = Boolean(!isActivelyInProgress && (isProgressFull || (lastLesson && lastLesson.isCompleted === true)));
                        let activeLessonThumb = (lastLesson && (lastLesson.thumbnail || (lastLesson.course && lastLesson.course.thumbnail))) || '';
                        if (activeLessonThumb && !activeLessonThumb.startsWith('http') && !activeLessonThumb.startsWith('/')) {
                            activeLessonThumb = '/' + activeLessonThumb;
                        }
                    %>


                    <!-- 1. SMART SUGGESTED EXAM (Standalone Spotlight Card) -->
                    <% if (locals.suggestedExam) { %>
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative group">
                        <!-- Top Row: Simple Free Icon + 2-3 Word Hook + Points / Duration -->
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 sm:size-9 rounded-xl <%= suggestedExam.type === 'live' ? 'bg-rose-500/15 border border-rose-500/30 text-rose-600' : (suggestedExam.type === 'popular' ? 'bg-amber-500/15 border border-amber-500/30 text-amber-600' : (suggestedExam.type === 'practice' ? 'bg-indigo-500/15 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400' : 'bg-teal-700/15 border border-teal-700/30 text-teal-800 dark:text-teal-300')) %> flex items-center justify-center shrink-0">
                                    <% if (suggestedExam.type === 'live') { %>
                                        <i class="fa-solid fa-circle-dot text-sm sm:text-base animate-pulse"></i>
                                    <% } else if (suggestedExam.type === 'popular') { %>
                                        <i class="fa-solid fa-fire text-sm sm:text-base"></i>
                                    <% } else if (suggestedExam.type === 'practice') { %>
                                        <i class="fa-solid fa-compass text-sm sm:text-base"></i>
                                    <% } else { %>
                                        <i class="fa-solid fa-clipboard-check text-sm sm:text-base"></i>
                                    <% } %>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs sm:text-[13px] font-bold <%= suggestedExam.type === 'live' ? 'text-rose-500' : (suggestedExam.type === 'popular' ? 'text-amber-500' : (suggestedExam.type === 'practice' ? 'text-indigo-600 dark:text-indigo-400' : 'text-teal-700 dark:text-teal-400')) %>">
                                    <% if (suggestedExam.type === 'live') { %>
                                        <span>লাইভ এক্সাম</span>
                                    <% } else if (suggestedExam.type === 'popular') { %>
                                        <span>জনপ্রিয় টেস্ট</span>
                                    <% } else if (suggestedExam.type === 'practice') { %>
                                        <span>সেলফ প্র্যাকটিস</span>
                                    <% } else { %>
                                        <span>কুইজ চ্যালেঞ্জ</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <% if (suggestedExam.duration) { %>
                                    <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">⏱️ <%= suggestedExam.duration %>m</span>
                                    <span class="text-slate-300 dark:text-slate-700">·</span>
                                <% } %>
                                <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-500/20 border border-amber-600/30 flex items-center gap-1">
                                    <i class="fa-solid fa-bolt text-[10px]"></i> +50 XP
                                </span>
                            </div>
                        </div>

                        <!-- Title & Subject Row (Full width, clear and prominent) -->
                        <div class="min-w-0 pt-0.5">
                            <a href="<%= suggestedExam.url %>" class="block text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 truncate hover:text-teal-700 dark:hover:text-teal-300 transition-colors" title="<%= suggestedExam.title %>">
                                <%= suggestedExam.title %>
                            </a>
                            <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate font-medium mt-0.5">
                                <%= suggestedExam.subject %><% if (suggestedExam.examTakers && suggestedExam.examTakers >= 30) { %> · <%= suggestedExam.examTakers %> জন পরীক্ষা দিয়েছে<% } %>
                            </p>
                        </div>

                        <!-- Live Glassmorphism Action: Shorter Button at the Left with Live Blowing Effect -->
                        <div class="pt-1.5 flex items-center justify-start">
                            <a href="<%= suggestedExam.url %>" 
                               class="inline-flex items-center justify-center gap-2 py-1.5 sm:py-2 px-4 sm:px-5 rounded-xl backdrop-blur-md font-medium text-xs sm:text-sm transition-all duration-300 active:scale-95 <%= suggestedExam.type === 'live' ? 'bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/40 text-rose-600 dark:text-rose-400 live-blowing-rose' : (suggestedExam.type === 'practice' ? 'bg-indigo-600/15 hover:bg-indigo-600/25 border border-indigo-500/40 text-indigo-700 dark:text-indigo-300' : 'bg-teal-600/15 hover:bg-teal-600/25 border border-teal-500/40 text-teal-800 dark:text-teal-200 live-blowing-teal') %>">
                                <i class="fa-solid <%= suggestedExam.type === 'practice' ? 'fa-arrow-right' : 'fa-play' %> text-[10px] <%= suggestedExam.type === 'live' ? 'text-rose-500' : (suggestedExam.type === 'practice' ? 'text-indigo-600 dark:text-indigo-300' : 'text-teal-600 dark:text-teal-300') %>"></i>
                                <span><%= suggestedExam.type === 'live' ? 'Join' : (suggestedExam.type === 'practice' ? 'Explore Bank' : 'Start') %></span>
                            </a>
                        </div>
                    </div>
                    <style>
                    @keyframes liveBlowTeal {
                        0%, 100% {
                            box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.4), 0 0 8px rgba(20, 184, 166, 0.2);
                        }
                        50% {
                            box-shadow: 0 0 0 5px rgba(20, 184, 166, 0), 0 0 16px rgba(20, 184, 166, 0.45);
                        }
                    }
                    @keyframes liveBlowRose {
                        0%, 100% {
                            box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.45), 0 0 10px rgba(244, 63, 94, 0.25);
                        }
                        50% {
                            box-shadow: 0 0 0 6px rgba(244, 63, 94, 0), 0 0 18px rgba(244, 63, 94, 0.5);
                        }
                    }
                    .live-blowing-teal {
                        animation: liveBlowTeal 2.4s infinite ease-in-out;
                    }
                    .live-blowing-rose {
                        animation: liveBlowRose 2.4s infinite ease-in-out;
                    }
                    </style>
                    <% } %>

                    <!-- SMART REVISION (Interactive Instant Recall Quiz - Flat DOM, Crisp, Zero Blur) -->
                    <% if (locals.dailyFlashcards && dailyFlashcards.length > 0) { 
                        const topicsList = (locals.flashcardTopics && flashcardTopics.length > 0) ? flashcardTopics : ['সকল বিষয়'];
                    %>
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative">
                        <!-- Top Row: Icon + Simple Title + Topic Dropdown Filter + Counter -->
                        <div class="flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
                            <div class="flex items-center gap-2 min-w-0">
                                <div class="size-8 rounded-xl bg-indigo-500/15 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-bolt text-xs"></i>
                                </div>
                                <h3 class="text-sm sm:text-base font-medium text-slate-900 dark:text-slate-100 antialiased truncate">
                                    স্মার্ট রিভিশন
                                </h3>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <!-- Filter Dropdown -->
                                <select id="fcTopicSelect" onchange="filterFlashcardsByTopic(this.value)" class="py-1 px-2.5 rounded-lg text-xs font-normal bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer">
                                    <% topicsList.forEach(tp => { %>
                                        <option value="<%= tp %>"><%= tp %></option>
                                    <% }) %>
                                </select>

                                <span class="text-xs font-normal text-slate-500 dark:text-slate-400">
                                    <span id="fcActiveNumBadge" class="text-slate-800 dark:text-slate-200">1</span> / <span id="fcTotalNumBadge"><%= dailyFlashcards.length %></span>
                                </span>
                            </div>
                        </div>

                        <!-- Questions Stack (Flat DOM - ZERO BLUR, 100% crisp) -->
                        <div id="flashcardsDeckList" class="w-full">
                            <% dailyFlashcards.forEach((fc, fIdx) => { 
                                const optChars = ['A', 'B', 'C', 'D'];
                                const correctOptIdx = (typeof fc.correctAnswerIndex === 'number') ? fc.correctAnswerIndex : -1;
                            %>
                                <div id="fcCardWrap-<%= fIdx %>" 
                                     class="fc-card-item <%= fIdx === 0 ? 'block' : 'hidden' %> w-full"
                                     data-card-idx="<%= fIdx %>"
                                     data-subject="<%= (fc.subject || 'সাধারণ').trim() %>"
                                     data-is-weak="<%= fc.isWeakTopic ? 'true' : 'false' %>">

                                    <div class="p-3.5 sm:p-4 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 flex flex-col justify-between">
                                        <div>
                                            <!-- Badges Row -->
                                            <div class="flex items-center gap-1.5 mb-2 flex-wrap">
                                                <span class="px-2 py-0.5 rounded-md text-xs font-normal bg-indigo-50 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-800/80">
                                                    <%= fc.subject || 'সাধারণ' %>
                                                </span>
                                                <% if (fc.isWeakTopic) { %>
                                                    <span class="px-2 py-0.5 rounded-md text-xs font-normal bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800/80">
                                                        দুর্বল অধ্যায়
                                                    </span>
                                                <% } %>
                                                <% if (fc.board) { %>
                                                    <span class="px-2 py-0.5 rounded-md text-xs font-normal bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60">
                                                        <%= fc.board %>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <!-- Question Text -->
                                            <h4 class="text-xs sm:text-sm font-normal text-slate-900 dark:text-slate-100 leading-relaxed mb-3">
                                                <%= fc.questionText %>
                                            </h4>

                                            <!-- Interactive MCQ Options -->
                                            <% if (fc.options && fc.options.length > 0) { %>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2" id="fcOptionsGroup-<%= fIdx %>">
                                                    <% fc.options.slice(0, 4).forEach((opt, oIdx) => { %>
                                                        <button type="button" 
                                                                onclick="checkFlashcardAnswer(<%= fIdx %>, <%= oIdx %>, <%= correctOptIdx %>)" 
                                                                id="fcOpt-<%= fIdx %>-<%= oIdx %>" 
                                                                class="fc-opt-btn w-full flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700/80 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 transition-all text-left group">
                                                            <div class="flex items-center gap-2 min-w-0 flex-1">
                                                                <span class="fc-opt-letter size-5 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs flex items-center justify-center shrink-0 border border-slate-200 dark:border-slate-600 font-medium leading-none">
                                                                    <%= optChars[oIdx] %>
                                                                </span>
                                                                <span class="truncate leading-normal"><%= opt %></span>
                                                            </div>
                                                            <span class="fc-opt-status hidden shrink-0 ml-1.5 text-xs"></span>
                                                        </button>
                                                    <% }) %>
                                                </div>
                                            <% } %>

                                            <!-- Instant Result & Explanation Box (reveals on click) -->
                                            <div id="fcFeedback-<%= fIdx %>" class="hidden mt-2 p-2.5 rounded-xl bg-white dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-xs leading-relaxed transition-all">
                                                <div id="fcResultMsg-<%= fIdx %>" class="font-medium text-xs mb-1"></div>
                                                <% if (fc.explanation && fc.explanation.trim() !== '') { %>
                                                    <p class="text-slate-600 dark:text-slate-400 font-normal">
                                                        <span class="text-indigo-600 dark:text-indigo-400 font-medium">ব্যাখ্যা:</span> <%= fc.explanation %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Bottom Navigation -->
                                        <div class="flex items-center justify-between gap-2 mt-3 pt-2 border-t border-slate-200/60 dark:border-slate-800/80">
                                            <button type="button" onclick="prevFlashcard()" class="fc-prev-btn px-2.5 py-1 rounded-lg text-xs font-normal text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 disabled:opacity-30 disabled:pointer-events-none flex items-center gap-1 transition-colors" <%= fIdx === 0 ? 'disabled' : '' %>>
                                                <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                                <span>পূর্ববর্তী</span>
                                            </button>
                                            <a href="/question-bank" class="text-xs font-normal text-indigo-600 dark:text-indigo-400 hover:underline">
                                                প্রশ্নব্যাংক →
                                            </a>
                                            <button type="button" onclick="nextFlashcard()" class="fc-next-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-600 hover:bg-indigo-500 text-white transition-colors flex items-center gap-1 shadow-2xs">
                                                <span class="fc-next-label"><%= fIdx === dailyFlashcards.length - 1 ? 'সমাপ্ত করুন' : 'পরবর্তী প্রশ্ন' %></span>
                                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>

                            <!-- Empty Filter State -->
                            <div id="fcTopicEmptyCard" class="hidden text-center py-6 px-3 flex flex-col items-center justify-center gap-2">
                                <h4 class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-100">এই টপিকে কোনো প্রশ্ন নেই</h4>
                                <button type="button" onclick="filterFlashcardsByTopic('সকল বিষয়')" class="mt-1 px-3 py-1.5 rounded-xl text-xs font-normal bg-indigo-600 text-white">
                                    সকল বিষয় দেখুন
                                </button>
                            </div>

                            <!-- Completion View -->
                            <div id="fcCompletionCard" class="hidden text-center py-6 px-3 flex flex-col items-center justify-center gap-2">
                                <div class="size-11 rounded-2xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg">
                                    🎉
                                </div>
                                <h4 class="text-sm font-medium text-slate-900 dark:text-slate-100">রিভিশন সম্পন্ন হয়েছে!</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400">আজকের রিভিশন প্রশ্নগুলো সফলভাবে সমাধান করেছেন।</p>
                                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-800 dark:text-amber-300 text-xs font-normal">
                                    <i class="fa-solid fa-bolt text-amber-500"></i> +15 XP অর্জিত
                                </div>
                                <div class="flex items-center gap-2 mt-2">
                                    <button type="button" onclick="restartFlashcards()" class="px-3 py-1.5 rounded-xl text-xs font-normal bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200">
                                        আবার শুরু করুন
                                    </button>
                                    <a href="/question-bank" class="px-3 py-1.5 rounded-xl text-xs font-normal bg-indigo-600 text-white hover:bg-indigo-500">
                                        প্রশ্নব্যাংক
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- STANDALONE QUICK STUDY NOTES & SCRATCHPAD (Placed Directly Before Video Lesson Watch Tracker) -->
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative">
                        <!-- Top Row: Icon + Simple Title + Auto-Save Status -->
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <div class="size-8 rounded-xl bg-sky-500/15 border border-sky-500/30 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                </div>
                                <h3 class="text-sm sm:text-base font-medium text-slate-900 dark:text-slate-100 antialiased truncate">
                                    স্টাডি কুইক নোট
                                </h3>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <span id="scratchSaveStatus" class="text-xs text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-normal">
                                    <i class="fa-solid fa-cloud-arrow-up text-[10px]"></i>
                                    <span>অটো-সেভ</span>
                                </span>
                            </div>
                        </div>

                        <!-- Math & Science One-Tap Symbol Toolbar -->
                        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 px-0.5 border-y border-slate-100 dark:border-slate-800/80">
                            <span class="text-xs text-slate-500 dark:text-slate-400 shrink-0 mr-1 flex items-center gap-1 font-normal">
                                <i class="fa-solid fa-square-root-variable text-[11px] text-sky-500"></i> প্রতীক:
                            </span>
                            <% const symbols = ['√', 'π', 'θ', 'Δ', 'α', 'β', '±', '²', '³', '⇌', '→', '°', 'λ', '∞']; %>
                            <% symbols.forEach(sym => { %>
                                <button type="button" onclick="insertNoteSymbol('<%= sym %>')" class="px-2 py-0.5 rounded-md text-xs font-normal bg-slate-100 dark:bg-slate-800 hover:bg-sky-500/15 hover:text-sky-600 dark:hover:text-sky-400 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60 transition-colors shrink-0">
                                    <%= sym %>
                                </button>
                            <% }) %>
                        </div>

                        <!-- Quick Scratchpad Textarea -->
                        <div class="relative w-full">
                            <textarea id="quickScratchpadText" 
                                      rows="3" 
                                      oninput="handleScratchpadInput()"
                                      placeholder="এখানে আপনার আজকের গুরুত্বপূর্ণ সূত্র বা নোট লিখে রাখুন... (লাইব্রেরিতে সেভ করা যাবে)" 
                                      class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-500 transition-all resize-none leading-relaxed font-sans placeholder:text-slate-400 dark:placeholder:text-slate-500 custom-scrollbar"></textarea>
                        </div>

                        <!-- Bottom Actions Toolbar -->
                        <div class="flex items-center justify-between gap-2 pt-1 border-t border-slate-100 dark:border-slate-800/80">
                            <button type="button" id="saveToLibBtn" onclick="saveQuickNoteToLibrary()" class="px-2.5 py-1.5 rounded-lg text-xs font-normal bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 hover:bg-sky-100 dark:hover:bg-sky-900/40 border border-sky-200/80 dark:border-sky-800/80 transition-colors flex items-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-bookmark text-[10px]"></i>
                                <span>লাইব্রেরিতে সেভ করুন</span>
                            </button>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" id="copyNoteBtn" onclick="copyQuickNote()" class="px-2.5 py-1.5 rounded-lg text-xs font-normal bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1 border border-slate-200/80 dark:border-slate-700/80 cursor-pointer">
                                    <i class="fa-regular fa-copy text-[10px]"></i>
                                    <span>কপি</span>
                                </button>
                                <button type="button" onclick="clearQuickNote()" class="px-2 py-1.5 rounded-lg text-xs font-normal text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors flex items-center gap-1 cursor-pointer">
                                    <i class="fa-regular fa-trash-can text-[10px]"></i>
                                    <span>মুছুন</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 2. VIDEO LESSON WATCH TRACKER (Standalone, Matching Quick Quiz Aesthetics) -->
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative group">
                        
                        <!-- Top Row: Icon with BG (like Quick Quiz) + Title + Concise 2-Word Text & +30 XP -->
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 sm:size-9 rounded-xl <%= (lastLesson && !isWatchedFull) ? 'bg-rose-500/15 border border-rose-500/30 text-rose-600' : 'bg-teal-700/15 border border-teal-700/30 text-teal-800 dark:text-teal-300' %> flex items-center justify-center shrink-0">
                                    <% if (lastLesson && !isWatchedFull) { %>
                                        <i class="fa-solid fa-play text-xs sm:text-sm text-rose-500 animate-pulse"></i>
                                    <% } else { %>
                                        <i class="fa-solid fa-play text-xs sm:text-sm text-teal-700 dark:text-teal-300"></i>
                                    <% } %>
                                </div>
                                <h3 class="text-sm sm:text-base font-medium text-slate-900 dark:text-slate-100 antialiased truncate">
                                    ভিডিও লেসন ওয়াচ ট্র্যাকার
                                </h3>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <span id="activity-count-video" class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">
