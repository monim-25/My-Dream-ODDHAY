        async function setRevisionReminder(topic, subject, link, delayMinutes = 30, btn = null) {
            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[10px]"></i><span>সেট হচ্ছে...</span>';
                }
                const res = await fetch('/api/student/set-revision-reminder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topic, subject, link, delayMinutes })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'success',
                            title: 'রিভিশন রিমাইন্ডার সেট হয়েছে!',
                            text: data.message || `"${topic}"-এর জন্য রিমাইন্ডার সেট করা হয়েছে।`,
                            timer: 3500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        alert(data.message || `"${topic}"-এর জন্য রিমাইন্ডার সেট হয়েছে!`);
                    }
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa-solid fa-check text-[10px]"></i><span>রিমাইন্ডার সেট</span>';
                        btn.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30 transition-colors cursor-pointer';
                        
                        // Auto-remove card smoothly from weak area radar after setting reminder
                        const card = btn.closest('.weak-topic-card') || btn.closest('[data-topic]');
                        if (card) {
                            setTimeout(() => {
                                card.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(-10px) scale(0.96)';
                                setTimeout(() => {
                                    card.remove();
                                    updateWeakAreaCardCount();
                                }, 400);
                            }, 1000);
                        }
                    }
                } else {
                    throw new Error(data.error || 'Failed to set reminder');
                }
            } catch (err) {
                console.error('Reminder error:', err);
                if (window.Swal) {
                    Swal.fire({
                        icon: 'error',
                        title: 'রিমাইন্ডার সেট করা যায়নি',
                        text: err.message,
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                } else {
                    alert('রিমাইন্ডার সেট করা যায়নি: ' + err.message);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-regular fa-bell text-[10px]"></i><span>Reminder</span>';
                }
            }
        }

        // Save Quick Note directly to Library as a Text File
        async function saveQuickNoteToLibrary() {
            const txt = document.getElementById('quickScratchpadText');
            const btn = document.getElementById('saveToLibBtn');
            if (!txt || !txt.value.trim()) {
                alert('সেভ করার জন্য প্রথমে কিছু নোট লিখুন!');
                if (txt) txt.focus();
                return;
            }
            const content = txt.value.trim();
            const origHTML = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[10px]"></i><span>সেভ হচ্ছে...</span>';
            }

            try {
                const res = await fetch('/api/library/save-quick-note', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content })
                });
                const data = await res.json();
                if (data.success) {
                    if (btn) {
                        btn.innerHTML = '<i class="fa-solid fa-check text-[10px] text-emerald-500"></i><span class="text-emerald-600 dark:text-emerald-400 font-medium">লাইব্রেরিতে সেভ হয়েছে!</span>';
                        setTimeout(() => {
                            btn.disabled = false;
