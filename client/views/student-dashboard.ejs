                                %>
                                <span id="weakAreaFocusBadge" class="px-2.5 py-1 rounded-lg text-[11px] font-bold <%= focusCount > 0 ? 'bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30' : (hasRadarData && !isMastered ? 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30' : 'bg-teal-800/15 text-teal-900 dark:text-teal-300 border border-teal-700/20') %> inline-flex items-center justify-center gap-1.5 leading-none select-none">
