<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Student Dashboard | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'dashboard' }) %>
        
        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <!-- Mobile Sidebar Overlay & Drawer for Dashboard -->
            <div id="mobileSidebarBackdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 lg:hidden"></div>
            <div id="mobileSidebarDrawer" class="fixed inset-y-0 left-0 w-[280px] bg-white dark:bg-[#0f172a] z-50 -translate-x-full transition-transform duration-300 ease-out shadow-2xl lg:hidden flex flex-col">
                <div class="flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="font-black text-base dark:text-white">ODDHAY</span>
                    </div>
                    <button onclick="toggleMobileSidebar()" class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-white rounded-lg">
                        <span class="material-symbols-rounded text-xl">close</span>
                    </button>
                </div>
                <div class="flex-1 overflow-y-auto p-3">
                    <%- include('partials/student-sidebar', { activePage: 'dashboard' }) %>
                </div>
            </div>

            <!-- Unified AI Study Assistant & Quick Actions Container (Subtle Balanced Dark Slate Tone) -->
            <div class="w-full bg-gradient-to-r from-[#131C2E] via-[#1A2638] to-[#152033] border-b border-indigo-500/25 text-white shadow-xl flex flex-col group relative">
                
                <!-- TOP PART: AI Study Assistant Section -->
                <div class="w-full pt-3 sm:pt-3.5 pb-2 sm:pb-2.5 px-3.5 sm:px-4.5 lg:px-5 relative overflow-hidden flex flex-col items-start justify-between">
                    <!-- Subtle Ambient Light Bubbles & Rays -->
                    <div class="absolute -top-20 -left-20 size-64 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-20 -right-20 size-64 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/[0.04] via-transparent to-cyan-500/[0.04] pointer-events-none"></div>

                    <!-- TOP-RIGHT CORNER: Deep Bluish Compact Quick Access Icon Buttons -->
                    <div class="absolute top-2.5 right-3.5 sm:top-3 sm:right-5 z-30 flex items-center gap-1.5 sm:gap-2">
                        <!-- 1. My Courses Icon -->
                        <a href="/my-courses" class="size-7.5 sm:size-8 rounded-lg border border-sky-400/30 hover:border-sky-400 bg-sky-950/70 hover:bg-sky-500 text-sky-200 hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="My Courses">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">auto_stories</span>
                        </a>

                        <!-- 2. Notes Icon -->
                        <a href="/notes" class="size-7.5 sm:size-8 rounded-lg border border-sky-400/30 hover:border-sky-400 bg-sky-950/70 hover:bg-sky-500 text-sky-200 hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Lecture Notes">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">sticky_note_2</span>
                        </a>

                        <!-- 3. Exams Icon -->
                        <a href="/exams" class="size-7.5 sm:size-8 rounded-lg border border-sky-400/30 hover:border-sky-400 bg-sky-950/70 hover:bg-sky-500 text-sky-200 hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Exams & Quizzes">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">edit_note</span>
                        </a>

                        <!-- 4. Question Bank Icon -->
                        <a href="/question-bank" class="size-7.5 sm:size-8 rounded-lg border border-sky-400/30 hover:border-sky-400 bg-sky-950/70 hover:bg-sky-500 text-sky-200 hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Question Bank">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">live_help</span>
                        </a>
                    </div>

                    <!-- Content: Left AI Assistant Info + Right Notice & Updates Section -->
                    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center w-full mb-1 ml-0">
                        <!-- LEFT COLUMN: Animated Floating AI Icon + AI Features List + CTA Button -->
                        <div class="lg:col-span-7 flex flex-col items-start gap-3 sm:gap-3.5 w-full">
                            <div class="flex flex-col items-start gap-1.5">
                                <!-- Animated Floating AI Core Visual (Moved a bit to the right side & bottom) -->
                                <div class="ai-animated-orb relative size-24 sm:size-28 lg:size-32 flex items-center justify-center shrink-0 ml-5 sm:ml-7 lg:ml-9 mt-2 sm:mt-2.5">
                                    <!-- Outer Pulsing Glow -->
                                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-indigo-500/30 via-purple-500/20 to-cyan-500/30 blur-xl animate-pulse"></div>
                                    
                                    <!-- Rotating Orbit Ring -->
                                    <div class="absolute inset-1 rounded-full border border-dashed border-cyan-400/40 animate-spin" style="animation-duration: 12s;"></div>
                                    
                                    <!-- Inner Glass Disc with Hyper-Unique Dual-Gyroscope Quantum Star Core -->
                                    <div class="size-16 sm:size-20 lg:size-22 rounded-full bg-slate-900/90 border border-cyan-400/50 flex items-center justify-center shadow-inner backdrop-blur-md overflow-hidden relative">
                                        <svg class="size-12 sm:size-14 lg:size-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <!-- Outer Counter-Rotating Gyro Ring with Satellite Nodes -->
                                            <g class="origin-center ai-spin-ccw">
                                                <ellipse cx="50" cy="50" rx="42" ry="18" stroke="url(#gyroGrad1)" stroke-width="1.8" stroke-dasharray="6 4" transform="rotate(-25 50 50)"/>
                                                <circle cx="15" cy="35" r="3" fill="#38BDF8"/>
                                                <circle cx="85" cy="65" r="3" fill="#F472B6"/>
                                            </g>
                                            
                                            <!-- Clockwise Gyro Ring -->
                                            <g class="origin-center ai-spin-cw">
                                                <ellipse cx="50" cy="50" rx="42" ry="18" stroke="url(#gyroGrad2)" stroke-width="1.8" stroke-dasharray="8 3" transform="rotate(35 50 50)"/>
                                                <circle cx="75" cy="25" r="3" fill="#818CF8"/>
                                                <circle cx="25" cy="75" r="3" fill="#34D399"/>
                                            </g>

                                            <!-- Center Hyper-Dimensional AI Core Star -->
                                            <g class="origin-center ai-pulse-core">
                                                <path d="M50 20 L57 38 L75 38 L60 49 L66 67 L50 56 L34 67 L40 49 L25 38 L43 38 Z" fill="url(#coreGrad)" stroke="#E0E7FF" stroke-width="1"/>
                                                <circle cx="50" cy="50" r="7" fill="#FFFFFF"/>
                                                <circle cx="50" cy="50" r="4" fill="#0EA5E9"/>
                                            </g>

                                            <defs>
                                                <linearGradient id="gyroGrad1" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#38BDF8"/>
                                                    <stop offset="0.5" stop-color="#C084FC"/>
                                                    <stop offset="1" stop-color="#F472B6"/>
                                                </linearGradient>
                                                <linearGradient id="gyroGrad2" x1="100" y1="0" x2="0" y2="100" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#34D399"/>
                                                    <stop offset="0.5" stop-color="#818CF8"/>
                                                    <stop offset="1" stop-color="#38BDF8"/>
                                                </linearGradient>
                                                <linearGradient id="coreGrad" x1="25" y1="20" x2="75" y2="67" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#38BDF8"/>
                                                    <stop offset="0.5" stop-color="#6366F1"/>
                                                    <stop offset="1" stop-color="#EC4899"/>
                                                </linearGradient>
                                            </defs>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <!-- AI Feature Bullet Points List (Shifted Rightwards with Subtle Darkish Tones) -->
                            <div class="flex flex-col gap-2 mt-0 mb-1 ml-4 sm:ml-6 lg:ml-8 font-['Plus_Jakarta_Sans',sans-serif]">
                                <div class="flex items-center gap-2 text-xs sm:text-[13px] text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-500/70 leading-none shrink-0">check_circle</span>
                                    <span>Unlimited Problem Solving</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs sm:text-[13px] text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-500/70 leading-none shrink-0">check_circle</span>
                                    <span>Snap Photo & Ask Doubts</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs sm:text-[13px] text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-500/70 leading-none shrink-0">check_circle</span>
                                    <span>Step-by-Step Instant Solutions</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs sm:text-[13px] text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-500/70 leading-none shrink-0">check_circle</span>
                                    <span>24/7 Personal AI Tutor</span>
                                </div>
                            </div>

                            <!-- CTA Button (Aligned Oddhay AI Button: Medium Dark Blue Font-Normal Text, Optical Alignment) -->
                            <div class="ml-4 sm:ml-6 lg:ml-8 py-1.5 sm:py-2">
                                <a href="/qa-forum" aria-label="Oddhay AI" class="inline-flex items-center justify-center gap-2 px-5 py-2 bg-sky-100/90 hover:bg-sky-50 text-sky-950 text-xs sm:text-sm font-normal rounded-xl border border-sky-200/80 shadow-xs transition-all duration-300 transform hover:scale-[1.02] active:scale-95 select-none group/btn leading-none">
                                    <!-- AI Microchip Icon -->
                                    <span class="material-symbols-rounded text-base sm:text-lg text-sky-900 shrink-0 flex items-center justify-center leading-none p-0 m-0 -mt-0.5 transition-transform group-hover/btn:scale-110">memory</span>
                                    
                                    <!-- Button Label (Medium Dark Blue, Font Normal, Perfectly Centered) -->
                                    <span class="font-normal text-sky-950 leading-none flex items-center p-0 m-0">Oddhay AI</span>
                                </a>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Notice & Updates Section (or Student Progress Fallback) -->
                        <% if (locals.upcomingEvent) { %>
                            <div class="lg:col-span-5 w-full flex justify-center lg:justify-end pr-0 lg:pr-4">
                                <div class="w-full max-w-md bg-[#111827] border border-indigo-500/30 text-white rounded-none shadow-xl flex flex-col overflow-hidden transition-all min-h-[160px] sm:min-h-[175px] my-1 backdrop-blur-md">
                                    <div class="flex items-center justify-between px-4 sm:px-5 py-2.5 border-b border-cyan-400/20">
                                        <div class="flex items-center gap-2">
                                            <% 
                                                const topNoticeType = upcomingEvent.type || 'none';
                                                let topNoticeDotClass = 'bg-cyan-400';
                                                let topNoticeTitle = 'Notice & Updates';
                                                let topNoticeIcon = 'notifications';

                                                if (topNoticeType === 'exam') {
                                                    topNoticeDotClass = 'bg-[#F43F5E] animate-pulse';
                                                    topNoticeTitle = 'Exam Alert';
                                                    topNoticeIcon = 'assignment_turned_in';
                                                } else if (topNoticeType === 'live') {
                                                    topNoticeDotClass = 'bg-rose-500 animate-pulse';
                                                    topNoticeTitle = 'Live Class Alert';
                                                    topNoticeIcon = 'sensors';
                                                } else if (topNoticeType === 'high_notice' || topNoticeType === 'notice') {
                                                    topNoticeDotClass = 'bg-amber-400 animate-pulse';
                                                    topNoticeTitle = 'Important Notice';
                                                    topNoticeIcon = 'campaign';
                                                } else if (topNoticeType === 'recommendation') {
                                                    topNoticeDotClass = 'bg-emerald-400';
                                                    topNoticeTitle = 'Recommendation';
                                                    topNoticeIcon = 'insights';
                                                }
                                            %>
                                            <span class="size-2.5 rounded-full shrink-0 <%= topNoticeDotClass %>"></span>
                                            <h2 class="font-bold text-sm text-white leading-tight">
                                                <%= topNoticeTitle %>
                                            </h2>
                                        </div>
                                        <span class="material-symbols-rounded text-cyan-300 text-base shrink-0 flex items-center justify-center -mt-0.5">
                                            <%= topNoticeIcon %>
                                        </span>
                                    </div>

                                    <div class="flex-1 flex flex-col justify-between p-3.5 sm:p-4">
                                        <div class="flex flex-col gap-2 flex-1 justify-between">
                                            <div>
                                                <% if (upcomingEvent.courseTitle) { %>
                                                    <div class="flex items-center gap-1.5 text-[11px] font-semibold text-cyan-300 mb-1 flex-wrap">
                                                        <span class="inline-flex items-center gap-1">
                                                            <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center -mt-0.5">auto_stories</span>
                                                            <span class="truncate max-w-[180px]"><%= upcomingEvent.courseTitle %></span>
                                                        </span>
                                                    </div>
                                                <% } %>
                                                <h3 class="text-sm sm:text-base font-bold text-white leading-snug line-clamp-1 mb-1"><%= upcomingEvent.title %></h3>
                                                <% if (upcomingEvent.message) { %>
                                                    <p class="text-xs text-cyan-100/90 leading-relaxed line-clamp-2"><%= upcomingEvent.message %></p>
                                                <% } else if (upcomingEvent.subtitle) { %>
                                                    <p class="text-xs text-cyan-100/90 leading-relaxed line-clamp-2"><%= upcomingEvent.subtitle %></p>
                                                <% } %>
                                            </div>
                                            <div class="flex items-center justify-between pt-3 mt-auto border-t border-cyan-400/10">
                                                <span class="text-xs font-semibold text-cyan-200 flex items-center gap-1">
                                                    <span class="material-symbols-rounded text-sm shrink-0 flex items-center justify-center -mt-0.5">schedule</span>
                                                    <span><%= upcomingEvent.time %></span>
                                                </span>
                                                <% if (upcomingEvent.link) { %>
                                                    <a href="<%= upcomingEvent.link %>" onclick="attendNotice('<%= upcomingEvent.id %>')" class="px-3.5 py-1.5 bg-[#F43F5E] hover:bg-rose-600 text-white text-xs font-bold rounded-lg transition-colors shadow-sm">
                                                        <%= upcomingEvent.buttonText || 'View Notice' %>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- DIRECTLY ON SECTION: Your Progress (Moved Higher Up via Translate Y) -->
                            <div class="lg:col-span-5 w-full flex flex-col justify-center gap-2.5 transform -translate-x-4 sm:-translate-x-8 lg:-translate-x-12 -translate-y-1 sm:translate-y-0 lg:translate-y-1 my-1 relative z-20">
                                <%
                                    // 100% Accurate Real User Activity Calculations
                                    const realUser = locals.user || {};
                                    const quizResultsList = realUser.quizResults || [];
                                    const bankAttemptsList = realUser.questionBankAttempts || [];

                                    // 1. Right & Wrong MCQ Counts from Quizzes & Question Bank
                                    let calcRightMCQ = 0;
                                    let calcWrongMCQ = 0;
                                    let sumPctScores = 0;
                                    let totalAttemptsCount = 0;

                                    quizResultsList.forEach(q => {
                                        const qScore = q.score || 0;
                                        const qTotal = q.total || q.totalQuestions || 1;
                                        const qWrong = q.wrongCount !== undefined ? q.wrongCount : Math.max(0, qTotal - qScore);
                                        calcRightMCQ += qScore;
                                        calcWrongMCQ += qWrong;
                                        sumPctScores += (qScore / qTotal) * 100;
                                        totalAttemptsCount++;
                                    });

                                    bankAttemptsList.forEach(a => {
                                        const bScore = a.mcqScore || a.score || 0;
                                        const bTotal = a.totalBankQuestions || a.mcqTotalQuestions || a.total || 1;
                                        const bWrong = a.mcqWrong !== undefined ? a.mcqWrong : Math.max(0, bTotal - bScore);
                                        calcRightMCQ += bScore;
                                        calcWrongMCQ += bWrong;
                                        sumPctScores += (bScore / bTotal) * 100;
                                        totalAttemptsCount++;
                                    });

                                    // Metric Values with DB fallbacks
                                    const realLevel = (locals.level) || realUser.level || realUser.currentLevel || 1;
                                    const realStreak = realUser.streakCount !== undefined ? realUser.streakCount : (realUser.streak || 0);
                                    const realXP = realUser.points !== undefined ? realUser.points : (realUser.totalXP || realUser.xp || 0);
                                    const realRightMCQ = realUser.correctMCQs !== undefined ? realUser.correctMCQs : (realUser.rightMCQ !== undefined ? realUser.rightMCQ : calcRightMCQ);
                                    const realWrongMCQ = realUser.wrongMCQs !== undefined ? realUser.wrongMCQs : (realUser.wrongMCQ !== undefined ? realUser.wrongMCQ : calcWrongMCQ);
                                    const realMarks = realUser.totalMarks !== undefined ? realUser.totalMarks : (realUser.gainedMarks !== undefined ? realUser.gainedMarks : (calcRightMCQ * 5));
                                    
                                    // Solved Questions (MCQs + Q&A Forum Doubts)
                                    const totalDoubts = (realUser.askedQuestions && realUser.askedQuestions.length) || (realUser.qaForumQuestions && realUser.qaForumQuestions.length) || 0;
                                    const realSolvedQuestions = realUser.solvedQuestions !== undefined ? realUser.solvedQuestions : (realUser.questionsSolved !== undefined ? realUser.questionsSolved : (calcRightMCQ + calcWrongMCQ + totalDoubts));
                                    
                                    // Completed Lessons Count
                                    const realCompletedLessons = (realUser.completedLessons && realUser.completedLessons.length) || 0;
                                    
                                    // Saved Resources / Bookmarks Count
                                    const realSavedResources = (locals.savedBookmarks && savedBookmarks.length) || (realUser.savedBookmarks && realUser.savedBookmarks.length) || (realUser.savedNotes && realUser.savedNotes.length) || 0;

                                    // Avg Score % Calculation
                                    let realAvgScore = 0;
                                    if (totalAttemptsCount > 0) {
                                        realAvgScore = Math.round(sumPctScores / totalAttemptsCount);
                                    } else if (realUser.avgScore) {
                                        realAvgScore = realUser.avgScore;
                                    } else if (realRightMCQ + realWrongMCQ > 0) {
                                        realAvgScore = Math.round((realRightMCQ / (realRightMCQ + realWrongMCQ)) * 100);
                                    }
                                %>

                                <!-- Header Title & Level Badge -->
                                <div class="flex items-center justify-between pb-1 border-b border-white/10">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-base text-cyan-300 leading-none shrink-0">trending_up</span>
                                        <h2 class="font-extrabold text-xs sm:text-sm text-slate-200 tracking-wide font-['Plus_Jakarta_Sans',sans-serif]">Your Progress</h2>
                                    </div>
                                    <span class="text-[11px] font-bold text-amber-300 flex items-center gap-1 bg-amber-500/15 border border-amber-400/30 px-2.5 py-0.5 rounded-full">
                                        <span class="material-symbols-rounded text-sm text-amber-300 leading-none">workspace_premium</span>
                                        <span>Level <%= realLevel %></span>
                                    </span>
                                </div>

                                <!-- Metrics Grid (9 Real User Metrics, Directly on Section Backdrop) -->
                                <div class="grid grid-cols-3 sm:grid-cols-3 gap-2 font-['Plus_Jakarta_Sans',sans-serif]">
                                    <!-- 1. Streak -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-amber-400">
                                            <span class="material-symbols-rounded text-base leading-none">local_fire_department</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realStreak %>d</span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Streak</span>
                                    </div>

                                    <!-- 2. Total XP -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-cyan-300">
                                            <span class="material-symbols-rounded text-base leading-none">bolt</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realXP %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Total XP</span>
                                    </div>

                                    <!-- 3. Gained Mark -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-purple-300">
                                            <span class="material-symbols-rounded text-base leading-none">military_tech</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realMarks %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Gained Mark</span>
                                    </div>

                                    <!-- 4. Avg Score -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-yellow-400">
                                            <span class="material-symbols-rounded text-base leading-none">analytics</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realAvgScore %>%</span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Avg Score</span>
                                    </div>

                                    <!-- 5. Right MCQ -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-emerald-400">
                                            <span class="material-symbols-rounded text-base leading-none">check_circle</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realRightMCQ %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Right MCQ</span>
                                    </div>

                                    <!-- 6. Wrong MCQ -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-rose-400">
                                            <span class="material-symbols-rounded text-base leading-none">cancel</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realWrongMCQ %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium">Wrong MCQ</span>
                                    </div>

                                    <!-- 7. Question Solved -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-indigo-300">
                                            <span class="material-symbols-rounded text-base leading-none">psychology</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realSolvedQuestions %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium truncate max-w-full">Question Solved</span>
                                    </div>

                                    <!-- 8. Lesson Completed -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
                                        <div class="flex items-center gap-1 text-teal-300">
                                            <span class="material-symbols-rounded text-base leading-none">task_alt</span>
                                            <span class="text-xs sm:text-sm font-extrabold"><%= realCompletedLessons %></span>
                                        </div>
                                        <span class="text-[10px] text-slate-300 font-medium truncate max-w-full">Lesson Completed</span>
                                    </div>

                                    <!-- 9. Saved Resources -->
                                    <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
