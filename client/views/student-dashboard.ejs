                                </span>
                            </div>
                            <button type="button" onclick="toggleMobileProgressModal(false)" class="size-7 rounded-lg bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/20 active:scale-95 text-slate-500 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Close">
                                <span class="material-symbols-rounded text-base leading-none">close</span>
                            </button>
                        </div>

                        <!-- Metrics Grid (9 Real User Metrics) -->
                        <div class="grid grid-cols-3 gap-2 font-['Plus_Jakarta_Sans',sans-serif]">
                            <!-- 1. Streak -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-amber-600 dark:text-amber-400">
                                    <span class="material-symbols-rounded text-base leading-none">local_fire_department</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realStreak %>d</span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Streak</span>
                            </div>

                            <!-- 2. Total XP -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-cyan-600 dark:text-cyan-300">
                                    <span class="material-symbols-rounded text-base leading-none">bolt</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realXP %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Total XP</span>
                            </div>

                            <!-- 3. Gained Mark -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-purple-600 dark:text-purple-300">
                                    <span class="material-symbols-rounded text-base leading-none">military_tech</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realMarks %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Gained Mark</span>
                            </div>

                            <!-- 4. Avg Score -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-yellow-600 dark:text-yellow-400">
                                    <span class="material-symbols-rounded text-base leading-none">analytics</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realAvgScore %>%</span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Avg Score</span>
                            </div>

                            <!-- 5. Right MCQ -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                                    <span class="material-symbols-rounded text-base leading-none">check_circle</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realRightMCQ %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Right MCQ</span>
                            </div>

                            <!-- 6. Wrong MCQ -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-rose-600 dark:text-rose-400">
                                    <span class="material-symbols-rounded text-base leading-none">cancel</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realWrongMCQ %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium">Wrong MCQ</span>
                            </div>

                            <!-- 7. Question Solved -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-indigo-600 dark:text-indigo-300">
                                    <span class="material-symbols-rounded text-base leading-none">psychology</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realSolvedQuestions %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium truncate max-w-full">Question Solved</span>
                            </div>

                            <!-- 8. Lesson Completed -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-teal-600 dark:text-teal-300">
                                    <span class="material-symbols-rounded text-base leading-none">task_alt</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realCompletedLessons %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium truncate max-w-full">Lesson Completed</span>
                            </div>

                            <!-- 9. Bookmarks -->
                            <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 backdrop-blur-xs">
                                <div class="flex items-center gap-1 text-sky-600 dark:text-sky-300">
                                    <span class="material-symbols-rounded text-base leading-none">bookmark</span>
                                    <span class="text-xs sm:text-sm font-extrabold"><%= realBookmarks %></span>
                                </div>
                                <span class="text-[10px] text-slate-600 dark:text-slate-300 font-medium truncate max-w-full">Bookmarks</span>
                            </div>
                        </div>
                    </div>
                </div>
                <script>
                    function toggleMobileProgressModal(show) {
                        const modal = document.getElementById('mobileProgressModal');
                        if (!modal) return;
                        if (show) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                        } else {
                            modal.classList.add('hidden');
                            modal.classList.remove('flex');
                        }
                    }
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape') toggleMobileProgressModal(false);
                    });
                </script>
            </div>
            <style>
                .ai-animated-orb { animation: aiFloat 4s ease-in-out infinite; }
                .ai-spin-cw { animation: aiSpinCW 16s linear infinite; }
                .ai-spin-ccw { animation: aiSpinCCW 10s linear infinite; }
                .ai-pulse-core { animation: aiPulseCore 3s ease-in-out infinite; }
                @keyframes aiFloat {
                    0%, 100% { transform: translateY(0px) scale(1); }
                    50% { transform: translateY(-8px) scale(1.04); }
                }
                @keyframes aiSpinCW { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                @keyframes aiSpinCCW { 0% { transform: rotate(360deg); } 100% { transform: rotate(-360deg); } }
                @keyframes aiPulseCore { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.12); opacity: 1; filter: drop-shadow(0 0 10px #38BDF8); } }
            </style>

            <!-- Main Dashboard Content Container with Clean Widget Cards & Balanced Gap -->
            <div class="w-full px-3.5 sm:px-5 lg:px-6 pt-4 sm:pt-5 pb-6 flex flex-col gap-4 sm:gap-5">

                    <% 
                        const lastLesson = (locals.user && user.lastWatchedLesson && user.lastWatchedLesson.course) ? user.lastWatchedLesson : null;
                        const dur = Number(lastLesson && lastLesson.duration) || 0;
                        const pos = Number(lastLesson && lastLesson.lastPosition) || 0;
                        
                        // Proper full completion detection:
                        // 1. Watched >= 92% or (for long videos >= 5 mins) remaining <= 25 seconds
                        const isProgressFull = Boolean(dur > 0 && pos > 0 && ((pos / dur >= 0.92) || (dur >= 300 && dur - pos <= 25)));
                        // 2. Actively in progress: has watched some seconds (> 0) but not reached near completion threshold
                        const isActivelyInProgress = Boolean(pos > 0 && !isProgressFull && (pos < 60 || (dur > 0 && pos / dur < 0.92)));
                        // 3. Fully completed IF AND ONLY IF it is NOT actively in progress AND (isProgressFull OR explicitly marked complete)
                        const isWatchedFull = Boolean(!isActivelyInProgress && (isProgressFull || (lastLesson && lastLesson.isCompleted === true)));
                        let activeLessonThumb = (lastLesson && (lastLesson.thumbnail || (lastLesson.course && lastLesson.course.thumbnail))) || '';
                        if (activeLessonThumb && !activeLessonThumb.startsWith('http') && !activeLessonThumb.startsWith('/')) {
                            activeLessonThumb = '/' + activeLessonThumb;
                        }
                    %>


                    <!-- 1. SMART SUGGESTED EXAM (Standalone Spotlight Card) -->
                    <% if (locals.suggestedExam) { %>
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative group">
                        <!-- Top Row: Simple Free Icon + 2-3 Word Hook + Points / Duration -->
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 sm:size-9 rounded-xl <%= suggestedExam.type === 'live' ? 'bg-rose-500/15 border border-rose-500/30 text-rose-600' : (suggestedExam.type === 'popular' ? 'bg-amber-500/15 border border-amber-500/30 text-amber-600' : 'bg-teal-700/15 border border-teal-700/30 text-teal-800 dark:text-teal-300') %> flex items-center justify-center shrink-0">
                                    <% if (suggestedExam.type === 'live') { %>
                                        <i class="fa-solid fa-circle-dot text-sm sm:text-base animate-pulse"></i>
                                    <% } else if (suggestedExam.type === 'popular') { %>
                                        <i class="fa-solid fa-fire text-sm sm:text-base"></i>
                                    <% } else { %>
                                        <i class="fa-solid fa-clipboard-check text-sm sm:text-base"></i>
                                    <% } %>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs sm:text-[13px] font-bold <%= suggestedExam.type === 'live' ? 'text-rose-500' : (suggestedExam.type === 'popular' ? 'text-amber-500' : 'text-teal-700 dark:text-teal-400') %>">
                                    <% if (suggestedExam.type === 'live') { %>
                                        <span>লাইভ এক্সাম</span>
                                    <% } else if (suggestedExam.type === 'popular') { %>
                                        <span>জনপ্রিয় টেস্ট</span>
                                    <% } else { %>
                                        <span>কুইজ চ্যালেঞ্জ</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <% if (suggestedExam.duration) { %>
                                    <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">⏱️ <%= suggestedExam.duration %>m</span>
                                    <span class="text-slate-300 dark:text-slate-700">·</span>
                                <% } %>
                                <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-500/20 border border-amber-600/30 flex items-center gap-1">
                                    <i class="fa-solid fa-bolt text-[10px]"></i> +50 XP
                                </span>
                            </div>
                        </div>

                        <!-- Title & Subject Row (Full width, clear and prominent) -->
                        <div class="min-w-0 pt-0.5">
                            <a href="<%= suggestedExam.url %>" class="block text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 truncate hover:text-teal-700 dark:hover:text-teal-300 transition-colors" title="<%= suggestedExam.title %>">
                                <%= suggestedExam.title %>
                            </a>
                            <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate font-medium mt-0.5">
                                <%= suggestedExam.subject %><% if (suggestedExam.examTakers && suggestedExam.examTakers >= 30) { %> · <%= suggestedExam.examTakers %> জন পরীক্ষা দিয়েছে<% } %>
                            </p>
                        </div>

                        <!-- Live Glassmorphism Action: Shorter Button at the Left with Live Blowing Effect -->
                        <div class="pt-1.5 flex items-center justify-start">
                            <a href="<%= suggestedExam.url %>" 
                               class="inline-flex items-center justify-center gap-2 py-1.5 sm:py-2 px-4 sm:px-5 rounded-xl backdrop-blur-md font-bold text-xs sm:text-sm transition-all duration-300 active:scale-95 <%= suggestedExam.type === 'live' ? 'bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/40 text-rose-600 dark:text-rose-400 live-blowing-rose' : 'bg-teal-600/15 hover:bg-teal-600/25 border border-teal-500/40 text-teal-800 dark:text-teal-200 live-blowing-teal' %>">
                                <i class="fa-solid fa-play text-[10px] <%= suggestedExam.type === 'live' ? 'text-rose-500' : 'text-teal-600 dark:text-teal-300' %>"></i>
                                <span><%= suggestedExam.type === 'live' ? 'Join' : 'Start' %></span>
                            </a>
                        </div>
                    </div>
                    <style>
                    @keyframes liveBlowTeal {
                        0%, 100% {
                            box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.4), 0 0 8px rgba(20, 184, 166, 0.2);
                            transform: scale(1);
                        }
                        50% {
                            box-shadow: 0 0 0 5px rgba(20, 184, 166, 0), 0 0 16px rgba(20, 184, 166, 0.45);
                            transform: scale(1.02);
                        }
                    }
                    @keyframes liveBlowRose {
                        0%, 100% {
                            box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.45), 0 0 10px rgba(244, 63, 94, 0.25);
                            transform: scale(1);
                        }
                        50% {
                            box-shadow: 0 0 0 6px rgba(244, 63, 94, 0), 0 0 18px rgba(244, 63, 94, 0.5);
                            transform: scale(1.02);
                        }
                    }
                    .live-blowing-teal {
                        animation: liveBlowTeal 2.4s infinite ease-in-out;
                    }
                    .live-blowing-rose {
                        animation: liveBlowRose 1.8s infinite ease-in-out;
                    }
                    </style>
                    <% } %>

                    <!-- 2. VIDEO LESSON WATCH TRACKER (Standalone, Matching Quick Quiz Aesthetics) -->
                    <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col p-3.5 sm:p-4 transition-all gap-2.5 relative group">
                        
                        <!-- Top Row: Icon with BG (like Quick Quiz) + Title + Concise 2-Word Text & +30 XP -->
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="size-8 sm:size-9 rounded-xl <%= (lastLesson && !isWatchedFull) ? 'bg-rose-500/15 border border-rose-500/30 text-rose-600' : 'bg-teal-700/15 border border-teal-700/30 text-teal-800 dark:text-teal-300' %> flex items-center justify-center shrink-0">
                                    <% if (lastLesson && !isWatchedFull) { %>
                                        <i class="fa-solid fa-play text-xs sm:text-sm text-rose-500 animate-pulse"></i>
                                    <% } else { %>
                                        <i class="fa-solid fa-play text-xs sm:text-sm text-teal-700 dark:text-teal-300"></i>
                                    <% } %>
                                </div>
                                <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 antialiased truncate">
                                    ভিডিও লেসন ওয়াচ ট্র্যাকার
                                </h3>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <span id="activity-count-video" class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">
                                    দৈনিক লেসন
                                </span>
                                <span class="text-slate-300 dark:text-slate-700">·</span>
                                <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-500/20 border border-amber-600/30 flex items-center gap-1">
                                    <i class="fa-solid fa-bolt text-[10px]"></i> +30 XP
                                </span>
                            </div>
                        </div>

                        <!-- Hidden helper element for script compatibility -->
                        <span id="activity-count-video-mobile" class="hidden"></span>
                        <span id="todayXpBadge" class="hidden"></span>

                        <% if (lastLesson && !isWatchedFull) { %>
                            <!-- Uncompleted Video Details (Title, Course & Thumbnail) with comfortable gap from section header -->
                            <div class="flex items-center gap-3 pt-2 sm:pt-2.5 min-w-0">
                                <a href="/course-details/<%= lastLesson.course._id %>?lesson=<%= lastLesson.lessonId %>&time=<%= lastLesson.lastPosition || 0 %>&from=dashboard" 
                                   class="relative size-12 sm:size-14 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center group/thumb shadow-xs">
                                    <% if (activeLessonThumb) { %>
                                        <img src="<%= activeLessonThumb %>" class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform" alt="<%= lastLesson.lessonTitle %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <div class="w-full h-full items-center justify-center bg-teal-950" style="display:none;">
                                            <i class="fa-solid fa-play text-xs text-teal-300"></i>
                                        </div>
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center bg-teal-950">
                                            <i class="fa-solid fa-play text-xs text-teal-300"></i>
                                        </div>
                                    <% } %>
                                    <div class="absolute inset-0 bg-black/25 flex items-center justify-center">
                                        <i class="fa-solid fa-play text-[10px] text-white"></i>
                                    </div>
                                </a>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1 text-[10px] font-bold text-rose-500 mb-0.5">
                                        <i class="fa-solid fa-clock-rotate-left text-[9px]"></i>
                                        <span>চলমান লেসন</span>
                                    </div>
                                    <a href="/course-details/<%= lastLesson.course._id %>?lesson=<%= lastLesson.lessonId %>&time=<%= lastLesson.lastPosition || 0 %>&from=dashboard" 
                                       class="block text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 truncate hover:text-teal-700 dark:hover:text-teal-300 transition-colors" 
                                       title="<%= lastLesson.lessonTitle %>">
                                        <%= lastLesson.lessonTitle %>
                                    </a>
                                    <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate font-medium mt-0.5">
                                        <%= lastLesson.course.title %>
                                    </p>
                                </div>
                            </div>

                            <!-- Stylish Glassmorphism Action Button: Left-aligned with comfortable gap -->
                            <div class="pt-2.5 sm:pt-3 flex items-center justify-start">
                                <a href="/course-details/<%= lastLesson.course._id %>?lesson=<%= lastLesson.lessonId %>&time=<%= lastLesson.lastPosition || 0 %>&from=dashboard" 
                                   class="inline-flex items-center justify-center gap-2 py-1.5 sm:py-2 px-4 sm:px-5 rounded-xl backdrop-blur-md font-bold text-xs sm:text-sm transition-all duration-300 active:scale-95 bg-teal-600/15 hover:bg-teal-600/25 dark:bg-teal-500/15 dark:hover:bg-teal-500/25 border border-teal-500/35 text-teal-800 dark:text-teal-200 shadow-xs">
                                    <i class="fa-solid fa-play text-[10px] text-teal-600 dark:text-teal-300"></i>
                                    <span>Resume</span>
                                </a>
                            </div>
                        <% } else { %>
                            <!-- When NO uncompleted video: Explore / Watch Prompt -->
                            <div class="min-w-0 pt-2 sm:pt-2.5">
                                <p class="text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300">
                                    আজকের পড়ালেখা এগিয়ে নিতে আপনার কোর্সের নতুন ভিডিও লেসন দেখুন
                                </p>
                            </div>

                            <!-- Stylish Glassmorphism Action Button: Left-aligned -->
                            <div class="pt-2.5 sm:pt-3 flex items-center justify-start">
                                <a href="/courses" 
                                   class="inline-flex items-center justify-center gap-2 py-1.5 sm:py-2 px-4 sm:px-5 rounded-xl backdrop-blur-md font-bold text-xs sm:text-sm transition-all duration-300 active:scale-95 bg-teal-600/15 hover:bg-teal-600/25 dark:bg-teal-500/15 dark:hover:bg-teal-500/25 border border-teal-500/35 text-teal-800 dark:text-teal-200 shadow-xs">
                                    <i class="fa-solid fa-play text-[10px] text-teal-600 dark:text-teal-300"></i>
                                    <span>Watch</span>
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <!-- SECTION 2: BOOKMARKS & WEAK AREA RADAR (Side-by-side with balanced perfection) -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5 w-full items-stretch">

                        <!-- 1. BOOKMARKS WIDGET (Perfected Design) -->
                        <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all">
                            <div class="flex items-center justify-between px-4 sm:px-5 py-3.5 border-b border-slate-200/80 dark:border-slate-800/80">
                                <div class="flex items-center gap-2.5">
                                    <div class="size-8 sm:size-9 rounded-xl bg-teal-500/15 border border-teal-500/30 text-teal-700 dark:text-teal-300 flex items-center justify-center shrink-0">
                                        <i class="fa-solid fa-bookmark text-sm sm:text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 leading-tight antialiased">
                                            Bookmarks
                                        </h3>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">সংরক্ষিত নোট ও বই</p>
                                    </div>
                                </div>
                                <span id="bookmarkCountBadge" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-teal-500/15 text-teal-800 dark:text-teal-300 border border-teal-500/25 flex items-center gap-1.5">
                                    <i class="fa-regular fa-bookmark text-[10px]"></i> <%= (locals.savedBookmarks || []).length %> Items
                                </span>
                            </div>
                            
                            <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                                <div class="space-y-2.5" id="bookmarkListContainer">
                                    <% if (locals.savedBookmarks && savedBookmarks.length > 0) { %>
                                        <% savedBookmarks.forEach(bm => { 
                                            const isNote = bm.itemType === 'note' || (bm.link && (bm.link.includes('note') || bm.link.includes('/note-viewer/')));
                                            const isBook = bm.itemType === 'book' || (bm.link && (bm.link.includes('library') || bm.link.includes('.pdf') || bm.link.includes('book')));
                                            const linkStr = (bm.link || '').toLowerCase();
                                            const isDirectDoc = linkStr.endsWith('.pdf') || linkStr.endsWith('.jpg') || linkStr.endsWith('.jpeg') || linkStr.endsWith('.png');
                                        %>
                                            <div class="flex items-center justify-between p-2.5 sm:p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-xs group hover:border-teal-500/40 hover:bg-teal-50/30 dark:hover:bg-slate-800 transition-all shadow-2xs gap-2" id="bm-item-<%= bm._id %>">
                                                <% if (isDirectDoc) { %>
                                                    <div onclick="openMediaViewer('<%= bm.link.replace(/'/g, "\\'") %>', '<%= bm.title.replace(/'/g, "\\'") %>')" class="flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer">
                                                <% } else { %>
                                                    <a href="<%= bm.link %>" class="flex items-center gap-2.5 min-w-0 flex-1">
                                                <% } %>
                                                    <div class="size-7 rounded-lg flex items-center justify-center shrink-0 <%= isNote ? 'bg-amber-500/15 text-amber-600 dark:text-amber-400' : (isBook ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400' : 'bg-teal-500/15 text-teal-600 dark:text-teal-400') %>">
                                                        <i class="fa-solid <%= isNote ? 'fa-file-lines' : (isBook ? 'fa-book-open' : 'fa-bookmark') %> text-xs"></i>
                                                    </div>
                                                    <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 truncate group-hover:text-teal-700 dark:group-hover:text-teal-300 transition-colors"><%= bm.title %></span>
                                                    <% if (isNote) { %>
                                                        <span class="text-[9px] font-bold text-amber-800 dark:text-amber-300 bg-amber-500/20 border border-amber-500/30 px-1.5 py-0.5 rounded-md shrink-0 ml-auto mr-1">Note</span>
                                                    <% } else if (isBook) { %>
                                                        <span class="text-[9px] font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-500/20 border border-emerald-500/30 px-1.5 py-0.5 rounded-md shrink-0 ml-auto mr-1">Book</span>
                                                    <% } else { %>
                                                        <span class="text-[9px] font-bold text-teal-800 dark:text-teal-300 bg-teal-500/20 border border-teal-500/30 px-1.5 py-0.5 rounded-md shrink-0 ml-auto mr-1">Saved</span>
                                                    <% } %>
                                                <% if (isDirectDoc) { %>
                                                    </div>
                                                <% } else { %>
                                                    </a>
                                                <% } %>
                                                <button onclick="removeBookmark('<%= bm._id %>')" class="size-7 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 flex items-center justify-center transition-colors shrink-0 cursor-pointer" title="Remove">
                                                    <i class="fa-regular fa-trash-can text-xs"></i>
                                                </button>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="text-center py-8 my-auto flex flex-col items-center justify-center">
                                            <div class="size-12 rounded-2xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-2.5">
                                                <i class="fa-solid fa-bookmark text-lg"></i>
                                            </div>
                                            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-bold">কোনো সেভ করা নোট বা বই নেই</p>
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">গুরুত্বপূর্ণ লেকচার নোট বা বই সেভ করে রাখুন</p>
                                            <div class="mt-3.5 flex items-center justify-center gap-2.5">
                                                <a href="/notes" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                                    <i class="fa-solid fa-file-lines text-[10px]"></i>
                                                    <span>Notes</span>
                                                </a>
                                                <a href="/library" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                                    <i class="fa-solid fa-book-open text-[10px]"></i>
                                                    <span>Library</span>
                                                </a>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- 2. WEAK AREA RADAR WIDGET (Placed beside Bookmarks with perfection) -->
                        <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all">
                            <div class="flex items-center justify-between px-4 sm:px-5 py-3.5 border-b border-slate-200/80 dark:border-slate-800/80">
                                <div class="flex items-center gap-2.5">
                                    <div class="size-8 sm:size-9 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                                        <i class="fa-solid fa-crosshairs text-sm sm:text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 leading-tight antialiased">
                                            Weak Area Radar
                                        </h3>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">স্মার্ট রিভিশন ট্র্যাকার</p>
                                    </div>
                                </div>
                                <% 
                                    const focusCount = (locals.weakAreas && weakAreas.weakTopics && weakAreas.moderateTopics) 
                                        ? (weakAreas.weakTopics.length + weakAreas.moderateTopics.length) 
                                        : 0;
                                    const hasRadarData = Boolean(locals.weakAreas && weakAreas.hasData);
                                    const isMastered = hasRadarData && (weakAreas.overallAccuracy >= 70);
                                %>
                                <span id="weakAreaFocusBadge" class="px-2.5 py-1 rounded-lg text-[11px] font-bold <%= focusCount > 0 ? 'bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30' : (hasRadarData && !isMastered ? 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30' : 'bg-teal-800/15 text-teal-900 dark:text-teal-300 border border-teal-700/20') %> inline-flex items-center justify-center gap-1.5 leading-none select-none">
                                    <i class="fa-solid <%= focusCount > 0 ? 'fa-bullseye' : (hasRadarData && !isMastered ? 'fa-chart-line' : 'fa-circle-check') %> text-[10px]"></i>
                                    <span><%= focusCount > 0 ? `${focusCount} Focus Areas` : (hasRadarData && !isMastered ? 'Needs Practice' : 'Optimal') %></span>
                                </span>
                            </div>

                            <div id="weakAreaRadarBody" class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                                <% if (locals.weakAreas && weakAreas.hasData && focusCount > 0) { %>
                                    <!-- Top Mini Stats Row -->
                                    <div class="grid grid-cols-3 gap-2 mb-3 text-center">
                                        <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                                            <p class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold">Analyzed</p>
                                            <p class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 mt-0.5"><%= weakAreas.totalAnalyzed %> Qs</p>
                                        </div>
                                        <div class="p-2 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200/60 dark:border-rose-900/40">
                                            <p class="text-[9px] text-rose-600 dark:text-rose-400 font-semibold">Mistakes</p>
                                            <p class="text-xs sm:text-sm font-bold text-rose-700 dark:text-rose-300 mt-0.5"><%= weakAreas.totalMistakes %></p>
                                        </div>
                                        <div class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-900/40">
                                            <p class="text-[9px] text-emerald-600 dark:text-emerald-400 font-semibold">Accuracy</p>
                                            <p class="text-xs sm:text-sm font-bold text-emerald-700 dark:text-emerald-300 mt-0.5"><%= weakAreas.overallAccuracy %>%</p>
                                        </div>
                                    </div>

                                    <!-- Weak Topics List -->
                                    <div id="weakTopicsListContainer" class="space-y-2.5">
                                        <% 
                                            const displayTopics = [...weakAreas.weakTopics, ...weakAreas.moderateTopics].slice(0, 5);
                                            displayTopics.forEach((t, tIdx) => { 
                                                 const isCrit = t.status === 'critical';
                                        %>
                                            <div data-topic="<%= t.topic.replace(/"/g, '&quot;') %>" class="p-2.5 sm:p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border <%= isCrit ? 'border-rose-300/80 dark:border-rose-800/60' : 'border-amber-300/80 dark:border-amber-800/60' %> transition-all shadow-2xs">
                                                <div class="flex items-start justify-between gap-1.5">
                                                    <div class="min-w-0 flex-1">
                                                        <div class="flex items-center gap-1.5 flex-wrap">
                                                            <span class="text-[9px] font-extrabold uppercase tracking-wide px-1.5 py-0.5 rounded <%= isCrit ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 border border-rose-200' : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border border-amber-200' %>">
                                                                 <%= t.subject %>
                                                            </span>
                                                            <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">
                                                                Score: <%= (t.marksObtained !== undefined ? t.marksObtained : 0) %>/<%= (t.maxMarks !== undefined ? t.maxMarks : t.total) %> · <%= t.wrong > 0 ? ('Wrong: ' + t.wrong) : '' %><%= (t.wrong > 0 && t.skipped > 0) ? ', ' : '' %><%= t.skipped > 0 ? ('Skipped: ' + t.skipped) : '' %><% if (t.wrong === 0 && t.skipped === 0) { %>Correct: <%= t.correct %><% } %>
                                                            </span>
                                                        </div>
                                                        <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 mt-1 truncate" title="<%= t.topic %>">
                                                            <%= t.topic %>
                                                        </h4>
                                                    </div>
                                                    <span class="text-xs font-black shrink-0 <%= isCrit ? 'text-rose-600 dark:text-rose-400' : 'text-amber-600 dark:text-amber-400' %>">
                                                        <%= t.accuracy %>%
                                                    </span>
                                                </div>

                                                <!-- Mini Accuracy Progress Bar -->
                                                <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden mt-2">
                                                    <div class="h-full rounded-full <%= isCrit ? 'bg-rose-500' : 'bg-amber-500' %>" style="width: <%= Math.min(100, Math.max(0, t.accuracy || 0)) %>%"></div>
                                                </div>

                                                <!-- Actions: Watch Lesson/Practice + Set Reminder -->
                                                <div class="flex items-center justify-between gap-1.5 mt-2.5 pt-1.5 border-t border-slate-200/60 dark:border-slate-700/60">
                                                    <a href="<%= t.revisionLink %>" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-800 dark:text-teal-300 hover:text-teal-950 transition-colors">
                                                        <i class="fa-solid <%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'fa-circle-play' : 'fa-pen-to-square' %> text-[11px]"></i>
                                                        <span><%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'Revision Class' : 'Practice' %></span>
                                                    </a>
                                                    <button onclick="openReminderTimerModal('<%= t.topic %>', '<%= t.subject %>', '<%= t.revisionLink %>', this)" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-500/15 hover:bg-amber-500/25 text-amber-800 dark:text-amber-300 border border-amber-500/30 transition-colors cursor-pointer" title="Schedule revision reminder">
                                                        <i class="fa-regular fa-bell text-[10px]"></i>
                                                        <span>Reminder</span>
                                                    </button>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else if (locals.weakAreas && weakAreas.hasData) { %>
                                    <% if (weakAreas.overallAccuracy < 70) { %>
                                        <!-- Needs More Practice State -->
                                        <div class="text-center py-8 my-auto flex flex-col items-center gap-2.5">
                                            <div class="size-12 rounded-2xl bg-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center shadow-xs">
                                                <i class="fa-solid fa-chart-line text-lg"></i>
                                            </div>
                                            <div>
                                                <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">Keep Practicing!</h4>
                                                <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[240px] mx-auto">Your recent accuracy is <%= weakAreas.overallAccuracy %>%. Consistent practice will help you improve.</p>
                                            </div>
                                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-xl text-xs font-bold transition-colors shadow-xs">
                                                <span>Start Practice Exam</span>
                                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <!-- Excellent Mastery State -->
                                        <div class="text-center py-8 my-auto flex flex-col items-center gap-2.5">
                                            <div class="size-12 rounded-2xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shadow-xs">
                                                <i class="fa-solid fa-certificate text-lg"></i>
                                            </div>
                                            <div>
                                                <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">Excellent Mastery!</h4>
                                                <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[240px] mx-auto">No weak topics identified. Your recent accuracy is <%= weakAreas.overallAccuracy %>%, keep it up!</p>
                                            </div>
                                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 text-xs font-bold text-teal-800 dark:text-teal-300 hover:underline">
                                                <span>Take Model Test</span>
                                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                            </a>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <!-- Onboarding State -->
                                    <div class="text-center py-8 my-auto flex flex-col items-center gap-2.5">
                                        <div class="size-12 rounded-2xl bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shadow-xs">
                                            <i class="fa-solid fa-crosshairs text-lg"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">Smart Revision Radar</h4>
                                            <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[240px] mx-auto">Take exams to automatically track weak topics and receive revision suggestions.</p>
                                        </div>
                                        <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-xl text-xs font-bold transition-colors">
                                            <span>Start Practice Exam</span>
                                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div><!-- /SECTION 2: BOOKMARKS & WEAK AREA RADAR -->

                    <!-- SECTION 3: WEEKLY XP ACTIVITY CHART & LEADERBOARD (Side-by-side) -->
                    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-5 w-full items-stretch">
                        <div class="lg:col-span-3 w-full flex flex-col">
                            <!-- 3. Weekly XP Activity Chart (Matching Actual Page Background as Others) -->
                            <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all relative">
                        <div class="flex items-center justify-between px-5 sm:px-6 py-3.5 border-b border-slate-200/80 dark:border-slate-800/80">
                            <div class="flex items-center gap-2.5">
                                <div class="size-8 rounded-xl bg-indigo-500/15 dark:bg-indigo-500/25 flex items-center justify-center text-indigo-600 dark:text-rose-400 shrink-0">
                                    <span class="material-symbols-rounded text-lg leading-none">show_chart</span>
                                </div>
                                <div>
                                    <h2 class="font-semibold text-sm sm:text-base text-slate-800 dark:text-slate-200 leading-tight antialiased">Weekly Activity</h2>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Momentum & XP Progress</p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-indigo-200 border border-slate-200 dark:border-white/10">
                                7 Days XP
                            </span>
                        </div>

                        <div class="px-3 sm:px-5 pt-3 pb-5 flex-1 flex flex-col justify-center">
                            <%
                                const weekLabels = locals.chartLabels || ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                                const weekData   = locals.chartData  || [0,0,0,0,0,0,0];
                                const wMax = Math.max(...weekData, 1);
                                const W = 500, H = 200, padL = 22, padR = 22, padT = 25, padB = 35;
                                const innerW = W - padL - padR;
                                const innerH = H - padT - padB;
                                const pts = weekData.map((v, i) => {
                                    const x = padL + (i / (weekLabels.length - 1)) * innerW;
                                    const y = padT + innerH - (v / wMax) * innerH;
                                    return { x, y, v, label: weekLabels[i] };
                                });

                                // Ultra smooth curved bezier path across 500px canvas
                                let pathD = `M ${pts[0].x} ${pts[0].y}`;
                                for (let i = 1; i < pts.length; i++) {
                                    const cp1x = (pts[i - 1].x + pts[i].x) / 2;
                                    const cp1y = pts[i - 1].y;
                                    const cp2x = (pts[i - 1].x + pts[i].x) / 2;
                                    const cp2y = pts[i].y;
                                    pathD += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${pts[i].x} ${pts[i].y}`;
                                }
                                const areaD = `${pathD} L ${pts[pts.length - 1].x} ${padT + innerH} L ${pts[0].x} ${padT + innerH} Z`;

                                // Colors for point node borders matching line gradient
                                const pointColors = [
                                    '#F43F5E', // Coral Pink
                                    '#FB7185', // Coral Pink
                                    '#A855F7', // Purple
                                    '#8B5CF6', // Purple
                                    '#6366F1', // Indigo / Blue-Purple
                                    '#0EA5E9', // Bright Light Blue
                                    '#38BDF8'  // Bright Light Blue
                                ];
                            %>
                            <div class="relative w-full flex-1">
                                <svg viewBox="0 0 500 200" class="w-full h-44 sm:h-52 overflow-visible" style="display:block;">
                                    <defs>
                                        <!-- Line Glow Filter -->
                                        <filter id="lineGlow" x="-20%" y="-20%" width="140%" height="140%">
                                            <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#8B5CF6" flood-opacity="0.3" />
                                        </filter>

                                        <!-- Continuous Line Gradient: Coral Pink -> Purple -> Bright Light Blue -->
                                        <linearGradient id="chartLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#F43F5E" />
                                            <stop offset="50%" stop-color="#8B5CF6" />
                                            <stop offset="100%" stop-color="#38BDF8" />
                                        </linearGradient>

                                        <!-- Soft Semi-Transparent Gradient Area Fill -->
                                        <linearGradient id="chartAreaGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#F43F5E" stop-opacity="0.2" />
                                            <stop offset="50%" stop-color="#8B5CF6" stop-opacity="0.18" />
                                            <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.2" />
                                        </linearGradient>
                                        
                                        <!-- Vertical Fade for Area Fill -->
                                        <linearGradient id="areaFade" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
                                        </linearGradient>

                                        <mask id="areaMask">
                                            <rect x="0" y="0" width="500" height="200" fill="url(#areaFade)" />
                                        </mask>
                                    </defs>

                                    <!-- Horizontal Grid Lines -->
                                    <% [0, 50, 100].forEach(pct => {
                                        const gy = padT + innerH - (pct / 100) * innerH;
                                    %>
                                        <line x1="<%= padL %>" y1="<%= gy %>" x2="<%= W - padR %>" y2="<%= gy %>"
                                              stroke="#94a3b8" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="4,4"/>
                                    <% }) %>

                                    <!-- Soft Semi-Transparent Gradient Area Fill -->
                                    <path d="<%= areaD %>" fill="url(#chartAreaGrad)" mask="url(#areaMask)" />

                                    <!-- Main Smooth Curved Line (Coral Pink -> Purple -> Bright Light Blue) -->
                                    <path d="<%= pathD %>" fill="none" stroke="url(#chartLineGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#lineGlow)"/>

                                    <!-- Interactive Data Points & Tooltips -->
                                    <% pts.forEach((p, i) => { 
                                        const pColor = pointColors[i] || '#8B5CF6';
                                    %>
                                        <g class="weekly-point-group" style="cursor:pointer;">
                                            <!-- Hover Trigger Zone -->
                                            <rect x="<%= p.x - (innerW / 12) %>" y="0" width="<%= innerW / 6 %>" height="200" fill="transparent" class="point-hover-strip" />
                                            
                                            <!-- Dotted Vertical Guide Line -->
                                            <line x1="<%= p.x %>" y1="<%= p.y %>" x2="<%= p.x %>" y2="<%= padT + innerH %>" stroke="#94a3b8" stroke-opacity="0.4" opacity="0" class="guide-line transition-opacity" stroke-dasharray="2,2"/>
                                            
                                            <!-- Data Node: White Center + Border matching line gradient at point -->
                                            <circle cx="<%= p.x %>" cy="<%= p.y %>" r="6" fill="#FFFFFF" stroke="<%= pColor %>" stroke-width="3.5" class="point-dot transition-all duration-200 drop-shadow-md" />
                                            
                                            <!-- Tooltip -->
                                            <g class="weekly-tooltip" opacity="0" style="transition:all 0.2s">
                                                <rect x="<%= p.x - 28 %>" y="<%= p.y - 36 %>" width="56" height="25" rx="7" fill="#0f172a" class="shadow-xl"/>
                                                <polygon points="<%= p.x - 4 %>,<%= p.y - 11 %> <%= p.x + 4 %>,<%= p.y - 11 %> <%= p.x %>,<%= p.y - 6 %>" fill="#0f172a"/>
                                                <text x="<%= p.x %>" y="<%= p.y - 19 %>" text-anchor="middle"
                                                      font-size="11" font-weight="800" fill="#FFFFFF" font-family="sans-serif"><%= p.v %> XP</text>
                                            </g>
                                        </g>
                                    <% }) %>

                                    <!-- X-Axis Day Labels -->
                                    <% pts.forEach((p, i) => { %>
                                        <text x="<%= p.x %>" y="<%= H - 8 %>" text-anchor="middle"
                                              font-size="11" font-weight="700" class="fill-slate-500 dark:fill-slate-400" font-family="sans-serif">
                                            <%= p.label %>
                                        </text>
                                    <% }) %>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <style>
                        .weekly-point-group:hover .weekly-tooltip { opacity: 1 !important; transform: translateY(-2px); }
                        .weekly-point-group:hover .guide-line { opacity: 1 !important; }
                        .weekly-point-group:hover .point-dot { r: 8 !important; stroke-width: 4 !important; filter: brightness(1.2); }
                    </style>
                        </div><!-- /lg:col-span-3 -->

                        <div class="lg:col-span-2 w-full flex flex-col">
                            <!-- 4. Leaderboard -->
                            <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all">
                                <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-200/80 dark:border-slate-800/80">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-[#F43F5E] text-lg shrink-0 flex items-center justify-center -mt-0.5">military_tech</span>
                                <h2 class="font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-tight antialiased">Leaderboard</h2>
                            </div>
                            <span class="text-[11px] font-bold text-slate-600 dark:text-slate-300"><%= (locals.leaderboard && leaderboard[0]) ? (leaderboard[0].classLevel || user.classLevel || '') : '' %> · XP Rankings</span>
                        </div>
                        <div class="p-3.5 sm:p-4 flex-1 flex flex-col gap-2.5">
                            <div class="rounded-xl overflow-hidden w-full divide-y divide-slate-200/60 dark:divide-slate-800/60">
                                <% if (locals.leaderboard && leaderboard.length > 0) { %>
                                    <% leaderboard.slice(0, 10).forEach((entry, index) => { 
                                        const isMe = user && entry._id && entry._id.toString() === user._id.toString();
                                    %>
                                        <div class="flex items-center gap-2.5 px-3 py-2 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors w-full <%= isMe ? 'bg-slate-100/70 dark:bg-emerald-900/30' : '' %>">
                                            <div class="size-5.5 rounded-full flex items-center justify-center font-bold text-xs shrink-0 <%= index === 0 ? 'bg-amber-100 text-amber-600 border border-amber-300' : index === 1 ? 'bg-slate-200 text-slate-600' : index === 2 ? 'bg-orange-100 text-orange-600' : 'bg-white/80 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">
                                                <%= index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : index + 1 %>
                                            </div>
                                            <div class="size-5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-[9px] shrink-0 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                                                <% if (entry.profileImage) { %>
                                                    <img src="<%= entry.profileImage %>" class="size-full object-cover">
                                                <% } else { %>
                                                    <%= entry.name ? entry.name[0].toUpperCase() : 'S' %>
                                                <% } %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate <%= isMe ? 'text-[#F43F5E]' : '' %>">
                                                    <%= entry.name %><% if (isMe) { %> <span class="text-[9px] font-black text-[#F43F5E] bg-rose-50 dark:bg-rose-900/20 px-1.5 py-0.5 rounded-full ml-1">You</span><% } %>
                                                </p>
                                                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold"><%= entry.classLevel || '' %></p>
                                            </div>
                                            <div class="text-right shrink-0">
                                                <p class="font-bold text-xs text-[#F43F5E]"><%= (entry.totalXP || 0) %> XP</p>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center text-center py-5 gap-1.5">
                                        <span class="material-symbols-rounded text-2xl text-slate-400">leaderboard</span>
                                        <p class="text-xs font-bold text-slate-500">No students found yet</p>
                                    </div>
                                <% } %>
                            </div>
                            <a href="/leaderboard" class="w-full py-2 px-4 text-center text-xs font-bold text-[#F43F5E] hover:text-rose-600 bg-white/80 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 rounded-xl border border-slate-200 dark:border-slate-700 transition-all flex items-center justify-center gap-1.5 shadow-xs group">
                                <span>See Full Leaderboard</span>
                                <span class="material-symbols-rounded text-lg leading-none shrink-0 flex items-center justify-center -mt-0.5 transition-transform group-hover:translate-y-0.5">expand_more</span>
                            </a>
                        </div>
                    </div>
                </div><!-- /lg:col-span-2 -->

            </div><!-- /SECTION 3: WEEKLY XP ACTIVITY CHART & LEADERBOARD -->

            <div class="h-20 sm:h-24 lg:h-6 w-full shrink-0"></div><!-- Safe bottom spacing for mobile bottom nav -->
            </div><!-- /Main Dashboard Content Container -->


        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'dashboard' }) %>
    <%- include('partials/app-scripts') %>
    <script>
        function attendNotice(noticeId) {
            if (!noticeId) return;
            try {
                fetch('/api/attend-notice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ noticeId }),
                    keepalive: true
                }).catch(err => {});
            } catch (e) {}
        }

        function toggleDailyGoal(goalId, btn) {
            fetch('/api/toggle-daily-goal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ goalId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    window.location.reload();
                }
            }).catch(e => console.error(e));
        }

        function refreshDailyStats() {
            fetch('/api/daily-stats')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const badge = document.getElementById('todayXpBadge');
                        if (badge) badge.innerHTML = `<span class="material-symbols-rounded text-xs">bolt</span> +${data.todayXpEarned} XP Today`;
                        
                        const text = document.getElementById('todayXpText');
                        if (text) text.innerText = `+${data.todayXpEarned} XP Earned Today`;

                        const xpTextPill = document.getElementById('today-xp-text');
                        if (xpTextPill) xpTextPill.innerText = `${data.todayXpEarned} XP`;
                        
                        const bar = document.getElementById('todayXpBar');
                        if (bar) {
                            const pct = Math.min(100, Math.round((data.todayXpEarned / 100) * 100));
                            bar.style.width = pct + '%';
                        }
                        
                        const v = document.getElementById('activity-count-video');
                        if (v) v.innerText = `দৈনিক লেসন`;
                        const vMobile = document.getElementById('activity-count-video-mobile');
                        if (vMobile) vMobile.innerText = `দৈনিক লেসন`;
                        const vPill = document.getElementById('today-videos-count-text');
                        if (vPill) vPill.innerText = `${data.todayVideosCount} Class`;
                        
                        const q = document.getElementById('activity-count-quiz');
                        if (q) q.innerText = `আজকে দেওয়া হয়েছে: ${data.todayQuizzesCount}টি পরীক্ষা`;
                        const qMobile = document.getElementById('activity-count-quiz-mobile');
                        if (qMobile) qMobile.innerText = `আজকে দেওয়া হয়েছে: ${data.todayQuizzesCount}টি`;
                        const qPill = document.getElementById('today-quizzes-count-text');
                        if (qPill) qPill.innerText = `${data.todayQuizzesCount} Solved`;
                        
                        const n = document.getElementById('activity-count-note');
                        if (n) n.innerText = `আজকে পড়া হয়েছে: ${data.todayNotesCount}টি নোট/প্রশ্ন`;
                        const nPill = document.getElementById('today-notes-count-text');
                        if (nPill) nPill.innerText = `${(data.todayNotesCount + (data.todaySavedNotesCount || 0))} Saved/Viewed`;

                        const timePill = document.getElementById('today-active-time-text');
                        if (timePill) timePill.innerText = `${data.todayActiveMinutes || 0}m`;
                    }
                })
                .catch(e => {});
        }

        function trackActivity(type) {
            fetch('/api/track-activity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        function removeBookmark(bookmarkId) {
            fetch('/api/remove-bookmark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookmarkId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    const el = document.getElementById('bm-item-' + bookmarkId);
                    if (el) el.remove();
                    
                    const badge = document.getElementById('bookmarkCountBadge');
                    const remaining = document.querySelectorAll('#bookmarkListContainer > div[id^="bm-item-"]').length;
                    if (badge) {
                        badge.textContent = `${remaining} Items`;
                    }
                    if (remaining === 0) {
                        const container = document.getElementById('bookmarkListContainer');
                        if (container) {
                            container.innerHTML = `
                                <div class="text-center py-8 my-auto flex flex-col items-center justify-center">
                                    <div class="size-12 rounded-2xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-2.5">
                                        <i class="fa-solid fa-bookmark text-lg"></i>
                                    </div>
                                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-bold">কোনো সেভ করা নোট বা বই নেই</p>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">গুরুত্বপূর্ণ লেকচার নোট বা বই সেভ করে রাখুন</p>
                                    <div class="mt-3.5 flex items-center justify-center gap-2.5">
                                        <a href="/notes" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                            <i class="fa-solid fa-file-lines text-[10px]"></i>
                                            <span>Notes</span>
                                        </a>
                                        <a href="/library" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                            <i class="fa-solid fa-book-open text-[10px]"></i>
                                            <span>Library</span>
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    }
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        // Active Site Time Heartbeat Ping (Pings /api/active-heartbeat every 60 seconds when user is active)
        let isTabActive = true;
        window.addEventListener('focus', () => { isTabActive = true; refreshDailyStats(); });
        window.addEventListener('blur', () => { isTabActive = false; });

        setInterval(() => {
            if (isTabActive && !document.hidden) {
                fetch('/api/active-heartbeat', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            refreshDailyStats();
                        }
                    })
                    .catch(e => {});
            }
        }, 60000);

        function openReminderTimerModal(topic, subject, link, btn) {
            if (!window.Swal) {
                setRevisionReminder(topic, subject, link, 60, btn);
                return;
            }

            // Calculate minutes until 9:00 AM tomorrow
            const now = new Date();
            const morning = new Date();
            morning.setDate(morning.getDate() + 1);
            morning.setHours(9, 0, 0, 0);
            const morningMins = Math.max(1, Math.round((morning - now) / 60000));

            const htmlContent = `
                <div class="text-left font-sans text-xs space-y-3 pt-1">
                    <p class="text-slate-600 dark:text-slate-300 text-xs">
                        <strong>"${topic}"</strong> (${subject}) অধ্যায়টি পুনরায় রিভিশন দিতে কখন রিমাইন্ডার পেতে চান?
                    </p>
                    <div class="grid grid-cols-1 gap-2 text-slate-700 dark:text-slate-200">
                        <!-- Option: Custom Minutes (Recommended) -->
                        <label id="labelCustomTime" class="flex flex-col gap-2 p-2.5 rounded-xl border border-teal-300 dark:border-teal-700 bg-teal-50/60 dark:bg-teal-950/40 hover:bg-teal-50 dark:hover:bg-teal-950/60 cursor-pointer transition-all">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="reminderTime" value="custom" id="radioCustomTime" checked class="text-teal-600 focus:ring-teal-500 shrink-0">
                                <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                    <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                        <span class="material-symbols-rounded text-base text-teal-600 dark:text-teal-400 leading-none shrink-0 inline-flex items-center justify-center select-none">edit_calendar</span>
                                        <span class="truncate">নিজের মতো মিনিট নির্ধারণ করুন (প্রস্তাবিত)</span>
                                    </span>
                                    <span class="text-[10px] text-teal-700 dark:text-teal-300 font-bold px-2 py-0.5 rounded-md bg-teal-100/80 dark:bg-teal-900/60 shrink-0">প্রস্তাবিত</span>
                                </div>
                            </div>
                            <div id="customTimeBox" class="mt-1 pl-7">
                                <input type="number" id="customMinutesInput" min="1" max="10080" placeholder="কত মিনিট পর? (যেমন: ২০, ৪৫ বা ৬০)" class="w-full text-xs px-3 py-2 rounded-lg border border-teal-300 dark:border-teal-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 outline-none">
                            </div>
                        </label>

                        <!-- Option: 30 Minutes -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="30" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">hourglass_top</span>
                                    <span class="truncate">৩০ মিনিট পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৩০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 1 Hour -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="60" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-blue-500 dark:text-blue-400 leading-none shrink-0 inline-flex items-center justify-center select-none">schedule</span>
                                    <span class="truncate">১ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৬০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 2 Hours -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="120" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-indigo-500 dark:text-indigo-400 leading-none shrink-0 inline-flex items-center justify-center select-none">alarm</span>
                                    <span class="truncate">২ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">১২০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: Tomorrow Morning -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="${morningMins}" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">wb_sunny</span>
                                    <span class="truncate">আগামীকাল সকালে (সকাল ৯:০০)</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">সকাল ৯:০০</span>
                            </div>
                        </label>
                    </div>
                </div>
            `;

            Swal.fire({
                title: '<div class="flex items-center justify-center gap-2 text-base font-black"><span class="material-symbols-rounded text-teal-600 text-xl leading-none shrink-0 inline-flex items-center justify-center">alarm_on</span> রিভিশন রিমাইন্ডার শিডিউল</div>',
                html: htmlContent,
                showCancelButton: true,
                confirmButtonText: 'রিমাইন্ডার নিশ্চিত করুন',
                cancelButtonText: 'বাতিল',
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#94a3b8',
                customClass: {
                    popup: 'rounded-2xl dark:bg-slate-900 dark:text-slate-100',
                    confirmButton: 'rounded-xl text-xs font-bold px-4 py-2',
                    cancelButton: 'rounded-xl text-xs font-bold px-4 py-2'
                },
                didOpen: () => {
                    const radioButtons = document.querySelectorAll('input[name="reminderTime"]');
                    const customBox = document.getElementById('customTimeBox');
                    const customInput = document.getElementById('customMinutesInput');
                    const labelCustom = document.getElementById('labelCustomTime');

                    if (customInput) {
                        setTimeout(() => customInput.focus(), 150);
                    }

                    radioButtons.forEach(rb => {
                        rb.addEventListener('change', () => {
                            if (rb.value === 'custom') {
                                customBox.classList.remove('hidden');
                                labelCustom.classList.add('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                                customInput.focus();
                            } else {
                                customBox.classList.add('hidden');
                                labelCustom.classList.remove('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                            }
                        });
                    });
                },
                preConfirm: () => {
                    const selected = document.querySelector('input[name="reminderTime"]:checked');
                    if (!selected) {
                        Swal.showValidationMessage('দয়া করে একটি সময় নির্বাচন করুন');
                        return false;
                    }
                    if (selected.value === 'custom') {
                        const customVal = parseInt(document.getElementById('customMinutesInput').value, 10);
                        if (isNaN(customVal) || customVal < 1) {
                            Swal.showValidationMessage('দয়া করে সঠিক মিনিট (কমপক্ষে ১ মিনিট) লিখুন');
                            return false;
                        }
                        return customVal;
                    }
                    return parseInt(selected.value, 10);
                }
            }).then(result => {
                if (result.isConfirmed && typeof result.value === 'number') {
                    setRevisionReminder(topic, subject, link, result.value, btn);
                }
            });
        }

        async function setRevisionReminder(topic, subject, link, delayMinutes = 30, btn = null) {
            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs animate-spin shrink-0 inline-flex items-center justify-center leading-none">sync</span><span>সেট হচ্ছে...</span>';
                }
                const res = await fetch('/api/student/set-revision-reminder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topic, subject, link, delayMinutes })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'success',
                            title: 'রিভিশন রিমাইন্ডার সেট হয়েছে!',
                            text: data.message || `"${topic}" অধ্যায়ের জন্য রিমাইন্ডার সেট করা হয়েছে।`,
                            timer: 3500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        alert(data.message || `"${topic}"-এর জন্য রিমাইন্ডার সেট হয়েছে!`);
                    }
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-rounded text-xs text-emerald-500 shrink-0 inline-flex items-center justify-center leading-none">check</span><span>রিমাইন্ডার সেট</span>';
                        btn.classList.remove('bg-amber-500/15', 'text-amber-800', 'dark:text-amber-300');
                        btn.classList.add('bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-300');

                        const card = btn.closest('[data-topic]');
                        if (card) {
                            setTimeout(() => {
                                card.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(-8px) scale(0.96)';
                                card.style.maxHeight = card.offsetHeight + 'px';
                                requestAnimationFrame(() => {
                                    card.style.maxHeight = '0px';
                                    card.style.paddingTop = '0px';
                                    card.style.paddingBottom = '0px';
                                    card.style.marginTop = '0px';
                                    card.style.marginBottom = '0px';
                                    card.style.borderWidth = '0px';
                                    card.style.overflow = 'hidden';
                                });
                                setTimeout(() => {
                                    card.remove();

                                    // Update remaining topics and badge
                                    const container = document.getElementById('weakTopicsListContainer');
                                    const remainingCards = container ? container.querySelectorAll('[data-topic]').length : 0;

                                    const badge = document.getElementById('weakAreaFocusBadge');
                                    if (badge) {
                                        if (remainingCards > 0) {
                                            badge.className = 'px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                                            badge.innerHTML = `<span class="material-symbols-rounded text-xs leading-none shrink-0 flex items-center justify-center select-none font-normal">crisis_alert</span> <span class="leading-none select-none">${remainingCards} Focus Areas</span>`;
                                        } else {
                                            badge.className = 'px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                                            badge.innerHTML = '<span class="material-symbols-rounded text-xs leading-none shrink-0 flex items-center justify-center select-none font-normal">alarm_on</span> <span class="leading-none select-none">Reminded</span>';
                                        }
                                    }

                                    if (remainingCards === 0) {
                                        const body = document.getElementById('weakAreaRadarBody');
                                        if (body) {
                                            body.innerHTML = `
                                                <div class="text-center py-5 my-auto flex flex-col items-center gap-2">
                                                    <div class="size-11 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center shadow-xs">
                                                        <span class="material-symbols-rounded text-2xl leading-none shrink-0 flex items-center justify-center select-none font-normal">alarm_on</span>
                                                    </div>
                                                    <div>
                                                        <h4 class="text-xs font-black text-slate-800 dark:text-slate-100">Keep Practicing!</h4>
                                                        <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-0.5 max-w-[220px] mx-auto">Reminders have been set for your topics. Continue practicing more exams and quizzes to master your subjects!</p>
                                                    </div>
                                                    <a href="/exams" class="mt-1 inline-flex items-center gap-1 px-3 py-1.5 bg-teal-800 hover:bg-teal-900 text-white rounded-lg text-xs font-bold transition-colors shadow-xs">
                                                        <span>Start Practice Exam</span>
                                                        <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center select-none leading-none font-normal">arrow_forward</span>
                                                    </a>
                                                </div>
                                            `;
                                        }
                                    }
                                }, 400);
                            }, 500);
                        }
                    }
                } else {
                    throw new Error(data.error || 'Failed to set reminder');
                }
            } catch (err) {
                console.error('Reminder error:', err);
                if (window.Swal) {
                    Swal.fire({
                        icon: 'error',
                        title: 'রিমাইন্ডার সেট করা যায়নি',
                        text: err.message,
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                } else {
                    alert('রিমাইন্ডার সেট করা যায়নি: ' + err.message);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs shrink-0 inline-flex items-center justify-center leading-none">alarm_on</span><span>রিমাইন্ডার</span>';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshDailyStats();

            // Mobile Unenrolled Course Carousel Controller (Center Snap & Auto-Scroll)
            const track = document.getElementById('unenrolledCarouselTrack');
            if (track) {
                const cards = track.querySelectorAll('.carousel-course-card');
                const dots = document.querySelectorAll('.unenrolled-dot');
                let currentIndex = 0;
                let autoTimer = null;
                let isInteracting = false;

                function getClosestIndex() {
                    const trackCenter = track.scrollLeft + track.offsetWidth / 2;
                    let closest = 0;
                    let minDiff = Infinity;
                    cards.forEach((card, idx) => {
                        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                        const diff = Math.abs(trackCenter - cardCenter);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closest = idx;
                        }
                    });
                    return closest;
                }

                function updateCardStates(activeIdx) {
                    cards.forEach((card, idx) => {
                        if (idx === activeIdx) {
                            card.classList.remove('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                            card.classList.add('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                        } else {
                            card.classList.remove('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                            card.classList.add('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                        }
                    });
                }

                function updateDots(activeIdx) {
                    dots.forEach((dot, idx) => {
                        if (idx === activeIdx) {
                            dot.classList.add('bg-indigo-600', 'w-3.5');
                            dot.classList.remove('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                        } else {
                            dot.classList.remove('bg-indigo-600', 'w-3.5');
                            dot.classList.add('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                        }
                    });
                }

                function scrollToCard(index) {
                    if (!cards[index]) return;
                    const card = cards[index];
                    const targetScroll = card.offsetLeft - (track.offsetWidth - card.offsetWidth) / 2;
                    track.scrollTo({ left: Math.max(0, targetScroll), behavior: 'smooth' });
                    currentIndex = index;
                    updateDots(index);
                    updateCardStates(index);
                }

                function startAutoPlay() {
                    stopAutoPlay();
                    if (cards.length <= 1) return;
                    autoTimer = setInterval(() => {
                        if (isInteracting) return;
                        currentIndex = (getClosestIndex() + 1) % cards.length;
                        scrollToCard(currentIndex);
                    }, 4500);
                }

                function stopAutoPlay() {
                    if (autoTimer) {
                        clearInterval(autoTimer);
                        autoTimer = null;
                    }
                }

                // Scroll detection to sync dots & shadow states
                track.addEventListener('scroll', () => {
                    const closest = getClosestIndex();
                    currentIndex = closest;
                    updateDots(closest);
                    updateCardStates(closest);
                }, { passive: true });

                // Touch & Pointer interaction pause
                track.addEventListener('touchstart', () => {
                    isInteracting = true;
                    stopAutoPlay();
                }, { passive: true });

                track.addEventListener('touchend', () => {
                    isInteracting = false;
                    setTimeout(startAutoPlay, 5000);
                }, { passive: true });

                // Tap on a non-presenting (shadowish) card to bring it to center
                cards.forEach((card, idx) => {
                    card.addEventListener('click', (e) => {
                        if (idx !== currentIndex) {
                            // If tapping an inactive card, center it smoothly
                            const clickedLink = e.target.closest('a');
                            if (!clickedLink) {
                                e.preventDefault();
                                stopAutoPlay();
                                scrollToCard(idx);
                                setTimeout(startAutoPlay, 5000);
                            }
                        }
                    });
                });

                // Dot click navigation
                dots.forEach(dot => {
                    dot.addEventListener('click', () => {
                        const targetIdx = parseInt(dot.getAttribute('data-dot-idx'), 10);
                        if (!isNaN(targetIdx)) {
                            stopAutoPlay();
                            scrollToCard(targetIdx);
                            setTimeout(startAutoPlay, 6000);
                        }
                    });
                });

                // Initialize states & start autoplay on mobile
                updateCardStates(0);
                if (window.innerWidth < 1024) {
                    startAutoPlay();
                }
            }
        });
    </script>
</body>
</html>