                    <div class="w-full border-b border-slate-200/80 dark:border-slate-800/80 my-0"></div>

                    <!-- 2. Daily Goals & Unlimited Activity Widget (#DEFFF1 Color Theme, Square Type) -->
                    <div class="w-full bg-[#DEFFF1] dark:bg-[#0c261e] text-slate-800 dark:text-slate-200 rounded-none border-0 overflow-hidden flex flex-col my-0 transition-all">
                        <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-900/10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-teal-800 text-lg shrink-0 flex items-center justify-center -mt-0.5">task_alt</span>
