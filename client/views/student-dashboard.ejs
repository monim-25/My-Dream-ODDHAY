                                                        <a href="<%= t.revisionLink || '/exams' %>" 
                                                           onclick="handleWeakAreaActivity(this, '<%= t.topic.replace(/'/g, "\\'") %>', '<%= (t.subject || '').replace(/'/g, "\\'") %>', 'practice')"
                                                           class="inline-flex items-center gap-1 text-[11px] font-bold text-teal-800 dark:text-teal-300 hover:text-teal-950 transition-colors"
                                                           title="রিভিশন ক্লাস বা প্র্যাকটিস করুন">
                                                            <i class="fa-solid <%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'fa-circle-play' : 'fa-pen-to-square' %> text-[10px]"></i>
                                                            <span><%= (t.revisionLink && t.revisionLink.includes('/course-details')) ? 'Class' : 'Practice' %></span>
                                                        </a>
                                                        <span class="text-slate-300 dark:text-slate-600">·</span>
                                                        <a href="<%= t.retestLink || '/exams' %>" 
                                                           onclick="handleWeakAreaActivity(this, '<%= t.topic.replace(/'/g, "\\'") %>', '<%= (t.subject || '').replace(/'/g, "\\'") %>', 'test_again')"
                                                           class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-700 dark:text-indigo-300 hover:text-indigo-900 transition-colors"
                                                           title="এই টপিকে পুনরায় পরীক্ষা দিন">
                                                            <i class="fa-solid fa-rotate-right text-[10px]"></i>
                                                            <span>Test Again</span>
                                                        </a>
                                                    </div>
                                                    <button type="button" 
                                                            data-topic="<%= t.topic %>" 
                                                            data-subject="<%= t.subject || '' %>" 
                                                            data-link="<%= t.revisionLink || '/exams' %>"
                                                            onclick="openReminderTimerModalFromBtn(this)" 
                                                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold <%= t.isReminded ? 'bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/15 hover:bg-amber-500/25 text-amber-800 dark:text-amber-300 border border-amber-500/30' %> transition-colors cursor-pointer shrink-0" 
                                                            title="<%= t.isReminded ? 'রিমাইন্ডার আপডেট করুন' : 'রিভিশন রিমাইন্ডার সেট করুন' %>">
                                                        <i class="fa-<%= t.isReminded ? 'solid fa-check' : 'regular fa-bell' %> text-[10px]"></i>
                                                        <span><%= t.isReminded ? 'রিমাইন্ডার সেট' : 'Reminder' %></span>
                                                    </button>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else if (locals.weakAreas && (weakAreas.hasHandledActivities || weakAreas.hasData)) { %>
                                    <% if (weakAreas.hasHandledActivities) { %>
                                        <!-- All Weak Areas Handled / Scheduled State -->
                                        <div class="text-center py-6 my-auto flex flex-col items-center gap-2">
                                            <div class="size-10 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                                <i class="fa-solid fa-circle-check text-base"></i>
                                            </div>
                                            <div class="px-2">
                                                <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium max-w-[260px] mx-auto leading-relaxed">আপনার দুর্বল অধ্যায়গুলোর জন্য রিভিশন রিমাইন্ডার ও প্র্যাকটিস অ্যাক্টিভিটি সম্পন্ন হয়েছে।</p>
                                            </div>
                                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md transition-all shadow-2xs group">
                                                <i class="fa-solid fa-pen-nib text-[10px] text-teal-600 dark:text-teal-400"></i>
                                                <span>Take Model Test</span>
                                                <i class="fa-solid fa-arrow-right text-[9px] text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                                            </a>
                                        </div>
                                    <% } else if (weakAreas.overallAccuracy < 70) { %>
                                        <!-- Needs More Practice State -->
                                        <div class="text-center py-6 my-auto flex flex-col items-center gap-2">
                                            <div class="size-10 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                                                <i class="fa-solid fa-chart-line text-base"></i>
                                            </div>
                                            <div class="px-2">
                                                <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium max-w-[260px] mx-auto leading-relaxed">আরও মডেল টেস্ট ও কুইজ দিয়ে দুর্বল বিষয়গুলো চিহ্নিত করে প্রস্তুতি শক্তিশালী করুন।</p>
                                            </div>
                                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md transition-all shadow-2xs group">
                                                <i class="fa-solid fa-pen-nib text-[10px] text-amber-600 dark:text-amber-400"></i>
                                                <span>Take Model Test</span>
                                                <i class="fa-solid fa-arrow-right text-[9px] text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <!-- Excellent Mastery State -->
                                        <div class="text-center py-6 my-auto flex flex-col items-center gap-2">
                                            <div class="size-10 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                                <i class="fa-solid fa-certificate text-base"></i>
                                            </div>
                                            <div class="px-2">
                                                <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium max-w-[260px] mx-auto leading-relaxed">চমৎকার প্রস্তুতি! ধারাবাহিকতা ধরে রাখতে নিয়মিত নতুন মডেল টেস্টে অংশ নিন।</p>
                                            </div>
                                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md transition-all shadow-2xs group">
                                                <i class="fa-solid fa-pen-nib text-[10px] text-teal-600 dark:text-teal-400"></i>
                                                <span>Take Model Test</span>
                                                <i class="fa-solid fa-arrow-right text-[9px] text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                                            </a>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <!-- Onboarding / Blank State -->
                                    <div class="text-center py-6 my-auto flex flex-col items-center gap-2">
                                        <div class="size-10 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                            <i class="fa-solid fa-crosshairs text-base"></i>
                                        </div>
                                        <div class="px-2">
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium max-w-[260px] mx-auto leading-relaxed">মডেল টেস্ট বা কুইজে অংশ নিয়ে দুর্বল অধ্যায়গুলো শনাক্ত করুন এবং প্রস্তুতি নিখুঁত করুন।</p>
                                        </div>
                                        <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md transition-all shadow-2xs group">
                                            <i class="fa-solid fa-pen-nib text-[10px] text-indigo-600 dark:text-indigo-400"></i>
                                            <span>Take Model Test</span>
                                            <i class="fa-solid fa-arrow-right text-[9px] text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div><!-- /SECTION 2: WEAK AREA RADAR -->

                    <!-- UNENROLLED COURSES & FEATURED PACKAGES MOBILE CAROUSEL (< lg only, placed after Bookmarks) -->
                    <%
                        const mobileUnenrolledList = (locals.unenrolledCourses && unenrolledCourses.length > 0)
                            ? unenrolledCourses
                            : ((locals.promotedCourses && promotedCourses.length > 0) ? promotedCourses : (locals.recommendations || []));

                        function getMobileCourseImg(imgPath) {
                            if (!imgPath || typeof imgPath !== 'string' || imgPath.trim() === '') return '';
                            if (imgPath.startsWith('http')) return imgPath;
                            let normalized = imgPath.replace(/\\/g, '/');
                            if (!normalized.startsWith('/')) normalized = '/' + normalized;
                            return normalized;
                        }
                    %>

                    <% if (mobileUnenrolledList && mobileUnenrolledList.length > 0) { %>
                    <div class="w-full mb-1 relative z-20 lg:hidden font-['Plus_Jakarta_Sans',sans-serif]">
                        <!-- Header with title & View All link in English -->
                        <div class="flex items-center justify-between w-full mb-2 px-1">
                            <div class="flex items-center gap-1.5">
                                <div class="size-6 rounded-lg bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-base leading-none">auto_stories</span>
                                </div>
                                <span class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-100 tracking-tight">Courses & Packages</span>
                            </div>
                            <a href="/courses" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 flex items-center gap-0.5 group transition-colors">
                                <span>View All</span>
                                <span class="material-symbols-rounded text-sm transition-transform group-hover:translate-x-0.5">chevron_right</span>
                            </a>
                        </div>

                        <!-- Swipeable Cards Track Centered with snap-center -->
                        <div id="unenrolledCarouselTrack" class="flex items-stretch gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar pb-1.5 w-full px-[6vw] sm:px-[calc((100%-310px)/2)]">
                            <% mobileUnenrolledList.forEach((c, cIdx) => { 
                                const cImg = getMobileCourseImg(c.thumbnail);
                                const isFree = c.accessType === 'free' || c.accessType === 'Free';
                                const subName = (Array.isArray(c.subject) && c.subject.length > 0) ? c.subject[0] : (c.subject || 'Academic');
                                const instructorName = c.instructor?.name || 'Oddhay Specialist';
                                const hasDiscount = !isFree && c.discountPrice && c.discountPrice > 0 && c.price && c.price > c.discountPrice;
                                const displayPrice = isFree ? 'Free' : (c.discountPrice > 0 ? '৳' + c.discountPrice : (c.price > 0 ? '৳' + c.price : 'Free'));

                                // Accurately determine if this item is a Course or a Package
                                let itemType = 'Course';
                                const titleLower = (c.title || '').toLowerCase();
                                const catStr = Array.isArray(c.category) ? c.category.join(' ').toLowerCase() : (c.category || '').toLowerCase();
                                const tagStr = Array.isArray(c.tags) ? c.tags.join(' ').toLowerCase() : (c.tags || '').toLowerCase();
                                if (c.isPackage || /package|bundle|প্যাকেজ|বান্ডেল/.test(titleLower) || /package|bundle|প্যাকেজ|বান্ডেল/.test(catStr) || /package|bundle/.test(tagStr)) {
                                    itemType = 'Package';
                                } else {
                                    itemType = 'Course';
                                }
                                const isCardActive = cIdx === 0;
                            %>
                            <div class="carousel-course-card snap-center shrink-0 w-[86vw] max-w-[310px] min-w-[260px] rounded-2xl bg-white dark:bg-[#131d31] border border-slate-200/90 dark:border-slate-800/90 transition-all duration-500 ease-out flex flex-col overflow-hidden group cursor-pointer <%= isCardActive ? 'opacity-100 scale-100 shadow-md ring-1 ring-indigo-500/25 dark:ring-indigo-400/20' : 'opacity-40 dark:opacity-35 scale-[0.92] brightness-75 shadow-none' %>" data-card-idx="<%= cIdx %>">
                                <!-- Card Thumbnail Container -->
                                <div class="w-full h-28 sm:h-32 relative overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0">
                                    <% if (cImg) { %>
                                        <img src="<%= cImg %>" alt="<%= c.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <% } %>
                                    <div class="w-full h-full <%= cImg ? 'hidden' : 'flex' %> items-center justify-center bg-gradient-to-br from-indigo-500/20 via-sky-500/15 to-purple-500/20">
                                        <span class="material-symbols-rounded text-3xl text-indigo-500/60 dark:text-indigo-400/60">school</span>
                                    </div>
                                    
                                    <!-- Gradient Overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

                                    <!-- Top Badges -->
                                    <div class="absolute top-2 left-2 right-2 flex items-center justify-between z-10 pointer-events-none">
                                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-slate-900/70 text-white backdrop-blur-md border border-white/10 truncate max-w-[130px]">
                                            <%= subName %>
                                        </span>
                                        <% if (isFree) { %>
                                            <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-emerald-500 text-white shadow-xs">
                                                Free <%= itemType %>
                                            </span>
                                        <% } else if (hasDiscount) { %>
                                            <span class="px-1.5 py-0.5 rounded-lg text-[10px] font-bold bg-rose-500 text-white shadow-xs flex items-center gap-0.5">
                                                <span class="material-symbols-rounded text-xs leading-none">local_offer</span>
                                                <span>Save ৳<%= c.price - c.discountPrice %></span>
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-indigo-600 text-white shadow-xs">
                                                <%= itemType %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Card Content -->
                                <div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between gap-2">
                                    <div>
                                        <h4 class="text-xs sm:text-[13px] font-bold text-slate-800 dark:text-slate-100 line-clamp-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                            <%= c.title %>
                                        </h4>
                                        <div class="flex items-center gap-1.5 mt-1 text-[10.5px] text-slate-500 dark:text-slate-400">
                                            <span class="material-symbols-rounded text-xs text-indigo-500 leading-none">person</span>
                                            <span class="truncate max-w-[120px]"><%= instructorName %></span>
                                            <span class="text-slate-300 dark:text-slate-600">•</span>
                                            <span class="px-1.5 py-0.2 rounded-md text-[9.5px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60"><%= itemType %></span>
                                            <% if (c.totalRecordedClasses || c.totalLiveClasses) { %>
                                                <span class="text-slate-300 dark:text-slate-600">•</span>
                                                <span class="material-symbols-rounded text-xs text-sky-500 leading-none">play_circle</span>
                                                <span><%= (c.totalRecordedClasses || 0) + (c.totalLiveClasses || 0) %> Lessons</span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Price & CTA Button Row -->
                                    <div class="flex items-center justify-between gap-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
                                        <div class="flex items-baseline gap-1">
                                            <span class="text-xs sm:text-sm font-black <%= isFree ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-900 dark:text-white' %>">
                                                <%= displayPrice %>
                                            </span>
                                            <% if (hasDiscount) { %>
                                                <span class="text-[10px] font-medium text-slate-400 line-through">
                                                    ৳<%= c.price %>
                                                </span>
                                            <% } %>
                                        </div>

                                        <a href="/course-details/<%= c._id %>" class="px-2.5 py-1 rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 hover:from-indigo-700 hover:to-sky-700 text-white text-[11px] font-bold flex items-center gap-1 shadow-xs active:scale-95 transition-all shrink-0">
                                            <span><%= isFree ? 'Enroll Free' : 'View Details' %></span>
                                            <span class="material-symbols-rounded text-xs leading-none">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>

                        <!-- Mini Dot Indicators for Mobile Carousel -->
                        <% if (mobileUnenrolledList.length > 1) { %>
                        <div class="flex items-center justify-center gap-1 mt-1.5" id="unenrolledCarouselDots">
                            <% mobileUnenrolledList.forEach((_, dIdx) => { %>
                                <button type="button" class="unenrolled-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer <%= dIdx === 0 ? 'bg-indigo-600 w-3.5' : 'bg-slate-300 dark:bg-slate-700 w-1.5' %>" data-dot-idx="<%= dIdx %>" title="Slide <%= dIdx + 1 %>"></button>
                            <% }) %>
                        </div>
                        <% } %>
                    </div>
                    <% } %>

                    <!-- SECTION 3: WEEKLY XP ACTIVITY CHART & LEADERBOARD (Side-by-side) -->
                    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-5 w-full items-stretch">
                        <div class="lg:col-span-3 w-full flex flex-col">
                            <!-- 3. Weekly XP Activity Chart -->
                            <div class="w-full h-full bg-[#FFFFFF] dark:bg-[#0b1120] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all relative">
                                <div class="flex items-center justify-between px-4 sm:px-5 py-3.5 border-b border-slate-200/80 dark:border-slate-800/80">
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-8 sm:size-9 rounded-xl bg-indigo-500/15 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
                                            <i class="fa-solid fa-chart-line text-sm sm:text-base"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-medium text-sm sm:text-base text-slate-900 dark:text-slate-100 leading-tight antialiased">
                                                Weekly Activity
                                            </h3>
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">সাপ্তাহিক প্রগ্রেস ও স্টাডি মোমেন্টাম</p>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 border border-indigo-500/25 inline-flex items-center justify-center gap-1.5 leading-none select-none">
                                        <i class="fa-solid fa-bolt text-[10px]"></i>
                                        <span>7 Days XP</span>
                                    </span>
                                </div>

                                <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
                                    <%
                                        const weekLabels = locals.chartLabels || ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                                        const weekData   = locals.chartData  || [0,0,0,0,0,0,0];
                                        const weeklyTotalXP = weekData.reduce((acc, v) => acc + (Number(v) || 0), 0);
                                        const weeklyAvgXP   = Math.round(weeklyTotalXP / (weekData.length || 7));
                                        const peakXP        = Math.max(...weekData, 0);
                                        const wMax = Math.max(...weekData, 10);
                                        const W = 500, H = 190, padL = 22, padR = 22, padT = 20, padB = 30;
                                        const innerW = W - padL - padR;
                                        const innerH = H - padT - padB;
                                        const pts = weekData.map((v, i) => {
                                            const x = padL + (i / (weekLabels.length - 1)) * innerW;
                                            const y = padT + innerH - (v / wMax) * innerH;
                                            return { x, y, v, label: weekLabels[i] };
                                        });

                                        // Ultra smooth curved bezier path across canvas
                                        let pathD = `M ${pts[0].x} ${pts[0].y}`;
                                        for (let i = 1; i < pts.length; i++) {
                                            const cp1x = (pts[i - 1].x + pts[i].x) / 2;
                                            const cp1y = pts[i - 1].y;
                                            const cp2x = (pts[i - 1].x + pts[i].x) / 2;
                                            const cp2y = pts[i].y;
                                            pathD += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${pts[i].x} ${pts[i].y}`;
                                        }
                                        const areaD = `${pathD} L ${pts[pts.length - 1].x} ${padT + innerH} L ${pts[0].x} ${padT + innerH} Z`;

                                        // Harmonious modern gradient points
                                        const pointColors = [
                                            '#6366F1', '#8B5CF6', '#A855F7', '#EC4899', '#F43F5E', '#06B6D4', '#3B82F6'
                                        ];
                                    %>

                                    <!-- Top Mini Stats Row matching other widgets -->
                                    <div class="grid grid-cols-3 gap-2 mb-3 text-center">
                                        <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                                            <p class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold">Total Earned</p>
                                            <p class="text-xs sm:text-sm font-bold text-indigo-600 dark:text-indigo-400 mt-0.5"><%= weeklyTotalXP %> XP</p>
                                        </div>
                                        <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                                            <p class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold">Daily Average</p>
                                            <p class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 mt-0.5"><%= weeklyAvgXP %> XP</p>
                                        </div>
                                        <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                                            <p class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold">Peak Day</p>
                                            <p class="text-xs sm:text-sm font-bold text-emerald-600 dark:text-emerald-400 mt-0.5"><%= peakXP %> XP</p>
                                        </div>
                                    </div>

                                    <!-- SVG Chart -->
                                    <div class="relative w-full flex-1 min-h-[140px]">
                                        <svg viewBox="0 0 500 190" class="w-full h-40 sm:h-48 overflow-visible" style="display:block;">
                                            <defs>
                                                <!-- Line Glow Filter -->
                                                <filter id="lineGlow" x="-20%" y="-20%" width="140%" height="140%">
                                                    <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#8B5CF6" flood-opacity="0.3" />
                                                </filter>

                                                <!-- Continuous Line Gradient: Indigo -> Purple -> Cyan -->
                                                <linearGradient id="chartLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                                    <stop offset="0%" stop-color="#6366F1" />
                                                    <stop offset="50%" stop-color="#8B5CF6" />
                                                    <stop offset="100%" stop-color="#06B6D4" />
                                                </linearGradient>

                                                <!-- Soft Semi-Transparent Gradient Area Fill -->
                                                <linearGradient id="chartAreaGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                                    <stop offset="0%" stop-color="#6366F1" stop-opacity="0.25" />
                                                    <stop offset="50%" stop-color="#8B5CF6" stop-opacity="0.2" />
                                                    <stop offset="100%" stop-color="#06B6D4" stop-opacity="0.25" />
                                                </linearGradient>
                                                
                                                <!-- Vertical Fade for Area Fill -->
                                                <linearGradient id="areaFade" x1="0%" y1="0%" x2="0%" y2="100%">
                                                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                                                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
                                                </linearGradient>

                                                <mask id="areaMask">
                                                    <rect x="0" y="0" width="500" height="190" fill="url(#areaFade)" />
                                                </mask>
                                            </defs>

                                            <!-- Horizontal Grid Lines -->
                                            <% [0, 50, 100].forEach(pct => {
                                                const gy = padT + innerH - (pct / 100) * innerH;
                                            %>
                                                <line x1="<%= padL %>" y1="<%= gy %>" x2="<%= W - padR %>" y2="<%= gy %>"
                                                      stroke="#94a3b8" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="4,4"/>
                                            <% }) %>

                                            <!-- Soft Semi-Transparent Gradient Area Fill -->
                                            <path d="<%= areaD %>" fill="url(#chartAreaGrad)" mask="url(#areaMask)" />

                                            <!-- Main Smooth Curved Line -->
                                            <path d="<%= pathD %>" fill="none" stroke="url(#chartLineGrad)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" filter="url(#lineGlow)"/>

                                            <!-- Interactive Data Points & Tooltips -->
                                            <% pts.forEach((p, i) => { 
                                                const pColor = pointColors[i] || '#8B5CF6';
                                            %>
                                                <g class="weekly-point-group" style="cursor:pointer;">
                                                    <!-- Hover Trigger Zone -->
                                                    <rect x="<%= p.x - (innerW / 12) %>" y="0" width="<%= innerW / 6 %>" height="190" fill="transparent" class="point-hover-strip" />
                                                    
                                                    <!-- Dotted Vertical Guide Line -->
                                                    <line x1="<%= p.x %>" y1="<%= p.y %>" x2="<%= p.x %>" y2="<%= padT + innerH %>" stroke="#94a3b8" stroke-opacity="0.4" opacity="0" class="guide-line transition-opacity" stroke-dasharray="2,2"/>
                                                    
                                                    <!-- Data Node: White Center + Border matching line gradient at point -->
                                                    <circle cx="<%= p.x %>" cy="<%= p.y %>" r="5.5" fill="#FFFFFF" stroke="<%= pColor %>" stroke-width="3" class="point-dot transition-all duration-200 drop-shadow-md" />
                                                    
                                                    <!-- Tooltip -->
                                                    <g class="weekly-tooltip" opacity="0" style="transition:all 0.2s">
                                                        <rect x="<%= p.x - 28 %>" y="<%= p.y - 34 %>" width="56" height="24" rx="7" fill="#0f172a" class="shadow-xl"/>
                                                        <polygon points="<%= p.x - 4 %>,<%= p.y - 10 %> <%= p.x + 4 %>,<%= p.y - 10 %> <%= p.x %>,<%= p.y - 5 %>" fill="#0f172a"/>
                                                        <text x="<%= p.x %>" y="<%= p.y - 18 %>" text-anchor="middle"
                                                              font-size="11" font-weight="800" fill="#FFFFFF" font-family="sans-serif"><%= p.v %> XP</text>
                                                    </g>
                                                </g>
                                            <% }) %>

                                            <!-- X-Axis Day Labels -->
                                            <% pts.forEach((p, i) => { %>
                                                <text x="<%= p.x %>" y="<%= H - 8 %>" text-anchor="middle"
                                                      font-size="11" font-weight="700" class="fill-slate-500 dark:fill-slate-400" font-family="sans-serif">
                                                    <%= p.label %>
                                                </text>
                                            <% }) %>
                                        </svg>
                                    </div>

                                    <!-- Bottom Info Footer -->
                                    <div class="mt-2.5 pt-2 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                                        <span class="inline-flex items-center gap-1.5 font-medium">
                                            <i class="fa-solid fa-circle-info text-indigo-500 text-[10px]"></i>
                                            কুইজ, এক্সাম ও লেকচারে XP অর্জিত হয়
                                        </span>
                                        <a href="/exams" class="font-bold text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1">
                                            <span>Earn XP</span>
                                            <i class="fa-solid fa-angle-right text-[9px]"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <style>
                                .weekly-point-group:hover .weekly-tooltip { opacity: 1 !important; transform: translateY(-2px); }
                                .weekly-point-group:hover .guide-line { opacity: 1 !important; }
                                .weekly-point-group:hover .point-dot { r: 7.5 !important; stroke-width: 3.5 !important; filter: brightness(1.15); }
                            </style>
                        </div><!-- /lg:col-span-3 -->

                        <div class="lg:col-span-2 w-full flex flex-col">
                            <!-- 4. Leaderboard -->
                            <div class="w-full h-full bg-[#FFFFFF] dark:bg-[#0b1120] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col justify-between transition-all">
                                <div class="flex items-center justify-between px-4 sm:px-5 py-3.5 border-b border-slate-200/80 dark:border-slate-800/80">
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-8 sm:size-9 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                            <i class="fa-solid fa-trophy text-sm sm:text-base"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-medium text-sm sm:text-base text-slate-900 dark:text-slate-100 leading-tight antialiased">Leaderboard</h3>
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">শীর্ষ শিক্ষার্থী রেঙ্কিং</p>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none">
                                        <i class="fa-solid fa-medal text-[10px]"></i>
                                        <span><%= (locals.leaderboard && leaderboard[0] && leaderboard[0].classLevel) ? leaderboard[0].classLevel : (user && user.classLevel ? user.classLevel : 'XP Rankings') %></span>
                                    </span>
                                </div>

                                <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between gap-2.5">
                                    <div class="rounded-xl overflow-hidden w-full divide-y divide-slate-100 dark:divide-slate-800/60 max-h-[295px] sm:max-h-[315px] overflow-y-auto overscroll-contain custom-scrollbar pr-0.5">
                                        <% if (locals.leaderboard && leaderboard.length > 0) { %>
                                            <% leaderboard.slice(0, 10).forEach((entry, index) => { 
                                                const isMe = user && entry._id && entry._id.toString() === user._id.toString();
                                            %>
                                                <div class="flex items-center gap-2.5 px-2.5 py-2 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors w-full rounded-lg <%= isMe ? 'bg-teal-500/10 dark:bg-teal-900/20 border border-teal-500/25' : '' %>">
                                                    <!-- Rank Badge -->
                                                    <div class="size-6 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 <%= index === 0 ? 'bg-amber-100 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-300 dark:border-amber-700/60 shadow-2xs' : index === 1 ? 'bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700' : index === 2 ? 'bg-amber-800/15 text-amber-700 dark:text-amber-500 border border-amber-700/30' : 'bg-slate-100 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60 text-[10px]' %>">
                                                        <%= index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '#' + (index + 1) %>
                                                    </div>

                                                    <!-- Avatar -->
                                                    <div class="w-6 h-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-[10px] shrink-0 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 shadow-2xs" style="width: 24px; height: 24px; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px;">
                                                        <% if (entry.profileImage) { %>
                                                            <img src="<%= entry.profileImage %>" class="w-full h-full object-cover block rounded-full" alt="<%= entry.name %>" style="width: 24px; height: 24px; max-width: 24px; max-height: 24px; object-fit: cover;">
                                                        <% } else { %>
                                                            <span class="leading-none text-[10px] font-bold"><%= entry.name ? entry.name[0].toUpperCase() : 'S' %></span>
                                                        <% } %>
                                                    </div>

                                                    <!-- Student Info -->
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center gap-1.5 flex-wrap">
                                                            <p class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate <%= isMe ? 'text-teal-700 dark:text-teal-300' : '' %>">
                                                                <%= entry.name %>
                                                            </p>
                                                            <% if (isMe) { %>
                                                                <span class="text-[9px] font-black text-teal-700 dark:text-teal-300 bg-teal-500/15 border border-teal-500/30 px-1.5 py-0.2 rounded-full leading-tight">You</span>
                                                            <% } %>
                                                            <% if (entry.streak && entry.streak > 0) { %>
                                                                <span class="inline-flex items-center gap-0.5 text-[10px] text-amber-500 font-bold" title="<%= entry.streak %> day streak">
                                                                    <i class="fa-solid fa-fire text-[9px]"></i>
                                                                    <span><%= entry.streak %></span>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate"><%= entry.classLevel || 'Student' %></p>
                                                    </div>

                                                    <!-- XP Pill Badge -->
                                                    <div class="text-right shrink-0">
                                                        <span class="inline-flex items-center gap-1 font-bold text-xs text-amber-600 dark:text-amber-400 bg-amber-500/10 dark:bg-amber-500/15 px-2 py-0.5 rounded-lg border border-amber-500/20">
                                                            <i class="fa-solid fa-bolt text-[9px]"></i>
                                                            <span><%= (entry.totalXP || 0).toLocaleString() %> XP</span>
                                                        </span>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="flex flex-col items-center justify-center text-center py-8 gap-2">
                                                <div class="size-11 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-600 dark:text-amber-400 flex items-center justify-center shadow-2xs">
                                                    <i class="fa-solid fa-trophy text-base"></i>
                                                </div>
                                                <div>
                                                    <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">কোনো রেঙ্কিং পাওয়া যায়নি</h4>
                                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">পরীক্ষায় অংশ নিয়ে প্রথম স্থান অর্জন করুন!</p>
                                                </div>
                                                <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1 bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 rounded-lg text-xs font-bold hover:bg-amber-500/25 transition-colors">
                                                    <span>Start Exam</span>
                                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Stylish Glassmorphic Footer Button -->
                                    <a href="/leaderboard" class="w-full mt-2 py-2 px-4 text-center text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 rounded-xl border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-sm transition-all flex items-center justify-center gap-2 group shadow-2xs">
                                        <i class="fa-solid fa-ranking-star text-amber-500 text-xs"></i>
                                        <span>সম্পূর্ণ লিডারবোর্ড দেখুন</span>
                                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                                    </a>
                                </div>
                            </div>
                        </div><!-- /lg:col-span-2 -->

                    </div><!-- /SECTION 3: WEEKLY XP ACTIVITY CHART & LEADERBOARD -->
            </div><!-- /Main Dashboard Content Container -->


        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'dashboard' }) %>
    <%- include('partials/app-scripts') %>
    <script>
        function attendNotice(noticeId) {
            if (!noticeId) return;
            try {
                fetch('/api/attend-notice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ noticeId }),
                    keepalive: true
                }).catch(err => {});
            } catch (e) {}
        }

        function toggleDailyGoal(goalId, btn) {
            fetch('/api/toggle-daily-goal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ goalId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    window.location.reload();
                }
            }).catch(e => console.error(e));
        }

        function refreshDailyStats() {
            fetch('/api/daily-stats')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const badge = document.getElementById('todayXpBadge');
                        if (badge) badge.innerHTML = `<span class="material-symbols-rounded text-xs">bolt</span> +${data.todayXpEarned} XP Today`;
                        
                        const text = document.getElementById('todayXpText');
                        if (text) text.innerText = `+${data.todayXpEarned} XP Earned Today`;

                        const xpTextPill = document.getElementById('today-xp-text');
                        if (xpTextPill) xpTextPill.innerText = `${data.todayXpEarned} XP`;
                        
                        const bar = document.getElementById('todayXpBar');
                        if (bar) {
                            const pct = Math.min(100, Math.round((data.todayXpEarned / 100) * 100));
                            bar.style.width = pct + '%';
                        }
                        
                        const v = document.getElementById('activity-count-video');
                        if (v) v.innerText = `দৈনিক লেসন`;
                        const vMobile = document.getElementById('activity-count-video-mobile');
                        if (vMobile) vMobile.innerText = `দৈনিক লেসন`;
                        const vPill = document.getElementById('today-videos-count-text');
                        if (vPill) vPill.innerText = `${data.todayVideosCount} Class`;
                        
                        const q = document.getElementById('activity-count-quiz');
                        if (q) q.innerText = `আজকে দেওয়া হয়েছে: ${data.todayQuizzesCount}টি পরীক্ষা`;
                        const qMobile = document.getElementById('activity-count-quiz-mobile');
                        if (qMobile) qMobile.innerText = `আজকে দেওয়া হয়েছে: ${data.todayQuizzesCount}টি`;
                        const qPill = document.getElementById('today-quizzes-count-text');
                        if (qPill) qPill.innerText = `${data.todayQuizzesCount} Solved`;
                        
                        const n = document.getElementById('activity-count-note');
                        if (n) n.innerText = `আজকে পড়া হয়েছে: ${data.todayNotesCount}টি নোট/প্রশ্ন`;
                        const nPill = document.getElementById('today-notes-count-text');
                        if (nPill) nPill.innerText = `${(data.todayNotesCount + (data.todaySavedNotesCount || 0))} Saved/Viewed`;

                        const timePill = document.getElementById('today-active-time-text');
                        if (timePill) timePill.innerText = `${data.todayActiveMinutes || 0}m`;
                    }
                })
                .catch(e => {});
        }

        function trackActivity(type) {
            fetch('/api/track-activity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        function removeBookmark(bookmarkId) {
            fetch('/api/remove-bookmark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookmarkId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    const el = document.getElementById('bm-item-' + bookmarkId);
                    if (el) el.remove();
                    
                    const badge = document.getElementById('bookmarkCountBadge');
                    const remaining = document.querySelectorAll('#bookmarkListContainer > div[id^="bm-item-"]').length;
                    if (badge) {
                        badge.textContent = `${remaining} Items`;
                    }
                    if (remaining === 0) {
                        const container = document.getElementById('bookmarkListContainer');
                        if (container) {
                            container.innerHTML = `
                                <div class="text-center py-8 my-auto flex flex-col items-center justify-center">
                                    <div class="size-12 rounded-2xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-2.5">
                                        <i class="fa-solid fa-bookmark text-lg"></i>
                                    </div>
                                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-bold">কোনো সেভ করা নোট বা বই নেই</p>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">গুরুত্বপূর্ণ লেকচার নোট বা বই সেভ করে রাখুন</p>
                                    <div class="mt-3.5 flex items-center justify-center gap-2.5">
                                        <a href="/notes" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                            <i class="fa-solid fa-file-lines text-[10px]"></i>
                                            <span>Notes</span>
                                        </a>
                                        <a href="/library" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-500/15 hover:bg-teal-500/25 border border-teal-500/30 transition-colors">
                                            <i class="fa-solid fa-book-open text-[10px]"></i>
                                            <span>Library</span>
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    }
                    refreshDailyStats();
                }
            }).catch(e => console.error(e));
        }

        // Active Site Time Heartbeat Ping (Pings /api/active-heartbeat every 60 seconds when user is active)
        let isTabActive = true;
        window.addEventListener('focus', () => { isTabActive = true; refreshDailyStats(); });
        window.addEventListener('blur', () => { isTabActive = false; });

        setInterval(() => {
            if (isTabActive && !document.hidden) {
                fetch('/api/active-heartbeat', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            refreshDailyStats();
                        }
                    })
                    .catch(e => {});
            }
        }, 60000);

        function openReminderTimerModal(topic, subject, link, btn) {
            if (!window.Swal) {
                setRevisionReminder(topic, subject, link, 60, btn);
                return;
            }

            // Calculate minutes until 9:00 AM tomorrow
            const now = new Date();
            const morning = new Date();
            morning.setDate(morning.getDate() + 1);
            morning.setHours(9, 0, 0, 0);
            const morningMins = Math.max(1, Math.round((morning - now) / 60000));

            const htmlContent = `
                <div class="text-left font-sans text-xs space-y-3 pt-1">
                    <p class="text-slate-600 dark:text-slate-300 text-xs">
                        <strong>"${topic}"</strong> (${subject}) পুনরায় রিভিশন দিতে কখন রিমাইন্ডার পেতে চান?
                    </p>
                    <div class="grid grid-cols-1 gap-2 text-slate-700 dark:text-slate-200">
                        <!-- Option: Custom Minutes (Recommended) -->
                        <label id="labelCustomTime" class="flex flex-col gap-2 p-2.5 rounded-xl border border-teal-300 dark:border-teal-700 bg-teal-50/60 dark:bg-teal-950/40 hover:bg-teal-50 dark:hover:bg-teal-950/60 cursor-pointer transition-all">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="reminderTime" value="custom" id="radioCustomTime" checked class="text-teal-600 focus:ring-teal-500 shrink-0">
                                <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                    <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                        <span class="material-symbols-rounded text-base text-teal-600 dark:text-teal-400 leading-none shrink-0 inline-flex items-center justify-center select-none">edit_calendar</span>
                                        <span class="truncate">নিজের মতো মিনিট নির্ধারণ করুন (প্রস্তাবিত)</span>
                                    </span>
                                    <span class="text-[10px] text-teal-700 dark:text-teal-300 font-bold px-2 py-0.5 rounded-md bg-teal-100/80 dark:bg-teal-900/60 shrink-0">প্রস্তাবিত</span>
                                </div>
                            </div>
                            <div id="customTimeBox" class="mt-1 pl-7">
                                <input type="number" id="customMinutesInput" min="1" max="10080" placeholder="কত মিনিট পর? (যেমন: ২০, ৪৫ বা ৬০)" class="w-full text-xs px-3 py-2 rounded-lg border border-teal-300 dark:border-teal-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 outline-none">
                            </div>
                        </label>

                        <!-- Option: 30 Minutes -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="30" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">hourglass_top</span>
                                    <span class="truncate">৩০ মিনিট পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৩০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 1 Hour -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="60" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-blue-500 dark:text-blue-400 leading-none shrink-0 inline-flex items-center justify-center select-none">schedule</span>
                                    <span class="truncate">১ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">৬০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: 2 Hours -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="120" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-indigo-500 dark:text-indigo-400 leading-none shrink-0 inline-flex items-center justify-center select-none">alarm</span>
                                    <span class="truncate">২ ঘণ্টা পর</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">১২০ মিনিট</span>
                            </div>
                        </label>

                        <!-- Option: Tomorrow Morning -->
                        <label class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="reminderTime" value="${morningMins}" class="text-teal-600 focus:ring-teal-500 shrink-0">
                            <div class="flex-1 flex items-center justify-between gap-2 min-w-0">
                                <span class="font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                    <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none shrink-0 inline-flex items-center justify-center select-none">wb_sunny</span>
                                    <span class="truncate">আগামীকাল সকালে (সকাল ৯:০০)</span>
                                </span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 shrink-0">সকাল ৯:০০</span>
                            </div>
                        </label>
                    </div>
                </div>
            `;

            Swal.fire({
                title: '<div class="flex items-center justify-center gap-2 text-base font-black"><span class="material-symbols-rounded text-teal-600 text-xl leading-none shrink-0 inline-flex items-center justify-center">alarm_on</span> রিভিশন রিমাইন্ডার শিডিউল</div>',
                html: htmlContent,
                showCancelButton: true,
                confirmButtonText: 'রিমাইন্ডার নিশ্চিত করুন',
                cancelButtonText: 'বাতিল',
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#94a3b8',
                customClass: {
                    popup: 'rounded-2xl dark:bg-slate-900 dark:text-slate-100',
                    confirmButton: 'rounded-xl text-xs font-bold px-4 py-2',
                    cancelButton: 'rounded-xl text-xs font-bold px-4 py-2'
                },
                didOpen: () => {
                    const radioButtons = document.querySelectorAll('input[name="reminderTime"]');
                    const customBox = document.getElementById('customTimeBox');
                    const customInput = document.getElementById('customMinutesInput');
                    const labelCustom = document.getElementById('labelCustomTime');

                    if (customInput) {
                        setTimeout(() => customInput.focus(), 150);
                    }

                    radioButtons.forEach(rb => {
                        rb.addEventListener('change', () => {
                            if (rb.value === 'custom') {
                                customBox.classList.remove('hidden');
                                labelCustom.classList.add('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                                customInput.focus();
                            } else {
                                customBox.classList.add('hidden');
                                labelCustom.classList.remove('border-teal-300', 'dark:border-teal-700', 'bg-teal-50/60', 'dark:bg-teal-950/40');
                            }
                        });
                    });
                },
                preConfirm: () => {
                    const selected = document.querySelector('input[name="reminderTime"]:checked');
                    if (!selected) {
                        Swal.showValidationMessage('দয়া করে একটি সময় নির্বাচন করুন');
                        return false;
                    }
                    if (selected.value === 'custom') {
                        const customVal = parseInt(document.getElementById('customMinutesInput').value, 10);
                        if (isNaN(customVal) || customVal < 1) {
                            Swal.showValidationMessage('দয়া করে সঠিক মিনিট (কমপক্ষে ১ মিনিট) লিখুন');
                            return false;
                        }
                        return customVal;
                    }
                    return parseInt(selected.value, 10);
                }
            }).then(result => {
                if (result.isConfirmed && typeof result.value === 'number') {
                    setRevisionReminder(topic, subject, link, result.value, btn);
                }
            });
        }

        function openReminderTimerModalFromBtn(btn) {
            if (!btn) return;
            const topic = btn.getAttribute('data-topic') || '';
            const subject = btn.getAttribute('data-subject') || '';
            const link = btn.getAttribute('data-link') || '/exams';
            openReminderTimerModal(topic, subject, link, btn);
        }

        function handleWeakAreaActivity(el, topic, subject, actionType) {
            try {
                if (!topic) return;
                const payload = JSON.stringify({ topic, subject, actionType });
                fetch('/api/student/weak-area-activity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload,
                    keepalive: true
                }).catch(() => {});
            } catch (e) {
                console.warn('Weak area activity log error:', e);
            }
        }

        function updateWeakAreaCardCount() {
            const container = document.getElementById('weakTopicsListContainer');
            const remainingCards = container ? container.querySelectorAll('.weak-topic-card') : [];
            const badge = document.getElementById('weakAreaFocusBadge');
            if (remainingCards.length > 0) {
                if (badge) {
                    badge.className = 'px-2.5 py-1 rounded-lg text-[11px] font-bold bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                    badge.innerHTML = `<i class="fa-solid fa-bullseye text-[10px]"></i><span>${remainingCards.length} Focus Areas</span>`;
                }
            } else {
                if (badge) {
                    badge.className = 'px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 inline-flex items-center justify-center gap-1.5 leading-none select-none';
                    badge.innerHTML = `<i class="fa-solid fa-circle-check text-[10px]"></i><span>রিভিশনে অন্তর্ভুক্ত</span>`;
                }
                const radarBody = document.getElementById('weakAreaRadarBody');
                if (radarBody) {
                    radarBody.innerHTML = `
                        <div class="text-center py-6 my-auto flex flex-col items-center gap-2 animate-fade-in">
                            <div class="size-10 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                <i class="fa-solid fa-circle-check text-base"></i>
                            </div>
                            <div class="px-2">
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium max-w-[260px] mx-auto leading-relaxed">আপনার দুর্বল অধ্যায়গুলোর জন্য রিভিশন রিমাইন্ডার ও প্র্যাকটিস অ্যাক্টিভিটি সম্পন্ন হয়েছে।</p>
                            </div>
                            <a href="/exams" class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md transition-all shadow-2xs group">
                                <i class="fa-solid fa-pen-nib text-[10px] text-teal-600 dark:text-teal-400"></i>
                                <span>Take Model Test</span>
