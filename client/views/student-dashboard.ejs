                                                  alt="<%= lastLesson.lessonTitle %>"
                                                  onerror="if (!this.dataset.triedThumb && !this.src.includes('/thumbnails/')) { this.dataset.triedThumb = '1'; this.src = this.src.replace('/uploads/', '/uploads/thumbnails/'); } else { this.style.display='none'; const fb = this.nextElementSibling; if (fb) fb.style.display='flex'; }">
                                             <div class="w-full h-full items-center justify-center bg-teal-950" style="display:none;">
                                                 <span class="material-symbols-rounded text-4xl text-teal-300 leading-none">play_circle</span>
                                             </div>
                                         <% } else { %>
                                             <div class="w-full h-full flex items-center justify-center bg-teal-950">
                                                 <span class="material-symbols-rounded text-4xl text-teal-300 leading-none">play_circle</span>
                                             </div>
                                         <% } %>
