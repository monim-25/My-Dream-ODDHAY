            const status = document.getElementById('scratchSaveStatus');
            if (status) {
                status.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[10px]"></i><span>সেভ হচ্ছে...</span>';
            }
            if (scratchpadDebounceTimer) clearTimeout(scratchpadDebounceTimer);
            scratchpadDebounceTimer = setTimeout(() => {
                if (txt) {
                    localStorage.setItem('oddhay_dash_scratchpad', txt.value);
                }
                if (status) {
                    status.innerHTML = '<i class="fa-solid fa-cloud-arrow-up text-[10px]"></i><span>অটো-সেভ সক্রিয়</span>';
                }
            }, 350);
        }

        function insertNoteSymbol(sym) {
            const txt = document.getElementById('quickScratchpadText');
            if (!txt) return;
            const start = txt.selectionStart || txt.value.length;
            const end = txt.selectionEnd || txt.value.length;
            txt.value = txt.value.substring(0, start) + sym + txt.value.substring(end);
            txt.selectionStart = txt.selectionEnd = start + sym.length;
            txt.focus();
            handleScratchpadInput();
        }

        function copyQuickNote() {
            const txt = document.getElementById('quickScratchpadText');
            const btn = document.getElementById('copyNoteBtn');
            if (!txt || !txt.value.trim()) return;
            navigator.clipboard.writeText(txt.value).then(() => {
                if (btn) {
                    const orig = btn.innerHTML;
                    btn.innerHTML = '<i class="fa-solid fa-check text-[10px]"></i><span>কপি হয়েছে!</span>';
                    setTimeout(() => { btn.innerHTML = orig; }, 1800);
                }
            }).catch(e => console.error(e));
        }

        function clearQuickNote() {
            const txt = document.getElementById('quickScratchpadText');
            if (!txt || !txt.value.trim()) return;
            if (confirm('আপনি কি নিশ্চিত যে সম্পূর্ণ নোট মুছে ফেলতে চান?')) {
                txt.value = '';
                localStorage.removeItem('oddhay_dash_scratchpad');
                handleScratchpadInput();
            }
        }

        // Restore active states on page load
        document.addEventListener('DOMContentLoaded', () => {
            initFlashcardsDeck();
            loadQuickNote();
            try {
                const savedTab = sessionStorage.getItem('oddhay_dash_rev_tab');
                if (savedTab && ['flashcards', 'bookmarks', 'notes'].includes(savedTab)) {
                    switchRevTab(savedTab);
                }
            } catch (e) {}
        });
    </script>
</body>
</html>