            } catch (err) {
                console.error('Error saving note to library:', err);
                alert('সার্ভার এরর। দয়া করে আবার চেষ্টা করুন।');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHTML;
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshDailyStats();

            // Mobile Unenrolled Course Carousel Controller (Center Snap & Auto-Scroll)
            const track = document.getElementById('unenrolledCarouselTrack');
            if (track) {
                const cards = track.querySelectorAll('.carousel-course-card');
                const dots = document.querySelectorAll('.unenrolled-dot');
                let currentIndex = 0;
                let autoTimer = null;
                let isInteracting = false;

                function getClosestIndex() {
                    const trackCenter = track.scrollLeft + track.offsetWidth / 2;
                    let closest = 0;
                    let minDiff = Infinity;
                    cards.forEach((card, idx) => {
                        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
                        const diff = Math.abs(trackCenter - cardCenter);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closest = idx;
                        }
                    });
                    return closest;
                }

                function updateCardStates(activeIdx) {
                    cards.forEach((card, idx) => {
                        if (idx === activeIdx) {
                            card.classList.remove('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                            card.classList.add('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                        } else {
                            card.classList.remove('opacity-100', 'scale-100', 'shadow-md', 'ring-1', 'ring-indigo-500/25', 'dark:ring-indigo-400/20');
                            card.classList.add('opacity-40', 'dark:opacity-35', 'scale-[0.92]', 'brightness-75', 'shadow-none');
                        }
                    });
                }

                function updateDots(activeIdx) {
                    dots.forEach((dot, idx) => {
                        if (idx === activeIdx) {
                            dot.classList.add('bg-indigo-600', 'w-3.5');
                            dot.classList.remove('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                        } else {
                            dot.classList.remove('bg-indigo-600', 'w-3.5');
                            dot.classList.add('bg-slate-300', 'dark:bg-slate-700', 'w-1.5');
                        }
                    });
                }

                function scrollToCard(index) {
                    if (!cards[index]) return;
                    const card = cards[index];
                    const targetScroll = card.offsetLeft - (track.offsetWidth - card.offsetWidth) / 2;
                    track.scrollTo({ left: Math.max(0, targetScroll), behavior: 'smooth' });
                    currentIndex = index;
                    updateDots(index);
                    updateCardStates(index);
                }

                function startAutoPlay() {
                    stopAutoPlay();
                    if (cards.length <= 1) return;
                    autoTimer = setInterval(() => {
                        if (isInteracting) return;
                        currentIndex = (getClosestIndex() + 1) % cards.length;
                        scrollToCard(currentIndex);
                    }, 4500);
                }

                function stopAutoPlay() {
                    if (autoTimer) {
                        clearInterval(autoTimer);
                        autoTimer = null;
                    }
                }

                // Scroll detection to sync dots & shadow states
                track.addEventListener('scroll', () => {
                    const closest = getClosestIndex();
                    currentIndex = closest;
                    updateDots(closest);
                    updateCardStates(closest);
                }, { passive: true });

                // Touch & Pointer interaction pause
                track.addEventListener('touchstart', () => {
                    isInteracting = true;
                    stopAutoPlay();
                }, { passive: true });

                track.addEventListener('touchend', () => {
                    isInteracting = false;
                    setTimeout(startAutoPlay, 5000);
                }, { passive: true });

                // Tap on a non-presenting (shadowish) card to bring it to center
                cards.forEach((card, idx) => {
                    card.addEventListener('click', (e) => {
                        if (idx !== currentIndex) {
                            // If tapping an inactive card, center it smoothly
                            const clickedLink = e.target.closest('a');
                            if (!clickedLink) {
                                e.preventDefault();
                                stopAutoPlay();
                                scrollToCard(idx);
                                setTimeout(startAutoPlay, 5000);
                            }
                        }
                    });
                });

                // Dot click navigation
                dots.forEach(dot => {
                    dot.addEventListener('click', () => {
                        const targetIdx = parseInt(dot.getAttribute('data-dot-idx'), 10);
                        if (!isNaN(targetIdx)) {
                            stopAutoPlay();
                            scrollToCard(targetIdx);
                            setTimeout(startAutoPlay, 6000);
                        }
                    });
                });

                // Initialize states & start autoplay on mobile
                updateCardStates(0);
                if (window.innerWidth < 1024) {
                    startAutoPlay();
                }
            }
        });

