                                        <img src="<%= activeLessonThumb %>" class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform" alt="<%= lastLesson.lessonTitle %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
