                                            <p class="text-[9px] text-emerald-600 dark:text-emerald-400 font-semibold">Accuracy</p>
                                            <p class="text-xs sm:text-sm font-bold text-emerald-700 dark:text-emerald-300 mt-0.5"><%= weakAreas.overallAccuracy %>%</p>
                                        </div>
                                    </div>

                                    <!-- Weak Topics List -->
                                    <div id="weakTopicsListContainer" class="space-y-2.5">
                                        <% 
                                            const displayTopics = displayTopicsList.slice(0, 5);
                                            displayTopics.forEach((t, tIdx) => { 
                                                 const isCrit = t.status === 'critical';
                                        %>
                                            <div data-topic="<%= t.topic.replace(/"/g, '&quot;') %>" class="weak-topic-card p-2.5 sm:p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border <%= isCrit ? 'border-rose-300/80 dark:border-rose-800/60' : (t.status === 'moderate' ? 'border-amber-300/80 dark:border-amber-800/60' : 'border-emerald-300/80 dark:border-emerald-800/60') %> transition-all shadow-2xs">
