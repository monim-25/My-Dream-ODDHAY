<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Student Dashboard | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'dashboard' }) %>
        
        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <!-- Unified AI Study Assistant & Quick Actions Container (Matching Actual Page Background) -->
            <div class="w-full bg-[#FFFFFF] dark:bg-[#0b1120] border-b border-slate-200/80 dark:border-slate-800/80 text-slate-800 dark:text-slate-100 flex flex-col group relative transition-colors duration-300">
                
                <!-- TOP PART: AI Study Assistant Section -->
                <div class="w-full pt-3 sm:pt-3.5 pb-2 sm:pb-2.5 px-3.5 sm:px-4.5 lg:px-5 relative overflow-hidden flex flex-col items-start justify-between">

                    <%
                        // 100% Accurate Real User Activity Calculations
                        const realUser = locals.user || {};
                        const pStats = locals.progressStats || null;

                        let realLevel, realStreak, realXP, realMarks, realAvgScore, realRightMCQ, realWrongMCQ, realSolvedQuestions, realCompletedLessons, realBookmarks;

                        if (pStats) {
                            realLevel = pStats.level !== undefined ? pStats.level : (locals.level || 1);
                            realStreak = pStats.streak !== undefined ? pStats.streak : 0;
                            realXP = pStats.totalXP !== undefined ? pStats.totalXP : 0;
                            realMarks = pStats.gainedMarks !== undefined ? pStats.gainedMarks : 0;
                            realAvgScore = pStats.avgScore !== undefined ? pStats.avgScore : 0;
                            realRightMCQ = pStats.rightMCQ !== undefined ? pStats.rightMCQ : 0;
                            realWrongMCQ = pStats.wrongMCQ !== undefined ? pStats.wrongMCQ : 0;
                            realSolvedQuestions = pStats.solvedQuestions !== undefined ? pStats.solvedQuestions : 0;
                            realCompletedLessons = pStats.completedLessons !== undefined ? pStats.completedLessons : 0;
                            realBookmarks = pStats.bookmarks !== undefined ? pStats.bookmarks : (pStats.savedResources !== undefined ? pStats.savedResources : 0);
                        } else {
                            const quizResultsList = realUser.quizResults || [];
                            const bankAttemptsList = locals.questionBankAttempts || realUser.questionBankAttempts || [];

                            let calcRightMCQ = 0;
                            let calcWrongMCQ = 0;
                            let calcMarks = 0;
                            let calcSolved = 0;
                            let sumPctScores = 0;
                            let totalAttemptsCount = 0;

                            quizResultsList.forEach(q => {
                                const qScore = q.score || 0;
                                const qTotal = q.total || 0;
                                const qWrong = Math.max(0, qTotal - qScore);
                                calcRightMCQ += qScore;
                                calcWrongMCQ += qWrong;
                                calcMarks += qScore;
                                calcSolved += qTotal;
                                if (qTotal > 0) {
                                    sumPctScores += (qScore / qTotal) * 100;
                                    totalAttemptsCount++;
                                }
                            });

                            bankAttemptsList.forEach(a => {
                                const bRight = a.mcqCorrectCount || a.mcqScore || 0;
                                const bWrong = a.wrongMcqCount || 0;
                                calcRightMCQ += bRight;
                                calcWrongMCQ += bWrong;
                                calcMarks += (a.mcqScore || 0);
                                if (a.writtenStatus === 'reviewed' && a.teacherReview && typeof a.teacherReview.totalWrittenScore === 'number') {
                                    calcMarks += a.teacherReview.totalWrittenScore;
                                }

                                let aSolved = 0;
                                (a.userAnswers || []).forEach(ua => {
                                    if ((ua.questionType || 'MCQ') === 'MCQ') {
                                        if (ua.selectedOptionIndex !== undefined && ua.selectedOptionIndex !== null && ua.selectedOptionIndex >= 0) aSolved++;
                                    } else {
                                        if ((ua.writtenAnswer && String(ua.writtenAnswer).trim() !== '') || ua.writtenImage || (Array.isArray(ua.writtenImages) && ua.writtenImages.length > 0)) aSolved++;
                                    }
                                });
                                if (aSolved === 0 && (bRight + bWrong > 0)) aSolved = bRight + bWrong;
                                calcSolved += aSolved;

                                const maxTot = (a.maxMcqScore || a.mcqTotalQuestions || (bRight + bWrong)) + (a.writtenStatus === 'reviewed' && a.teacherReview?.maxWrittenScore ? a.teacherReview.maxWrittenScore : 0);
                                const earned = (a.mcqScore || 0) + (a.writtenStatus === 'reviewed' && a.teacherReview?.totalWrittenScore ? a.teacherReview.totalWrittenScore : 0);
                                if (maxTot > 0) {
                                    sumPctScores += Math.max(0, Math.min(100, (earned / maxTot) * 100));
                                    totalAttemptsCount++;
                                }
                            });

                            realLevel = locals.level || realUser.level || 1;
                            realStreak = realUser.streakCount !== undefined ? realUser.streakCount : (realUser.streak || 0);
                            realXP = realUser.totalXP !== undefined ? realUser.totalXP : (realUser.points || 0);
                            realRightMCQ = calcRightMCQ;
                            realWrongMCQ = calcWrongMCQ;
                            realMarks = calcMarks % 1 === 0 ? calcMarks : Number(calcMarks.toFixed(1));
                            realSolvedQuestions = calcSolved;
                            realCompletedLessons = (realUser.completedLessons && realUser.completedLessons.length) || 0;
                            const userBookmarksList = (realUser.savedBookmarks || []).filter(b => 
                                b.itemType === 'note' || b.itemType === 'book' || 
                                (b.link && (b.link.includes('note') || b.link.includes('library') || b.link.includes('.pdf') || b.link.includes('book'))) ||
                                (!b.itemType && (!b.link || !b.link.includes('question-bank')))
                            );
                            realBookmarks = userBookmarksList.length;
                            realAvgScore = totalAttemptsCount > 0 ? Math.round(sumPctScores / totalAttemptsCount) : (calcRightMCQ + calcWrongMCQ > 0 ? Math.round((calcRightMCQ / (calcRightMCQ + calcWrongMCQ)) * 100) : 0);
                        }
                    %>

                    <!-- TOP-RIGHT CORNER: Desktop Quick Access Icons (Desktop Only >= lg) -->
                    <div class="absolute top-2.5 right-3.5 sm:top-3 sm:right-5 z-30 hidden lg:flex items-center gap-1.5 sm:gap-2">
                        <!-- 1. My Courses Icon -->
                        <a href="/my-courses" class="size-7.5 sm:size-8 rounded-lg border border-sky-200/80 dark:border-sky-400/30 hover:border-sky-400 bg-sky-50 dark:bg-sky-950/70 hover:bg-sky-500 text-sky-700 dark:text-sky-200 hover:text-white dark:hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="My Courses">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">auto_stories</span>
                        </a>

                        <!-- 2. Notes Icon -->
                        <a href="/notes" class="size-7.5 sm:size-8 rounded-lg border border-sky-200/80 dark:border-sky-400/30 hover:border-sky-400 bg-sky-50 dark:bg-sky-950/70 hover:bg-sky-500 text-sky-700 dark:text-sky-200 hover:text-white dark:hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Lecture Notes">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">sticky_note_2</span>
                        </a>

                        <!-- 3. Exams Icon -->
                        <a href="/exams" class="size-7.5 sm:size-8 rounded-lg border border-sky-200/80 dark:border-sky-400/30 hover:border-sky-400 bg-sky-50 dark:bg-sky-950/70 hover:bg-sky-500 text-sky-700 dark:text-sky-200 hover:text-white dark:hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Exams & Quizzes">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">edit_note</span>
                        </a>

                        <!-- 4. Question Bank Icon -->
                        <a href="/question-bank" class="size-7.5 sm:size-8 rounded-lg border border-sky-200/80 dark:border-sky-400/30 hover:border-sky-400 bg-sky-50 dark:bg-sky-950/70 hover:bg-sky-500 text-sky-700 dark:text-sky-200 hover:text-white dark:hover:text-slate-950 transition-colors flex items-center justify-center p-0 shrink-0 shadow-xs group" title="Question Bank">
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none flex items-center justify-center text-center p-0 m-0">live_help</span>
                        </a>
                    </div>

                    <!-- QUICK ACTIONS MOBILE ROW (Visible on mobile/tablet < lg; Oddhay AI + 3 Quick Actions in One Clean Line) -->
                    <div class="w-full pt-2 pb-2.5 relative z-20 border-t border-b border-slate-200/80 dark:border-white/10 lg:hidden">
                        <div class="grid grid-cols-4 gap-1.5 sm:gap-2.5 w-full">
                            
                            <!-- 1. ODDHAY AI -->
                            <a href="/student" class="flex flex-col items-center justify-center py-1 px-0.5 gap-1 group/btn w-full cursor-pointer select-none">
                                <div class="size-11 sm:size-12 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-cyan-500 text-white shadow-md shadow-sky-500/25 group-hover/btn:scale-105 transition-transform flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-[22px] sm:text-2xl leading-none">memory</span>
                                </div>
                                <span class="text-[10.5px] sm:text-xs font-bold text-slate-700 dark:text-slate-200 text-center leading-tight truncate max-w-full">Oddhay AI</span>
                            </a>

                            <!-- 2. COURSES -->
                            <a href="/courses" class="flex flex-col items-center justify-center py-1 px-0.5 gap-1 group/btn w-full cursor-pointer select-none">
                                <div class="size-11 sm:size-12 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white shadow-md shadow-blue-500/20 group-hover/btn:scale-105 transition-transform flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-[22px] sm:text-2xl leading-none">auto_stories</span>
                                </div>
                                <span class="text-[10.5px] sm:text-xs font-bold text-slate-700 dark:text-slate-200 text-center leading-tight truncate max-w-full">Courses</span>
                            </a>

                            <!-- 3. EXAMS -->
                            <a href="/exams" class="flex flex-col items-center justify-center py-1 px-0.5 gap-1 group/btn w-full cursor-pointer select-none">
                                <div class="size-11 sm:size-12 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 text-white shadow-md shadow-rose-500/20 group-hover/btn:scale-105 transition-transform flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-[22px] sm:text-2xl leading-none">edit_note</span>
                                </div>
                                <span class="text-[10.5px] sm:text-xs font-bold text-slate-700 dark:text-slate-200 text-center leading-tight truncate max-w-full">Exams</span>
                            </a>

                            <!-- 4. QUESTION BANK -->
                            <a href="/question-bank" class="flex flex-col items-center justify-center py-1 px-0.5 gap-1 group/btn w-full cursor-pointer select-none">
                                <div class="size-11 sm:size-12 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 text-white shadow-md shadow-cyan-500/20 group-hover/btn:scale-105 transition-transform flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-[22px] sm:text-2xl leading-none">archive</span>
                                </div>
                                <span class="text-[10.5px] sm:text-xs font-bold text-slate-700 dark:text-slate-200 text-center leading-tight truncate max-w-full">Question Bank</span>
                            </a>

                        </div>
                    </div>

                    <!-- PRIORITY NOTICE / UPCOMING EVENT (Mobile Only < lg) -->
                    <% if (locals.upcomingEvent) { 
                        const mNoticeType = upcomingEvent.type || 'none';
                        let mNoticeBadgeText = 'Notice & Updates';
                        let mNoticeIcon = 'notifications';
                        let mNoticeIconBg = 'bg-sky-500/15 dark:bg-sky-500/20';
                        let mNoticeIconColor = 'text-sky-600 dark:text-sky-400';
                        let mNoticeBadgeStyle = 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20';
                        let mNoticeBtnStyle = 'bg-gradient-to-r from-sky-600 to-blue-600 text-white shadow-sky-500/20';
                        let mNoticeBorder = 'border-slate-200/90 dark:border-slate-800/90';

                        if (mNoticeType === 'live') {
                            mNoticeBadgeText = 'Live Class Alert';
                            mNoticeIcon = 'sensors';
                            mNoticeIconBg = 'bg-rose-500/15 dark:bg-rose-500/20';
                            mNoticeIconColor = 'text-rose-600 dark:text-rose-400';
                            mNoticeBadgeStyle = 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/25';
                            mNoticeBtnStyle = 'bg-gradient-to-r from-rose-600 to-red-600 text-white shadow-rose-500/25';
                            mNoticeBorder = 'border-rose-200/80 dark:border-rose-900/40';
                        } else if (mNoticeType === 'exam' || mNoticeType === 'quiz') {
                            mNoticeBadgeText = 'Exam Alert';
                            mNoticeIcon = 'edit_note';
                            mNoticeIconBg = 'bg-amber-500/15 dark:bg-amber-500/20';
                            mNoticeIconColor = 'text-amber-600 dark:text-amber-400';
                            mNoticeBadgeStyle = 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/25';
                            mNoticeBtnStyle = 'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-amber-500/25';
                            mNoticeBorder = 'border-amber-200/80 dark:border-amber-900/40';
                        } else if (mNoticeType === 'high_notice' || mNoticeType === 'notice') {
                            mNoticeBadgeText = 'Important Notice';
                            mNoticeIcon = 'campaign';
                            mNoticeIconBg = 'bg-indigo-500/15 dark:bg-indigo-500/20';
                            mNoticeIconColor = 'text-indigo-600 dark:text-indigo-300';
                            mNoticeBadgeStyle = 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/25';
                            mNoticeBtnStyle = 'bg-gradient-to-r from-indigo-600 to-sky-600 text-white shadow-indigo-500/25';
                            mNoticeBorder = 'border-indigo-200/80 dark:border-indigo-900/40';
                        } else if (mNoticeType === 'upcoming') {
                            mNoticeBadgeText = 'Routine Task';
                            mNoticeIcon = 'task_alt';
                            mNoticeIconBg = 'bg-emerald-500/15 dark:bg-emerald-500/20';
                            mNoticeIconColor = 'text-emerald-600 dark:text-emerald-400';
                            mNoticeBadgeStyle = 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/25';
                            mNoticeBtnStyle = 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-emerald-500/25';
                            mNoticeBorder = 'border-emerald-200/80 dark:border-emerald-900/40';
                        }
                    %>
                    <div class="w-full mt-2 mb-1 px-1 relative z-20 lg:hidden font-['Plus_Jakarta_Sans',sans-serif]">
                        <div class="w-full rounded-2xl bg-white dark:bg-[#131d31] border <%= mNoticeBorder %> shadow-xs p-3.5 flex flex-col justify-between gap-2.5 relative overflow-hidden">
                            <!-- Background subtle ambient glow -->
                            <div class="absolute -right-8 -bottom-8 size-28 bg-indigo-500/5 dark:bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

                            <!-- Header: Priority Related Icon + Badge + Course / Time -->
                            <div class="flex items-center justify-between gap-2 relative z-10">
                                <div class="flex items-center gap-1.5 min-w-0">
                                    <div class="size-6 rounded-lg <%= mNoticeIconBg %> flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-sm leading-none <%= mNoticeIconColor %>"><%= mNoticeIcon %></span>
                                    </div>
                                    <span class="px-2 py-0.5 rounded-lg text-[10.5px] font-bold border <%= mNoticeBadgeStyle %> shrink-0">
                                        <%= mNoticeBadgeText %>
                                    </span>
                                    <% if (upcomingEvent.courseTitle) { %>
                                        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 truncate max-w-[130px]">• <%= upcomingEvent.courseTitle %></span>
                                    <% } %>
                                </div>
                                <% if (upcomingEvent.time) { %>
                                    <span class="text-[10.5px] font-semibold text-slate-500 dark:text-slate-400 shrink-0 flex items-center gap-0.5">
                                        <span class="material-symbols-rounded text-xs leading-none">schedule</span>
                                        <span><%= upcomingEvent.time %></span>
                                    </span>
                                <% } %>
                            </div>

                            <!-- Notice Content -->
                            <div class="relative z-10">
                                <h3 class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-100 line-clamp-2 leading-snug"><%= upcomingEvent.title %></h3>
                                <% if (upcomingEvent.message || upcomingEvent.subtitle) { %>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 leading-relaxed"><%= upcomingEvent.message || upcomingEvent.subtitle %></p>
                                <% } %>
                            </div>

                            <!-- CTA Button / Footer -->
                            <% if (upcomingEvent.link) { %>
                            <div class="flex items-center justify-end pt-1.5 border-t border-slate-100 dark:border-slate-800/80 relative z-10">
                                <a href="<%= upcomingEvent.link %>" onclick="attendNotice('<%= upcomingEvent.id %>')" class="px-3.5 py-1.5 rounded-xl <%= mNoticeBtnStyle %> text-xs font-bold flex items-center gap-1 shadow-xs active:scale-95 transition-all">
                                    <span><%= upcomingEvent.buttonText || 'View Details' %></span>
                                    <span class="material-symbols-rounded text-xs leading-none">arrow_forward</span>
                                </a>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %>


                    <!-- Content: Left AI Assistant Info + Right Notice & Updates Section (Desktop Only >= lg) -->
                    <div class="relative z-10 hidden lg:grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-center w-full mb-1 ml-0">
                        <!-- LEFT COLUMN: Animated Floating AI Icon + AI Features List + CTA Button -->
                        <div class="lg:col-span-7 flex flex-col items-start gap-1.5 sm:gap-2 lg:gap-3.5 w-full">
                            <!-- Large Screen Only: Animated Floating AI Core Visual (Kept intact for lg screens) -->
                            <div class="hidden lg:flex flex-col items-start gap-1.5">
                                <!-- Animated Floating AI Core Visual (Moved a bit to the right side & bottom) -->
                                <div class="ai-animated-orb relative size-24 sm:size-28 lg:size-32 flex items-center justify-center shrink-0 ml-5 sm:ml-7 lg:ml-9 mt-2 sm:mt-2.5">
                                    <!-- Outer Pulsing Glow -->
                                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-indigo-500/30 via-purple-500/20 to-cyan-500/30 blur-xl animate-pulse"></div>
                                    
                                    <!-- Rotating Orbit Ring -->
                                    <div class="absolute inset-1 rounded-full border border-dashed border-cyan-400/40 animate-spin" style="animation-duration: 12s;"></div>
                                    
                                    <!-- Inner Glass Disc with Hyper-Unique Dual-Gyroscope Quantum Star Core -->
                                    <div class="size-16 sm:size-20 lg:size-22 rounded-full bg-slate-900/90 border border-cyan-400/50 flex items-center justify-center shadow-inner backdrop-blur-md overflow-hidden relative">
                                        <svg class="size-12 sm:size-14 lg:size-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <!-- Outer Counter-Rotating Gyro Ring with Satellite Nodes -->
                                            <g class="origin-center ai-spin-ccw">
                                                <ellipse cx="50" cy="50" rx="42" ry="18" stroke="url(#gyroGrad1)" stroke-width="1.8" stroke-dasharray="6 4" transform="rotate(-25 50 50)"/>
                                                <circle cx="15" cy="35" r="3" fill="#38BDF8"/>
                                                <circle cx="85" cy="65" r="3" fill="#F472B6"/>
                                            </g>
                                            
                                            <!-- Clockwise Gyro Ring -->
                                            <g class="origin-center ai-spin-cw">
                                                <ellipse cx="50" cy="50" rx="42" ry="18" stroke="url(#gyroGrad2)" stroke-width="1.8" stroke-dasharray="8 3" transform="rotate(35 50 50)"/>
                                                <circle cx="75" cy="25" r="3" fill="#818CF8"/>
                                                <circle cx="25" cy="75" r="3" fill="#34D399"/>
                                            </g>

                                            <!-- Center Hyper-Dimensional AI Core Star -->
                                            <g class="origin-center ai-pulse-core">
                                                <path d="M50 20 L57 38 L75 38 L60 49 L66 67 L50 56 L34 67 L40 49 L25 38 L43 38 Z" fill="url(#coreGrad)" stroke="#E0E7FF" stroke-width="1"/>
                                                <circle cx="50" cy="50" r="7" fill="#FFFFFF"/>
                                                <circle cx="50" cy="50" r="4" fill="#0EA5E9"/>
                                            </g>

                                            <defs>
                                                <linearGradient id="gyroGrad1" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#38BDF8"/>
                                                    <stop offset="0.5" stop-color="#C084FC"/>
                                                    <stop offset="1" stop-color="#F472B6"/>
                                                </linearGradient>
                                                <linearGradient id="gyroGrad2" x1="100" y1="0" x2="0" y2="100" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#34D399"/>
                                                    <stop offset="0.5" stop-color="#818CF8"/>
                                                    <stop offset="1" stop-color="#38BDF8"/>
                                                </linearGradient>
                                                <linearGradient id="coreGrad" x1="25" y1="20" x2="75" y2="67" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#38BDF8"/>
                                                    <stop offset="0.5" stop-color="#6366F1"/>
                                                    <stop offset="1" stop-color="#EC4899"/>
                                                </linearGradient>
                                            </defs>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <!-- AI Feature Bullet Points List (Desktop Only, hidden on small screen) -->
                            <div class="hidden lg:flex flex-col gap-2 mt-0 mb-1 ml-8 font-['Plus_Jakarta_Sans',sans-serif]">
                                <div class="flex items-center gap-2 text-[13px] text-slate-600 dark:text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-600 dark:text-cyan-400 leading-none shrink-0">check_circle</span>
                                    <span>Unlimited Problem Solving</span>
                                </div>
                                <div class="flex items-center gap-2 text-[13px] text-slate-600 dark:text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-600 dark:text-cyan-400 leading-none shrink-0">check_circle</span>
                                    <span>Snap Photo & Ask Doubts</span>
                                </div>
                                <div class="flex items-center gap-2 text-[13px] text-slate-600 dark:text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-600 dark:text-cyan-400 leading-none shrink-0">check_circle</span>
                                    <span>Step-by-Step Instant Solutions</span>
                                </div>
                                <div class="flex items-center gap-2 text-[13px] text-slate-600 dark:text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-cyan-600 dark:text-cyan-400 leading-none shrink-0">check_circle</span>
                                    <span>24/7 Personal AI Tutor</span>
                                </div>
                            </div>

                            <!-- Desktop CTA Button (Pill Style, Kept Intact for lg Screens) -->
                            <div class="hidden lg:flex ml-2.5 sm:ml-5 lg:ml-8 pt-0.5 pb-1 sm:py-1.5 lg:py-2">
                                <a href="/student" aria-label="Oddhay AI" class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-1.5 sm:py-2 bg-sky-50 dark:bg-sky-950/70 hover:bg-sky-100 dark:hover:bg-sky-900/80 text-sky-900 dark:text-sky-200 text-xs sm:text-sm font-semibold rounded-xl border border-sky-200 dark:border-sky-500/30 shadow-xs transition-all duration-300 transform hover:scale-[1.02] active:scale-95 select-none group/btn leading-none">
                                    <!-- AI Microchip Icon -->
