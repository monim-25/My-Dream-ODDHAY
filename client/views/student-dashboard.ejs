                                                                <%= t.subject %>
                                                            </span>
                                                            <span class="text-[9px] font-medium text-slate-500 dark:text-slate-400">
                                                                Score <%= (t.marksObtained !== undefined ? t.marksObtained : 0) %>/<%= (t.maxMarks !== undefined ? t.maxMarks : t.total) %><% if (t.wrong > 0) { %> · ভুল <%= t.wrong %><% } %>
                                                            </span>
                                                        </div>
                                                        <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 mt-1 truncate" title="<%= t.topic %>">
                                                            <%= t.topic %>
                                                        </h4>
                                                    </div>
                                                    <span class="text-xs font-black shrink-0 <%= isCrit ? 'text-rose-600 dark:text-rose-400' : (t.status === 'moderate' ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400') %>">
                                                        <%= t.accuracy %>%
                                                    </span>
                                                </div>

                                                <!-- Mini Accuracy Progress Bar -->
                                                <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden mt-2">
                                                    <div class="h-full rounded-full <%= isCrit ? 'bg-rose-500' : (t.status === 'moderate' ? 'bg-amber-500' : 'bg-emerald-500') %>" style="width: <%= Math.min(100, Math.max(0, t.accuracy || 0)) %>%"></div>
                                                </div>

                                                <!-- Actions: Watch Lesson/Practice + Test Again + Set Reminder -->
                                                <div class="flex items-center justify-between gap-1.5 mt-2.5 pt-1.5 border-t border-slate-200/60 dark:border-slate-700/60 flex-wrap sm:flex-nowrap">
