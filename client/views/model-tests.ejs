<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Model Test | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <main class="flex-1 w-full overflow-y-auto p-4 sm:p-6 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-4 pb-12">
            
            <!-- DYNAMIC COUNT BADGE BAR -->
            <div class="max-w-6xl w-full mx-auto flex items-center justify-end">
                <span class="px-3 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 text-xs font-semibold flex items-center gap-1.5">
                    <span class="material-symbols-rounded text-sm leading-none">workspace_premium</span>
                    <span id="modelTestCountBadge"><%= modelTests.length %> Model Tests Available</span>
                </span>
            </div>

            <!-- MODEL TESTS GRID -->
            <div class="max-w-6xl w-full mx-auto">
                <div id="modelTestsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
                    <% if (modelTests.length === 0) { %>
                        <div class="col-span-full py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                            <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">event_busy</span>
                            <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Model Tests Available</h3>
                            <p class="text-[11px] text-slate-400">There are no model tests uploaded for your class level yet.</p>
                        </div>
                    <% } else { %>
                        <% modelTests.forEach(function(test) { %>
                            <% 
                               const tSubject = (test.subject || 'General').trim();
                               const tBoard = (test.board || '').trim();
                               const tYear = (test.year || '').trim();
                               const tTitle = test.title && test.title.trim() !== '' ? test.title.trim() : `${tSubject} ${tBoard} ${tYear}`.trim();
                            %>
                            <div class="model-card bg-[#F2F6F9] dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-2xl p-3.5 flex flex-col justify-between hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-3" data-subject="<%= tSubject %>" data-title="<%= tTitle.toLowerCase() %>">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-2">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20">
                                                <%= tSubject %>
                                            </span>
                                            <% if (test.duration && test.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300/60 dark:border-slate-700">
                                                    <%= test.duration %> Mins
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-emerald-500 transition-colors">
                                        <%= tTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-slate-200/70 dark:border-slate-700/50">
                                    <div class="text-[10px] font-medium text-slate-400 flex items-center gap-1 truncate">
                                        <span class="material-symbols-rounded text-xs text-emerald-500 leading-none select-none">workspace_premium</span>
                                        <span class="truncate"><%= tBoard || 'Model Test' %> <%= tYear ? ' • ' + tYear : '' %></span>
                                    </div>
                                    <a href="/question-bank/solve/<%= test._id %>" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold transition-all flex items-center gap-1 shadow-2xs active:scale-95 shrink-0">
                                        <span class="material-symbols-rounded text-sm leading-none">play_arrow</span>
                                        <span>Take Exam</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- EMPTY SEARCH RESULT STATE -->
                <div id="noResultsState" class="hidden py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                    <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">search_off</span>
                    <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Matching Model Tests</h3>
                    <p class="text-[11px] text-slate-400">Try adjusting your subject filter or search terms.</p>
                </div>
            </div>

        </main>
    </div>

    <script>
        let currentModelSubject = 'all';
        let currentModelSearch = '';

        window.filterModelWithSubject = function(subject) {
            currentModelSubject = subject || 'all';
            filterModelTests();
        };

        window.filterModelWithSearch = function(search) {
            currentModelSearch = (search || '').toLowerCase().trim();
            filterModelTests();
        };

        function filterModelTests() {
            const cards = document.querySelectorAll('.model-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject') || '';
                const cardTitle = card.getAttribute('data-title') || '';

                const matchesSubject = (currentModelSubject === 'all' || cardSubject === currentModelSubject);
                const matchesSearch = (currentModelSearch === '' || cardTitle.includes(currentModelSearch) || cardSubject.toLowerCase().includes(currentModelSearch));

                if (matchesSubject && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const badgeEl = document.getElementById('modelTestCountBadge');
            if (badgeEl) {
                badgeEl.textContent = `${visibleCount} Model Tests Available`;
            }

            const noResults = document.getElementById('noResultsState');
            if (noResults) {
                if (visibleCount === 0 && cards.length > 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
        }
    </script>
</body>
</html>
