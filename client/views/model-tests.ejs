<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Model Test | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header', { pageTitle: 'Model Test', activePage: 'exams', backUrl: '/exams' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <%
            const subjectsSet = new Set();
            if (locals.assignedSubjects && Array.isArray(assignedSubjects)) {
                assignedSubjects.forEach(s => { if (s && s.trim()) subjectsSet.add(s.trim()); });
            }
            if (locals.modelTests && Array.isArray(modelTests)) {
                modelTests.forEach(t => { if (t.subject && t.subject.trim()) subjectsSet.add(t.subject.trim()); });
            }
            const allModelSubjects = Array.from(subjectsSet).sort();
        %>

        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-0 pb-24 sm:pb-28 lg:pb-8">
            
            <!-- ON-SCREEN SEARCH & CUSTOM FILTER BAR (Placed directly on screen, ideal for small screens) -->
            <div class="sticky top-0 z-20 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 px-3 sm:px-4 py-2.5 sm:py-3 shadow-2xs">
                <div class="max-w-6xl w-full mx-auto space-y-2">
                    
                    <!-- Search Input & Custom Filter Dropdown Row (Sturdy & Touch-friendly for Small Screens) -->
                    <div class="flex items-center gap-2 w-full">
                        <!-- Live Search Input -->
                        <div class="relative flex-1 min-w-0">
                            <div class="absolute left-3 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none select-none text-slate-400 dark:text-slate-500">
                                <span class="material-symbols-rounded text-[19px] leading-none">search</span>
                            </div>
                            <input type="text" id="screenModelSearchInput"
                                oninput="handleScreenModelSearch(this.value)"
                                onkeyup="handleScreenModelSearch(this.value)"
                                placeholder="Search model tests, board, year..."
                                class="w-full h-11 pl-10 pr-9 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 rounded-xl outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/15 shadow-2xs transition-all">
                            <button type="button" id="screenModelClearSearchBtn" onclick="clearScreenModelSearch()"
                                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 size-5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 items-center justify-center transition-colors cursor-pointer select-none">
                                <span class="material-symbols-rounded text-sm">cancel</span>
                            </button>
                        </div>

                        <!-- Custom Subject Filter Dropdown -->
                        <div class="relative shrink-0" id="screenModelSubjectDropdownContainer">
                            <button type="button" id="screenModelSubjectDropdownBtn" onclick="toggleScreenModelSubjectDropdown(event)"
                                class="h-11 px-3 sm:px-3.5 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all active:scale-95 shadow-2xs"
                                title="Filter by Subject">
                                <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-lg leading-none shrink-0">tune</span>
                                <span id="screenModelSubjectSelectedLabel" class="truncate max-w-[85px] sm:max-w-[130px] font-bold">All Subjects</span>
                                <span id="screenModelSubjectDropdownArrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                            </button>

                            <!-- Custom Dropdown Popover Menu -->
                            <div id="screenModelSubjectDropdownMenu"
                                class="hidden absolute right-0 top-full mt-1.5 w-52 sm:w-60 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                                <!-- All Subjects Option -->
                                <button type="button" onclick="selectScreenModelSubject('all')"
                                    data-screen-subject-opt="all"
                                    class="screen-model-sub-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 font-bold">
                                    <span class="flex items-center gap-2">
                                        <span class="opt-dot size-1.5 rounded-full bg-emerald-500"></span>
                                        <span>All Subjects</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400 inline">check</span>
                                </button>
                                
                                <% allModelSubjects.forEach(sub => { %>
                                    <button type="button" onclick="selectScreenModelSubject('<%= sub.replace(/'/g, "\\'") %>')"
                                        data-screen-subject-opt="<%= sub %>"
                                        class="screen-model-sub-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                        <span class="flex items-center gap-2">
                                            <span class="opt-dot size-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                            <span class="truncate"><%= sub %></span>
                                        </span>
                                        <span class="opt-check material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400 hidden">check</span>
                                    </button>
                                <% }); %>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- CONTENT BODY WRAPPER -->
            <div class="max-w-6xl w-full mx-auto px-3 sm:px-4 pt-3 sm:pt-4 space-y-3 sm:space-y-4">

                <!-- STATUS & COUNT BAR -->
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 truncate">
                            <span id="activeFilterLabel">All Model Tests</span>
                        </span>
                        <button type="button" id="resetFiltersBtn" onclick="resetModelFilters()" class="hidden text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-0.5 shrink-0">
                            <span>Reset</span>
                            <span class="material-symbols-rounded text-xs leading-none">close</span>
                        </button>
                    </div>

                    <span class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-500/20 text-[11px] font-semibold flex items-center gap-1.5 shrink-0">
                        <span class="material-symbols-rounded text-xs sm:text-sm leading-none">workspace_premium</span>
                        <span id="modelTestCountBadge"><%= modelTests.length %> Available</span>
                    </span>
                </div>

                <!-- MODEL TESTS GRID -->
                <div id="modelTestsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
                    <% if (modelTests.length === 0) { %>
                        <div class="col-span-full py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                            <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">event_busy</span>
                            <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Model Tests Available</h3>
                            <p class="text-[11px] text-slate-400">There are no model tests uploaded for your class level yet.</p>
                        </div>
                    <% } else { %>
                        <% modelTests.forEach(function(test) { %>
                            <% 
                               const tSubject = (test.subject || 'General').trim();
                               const tBoard = (test.board || '').trim();
                               const tYear = (test.year || '').trim();
                               const tTitle = test.title && test.title.trim() !== '' ? test.title.trim() : `${tSubject} ${tBoard} ${tYear}`.trim();
                            %>
                            <div class="model-card bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/70 rounded-xl sm:rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-2.5"
                                 data-subject="<%= tSubject %>" 
                                 data-title="<%= tTitle.toLowerCase() %>"
                                 data-board="<%= tBoard.toLowerCase() %>"
                                 data-year="<%= tYear.toLowerCase() %>">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-1.5">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20">
                                                <%= tSubject %>
                                            </span>
                                            <% if (test.duration && test.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                                    <%= test.duration %> Mins
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                                        <%= tTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/50">
                                    <div class="flex items-center gap-1 text-[10px] font-medium text-slate-400 truncate">
                                        <span class="material-symbols-rounded text-xs text-emerald-500 leading-none">quiz</span>
                                        <span class="truncate"><%= test.totalQuestions %> Questions <%= tBoard ? '• ' + tBoard : '' %></span>
                                    </div>

                                    <a href="/question-bank/solve/<%= test._id %>?from=model" class="px-2.5 sm:px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-semibold transition-all shadow-2xs active:scale-95 flex items-center gap-1 shrink-0">
                                        <span>Start Exam</span>
                                        <span class="material-symbols-rounded text-xs leading-none">play_arrow</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- EMPTY SEARCH RESULT STATE -->
                <div id="noResultsState" class="hidden py-12 text-center bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 space-y-2">
                    <span class="material-symbols-rounded text-3xl text-slate-400 leading-none">search_off</span>
                    <h3 class="text-xs font-bold text-slate-600 dark:text-slate-400">No Matching Model Tests</h3>
                    <p class="text-[11px] text-slate-400">Try adjusting your subject filter or search terms.</p>
                    <div class="pt-1">
                        <button type="button" onclick="resetModelFilters()" class="px-3 py-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 rounded-xl hover:bg-emerald-100 transition-colors">
                            Clear Filters
                        </button>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'exams' }) %>

    <script>
        let currentModelSubject = 'all';
        let currentModelSearch = '';

        // Toggle custom dropdown
        function toggleScreenModelSubjectDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('screenModelSubjectDropdownMenu');
            const arrow = document.getElementById('screenModelSubjectDropdownArrow');
            if (menu) {
                const isOpen = !menu.classList.contains('hidden');
                if (isOpen) {
                    menu.classList.add('hidden');
                    if (arrow) arrow.style.transform = 'rotate(0deg)';
                } else {
                    menu.classList.remove('hidden');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }

        // Close dropdown when tapping outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('screenModelSubjectDropdownContainer');
            const menu = document.getElementById('screenModelSubjectDropdownMenu');
            const arrow = document.getElementById('screenModelSubjectDropdownArrow');
            if (container && menu && !container.contains(e.target)) {
                menu.classList.add('hidden');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
            }
        });

        // Select subject from dropdown or chips
        function selectScreenModelSubject(subject) {
            currentModelSubject = subject || 'all';

            // Close dropdown
            const menu = document.getElementById('screenModelSubjectDropdownMenu');
            const arrow = document.getElementById('screenModelSubjectDropdownArrow');
            if (menu) menu.classList.add('hidden');
            if (arrow) arrow.style.transform = 'rotate(0deg)';

            // Update dropdown trigger label
            const labelEl = document.getElementById('screenModelSubjectSelectedLabel');
            if (labelEl) {
                labelEl.textContent = (currentModelSubject === 'all') ? 'All Subjects' : currentModelSubject;
            }

            // Update dropdown options checkmarks and colors
            document.querySelectorAll('.screen-model-sub-opt').forEach(opt => {
                const optSub = opt.getAttribute('data-screen-subject-opt');
                const dot = opt.querySelector('.opt-dot');
                const check = opt.querySelector('.opt-check');
                if (optSub === currentModelSubject) {
                    opt.classList.add('bg-emerald-50', 'dark:bg-emerald-950/40', 'text-emerald-600', 'dark:text-emerald-400', 'font-bold');
                    opt.classList.remove('text-slate-700', 'dark:text-slate-300', 'font-medium');
                    if (dot) dot.classList.replace('bg-slate-300', 'bg-emerald-500');
                    if (check) check.classList.remove('hidden');
                } else {
                    opt.classList.remove('bg-emerald-50', 'dark:bg-emerald-950/40', 'text-emerald-600', 'dark:text-emerald-400', 'font-bold');
                    opt.classList.add('text-slate-700', 'dark:text-slate-300', 'font-medium');
                    if (dot) dot.classList.replace('bg-emerald-500', 'bg-slate-300');
                    if (check) check.classList.add('hidden');
                }
            });

            // Update dropdown trigger button active style
            const triggerBtn = document.getElementById('screenModelSubjectDropdownBtn');
            if (triggerBtn) {
                if (currentModelSubject !== 'all') {
                    triggerBtn.classList.add('bg-emerald-50/80', 'dark:bg-emerald-950/40', 'border-emerald-300', 'dark:border-emerald-500/40', 'text-emerald-700', 'dark:text-emerald-300');
                    triggerBtn.classList.remove('bg-slate-50', 'dark:bg-slate-800/90', 'border-slate-200/90', 'dark:border-slate-700/80', 'text-slate-700', 'dark:text-slate-200');
                } else {
                    triggerBtn.classList.remove('bg-emerald-50/80', 'dark:bg-emerald-950/40', 'border-emerald-300', 'dark:border-emerald-500/40', 'text-emerald-700', 'dark:text-emerald-300');
                    triggerBtn.classList.add('bg-slate-50', 'dark:bg-slate-800/90', 'border-slate-200/90', 'dark:border-slate-700/80', 'text-slate-700', 'dark:text-slate-200');
                }
            }

            // Synchronize desktop nav select if present
            const headerSelect = document.getElementById('model-header-subject');
            if (headerSelect && headerSelect.value !== currentModelSubject) {
                headerSelect.value = currentModelSubject;
            }

            filterModelTests();
        }

        // Live Search Handler
        function handleScreenModelSearch(val) {
            currentModelSearch = (val || '').toLowerCase().trim();
            
            const clearBtn = document.getElementById('screenModelClearSearchBtn');
            if (clearBtn) {
                if (currentModelSearch.length > 0) {
                    clearBtn.classList.remove('hidden');
                    clearBtn.classList.add('flex');
                } else {
                    clearBtn.classList.add('hidden');
                    clearBtn.classList.remove('flex');
                }
            }

            // Synchronize desktop header search input if present
            const headerInput = document.getElementById('model-search-input-header');
            if (headerInput && headerInput.value !== val) {
                headerInput.value = val;
            }

            filterModelTests();
        }

        // Clear Search
        function clearScreenModelSearch() {
            const input = document.getElementById('screenModelSearchInput');
            if (input) input.value = '';
            handleScreenModelSearch('');
        }

        // Reset all filters
        function resetModelFilters() {
            clearScreenModelSearch();
            selectScreenModelSubject('all');
        }

        // Core filter function
        function filterModelTests() {
            const cards = document.querySelectorAll('.model-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject') || '';
                const cardTitle = card.getAttribute('data-title') || '';
                const cardBoard = card.getAttribute('data-board') || '';
                const cardYear = card.getAttribute('data-year') || '';

                const matchesSubject = (currentModelSubject === 'all' || cardSubject === currentModelSubject);
                const matchesSearch = (
                    currentModelSearch === '' || 
                    cardTitle.includes(currentModelSearch) || 
                    cardSubject.toLowerCase().includes(currentModelSearch) ||
                    cardBoard.includes(currentModelSearch) ||
                    cardYear.includes(currentModelSearch)
                );

                if (matchesSubject && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            // Update badge count
            const badgeEl = document.getElementById('modelTestCountBadge');
            if (badgeEl) {
                badgeEl.textContent = `${visibleCount} Available`;
            }

            // Update active filter label and reset button
            const activeLabel = document.getElementById('activeFilterLabel');
            const resetBtn = document.getElementById('resetFiltersBtn');
            const hasFilter = (currentModelSubject !== 'all' || currentModelSearch !== '');

            if (activeLabel) {
                if (currentModelSubject !== 'all' && currentModelSearch) {
                    activeLabel.textContent = `Filtered: "${currentModelSubject}" & "${currentModelSearch}"`;
                } else if (currentModelSubject !== 'all') {
                    activeLabel.textContent = `Subject: ${currentModelSubject}`;
                } else if (currentModelSearch) {
                    activeLabel.textContent = `Search: "${currentModelSearch}"`;
                } else {
                    activeLabel.textContent = 'All Model Tests';
                }
            }

            if (resetBtn) {
                if (hasFilter) {
                    resetBtn.classList.remove('hidden');
                } else {
                    resetBtn.classList.add('hidden');
                }
            }

            // No results state
            const noResults = document.getElementById('noResultsState');
            if (noResults) {
                if (visibleCount === 0 && cards.length > 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
        }

        // Interop with desktop header if called from header
        window.filterModelWithSubject = function(subject) {
            selectScreenModelSubject(subject);
        };

        window.filterModelWithSearch = function(search) {
            const screenInput = document.getElementById('screenModelSearchInput');
            if (screenInput) screenInput.value = search;
            handleScreenModelSearch(search);
        };
    </script>
</body>
</html>
