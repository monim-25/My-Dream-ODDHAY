        function removeRoutineSlot(btn) {
            const container = document.getElementById('routineSlotsContainer');
            if (container.children.length > 1) {
                btn.closest('.routine-slot').remove();
            } else {
                alert("At least one schedule slot is required.");
            }
        }

        // Curriculum Management
        let chapterCount = 1;
        function addChapterSlot() {
            const container = document.getElementById('chapterSlotsContainer');
            const slot = document.createElement('div');
            slot.className = 'chapter-slot group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-xl flex items-center gap-3 relative animate-in fade-in slide-in-from-top-2 duration-200';
            slot.innerHTML = `
                <div class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 group-focus-within:bg-emerald-500 group-focus-within:text-white transition-all">
                    <span class="material-symbols-rounded text-sm">segment</span>
                </div>
                <div class="flex-1">
                    <input type="text" name="chapters[${chapterCount}][title]" required placeholder="New Chapter / Module Title..." class="form-input border-0 bg-transparent px-0 h-8 focus:ring-0">
                </div>

                    <button type="button" onclick="openChapterTeachersModal(this, ${chapterCount})" class="h-8 px-3 rounded-lg text-slate-500 hover:text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-500/10 transition-all flex items-center gap-1">
                        <span class="material-symbols-rounded text-[16px]">person_add</span>
                        <span class="text-[10px] font-bold">Teachers</span>
                    </button>
                    <div class="chapter-teachers-container hidden"></div>

<button type="button" onclick="this.closest('.chapter-slot').remove()" class="size-8 rounded-lg text-slate-300 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-all flex items-center justify-center">
                    <span class="material-symbols-rounded text-[18px]">close</span>
