                reader.readAsDataURL(file);
            }
        });

        // Routine Management
        let routineSlotCount = 1;
        function addRoutineSlot() {
            const container = document.getElementById('routineSlotsContainer');
            const slot = document.createElement('div');
            slot.className = 'routine-slot group bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 p-4 rounded-xl flex flex-wrap items-end gap-3 relative animate-in fade-in slide-in-from-top-2 duration-200';
            slot.innerHTML = `
                <div class="flex-1 min-w-[120px]">
                    <label class="text-[10px] font-bold text-slate-400 mb-1 block">Day</label>
