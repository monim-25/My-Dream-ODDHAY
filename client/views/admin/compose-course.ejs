    <script>
        function togglePricing(isPaid) {
            const grid = document.getElementById('pricingGrid');
            grid.style.opacity = isPaid ? '1' : '0.4';
            grid.querySelectorAll('input').forEach(i => i.disabled = !isPaid);
        }

        // Multi-select Logic
        function toggleDropdown(trigger) {
            const dropdown = trigger.nextElementSibling;
            const isOpen = dropdown.style.display === 'block';
            
            // Close all other dropdowns
            document.querySelectorAll('.multi-select-dropdown').forEach(d => d.style.display = 'none');
            
            dropdown.style.display = isOpen ? 'none' : 'block';
            event.stopPropagation();
        }

        function toggleOption(option, value, name) {
            const checkbox = option.querySelector('input');
            const checkIcon = option.querySelector('.material-symbols-rounded');
            const container = option.closest('.multi-select-container');
            const trigger = container.querySelector('.multi-select-trigger');
            
            checkbox.checked = !checkbox.checked;
            
            if (checkbox.checked) {
                option.classList.add('bg-blue-50', 'dark:bg-blue-900/20');
                checkIcon.classList.remove('hidden');
                checkIcon.parentElement.classList.add('bg-blue-500', 'border-blue-500');
            } else {
                option.classList.remove('bg-blue-50', 'dark:bg-blue-900/20');
                checkIcon.classList.add('hidden');
                checkIcon.parentElement.classList.remove('bg-blue-500', 'border-blue-500');
            }
            
            updatePills(container);
            event.stopPropagation();
        }

        function updatePills(container) {
            const trigger = container.querySelector('.multi-select-trigger');
            const checkboxes = container.querySelectorAll('input:checked');
            const placeholder = trigger.querySelector('.placeholder');
            
            // Clear existing pills except placeholder
            const existingPills = trigger.querySelectorAll('.multi-select-pill');
            existingPills.forEach(p => p.remove());
            
            if (checkboxes.length > 0) {
                placeholder.style.display = 'none';
                checkboxes.forEach(cb => {
                    const pill = document.createElement('div');
                    pill.className = 'multi-select-pill';
                    const label = cb.getAttribute('data-label') || cb.value;
                    pill.innerHTML = `${label} <span class="material-symbols-rounded text-[10px]" onclick="removePill(event, this, '${cb.value}')">close</span>`;
                    trigger.appendChild(pill);
                });
            } else {
                placeholder.style.display = 'block';
            }
        }

        function removePill(event, span, value) {
            event.stopPropagation();
            const container = span.closest('.multi-select-container');
            const checkbox = container.querySelector(`input[value="${value}"]`);
            const option = checkbox.closest('.multi-select-option');
            
            checkbox.checked = false;
            option.classList.remove('bg-blue-50', 'dark:bg-blue-900/20');
            const checkIcon = option.querySelector('.material-symbols-rounded');
            checkIcon.classList.add('hidden');
            checkIcon.parentElement.classList.remove('bg-blue-500', 'border-blue-500');
            
            updatePills(container);
        }

        // Close dropdowns on outside click
        window.onclick = function(event) {
            if (!event.target.closest('.multi-select-container')) {
                document.querySelectorAll('.multi-select-dropdown').forEach(d => d.style.display = 'none');
            }
        }

        // Search and Add Teacher Logic
        
        async function browseTeachersByClass() {
            const container = document.getElementById('browseTeachersContainer');
            const loading = document.getElementById('browseTeachersLoading');
            const list = document.getElementById('browseTeachersList');
            
            const isAdmin = window.location.pathname.startsWith('/admin');
            const baseUrl = isAdmin ? '/admin/api' : '/superadmin/api';
            
            const classCheckboxes = document.querySelectorAll('input[name="classLevel[]"]:checked, input[name="classes"]:checked, input[name="classes[]"]:checked');
            const classSelects = document.querySelectorAll('select[name="applicableClass"], select[name="classLevel"], select[name="class"]');
            
            let selectedClasses = [];
            classCheckboxes.forEach(cb => selectedClasses.push(cb.value));
            classSelects.forEach(sel => { if(sel.value) selectedClasses.push(sel.value); });
            
            if (selectedClasses.length === 0) {
                if (typeof showFeedback === 'function') showFeedback('Please select at least one Class Level first', 'error');
                return;
            }
            
            container.classList.remove('hidden');
            list.innerHTML = '';
            loading.classList.remove('hidden');
            
            try {
                const query = encodeURIComponent(selectedClasses.join(','));
                const res = await fetch(`${baseUrl}/teachers-by-class?classes=${query}`);
                const teachers = await res.json();
                
                loading.classList.add('hidden');
                
                if (teachers.length === 0) {
                    list.innerHTML = '<div class="text-[10px] text-slate-400 font-bold italic">No teachers found for the selected classes.</div>';
                    return;
                }
                
                teachers.forEach(teacher => {
                    const isAdded = document.querySelector(`input[name="permittedTeachers[]"][value="${teacher._id}"]`);
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg shrink-0';
                    div.innerHTML = `
                        <div class="flex items-center gap-3">
                            <img src="${teacher.profileImage || teacher.profilePicture || '/images/default-avatar.png'}" class="w-8 h-8 rounded-full object-cover">
                            <div class="flex flex-col leading-none">
                                <span class="text-[11px] font-bold text-slate-900 dark:text-white">${teacher.name}</span>
                                <span class="text-[9px] text-slate-400 font-medium">${teacher.email} | ${teacher.phone || 'No phone'}</span>
                            </div>
                        </div>
                        <button type="button" class="add-btn h-8 px-4 ${isAdded ? 'bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed' : 'bg-blue-500 hover:bg-blue-600 text-white'} rounded text-[10px] font-bold transition-all" ${isAdded ? 'disabled' : ''}>
                            ${isAdded ? 'Added' : 'Add'}
                        </button>
                    `;
                    if (!isAdded) {
                        div.querySelector('.add-btn').onclick = (e) => {
                            if (typeof addTeacherPill === 'function') addTeacherPill(teacher);
                            e.target.textContent = 'Added';
                            e.target.disabled = true;
                            e.target.className = 'add-btn h-8 px-4 bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed rounded text-[10px] font-bold transition-all';
                        };
                    }
                    list.appendChild(div);
                });
            } catch (err) {
                loading.classList.add('hidden');
                list.innerHTML = '<div class="text-[10px] text-rose-500 font-bold italic">Error loading teachers.</div>';
            }
        }

        async function searchAndAddTeacher() {
            const input = document.getElementById('teacherSearchInput');
            const feedback = document.getElementById('teacherSearchFeedback');
            const query = input.value.trim();
            
            if (!query) return;
            
            // Check for duplicates
            const existing = document.querySelector(`input[name="permittedTeachers[]"][value="${query}"]`);
            if (existing) {
                showFeedback('Teacher already added', 'error');
                return;
            }

            try {
                showFeedback('Searching...', 'info');
                const res = await fetch(`/admin/api/search-teacher?query=${encodeURIComponent(query)}`);
                const data = await res.json();
                
                if (!res.ok) {
                    showFeedback(data.error || 'Teacher not found', 'error');
                    return;
                }

                // Check for duplicates again with ID
                if (document.querySelector(`input[name="permittedTeachers[]"][value="${data._id}"]`)) {
                    showFeedback('Teacher already added', 'error');
                    return;
                }

                addTeacherPill(data);
                input.value = '';
                showFeedback('Teacher authorized successfully', 'success');
            } catch (err) {
                showFeedback('Failed to search teacher', 'error');
            }
        }

        function addTeacherPill(teacher) {
            const list = document.getElementById('authorizedTeachersList');
            const hint = list.querySelector('.no-teachers-hint');
            if (hint) hint.remove();

            const pill = document.createElement('div');
            pill.className = 'bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 pl-1 pr-3 py-1 rounded-full flex items-center gap-2 shadow-sm animate-in fade-in zoom-in duration-200';
            pill.innerHTML = `
                <img src="${teacher.profileImage || teacher.profilePicture || '/images/default-avatar.png'}" class="w-6 h-6 rounded-full object-cover">
                <div class="flex flex-col leading-none">
                    <span class="text-[10px] font-bold text-slate-900 dark:text-white">${teacher.name}</span>
                    <span class="text-[8px] text-slate-400 font-medium">${teacher.email}</span>
                </div>
                <input type="hidden" name="permittedTeachers[]" value="${teacher._id}">
                <button type="button" onclick="this.parentElement.remove(); checkEmptyTeachers();" class="w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all">
                    <span class="material-symbols-rounded text-[10px]">close</span>
                </button>
            `;
            list.appendChild(pill);
        }

        function checkEmptyTeachers() {
            const list = document.getElementById('authorizedTeachersList');
            if (list.children.length === 0) {
                list.innerHTML = `
                    <div class="no-teachers-hint text-[10px] text-slate-400 font-bold italic flex items-center gap-2 py-1">
                        <span class="material-symbols-rounded text-[14px]">info</span>
                        No teachers authorized yet.
                    </div>
                `;
            }
        }

        function showFeedback(msg, type) {
            const feedback = document.getElementById('teacherSearchFeedback');
            feedback.textContent = msg;
            feedback.className = `mt-2 text-[10px] font-bold ${type === 'error' ? 'text-rose-500' : (type === 'success' ? 'text-emerald-500' : 'text-blue-500')}`;
            feedback.classList.remove('hidden');
            if (type !== 'info') setTimeout(() => feedback.classList.add('hidden'), 3000);
        }

        // Thumbnail Preview
        document.getElementById('thumbnailInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
