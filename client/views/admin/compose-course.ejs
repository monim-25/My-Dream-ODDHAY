        // Routine Image Preview
        document.getElementById('routineImageInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if(file) {
                const reader = new FileReader();
                reader.onload = e => {
                    const previewContainer = document.getElementById('routinePreviewContainer');
                    previewContainer.innerHTML = `
                        <img src="${e.target.result}" class="w-full h-full object-cover" id="routinePreviewImg">
                        <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center text-white transition-opacity group-hover:bg-black/60">
                            <span class="material-symbols-rounded text-3xl mb-2">edit</span>
                            <p class="text-[10px] font-bold uppercase tracking-widest">Change Routine</p>
                        </div>
                    `;
                    previewContainer.classList.remove('hidden');
                }
                reader.readAsDataURL(file);
            }
        });
    
        let currentChapterSlot = null;
        let currentChapterIndex = 0;

        function openChapterTeachersModal(btn, idx) {
            currentChapterSlot = btn.closest('.chapter-slot');
            currentChapterIndex = idx;
            
            const authorizedInputs = document.querySelectorAll('input[name="permittedTeachers[]"]');
            const list = document.getElementById('chapterTeachersList');
            list.innerHTML = '';
            
            if (authorizedInputs.length === 0) {
                list.innerHTML = '<div class="text-[11px] text-rose-500 font-bold p-2 bg-rose-50 dark:bg-rose-500/10 rounded-lg">No authorized teachers found. Please add teachers to the course first.</div>';
            } else {
                let container = currentChapterSlot.querySelector('.chapter-teachers-container');
                if (!container) {
                    container = document.createElement('div');
                    container.className = 'chapter-teachers-container hidden';
                    currentChapterSlot.appendChild(container);
                }
                
                const existingInputs = container.querySelectorAll('input[name="chapters[' + idx + '][permittedTeachers][]"]');
                const selectedIds = Array.from(existingInputs).map(inp => inp.value);
                
                authorizedInputs.forEach(inp => {
                    const tId = inp.value;
                    const pill = inp.closest('div');
                    
                    let name = 'Unknown';
                    let email = '';
                    let imgSrc = '/images/default-avatar.png';
                    
                    if (pill) {
                        const nameEl = pill.querySelector('.flex-col > span:first-child');
                        const emailEl = pill.querySelector('.flex-col > span:nth-child(2)');
                        const imgEl = pill.querySelector('img');
                        if (nameEl) name = nameEl.textContent.trim();
                        if (emailEl) email = emailEl.textContent.trim();
                        if (imgEl) imgSrc = imgEl.src;
                    }
                    
                    const isChecked = selectedIds.includes(tId) ? 'checked' : '';
                    
                    const div = document.createElement('label');
                    div.className = 'flex items-center gap-3 p-2 rounded-lg border border-slate-200 dark:border-slate-800 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors';
                    div.innerHTML = `
                        <input type="checkbox" value="${tId}" ${isChecked} class="form-checkbox text-blue-500 rounded border-slate-300 dark:border-slate-600 focus:ring-0 w-4 h-4" onchange="toggleChapterTeacher(this.value, this.checked)">
                        <img src="${imgSrc}" class="w-8 h-8 rounded-full object-cover">
                        <div class="flex flex-col">
                            <span class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">${name}</span>
                            <span class="text-[9px] text-slate-500">${email}</span>
                        </div>
                    `;
                    list.appendChild(div);
                });
            }
            
            const modal = document.getElementById('chapterTeachersModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeChapterTeachersModal() {
            const modal = document.getElementById('chapterTeachersModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function toggleChapterTeacher(tId, isChecked) {
            if (!currentChapterSlot) return;
            let container = currentChapterSlot.querySelector('.chapter-teachers-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'chapter-teachers-container hidden';
                currentChapterSlot.appendChild(container);
            }
            
            const nameAttr = `chapters[${currentChapterIndex}][permittedTeachers][]`;
            
            if (isChecked) {
                if (!container.querySelector(`input[value="${tId}"]`)) {
                    const inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = nameAttr;
                    inp.value = tId;
                    container.appendChild(inp);
                }
            } else {
                const inp = container.querySelector(`input[value="${tId}"]`);
                if (inp) inp.remove();
            }
        }

</script>


<script>
    document.addEventListener('DOMContentLoaded', () => {
        const globalAcademicClasses = <%- typeof globalAcademicClasses !== 'undefined' ? JSON.stringify(globalAcademicClasses) : '[]' %>;
        if (!globalAcademicClasses || globalAcademicClasses.length === 0) return;

        function updateDynamicSubjects() {
            const classCheckboxes = document.querySelectorAll('input[name="classLevel[]"]:checked, input[name="classes"]:checked, input[name="classes[]"]:checked, input[name="targetClass"]:checked');
            const classSelects = document.querySelectorAll('select[name="applicableClass"], select[name="classLevel"], select[name="class"], select[name="targetClass"]');
            
            let selectedClasses = [];
            classCheckboxes.forEach(cb => selectedClasses.push(cb.value));
            classSelects.forEach(sel => { if(sel.value) selectedClasses.push(sel.value); });

            let allowedSubjects = new Set();
            if (selectedClasses.length === 0) {
                globalAcademicClasses.forEach(c => (c.subjects || []).forEach(s => allowedSubjects.add(s)));
            } else {
                globalAcademicClasses.forEach(c => {
                    const normalizedClass = c.name.replace('Class ', '');
                    if (selectedClasses.includes(c.name) || selectedClasses.includes(normalizedClass)) {
                        (c.subjects || []).forEach(s => allowedSubjects.add(s));
                    }
                });
            }

            const subjectCheckboxes = document.querySelectorAll('input[name="subject[]"], input[name="subjects"], input[name="subjects[]"], input[name="targetSubject"]');
            subjectCheckboxes.forEach(cb => {
                const optDiv = cb.closest('.multi-select-option');
                if (optDiv) {
                    if (allowedSubjects.has(cb.value)) {
                        optDiv.style.display = 'flex';
                    } else {
                        optDiv.style.display = 'none';
                        if (cb.checked) {
                            cb.checked = false;
                            const checkIcon = optDiv.querySelector('.material-symbols-rounded');
                            if (checkIcon) checkIcon.classList.add('hidden');
                            optDiv.classList.remove('bg-blue-50', 'dark:bg-blue-900/20');
                            if(checkIcon && checkIcon.parentElement) checkIcon.parentElement.classList.remove('bg-blue-500', 'border-blue-500');
                        }
                    }
                }
            });

            const subjectSelects = document.querySelectorAll('select[name="subject"], select[name="targetSubject"]');
            subjectSelects.forEach(sel => {
                const options = sel.querySelectorAll('option');
                let hasValidSelected = false;
                options.forEach(opt => {
                    if (!opt.value) return; 
                    if (allowedSubjects.has(opt.value)) {
                        opt.style.display = '';
                        if (sel.value === opt.value) hasValidSelected = true;
                    } else {
                        opt.style.display = 'none';
                    }
                });
                if (!hasValidSelected && sel.value) sel.value = '';
            });
            
            document.querySelectorAll('.multi-select-container').forEach(container => {
                const classLevelNames = ['classLevel', 'classes', 'targetClass', 'applicableClass'];
                const subjectNames = ['subject', 'subjects', 'targetSubject', 'applicableSubject'];
                const dataName = container.getAttribute('data-name');
                if (dataName && subjectNames.includes(dataName)) {
                    const triggerSpan = container.querySelector('.multi-select-trigger span');
                    const checkedBox = container.querySelectorAll('input[type="checkbox"]:checked');
                    if (triggerSpan) {
                        if (checkedBox.length === 0) {
                            triggerSpan.textContent = 'Select Subjects';
                            triggerSpan.classList.add('text-slate-400');
                            triggerSpan.classList.remove('text-slate-700', 'dark:text-slate-200');
                        } else {
                            triggerSpan.textContent = Array.from(checkedBox).map(cb => cb.value).join(', ');
                            triggerSpan.classList.remove('text-slate-400');
                            triggerSpan.classList.add('text-slate-700', 'dark:text-slate-200');
                        }
                    }
                }
            });
        }

        document.querySelectorAll('select[name="applicableClass"], select[name="classLevel"], select[name="class"], select[name="targetClass"]').forEach(sel => {
            sel.addEventListener('change', updateDynamicSubjects);
        });

        const observer = new MutationObserver(mutations => {
            let shouldUpdate = false;
            mutations.forEach(m => {
                const container = m.target.closest('.multi-select-container');
                if (container) {
                    const dataName = container.getAttribute('data-name') || '';
                    if (['classLevel', 'classes', 'targetClass', 'applicableClass'].includes(dataName) || container.querySelector('input[name="targetClass"]')) {
                        shouldUpdate = true;
                    }
                }
            });
            if (shouldUpdate) updateDynamicSubjects();
        });

        document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
            observer.observe(dropdown, { attributes: true, subtree: true, attributeFilter: ['class'] });
        });

        setTimeout(updateDynamicSubjects, 100);
    });
</script>
</body>
</html>