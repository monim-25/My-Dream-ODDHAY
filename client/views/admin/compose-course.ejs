                    <input type="time" name="routine[${routineSlotCount}][endTime]" class="form-input">
                </div>
                <div class="flex-[1.5] min-w-[150px]">
                    <label class="text-[10px] font-bold text-slate-400 mb-1 block">Topic / Note</label>
                    <input type="text" name="routine[${routineSlotCount}][note]" placeholder="e.g., Live Class" class="form-input">
                </div>
                <button type="button" onclick="removeRoutineSlot(this)" class="size-[42px] rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-rose-500 hover:border-rose-200 transition-all flex items-center justify-center">
                    <span class="material-symbols-rounded text-[20px]">delete</span>
                </button>
