<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title><%= targetUser.name %> | Profile Insight | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        
        /* Command Center Tabs */
        .tab-btn { position: relative; transition: all 0.2s ease; border-bottom: 2px solid transparent; }
        .tab-btn.active { color: #137fec; border-bottom-color: #137fec; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.25s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        /* Scope chip styles */
        .scope-chip { display: inline-flex; items-center; gap: 4px; padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600; }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'users' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'User Profile' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                <% 
                  function getWorkingDuration(date) {
                      if (!date) return 'N/A';
                      const start = new Date(date);
                      const end = new Date();
                      let years = end.getFullYear() - start.getFullYear();
                      let months = end.getMonth() - start.getMonth();
                      let days = end.getDate() - start.getDate();
                      if (days < 0) { months--; days += new Date(end.getFullYear(), end.getMonth(), 0).getDate(); }
                      if (months < 0) { years--; months += 12; }
                      let parts = [];
                      if (years > 0) parts.push(years + (years === 1 ? ' Year' : ' Years'));
                      if (months > 0) parts.push(months + (months === 1 ? ' Month' : ' Months'));
                      if (days > 0) parts.push(days + (days === 1 ? ' Day' : ' Days'));
                      return parts.length > 0 ? parts.join(', ') : 'Joined Today';
                  }

                  const userAvatar = targetUser.profilePicture || targetUser.profileImage;
                  const teacherClasses = (targetUser.assignedClasses && targetUser.assignedClasses.length > 0) ? targetUser.assignedClasses : (targetUser.classLevel ? targetUser.classLevel.split(/[,;/]+/).map(s=>s.trim()).filter(Boolean) : []);
                  const teacherSubjects = (targetUser.teachingSubjects && targetUser.teachingSubjects.length > 0) ? targetUser.teachingSubjects : (targetUser.teachingSubject ? targetUser.teachingSubject.split(/[,;/]+/).map(s=>s.trim()).filter(Boolean) : []);
                  const teacherClsText = teacherClasses.join(', ') || 'No Class Assigned';
                  const teacherSubText = teacherSubjects.join(', ') || 'No Subject Assigned';
                %>
                
                <!-- Main Container -->
                <div class="bg-white dark:bg-[#0b1120] rounded-lg border border-slate-200 dark:border-slate-700/50 shadow-sm mb-3 flex flex-col flex-1">
                    
                    <!-- Profile Header Section -->
                    <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex flex-col gap-5 shrink-0">
                        <!-- Top Row: Avatar + Info -->
                        <div class="flex flex-col md:flex-row items-center md:items-start gap-5 w-full">
                            <!-- Avatar -->
                            <div class="relative shrink-0">
                                <div class="size-24 sm:size-28 md:size-32 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-4xl font-black text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
                                    <% if (userAvatar) { %>
                                        <img src="<%= userAvatar %>" alt="<%= targetUser.name %>" class="size-full object-cover block" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';">
                                        <span class="hidden size-full items-center justify-center font-bold text-3xl text-slate-500 select-none">
                                            <%= targetUser.name ? targetUser.name[0].toUpperCase() : 'U' %>
                                        </span>
                                    <% } else { %>
                                        <span class="size-full flex items-center justify-center font-bold text-3xl text-slate-500 select-none">
                                            <%= targetUser.name ? targetUser.name[0].toUpperCase() : 'U' %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- User Info -->
                            <div class="flex-1 min-w-0 flex flex-col justify-center w-full text-center md:text-left">
                                <!-- Line 1: Name and Actions -->
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between w-full gap-3 mb-2.5">
                                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
                                        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white truncate"><%= targetUser.name %></h1>
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider <%= targetUser.role === 'superadmin' ? 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300' : targetUser.role === 'admin' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : targetUser.role === 'teacher' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300' %>">
                                            <%= targetUser.role %>
                                        </span>
                                        <% if (targetUser.status === 'suspended') { %>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300">Suspended</span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">Active</span>
                                        <% } %>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex items-center justify-center md:justify-start gap-2">
                                        <button type="button" onclick="openDirectMessageModal()" class="h-8 px-3 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-semibold text-xs border border-indigo-200 dark:border-indigo-500/20 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 dark:hover:text-white transition-all shadow-2xs flex items-center gap-1.5" title="Message User">
                                            <span class="material-symbols-rounded text-[14px]">chat</span> Message
                                        </button>
                                        <button class="h-8 px-3 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-xs border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-all shadow-2xs flex items-center gap-1.5" onclick="resetPassword()">
                                            <span class="material-symbols-rounded text-[14px]">key</span> Reset Pass
                                        </button>
                                        <% if(targetUser.status === 'suspended') { %>
                                            <button class="h-8 px-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold text-xs border border-emerald-200 dark:border-emerald-500/20 hover:bg-emerald-500 hover:text-white transition-all shadow-2xs flex items-center gap-1.5" onclick="toggleStatus('active')">
                                                <span class="material-symbols-rounded text-[14px]">check_circle</span> Activate
                                            </button>
                                        <% } else { %>
                                            <button class="h-8 px-3 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 font-semibold text-xs border border-amber-200 dark:border-amber-500/20 hover:bg-amber-500 hover:text-white transition-all shadow-2xs flex items-center gap-1.5" onclick="toggleStatus('suspended')">
                                                <span class="material-symbols-rounded text-[14px]">block</span> Suspend
                                            </button>
                                        <% } %>
                                        <button class="h-8 w-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 font-semibold text-xs border border-rose-200 dark:border-rose-500/20 hover:bg-rose-500 hover:text-white transition-all shadow-2xs flex items-center justify-center gap-1.5" onclick="deleteUser()" title="Delete User">
                                            <span class="material-symbols-rounded text-[15px]">delete</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Line 2: Identity Badges -->
                                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-3">
                                    <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                                        <span class="material-symbols-rounded text-[13px] text-slate-400">mail</span>
                                        <%= targetUser.email || 'N/A' %>
                                    </div>
                                    <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                                        <span class="material-symbols-rounded text-[13px] text-slate-400">call</span>
                                        <%= targetUser.phone || 'N/A' %>
                                    </div>

                                    <!-- Teacher Designation Badge with Edit Button -->
                                    <% if (targetUser.role === 'teacher') { %>
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-blue-200 dark:border-blue-500/30 bg-blue-50 dark:bg-blue-500/10 text-[11px] font-semibold text-blue-700 dark:text-blue-300">
                                            <span class="material-symbols-rounded text-[13px] text-blue-500">badge</span>
                                            <span>Designation: <strong class="font-bold"><%= targetUser.designation || 'Instructor' %></strong></span>
                                            <button type="button" onclick="editTeacherDesignation('<%= targetUser._id %>', '<%= (targetUser.designation || '').replace(/'/g, "\\'") %>')" class="size-4.5 rounded hover:bg-blue-200 dark:hover:bg-blue-900/60 flex items-center justify-center text-blue-600 dark:text-blue-300 transition-colors ml-0.5" title="Declare / Edit Teacher Designation">
                                                <span class="material-symbols-rounded text-[12px]">edit</span>
                                            </button>
                                        </div>

                                        <!-- Teacher Teaching Subject & Class Badge (ONLY FOR TEACHER) -->
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-fuchsia-200 dark:border-fuchsia-500/30 bg-fuchsia-50 dark:bg-fuchsia-500/10 text-[11px] font-semibold text-fuchsia-700 dark:text-fuchsia-300">
                                            <span class="material-symbols-rounded text-[13px] text-fuchsia-500">menu_book</span>
                                            <span>Teaching: <strong class="font-bold"><%= teacherClsText %></strong> • <strong class="font-bold"><%= teacherSubText %></strong></span>
                                            <button type="button" onclick="openAcademicScopeModal()" class="size-4.5 rounded hover:bg-fuchsia-200 dark:hover:bg-fuchsia-900/60 flex items-center justify-center text-fuchsia-600 dark:text-fuchsia-300 transition-colors ml-0.5" title="Assign / Edit Teacher Subject & Class">
                                                <span class="material-symbols-rounded text-[12px]">edit</span>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Line 3: Quick Metric Stats -->
                                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                                    <% if (targetUser.role === 'teacher') { %>
                                        <div onclick="switchTab('courses', document.getElementById('tab-btn-courses'))" class="cursor-pointer p-2.5 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 hover:border-blue-400 transition-all">
                                            <p class="text-[10px] font-bold text-blue-600 dark:text-blue-400 mb-0.5">Assigned Courses</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.coursesMentored : 0 %> Units</p>
                                        </div>
                                        <div onclick="switchTab('quizzes', document.getElementById('tab-btn-quizzes'))" class="cursor-pointer p-2.5 rounded-xl bg-violet-50 dark:bg-violet-500/10 border border-violet-200 dark:border-violet-500/20 hover:border-violet-400 transition-all">
                                            <p class="text-[10px] font-bold text-violet-600 dark:text-violet-400 mb-0.5">Quizzes Made</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.quizzesCount : 0 %> Exams</p>
                                        </div>
                                        <div onclick="switchTab('topics', document.getElementById('tab-btn-topics'))" class="cursor-pointer p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 hover:border-emerald-400 transition-all">
                                            <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 mb-0.5">AI Topics</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.topicsCount : 0 %> Topics</p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Notes added</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.notesAdded : 0 %></p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Questions added</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.questionsAdded : 0 %></p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Classes taken</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= teacherStats ? teacherStats.classesTaken : 0 %></p>
                                        </div>
                                    <% } else if (targetUser.role === 'admin' || targetUser.role === 'superadmin') { %>
                                        <div class="p-2.5 rounded-xl bg-blue-500/10 border border-blue-500/20">
                                            <p class="text-[10px] font-bold text-blue-600 dark:text-blue-400 mb-0.5">Working Duration</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= getWorkingDuration(targetUser.createdAt) %></p>
                                        </div>
                                        <div onclick="switchTab('management', document.getElementById('tab-btn-management'))" class="cursor-pointer p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 hover:border-emerald-400 transition-all">
                                            <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 mb-0.5">Courses Created</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= adminStats ? adminStats.totalCourses : 0 %> Units</p>
                                        </div>
                                        <div onclick="switchTab('aimoderation', document.getElementById('tab-btn-aimoderation'))" class="cursor-pointer p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 hover:border-indigo-400 transition-all">
                                            <p class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 mb-0.5">AI Topics Moderated</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= adminStats ? adminStats.totalReviewedTopics : 0 %> Reviewed</p>
                                        </div>
                                        <div onclick="switchTab('appointed', document.getElementById('tab-btn-appointed'))" class="cursor-pointer p-2.5 rounded-xl bg-purple-500/10 border border-purple-500/20 hover:border-purple-400 transition-all">
                                            <p class="text-[10px] font-bold text-purple-600 dark:text-purple-400 mb-0.5">Appointed Accounts</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= appointedAccounts ? appointedAccounts.length : 0 %> Users</p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20">
                                            <p class="text-[10px] font-bold text-amber-600 dark:text-amber-400 mb-0.5">Admin Actions</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= adminStats ? adminStats.totalUserActions : 0 %> Logged</p>
                                        </div>
                                    <% } else if (targetUser.role === 'guardian' || targetUser.role === 'parent') { %>
                                        <% if (guardianStats && guardianStats.connectedStudents && guardianStats.connectedStudents.length > 0) { %>
                                            <% guardianStats.connectedStudents.forEach(stu => { %>
                                                <a href="/superadmin/user/<%= stu._id %>" class="flex items-center gap-3 p-2.5 px-4 rounded-xl bg-blue-500/5 border border-blue-200 dark:border-blue-500/20 hover:bg-blue-500 hover:text-white transition-all shadow-2xs">
                                                    <span class="material-symbols-rounded text-lg text-blue-500">school</span>
                                                    <div>
                                                        <p class="text-[10px] uppercase font-bold tracking-wider opacity-70">Linked Student</p>
                                                        <p class="text-xs font-bold leading-tight"><%= stu.name %></p>
                                                    </div>
                                                </a>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="p-2.5 rounded-xl bg-rose-500/5 border border-rose-500/20 flex items-center gap-2">
                                                <span class="material-symbols-rounded text-rose-500 text-sm">person_off</span>
                                                <p class="text-xs font-bold text-rose-600">No students linked to this account</p>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Achievement</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= targetUser.totalXP || 0 %> XP</p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Active streak</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight"><%= targetUser.streak || 0 %> Days</p>
                                        </div>
                                        <div class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Total spent</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight">৳ <%= stats.totalSpend %></p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Tabs Bar -->
                    <div id="tabs-nav-bar" class="flex flex-wrap border-b border-slate-100 dark:border-slate-800 px-4 pt-2 gap-1 shrink-0">
                        <% if (targetUser.role === 'admin' || targetUser.role === 'superadmin') { %>
                            <button id="tab-btn-management" class="tab-btn active px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('management', this)">Created Courses (<%= adminStats ? adminStats.totalCourses : 0 %>)</button>
                            <button id="tab-btn-aimoderation" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('aimoderation', this)">AI Approvals & Moderation (<%= adminStats ? adminStats.totalReviewedTopics : 0 %>)</button>
                            <button id="tab-btn-appointed" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('appointed', this)">Appointed Accounts (<%= appointedAccounts ? appointedAccounts.length : 0 %>)</button>
                            <button id="tab-btn-integration" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('integration', this)">User Moderation Actions</button>
                            <button id="tab-btn-activity" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('activity', this)">System Activity</button>
                        <% } else if (targetUser.role === 'teacher') { %>
                            <button id="tab-btn-info" class="tab-btn active px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('info', this)">Teacher Info</button>
                            <button id="tab-btn-courses" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('courses', this)">Assigned Courses (<%= teacherStats ? teacherStats.coursesMentored : 0 %>)</button>
                            <button id="tab-btn-topics" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('topics', this)">AI Topics (<%= teacherStats ? teacherStats.topicsCount : 0 %>)</button>
                            <button id="tab-btn-quizzes" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('quizzes', this)">Quizzes (<%= teacherStats ? teacherStats.quizzesCount : 0 %>)</button>
                            <button id="tab-btn-finances" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('finances', this)">Content Details</button>
                            <button id="tab-btn-activity" class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('activity', this)">System Activity</button>
                        <% } else if (targetUser.role === 'guardian' || targetUser.role === 'parent') { %>
                            <button class="tab-btn active px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('complain', this)">Complain</button>
                            <button class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('finances', this)">Finances</button>
                        <% } else { %>
                            <button class="tab-btn active px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('enrollments', this)">Academic Enrollments</button>
                            <button class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('assessments', this)">Assessments</button>
                            <button class="tab-btn px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" onclick="switchTab('finances', this)">Finances</button>
                        <% } %>
                    </div>

                    <!-- Tab Contents Area -->
                    <div class="p-4 sm:p-6 flex-1 min-h-[400px]">

                        <% if (targetUser.role === 'teacher') { %>
                            <!-- 1. Teacher Info Tab (Real details filled by teacher only) -->
                            <div id="tab-info" class="tab-content active">
                                <div class="max-w-4xl flex flex-col gap-4">
                                    <% if (creatorAdmin) { %>
                                        <!-- Appointed by Admin Card -->
                                        <div class="p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="size-8 rounded-full overflow-hidden bg-slate-200 dark:bg-slate-700 shrink-0">
                                                    <% if (creatorAdmin.profilePicture || creatorAdmin.profileImage) { %>
                                                        <img src="<%= creatorAdmin.profilePicture || creatorAdmin.profileImage %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <div class="w-full h-full flex items-center justify-center font-bold text-xs text-slate-600 dark:text-slate-300">
                                                            <%= (creatorAdmin.name || 'A').charAt(0).toUpperCase() %>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                <div>
                                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                                        <span class="italic">Appointed by</span> 
                                                        <a href="<%= (user.role === 'admin' ? '/admin' : '/superadmin') %>/user/<%= creatorAdmin._id %>" class="font-bold text-slate-800 dark:text-slate-100 hover:text-primary transition-colors underline decoration-slate-300 dark:decoration-slate-600 underline-offset-2">
                                                            <%= creatorAdmin.name %>
                                                        </a>
                                                        <span class="text-[10px] ml-1.5 px-2 py-0.5 rounded-full font-bold uppercase <%= creatorAdmin.role === 'superadmin' ? 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300' %>"><%= creatorAdmin.role %></span>
                                                    </p>
                                                    <p class="text-[10px] text-slate-400 mt-0.5">Institutional staff onboarding authority</p>
                                                </div>
                                            </div>
                                            <a href="<%= (user.role === 'admin' ? '/admin' : '/superadmin') %>/user/<%= creatorAdmin._id %>" class="text-xs font-semibold text-primary hover:underline flex items-center gap-0.5">
                                                View Profile <span class="material-symbols-rounded text-sm">arrow_forward</span>
                                            </a>
                                        </div>
                                    <% } %>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                        <!-- Designation -->
                                        <div class="p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-500 flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-rounded text-lg">work</span>
                                                </div>
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Designation</p>
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= targetUser.designation || 'Instructor' %></p>
                                                </div>
                                            </div>
                                            <button type="button" onclick="editTeacherDesignation('<%= targetUser._id %>', '<%= (targetUser.designation || '').replace(/'/g, "\\'") %>')" class="px-2 py-1 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:text-blue-500 transition-colors flex items-center gap-1 shadow-2xs">
                                                <span class="material-symbols-rounded text-xs">edit</span> Edit
                                            </button>
                                        </div>

                                        <!-- Experience -->
                                        <div class="p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 flex items-center gap-3">
                                            <div class="size-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                                                <span class="material-symbols-rounded text-lg">history</span>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-slate-400 mb-0.5">Teaching Experience</p>
                                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= targetUser.experience || 'Not specified' %></p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Academic History (Real inputs from onboarding) -->
                                    <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                                        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-200/60 dark:border-slate-800">
                                            <span class="material-symbols-rounded text-indigo-500 text-lg">school</span>
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">Academic History (Filled by Teacher)</h4>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                            <!-- School -->
                                            <div class="bg-white dark:bg-slate-800/60 p-3 rounded-lg border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between">
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-1">Secondary School (SSC)</p>
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mb-2 leading-snug"><%= targetUser.schoolName || 'Not specified' %></p>
                                                </div>
                                                <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700/50 pt-2 mt-auto">
                                                    <span class="text-[10px] text-slate-400 font-medium">SSC Result</span>
                                                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400"><%= targetUser.sscGpa ? 'GPA ' + targetUser.sscGpa : 'N/A' %></span>
                                                </div>
                                            </div>
                                            <!-- College -->
                                            <div class="bg-white dark:bg-slate-800/60 p-3 rounded-lg border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between">
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-1">Higher Secondary College (HSC)</p>
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mb-2 leading-snug"><%= targetUser.collegeName || 'Not specified' %></p>
                                                </div>
                                                <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700/50 pt-2 mt-auto">
                                                    <span class="text-[10px] text-slate-400 font-medium">HSC Result</span>
                                                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400"><%= targetUser.hscGpa ? 'GPA ' + targetUser.hscGpa : 'N/A' %></span>
                                                </div>
                                            </div>
                                            <!-- University -->
                                            <div class="bg-white dark:bg-slate-800/60 p-3 rounded-lg border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between">
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-1">University / Highest Institution</p>
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mb-2 leading-snug"><%= targetUser.universityName || 'Not specified' %></p>
                                                </div>
                                                <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700/50 pt-2 mt-auto">
                                                    <span class="text-[10px] text-slate-400 font-medium">CGPA / Grade</span>
                                                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400"><%= targetUser.cgpa ? 'CGPA ' + targetUser.cgpa : 'N/A' %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Contact & Addresses -->
                                    <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                                        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-200/60 dark:border-slate-800">
                                            <span class="material-symbols-rounded text-rose-500 text-lg">home_pin</span>
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">Address & Contact Details</h4>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                            <div class="space-y-2">
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Email Address</p>
                                                    <p class="text-xs font-medium text-slate-800 dark:text-slate-200"><%= targetUser.email || 'N/A' %></p>
                                                </div>
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Phone Number</p>
                                                    <p class="text-xs font-medium text-slate-800 dark:text-slate-200"><%= targetUser.phone || 'N/A' %></p>
                                                </div>
                                            </div>
                                            <div class="space-y-2">
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Present Address</p>
                                                    <p class="text-xs font-medium text-slate-800 dark:text-slate-200"><%= targetUser.presentAddress || 'Not specified' %></p>
                                                </div>
                                                <div>
                                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Permanent Address</p>
                                                    <p class="text-xs font-medium text-slate-800 dark:text-slate-200"><%= targetUser.permanentAddress || 'Not specified' %></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bio & Achievements -->
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-slate-400 text-base">person</span> Professional Bio
                                            </p>
                                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap"><%= targetUser.bio || 'No professional bio provided.' %></p>
                                        </div>
                                        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-amber-500 text-base">emoji_events</span> Key Achievements
                                            </p>
                                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap"><%= targetUser.achievements || 'No notable achievements listed.' %></p>
                                        </div>
                                    </div>

                                    <!-- Social Links (if any) -->
                                    <% if (targetUser.socialLinks && (targetUser.socialLinks.facebook || targetUser.socialLinks.linkedin)) { %>
                                        <div class="p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 flex items-center gap-4">
                                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Social Presence:</p>
                                            <% if (targetUser.socialLinks.facebook) { %>
                                                <a href="<%= targetUser.socialLinks.facebook %>" target="_blank" class="text-xs text-blue-600 hover:underline flex items-center gap-1">
                                                    <span class="material-symbols-rounded text-sm">link</span> Facebook
                                                </a>
                                            <% } %>
                                            <% if (targetUser.socialLinks.linkedin) { %>
                                                <a href="<%= targetUser.socialLinks.linkedin %>" target="_blank" class="text-xs text-blue-500 hover:underline flex items-center gap-1">
                                                    <span class="material-symbols-rounded text-sm">link</span> LinkedIn
                                                </a>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- 2. Assigned Courses Tab -->
                            <div id="tab-courses" class="tab-content">
                                <% if (teacherCourses && teacherCourses.length > 0) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                        <% teacherCourses.forEach(c => { %>
                                            <a href="/superadmin/course/<%= c._id %>" class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-primary/50 transition-all flex flex-col justify-between shadow-2xs">
                                                <div>
                                                    <div class="flex items-center justify-between mb-2">
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= c.accessType === 'free' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10' : 'bg-blue-50 text-blue-600 dark:bg-blue-500/10' %>">
                                                            <%= c.accessType || 'enrolled' %>
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-medium"><%= c.category || 'Academic' %></span>
                                                    </div>
                                                    <h4 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors line-clamp-2 mb-1.5"><%= c.title %></h4>
                                                    <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-3"><%= c.subject %> • <%= c.classLevel %></p>
                                                </div>
                                                <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 dark:border-slate-800 text-[10px] text-slate-400 font-semibold">
                                                    <span><%= c.chapters ? c.chapters.length : 0 %> Chapters</span>
                                                    <span class="flex items-center gap-0.5 text-primary group-hover:translate-x-0.5 transition-transform">
                                                        View Course <span class="material-symbols-rounded text-[12px]">arrow_forward</span>
                                                    </span>
                                                </div>
                                            </a>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                                        <span class="material-symbols-rounded text-5xl mb-2 opacity-40">school</span>
                                        <p class="text-xs font-bold">No courses assigned or created by this teacher yet</p>
                                    </div>
                                <% } %>
                            </div>

                            <!-- 3. AI Topics Tab -->
                            <div id="tab-topics" class="tab-content">
                                <% if (teacherTopics && teacherTopics.length > 0) { %>
                                    <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl">
                                        <table class="w-full text-left border-collapse">
                                            <thead class="bg-slate-50/70 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800">
                                                <tr>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Topic Name</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Class & Subject</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Chapter</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider text-center">Status</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider text-right">Created</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                                                <% teacherTopics.forEach(t => { %>
                                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                                                        <td class="px-4 py-3 font-bold text-slate-900 dark:text-white">
                                                            <%= t.name %>
                                                            <% if (t.code) { %>
                                                                <span class="text-[10px] font-mono text-slate-400 ml-1">(<%= t.code %>)</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300 font-medium">
                                                            <%= t.classLevel %> • <%= t.subject %>
                                                        </td>
                                                        <td class="px-4 py-3 text-slate-500">
                                                            <%= t.chapter ? t.chapter.name : 'N/A' %>
                                                        </td>
                                                        <td class="px-4 py-3 text-center">
                                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= t.status === 'approved' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10' : t.status === 'rejected' ? 'bg-rose-50 text-rose-600 dark:bg-rose-500/10' : 'bg-amber-50 text-amber-600 dark:bg-amber-500/10' %>">
                                                                <%= t.status || 'approved' %>
                                                            </span>
                                                        </td>
                                                        <td class="px-4 py-3 text-right text-slate-400 text-[11px]">
                                                            <%= new Date(t.createdAt).toLocaleDateString('en-GB') %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                                        <span class="material-symbols-rounded text-5xl mb-2 opacity-40">psychology</span>
                                        <p class="text-xs font-bold">No topics submitted for AI by this teacher yet</p>
                                    </div>
                                <% } %>
                            </div>

                            <!-- 4. Quizzes Tab -->
                            <div id="tab-quizzes" class="tab-content">
                                <% if (teacherQuizzes && teacherQuizzes.length > 0) { %>
                                    <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl">
                                        <table class="w-full text-left border-collapse">
                                            <thead class="bg-slate-50/70 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800">
                                                <tr>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Quiz Title</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Associated Course</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider text-center">Questions</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider text-center">Access</th>
                                                    <th class="px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider text-right">Created</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                                                <% teacherQuizzes.forEach(q => { %>
                                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                                                        <td class="px-4 py-3 font-bold text-slate-900 dark:text-white">
                                                            <%= q.title %>
                                                        </td>
                                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300 font-medium">
                                                            <%= q.course ? q.course.title : 'Model Test / General' %>
                                                        </td>
                                                        <td class="px-4 py-3 text-center font-bold text-slate-700 dark:text-slate-300">
                                                            <%= q.questions ? q.questions.length : 0 %>
                                                        </td>
                                                        <td class="px-4 py-3 text-center">
                                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= q.accessType === 'free' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10' : 'bg-blue-50 text-blue-600 dark:bg-blue-500/10' %>">
                                                                <%= q.accessType || 'enrolled' %>
                                                            </span>
                                                        </td>
                                                        <td class="px-4 py-3 text-right text-slate-400 text-[11px]">
                                                            <%= new Date(q.createdAt).toLocaleDateString('en-GB') %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                                        <span class="material-symbols-rounded text-5xl mb-2 opacity-40">quiz</span>
                                        <p class="text-xs font-bold">No quizzes created by this teacher yet</p>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>

                        <% if (targetUser.role === 'admin' || targetUser.role === 'superadmin') { %>
                            <!-- Admin Management Tab (Created Courses) -->
                            <div id="tab-management" class="tab-content active">
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                    <% if (adminCourses && adminCourses.length > 0) { %>
                                        <% adminCourses.forEach(course => { %>
                                            <a href="/superadmin/course/<%= course._id %>" class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-blue-500/40 transition-all group block shadow-2xs">
                                                <div class="flex items-center gap-3">
                                                    <div class="size-11 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white transition-all shrink-0">
                                                        <span class="material-symbols-rounded">school</span>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate group-hover:text-blue-500 transition-colors"><%= course.title %></h4>
                                                        <p class="text-[10px] font-bold text-slate-500 mt-0.5"><%= course.subject %> • <%= course.classLevel %></p>
                                                        <p class="text-[9px] font-semibold text-slate-400 mt-1">Created on: <%= new Date(course.createdAt).toLocaleDateString('en-GB') %></p>
                                                    </div>
                                                </div>
                                            </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="col-span-full py-16 flex flex-col items-center justify-center text-slate-400">
                                            <span class="material-symbols-rounded text-5xl mb-2 opacity-40">library_add</span>
                                            <p class="text-xs font-bold">No courses created yet</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Admin AI Moderation Tab -->
                            <div id="tab-aimoderation" class="tab-content">
                                <% if (adminReviewedTopics && adminReviewedTopics.length > 0) { %>
                                    <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl mb-6">
                                        <div class="px-4 py-3 bg-slate-50/80 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-indigo-500 text-sm">verified</span> AI Topics Reviewed & Approved
                                            </h4>
                                            <span class="text-[11px] font-bold text-slate-400"><%= adminReviewedTopics.length %> topics</span>
                                        </div>
                                        <table class="w-full text-left border-collapse text-xs">
                                            <thead class="bg-slate-50/40 dark:bg-slate-900/30 border-b border-slate-200 dark:border-slate-800">
                                                <tr>
                                                    <th class="px-4 py-2.5 text-[10px] font-bold text-slate-500 uppercase">Topic Name</th>
                                                    <th class="px-4 py-2.5 text-[10px] font-bold text-slate-500 uppercase">Class & Subject</th>
                                                    <th class="px-4 py-2.5 text-[10px] font-bold text-slate-500 uppercase text-center">Status</th>
                                                    <th class="px-4 py-2.5 text-[10px] font-bold text-slate-500 uppercase text-right">Review Date</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                <% adminReviewedTopics.forEach(top => { %>
                                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02]">
                                                        <td class="px-4 py-2.5 font-bold text-slate-900 dark:text-white"><%= top.name %></td>
