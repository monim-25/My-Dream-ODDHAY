    <!-- Pre-load Academic Data for Scope Modal -->
    <script>
        const ACADEMIC_CLASSES = <%- JSON.stringify(academicClasses || []) %>;
        const TARGET_USER_ID = '<%= targetUser._id %>';
        const TARGET_USER_CLASSES = <%- JSON.stringify(teacherClasses) %>;
        const TARGET_USER_SUBJECTS = <%- JSON.stringify(teacherSubjects) %>;
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            const target = document.getElementById('tab-' + tabId);
            if (target) target.classList.add('active');
            if (btn) btn.classList.add('active');
        }

        // 1. Edit Teacher Designation
        async function editTeacherDesignation(userId, currentDesignation) {
            const { value: newDesignation } = await Swal.fire({
                title: '<p class="text-sm font-bold tracking-tight">Declare Teacher Designation</p>',
                input: 'text',
                inputLabel: 'Official Professional Designation',
                inputValue: currentDesignation || '',
                inputPlaceholder: 'e.g. Senior Lecturer, Head of Mathematics, Assistant Teacher',
                showCancelButton: true,
                confirmButtonText: 'Save Designation',
                confirmButtonColor: '#137fec',
                cancelButtonText: 'Cancel',
                inputValidator: (val) => {
                    if (!val || !val.trim()) return 'Designation cannot be empty';
                }
            });

            if (newDesignation !== undefined) {
                try {
                    Swal.fire({ title: 'Saving...', didOpen: () => Swal.showLoading() });
                    const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';
                    const res = await fetch(`${apiBase}/users/${userId}/update`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ designation: newDesignation.trim() })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await Swal.fire({ icon: 'success', title: 'Saved!', text: 'Teacher designation updated successfully', timer: 1200, showConfirmButton: false });
                        window.location.reload();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to update designation', 'error');
                    }
                } catch(e) {
                    Swal.fire('Error', e.message || 'Network error', 'error');
                }
            }
        }

        // 2. Assign Teacher Subject & Class (Dropdown & Option to Add/Remove)
        function openAcademicScopeModal() {
            let selectedClasses = [...TARGET_USER_CLASSES];
            let selectedSubjects = [...TARGET_USER_SUBJECTS];

            function renderScopeModalHTML() {
                // Collect unique subjects from selected classes, or fallback to all available subjects
                let availableSubjectsSet = new Set();
                ACADEMIC_CLASSES.forEach(c => {
                    if (selectedClasses.length === 0 || selectedClasses.includes(c.name)) {
                        (c.subjects || []).forEach(s => availableSubjectsSet.add(s));
                        (c.commonSubjects || []).forEach(s => availableSubjectsSet.add(s));
                        (c.groups || []).forEach(g => (g.subjects || []).forEach(s => availableSubjectsSet.add(s)));
                    }
                });
                const availableSubjects = Array.from(availableSubjectsSet).sort();

                let classOptionsHTML = '<option value="">-- Choose Class to Add --</option>';
                ACADEMIC_CLASSES.forEach(c => {
                    if (!selectedClasses.includes(c.name)) {
                        classOptionsHTML += `<option value="${c.name}">${c.name}</option>`;
                    }
                });

                let subjectOptionsHTML = '<option value="">-- Choose Subject to Add --</option>';
                availableSubjects.forEach(s => {
                    if (!selectedSubjects.includes(s)) {
                        subjectOptionsHTML += `<option value="${s}">${s}</option>`;
                    }
                });

                let classChips = selectedClasses.map((cls, idx) => `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/30 text-xs font-bold text-blue-700 dark:text-blue-300">
                        <span>${cls}</span>
                        <button type="button" onclick="window._scopeRemoveClass(${idx})" class="text-blue-400 hover:text-rose-500 font-bold">&times;</button>
                    </span>
                `).join('');

                let subjectChips = selectedSubjects.map((sub, idx) => `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-fuchsia-50 dark:bg-fuchsia-500/10 border border-fuchsia-200 dark:border-fuchsia-500/30 text-xs font-bold text-fuchsia-700 dark:text-fuchsia-300">
                        <span>${sub}</span>
                        <button type="button" onclick="window._scopeRemoveSubject(${idx})" class="text-fuchsia-400 hover:text-rose-500 font-bold">&times;</button>
                    </span>
                `).join('');

                return `
                    <div class="space-y-4 text-left font-sans text-xs">
                        <!-- Classes Section -->
                        <div class="p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800">
                            <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                                Teaching Classes
                            </label>
                            <div class="flex flex-wrap gap-1.5 min-h-[32px] p-2 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 mb-2">
                                ${classChips || '<span class="text-slate-400 text-[11px] italic">No class selected</span>'}
                            </div>
                            <div class="flex gap-2">
                                <select id="_scopeClassSelect" class="flex-1 h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium outline-none focus:border-primary">
                                    ${classOptionsHTML}
                                </select>
                                <button type="button" onclick="window._scopeAddClass()" class="h-9 px-3.5 rounded-lg bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition-colors shrink-0">
                                    + Add Class
                                </button>
                            </div>
                        </div>

                        <!-- Subjects Section -->
                        <div class="p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800">
                            <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                                Teaching Subjects
                            </label>
                            <div class="flex flex-wrap gap-1.5 min-h-[32px] p-2 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 mb-2">
                                ${subjectChips || '<span class="text-slate-400 text-[11px] italic">No subject selected</span>'}
                            </div>
                            <div class="flex gap-2 mb-2">
                                <select id="_scopeSubjectSelect" class="flex-1 h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium outline-none focus:border-primary">
                                    ${subjectOptionsHTML}
                                </select>
                                <button type="button" onclick="window._scopeAddSubject()" class="h-9 px-3.5 rounded-lg bg-fuchsia-600 text-white font-bold text-xs hover:bg-fuchsia-700 transition-colors shrink-0">
                                    + Add Subject
                                </button>
                            </div>
                            <div class="flex gap-2">
                                <input id="_scopeCustomSubject" placeholder="Or type custom subject..." class="flex-1 h-8 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium outline-none">
                                <button type="button" onclick="window._scopeAddCustomSubject()" class="h-8 px-3 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-[11px] hover:bg-slate-300 transition-colors">
                                    Add Custom
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            window._scopeAddClass = function() {
                const sel = document.getElementById('_scopeClassSelect');
                if (sel && sel.value && !selectedClasses.includes(sel.value)) {
                    selectedClasses.push(sel.value);
                    const modalContent = Swal.getHtmlContainer();
                    if (modalContent) modalContent.innerHTML = renderScopeModalHTML();
                }
            };

            window._scopeRemoveClass = function(idx) {
                selectedClasses.splice(idx, 1);
                const modalContent = Swal.getHtmlContainer();
                if (modalContent) modalContent.innerHTML = renderScopeModalHTML();
            };

            window._scopeAddSubject = function() {
                const sel = document.getElementById('_scopeSubjectSelect');
                if (sel && sel.value && !selectedSubjects.includes(sel.value)) {
                    selectedSubjects.push(sel.value);
                    const modalContent = Swal.getHtmlContainer();
                    if (modalContent) modalContent.innerHTML = renderScopeModalHTML();
                }
            };

            window._scopeAddCustomSubject = function() {
                const input = document.getElementById('_scopeCustomSubject');
                if (input && input.value.trim() && !selectedSubjects.includes(input.value.trim())) {
                    selectedSubjects.push(input.value.trim());
                    const modalContent = Swal.getHtmlContainer();
                    if (modalContent) modalContent.innerHTML = renderScopeModalHTML();
                }
            };

            window._scopeRemoveSubject = function(idx) {
                selectedSubjects.splice(idx, 1);
                const modalContent = Swal.getHtmlContainer();
                if (modalContent) modalContent.innerHTML = renderScopeModalHTML();
            };

            Swal.fire({
                title: '<p class="text-[15px] font-black tracking-tight">Assign Teacher Subject & Class</p>',
                html: renderScopeModalHTML(),
                width: '520px',
                showCancelButton: true,
                confirmButtonText: 'Save Assignment',
                confirmButtonColor: '#137fec',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                preConfirm: () => {
                    return {
                        assignedClasses: selectedClasses,
                        teachingSubjects: selectedSubjects
                    };
                }
            }).then(async (result) => {
                if (result.isConfirmed && result.value) {
                    try {
                        Swal.fire({ title: 'Saving Assignment...', didOpen: () => Swal.showLoading() });
                        const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';
                        const res = await fetch(`${apiBase}/users/${TARGET_USER_ID}/update`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(result.value)
                        });
                        const data = await res.json();
                        if (data.success) {
                            await Swal.fire({ icon: 'success', title: 'Saved!', text: 'Teacher subject & class assigned successfully', timer: 1200, showConfirmButton: false });
                            window.location.reload();
                        } else {
                            Swal.fire('Error', data.error || 'Failed to update assignment', 'error');
                        }
                    } catch(e) {
                        Swal.fire('Error', e.message || 'Network error', 'error');
                    }
                }
            });
        }

        // 3. Reset Password
        function resetPassword() {
            Swal.fire({
                title: 'Reset Password',
                text: 'Are you sure you want to reset password for this user?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec',
                confirmButtonText: 'Yes, Reset'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';
                        const res = await fetch(`${apiBase}/users/${TARGET_USER_ID}/update`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action: 'reset_password' })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Success', data.message || 'Password reset successfully', 'success');
                        } else {
                            Swal.fire('Error', data.error || 'Failed to reset password', 'error');
                        }
                    } catch(e) {
                        Swal.fire('Error', 'Network error', 'error');
                    }
                }
            });
        }

        // 4. Toggle Status
        function toggleStatus(newStatus) {
            Swal.fire({
                title: newStatus === 'suspended' ? 'Suspend User?' : 'Activate User?',
                text: newStatus === 'suspended' ? 'User will be restricted from accessing the platform.' : 'User will regain full platform access.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: newStatus === 'suspended' ? '#ef4444' : '#10b981',
                confirmButtonText: newStatus === 'suspended' ? 'Yes, Suspend' : 'Yes, Activate'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';
                        const res = await fetch(`${apiBase}/users/${TARGET_USER_ID}/update`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: newStatus })
                        });
                        const data = await res.json();
                        if (data.success) {
                            await Swal.fire({ icon: 'success', title: 'Updated!', timer: 1000, showConfirmButton: false });
                            window.location.reload();
                        } else {
                            Swal.fire('Error', data.error || 'Failed to update status', 'error');
                        }
                    } catch(e) {
                        Swal.fire('Error', 'Network error', 'error');
                    }
                }
            });
        }

        // 5. Delete User
        function deleteUser() {
            Swal.fire({
                title: 'Delete User Permanently?',
                text: 'This action is irreversible. All data associated with this user will be deleted.',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';
                    window.location.href = `${apiBase}/users/${TARGET_USER_ID}/delete`;
                }
            });
        }
    </script>
    <!-- Direct Messaging Modal -->
    <div id="directMessageModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden max-h-[85vh] animate-in fade-in zoom-in-95 duration-200">
            <!-- Modal Header -->
            <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/40">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-full overflow-hidden bg-slate-200 dark:bg-slate-700 relative shrink-0">
                        <% if (targetUser.profilePicture || targetUser.profileImage) { %>
                            <img src="<%= targetUser.profilePicture || targetUser.profileImage %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center font-bold text-sm text-slate-600 dark:text-slate-300">
                                <%= (targetUser.name || 'U').charAt(0).toUpperCase() %>
                            </div>
                        <% } %>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white"><%= targetUser.name %></h3>
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase <%= targetUser.role === 'teacher' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' : targetUser.role === 'admin' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300' %>"><%= targetUser.role %></span>
                        </div>
                        <p class="text-[11px] text-slate-400">Direct Communication Portal</p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5">
                    <a href="/messages?user=<%= targetUser._id %>" target="_blank" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-primary hover:bg-primary/10 flex items-center gap-1 transition-colors" title="Open in Full Messages Page">
                        <span class="material-symbols-rounded text-sm">open_in_new</span> Full Inbox
                    </a>
                    <button type="button" onclick="closeDirectMessageModal()" class="size-8 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-colors">
                        <span class="material-symbols-rounded text-lg">close</span>
                    </button>
                </div>
            </div>

            <!-- Messages Thread Body -->
            <div id="directMessageThread" class="flex-1 p-4 overflow-y-auto space-y-3 min-h-[260px] max-h-[380px] bg-slate-50/30 dark:bg-slate-950/20">
                <div class="flex items-center justify-center py-10 text-slate-400">
                    <span class="material-symbols-rounded animate-spin mr-2">progress_activity</span>
                    <span class="text-xs">Loading message history...</span>
                </div>
            </div>

            <!-- Modal Input Footer -->
            <form id="directMessageForm" onsubmit="sendDirectMessage(event)" class="p-3 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center gap-2">
                <input type="text" id="directMessageInput" placeholder="Write a message to <%= targetUser.name %>..." class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-all" autocomplete="off" required>
                <button type="submit" id="directMessageSendBtn" class="h-9 px-4 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all shrink-0 shadow-xs">
                    <span>Send</span>
                    <span class="material-symbols-rounded text-sm">send</span>
                </button>
            </form>
        </div>
    </div>

    <script>
        // Direct Message Modal Logic
        const targetUserId = '<%= targetUser._id %>';
        const currentUserId = '<%= user._id %>';

        async function openDirectMessageModal() {
            const modal = document.getElementById('directMessageModal');
            modal.classList.remove('hidden');
            loadDirectMessages();
            setTimeout(() => {
                const input = document.getElementById('directMessageInput');
                if (input) input.focus();
            }, 100);
        }

        function closeDirectMessageModal() {
            const modal = document.getElementById('directMessageModal');
            modal.classList.add('hidden');
        }

        async function loadDirectMessages() {
            const threadEl = document.getElementById('directMessageThread');
            try {
                const res = await fetch(`/api/messages/thread/${targetUserId}`);
                const data = await res.json();
                if (data.success) {
                    if (!data.messages || data.messages.length === 0) {
                        threadEl.innerHTML = `
                            <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                                <span class="material-symbols-rounded text-4xl mb-2 opacity-40">chat</span>
                                <p class="text-xs font-bold text-slate-500">No message history yet</p>
                                <p class="text-[11px] text-slate-400 mt-0.5">Send a direct message below to start conversation.</p>
                            </div>
                        `;
                    } else {
                        threadEl.innerHTML = data.messages.map(m => {
                            const isMine = String(m.sender) === currentUserId;
                            const timeStr = new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            return `
                                <div class="flex ${isMine ? 'justify-end' : 'justify-start'}">
                                    <div class="max-w-[78%] px-3.5 py-2.5 rounded-2xl text-xs ${isMine ? 'bg-primary text-white rounded-br-xs' : 'bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-200 dark:border-slate-700 rounded-bl-xs shadow-2xs'}">
                                        <p class="leading-relaxed break-words whitespace-pre-wrap">${escapeHtml(m.text || '')}</p>
                                        <div class="flex items-center justify-end gap-1 mt-1 text-[10px] ${isMine ? 'text-white/70' : 'text-slate-400'}">
                                            <span>${timeStr}</span>
                                            ${isMine ? `<span class="material-symbols-rounded text-[11px]">${m.isRead ? 'done_all' : 'done'}</span>` : ''}
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                        threadEl.scrollTop = threadEl.scrollHeight;
                    }
                } else {
                    threadEl.innerHTML = `<div class="p-4 text-center text-rose-500 text-xs font-semibold">${data.error || 'Failed to load messages'}</div>`;
                }
            } catch (err) {
                threadEl.innerHTML = `<div class="p-4 text-center text-rose-500 text-xs font-semibold">Error connecting to message service</div>`;
            }
        }

        async function sendDirectMessage(e) {
            e.preventDefault();
            const input = document.getElementById('directMessageInput');
            const btn = document.getElementById('directMessageSendBtn');
            const text = (input.value || '').trim();
            if (!text) return;

            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-rounded animate-spin text-sm">progress_activity</span>`;

            try {
                const res = await fetch('/api/messages/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ targetUserId, text })
                });
                const data = await res.json();
                if (data.success) {
                    input.value = '';
                    await loadDirectMessages();
                } else {
                    Swal.fire('Message Error', data.error || 'Failed to send message', 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Network error sending message', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<span>Send</span><span class="material-symbols-rounded text-sm">send</span>`;
                input.focus();
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }
    </script>
</body>
</html>
