    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleAdminSidebar() { document.getElementById('adminSidebar').classList.toggle('active'); }
        
        async function reviewPayment(id, action) {
            const actionText = action === 'approve' ? 'Approve' : 'Reject';
            const actionColor = action === 'approve' ? '#10b981' : '#ef4444';
            
            const confirmResult = await Swal.fire({
                title: `${actionText} Payment?`,
                text: `Are you sure you want to ${action.toLowerCase()} this payment request?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: actionColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: `Yes, ${actionText}`
            });
            
            if (!confirmResult.isConfirmed) return;
            
            Swal.fire({
                title: 'Processing...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            
            try {
                const res = await fetch(`/payment/${id}/review`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire('Success!', `Payment has been ${action === 'approve' ? 'approved' : 'rejected'}.`, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Failed', data.error || 'Operation failed', 'error');
                }
            } catch (e) {
                Swal.fire('Error', 'Server error. Please try again.', 'error');
            }
        }
        let currentRefundPaymentId = '';
        let currentRefundAmount = 0;
        
        function openRefundModal(id, amount) {
            currentRefundPaymentId = id;
            currentRefundAmount = amount;
            document.getElementById('refund-payment-id').textContent = id.substring(id.length - 8);
            document.getElementById('refund-original').textContent = '\u09F3' + amount;
            document.getElementById('refund-amount-input').value = '';
            document.getElementById('refund-amount-input').max = amount;
            document.getElementById('refund-reason').value = '';
            selectRefundType('full');
            document.getElementById('refund-modal').classList.remove('hidden');
        }
        
        function closeRefundModal() { document.getElementById('refund-modal').classList.add('hidden'); }
        
        function selectRefundType(type) {
            if (type === 'full') {
                document.getElementById('refund-full-option').classList.add('selected');
                document.getElementById('refund-partial-option').classList.remove('selected');
                document.getElementById('refund-amount-field').classList.add('hidden');
            } else {
                document.getElementById('refund-partial-option').classList.add('selected');
                document.getElementById('refund-full-option').classList.remove('selected');
                document.getElementById('refund-amount-field').classList.remove('hidden');
                document.getElementById('refund-amount-input').focus();
            }
        }
        
        async function processRefund() {
            const type = document.querySelector('input[name="refundType"]:checked').value;
            const amount = type === 'full' ? currentRefundAmount : parseFloat(document.getElementById('refund-amount-input').value);
            const reason = document.getElementById('refund-reason').value;
            
            if (type === 'partial' && (!amount || amount <= 0 || amount > currentRefundAmount)) {
                Swal.fire('Invalid Amount', `Please enter a valid refund amount (1 - ${currentRefundAmount})`, 'warning');
                return;
            }
            
            const confirmResult = await Swal.fire({
                title: 'Confirm Refund',
                text: `Process ${type} refund of \u09F3${amount}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, process it!'
            });
            
            if (!confirmResult.isConfirmed) return;
            
            closeRefundModal(); 
            Swal.fire({
                title: 'Processing...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            try {
                const res = await fetch('/admin/payments/' + currentRefundPaymentId + '/refund', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type, amount, reason })
                });
                const data = await res.json();
                if (data.success) { 
                    Swal.fire('Success!', 'Refund processed successfully.', 'success').then(() => location.reload()); 
                } else { 
                    Swal.fire('Failed', data.error || 'Refund failed', 'error'); 
                }
            } catch (e) { 
                Swal.fire('Error', 'Server error. Please try again.', 'error'); 
            }
        }

        // Details Modal & Printing Logic
        async function openDetailsModal(id) {
            Swal.fire({
                title: 'Loading Details...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            
            try {
                const res = await fetch(`/admin/payments/${id}/details`);
                const payment = await res.json();
                
                if (payment.error) throw new Error(payment.error);

                const date = new Date(payment.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                const courseTitle = payment.course ? payment.course.title : 'General Academic Fee';
                
                Swal.fire({
                    title: '<span class="text-lg font-black text-slate-800 dark:text-white">Transaction Receipt</span>',
                    html: `
                        <div class="space-y-4">
                        <div class="text-left p-5 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800 font-sans">
                            <div class="flex justify-between items-start border-b border-slate-200 dark:border-slate-700 pb-3 mb-4">
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 tracking-widest mb-1">Receipt To</p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">${payment.user ? payment.user.name : 'Unknown User'}</p>
                                    <p class="text-[10px] text-slate-500">${payment.user ? payment.user.email : 'N/A'}</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-[10px] font-bold text-slate-400 tracking-widest mb-1">Date</p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">${date}</p>
                                </div>
                            </div>

                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <p class="text-xs text-slate-500 font-medium">Transaction ID</p>
                                    <p class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200">${payment.transactionId}</p>
                                </div>
                                <div class="flex justify-between">
                                    <p class="text-xs text-slate-500 font-medium">Payment Method</p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 capitalize">${payment.paymentMethod || 'N/A'}</p>
                                </div>
                                <div class="flex justify-between">
                                    <p class="text-xs text-slate-500 font-medium">Payment Status</p>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${payment.status === 'success' || payment.status === 'approved' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : payment.status === 'refunded' || payment.status === 'partial_refund' ? 'bg-rose-500/10 text-rose-500 border border-rose-500/20' : 'bg-amber-500/10 text-amber-500 border border-amber-500/20'}">${payment.status}</span>
                                </div>

                                <!-- Financial Breakdown -->
                                <div class="py-2 space-y-1.5 border-t border-b border-slate-100 dark:border-slate-800">
                                    <div class="flex justify-between">
                                        <p class="text-[10px] text-slate-500">Original Price</p>
                                        <p class="text-[10px] font-bold text-slate-700 dark:text-slate-300">৳ ${payment.amount + (payment.discountAmount || 0)}</p>
                                    </div>
                                    ${payment.discountAmount > 0 ? `
                                    <div class="flex justify-between">
                                        <p class="text-[10px] text-emerald-600 font-medium">Discount ${payment.couponCode ? `(${payment.couponCode})` : ''}</p>
                                        <p class="text-[10px] font-bold text-emerald-600">- ৳ ${payment.discountAmount}</p>
                                    </div>
                                    ` : ''}
                                    ${(payment.refundAmount > 0 || payment.status === 'refunded') ? `
                                    <div class="flex justify-between py-1.5 px-2 bg-rose-500/5 rounded border border-rose-500/10">
                                        <p class="text-[10px] text-rose-600 font-bold">Refunded</p>
                                        <p class="text-[10px] font-bold text-rose-600">- ৳ ${payment.refundAmount || payment.amount}</p>
                                    </div>
                                    ` : ''}
                                </div>

                                <div class="pt-1">
                                    <p class="text-[10px] font-bold text-slate-400 tracking-widest mb-2">Item Details</p>
                                    <div class="flex justify-between items-center bg-white dark:bg-slate-800 p-2 rounded-lg border border-slate-100 dark:border-slate-700">
                                        <p class="text-xs font-bold text-slate-700 dark:text-slate-300 truncate pr-4">${courseTitle}</p>
                                        <p class="text-xs font-black text-slate-900 dark:text-white">৳ ${payment.amount}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-6 flex justify-between items-center pt-4 border-t-2 border-dashed border-slate-200 dark:border-slate-700">
                                <p class="text-sm font-black text-slate-800 dark:text-white uppercase">${(payment.refundAmount > 0 || payment.status === 'refunded') ? 'Net Payment' : 'Total Paid'}</p>
                                <p class="text-xl font-black ${(payment.refundAmount > 0 || payment.status === 'refunded') ? 'text-slate-400 line-through' : 'text-primary'}">৳ ${(payment.amount - (payment.refundAmount || 0)) < 0 ? 0 : (payment.amount - (payment.refundAmount || 0))}</p>
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: '<div class="flex items-center gap-2"><span class="material-symbols-rounded text-[18px]">download</span> Export Receipt</div>',
                    cancelButtonText: 'Close',
                    confirmButtonColor: '#137fec',
                    cancelButtonColor: '#64748b',
                    width: '500px',
                    customClass: {
                        container: 'payment-receipt-modal',
                        popup: 'rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        downloadReceipt(payment);
                    }
                });
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'Failed to fetch payment details: ' + err.message, 'error');
            }
        }

        function downloadReceipt(payment) {
            const content = `
=========================================
                 ODDHAY
            Official Receipt
=========================================
Transaction ID : ${payment.transactionId}
Date           : ${new Date(payment.createdAt).toLocaleString()}
-----------------------------------------
User Details
Name           : ${payment.user ? payment.user.name : 'Unknown User'}
Email          : ${payment.user ? payment.user.email : 'N/A'}
-----------------------------------------
Payment Details
Course/Item    : ${payment.course ? payment.course.title : 'General Fee'}
Original Price : ৳ ${payment.amount + (payment.discountAmount || 0)}
${payment.discountAmount > 0 ? `Discount       : ৳ ${payment.discountAmount} ${payment.couponCode ? `(Coupon: ${payment.couponCode})` : ''}` : ''}
Amount Paid    : ৳ ${payment.amount}
${(payment.refundAmount > 0 || payment.status === 'refunded') ? `Refund Amount  : ৳ ${payment.refundAmount || payment.amount}
Net Payment    : ৳ ${(payment.amount - (payment.refundAmount || 0)) < 0 ? 0 : (payment.amount - (payment.refundAmount || 0))}` : ''}
Method         : ${payment.paymentMethod || 'N/A'}
Status         : ${payment.status.charAt(0).toUpperCase() + payment.status.slice(1)}
-----------------------------------------
Thank you for your payment!
This is a computer-generated receipt.
=========================================
            `;
            const blob = new Blob([content], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `receipt_${payment.transactionId}.txt`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            Swal.fire({
                title: 'Receipt Downloaded',
                text: 'Your transaction receipt has been exported successfully.',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
        }
        
        function closeDetailsModal() {
            document.getElementById('details-modal').classList.add('hidden');
        }
        
        function printReceipt() {
            window.print();
        }

        // Bulk Actions Logic
        const selectedPayments = new Set();
        
        function toggleSelectRow(id) {
            const row = document.getElementById('row-' + id);
            const cb = document.getElementById('cb-' + id);
            if (selectedPayments.has(id)) {
                selectedPayments.delete(id);
                row.classList.remove('bg-blue-50/50', 'dark:bg-blue-500/10');
                if(cb) cb.checked = false;
            } else {
                selectedPayments.add(id);
                row.classList.add('bg-blue-50/50', 'dark:bg-blue-500/10');
                if(cb) cb.checked = true;
            }
            updateBulkBarUI();
        }

        function toggleSelectAll() {
            const headerCb = document.getElementById('selectAll');
            const isChecked = headerCb.checked;
            selectAllRows(isChecked);
        }

        function updateBulkBar() {
            document.querySelectorAll('.payment-checkbox').forEach(cb => {
                const id = cb.value;
                const row = document.getElementById('row-' + id);
                if(cb.checked) {
                    selectedPayments.add(id);
                    row.classList.add('bg-blue-50/50', 'dark:bg-blue-500/10');
                } else {
                    selectedPayments.delete(id);
                    row.classList.remove('bg-blue-50/50', 'dark:bg-blue-500/10');
                }
            });
            updateBulkBarUI();
        }

        function selectAllRows(force) {
            document.querySelectorAll('.payment-checkbox').forEach(cb => {
                cb.checked = force;
            });
            document.querySelectorAll('.user-row').forEach(row => {
                const id = row.id.replace('row-', '');
                if (force) {
                    selectedPayments.add(id);
                    row.classList.add('bg-blue-50/50', 'dark:bg-blue-500/10');
                } else {
                    selectedPayments.delete(id);
                    row.classList.remove('bg-blue-50/50', 'dark:bg-blue-500/10');
                }
            });
            updateBulkBarUI();
        }
        
        function updateBulkBarUI() {
            const bar = document.getElementById('bulkBar');
            const headerCb = document.getElementById('selectAll');
            const totalOnPage = document.querySelectorAll('.payment-checkbox').length;
            
            // Sync header checkbox state
            if (headerCb) {
                if (selectedPayments.size === 0) {
                    headerCb.checked = false;
                    headerCb.indeterminate = false;
                } else if (selectedPayments.size >= totalOnPage) {
                    headerCb.checked = true;
                    headerCb.indeterminate = false;
                } else {
                    headerCb.checked = false;
                    headerCb.indeterminate = true;
                }
            }
            
            if(selectedPayments.size > 0) {
                bar.classList.remove('hidden');
                setTimeout(() => {
                    bar.classList.remove('translate-y-10', 'opacity-0');
                }, 10);
            } else {
                bar.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => {
                    bar.classList.add('hidden');
                }, 300);
            }
            document.getElementById('selectedCount').textContent = selectedPayments.size;
        }

        function selectAllRows(force) {
            document.querySelectorAll('.payment-checkbox').forEach(cb => {
                cb.checked = force;
                if(force) selectedPayments.add(cb.value);
                else selectedPayments.delete(cb.value);
            });
            const headerCb = document.getElementById('selectAll');
            if(headerCb) headerCb.checked = force;
            updateBulkBarUI();
        }
        
        function clearSelection() {
            selectedPayments.clear();
            document.querySelectorAll('.payment-checkbox').forEach(cb => cb.checked = false);
            updateBulkBarUI();
        }
        
        async function bulkAction(action) {
            if(selectedPayments.size === 0) return;
            
            let actionText = '';
            if (action === 'refund') actionText = 'fully refund';
            if (action === 'dispute') actionText = 'mark as disputed';
            if (action === 'resolve') actionText = 'resolve disputed';
            
            const req = await Swal.fire({
                title: 'Confirm Bulk Action',
                text: `Are you sure you want to ${actionText} ${selectedPayments.size} payments?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, proceed!'
            });
            
            if(!req.isConfirmed) return;
            
            Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); }});
            
            try {
                const res = await fetch('/admin/payments/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: action, paymentIds: Array.from(selectedPayments) })
                });
                const data = await res.json();
                if(data.success) {
                    Swal.fire('Success!', `Bulk action successful.`, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Failed', data.error || 'Action failed.', 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'Server error during bulk action.', 'error');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const chartData = <%- JSON.stringify(typeof revenueChart !== 'undefined' ? revenueChart : []) %>;
            const canvas = document.getElementById('revenueChartCanvas');
            if(chartData && chartData.length > 0 && canvas) {
                const ctx = canvas.getContext('2d');
                
                // Colors based on theme
                const isDark = document.documentElement.classList.contains('dark');
                const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';
                const textColor = isDark ? '#94a3b8' : '#64748b';
                
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: chartData.map(d => {
                            const date = new Date(d._id);
                            return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
                        }),
                        datasets: [{
                            label: 'Revenue (\u09F3)',
                            data: chartData.map(d => d.amount),
                            borderColor: '#137fec',
                            backgroundColor: 'rgba(19, 127, 236, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointBackgroundColor: '#137fec'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                backgroundColor: isDark ? 'rgba(15, 23, 42, 0.9)' : 'rgba(255, 255, 255, 0.9)',
                                titleColor: isDark ? '#fff' : '#0f172a',
                                bodyColor: isDark ? '#cbd5e1' : '#475569',
                                borderColor: isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)',
                                borderWidth: 1,
                                padding: 10,
                                displayColors: false,
                                callbacks: {
                                    label: function(context) {
                                        return '\u09F3 ' + context.parsed.y.toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    color: textColor,
                                    font: { size: 11, family: "'Inter', sans-serif" },
                                    maxTicksLimit: 6
                                }
                            },
                            y: {
                                border: { display: false },
                                grid: { color: gridColor },
                                ticks: {
                                    color: textColor,
                                    font: { size: 11, family: "'Inter', sans-serif" },
                                    callback: function(value) {
                                        if (value >= 1000) return (value / 1000) + 'k';
                                        return value;
                                    }
                                },
                                beginAtZero: true
                            }
                        },
                        interaction: {
                            mode: 'nearest',
                            axis: 'x',
                            intersect: false
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>
