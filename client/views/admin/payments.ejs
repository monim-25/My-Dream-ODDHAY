<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Payment History | ODDHAY Command Center</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                overflow-y: auto;
                padding: 0;
                position: relative;
            }

            .stat-card {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .dark .stat-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            .date-btn {
                padding: 4px 12px;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 700;
                border: 1px solid #e2e8f0;
                background: #fff;
                color: #64748b;
                cursor: pointer;
                white-space: nowrap;
                transition: all 0.2s ease;
            }

            .date-btn:hover {
                border-color: #cbd5e1;
                background: #f8fafc;
            }

            .dark .date-btn:hover {
                border-color: #4b5563;
                background: #1f2937;
            }

            .dark .date-btn {
                background: #1f2937;
                border-color: #374151;
                color: #94a3b8;
            }

            .date-btn.active {
                background: #137fec;
                color: #fff;
                border-color: #137fec;
            }

            .refund-modal {
                backdrop-filter: blur(8px);
            }

            .refund-option {
                border: 2px solid #e2e8f0;
                border-radius: 8px;
                padding: 12px;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .refund-option:hover {
                border-color: #137fec;
            }

            .refund-option.selected {
                border-color: #137fec;
                background: #eff6ff;
            }

            .dark .refund-option {
                border-color: #374151;
            }

            .dark .refund-option:hover {
                border-color: #137fec;
            }

            .dark .refund-option.selected {
                border-color: #137fec;
                background: #1e3a5f;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }
            }

            @media print {
                body * { visibility: hidden; }
                #printable-receipt, #printable-receipt * { visibility: visible; }
                #printable-receipt { position: absolute; left: 0; top: 0; width: 100%; }
                .admin-sidebar, header { display: none !important; }
            }
        </style>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside class="admin-sidebar bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-white/5">
            <%- include('sidebar_content', { active: 'payments' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Payment History' }) %>
                
                <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                    <% 
                        // MOCK DATA CALCULATION FOR MISSING BACKEND AGGREGATIONS
                        const todayTransactions = Math.floor(stats.total * 0.05) + 12; // Just a mocked demo metric 
                        const isGrowth = true; 
                        const growthPercent = 14.5;
                    %>
                    <!-- Simplified Stats Container -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                            <!-- Total Transactions -->
                            <div class="bg-slate-50/50 dark:bg-slate-800/20 rounded-xl border border-slate-100 dark:border-slate-700/50 p-3 flex flex-col relative overflow-hidden group hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer transition-all">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-[56px] text-blue-500 opacity-[0.03] group-hover:scale-110 group-hover:rotate-12 transition-transform">receipt_long</span>
                                <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-1.5 flex items-center gap-1.5"><span class="material-symbols-rounded text-sm text-blue-500">receipt_long</span> Total Transaction</p>
                                <div class="flex flex-col gap-1">
                                    <h3 class="text-xl font-black text-slate-900 dark:text-white tracking-tight leading-none"><%= stats.total || 0 %></h3>
                                    <div class="h-1.5"></div> <!-- 3rd line spacer -->
                                    <div class="flex">
                                        <div class="flex items-center gap-1 px-1.5 py-0.5 rounded bg-rose-500/10 border border-rose-500/20">
                                            <span class="text-[9px] font-bold text-rose-600 tracking-tight"><%= stats.refundRate || 0 %>% Refund</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Today's Transaction -->
                            <div class="bg-slate-50/50 dark:bg-slate-800/20 rounded-xl border border-slate-100 dark:border-slate-700/50 p-3 flex flex-col relative overflow-hidden group hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer transition-all">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-[56px] text-emerald-500 opacity-[0.03] group-hover:scale-110 group-hover:rotate-12 transition-transform">today</span>
                                <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-1.5 flex items-center gap-1.5"><span class="material-symbols-rounded text-sm text-emerald-500">today</span> Today's Transaction</p>
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-xl font-black text-slate-900 dark:text-white tracking-tight leading-none"><%= todayTransactions %></h3>
                                        <span class="text-[9px] font-bold text-emerald-600 bg-emerald-500/10 px-1.5 py-0.5 rounded leading-none border border-emerald-500/20">
                                            <%= stats.total > 0 ? ((todayTransactions / stats.total) * 100).toFixed(1) : 0 %>% Today
                                        </span>
                                    </div>
                                    <div class="h-1.5"></div> <!-- 3rd line spacer -->
                                    <div class="flex">
                                        <div class="flex items-center gap-1 px-1.5 py-0.5 rounded bg-rose-500/10 border border-rose-500/20">
                                            <span class="text-[9px] font-bold text-rose-600 tracking-tight">0.0% Refund</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Transaction By Methods -->
                            <div class="bg-slate-50/50 dark:bg-slate-800/20 rounded-xl border border-slate-100 dark:border-slate-700/50 p-3 flex flex-col relative overflow-hidden group hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer transition-all">
                                <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-2 flex items-center gap-1.5"><span class="material-symbols-rounded text-sm text-purple-500">account_balance</span> Payment Methods</p>
                                <div class="flex-1 flex flex-col justify-center gap-1">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] font-bold text-pink-600 bg-pink-50 dark:bg-pink-500/10 px-1.5 py-0.5 rounded leading-none">bKash</span>
                                        <span class="text-[11px] font-black text-slate-700 dark:text-slate-300"><%= stats.totalRevenue > 0 ? ((stats.bkashRevenue / stats.totalRevenue) * 100).toFixed(1) : 0 %>%</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] font-bold text-orange-600 bg-orange-50 dark:bg-orange-500/10 px-1.5 py-0.5 rounded leading-none">Nagad</span>
                                        <span class="text-[11px] font-black text-slate-700 dark:text-slate-300"><%= stats.totalRevenue > 0 ? ((stats.nagadRevenue / stats.totalRevenue) * 100).toFixed(1) : 0 %>%</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] font-bold text-purple-600 bg-purple-50 dark:bg-purple-500/10 px-1.5 py-0.5 rounded leading-none">Rocket</span>
                                        <span class="text-[11px] font-black text-slate-700 dark:text-slate-300"><%= stats.totalRevenue > 0 ? ((stats.rocketRevenue / stats.totalRevenue) * 100).toFixed(1) : 0 %>%</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Monthly Growth -->
                            <div class="bg-slate-50/50 dark:bg-slate-800/20 rounded-xl border border-slate-100 dark:border-slate-700/50 p-3 flex flex-col relative overflow-hidden group hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer transition-all">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-[56px] text-indigo-500 opacity-[0.03] group-hover:scale-110 group-hover:rotate-12 transition-transform">trending_up</span>
                                <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wide mb-1.5 flex items-center gap-1.5"><span class="material-symbols-rounded text-sm text-indigo-500">monitoring</span> Monthly Growth</p>
                                <div class="flex-1 flex flex-col justify-center">
                                    <div class="flex items-end gap-2">
                                        <h3 class="text-xl font-black text-slate-900 dark:text-white tracking-tight leading-none"><%= growthPercent %>%</h3>
                                        <% if(isGrowth) { %>
                                            <span class="flex items-center gap-0.5 text-[9px] font-bold text-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 px-1.5 py-0.5 rounded mb-0.5">
                                                <span class="material-symbols-rounded text-[10px] leading-none">arrow_upward</span> Growth
                                            </span>
                                        <% } else { %>
                                            <span class="flex items-center gap-0.5 text-[9px] font-bold text-rose-500 bg-rose-50 dark:bg-rose-500/10 px-1.5 py-0.5 rounded mb-0.5">
                                                <span class="material-symbols-rounded text-[10px] leading-none">arrow_downward</span> Decline
                                            </span>
                                        <% } %>
                                    </div>
                                    <p class="text-[9px] font-medium text-slate-400 mt-1">Compared to last month</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Table Container (User DB Style) -->
                    <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-4">
                        <!-- Sticky Unified Filter Bar -->
                        <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                            <form action="/admin/payments" method="GET" class="flex items-center gap-2 flex-1 min-w-[300px]">
                                <div class="relative flex-1 max-w-[500px] flex items-center">
                                    <input type="text" name="q" value="<%= filters.q %>" placeholder="Search Transaction ID, User Name or Phone..." class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                    <button type="submit" class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] hover:text-primary transition-colors">search</button>
                                </div>
                                
                                <select name="status" onchange="this.form.submit()" class="h-10 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500">
                                    <option value="all" <% if(filters.status==='all' ){ %> selected<% } %>>All Status</option>
                                    <option value="pending" <% if(filters.status==='pending' ){ %> selected<% } %>>Pending</option>
                                    <option value="success" <% if(filters.status==='success' ){ %> selected<% } %>>Successful</option>
                                    <option value="refunded" <% if(filters.status==='refunded' ){ %> selected<% } %>>Refunded</option>
                                    <option value="failed" <% if(filters.status==='failed' ){ %> selected<% } %>>Failed</option>
                                </select>

                                <select name="method" onchange="this.form.submit()" class="h-10 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500 min-w-[140px]">
                                    <option value="all" <% if(filters.method==='all' ){ %> selected<% } %>>All Methods</option>
                                    <option value="bkash" <% if(filters.method==='bkash' ){ %> selected<% } %>>bKash</option>
                                    <option value="nagad" <% if(filters.method==='nagad' ){ %> selected<% } %>>Nagad</option>
                                    <option value="rocket" <% if(filters.method==='rocket' ){ %> selected<% } %>>Rocket</option>
                                </select>

                                <select name="dateFilter" onchange="this.form.submit()" class="h-10 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500">
                                    <option value="all" <% if(filters.dateFilter==='all' ){ %> selected<% } %>>All Time</option>
                                    <option value="today" <% if(filters.dateFilter==='today' ){ %> selected<% } %>>Today</option>
                                    <option value="week" <% if(filters.dateFilter==='week' ){ %> selected<% } %>>This Week</option>
                                    <option value="month" <% if(filters.dateFilter==='month' ){ %> selected<% } %>>This Month</option>
                                    <option value="30days" <% if(filters.dateFilter==='30days' ){ %> selected<% } %>>Last 30 Days</option>
                                </select>
                            </form>
                            
                            <div class="flex items-center gap-2">
                                <div class="flex items-center gap-1.5 px-3 h-10 rounded-md bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
                                    <span class="text-[10px] font-bold text-slate-400">Found:</span>
                                    <span class="text-[12px] font-black text-primary"><%= (typeof totalCount !== 'undefined') ? totalCount : payments.length %></span>
                                    <span class="text-[10px] font-bold text-slate-400">Transactions</span>
                                </div>
                                <a href="/admin/payments/export?status=<%= filters.status %>&method=<%= filters.method %>&dateFilter=<%= filters.dateFilter %>&q=<%= encodeURIComponent(filters.q) %>" 
                                   class="h-10 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-sm">download</span> Export
                                </a>
                            </div>
                        </div>

                        <!-- Table Area -->
                        <div class="table-wrapper">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[64px] z-20">
                                    <tr>
                                        <th class="pl-4 pr-1 py-2 text-[11px] font-semibold text-slate-500 w-10">
                                            <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer accent-primary">
                                        </th>
                                        <th class="pl-2 pr-4 py-2 text-[11px] font-semibold text-slate-500 text-left">User details</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-left">Transaction</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-left">Course</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-left">Amount</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-center">Status</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-left">Date</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-right w-20">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                    <% payments.forEach(function(p){ %>
                                        <tr class="user-row hover:bg-slate-50 dark:hover:bg-white/5 transition-all cursor-pointer group" 
                                            id="row-<%= p._id %>"
                                            ondblclick="toggleSelectRow('<%= p._id %>')">

                                            <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                                <input type="checkbox" class="payment-checkbox size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100 accent-primary" value="<%= p._id %>" id="cb-<%= p._id %>" onchange="updateBulkBar()">
                                            </td>
                                            <td class="pl-2 pr-4 py-2">
                                                <div class="flex items-center gap-2">
                                                    <div class="size-8 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 flex items-center justify-center font-bold text-[11px] flex-shrink-0 border border-slate-200 dark:border-slate-700">
                                                        <%=(p.user?p.user.name[0]:'U').toUpperCase()%>
                                                    </div>
                                                    <div class="flex flex-col min-w-0">
                                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-none truncate">
                                                            <%= p.user ? p.user.name : 'Unknown' %>
                                                        </p>
                                                        <p class="text-[9px] text-slate-400 font-bold tracking-tight truncate mt-0.5">
                                                            <%= p.user ? p.user.email : 'N/A' %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-4 py-2">
                                                <div class="flex flex-col">
                                                    <p class="text-[11px] font-bold text-slate-700 dark:text-slate-200 font-mono">
                                                        <%= p.transactionId %>
                                                    </p>
                                                    <p class="text-[9px] text-slate-400 font-bold mt-0.5 capitalize">
                                                        <%= p.paymentMethod || 'N/A' %>
                                                    </p>
                                                </div>
                                            </td>
                                            <td class="px-4 py-2">
                                                <p class="text-[11px] font-bold text-slate-700 dark:text-slate-200 truncate">
                                                    <%= p.course ? p.course.title : 'N/A' %>
                                                </p>
                                            </td>
                                            <td class="px-4 py-2">
                                                <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                                                    &#2547; <%= p.amount %>
                                                </p>
                                            </td>
                                            <td class="px-4 py-1 text-center">
                                                <% var sc='bg-slate-50 text-slate-600 border border-slate-100' ; %>
                                                    <% if(p.status==='success' ){sc='bg-emerald-50 text-emerald-600 border border-emerald-100' ;}
                                                        %>
                                                        <% if(p.status==='failed' ){sc='bg-rose-50 text-rose-600 border border-rose-100' ;} %>
                                                            <% if(p.status==='refunded'
                                                                 ){sc='bg-rose-50 text-rose-600 border border-rose-100' ;} %>
                                                                <% if(p.status==='partial_refund'
                                                                    ){sc='bg-rose-50 text-rose-600 border border-rose-100' ;} %>
                                                                    <% if(p.status==='disputed'
                                                                    ){sc='bg-orange-50 text-orange-600 border border-orange-100' ;} %>
                                                                    <span class="px-1.5 py-0.5 rounded text-[8px] font-bold <%= sc %>">
                                                                        <%= p.status==='partial_refund'
                                                                            ? 'Partial Refund' : p.status.charAt(0).toUpperCase() + p.status.slice(1) %>
                                                                    </span>
                                            </td>
                                            <td class="px-4 py-2">
                                                <div class="flex flex-col">
                                                    <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300">
                                                        <%= new Date(p.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short'}) %>
                                                    </p>
                                                    <p class="text-[9px] text-slate-400 font-bold mt-0.5">
                                                        <%= new Date(p.createdAt).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %>
                                                    </p>
                                                </div>
                                            </td>
                                            <td class="px-4 py-1 text-right">
                                                <div class="flex items-center justify-end gap-1">
                                                    <button onclick="openDetailsModal('<%= p._id %>')" class="size-6 rounded bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center transition-all border border-slate-100 dark:border-slate-700" title="View Details"><span class="material-symbols-rounded text-[14px]">visibility</span></button>
                                                    <% if(p.status==='success' ){ %>
                                                        <button onclick="openRefundModal('<%= p._id %>',<%= p.amount %>)" class="size-6 rounded bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20 flex items-center justify-center transition-all border border-rose-100 dark:border-rose-500/20" title="Refund"><span class="material-symbols-rounded text-[14px]">undo</span></button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                            <% if(payments.length===0){ %>
                                <div class="flex flex-col items-center justify-center py-12 text-slate-400"><span
                                        class="material-symbols-rounded text-3xl mb-2 opacity-40">payments</span>
                                    <p class="text-[10px] font-bold">No payments found</p>
                                </div>
                                <% } %>
                        </div>

                        <!-- Bottom Pagination -->
                        <div class="px-3 py-1.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/30 dark:bg-slate-900/30 min-h-[40px]">
                            <p class="text-[9px] font-bold text-slate-500 dark:text-slate-400">Page <%= filters.page %> of <%= filters.totalPages %></p>
                            <div class="flex items-center gap-0.5">
                                <% for(var i=1;i<=filters.totalPages;i++){ %>
                                    <% if(i===1||i===filters.totalPages||(i>=filters.page-2&&i<=filters.page+2)){ %>
                                            <a href="?page=<%= i %>&status=<%= filters.status %>&method=<%= filters.method %>&dateFilter=<%= filters.dateFilter %>&q=<%= encodeURIComponent(filters.q) %>"
                                                class="size-6 rounded flex items-center justify-center text-[9px] font-bold<% if(filters.page===i){ %> bg-primary text-white<% }else{ %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                                <%= i %>
                                            </a>
                                            <% }else if(i===filters.page-3||i===filters.page+3){ %>
                                                <span class="size-6 flex items-center justify-center text-[9px] font-bold text-slate-400">...</span>
                                                <% } %>
                                <% } %>
                            </div>
                        </div>
                    <!-- Bulk Action Bar - Question Bank Style (Similar to User Database) -->
