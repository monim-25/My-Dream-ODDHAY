<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Question Insights | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-slide-up { animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }
    </style>
</head>

<body class="bg-[#F8FAFC] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'question-details' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC]">
            <%- include('header_v2', { pageTitle: 'Question History Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 bg-[#F8FAFC] dark:bg-[#020617]">
                <!-- Archive Stats (truncated for brevity in code view, but preserved in actual) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        <div onclick="window.location.href='?type=MCQ'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-blue-500 opacity-[0.05]">list_alt</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-blue-500">list_alt</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">MCQ</p>
                            </div>
                            <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= mCQCount %></h3></div>
                        </div>
                        <div onclick="window.location.href='?type=Short'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.05]">short_text</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-emerald-500">short_text</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Short Answer</p>
                            </div>
                            <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= shortCount %></h3></div>
                        </div>
                        <div onclick="window.location.href='?type=Medium'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.05]">notes</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-amber-500">notes</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Medium</p>
                            </div>
                            <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= mediumCount %></h3></div>
                        </div>
                        <div onclick="window.location.href='?type=Comprehension'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-purple-500 opacity-[0.05]">article</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-purple-500">article</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Comprehension</p>
                            </div>
                            <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= compCount %></h3></div>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Filters Bar -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <form action="" method="GET" class="relative flex-1 max-w-[480px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search questions..." class="w-full pl-3 pr-10 h-10 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                <input type="hidden" name="type" value="<%= filters.type %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="board" value="<%= filters.board %>">
                                <input type="hidden" name="access" value="<%= filters.access %>">
                                <% if (filters.author) { %><input type="hidden" name="author" value="<%= filters.author %>"><% } %>
                            </form>
                            
                            <!-- Board Filter -->
                            <div class="relative w-28">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&access=<%= filters.access %>&board=' + this.value" class="w-full h-10 pl-3 pr-8 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.board === 'all' ? 'selected' : '' %>>All Boards</option>
                                    <% ['Dhaka Board', 'Comilla Board', 'Rajshahi Board', 'Chittagong Board', 'Sylhet Board', 'Barisal Board', 'Khulna Board', 'Rangpur Board', 'Mymensingh Board'].forEach(b => { %>
                                        <option value="<%= b %>" <%= filters.board === b ? 'selected' : '' %>><%= b %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-28">
                                <select onchange="window.location.href='?q=<%= filters.q %>&class=<%= filters.class %>&board=<%= filters.board %>&access=<%= filters.access %>&type=' + this.value" class="w-full h-10 pl-3 pr-8 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.type === 'all' ? 'selected' : '' %>>All Types</option>
                                    <option value="MCQ" <%= filters.type === 'MCQ' ? 'selected' : '' %>>MCQ</option>
                                    <option value="Short" <%= filters.type === 'Short' ? 'selected' : '' %>>Short</option>
                                    <option value="Medium" <%= filters.type === 'Medium' ? 'selected' : '' %>>Medium</option>
                                    <option value="Comprehension" <%= filters.type === 'Comprehension' ? 'selected' : '' %>>Comprehension</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-28">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&board=<%= filters.board %>&access=<%= filters.access %>&class=' + this.value" class="w-full h-10 pl-3 pr-8 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                    <% [6,7,8,9,10,11,12].forEach(c => { %>
                                        <option value="<%= c %>" <%= filters.class == c ? 'selected' : '' %>>Class <%= c %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-28">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&board=<%= filters.board %>&class=<%= filters.class %>&access=' + this.value" class="w-full h-10 pl-3 pr-8 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.access === 'all' ? 'selected' : '' %>>All Access</option>
                                    <option value="Free" <%= filters.access === 'Free' ? 'selected' : '' %>>Free</option>
                                    <option value="Paid" <%= filters.access === 'Paid' ? 'selected' : '' %>>Paid</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all"><span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalCount %></span> Questions</span></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="document.getElementById('compositionWizardModal').classList.remove('hidden')" class="h-10 px-4 rounded-lg bg-slate-900 text-white font-bold text-[10px] shadow-lg shadow-slate-900/10 hover:bg-black transition-all flex items-center gap-2">
                                <span class="material-symbols-rounded text-sm">add_circle</span> Add question
                            </button>
                            <button onclick="exportToCSV()" class="h-10 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5"><span class="material-symbols-rounded text-sm">download</span> Export</button>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-2 text-[10px] font-bold text-slate-500 text-left">Question Content</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Type</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Board</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Subject</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Class</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Access</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Author</th>
                                    <th class="pr-4 py-3 text-[10px] font-black uppercase tracking-widest text-slate-400 text-right border-0">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% questions.forEach(q => { %>
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" onclick="viewQuestion('<%= q._id %>')">
                                        <td class="pl-4 pr-1 py-3" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= q._id %>" id="cb-<%= q._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-3 max-w-md">
                                            <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-relaxed line-clamp-2"><%= q.questionText %></p>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <% const typeMap = { 'MCQ': 'blue', 'Short': 'emerald', 'Medium': 'amber', 'Comprehension': 'purple' }; const color = typeMap[q.questionType] || 'slate'; %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-<%= color %>-50 dark:bg-<%= color %>-500/10 text-<%= color %>-600 dark:text-<%= color %>-400 text-[9px] font-bold border border-<%= color %>-100 dark:border-<%= color %>-500/20"><%= q.questionType %></span>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <div class="flex flex-col">
                                                <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300"><%= q.board || '---' %></span>
                                                <span class="text-[8px] font-bold text-slate-400"><%= q.year || '' %></span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap"><span class="text-[10px] font-bold text-primary"><%= q.subject || 'General' %></span></td>
                                        <td class="px-6 py-3 whitespace-nowrap font-bold text-slate-500 dark:text-slate-400 text-[10px]">Class: <%= q.classLevel %></td>
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <% if (q.accessType === 'Paid') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20">Paid</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <div class="flex items-center gap-2">
                                                <div class="size-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
                                                    <% if (q.addedBy && q.addedBy.profileImage) { %>
                                                        <img src="<%= q.addedBy.profileImage %>" class="size-full object-cover" onerror="this.src='/images/default-avatar.png';">
                                                    <% } else { %>
                                                        <span class="text-[9px] font-bold text-slate-400"><%= (q.addedBy && q.addedBy.name ? q.addedBy.name[0].toUpperCase() : 'A') %></span>
                                                    <% } %>
                                                </div>
                                                <span class="text-[10px] font-bold text-slate-400 truncate max-w-[80px]"><%= q.addedBy ? q.addedBy.name : 'System' %></span>
                                            </div>
                                        </td>
                                        <td class="pr-4 py-3 whitespace-nowrap border-0 text-right">
                                            <div class="flex items-center justify-end gap-1">
                                                <button onclick="event.stopPropagation(); viewQuestion('<%= q._id %>')" class="size-8 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm group" title="View Details">
                                                    <span class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">visibility</span>
                                                </button>
                                                <button onclick="event.stopPropagation(); deleteQuestion('<%= q._id %>')" class="size-8 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm group" title="Delete">
                                                    <span class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% if (filters.totalPages > 1) { %>
                                <% for(var i=1; i<=filters.totalPages; i++) { %>
                                    <a href="?page=<%= i %>&q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&board=<%= filters.board %>&access=<%= filters.access %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold <%= filters.page === i ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200' %> transition-all"><%= i %></a>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Question Details Drawer (View + Inline Edit) -->
    <div id="viewModal" class="fixed inset-0 z-[200] hidden">
        <div class="absolute inset-0 bg-slate-900/20 backdrop-blur-sm" onclick="closeModal()"></div>
        <div class="absolute inset-y-0 right-0 w-full max-w-[580px] bg-white dark:bg-[#0b1120] shadow-2xl animate-slide-left border-l border-slate-200/50 dark:border-white/5">
            <div class="h-full flex flex-col overflow-hidden">
                <!-- Modal Header -->
                <div class="px-6 py-5 border-b border-slate-50 dark:border-white/5 flex items-center justify-between bg-white dark:bg-white/5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 rounded-xl bg-slate-900 flex items-center justify-center text-white">
                            <span class="material-symbols-rounded text-xl">visibility</span>
                        </div>
                        <div>
                            <h2 class="text-sm font-black text-slate-900 dark:text-white tracking-tight">Question details</h2>
                            <p class="text-[10px] font-bold text-slate-500">View and manage question properties</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button id="modalEditBtn" class="h-8 px-4 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-bold flex items-center gap-2 hover:bg-slate-900 hover:text-white transition-all">
                            <span class="material-symbols-rounded text-[16px]">edit</span>
                            <span>Edit</span>
                        </button>
                        <button onclick="closeModal()" class="size-8 rounded-lg hover:bg-slate-100 dark:hover:bg-white/5 transition-all flex items-center justify-center group">
                            <span class="material-symbols-rounded text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">close</span>
                        </button>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto custom-scrollbar">
                    <!-- VIEW MODE CONTAINER -->
                    <div id="viewModeContainer" class="p-8 space-y-8">
                        <div class="flex items-center gap-2">
                            <span id="modalType" class="px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 text-[9px] font-black border border-blue-200/50 dark:border-blue-500/20">MCQ</span>
                            <span id="modalSubject" class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-white/5 text-slate-500 dark:text-slate-400 text-[9px] font-black border border-slate-200/50 dark:border-white/5">Subject</span>
                            <div id="modalAccessBadge"></div>
                        </div>

                        <div>
                            <p class="text-[10px] font-black text-slate-400 mb-4">Question</p>
                            <h3 id="modalText" class="text-xl font-black text-slate-900 dark:text-white leading-[1.3] tracking-tight italic"></h3>
                        </div>

                        <div id="modalOptionsContainer" class="hidden space-y-4">
                            <p class="text-[10px] font-black text-slate-400">Options</p>
                            <div id="modalOptions" class="grid grid-cols-1 gap-2"></div>
                        </div>

                        <div class="p-6 rounded-3xl bg-emerald-50 dark:bg-emerald-500/5 border border-emerald-100 dark:border-emerald-500/20">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="material-symbols-rounded text-emerald-600 text-lg">verified</span>
                                <p class="text-[10px] font-black text-emerald-600 dark:text-emerald-400">Correct answer</p>
                            </div>
                            <p id="modalAnswer" class="text-base font-black text-emerald-700 dark:text-emerald-300 tracking-tight"></p>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-white dark:border-white/5 shadow-sm">
                                <p class="text-[9px] font-black text-slate-400 mb-1">Board</p>
                                <p id="modalBoard" class="text-xs font-black text-slate-900 dark:text-white tracking-tight"></p>
                            </div>
                            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-white dark:border-white/5 shadow-sm">
                                <p class="text-[9px] font-black text-slate-400 mb-1">Class</p>
                                <p id="modalClass" class="text-xs font-black text-slate-900 dark:text-white tracking-tight"></p>
                            </div>
                            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-white dark:border-white/5 shadow-sm">
                                <p class="text-[9px] font-black text-slate-400 mb-1">Year</p>
                                <p id="modalYear" class="text-xs font-black text-slate-900 dark:text-white tracking-tight"></p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 p-5 rounded-[2rem] bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-white/5">
                            <div class="size-12 rounded-full overflow-hidden border-2 border-white dark:border-slate-800 shadow-sm">
                                <img id="modalAuthorImg" src="/images/default-avatar.png" class="size-full object-cover">
                            </div>
                            <div>
                                <p id="modalAuthorName" class="text-xs font-black text-slate-900 dark:text-white tracking-tight mb-0.5"></p>
                                <p id="modalAuthorRole" class="text-[10px] font-bold text-slate-400 italic">Contributor</p>
                            </div>
                        </div>
                    </div>

                    <!-- EDIT MODE CONTAINER -->
                    <div id="editModeContainer" class="hidden p-8 space-y-8 animate-slide-up">
                        <input type="hidden" id="editQId">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 ml-1">Board</label>
                                <input type="text" id="editBoard" class="w-full h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 ml-1">Year</label>
                                <input type="number" id="editYear" class="w-full h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 ml-1">Subject</label>
                                <select id="editSubject" class="w-full h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                                    <option value="Physics">Physics</option>
                                    <option value="Chemistry">Chemistry</option>
                                    <option value="Mathematics">Mathematics</option>
                                    <option value="Biology">Biology</option>
                                    <option value="ICT">ICT</option>
                                    <option value="English">English</option>
                                    <option value="Bangla">Bangla</option>
                                    <option value="General">General Knowledge</option>
                                    <option value="Higher Math">Higher Math</option>
                                    <option value="Accounting">Accounting</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Management">Management</option>
                                    <option value="Economics">Economics</option>
                                </select>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 ml-1">Class</label>
                                <select id="editClass" class="w-full h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                                    <% (globalAcademicClasses || []).forEach(cls => { %>
                                        <option value="<%= cls.name.replace('Class ', '') %>" <%= typeof filters !== 'undefined' && filters.class === cls.name.replace('Class ', '') ? 'selected' : '' %>><%= cls.name %></option>
                                    <% }) %>
                                    <option value="HSC">HSC</option>
                                    <option value="SSC">SSC</option>
                                    <option value="JSC">JSC</option>
                                    <option value="Admission">Admission</option>
                                    <option value="BCS">BCS</option>
                                </select>
                            </div>
                            <div class="col-span-2 space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 ml-1">Access Control</label>
                                <select id="editAccessType" class="w-full h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                                    <option value="Free">Free Access</option>
                                    <option value="Paid">Paid Content</option>
                                </select>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-slate-400 ml-1">Question Content</label>
                            <textarea id="editText" class="w-full p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary leading-relaxed" rows="4"></textarea>
                        </div>

                        <div id="editMcqArea" class="hidden space-y-4">
                            <p class="text-[10px] font-black text-slate-400 ml-1">Options Matrix</p>
                            <div class="grid grid-cols-1 gap-3">
                                <% ['A','B','C','D'].forEach((l, idx) => { %>
                                    <div class="flex items-center gap-3">
                                        <span class="text-[10px] font-black text-slate-300 w-4"><%= l %></span>
                                        <input type="text" id="editOpt<%= idx %>" class="flex-1 h-10 px-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800 text-xs font-bold outline-none focus:border-primary">
                                        <input type="radio" name="editCorrectIdx" value="<%= idx %>" class="size-4 accent-emerald-500">
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <div id="editAnswerArea" class="hidden space-y-1.5">
                            <label class="text-[10px] font-black text-emerald-600 ml-1">Model Solution</label>
                            <textarea id="editAnswer" class="w-full p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-500/5 border border-emerald-100 dark:border-emerald-500/20 text-sm font-bold text-emerald-900 dark:text-emerald-300 outline-none" rows="3"></textarea>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-slate-400 ml-1">Expert Explanation</label>
                            <textarea id="editExplanation" class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-medium outline-none focus:border-primary" rows="2"></textarea>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-50 dark:border-white/5">
                            <button type="button" onclick="toggleEditMode(false)" class="text-[10px] font-black text-slate-400 uppercase hover:text-slate-600 transition-all">Cancel</button>
                            <button type="button" onclick="saveInlineEdit()" class="h-10 px-8 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-xl shadow-slate-900/10 active:scale-95 transition-all">Save Changes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Composition Wizard Modal -->
    <div id="compositionWizardModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xl z-[250] hidden flex items-center justify-center p-6">
        <div class="bg-white dark:bg-[#0b1120] rounded-[2.5rem] w-full max-w-lg overflow-hidden shadow-2xl border border-white/10 relative animate-slide-up">
            <button onclick="document.getElementById('compositionWizardModal').classList.add('hidden')" class="absolute top-6 right-6 size-10 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all">
                <span class="material-symbols-rounded text-lg">close</span>
            </button>
            <div class="p-10">
                <div class="flex items-center gap-4 mb-8">
                    <div class="size-12 rounded-2xl bg-slate-900 flex items-center justify-center text-white">
                        <span class="material-symbols-rounded text-[26px]">precision_manufacturing</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight">Composition wizard</h3>
                        <p class="text-[11px] font-bold text-slate-500 mt-0.5">Setup metadata before studio entry</p>
                    </div>
                </div>
                <div class="space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Class level</label>
                            <select id="wizClass" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-primary">
                                <% [6,7,8,9,10,11,12].forEach(c => { %><option value="<%= c %>" <%= filters.class == c ? 'selected' : '' %>>Class <%= c %></option><% }) %>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Subject</label>
                            <select id="wizSubject" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-primary">
                                <% ['Physics','Chemistry','Biology','Higher Mathematics','General Mathematics','Bangla','English','ICT','Accounting','Business Organization','Finance & Banking','Economics'].forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Chapter / Topic</label>
                        <input type="text" id="wizTopic" placeholder="e.g. Thermodynamics" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-primary">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Question type</label>
                            <select id="wizType" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-primary">
                                <option value="MCQ">MCQ (Slots)</option>
                                <option value="Short">Short answer</option>
                                <option value="Medium">Medium complexity</option>
                                <option value="Comprehension">Comprehension</option>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Quantity</label>
                            <input type="number" id="wizCount" value="10" min="1" max="50" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-primary">
                        </div>
                    </div>
                    <div class="pt-4">
                        <button onclick="startComposition()" class="w-full h-12 bg-slate-900 text-white rounded-lg font-black text-[11px] uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-slate-900/10 active:scale-95">Make questions</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const questionsData = <%- JSON.stringify(questions) %>;
        const selectedItems = new Set();
        function toggleSelectAll() { selectAllRows(document.getElementById('selectAll').checked); }
        function selectAllRows(force) {
            document.querySelectorAll('.item-cb').forEach(cb => { cb.checked = force; if(force) selectedItems.add(cb.value); else selectedItems.delete(cb.value); });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }
        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value); else selectedItems.delete(el.value);
            updateBulkUI();
        }
        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) { bar.classList.remove('hidden'); countEl.innerText = selectedItems.size; } else { bar.classList.add('hidden'); }
        }
        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkUI();
        }
        async function handleBulkAction(action) {
            const res = await Swal.fire({ title: 'Bulk Action', text: `Apply ${action} to ${selectedItems.size} items?`, icon: 'warning', showCancelButton: true });
            if (!res.isConfirmed) return;
            try {
                const response = await fetch('/admin/question/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload(); else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function startComposition() {
            const params = new URLSearchParams({
                class: document.getElementById('wizClass').value,
                subject: document.getElementById('wizSubject').value,
                topic: document.getElementById('wizTopic').value,
                type: document.getElementById('wizType').value,
                count: document.getElementById('wizCount').value,
                bankId: '<%= typeof bank !== "undefined" ? bank._id : "" %>'
            });
            window.location.href = `/admin/add-question?${params.toString()}`;
        }

        function viewQuestion(id) {
            const q = questionsData.find(item => item._id.toString() === id);
            if (!q) return;

            toggleEditMode(false); // Reset to view mode
            
            document.getElementById('modalType').innerText = q.questionType;
            document.getElementById('modalSubject').innerText = q.subject || 'General';
            document.getElementById('modalText').innerText = q.questionText;
            document.getElementById('modalBoard').innerText = q.board || 'Not Specified';
            document.getElementById('modalClass').innerText = q.classLevel ? `Class ${q.classLevel}` : 'N/A';
            document.getElementById('modalYear').innerText = q.year || '---';

            const accessEl = document.getElementById('modalAccessBadge');
            accessEl.innerHTML = q.accessType === 'Paid' 
                ? `<span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold border border-amber-500/20"><span class="material-symbols-rounded text-sm">workspace_premium</span> Paid Content</span>`
                : `<span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold border border-emerald-500/20"><span class="material-symbols-rounded text-sm">redeem</span> Free Access</span>`;

            const authorImg = document.getElementById('modalAuthorImg');
            const authorName = document.getElementById('modalAuthorName');
            const authorRole = document.getElementById('modalAuthorRole');
            
            if (q.addedBy && typeof q.addedBy === 'object') {
                authorName.innerText = q.addedBy.name || 'System';
                authorRole.innerText = q.addedBy.role || 'Administrator';
                authorImg.src = q.addedBy.profileImage || '/images/default-avatar.png';
            } else {
                authorName.innerText = 'System';
                authorRole.innerText = 'Automatic';
                authorImg.src = '/images/default-avatar.png';
            }

            const optionsContainer = document.getElementById('modalOptionsContainer');
            const optionsEl = document.getElementById('modalOptions');
            optionsEl.innerHTML = '';
            
            if (q.questionType === 'MCQ' && q.options && q.options.length > 0) {
                optionsContainer.classList.remove('hidden');
                q.options.forEach((opt, idx) => {
                    const isCorrect = idx === q.correctAnswerIndex;
                    const div = document.createElement('div');
                    div.className = `p-4 rounded-2xl border transition-all ${isCorrect ? 'border-emerald-500 bg-emerald-50/30 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-2 ring-emerald-500/20' : 'border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 shadow-sm'} text-[13px] font-bold flex gap-3 items-center`;
                    div.innerHTML = `<div class="size-6 rounded-lg ${isCorrect ? 'bg-emerald-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-500'} flex items-center justify-center text-[11px] font-black shrink-0">${String.fromCharCode(65 + idx)}</div><span class="flex-1">${opt}</span>${isCorrect ? '<span class="material-symbols-rounded text-emerald-500 text-lg">check_circle</span>' : ''}`;
                    optionsEl.appendChild(div);
                });
                document.getElementById('modalAnswer').innerText = q.options[q.correctAnswerIndex] || 'No answer defined';
            } else {
                optionsContainer.classList.add('hidden');
                document.getElementById('modalAnswer').innerText = q.correctAnswer || 'Refer to reference materials.';
            }

            document.getElementById('modalEditBtn').onclick = () => toggleEditMode(true, q);
            document.getElementById('viewModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden'; 
        }

        function toggleEditMode(enable, q = null) {
            const view = document.getElementById('viewModeContainer');
            const edit = document.getElementById('editModeContainer');
            const editBtn = document.getElementById('modalEditBtn');

            if (enable && q) {
                view.classList.add('hidden');
                edit.classList.remove('hidden');
                editBtn.classList.add('hidden');

                document.getElementById('editQId').value = q._id;
                document.getElementById('editBoard').value = q.board || '';
                document.getElementById('editYear').value = q.year || '';
                document.getElementById('editSubject').value = q.subject || '';
                document.getElementById('editClass').value = q.classLevel || '';
                document.getElementById('editAccessType').value = q.accessType || 'Free';
                document.getElementById('editText').value = q.questionText || '';
                document.getElementById('editExplanation').value = q.explanation || '';

                if (q.questionType === 'MCQ') {
                    document.getElementById('editMcqArea').classList.remove('hidden');
                    document.getElementById('editAnswerArea').classList.add('hidden');
                    q.options.forEach((opt, idx) => {
                        const input = document.getElementById(`editOpt${idx}`);
                        if (input) input.value = opt;
                    });
                    const radios = document.getElementsByName('editCorrectIdx');
                    if (radios[q.correctAnswerIndex]) radios[q.correctAnswerIndex].checked = true;
                } else {
                    document.getElementById('editMcqArea').classList.add('hidden');
                    document.getElementById('editAnswerArea').classList.remove('hidden');
                    document.getElementById('editAnswer').value = q.correctAnswer || '';
                }
            } else {
                view.classList.remove('hidden');
                edit.classList.add('hidden');
                editBtn.classList.remove('hidden');
            }
        }

        async function saveInlineEdit() {
            const qId = document.getElementById('editQId').value;
            const data = {
                board: document.getElementById('editBoard').value,
                year: document.getElementById('editYear').value,
                subject: document.getElementById('editSubject').value,
                classLevel: document.getElementById('editClass').value,
                accessType: document.getElementById('editAccessType').value,
                questionText: document.getElementById('editText').value,
                explanation: document.getElementById('editExplanation').value,
                questionType: document.getElementById('editMcqArea').classList.contains('hidden') ? 'Short' : 'MCQ' 
            };

            if (data.questionType === 'MCQ') {
                data.options = [
                    document.getElementById('editOpt0').value,
                    document.getElementById('editOpt1').value,
                    document.getElementById('editOpt2').value,
                    document.getElementById('editOpt3').value
                ];
                const radios = document.getElementsByName('editCorrectIdx');
                for (let i = 0; i < radios.length; i++) { if (radios[i].checked) { data.correctAnswerIndex = i; break; } }
            } else {
                data.correctAnswer = document.getElementById('editAnswer').value;
            }

            try {
                const response = await fetch(`/admin/edit-question/${qId}`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    const updatedQ = await response.json();
                    
                    // Update local data
                    const idx = questionsData.findIndex(item => item._id.toString() === qId);
                    if (idx !== -1) {
                        questionsData[idx] = { ...questionsData[idx], ...data, ...updatedQ };
                    }

                    Swal.fire({ icon: 'success', title: 'Saved!', timer: 1000, showConfirmButton: false });
                    
                    // Switch back to view mode and update UI
                    toggleEditMode(false);
                    viewQuestion(qId);
                    
                    // Update the table row without reload
                    try {
                        const row = document.querySelector(`tr[onclick*="${qId}"]`);
                        if (row) {
                            const contentP = row.querySelector('.line-clamp-2');
                            if (contentP) contentP.innerText = data.questionText;
                            
                            const metadataCells = row.querySelectorAll('td');
                            if (metadataCells.length >= 7) {
                                // Board/Year Cell
                                const boardSpans = metadataCells[3].querySelectorAll('span');
                                if (boardSpans.length >= 2) {
                                    boardSpans[0].innerText = data.board || '---';
                                    boardSpans[1].innerText = data.year || '';
                                }
                                
                                // Subject Cell
                                const subjectSpan = metadataCells[4].querySelector('span');
                                if (subjectSpan) subjectSpan.innerText = data.subject || 'General';
                                
                                // Class Cell
                                metadataCells[5].innerText = `Class: ${data.classLevel}`;
                                
                                // Access badge update
                                const accessCell = metadataCells[6];
                                if (data.accessType === 'Paid') {
                                    accessCell.innerHTML = `<span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20">Paid</span>`;
                                } else {
                                    accessCell.innerHTML = `<span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>`;
                                }
                            }
                        }
                    } catch (domErr) {
                        console.warn('Row update failed, but data was saved:', domErr);
                    }
                } else {
                    const err = await response.text();
                    Swal.fire({ icon: 'error', title: 'Save Failed', text: err });
                }
            } catch (err) { 
                console.error('Save error:', err);
                Swal.fire({ icon: 'error', title: 'System Error', text: err.message || 'Failed to connect' }); 
            }
        }

        function closeModal() { 
            document.getElementById('viewModal').classList.add('hidden'); 
            document.body.style.overflow = '';
        }

        async function deleteQuestion(id) {
            const res = await Swal.fire({ title: 'Delete?', text: 'Remove from database?', icon: 'warning', showCancelButton: true });
            if (res.isConfirmed) window.location.href = `/admin/question/${id}/delete`;
        }

        function exportToCSV() {
            const rows = [['Question', 'Type', 'Board', 'Year', 'Subject', 'Class', 'Author']];
            questionsData.forEach(q => rows.push([`"${q.questionText.replace(/"/g, '""')}"`, q.questionType, q.board, q.year, q.subject, q.classLevel, q.addedBy?.name || 'System']));
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            window.location.href = encodeURI(csvContent);
        }
    </script>
</body>
</html>
