<!DOCTYPE html>
<html lang="en" class="<%= (typeof user !== 'undefined' && user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Complete Academic & Address Credentials | ODDHAY Admin Hub</title>
</head>
<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen p-3 sm:p-6 lg:p-8 flex items-center justify-center selection:bg-primary/20">

    <div class="max-w-2xl w-full bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xl overflow-hidden transition-all my-auto">
        <!-- Top Progress Stripe -->
        <div class="h-1.5 bg-gradient-to-r from-blue-600 via-indigo-500 to-sky-400"></div>

        <div class="p-4 sm:p-7 space-y-4 sm:space-y-6">
            <!-- Admin Verification Notice -->
            <div class="p-3.5 sm:p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 space-y-2">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide"><%= user.name %></span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">Admin</span>
                    </div>
                    <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium"><%= user.email %></span>
                </div>
                <p class="text-[11.5px] text-blue-600 dark:text-sky-400 leading-relaxed font-medium pt-1.5 border-t border-slate-200/60 dark:border-slate-800">
                    Welcome to ODDHAY Admin Hub. As part of institutional governance, entering your verified academic credentials and residential addresses is mandatory on your first login.
                </p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center gap-2">
                    <span class="material-symbols-rounded text-base text-rose-500 shrink-0">error</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Form -->
            <form action="/admin/onboarding-profile" method="POST" class="space-y-5">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <!-- 1. ACADEMIC CREDENTIALS SECTION -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 pb-1.5 border-b border-slate-100 dark:border-slate-800">
                        <span class="material-symbols-rounded text-blue-500 text-base">history_edu</span>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                            Academic Background <span class="text-rose-500">*</span>
                        </h3>
                    </div>

                    <!-- School & SSC -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                Secondary School Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="schoolName" value="<%= user.schoolName || '' %>" required placeholder="Type school name..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                SSC GPA <span class="text-slate-500 dark:text-slate-400 font-normal text-[11px]">(Optional)</span>
                            </label>
                            <input type="text" name="sscGpa" value="<%= user.sscGpa || '' %>" placeholder="Type SSC GPA..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                    </div>

                    <!-- College & HSC -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                Higher Secondary College Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="collegeName" value="<%= user.collegeName || '' %>" required placeholder="Type college name..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                HSC GPA <span class="text-slate-500 dark:text-slate-400 font-normal text-[11px]">(Optional)</span>
                            </label>
                            <input type="text" name="hscGpa" value="<%= user.hscGpa || '' %>" placeholder="Type HSC GPA..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                    </div>

                    <!-- University & CGPA -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                University / Highest Degree Institution <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="universityName" value="<%= user.universityName || '' %>" required placeholder="Type university / institution name..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                CGPA / Grade <span class="text-slate-500 dark:text-slate-400 font-normal text-[11px]">(Optional)</span>
                            </label>
                            <input type="text" name="cgpa" value="<%= user.cgpa || '' %>" placeholder="Type CGPA or grade..."
                                   class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all">
                        </div>
                    </div>
                </div>

                <!-- 2. RESIDENTIAL ADDRESSES SECTION -->
                <div class="space-y-3 pt-2">
                    <div class="flex items-center justify-between pb-1.5 border-b border-slate-100 dark:border-slate-800">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-rose-500 text-base">home_pin</span>
                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                                Address Details <span class="text-rose-500">*</span>
                            </h3>
                        </div>
                        <label class="inline-flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 cursor-pointer select-none">
                            <input type="checkbox" id="sameAddressCheck" onchange="syncAddresses(this)" class="size-3.5 rounded border-slate-300 dark:border-slate-700 text-blue-600 focus:ring-0">
                            <span>Permanent same as present</span>
                        </label>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                Present Address <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="presentAddress" name="presentAddress" required rows="2" placeholder="Type present address..."
                                      class="w-full p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all resize-none"><%= user.presentAddress || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-800 dark:text-slate-200 mb-1">
                                Permanent Address <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="permanentAddress" name="permanentAddress" required rows="2" placeholder="Type permanent address..."
                                      class="w-full p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-blue-500 transition-all resize-none"><%= user.permanentAddress || '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit"
                            class="w-full h-10 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                        <span class="material-symbols-rounded text-base">check_circle</span>
                        <span>Complete Setup & Enter Admin Workspace</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function syncAddresses(checkbox) {
            const present = document.getElementById('presentAddress');
            const permanent = document.getElementById('permanentAddress');
            if (checkbox.checked) {
                permanent.value = present.value;
                permanent.readOnly = true;
                permanent.classList.add('opacity-75');
            } else {
                permanent.readOnly = false;
                permanent.classList.remove('opacity-75');
            }
        }
        document.getElementById('presentAddress')?.addEventListener('input', function() {
            const check = document.getElementById('sameAddressCheck');
            if (check && check.checked) {
                document.getElementById('permanentAddress').value = this.value;
            }
        });
    </script>
</body>
</html>
