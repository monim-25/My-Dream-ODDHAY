<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Academic Studio | ODDHAY Command Center</title>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                min-height: 100vh;
                transition: all 0.3s ease;
            }

            .stat-card {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .dark .stat-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            .chart-container {
                position: relative;
                width: 100%;
                height: 200px;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }
            }
        </style>
</head>

<body class="bg-[#F8F8FF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans min-h-screen">
    <div class="flex">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'academic' }) %>
        </aside>

        <main class="admin-main flex-1 ml-[260px] bg-[#F8F8FF] flex flex-col min-h-screen w-full">
            <%- include('header_v2', { pageTitle: 'Academic Studio' }) %>

                <section class="flex flex-col gap-0.5 bg-[#F8F8FF] border-l border-slate-900/10 dark:border-white/5 p-0.5 w-full">
                    <!-- Academic Performance - Unified Container -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-1">
                            <div class="p-3 flex flex-col group h-[85px] bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md shadow-sm hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">analytics</span>
                                <p class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">analytics</span> Avg Score</p>
                                <div class="flex-1 flex flex-col justify-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.avgPerformance %>%</h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold relative z-10">QualityIndex &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md shadow-sm hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">quiz</span>
                                <p class="text-[11px] font-semibold text-amber-500 dark:text-amber-400 flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">quiz</span> Quizzes</p>
                                <div class="flex-1 flex flex-col justify-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.totalQuizzes %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold relative z-10">ActiveExams &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md shadow-sm hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">groups</span>
                                <p class="text-[11px] font-semibold text-emerald-500 dark:text-emerald-400 flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">groups</span> Participation</p>
                                <div class="flex-1 flex flex-col justify-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.attendanceRate %>%</h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold relative z-10">DailyAvg &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md shadow-sm hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-violet-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">task</span>
                                <p class="text-[11px] font-semibold text-violet-500 dark:text-violet-400 flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">task</span> Submissions</p>
                                <div class="flex-1 flex flex-col justify-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.assignmentSubmissions %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold relative z-10">TotalTasks &rarr;</p>
                            </div>

                        </div>
                    </div>

                    <!-- Content Library - Unified Container -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-1">
                            <div class="p-3 flex flex-col group h-[85px] bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-md shadow-sm hover:bg-rose-100/40 dark:hover:bg-rose-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-rose-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">play_circle</span>
                                <p class="text-[11px] font-bold text-rose-500 dark:text-rose-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">play_circle</span> Videos</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.totalClasses %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">Lessons &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-fuchsia-50/40 dark:bg-fuchsia-500/10 border border-fuchsia-100/20 dark:border-fuchsia-500/20 rounded-md shadow-sm hover:bg-fuchsia-100/40 dark:hover:bg-fuchsia-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-fuchsia-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">menu_book</span>
                                <p class="text-[11px] font-bold text-fuchsia-500 dark:text-fuchsia-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">menu_book</span> Materials</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.totalMaterials %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">PDFDocs &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-cyan-50/40 dark:bg-cyan-500/10 border border-cyan-100/20 dark:border-cyan-500/20 rounded-md shadow-sm hover:bg-cyan-100/40 dark:hover:bg-cyan-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-cyan-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">edit_note</span>
                                <p class="text-[11px] font-bold text-cyan-500 dark:text-cyan-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">edit_note</span> Notes</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.totalNotes %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">SharedNotes &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-orange-50/40 dark:bg-orange-500/10 border border-orange-100/20 dark:border-orange-500/20 rounded-md shadow-sm hover:bg-orange-100/40 dark:hover:bg-orange-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-orange-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">campaign</span>
                                <p class="text-[11px] font-bold text-orange-500 dark:text-orange-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">campaign</span> Updates</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= stats.totalAnnouncements %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">Broadcasts &rarr;</p>
                            </div>
                        </div>
                    </div>

                    <!-- Platform Overview - Unified Container -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-1">
                            <div class="p-3 flex flex-col group h-[85px] bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md shadow-sm hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">school</span>
                                <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">school</span> Students</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= userCount ? userCount.students : 0 %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">Active &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md shadow-sm hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">co_present</span>
                                <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">co_present</span> Teachers</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= userCount ? userCount.teachers : 0 %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">Faculty &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md shadow-sm hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-violet-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">family_restroom</span>
                                <p class="text-[11px] font-bold text-violet-600 dark:text-violet-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">family_restroom</span> Guardians</p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= userCount ? userCount.guardians : 0 %></h3>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold tracking-tight relative z-10">Parents &rarr;</p>
                            </div>
                            <div class="p-3 flex flex-col group h-[85px] bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md shadow-sm hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all relative overflow-hidden">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">payments</span>
                                <p class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5 mb-1 relative z-10"><span class="material-symbols-rounded text-[14px]">payments</span> Revenue</p>
                                <div class="flex-1 flex flex-col justify-center relative z-10">
                                    <div class="flex items-center gap-2">
                                        <% if (typeof revenueComparison !== 'undefined' && revenueComparison.yearlyVsLastYear !== 0) { %>
                                            <span class="px-1.5 py-0.5 rounded text-[12px] font-black <%= revenueComparison.yearlyVsLastYear > 0 ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500' %>">
                                                <%= revenueComparison.yearlyVsLastYear > 0 ? '↑' : '↓' %> <%= Math.abs(revenueComparison.yearlyVsLastYear) %>%
                                            </span>
                                        <% } %>
                                        <% if (user.role === 'superadmin') { %>
                                            <span class="text-xs font-bold text-slate-400">/ <%= totalPaymentRevenue ? ('৳' + (totalPaymentRevenue/1000).toFixed(1) + 'K' ) : '৳0' %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <p class="text-[9px] text-slate-500 font-bold relative z-10">Yearly Growth &rarr;</p>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Row: Score Distribution + Enrollment Trends -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-1">
                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Quiz Score Distribution</h3>
                            </div>
                            <div class="p-3">
                                <div class="chart-container">
                                    <canvas id="scoreDistChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Enrollment Trends (30 Days)</h3>
                            </div>
                            <div class="p-3">
                                <div class="chart-container">
                                    <canvas id="enrollmentChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pass/Fail Rate + Top Students -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-1">
                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Pass/Fail Rate</h3>
                            </div>
                            <div class="p-3">
                                <div class="chart-container" style="height: 180px;">
                                    <canvas id="passFailChart"></canvas>
                                </div>
                                <div class="mt-3 grid grid-cols-2 gap-2">
                                    <div class="text-center p-2 bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md">
                                        <p class="text-lg font-bold text-emerald-500"><%= stats.passFailRates.passed %></p>
                                        <p class="text-[11px] font-bold text-emerald-400">Passed</p>
                                    </div>
                                    <div class="text-center p-2 bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-md">
                                        <p class="text-lg font-bold text-rose-500"><%= stats.passFailRates.failed %></p>
                                        <p class="text-[11px] font-bold text-rose-400">Failed</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden lg:col-span-2">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Top Performing Students</h3>
                                <span class="text-[9px] font-bold text-slate-400">By quiz score</span>
                            </div>
                            <div class="p-2 space-y-1 max-h-[280px] overflow-y-auto">
                                <% if (stats.topStudents && stats.topStudents.length > 0) { %>
                                    <% stats.topStudents.forEach(function(student, index) { %>
                                        <div class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                                            <div class="size-8 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-sm">
                                                <%= student.name ? student.name[0].toUpperCase() : 'S' %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-[11px] font-bold truncate"><%= index + 1 %>. <%= student.name %></p>
                                                <p class="text-[9px] text-slate-400 truncate"><%= student.email %></p>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-[11px] font-bold text-emerald-500"><%= student.avgScore.toFixed(1) %>%</p>
                                                <p class="text-[9px] text-slate-400"><%= student.totalQuizzes %> quizzes</p>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center py-8 opacity-40">
                                        <span class="material-symbols-rounded text-3xl mb-1">emoji_events</span>
                                        <p class="text-[10px] font-bold">No quiz data yet</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- At-Risk Students + Categories Revenue -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-1">
                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">At-Risk Students</h3>
                                <span class="text-[9px] font-bold text-rose-500 bg-rose-500/10 px-2 py-0.5 rounded-md">Inactive 7+ days</span>
                            </div>
                            <div class="p-1.5">
                                <div class="space-y-1 max-h-[280px] overflow-y-auto">
                                    <% if(atRiskStudents && atRiskStudents.length > 0){ %>
                                        <% atRiskStudents.forEach(function(student){ %>
                                            <div class="flex items-center justify-between p-2 rounded-md hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                                                <div class="flex items-center gap-2">
                                                    <div class="size-8 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-xs">
                                                        <%=student.name?student.name[0].toUpperCase():'S'%>
                                                    </div>
                                                    <div>
                                                        <p class="text-[11px] font-bold"><%=student.name%></p>
                                                        <p class="text-[9px] text-slate-400"><%=student.lastActive ? new Date(student.lastActive).toLocaleDateString('en-GB') : 'Never' %></p>
                                                    </div>
                                                </div>
                                                <a href="/admin/user/<%=student._id%>" class="size-7 rounded-md bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-primary transition-all">
                                                    <span class="material-symbols-rounded text-[16px]">visibility</span>
                                                </a>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="flex flex-col items-center justify-center py-8 text-slate-400">
                                            <span class="material-symbols-rounded text-2xl mb-1 opacity-40">check_circle</span>
                                            <p class="text-[10px] font-bold">Everyone is active</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Course Selling Growth</h3>
                            </div>
                            <div class="p-1.5">
                                <div class="space-y-2 max-h-[280px] overflow-y-auto">
                                    <% if(stats.courseSellingGrowth && stats.courseSellingGrowth.length > 0){ %>
                                        <% stats.courseSellingGrowth.forEach(function(course){ %>
                                            <div class="space-y-1">
                                                <div class="flex items-center justify-between">
                                                    <span class="text-[11px] font-semibold text-slate-500 truncate max-w-[180px]"><%=course.title%></span>
                                                    <span class="text-[11px] font-black text-blue-600">
                                                        <%=course.count%> <span class="text-[9px] font-bold text-slate-400">Enrolled</span>
                                                    </span>
                                                </div>
                                                <div class="h-1.5 w-full bg-slate-100 dark:bg-slate-800 rounded-md overflow-hidden">
                                                    <div class="h-full bg-blue-500 rounded-md" style="width:<%=Math.min((course.count/stats.courseSellingGrowth[0].count)*100,100)%>%"></div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="flex flex-col items-center justify-center py-8 text-slate-400">
                                            <span class="material-symbols-rounded text-2xl mb-1 opacity-40">trending_up</span>
                                            <p class="text-[10px] font-bold">No selling data</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Teacher Performance Matrix -->
                    <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                        <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                            <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Teacher Performance</h3>
                            <a href="/admin/instructors" class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead class="bg-slate-50/50 dark:bg-white/5 border-b border-slate-100 dark:border-white/5">
                                    <tr>
                                        <th class="px-4 py-3 text-left text-[11px] font-bold text-slate-500">Instructor</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Courses</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Classes</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Notes</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Q's Added</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Questions Answered</th>
                                        <th class="px-4 py-3 text-center text-[11px] font-bold text-slate-500">Rating</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                    <% if(teacherPerformance && teacherPerformance.length > 0){ %>
                                        <% teacherPerformance.forEach(function(teacher){ %>
                                            <tr class="hover:bg-slate-50 dark:hover:bg-white/5">
                                                <td class="px-4 py-3">
                                                    <div class="flex items-center gap-3">
                                                        <div class="size-9 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-sm">
                                                            <%=teacher.name?teacher.name.charAt(0).toUpperCase():'T'%>
                                                        </div>
                                                        <div>
                                                            <p class="text-[12px] font-bold text-slate-900"><%=teacher.name%></p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-center"><p class="text-[12px] font-bold text-slate-800"><%=teacher.totalCourses%></p></td>
                                                <td class="px-4 py-3 text-center"><p class="text-[12px] font-bold text-slate-800"><%=teacher.classesUploaded%></p></td>
                                                <td class="px-4 py-3 text-center"><p class="text-[12px] font-bold text-slate-800"><%=teacher.notesUploaded%></p></td>
                                                <td class="px-4 py-3 text-center"><p class="text-[12px] font-bold text-slate-800"><%=teacher.questionsAdded%></p></td>
                                                <td class="px-4 py-3 text-center"><p class="text-[12px] font-bold text-emerald-600"><%=teacher.qaResolved%></p></td>
                                                <td class="px-4 py-3 text-center">
                                                    <div class="flex items-center justify-center gap-1">
                                                        <span class="material-symbols-rounded text-[14px] text-amber-500">star</span>
                                                        <p class="text-[12px] font-bold text-slate-800"><%=teacher.rating%></p>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="px-4 py-8 text-center">
                                                <div class="flex flex-col items-center text-slate-400">
                                                    <span class="material-symbols-rounded text-2xl mb-1 opacity-40">school</span>
                                                    <p class="text-[11px] font-bold">No instructors found</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm flex flex-col overflow-hidden">
                        <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                            <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Recent Activity</h3>
                            <a href="/admin/logs" class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                        </div>
                        <div class="p-1.5 grid grid-cols-1 md:grid-cols-2 gap-0.5">
                            <% if(recentActivity && recentActivity.length > 0){ %>
                                <% recentActivity.forEach(function(activity){ %>
                                    <div class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                                        <div class="size-8 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-primary">
                                            <span class="material-symbols-rounded text-[16px]"><%=activity.icon%></span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-[11px] font-bold truncate"><%=activity.text%></p>
                                            <p class="text-[9px] text-slate-400"><%=activity.time%></p>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="col-span-2 flex flex-col items-center justify-center py-8 text-slate-400">
                                    <span class="material-symbols-rounded text-2xl mb-1 opacity-40">history</span>
                                    <p class="text-[10px] font-bold">No recent activity</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
        </main>
    </div>

    <script>
        function toggleAdminSidebar() { document.getElementById('adminSidebar').classList.toggle('active'); }

        // Chart Initialization
        window.addEventListener('DOMContentLoaded', () => {
            // Quiz Score Distribution Chart
            const scoreDist = <%- JSON.stringify(stats.quizScoreDistribution || {}) %>;
            const scoreCanvas = document.getElementById('scoreDistChart');
            if (scoreCanvas && scoreDist) {
                const ctx = scoreCanvas.getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['0-20%', '20-40%', '40-60%', '60-80%', '80-100%'],
                        datasets: [{
                            label: 'Students',
                            data: [scoreDist.score0_20 || 0, scoreDist.score20_40 || 0, scoreDist.score40_60 || 0, scoreDist.score60_80 || 0, scoreDist.score80_100 || 0],
                            backgroundColor: ['#ef4444', '#f59e0b', '#eab308', '#22c55e', '#10b981'],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.03)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // Enrollment Trend Chart
            const enrollmentTrends = <%- JSON.stringify(stats.enrollmentTrends || []) %>;
            const enrollCanvas = document.getElementById('enrollmentChart');
            if (enrollCanvas && enrollmentTrends.length > 0) {
                const ctx = enrollCanvas.getContext('2d');
                const labels = enrollmentTrends.map(e => {
                    const d = new Date(e._id);
                    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
                });
                const data = enrollmentTrends.map(e => e.count);

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'New Students',
                            data: data,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.03)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // Pass/Fail Doughnut
            const passFail = <%- JSON.stringify(stats.passFailRates || {}) %>;
            const passFailCanvas = document.getElementById('passFailChart');
            if (passFailCanvas && (passFail.passed > 0 || passFail.failed > 0)) {
                const ctx = passFailCanvas.getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Passed', 'Failed'],
                        datasets: [{
                            data: [passFail.passed || 0, passFail.failed || 0],
                            backgroundColor: ['#10b981', '#ef4444'],
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, font: { size: 10, weight: 'bold' } } }
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>
