<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>User Database | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .action-btn { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .action-btn:hover { transform: translateY(-1px); }
        .bulk-bar { position: fixed; bottom: 0.25rem; left: 0.5rem; right: 0.5rem; background: #0f172a; border: 1px solid rgba(255,255,255,0.1); padding: 0.75rem 1.5rem; border-radius: 0.375rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; z-index: 1000; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 20px 40px rgba(0,0,0,0.4); opacity: 0; visibility: hidden; }
        .bulk-bar.active { opacity: 1; visibility: visible; }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'users' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'User Database' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <!-- Summary Stats - Unified Container -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-1">
                        <div class="bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">group</span>
                            <p class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 relative z-10">Total Users</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.total || 0 %></h2></div>
                        </div>
                        <div class="bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">school</span>
                            <p class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 relative z-10">Students</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.students || 0 %></h2></div>
                        </div>
                        <div class="bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">person_apron</span>
                            <p class="text-[11px] font-semibold text-amber-600 dark:text-amber-400 relative z-10">Instructors</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.teachers || 0 %></h2></div>
                        </div>
                        <div class="bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-violet-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">family_restroom</span>
                            <p class="text-[11px] font-semibold text-violet-600 dark:text-violet-400 relative z-10">Guardians</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.guardians || 0 %></h2></div>
                        </div>
                        <div class="bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-rose-100/40 dark:hover:bg-rose-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-rose-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">block</span>
                            <p class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 relative z-10">Suspended</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.suspended || 0 %></h2></div>
                        </div>
                        <div class="bg-slate-50/80 dark:bg-slate-500/10 border border-slate-200/40 dark:border-slate-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-slate-100/80 dark:hover:bg-slate-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-slate-400 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">person_remove</span>
                            <p class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 relative z-10">Removed</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10"><%= stats.removed || 0 %></h2></div>
                        </div>
                        <div class="bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md p-3 flex flex-col relative overflow-hidden group h-[85px] shadow-sm hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">trending_up</span>
                            <p class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 relative z-10">New Today</p>
                            <div class="flex-1 flex items-center"><h2 class="text-xl font-black text-slate-900 dark:text-white relative z-10">+<%= stats.newToday || 0 %></h2></div>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Filters Bar - Same as Question Bank -->
                    <div class="sticky top-[-0.5rem] z-30 bg-white dark:bg-slate-800 px-3 py-2 border-b border-slate-50 dark:border-slate-700/50 flex flex-wrap items-center justify-between gap-3 shadow-sm rounded-t-md">
                        <form action="/admin/users" method="GET" class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <div class="relative flex-1 max-w-[500px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search by name or email..." class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <button type="submit" class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] hover:text-primary transition-colors">search</button>
                            </div>
                            
                            <select name="role" onchange="this.form.submit()" class="h-10 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500">
                                <option value="all" <%= filters.role === 'all' ? 'selected' : '' %>>All Roles</option>
                                <option value="student" <%= filters.role === 'student' ? 'selected' : '' %>>Students</option>
                                <option value="teacher" <%= filters.role === 'teacher' ? 'selected' : '' %>>Instructors</option>
                                <option value="guardian" <%= filters.role === 'guardian' ? 'selected' : '' %>>Guardians</option>
                            </select>

                            <select name="status" onchange="this.form.submit()" class="h-10 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500">
                                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                            </select>
                        </form>
                        
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1.5 px-3 h-10 rounded-md bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
                                <span class="text-[10px] font-bold text-slate-400">Found:</span>
                                <span class="text-[12px] font-black text-primary"><%= (typeof filters.totalResults !== 'undefined') ? filters.totalResults : users.length %></span>
                                <span class="text-[10px] font-bold text-slate-400">Users</span>
                            </div>
                            <a href="/admin/users/export" class="h-10 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </a>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-4 pr-1 py-2 text-[11px] font-semibold text-slate-500 w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer accent-primary">
                                    </th>
                                    <th class="pl-1 pr-4 py-2 text-[11px] font-semibold text-slate-500">User Identity</th>
                                    <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-center">Role</th>
                                    <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-center">Status</th>
                                    <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-center">Enrollments</th>
                                    <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-center">Last Active</th>
                                    <th class="pr-4 py-2 text-[11px] font-semibold text-slate-500 text-right">Actions</th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% if(users && users.length > 0){ %>
                                    <% users.forEach(u => { %>
                                        <% 
                                            const isMaster = user.email && user.email === process.env.SUPER_ADMIN_EMAIL;
                                            const isSuperAdmin = user.role === 'superadmin' || isMaster;
                                            const isProtected = ['admin', 'superadmin'].includes(u.role);
                                            const canManage = isSuperAdmin || !isProtected;

                                            // MOCK: Auto-verify some for demo
                                            if (typeof u.isEmailVerified === 'undefined') {
                                                u.isEmailVerified = Math.random() > 0.3;
                                                u.isPhoneVerified = Math.random() > 0.5;
                                            }
                                        %>
                                        <tr class="user-row hover:bg-slate-50 dark:hover:bg-white/5 transition-all cursor-pointer group" ondblclick="toggleRowSelection('<%= u._id %>')">
                                            <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                                <% if(canManage) { %>
                                                    <input type="checkbox" class="user-checkbox size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100 accent-primary" value="<%= u._id %>" id="cb-<%= u._id %>" onchange="updateSelection(this)">
                                                <% } %>
                                            </td>
                                            <td class="pl-1 pr-4 py-2 text-left">
                                                <div class="flex items-center gap-3 justify-start">
                                                    <div class="size-9 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-xs text-slate-500 shadow-sm border border-slate-200 dark:border-slate-700">
                                                        <%= u.name ? u.name[0].toUpperCase() : 'U' %>
                                                    </div>
                                                    <div class="flex flex-col">
                                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight"><%= u.name %></p>
                                                        <div class="flex items-center gap-1">
                                                            <p class="text-[9px] text-slate-400 font-semibold"><%= u.email %></p>
                                                            <% if(u.isEmailVerified) { %>
                                                                <span class="material-symbols-rounded text-[10px] text-emerald-500 font-black" title="Email Verified">verified</span>
                                                            <% } else { %>
                                                                <span class="material-symbols-rounded text-[10px] text-slate-300 font-black" title="Email Not Verified">pending</span>
                                                            <% } %>
                                                            <% if(u.phone && u.isPhoneVerified) { %>
                                                                <span class="material-symbols-rounded text-[10px] text-blue-500 font-black" title="Phone Verified">verified_user</span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="px-4 py-3 text-center">
                                                <span class="px-2 py-0.5 rounded-md text-[9px] font-semibold <%= u.role==='student'?'bg-emerald-50 text-emerald-600':u.role==='teacher'?'bg-amber-50 text-amber-600':u.role==='guardian'?'bg-violet-50 text-violet-600':u.role==='admin'?'bg-blue-50 text-blue-600':'bg-purple-50 text-purple-600' %> border border-current/10">
                                                    <%= u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
                                                </span>
                                            </td>

                                            <td class="px-4 py-3 text-center">
                                                <span class="px-2 py-0.5 rounded-md text-[9px] font-semibold <%= u.status==='suspended'?'bg-rose-50 text-rose-600':'bg-emerald-50 text-emerald-600' %> border border-current/10">
                                                    <%= (u.status || 'active').charAt(0).toUpperCase() + (u.status || 'active').slice(1) %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= (u.enrolledCourses && u.enrolledCourses.length) || 0 %></span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[10px] font-semibold text-slate-500"><%= u.lastActive ? new Date(u.lastActive).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : 'Never' %></span>
                                            </td>
                                            <td class="pr-4 py-3 text-right">
                                                <div class="flex items-center justify-end gap-1">
                                                    <% if(canManage) { %>
                                                        <a href="/admin/user/<%= u._id %>" class="action-btn size-7 rounded bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white flex items-center justify-center shadow-sm" title="View Profile">
                                                            <span class="material-symbols-rounded text-sm">visibility</span>
                                                        </a>
                                                        <button onclick="openRoleModal('<%= u._id %>','<%= u.role %>')" class="action-btn size-7 rounded bg-violet-50 dark:bg-violet-500/10 border border-violet-100 dark:border-violet-500/20 text-violet-500 hover:bg-violet-500 hover:text-white flex items-center justify-center shadow-sm" title="Change Role">
                                                            <span class="material-symbols-rounded text-[16px] leading-none block">badge</span>
                                                        </button>
                                                        <button onclick="openStatusModal('<%= u._id %>','<%= u.status || 'active' %>')" class="action-btn size-7 rounded bg-amber-50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 text-amber-500 hover:bg-amber-500 hover:text-white flex items-center justify-center shadow-sm" title="<%= u.status==='suspended' ? 'Activate' : 'Suspend' %>">
                                                            <span class="material-symbols-rounded text-sm"><%= u.status==='suspended' ? 'play_arrow' : 'pause' %></span>
                                                        </button>
                                                        <button onclick="resetPw('<%= u._id %>')" class="action-btn size-7 rounded bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 hover:bg-slate-700 hover:text-white flex items-center justify-center shadow-sm" title="Reset Password">
                                                            <span class="material-symbols-rounded text-sm">key</span>
                                                        </button>
                                                        <button onclick="confirmDelete('<%= u._id %>', '<%= u.name %>')" class="action-btn size-7 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white flex items-center justify-center shadow-sm" title="Delete User">
                                                            <span class="material-symbols-rounded text-sm">delete</span>
                                                        </button>
                                                    <% } else { %>
                                                        <span class="text-[9px] font-bold text-slate-400 italic bg-slate-100 dark:bg-slate-900 px-2 py-0.5 rounded"><%= u.role === 'superadmin' ? 'Super Admin' : 'Admin Account' %></span>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="px-4 py-12 text-center text-slate-400">
                                            <span class="material-symbols-rounded text-3xl mb-2 opacity-40">person_off</span>
                                            <p class="text-[11px] font-bold">No users matching the filters</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&role=<%= filters.role %>&status=<%= filters.status %>&activity=<%= filters.activity %>&q=<%= encodeURIComponent(filters.q) %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold transition-all shadow-sm <%= filters.page === i ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Bulk Action Bar - Question Bank Style -->
                    <div id="bulkBar" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-between z-50 border border-slate-200 dark:border-slate-700 mx-4 rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50 transition-all duration-300 transform translate-y-10 opacity-0">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                                </div>
                                <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <button onclick="selectAllRows(true)" id="selectAllBtn" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-lg bg-slate-50/50 dark:bg-slate-900/50">Select All</button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="bulkAction('activate')" class="h-8 px-4 bg-emerald-500 text-white rounded-lg text-[10px] font-bold hover:bg-emerald-600 transition-all shadow-lg shadow-emerald-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">play_arrow</span> Activate
                            </button>
                            <button onclick="bulkAction('suspend')" class="h-8 px-4 bg-amber-500 text-white rounded-lg text-[10px] font-bold hover:bg-amber-600 transition-all shadow-lg shadow-amber-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">pause</span> Suspend
                            </button>
                            <button onclick="bulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-lg text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">delete</span> Delete
                            </button>
                            <button onclick="clearSelection()" class="h-8 px-4 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const isSuperAdminUser = <%= isSuperAdmin ? 'true' : 'false' %>;
        const selectedItems = new Set();

        function toggleSelectAll() {
            const selectAll = document.getElementById('selectAll');
            selectAllRows(selectAll.checked);
        }

        function selectAllRows(force) {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = force;
                if (force) selectedItems.add(cb.value);
                else selectedItems.delete(cb.value);
            });
            const selectAllCb = document.getElementById('selectAll');
            if (selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }

        function toggleRowSelection(id) {
            const cb = document.getElementById(`cb-${id}`);
            if (cb) {
                cb.checked = !cb.checked;
                updateSelection(cb);
            }
        }

        function updateSelection(cb) {
            if (cb.checked) selectedItems.add(cb.value);
            else selectedItems.delete(cb.value);
            
            const selectAllCb = document.getElementById('selectAll');
            if (selectAllCb) {
                const totalCheckboxes = document.querySelectorAll('.user-checkbox').length;
                selectAllCb.checked = totalCheckboxes === selectedItems.size && totalCheckboxes > 0;
            }
            updateBulkUI();
        }

        function updateBulkUI() {
            const bulkBar = document.getElementById('bulkBar');
            const countLabel = document.getElementById('selectedCount');
            
            if (selectedItems.size > 0) {
                bulkBar.classList.remove('hidden');
                setTimeout(() => {
                    bulkBar.classList.remove('translate-y-10', 'opacity-0');
                }, 10);
                countLabel.innerText = selectedItems.size;
            } else {
                bulkBar.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => {
                    bulkBar.classList.add('hidden');
                }, 300);
            }
        }

        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
            const selectAllCb = document.getElementById('selectAll');
            if (selectAllCb) selectAllCb.checked = false;
            updateBulkUI();
        }

        async function bulkAction(type) {
            const ids = Array.from(selectedItems);
            if (ids.length === 0) return;

            const confirm = await Swal.fire({
                title: 'Confirm Bulk Action',
                text: `Are you sure you want to ${type} ${ids.length} users?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: type === 'delete' ? '#f43f5e' : '#3b82f6',
                confirmButtonText: `Yes, ${type}`
            });

            if (confirm.isConfirmed) {
                try {
                    const response = await fetch('/admin/users/bulk', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: ids, action: type })
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Success', 'Bulk action completed', 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', data.error || 'Action failed', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Network error', 'error');
                }
            }
        }

        async function openRoleModal(id, currentRole) {
            const adminOption = isSuperAdminUser ? `<option value="admin" ${currentRole === 'admin' ? 'selected' : ''}>Administrator</option>` : '';
            const superAdminOption = isSuperAdminUser ? `<option value="superadmin" ${currentRole === 'superadmin' ? 'selected' : ''}>Super Administrator</option>` : '';
            
            const { value: newRole } = await Swal.fire({
                title: '<p class="text-[15px] font-black tracking-tight">Assign New Role</p>',
                html: `
                    <div class="relative mt-4">
                        <select id="roleSelect" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-violet-500 appearance-none transition-all">
                            <option value="student" ${currentRole === 'student' ? 'selected' : ''}>Student</option>
                            <option value="teacher" ${currentRole === 'teacher' ? 'selected' : ''}>Instructor</option>
                            <option value="guardian" ${currentRole === 'guardian' ? 'selected' : ''}>Guardian</option>
                            ${adminOption}
                            ${superAdminOption}
                        </select>
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">unfold_more</span>
                    </div>
                `,
                preConfirm: () => {
                    return document.getElementById('roleSelect').value;
                },
                showCancelButton: true,
                confirmButtonText: 'Update Role',
                confirmButtonColor: '#8b5cf6',
                customClass: {
                    popup: 'rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl',
                    confirmButton: 'rounded-lg px-6 py-2.5 text-xs font-bold'
                }
            });

            if (newRole && newRole !== currentRole) {
                updateUser(id, { role: newRole });
            }
        }

        async function openStatusModal(id, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'suspended' : 'active';
            const confirm = await Swal.fire({
                title: `<p class="text-[15px] font-black tracking-tight">${newStatus === 'suspended' ? 'Suspend' : 'Activate'} User?</p>`,
                text: `This user will ${newStatus === 'suspended' ? 'no longer' : 'now'} be able to access the platform.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: `Yes, ${newStatus}`,
                confirmButtonColor: newStatus === 'suspended' ? '#f59e0b' : '#10b981'
            });

            if (confirm.isConfirmed) {
                updateUser(id, { status: newStatus });
            }
        }

        async function resetPw(id) {
            const confirm = await Swal.fire({
                title: 'Reset Password?',
                text: "A new random password will be generated and sent to the user via email automatically.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Reset'
            });

            if (confirm.isConfirmed) {
                updateUser(id, { action: 'reset_password' });
            }
        }

        async function confirmDelete(id, name) {
            const confirm = await Swal.fire({
                title: `<p class="text-[15px] font-black tracking-tight">Delete ${name}?</p>`,
                text: 'This action is permanent and cannot be undone.',
                icon: 'error',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete Permanently',
                confirmButtonColor: '#f43f5e'
            });

            if (confirm.isConfirmed) {
                window.location.href = `/admin/users/${id}/delete`;
            }
        }

        async function updateUser(id, data) {
            try {
                const response = await fetch(`/admin/users/${id}/update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({ icon: 'success', title: 'Updated', timer: 1000, showConfirmButton: false });
                    setTimeout(() => location.reload(), 1000);
                } else {
                    Swal.fire('Error', result.error || 'Update failed', 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Network error', 'error');
            }
        }

        function toggleAdminSidebar() { 
            const sidebar = document.getElementById('adminSidebar');
            sidebar.classList.toggle('-translate-x-full');
        }
    </script>
</body>

</html>
