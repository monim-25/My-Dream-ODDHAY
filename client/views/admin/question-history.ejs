<% include ../partials/header %>
<div class="container-fluid">
  <h3 class="mb-3">Question History</h3>
  <% if (questions.length === 0) { %>
    <div class="alert alert-info">No questions found.</div>
  <% } else { %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Question Text</th>
          <th>Added By</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody>
        <% questions.forEach(function(q) { %>
          <tr>
            <td><%= q.questionText.length > 70 ? q.questionText.substring(0,70)+'...' : q.questionText %></td>
            <td><%= q.addedBy?.name || 'Unknown' %></td>
            <td><%= new Date(q.createdAt).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<!-- Footer removed -->
