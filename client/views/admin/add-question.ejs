<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Compose Matrix | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; transition: all 0.3s ease; }
        @media (max-width: 1024px) { .admin-main { margin-left: 0; } }
        .q-row { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100] lg:translate-x-0 -translate-x-full">
            <%- include('sidebar_content', { active: locals.active || 'question-details' }) %>
        </aside>

        <main class="admin-main flex-1 flex flex-col">
            <%- include('header_v2', { pageTitle: mode === 'archive' ? 'Archive Composition Studio' : 'History Composition Studio' }) %>

            <div class="flex-1 p-8 bg-[#F8FAFC] dark:bg-[#020617]">
                <div class="max-w-4xl mx-auto">
                    <form action="/admin/add-question-full" method="POST" enctype="multipart/form-data" class="space-y-6">
                        
                        <!-- Global Metadata Header (Visible in Archive Mode) -->
                        <div id="archiveGlobalHeader" class="hidden animate-slide-up mb-8">
                            <div class="bg-white dark:bg-[#0f172a] rounded-[2rem] p-8 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/5">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
                                        <span class="material-symbols-rounded text-primary text-xl">archive</span>
                                    </div>
                                    <div>
                                        <h4 class="text-[15px] font-black text-slate-900 dark:text-white tracking-tight leading-none">Archive metadata</h4>
                                        <p class="text-[11px] font-bold text-slate-500 mt-1.5">Applies to all questions</p>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                                    <!-- Board -->
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Board</label>
                                        <input type="text" name="board" id="globalBoard" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all" placeholder="e.g. Dhaka Board">
                                    </div>
                                    <!-- Year -->
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Year</label>
                                        <input type="number" name="year" id="globalYear" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all" placeholder="2024">
                                    </div>
                                    <!-- Subject -->
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Subject</label>
                                        <input type="text" name="subject" id="globalSubject" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all" placeholder="e.g. Physics">
                                    </div>
                                    <!-- Class -->
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Class</label>
                                        <select name="classLevel" id="globalClass" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all cursor-pointer">
                                            <option value="">Select Class</option>
                                            <% [6,7,8,9,10,11,12].forEach(c => { %>
                                                <option value="<%= c %>">Class <%= c %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <!-- File -->
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Source PDF</label>
                                        <label class="flex items-center gap-2 h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition-all group overflow-hidden">
                                            <span class="material-symbols-rounded text-slate-400 group-hover:text-primary transition-colors text-[18px]">attach_file</span>
                                            <span id="fileNameLabel" class="text-[11px] font-bold text-slate-500 truncate flex-1">Attach Paper</span>
                                            <input type="file" name="file" class="hidden" onchange="document.getElementById('fileNameLabel').innerText = this.files[0].name; document.getElementById('fileNameLabel').classList.remove('text-slate-500'); document.getElementById('fileNameLabel').classList.add('text-primary');">
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="mode" id="studioMode" value="standalone">
                        <div id="hiddenMetaFields">
                            <!-- Hidden Metadata (Still needed for non-archive mode or legacy) -->
                            <input type="hidden" name="classLevel" value="" id="hiddenClass">
                            <input type="hidden" name="isBoardQuestion" value="on">
                            <input type="hidden" name="accessType" value="Free">
                            <input type="hidden" name="bankId" value="">
                            
                            <!-- In Standalone mode, these are synced from wizard -->
                            <input type="hidden" name="board" value="" id="hiddenBoard">
                            <input type="hidden" name="year" value="" id="hiddenYear">
                            <input type="hidden" name="subject" value="" id="hiddenSubject">
                        </div>

                        <!-- Studio Header -->
                        <div class="flex items-center justify-between mb-8 px-4">
                            <div class="flex items-center gap-4">
                                <div>
                                    <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight"><%= mode === 'archive' ? 'Archive composition' : 'History composition' %></h3>
                                    <p class="text-[11px] font-bold text-slate-500 mt-0.5"><%= mode === 'archive' ? 'Adding questions to board papers' : 'Adding individual questions to library' %></p>
                                </div>
                            </div>
                            <div id="draftStatusBadge" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 px-3.5 py-1.5 rounded-full border border-emerald-200 dark:border-emerald-500/20 flex items-center gap-2 transition-all">
                                <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>Draft auto-saved</span>
                            </div>
                        </div>

                        <!-- Bulk Question Container -->
                        <div id="questionsContainer" class="space-y-6">
                            <!-- Question rows will be injected here -->
                        </div>

                        <!-- Addition Controls -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-2xl p-6 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/5 flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="flex items-center h-11 bg-slate-100 dark:bg-slate-800 rounded-xl overflow-hidden">
                                    <input type="number" id="bulkAddCount" value="1" min="1" max="50" class="w-16 h-full pl-4 bg-transparent text-sm font-bold text-slate-700 dark:text-slate-200 outline-none">
                                    <div class="w-px h-5 bg-slate-300 dark:bg-slate-600 mx-1 flex-shrink-0"></div>
                                    <select id="bulkAddType" class="h-full pr-3 pl-2 bg-transparent text-[11px] font-bold text-slate-600 dark:text-slate-300 outline-none cursor-pointer">
                                        <option value="MCQ">MCQ slots</option>
                                        <option value="Short">Short answer</option>
                                        <option value="Medium">Medium complexity</option>
                                        <option value="Comprehension">Comprehension</option>
                                    </select>
                                </div>
                                <button type="button" onclick="addQuestionRows()" class="h-11 px-5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-[11px] font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-2 flex-shrink-0">
                                    <span class="material-symbols-rounded flex-shrink-0" style="font-size:18px">add_box</span> Append slots
                                </button>
                            </div>
                            
                            <div class="flex items-center gap-4">
                                <a href="/admin/question-details" class="text-[11px] font-bold text-slate-400 hover:text-slate-600 transition-all">Discard studio</a>
                                <button type="submit" class="h-12 px-10 bg-slate-900 text-white rounded-lg font-bold text-[12px] shadow-xl shadow-slate-900/10 hover:bg-black transition-all active:scale-95">Add question</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <template id="questionTemplate">
        <div class="question-row bg-white dark:bg-[#0f172a] rounded-[2rem] p-8 border border-slate-100 dark:border-white/5 shadow-lg animate-slide-up relative">
            
            <!-- Hidden Fields -->
            <input type="hidden" name="qType[]" value="MCQ">
            <input type="hidden" name="qTopic[]" value="">

            <!-- Row Header -->
            <div class="flex items-center justify-between mb-6">
                <span class="text-[14px] font-black text-slate-900 dark:text-white flex-shrink-0"><span class="q-index">1</span> • <span class="q-type-label">MCQ</span></span>

                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-[12px] font-bold text-slate-800 dark:text-slate-200">Marks</span>
                        <input type="number" name="qMarks[]" value="1" min="1" max="100" class="w-16 h-8 px-2.5 bg-[#F8FAFC] dark:bg-slate-900 border border-[#E2E8F0] dark:border-slate-600 rounded-md text-[12px] font-bold text-slate-900 dark:text-white outline-none focus:border-slate-400 dark:focus:border-white shadow-sm">
                    </div>
                    <div class="flex items-center gap-3 individual-meta">
                        <div class="flex items-center gap-2">
                            <span class="text-[12px] font-bold text-slate-800 dark:text-slate-200">Board</span>
                            <input type="text" name="qBoard[]" class="w-24 h-8 px-3 bg-[#F8FAFC] dark:bg-slate-900 border border-[#E2E8F0] dark:border-slate-600 rounded-md text-[12px] font-bold text-slate-900 dark:text-white outline-none focus:border-slate-400 dark:focus:border-white shadow-sm">
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[12px] font-bold text-slate-800 dark:text-slate-200">Year</span>
                            <input type="number" name="qYear[]" class="w-24 h-8 px-3 bg-[#F8FAFC] dark:bg-slate-900 border border-[#E2E8F0] dark:border-slate-600 rounded-md text-[12px] font-bold text-slate-900 dark:text-white outline-none focus:border-slate-400 dark:focus:border-white shadow-sm">
                        </div>
                    </div>
                    <button type="button" onclick="removeRow(this)" class="size-9 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all shadow-sm">
                        <span class="material-symbols-rounded" style="font-size:18px">delete</span>
                    </button>
                </div>
            </div>

            <!-- Question Text -->
            <div class="space-y-2 mb-5">
                <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Question content</label>
                <textarea name="qText[]" required placeholder="Compose question here..." class="w-full p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[14px] font-bold outline-none focus:border-slate-900 dark:focus:border-white transition-all leading-relaxed resize-none" rows="2"></textarea>
            </div>

            <!-- MCQ Options Area -->
            <div class="mcq-area space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3 group">
                        <span class="size-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-[10px] font-black text-slate-500 flex-shrink-0 group-focus-within:bg-slate-900 group-focus-within:text-white transition-all">A</span>
                        <input type="text" name="qOptions[]" placeholder="Option A" class="flex-1 h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-slate-900 dark:focus:border-white transition-all">
                    </div>
                    <div class="flex items-center gap-3 group">
                        <span class="size-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-[10px] font-black text-slate-500 flex-shrink-0 group-focus-within:bg-slate-900 group-focus-within:text-white transition-all">B</span>
                        <input type="text" name="qOptions[]" placeholder="Option B" class="flex-1 h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-slate-900 dark:focus:border-white transition-all">
                    </div>
                    <div class="flex items-center gap-3 group">
                        <span class="size-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-[10px] font-black text-slate-500 flex-shrink-0 group-focus-within:bg-slate-900 group-focus-within:text-white transition-all">C</span>
                        <input type="text" name="qOptions[]" placeholder="Option C" class="flex-1 h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-slate-900 dark:focus:border-white transition-all">
                    </div>
                    <div class="flex items-center gap-3 group">
                        <span class="size-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-[10px] font-black text-slate-500 flex-shrink-0 group-focus-within:bg-slate-900 group-focus-within:text-white transition-all">D</span>
                        <input type="text" name="qOptions[]" placeholder="Option D" class="flex-1 h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold outline-none focus:border-slate-900 dark:focus:border-white transition-all">
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1 flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-emerald-500" style="font-size:16px">check_circle</span>
                        Correct solution
                    </label>
                    <select name="qCorrectIndex[]" class="w-full h-11 px-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-bold text-slate-700 dark:text-slate-200 outline-none focus:border-emerald-400 cursor-pointer transition-all">
                        <option value="0">Option A</option>
                        <option value="1">Option B</option>
                        <option value="2">Option C</option>
                        <option value="3">Option D</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Explanation <span class="text-slate-300">(Optional)</span></label>
                    <textarea name="qExplanation[]" placeholder="Why is this the correct answer?" class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] text-slate-600 dark:text-slate-400 outline-none focus:border-slate-900 transition-all resize-none" rows="2"></textarea>
                </div>
            </div>

            <!-- Short / Medium / Comprehension Answer Area -->
            <div class="answer-area hidden space-y-5">
                <div class="space-y-2">
                    <label class="text-[11px] font-bold text-emerald-600 ml-1">Model solution <span class="text-emerald-400/60">(Mandatory)</span></label>
                    <textarea name="qAnswer[]" placeholder="Provide the model answer or solution..." class="w-full p-4 rounded-xl bg-emerald-500/5 border border-emerald-500/10 text-[13px] font-bold outline-none focus:border-emerald-400 transition-all resize-none" rows="2"></textarea>
                </div>
                <div class="space-y-2">
                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Explanation <span class="text-slate-300">(Optional)</span></label>
                    <textarea name="qExplanation[]" placeholder="Add context, hints, or further explanation..." class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] text-slate-600 dark:text-slate-400 outline-none focus:border-slate-900 transition-all resize-none" rows="2"></textarea>
                </div>
            </div>

        </div>
    </template>

    <script>
        function getDefaultMarks(type) {
            if (type === 'Medium') return 2;
            if (type === 'Comprehension') return 10;
            return 1; // MCQ & Short
        }

        const DRAFT_KEY_BASE = 'oddhay_admin_question_studio_draft';

        function getDraftStorageKey() {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';
            const bankId = urlParams.get('bankId') || '';
            const subject = urlParams.get('subject') || '';
            return `${DRAFT_KEY_BASE}_${mode}_${bankId}_${subject}`;
        }

        function saveStudioDraft() {
            try {
                const key = getDraftStorageKey();
                const urlParams = new URLSearchParams(window.location.search);
                const mode = urlParams.get('mode') || 'standalone';

                const draft = {
                    mode,
                    globalMeta: {},
                    questions: []
                };

                if (mode === 'archive') {
                    const boardEl = document.getElementById('globalBoard');
                    const yearEl = document.getElementById('globalYear');
                    const subjectEl = document.getElementById('globalSubject');
                    const classEl = document.getElementById('globalClass');

                    if (boardEl) draft.globalMeta.board = boardEl.value;
                    if (yearEl) draft.globalMeta.year = yearEl.value;
                    if (subjectEl) draft.globalMeta.subject = subjectEl.value;
                    if (classEl) draft.globalMeta.classLevel = classEl.value;
                }

                document.querySelectorAll('.question-row').forEach(row => {
                    const typeInput = row.querySelector('input[name="qType[]"]');
                    const textInput = row.querySelector('textarea[name="qText[]"]');
                    const marksInput = row.querySelector('input[name="qMarks[]"]');
                    const type = typeInput ? typeInput.value : 'MCQ';

                    const qData = {
                        type,
                        text: textInput ? textInput.value : '',
                        marks: marksInput ? marksInput.value : getDefaultMarks(type),
                        options: [],
                        correctIndex: 0,
                        answer: '',
                        explanation: '',
                        board: '',
                        year: ''
                    };

                    if (type === 'MCQ') {
                        const optInputs = row.querySelectorAll('.mcq-area input[name="qOptions[]"]');
                        optInputs.forEach(opt => qData.options.push(opt.value));
                        const correctSelect = row.querySelector('.mcq-area select[name="qCorrectIndex[]"]');
                        if (correctSelect) qData.correctIndex = correctSelect.value;
                        const expText = row.querySelector('.mcq-area textarea[name="qExplanation[]"]');
                        if (expText) qData.explanation = expText.value;
                    } else {
                        const ansText = row.querySelector('.answer-area textarea[name="qAnswer[]"]');
                        if (ansText) qData.answer = ansText.value;
                        const expText = row.querySelector('.answer-area textarea[name="qExplanation[]"]');
                        if (expText) qData.explanation = expText.value;
                    }

                    const boardInput = row.querySelector('input[name="qBoard[]"]');
                    const yearInput = row.querySelector('input[name="qYear[]"]');
                    if (boardInput) qData.board = boardInput.value;
                    if (yearInput) qData.year = yearInput.value;

                    draft.questions.push(qData);
                });

                if (draft.questions.length > 0) {
                    localStorage.setItem(key, JSON.stringify(draft));
                    const badge = document.getElementById('draftStatusBadge');
                    if (badge) badge.classList.remove('hidden');
                }
            } catch (err) {
                console.error('Failed to save draft:', err);
            }
        }

        function restoreStudioDraft() {
            try {
                const key = getDraftStorageKey();
                const rawData = localStorage.getItem(key);
                if (!rawData) return false;

                const draft = JSON.parse(rawData);
                if (!draft || !draft.questions || draft.questions.length === 0) return false;

                if (draft.globalMeta) {
                    if (draft.globalMeta.board && document.getElementById('globalBoard')) document.getElementById('globalBoard').value = draft.globalMeta.board;
                    if (draft.globalMeta.year && document.getElementById('globalYear')) document.getElementById('globalYear').value = draft.globalMeta.year;
                    if (draft.globalMeta.subject && document.getElementById('globalSubject')) document.getElementById('globalSubject').value = draft.globalMeta.subject;
                    if (draft.globalMeta.classLevel && document.getElementById('globalClass')) document.getElementById('globalClass').value = draft.globalMeta.classLevel;
                }

                const container = document.getElementById('questionsContainer');
                container.innerHTML = '';

                draft.questions.forEach(qData => {
                    addSingleQuestionFromDraft(qData);
                });

                updateIndices();
                const badge = document.getElementById('draftStatusBadge');
                if (badge) badge.classList.remove('hidden');
                return true;
            } catch (err) {
                console.error('Failed to restore draft:', err);
                return false;
            }
        }

        function addSingleQuestionFromDraft(qData) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            const clone = template.content.cloneNode(true);
            const row = clone.querySelector('.question-row');

            toggleTypeUI(row, qData.type, true);

            const textInput = row.querySelector('textarea[name="qText[]"]');
            if (textInput) textInput.value = qData.text || '';

            const marksInput = row.querySelector('input[name="qMarks[]"]');
            if (marksInput) marksInput.value = qData.marks || getDefaultMarks(qData.type);

            if (qData.type === 'MCQ') {
                const optInputs = row.querySelectorAll('.mcq-area input[name="qOptions[]"]');
                (qData.options || []).forEach((optVal, idx) => {
                    if (optInputs[idx]) optInputs[idx].value = optVal || '';
                });
                const correctSelect = row.querySelector('.mcq-area select[name="qCorrectIndex[]"]');
                if (correctSelect) correctSelect.value = qData.correctIndex || 0;
                const expText = row.querySelector('.mcq-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';
            } else {
                const ansText = row.querySelector('.answer-area textarea[name="qAnswer[]"]');
                if (ansText) ansText.value = qData.answer || '';
                const expText = row.querySelector('.answer-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';
            }

            const boardInput = row.querySelector('input[name="qBoard[]"]');
            const yearInput = row.querySelector('input[name="qYear[]"]');
            if (boardInput && qData.board) boardInput.value = qData.board;
            if (yearInput && qData.year) yearInput.value = qData.year;

            if (mode === 'archive') {
                const indMeta = row.querySelector('.individual-meta');
                if (indMeta) indMeta.classList.add('hidden');
            }

            container.appendChild(clone);
        }

        function clearStudioDraft() {
            try {
                const key = getDraftStorageKey();
                localStorage.removeItem(key);
            } catch (e) {}
        }

        window.onload = () => {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';
            
            if (urlParams.has('class')) {
                const hiddenClass = document.querySelector('input[name="classLevel"]');
                if (hiddenClass) hiddenClass.value = urlParams.get('class');
            }
            if (urlParams.has('bankId')) {
                const hiddenBank = document.querySelector('input[name="bankId"]');
                if (hiddenBank) hiddenBank.value = urlParams.get('bankId');
            }
            
            if (mode === 'archive') {
                document.getElementById('studioMode').value = 'archive';
                document.getElementById('archiveGlobalHeader').classList.remove('hidden');
                const hiddenMeta = document.getElementById('hiddenMetaFields');
                if (hiddenMeta) hiddenMeta.remove(); 
                
                if (urlParams.has('board')) document.getElementById('globalBoard').value = urlParams.get('board');
                if (urlParams.has('year')) document.getElementById('globalYear').value = urlParams.get('year');
                if (urlParams.has('subject')) document.getElementById('globalSubject').value = urlParams.get('subject');
                if (urlParams.has('class')) document.getElementById('globalClass').value = urlParams.get('class');
            } else {
                document.getElementById('studioMode').value = 'standalone';
                const globalHeader = document.getElementById('archiveGlobalHeader');
                if (globalHeader) globalHeader.remove();
                
                if (urlParams.has('board')) document.getElementById('hiddenBoard').value = urlParams.get('board');
                if (urlParams.has('year')) document.getElementById('hiddenYear').value = urlParams.get('year');
                if (urlParams.has('subject')) document.getElementById('hiddenSubject').value = urlParams.get('subject');
                if (urlParams.has('class')) document.getElementById('hiddenClass').value = urlParams.get('class');
            }

            const restored = restoreStudioDraft();
            if (!restored) {
                addQuestionRows(urlParams.get('count') || 1, urlParams.get('type') || 'MCQ');
            }

            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('input', saveStudioDraft);
                form.addEventListener('change', saveStudioDraft);
                form.addEventListener('submit', () => {
                    clearStudioDraft();
                });
            }
        };

        function toggleTypeUI(row, type, preserveCustomMarks = false) {
            const mcq = row.querySelector('.mcq-area');
            const answer = row.querySelector('.answer-area');
            const typeLabel = row.querySelector('.q-type-label');
            const marksInput = row.querySelector('input[name="qMarks[]"]');
            
            typeLabel.innerText = type;
            row.querySelector('input[name="qType[]"]').value = type;

            if (!preserveCustomMarks && marksInput) {
                marksInput.value = getDefaultMarks(type);
            }

            if(type === 'MCQ') {
                mcq.classList.remove('hidden');
                answer.classList.add('hidden');
            } else {
                mcq.classList.add('hidden');
                answer.classList.remove('hidden');
            }
            saveStudioDraft();
        }

        function addQuestionRows(count = null, type = null) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            const num = count || parseInt(document.getElementById('bulkAddCount').value) || 1;
            const qType = type || document.getElementById('bulkAddType').value;

            for (let i = 0; i < num; i++) {
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('.question-row');
                
                toggleTypeUI(row, qType);
                
                if (mode === 'archive') {
                    const indMeta = row.querySelector('.individual-meta');
                    if (indMeta) indMeta.classList.add('hidden');
                }

                container.appendChild(clone);
            }
            updateIndices();
            saveStudioDraft();
        }

        function removeRow(btn) {
            btn.closest('.question-row').remove();
            updateIndices();
            saveStudioDraft();
        }

        function updateIndices() {
            document.querySelectorAll('.question-row').forEach((row, i) => {
                row.querySelector('.q-index').innerText = i + 1;
            });
        }
    </script>
</body>
</html>
