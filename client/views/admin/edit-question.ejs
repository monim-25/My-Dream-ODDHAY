<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Edit Intelligence | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; transition: all 0.3s ease; }
        @media (max-width: 1024px) { .admin-main { margin-left: 0; } }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100] lg:translate-x-0 -translate-x-full">
            <%- include('sidebar_content', { active: 'question-details' }) %>
        </aside>

        <main class="admin-main flex-1 flex flex-col">
            <%- include('header_v2', { pageTitle: 'Edit Intelligence' }) %>

            <div class="flex-1 p-8">
                <div class="max-w-4xl mx-auto">
                    <form action="/admin/edit-question/<%= question._id %>" method="POST" class="space-y-6">
                        
                        <!-- Metadata Cluster -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-[2rem] p-8 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/5">
                            <div class="flex items-center gap-3 mb-8">
                                <div class="size-10 rounded-2xl bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary">database</span>
                                </div>
                                <div>
                                    <h4 class="text-[15px] font-black text-slate-900 dark:text-white tracking-tight">Core Metadata</h4>
                                    <p class="text-[11px] font-bold text-slate-500">Academic & classification settings</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Board / Exam</label>
                                    <input type="text" name="board" value="<%= question.board %>" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all" placeholder="e.g. Dhaka Board">
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Year</label>
                                    <input type="number" name="year" value="<%= question.year %>" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all" placeholder="2024">
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Subject</label>
                                    <select name="subject" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all">
                                        <% ['Physics','Chemistry','Biology','Higher Mathematics','General Mathematics','Bangla','English','ICT','Accounting','Business Organization','Finance & Banking','Economics'].forEach(s => { %>
                                            <option value="<%= s %>" <%= question.subject === s ? 'selected' : '' %>><%= s %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Class</label>
                                    <select name="classLevel" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all">
                                        <% [6,7,8,9,10,11,12].forEach(c => { %>
                                            <option value="<%= c %>" <%= question.classLevel == c ? 'selected' : '' %>>Class <%= c %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Access</label>
                                    <select name="accessType" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all">
                                        <option value="Free" <%= question.accessType === 'Free' ? 'selected' : '' %>>Free</option>
                                        <option value="Paid" <%= question.accessType === 'Paid' ? 'selected' : '' %>>Paid</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Content Hub -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-[2rem] p-8 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/5">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Complexity</label>
                                    <select name="questionType" id="qTypeSelect" onchange="toggleTypeUI(this.value)" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all">
                                        <option value="MCQ" <%= question.questionType === 'MCQ' ? 'selected' : '' %>>MCQ</option>
                                        <option value="Short" <%= question.questionType === 'Short' ? 'selected' : '' %>>Short Answer</option>
                                        <option value="Medium" <%= question.questionType === 'Medium' ? 'selected' : '' %>>Medium</option>
                                        <option value="Comprehension" <%= question.questionType === 'Comprehension' ? 'selected' : '' %>>Comprehension</option>
                                    </select>
                                </div>
                                <div class="space-y-2 md:col-span-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Topic / Chapter</label>
                                    <input type="text" name="topic" value="<%= question.topic %>" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all" placeholder="e.g. Thermodynamics">
                                </div>
                            </div>

                            <div class="space-y-6">
                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Question Vector</label>
                                    <textarea name="questionText" required class="w-full p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary leading-relaxed" rows="4"><%= question.questionText %></textarea>
                                </div>

                                <!-- MCQ Matrix -->
                                <div id="mcqArea" class="<%= question.questionType !== 'MCQ' ? 'hidden' : '' %> space-y-6 animate-slide-up">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <% ['A','B','C','D'].forEach((label, i) => { %>
                                            <div class="space-y-1.5">
                                                <label class="text-[10px] font-black text-slate-400 uppercase ml-1">Option <%= label %></label>
                                                <input type="text" name="option<%= label %>" value="<%= question.options && question.options[i] ? question.options[i] : '' %>" class="w-full h-11 px-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-primary transition-all">
                                            </div>
                                        <% }) %>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Correct Answer Index</label>
                                        <select name="correctAnswerIndex" class="w-full h-11 px-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm font-bold outline-none focus:border-emerald-500 transition-all cursor-pointer">
                                            <% ['A','B','C','D'].forEach((l, i) => { %>
                                                <option value="<%= i %>" <%= question.correctAnswerIndex == i ? 'selected' : '' %>>Option <%= l %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <!-- Non-MCQ Vector -->
                                <div id="answerArea" class="<%= question.questionType === 'MCQ' ? 'hidden' : '' %> space-y-2 animate-slide-up">
                                    <label class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 ml-1">Model Solution</label>
                                    <textarea name="correctAnswer" class="w-full p-5 rounded-2xl bg-emerald-50/30 dark:bg-emerald-500/5 border border-emerald-100 dark:border-emerald-500/20 text-sm font-bold text-emerald-900 dark:text-emerald-200 outline-none focus:border-emerald-500" rows="3" placeholder="Provide verified solution..."><%= question.correctAnswer %></textarea>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-[11px] font-bold text-slate-900 dark:text-slate-200 ml-1">Expert Explanation</label>
                                    <textarea name="explanation" class="w-full p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-sm font-medium outline-none focus:border-primary leading-relaxed" rows="2" placeholder="Add logic or reasoning..."><%= question.explanation %></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Action Bar -->
                        <div class="flex items-center justify-between px-4 py-2">
                            <a href="/admin/question-details" class="text-xs font-bold text-slate-400 hover:text-rose-500 transition-all flex items-center gap-2">
                                <span class="material-symbols-rounded text-sm">keyboard_backspace</span>
                                Back to Library
                            </a>
                            <div class="flex items-center gap-3">
                                <button type="reset" class="h-11 px-6 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">Reset</button>
                                <button type="submit" class="h-11 px-10 bg-slate-900 dark:bg-white dark:text-slate-900 text-white rounded-xl font-black text-[11px] uppercase tracking-widest hover:opacity-90 transition-all shadow-xl shadow-slate-900/10 active:scale-95">Commit Revision</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleTypeUI(type) {
            const mcq = document.getElementById('mcqArea');
            const answer = document.getElementById('answerArea');
            if(type === 'MCQ') {
                mcq.classList.remove('hidden');
                answer.classList.add('hidden');
            } else {
                mcq.classList.add('hidden');
                answer.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
