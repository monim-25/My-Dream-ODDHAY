<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Exam Center | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        .stat-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.75rem; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
        .dark .stat-card { background: #1e293b; border: 1px solid #334155; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }
        <% /* Helpers are now provided via res.locals in server.js */ %>
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-slide-up { animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'quizzes' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] flex flex-col h-screen overflow-hidden">
            <%- include('header_v2', { pageTitle: 'Exam Intelligence' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                <!-- Exam Stats Grid -->
                <!-- Exam Stats - Unified Container -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-blue-500 opacity-[0.05]">quiz</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-blue-500">quiz</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Exams</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= totalQuizzes %></h3>
                            </div>
                        </div>
                        <div onclick="window.location.href='?type=model'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.05]">psychology</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-amber-500">psychology</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Model Tests</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.modelTestCount || 0 %></h3>
                            </div>
                        </div>
                        <div onclick="window.location.href='?type=course'" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.05]">auto_stories</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-emerald-500">auto_stories</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Course Exams</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.courseExamCount || 0 %></h3>
                            </div>
                        </div>
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-purple-500 opacity-[0.05]">help</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-purple-500">help</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Question Pool</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.totalQuestions || 0 %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Exam Inventory -->
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Filters (Sticky) -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <!-- Search -->
                            <form action="" method="GET" class="relative flex-1 max-w-[400px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search exams..." class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                <input type="hidden" name="type" value="<%= filters.type %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                <input type="hidden" name="access" value="<%= filters.access %>">
                            </form>

                            <!-- Type Filter Dropdown -->
                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&class=<%= filters.class %>&access=<%= filters.access %>&type=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= (filters.type === 'all' || !filters.type) ? 'selected' : '' %>>All Types</option>
                                    <option value="model" <%= filters.type === 'model' ? 'selected' : '' %>>Model Test</option>
                                    <option value="course" <%= filters.type === 'course' ? 'selected' : '' %>>Course</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Subject Filter Dropdown -->
                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&access=<%= filters.access %>&subject=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.subject === 'all' ? 'selected' : '' %>>All Subject</option>
                                    <% (subjects || []).forEach(sub => { %>
                                        <option value="<%= sub %>" <%= filters.subject === sub ? 'selected' : '' %>><%= sub %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Class Filter Dropdown -->
                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&access=<%= filters.access %>&subject=<%= filters.subject %>&class=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= (filters.class === 'all' || !filters.class) ? 'selected' : '' %>>All Class</option>
                                    <% (globalAcademicClasses || []).forEach(cls => { 
                                        let val = cls.name.replace('Class ', '');
                                    %>
                                        <option value="<%= val %>" <%= typeof filters !== 'undefined' && filters.class === val ? 'selected' : '' %>><%= cls.name %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Access Filter Dropdown -->
                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&subject=<%= filters.subject %>&access=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.access === 'all' ? 'selected' : '' %>>All Access</option>
                                    <option value="Free" <%= filters.access === 'Free' ? 'selected' : '' %>>Free</option>
                                    <option value="Paid" <%= filters.access === 'Paid' ? 'selected' : '' %>>Paid</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Found Items Counter -->
                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all">
                                <span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalQuizzes %></span> Matches</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 ml-auto">
                            <button onclick="exportQuizzesToCSV()" class="h-10 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                            <% if (user.role !== 'superadmin' && user.email !== process.env.SUPER_ADMIN_EMAIL) { %>
                                <a href="/admin/quizzes?author=<%= user._id %>" class="h-10 px-4 rounded-lg <%= filters.author === user._id.toString() ? 'bg-primary/10 text-primary border-primary/30' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700' %> font-bold text-[10px] border transition-all flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-sm">person</span> My Exams
                                </a>
                                <a href="/admin/compose-quiz" class="h-10 px-4 rounded-lg bg-primary text-white font-bold text-[10px] shadow-lg shadow-primary/20 flex items-center gap-2 hover:bg-blue-600 transition-all">
                                    <span class="material-symbols-rounded text-sm">add_task</span> New Exam
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Exam Name</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Class</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Type</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Subject</th>
                                    <th class="px-1 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Course</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Questions</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Attempts</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Duration</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Author</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Access</th>
                                    <th class="pr-4 py-2 text-right text-[10px] font-bold text-slate-500 tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% quizzes.forEach(quiz => { 
                                    const isModelTest = !quiz.course;
                                %>
                                    <tr class="quiz-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group"
                                        data-title="<%= quiz.title.toLowerCase() %>"
                                        ondblclick="toggleRowSelection('<%= quiz._id %>')">
                                        <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= quiz._id %>" id="cb-<%= quiz._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-2">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center text-indigo-500 border border-indigo-100 dark:border-indigo-500/20 shadow-sm">
                                                    <span class="material-symbols-rounded text-lg">psychology</span>
                                                </div>
                                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight truncate max-w-[180px]"><%= quiz.title %></p>
                                            </div>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-600 dark:text-slate-400">
                                                <%= quiz.course ? quiz.course.classLevel : (quiz.classLevel || '---') %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2">
                                            <span class="text-[10px] font-bold <%= isModelTest ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400' %>">
                                                <%= isModelTest ? 'Model test' : 'Course' %>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate max-w-[150px]">
                                                <%= quiz.course ? formatText(quiz.course.subject) : (quiz.subject || '---') %>
                                            </p>
                                        </td>
                                        <td class="px-1 py-2">
                                            <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate max-w-[100px]">
                                                <%= quiz.course ? formatText(quiz.course.title) : '---' %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="inline-flex items-center justify-center size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[11px] font-bold border border-blue-100 dark:border-blue-500/20"><%= quiz.questions.length %></span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="inline-flex items-center justify-center size-8 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[11px] font-bold"><%= quiz.attemptsCount || 0 %></span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="text-[10px] font-bold text-slate-600 dark:text-slate-400"><%= quiz.duration %> min</span>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-600 dark:text-slate-400 truncate max-w-[120px]">
                                                <%= quiz.addedBy ? quiz.addedBy.name || quiz.addedBy.email || 'Unknown' : '---' %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <% if(quiz.accessType === 'Paid') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[9px] font-bold border border-rose-100 dark:border-rose-500/20"><span class="material-symbols-rounded text-[10px]">lock</span> Paid</span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20"><span class="material-symbols-rounded text-[10px]">lock_open</span> Free</span>
                                            <% } %>
                                        </td>
                                        <td class="pr-4 py-2">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <a href="/admin/quiz-details/<%= quiz._id %>" class="size-8 rounded-md bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Preview">
                                                    <span class="material-symbols-rounded text-[18px]">visibility</span>
                                                </a>
                                                <% if (user.role === 'superadmin' || (quiz.addedBy && quiz.addedBy._id.toString() === user._id.toString())) { %>
                                                    <a href="/admin/quiz/<%= quiz._id %>" class="size-8 rounded-md bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-primary transition-all flex items-center justify-center shadow-sm" title="Edit">
                                                        <span class="material-symbols-rounded text-[18px]">edit</span>
                                                    </a>
                                                <% } %>
                                                <button onclick="deleteQuiz('<%= quiz._id %>')" class="size-8 rounded-md bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Delete">
                                                    <span class="material-symbols-rounded text-[18px]">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (filters && filters.totalPages > 1) { %>
                        <div class="px-3 py-2 bg-white dark:bg-[#0f172a] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                            <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                            <div class="flex items-center gap-0.5">
                                <% for(var i=1; i<=filters.totalPages; i++) { %>
                                    <a href="?page=<%= i %>&type=<%= filters.type || 'all' %>&class=<%= filters.class || 'all' %>&subject=<%= filters.subject || 'all' %>&access=<%= filters.access || 'all' %>&q=<%= filters.q || '' %>&author=<%= filters.author || '' %>"
                                        class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold <% if(filters.page === i) { %> bg-primary text-white <% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 <% } %> transition-all">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Bulk Action Bar (Light Glassmorphic) -->
                    <div id="bulkActions" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-between z-50 animate-slide-up border border-slate-200 dark:border-slate-700 mx-4 rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                                </div>
                                <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <div class="flex items-center gap-3">
                                <button onclick="selectAllRows(true)" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select All</button>
                                <button onclick="selectByType('model')" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-amber-500 transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select Model</button>
                                <button onclick="selectByType('course')" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-emerald-500 transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select Course</button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="handleBulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-md text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20">Delete</button>
                            <button onclick="clearSelection()" class="h-8 px-4 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-md text-[10px] font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modals -->
    <% if (user.role==='admin' && (!process.env.SUPER_ADMIN_EMAIL || user.email !==process.env.SUPER_ADMIN_EMAIL)) { %>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();

        function toggleSelectAll() {
            const isChecked = document.getElementById('selectAll').checked;
            selectAllRows(isChecked);
        }

        function selectAllRows(force) {
            const cbs = document.querySelectorAll('.item-cb');
            cbs.forEach(cb => {
                cb.checked = force;
                if(force) selectedItems.add(cb.value);
                else selectedItems.delete(cb.value);
            });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }

        function toggleRowSelection(id) {
            const cb = document.getElementById(`cb-${id}`);
            if (cb) {
                cb.checked = !cb.checked;
                toggleSelection(cb);
            }
        }

        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value);
            else selectedItems.delete(el.value);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = document.querySelectorAll('.item-cb').length === selectedItems.size;
            updateBulkUI();
        }

        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) {
                bar.classList.remove('hidden');
                countEl.innerText = selectedItems.size;
            } else { bar.classList.add('hidden'); }
        }

        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkUI();
        }

        function selectByType(type) {
            const rows = document.querySelectorAll('.quiz-row');
            rows.forEach(row => {
                const typeText = row.querySelector('td:nth-child(3)').innerText.toLowerCase();
                const isModel = typeText.includes('model');
                if (type === 'model' && isModel) {
                    const cb = row.querySelector('.item-cb');
                    if(cb) { cb.checked = true; selectedItems.add(cb.value); }
                } else if (type === 'course' && !isModel) {
                    const cb = row.querySelector('.item-cb');
                    if(cb) { cb.checked = true; selectedItems.add(cb.value); }
                }
            });
            updateBulkUI();
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({
                title: 'Bulk Action',
                text: `Are you sure you want to ${action} ${selectedItems.size} exams?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec'
            });
            if (!res.isConfirmed) return;
            
            try {
                const response = await fetch('/admin/quizzes/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        function deleteQuiz(id) {
            Swal.fire({
                title: 'Delete Exam?',
                text: 'This quiz and all its questions will be removed forever.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, delete it'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    fetch(`/admin/quiz/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Deleted!', 'Exam removed.', 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Error', data.error || 'Failed to delete', 'error');
                            }
                        })
                        .catch(err => Swal.fire('Error', 'Network error', 'error'));
                }
            });
        }

        function exportQuizzesToCSV() {
            const rows = [['Exam Title', 'Type', 'Course', 'Questions', 'Attempts', 'Duration']];
            document.querySelectorAll('.quiz-row').forEach(row => {
                if (row.style.display !== 'none') {
                    const cells = row.querySelectorAll('td');
                    rows.push([
                        cells[1].querySelector('p').innerText,
                        cells[2].innerText.trim(),
                        cells[3].querySelector('p').innerText.trim(),
                        cells[4].querySelector('span').innerText,
                        cells[5].querySelector('span').innerText,
                        cells[6].querySelector('span').innerText
                    ]);
                }
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "odhay_exams.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
