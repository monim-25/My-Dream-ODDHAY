<header class="h-16 bg-white dark:bg-[#0b1120] flex items-center justify-between px-3 sm:px-4 border-b border-slate-200/80 dark:border-slate-800 sticky top-0 z-50 overflow-visible transition-all duration-300">
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <!-- Mobile Sidebar Toggle -->
        <button type="button" onclick="toggleAdminSidebar()" id="mobileMenuBtn"
            class="lg:hidden size-9 rounded-[10px] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 shadow-xs active:scale-95 transition-all">
            <span class="material-symbols-rounded text-[20px]">menu</span>
        </button>

        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <!-- Brand Logo -->
            <style>@import url('https://fonts.googleapis.com/css2?family=Debata&display=swap');</style>
            <a href="<%= (locals.user && user.role === 'admin') ? '/admin' : '/superadmin' %>" class="flex items-center select-none group shrink-0">
                <span class="text-[20px] font-bold leading-none tracking-wide" style="font-family:'Debata', 'Baloo 2', 'Baloo Da 2', Georgia, serif; color:#1a2b4a;" class="dark:text-slate-100">ODDHAY</span>
            </a>

            <!-- Smart Back Arrow Navigation Button -->
            <button type="button" id="adminNavBackBtn" onclick="handleAdminNavBack(event)"
                <% if (locals.backUrl) { %>data-back-url="<%= locals.backUrl %>"<% } %>
                class="hidden size-8 rounded-lg text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all items-center justify-center shrink-0 cursor-pointer active:scale-90 border border-slate-200/80 dark:border-slate-700/80"
                title="Go to previous page" aria-label="Go Back">
                <span class="material-symbols-rounded text-[18px] sm:text-[19px] leading-none pointer-events-none">arrow_back</span>
            </button>

            <!-- Separator + Page Title (Crisp Blackish Text) -->
            <% if (locals.pageTitle) { %>
            <div class="h-4.5 w-px bg-slate-200 dark:bg-slate-700 shrink-0"></div>
            <span id="adminHeaderPageTitle" class="text-xs sm:text-[13px] font-semibold text-slate-800 dark:text-slate-100 tracking-wide truncate select-none"><%- locals.pageTitle %></span>
            <% } %>
        </div>
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <% if (locals.extraContent) { %>
            <div class="flex items-center">
                <%- extraContent %>
            </div>
            <div class="h-6 w-px bg-slate-200 dark:bg-slate-800 mx-1"></div>
        <% } %>

        <div class="flex items-center gap-1.5 sm:gap-2">
            <!-- Direct Messages Link -->
            <a href="<%= (locals.user && user.role === 'admin') ? '/admin/messages' : '/superadmin/messages' %>"
                class="relative size-9 sm:size-10 rounded-[12px] flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all group cursor-pointer" title="Direct Messages">
                <span class="material-symbols-rounded text-[21px] sm:text-[23px] group-hover:scale-110 transition-transform">chat</span>
                <span id="msg-badge" class="absolute top-1.5 right-1.5 size-4 bg-blue-500 text-[10px] font-bold text-white rounded-full border-2 border-white dark:border-slate-900 shadow-xs flex items-center justify-center <%= (locals.unreadMessageCount > 0) ? '' : 'hidden' %>">
                    <%= locals.unreadMessageCount || 0 %>
                </span>
            </a>
            
            <!-- Notifications Dropdown Trigger -->
            <div class="relative flex items-center justify-center">
                <button type="button" id="notificationBtn" onclick="toggleNotifications(event)"
                    class="relative size-9 sm:size-10 rounded-[12px] flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all group cursor-pointer" title="Notifications">
                    <span class="material-symbols-rounded text-[21px] sm:text-[23px] group-hover:scale-110 transition-transform">notifications</span>
                    <span id="notif-badge" class="absolute top-2 right-2 size-2 bg-rose-500 rounded-full border border-white dark:border-slate-900 shadow-xs <%= (locals.unreadNotificationCount > 0) ? '' : 'hidden' %>"></span>
                </button>
                <%- include('../partials/notifications-dropdown') %>
            </div>
            
            <!-- Theme Toggle -->
            <button type="button" onclick="document.documentElement.classList.toggle('dark')"
                class="size-9 sm:size-10 rounded-[12px] flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all active:scale-95 overflow-visible">
                <span class="material-symbols-rounded text-[20px] sm:text-[22px] dark:hidden">dark_mode</span>
                <span class="material-symbols-rounded text-[20px] sm:text-[22px] hidden dark:block text-amber-400">light_mode</span>
            </button>
        </div>
    </div>
</header>

<script>
    (function() {
        // Mobile Sidebar Toggle
        window.toggleAdminSidebar = function() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) {
                sidebar.classList.toggle('active');
            }
        };

        // Universal Notifications Toggle
        window.toggleNotifications = function(e) {
            if (e && e.stopPropagation) e.stopPropagation();
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) {
                const isHidden = dropdown.classList.contains('hidden');
                if (isHidden) {
                    dropdown.classList.remove('hidden');
                    if (typeof window.fetchNotifications === 'function') window.fetchNotifications();
                } else {
                    dropdown.classList.add('hidden');
                }
            }
        };

        // Close notifications dropdown on outside click
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('notificationDropdown');
            const notifBtn = document.getElementById('notificationBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                if (!dropdown.contains(e.target) && (!notifBtn || !notifBtn.contains(e.target))) {
                    dropdown.classList.add('hidden');
                }
            }
        });

        // ==========================================
        // Admin Back Arrow Navigation Controller
        // ==========================================
        const ADMIN_STACK_KEY = 'oddhay_admin_nav_stack';
        const ADMIN_IS_BACK_KEY = 'oddhay_admin_nav_is_back';

        function initAdminNavStack() {
            try {
                const isBack = sessionStorage.getItem(ADMIN_IS_BACK_KEY) === 'true';
                sessionStorage.removeItem(ADMIN_IS_BACK_KEY);
                let stack = JSON.parse(sessionStorage.getItem(ADMIN_STACK_KEY) || '[]');
                const current = window.location.pathname + window.location.search;

                if (!isBack) {
                    if (stack.length === 0 || stack[stack.length - 1] !== current) {
                        stack.push(current);
                        if (stack.length > 20) stack.shift();
                        sessionStorage.setItem(ADMIN_STACK_KEY, JSON.stringify(stack));
                    }
                }
            } catch(e) {}
        }

        window.handleAdminNavBack = function(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            executeAdminBackNavigation();
        };

        function executeAdminBackNavigation() {
            const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/superadmin';
            const baseAdmin = currentPath.startsWith('/admin') ? '/admin' : '/superadmin';

            // 1. Explicit data-back-url on back button
            const backBtn = document.getElementById('adminNavBackBtn');
            if (backBtn && backBtn.getAttribute('data-back-url')) {
                const target = backBtn.getAttribute('data-back-url');
                if (target && target !== window.location.pathname) {
                    navigateAdminTo(target);
                    return;
                }
            }

            // 2. Query param ?from=
            try {
                const params = new URLSearchParams(window.location.search);
                const fromParam = params.get('from');
                if (fromParam) {
                    navigateAdminTo(fromParam.startsWith('/') ? fromParam : `${baseAdmin}/${fromParam}`);
                    return;
                }
            } catch(e) {}

            // 3. Navigation Stack
            try {
                let stack = JSON.parse(sessionStorage.getItem(ADMIN_STACK_KEY) || '[]');
                if (stack.length > 1) {
                    stack.pop(); // pop current page
                    const prev = stack.pop();
                    sessionStorage.setItem(ADMIN_STACK_KEY, JSON.stringify(stack));
                    if (prev) {
                        navigateAdminTo(prev);
                        return;
                    }
                }
            } catch(e) {}

            // 4. Same-origin Referrer
            if (document.referrer) {
                try {
                    const refUrl = new URL(document.referrer);
                    if (refUrl.origin === window.location.origin && refUrl.pathname !== window.location.pathname) {
                        sessionStorage.setItem(ADMIN_IS_BACK_KEY, 'true');
                        window.location.href = document.referrer;
                        return;
                    }
                } catch(e) {}
            }

            // 5. Logical Parent Fallback
            const parent = getAdminLogicalParentUrl(currentPath, baseAdmin);
            navigateAdminTo(parent);
        }

        function navigateAdminTo(url) {
            try {
                sessionStorage.setItem(ADMIN_IS_BACK_KEY, 'true');
            } catch(e) {}
            window.location.href = url;
        }

        function getAdminLogicalParentUrl(path, baseAdmin) {
            if (path.includes('/user/')) return `${baseAdmin}/users`;
            if (path.includes('/course/')) return `${baseAdmin}/courses`;
            if (path.includes('/note/')) return `${baseAdmin}/notes`;
            if (path.includes('/quiz/')) return `${baseAdmin}/quizzes`;
            if (path.includes('/payment/')) return `${baseAdmin}/payments`;
            if (path.includes('/topic')) return `${baseAdmin}/topics`;
            return baseAdmin;
        }

        function bindAdminNavBackButton() {
            const backBtn = document.getElementById('adminNavBackBtn');
            if (backBtn) {
                const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/superadmin';
                const isRoot = (currentPath === '/superadmin' || currentPath === '/superadmin/dashboard' || currentPath === '/admin' || currentPath === '/admin/dashboard');
                if (!isRoot) {
                    backBtn.classList.remove('hidden');
                    backBtn.classList.add('flex');
                } else {
                    backBtn.classList.add('hidden');
                    backBtn.classList.remove('flex');
                }
            }
        }

        initAdminNavStack();
        bindAdminNavBackButton();
        document.addEventListener('DOMContentLoaded', bindAdminNavBackButton);
    })();
</script>
