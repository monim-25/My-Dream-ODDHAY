<header class="h-16 bg-white dark:bg-[#0b1120] flex items-center justify-between px-2 sticky top-0 z-50 overflow-visible transition-all duration-300">
    <div class="flex items-center gap-4">
        <button type="button" onclick="toggleAdminSidebar()" id="mobileMenuBtn"
            class="lg:hidden size-9 rounded-[10px] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 shadow-sm active:scale-95 transition-all">
            <span class="material-symbols-rounded text-[20px]">menu</span>
        </button>
        <div class="flex items-center gap-3">
            <!-- Brand Logo -->
            <style>@import url('https://fonts.googleapis.com/css2?family=Debata&display=swap');</style>
            <a href="/admin" class="flex items-center select-none group">
                <!-- Wordmark only -->
                <span class="text-[20px] font-bold leading-none tracking-wide" style="font-family:'Debata', 'Baloo 2', 'Baloo Da 2', Georgia, serif; color:#1a2b4a;" class="dark:text-slate-100">ODDHAY</span>
            </a>
            <!-- Separator + Page Title -->
            <% if (locals.pageTitle) { %>
            <div class="h-5 w-px bg-slate-200 dark:bg-slate-700"></div>
            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 tracking-wide"><%- locals.pageTitle %></span>
            <% } %>
        </div>
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-4">
        <% if (locals.extraContent) { %>
            <div class="flex items-center">
                <%- extraContent %>
            </div>
            <div class="h-6 w-px bg-slate-200 dark:bg-slate-800 mx-1"></div>
        <% } %>

        <div class="flex items-center gap-2">
            <!-- Messages -->
            <button class="relative size-10 rounded-[12px] flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all group" title="Messages">
                <span class="material-symbols-rounded text-[23px] group-hover:scale-110 transition-transform">mail</span>
                <span id="msg-badge" class="absolute top-2 right-2 size-4 bg-blue-500 text-[10px] font-bold text-white rounded-full border border-white dark:border-slate-900 shadow-sm flex items-center justify-center <%= (locals.unreadMessageCount > 0) ? '' : 'hidden' %>">
                    <%= locals.unreadMessageCount || 0 %>
                </span>
            </button>
            
            <!-- Notifications -->
            <button class="relative size-10 rounded-[12px] flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all group" title="Notifications">
                <span class="material-symbols-rounded text-[23px] group-hover:scale-110 transition-transform">notifications</span>
                <span id="notif-badge" class="absolute top-2.5 right-2.5 size-2 bg-rose-500 rounded-full border border-white dark:border-slate-900 shadow-sm <%= (locals.unreadNotificationCount > 0) ? '' : 'hidden' %>"></span>
            </button>
            
            <!-- Theme Toggle - Fix Vertical Centering -->
            <button type="button" onclick="document.documentElement.classList.toggle('dark')"
                class="size-10 rounded-[12px] flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-primary transition-all active:scale-95 overflow-visible">
                <span class="material-symbols-rounded text-[22px] dark:hidden">dark_mode</span>
                <span class="material-symbols-rounded text-[22px] hidden dark:block text-amber-400">light_mode</span>
            </button>
        </div>
    </div>
</header>

<script>
    (function() {
        // Mobile Sidebar Toggle Fix
        window.toggleAdminSidebar = function() {
            const sidebar = document.getElementById('adminSidebar');
            if(sidebar) {
                sidebar.classList.toggle('active');
            }
        }
    })();
</script>
