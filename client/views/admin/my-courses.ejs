<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>My Courses | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; }
        .stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .dark .stat-card { background: #1e293b; border: 1px solid #334155; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }
        .table-container { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.5rem; display: flex; flex-direction: column; height: 100%; min-height: 0; }
        .dark .table-container { background: #1e293b; border: 1px solid #334155; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-700 dark:text-slate-300 font-sans overflow-hidden antialiased">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'courses' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'My Workspace' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 bg-[#F8FAFC] dark:bg-[#020617]">
                <!-- Personalized Stats -->

                <!-- Personal Stats -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-blue-500 opacity-[0.05]">library_books</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-blue-500">library_books</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Courses</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.total %></h3>
                            </div>
                        </div>
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-violet-500 opacity-[0.05]">groups</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-violet-500">groups</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Enrolled</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.totalStudents %></h3>
                            </div>
                        </div>
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.05]">verified</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-emerald-500">verified</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Free Batches</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.free %></h3>
                            </div>
                        </div>
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.05]">monetization_on</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-amber-500">monetization_on</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Premium Batches</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.paid %></h3>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Data Hub -->
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-4">
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <form action="/admin/my-courses" method="GET" class="flex flex-wrap items-center gap-2 flex-1 min-w-[300px]">
                            <div class="relative flex-1 max-w-[400px]">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search my courses..." 
                                class="w-full pl-3 pr-10 h-9 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[12px] font-semibold outline-none focus:border-blue-500/50 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                            </div>
                            
                            <div class="relative w-[130px]">
                                <select name="classLevel" onchange="this.form.submit()" class="w-full h-9 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500/50">
                                    <option value="all">All Classes</option>
                                    <% classLevels.sort().forEach(lv => { %>
                                        <option value="<%= lv %>" <%= filters.classLevel === lv ? 'selected' : '' %>><%= lv %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[130px]">
                                <select name="accessType" onchange="this.form.submit()" class="w-full h-9 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500/50">
                                    <option value="all">Paid & Free</option>
                                    <option value="paid" <%= filters.accessType === 'paid' ? 'selected' : '' %>>Paid Only</option>
                                    <option value="free" <%= filters.accessType === 'free' ? 'selected' : '' %>>Free Only</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[130px]">
                                <select name="subject" onchange="this.form.submit()" class="w-full h-9 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500/50">
                                    <option value="all">All Subjects</option>
                                    <% subjects.sort().forEach(sub => { %>
                                        <option value="<%= sub %>" <%= filters.subject === sub ? 'selected' : '' %>><%= sub %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>


                            <div class="h-9 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all">
                                <span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalCourses %></span> Courses</span>
                            </div>
                        </form>

                        <div class="flex items-center gap-2">
                            <a href="/admin/compose-course" class="h-9 px-4 rounded-lg bg-primary text-white font-bold text-[10px] shadow-lg shadow-primary/20 hover:bg-blue-600 hover:-translate-y-0.5 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">add</span> Create New Course
                            </a>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                <tr>
                                    <th class="pl-4 pr-4 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-left">Course Name</th>
                                    <th class="px-6 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-left">Subject</th>
                                    <th class="px-6 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-left">Class</th>
                                    <th class="px-6 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-center">Students</th>
                                    <th class="px-6 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-left">Type</th>
                                    <th class="px-6 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-left">Pricing</th>
                                    <th class="pr-4 py-2.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% if (!courses.length) { %>
                                <tr>
                                    <td colspan="7" class="px-4 py-16 text-center">
                                        <div class="flex flex-col items-center justify-center gap-3">
                                            <div class="size-16 rounded-2xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                                                <span class="material-symbols-rounded text-3xl">auto_stories</span>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-slate-600 dark:text-slate-300">No courses in your workspace</p>
                                                <p class="text-[11px] text-slate-500 mt-1">Start by creating your first course batch.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                                <% courses.forEach(course => { %>
                                    <tr class="course-row group hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-all cursor-pointer">
                                        <td class="pl-4 pr-4 py-2.5">
                                            <div class="flex items-center gap-2">
                                                <div class="w-9 h-6 rounded-lg flex-shrink-0 overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 shadow-sm relative group-hover:shadow-md transition-all">
                                                    <% if (course.thumbnail) { %>
                                                        <img src="<%= course.thumbnail %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-600"><span class="material-symbols-rounded text-[12px]">image</span></div>
                                                    <% } %>
                                                </div>
                                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight truncate max-w-[200px]"><%= course.title %></p>
                                            </div>
                                        </td>
                                        <td class="px-6 py-2.5">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-slate-50 dark:bg-slate-900 text-slate-500 dark:text-slate-400 text-[9px] font-bold border border-slate-100 dark:border-slate-800 whitespace-nowrap">
                                                <%= Array.isArray(course.subject) ? course.subject.join(', ') : (course.subject || '') %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-2.5">
                                            <span class="text-[10px] font-bold text-slate-500 tracking-tight">Class: <span class="text-slate-900 dark:text-slate-200"><%= (Array.isArray(course.classLevel) ? course.classLevel : [course.classLevel]).map(c => (c || '').toString().replace(/Class\s+/i, '')).join(', ') %></span></span>
                                        </td>
                                        <td class="px-6 py-2.5 text-center">
                                            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200"><%= course.studentCount || 0 %></span>
                                        </td>
                                        <td class="px-6 py-2.5">
                                            <% if (course.accessType === 'free') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[8px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[8px] font-bold border border-amber-100 dark:border-amber-500/20">Premium</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-2.5">
                                            <div class="flex flex-col">
                                                <% if (course.accessType === 'paid' || course.accessType === 'trial') { %>
                                                    <div class="flex items-center gap-1">
                                                        <span class="text-[9px] font-bold text-slate-400 dark:text-slate-500 mt-0.5">&#2547;</span>
                                                        <span class="text-[12px] font-bold text-slate-800 dark:text-slate-100 tracking-tight"><%= course.discountPrice > 0 ? course.discountPrice : (course.price || 0) %></span>
                                                    </div>
                                                    <% if (course.discountPrice > 0 && course.discountPrice < course.price) { %>
                                                        <span class="text-[8px] text-slate-400 line-through">&#2547;<%= course.price %></span>
                                                    <% } %>
                                                <% } else { %>
                                                    <span class="text-emerald-500 text-[9px] font-bold tracking-wider opacity-60">FREE</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="pr-4 py-2.5 border-0">
                                            <div class="flex items-center justify-end gap-1">
                                                <a href="/admin/course/<%= course._id %>" class="size-7 rounded-lg bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm group">
                                                    <span class="material-symbols-rounded text-xs group-hover:scale-110 transition-transform">visibility</span>
                                                </a>
                                                <a href="/admin/edit-course/<%= course._id %>" class="size-7 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 text-amber-600 hover:bg-amber-500 hover:text-white transition-all flex items-center justify-center shadow-sm group">
                                                    <span class="material-symbols-rounded text-xs group-hover:scale-110 transition-transform">edit</span>
                                                </a>
                                                <button onclick="deleteCourse('<%= course._id %>')" class="size-7 rounded-lg bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm group">
                                                    <span class="material-symbols-rounded text-xs group-hover:scale-110 transition-transform">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 bg-white dark:bg-[#0f172a] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-[1px]">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= encodeURIComponent(filters.q) %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteCourse(id) {
            Swal.fire({
                title: 'Delete Course?',
                text: 'All associated data will be removed forever.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, delete it',
                customClass: {
                    popup: 'rounded-[24px] border-0 shadow-2xl',
                    title: 'font-black tracking-tight',
                    confirmButton: 'rounded-xl px-8 font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) window.location.href = `/admin/course/${id}/delete`;
            });
        }

        // Success Alert Check
        const urlParams = new URLSearchParams(window.location.search);
        if(urlParams.get('success')) {
            Swal.fire({
                title: 'Course Launched...',
                text: urlParams.get('success'),
                icon: 'success',
                confirmButtonColor: '#3B82F6',
                customClass: {
                    popup: 'rounded-[32px] border-0 shadow-2xl',
                    title: 'font-black tracking-tight',
                    confirmButton: 'rounded-2xl px-10 font-bold'
                }
            });
            // Clean URL
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    </script>
</body>
</html>
