<style>
    /* Custom Transparent Scrollbar for Sidebar */
    .admin-sidebar::-webkit-scrollbar {
        width: 4px;
    }

    .admin-sidebar::-webkit-scrollbar-track {
        background: transparent;
    }

    .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(203, 213, 225, 0.15);
        border-radius: 10px;
    }

    .admin-sidebar:hover::-webkit-scrollbar-thumb {
        background: rgba(203, 213, 225, 0.35);
        border-radius: 10px;
    }

    /* Firefox */
    .admin-sidebar {
        scrollbar-width: thin;
        scrollbar-color: rgba(203, 213, 225, 0.15) transparent;
    }
</style>

<div class="flex flex-col h-full bg-white dark:bg-[#0f172a]">
    <!-- User Profile Identity -->
    <div class="px-4 py-5">
        <a href="/admin/profile" class="flex items-center gap-3 group hover:opacity-80 transition-opacity">
            <div class="relative">
                <div
                    class="size-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm shadow-lg shadow-primary/20 overflow-hidden">
                    <% if (user.profilePicture) { %>
                        <img src="<%= user.profilePicture %>" alt="Profile" class="w-full h-full object-cover">
                        <% } else { %>
                            <%= user.name[0] %>
                                <% } %>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <h2 class="text-sm font-bold tracking-tight dark:text-white truncate leading-tight">
                    <%= user.name %>
                </h2>
                <p class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5">
                    <% if (locals.isSuperAdmin || user.role==='superadmin' || (locals.SUPER_ADMIN_EMAIL && user.email===locals.SUPER_ADMIN_EMAIL)) { %>
                        <span class="text-amber-500">⭐ SuperAdmin</span>
                        <% } else if (user.role==='teacher' ) { %>
                            Teacher
                            <% } else { %>
                                Administrator
                                <% } %>
                </p>
            </div>
        </a>
    </div>

    <!-- Navigation Scroll Area -->
    <div id="sidebarScrollArea" class="flex-1 overflow-y-auto pl-1.5 pr-3 py-6 no-scrollbar space-y-7">
        <!-- ROLE CONTEXT: <%= isSuperAdmin ? 'SUPERADMIN' : 'ADMIN' %> -->

        <!-- ========== MANAGEMENT SECTION ========== -->
        <div>
            <p class="text-[9px] font-bold text-slate-400 dark:text-slate-500 tracking-widest mb-3 px-4 opacity-50">
                Command Center</p>
            <nav class="space-y-1">
                <a href="/admin" class="nav-link <%= active === 'dashboard' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">analytics</span>
                    <span class="text-xs">Dashboard</span>
                </a>
                <a href="/admin/academic" class="nav-link <%= active === 'academic' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">psychology</span>
                    <span class="text-xs">Academic Studio</span>
                </a>
                <a href="/admin/users" class="nav-link <%= active === 'users' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">group</span>
                    <span class="text-xs">User Database</span>
                </a>
                
                <% if (isSuperAdmin || user.role === 'admin') { %>
                    <a href="/admin/create-role" class="nav-link <%= active === 'create-role' ? 'active' : '' %>">
                        <span class="material-symbols-rounded">person_add</span>
                        <span class="text-xs">Create New Role</span>
                    </a>
                <% } %>

                <a href="/admin/coupons" class="nav-link <%= active === 'coupons' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">loyalty</span>
                    <span class="text-xs">Coupon Engine</span>
                </a>

                <a href="/admin/payments" class="nav-link <%= active === 'payments' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">account_balance_wallet</span>
                    <span class="text-xs">Payment History</span>
                </a>
                
                <a href="/admin/logs" class="nav-link <%= active === 'logs' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">history</span>
                    <span class="text-xs">Activity Logs</span>
                </a>

                <a href="/admin/notifications" class="nav-link <%= active === 'notifications' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">notifications_active</span>
                    <span class="text-xs">Notification Center</span>
                </a>

                <% if (isSuperAdmin) { %>
                    <a href="/admin/settings" class="nav-link <%= active === 'settings' ? 'active' : '' %>">
                        <span class="material-symbols-rounded">settings</span>
                        <span class="text-xs">System Settings</span>
                    </a>
                <% } %>
            </nav>
        </div>

        <!-- ========== ACADEMIC SECTION ========== -->
        <div>
            <p class="text-[9px] font-bold text-slate-400 dark:text-slate-500 tracking-widest mb-3 px-4 opacity-50">Academic Section</p>
            <nav class="space-y-1">
                <a href="/admin/ai-knowledge" class="nav-link <%= active === 'ai-knowledge' ? 'active' : '' %>">
                    <span class="material-symbols-rounded text-indigo-500">smart_toy</span>
                    <span class="text-xs">AI Knowledge Hub</span>
                    <span class="ml-auto text-[8px] font-black uppercase px-1.5 py-0.5 rounded bg-indigo-500 text-white leading-none">AI</span>
                </a>
                <a href="/admin/courses" class="nav-link <%= active === 'courses' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">auto_stories</span>
                    <span class="text-xs">Course Management</span>
                </a>
                <a href="/admin/video-classes" class="nav-link <%= active === 'classes' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">play_circle</span>
                    <span class="text-xs">Video Lessons</span>
                </a>
                <a href="/admin/notes" class="nav-link <%= active === 'notes' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">description</span>
                    <span class="text-xs">Notes</span>
                </a>
                <a href="/admin/quizzes" class="nav-link <%= active === 'quizzes' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">quiz</span>
                    <span class="text-xs">Exam Center</span>
                </a>
                <a href="/admin/question-bank" class="nav-link <%= active === 'questions' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">archive</span>
                    <span class="text-xs">Question Archive</span>
                </a>
                <a href="/admin/question-bank-approvals" class="nav-link <%= active === 'question-bank-approvals' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">rule</span>
                    <span class="text-xs">Question Approvals</span>
                </a>
                <a href="/admin/question-details" class="nav-link <%= active === 'question-details' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">history</span>
                    <span class="text-xs">Question History</span>
                </a>
                <a href="/admin/qas" class="nav-link <%= active === 'qas' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">forum</span>
                    <span class="text-xs">Student Support</span>
                </a>
            </nav>
        </div>

    </div>

    <!-- Sidebar Footer -->
    <div class="p-4 mt-auto border-t border-slate-100 dark:border-slate-800/50">
        <a href="/logout"
            class="flex items-center gap-3 p-2.5 rounded-2xl bg-rose-50/40 dark:bg-rose-500/5 hover:bg-rose-100/50 dark:hover:bg-rose-500/10 border border-rose-100/50 dark:border-rose-500/10 transition-all group">
            <div
                class="size-8 rounded-xl bg-white dark:bg-slate-900 flex items-center justify-center text-rose-500 shadow-sm border border-rose-100/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-rounded text-[20px]">logout</span>
            </div>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-400 leading-none">Logout</span>
        </a>
    </div>
</div>

<style>
    .nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.2s ease;
        color: #000000;
        border: 1px solid transparent;
        margin: 0;
    }

    .dark .nav-link {
        color: #94a3b8;
    }

    .nav-link:hover {
        background: #f8fafc;
        color: #137fec;
    }

    .dark .nav-link:hover {
        background: #1e293b;
        color: #137fec;
    }

    .nav-link.active {
        background: #f3f4f6;
        color: #000000;
        border-radius: 12px;
        font-weight: 600;
    }

    .dark .nav-link.active {
        background: rgba(255, 255, 255, 0.05);
        /* Softer highlight in dark mode */
        color: #ffffff;
    }

    .nav-link .material-symbols-rounded {
        font-size: 18px;
        flex-shrink: 0;
    }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    (function() {
        const sidebarScroll = document.getElementById('sidebarScrollArea');
        if (sidebarScroll) {
            // Restore scroll position synchronously before paint to prevent visual jumping
            const savedScroll = localStorage.getItem('oddhaySidebarScrollPos');
            if (savedScroll) {
                sidebarScroll.style.scrollBehavior = 'auto'; // Ensure instant jump before paint
                sidebarScroll.scrollTop = parseInt(savedScroll, 10);
            }

            // Save scroll position on scroll
            let scrollTimeout;
            sidebarScroll.addEventListener('scroll', () => {
                if (scrollTimeout) cancelAnimationFrame(scrollTimeout);
                scrollTimeout = requestAnimationFrame(() => {
                    localStorage.setItem('oddhaySidebarScrollPos', sidebarScroll.scrollTop);
                });
            }, { passive: true });
        }
    })();
</script>
