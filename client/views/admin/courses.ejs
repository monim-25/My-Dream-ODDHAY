<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Course Catalog | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; }
        .stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .dark .stat-card { background: #1e293b; border: 1px solid #334155; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }
        .table-container { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.5rem; display: flex; flex-direction: column; height: 100%; min-height: 0; }
        .dark .table-container { background: #1e293b; border: 1px solid #334155; }
        .table-wrapper { position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
    </style>
</head>

<body class="bg-[#F8FAFC] text-slate-700 dark:text-slate-300 font-sans overflow-hidden antialiased">
    <!-- Course Preview Modal -->
    <div id="coursePreviewModal" class="fixed inset-0 z-[200] hidden">
        <div class="absolute inset-0 bg-slate-900/20 backdrop-blur-sm" onclick="document.getElementById('coursePreviewModal').classList.add('hidden')"></div>
        <div class="absolute inset-y-0 right-0 w-full max-w-[580px] bg-white dark:bg-[#0b1120] shadow-2xl animate-slide-left border-l border-slate-200/50 dark:border-white/5">
            <div class="h-full flex flex-col overflow-hidden">
                <!-- Modal Header -->
                <div class="px-6 py-5 border-b border-slate-50 dark:border-white/5 flex items-center justify-between bg-[#F8F6F1]/50 dark:bg-white/5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary text-xl">auto_stories</span>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white tracking-tight">Course Intelligence</h2>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Metadata Registry • Verified Asset</p>
                        </div>
                    </div>
                    <button onclick="document.getElementById('coursePreviewModal').classList.add('hidden')" class="size-8 rounded-lg hover:bg-slate-100 dark:hover:bg-white/5 transition-all flex items-center justify-center group">
                        <span class="material-symbols-rounded text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">close</span>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-8 custom-scrollbar">
                    <div class="flex gap-8">
                        <!-- Left side: Thumbnail & Quick Stats -->
                        <div class="w-[200px] flex-shrink-0 space-y-6">
                            <div class="aspect-[4/3] rounded-[2.5rem] overflow-hidden border-2 border-[#F8F6F1] dark:border-slate-800 shadow-xl shadow-slate-200/50 dark:shadow-black/50 group relative">
                                <img id="previewThumbnail" src="/images/course-default.png" class="size-full object-cover transition-transform duration-700 group-hover:scale-110">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>

                            <div class="grid grid-cols-1 gap-2">
                                <div class="p-4 rounded-[1.25rem] bg-white dark:bg-white/5 border border-slate-200 dark:border-white/5 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 tracking-tight mb-1">Enrolled</p>
                                    <p id="previewEnrolled" class="text-xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none">0</p>
                                </div>
                                <div class="p-4 rounded-[1.25rem] bg-white dark:bg-white/5 border border-slate-200 dark:border-white/5 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 tracking-tight mb-1">Pricing</p>
                                    <p id="previewPrice" class="text-xl font-bold text-emerald-600 tracking-tighter leading-none">৳ 0</p>
                                </div>
                            </div>
                        </div>

                        <!-- Right side: Core Metadata -->
                        <div class="flex-1 space-y-8">
                            <div>
                                <div class="flex items-center gap-2 mb-3">
                                    <span id="previewAccess" class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                    <span id="previewLevel" class="px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[10px] font-bold border border-blue-200 dark:border-blue-500/20">Class 10</span>
                                </div>
                                <h3 id="previewTitle" class="text-2xl font-bold text-slate-900 dark:text-white leading-[1.1] tracking-tight mb-4"></h3>
                                <div id="previewSubjects" class="flex flex-wrap gap-1.5"></div>
                            </div>

                            <div class="space-y-4">
                                <div class="flex items-center gap-4 p-5 rounded-[1.5rem] bg-white dark:bg-slate-900/50 border border-slate-100 dark:border-white/5 shadow-sm transition-all hover:shadow-md">
                                    <div class="size-12 rounded-full overflow-hidden border-2 border-[#F8F6F1] dark:border-slate-800 shadow-inner">
                                        <img id="previewInstructorImg" src="/images/default-avatar.png" class="size-full object-cover">
                                    </div>
                                    <div>
                                        <p id="previewInstructor" class="text-sm font-bold text-slate-900 dark:text-white tracking-tight mb-0.5"></p>
                                        <p class="text-[10px] font-medium text-slate-500 tracking-wide">Lead Instructor • Verified</p>
                                    </div>
                                </div>

                                <div class="p-6 rounded-[2rem] bg-[#F8F6F1]/50 dark:bg-white/5 border-2 border-dashed border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary/50 transition-all">
                                    <span class="material-symbols-rounded text-slate-300 group-hover:text-primary transition-colors text-3xl mb-2">dashboard_customize</span>
                                    <p class="text-[10px] font-bold text-slate-500 tracking-wider">Administrative Context</p>
                                    <p class="text-[9px] text-slate-400 font-medium mt-1 max-w-[200px]">Full curriculum management and assessment logs available in deep view.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-12 flex items-center justify-center">
                        <a id="previewFullLink" href="#" class="h-12 px-10 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold tracking-tight flex items-center justify-center shadow-lg shadow-slate-400/20 dark:shadow-black/40 hover:scale-[1.02] transition-all group">
                            Access Full Dashboard
                            <span class="material-symbols-rounded ml-3 text-lg group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'courses' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC]">
            <%- include('header_v2', { pageTitle: 'Course Management' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 bg-[#F8FAFC] dark:bg-[#020617]">
                <!-- Stats Overview - Unified Container -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        <a href="/admin/courses?accessType=all" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-blue-500 opacity-[0.05]">library_books</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-blue-500">library_books</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Courses</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.total %></h3>
                            </div>
                        </a>
                        <a href="/admin/courses?accessType=free" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.05]">verified</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-emerald-500">verified</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Free Access</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.free %></h3>
                            </div>
                        </a>
                        <a href="/admin/courses?accessType=paid" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.05]">monetization_on</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-amber-500">monetization_on</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Premium Batches</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.paid %></h3>
                            </div>
                        </a>
                        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-violet-500 opacity-[0.05]">groups</span>
                            <div class="flex items-center gap-1 relative z-10">
                                <span class="material-symbols-rounded text-[14px] text-violet-500">groups</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Enrolled Students</p>
                            </div>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.totalStudents %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (typeof filterTeacher !== 'undefined' && filterTeacher) { %>
                <!-- Teacher Filter Banner -->
                <div class="mt-[1px] px-4 py-2.5 bg-primary/5 border border-primary/20 rounded-md flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary text-base">person</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 tracking-wide">Filtering Courses by Instructor</p>
                            <p class="text-sm font-bold text-slate-900 dark:text-white"><%= filterTeacher.name %></p>
                        </div>
                        <% if (filterTeacher.teachingSubject) { %>
                            <span class="px-2 py-0.5 rounded-md bg-fuchsia-50 dark:bg-fuchsia-500/10 border border-fuchsia-200 dark:border-fuchsia-500/20 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-semibold"><%= filterTeacher.teachingSubject %></span>
                        <% } %>
                    </div>
                    <a href="/admin/courses" class="h-7 px-3 text-[10px] font-bold rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:text-primary transition-all flex items-center gap-1">
                        <span class="material-symbols-rounded text-[13px]">close</span> Clear Filter
                    </a>
                </div>
                <% } %>

                <!-- Main Data Hub -->
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <form action="/admin/courses" method="GET" class="flex flex-wrap items-center gap-2 flex-1 min-w-[300px]">
                            <div class="relative flex-1 max-w-[400px]">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search by title, subject, class..." 
                                class="w-full pl-3 pr-10 h-9 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[12px] font-semibold outline-none focus:border-blue-500/50 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                            </div>
                            <% if (filters.instructor) { %><input type="hidden" name="instructor" value="<%= filters.instructor %>"><% } %>
                            
                            <div class="relative w-[140px]">
                                <select name="classLevel" onchange="this.form.submit()" class="w-full h-9 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500/50">
                                    <option value="all">All Classes</option>
                                    <% classLevels.sort().forEach(lv => { %>
                                        <option value="<%= lv %>" <%= filters.classLevel === lv ? 'selected' : '' %>><%= lv %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>



                            <div class="relative w-[140px]">
                                <select name="accessType" onchange="this.form.submit()" class="w-full h-9 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500/50">
                                    <option value="all" <%= filters.accessType === 'all' ? 'selected' : '' %>>All Access</option>
                                    <option value="free" <%= filters.accessType === 'free' ? 'selected' : '' %>>Free</option>
                                    <option value="paid" <%= filters.accessType === 'paid' ? 'selected' : '' %>>Paid</option>
                                    <option value="trial" <%= filters.accessType === 'trial' ? 'selected' : '' %>>Trial</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>
                            


                            <div class="h-9 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all">
                                <span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalCourses %></span> Matches</span>
                            </div>
                        </form>

                        <div class="flex items-center gap-2">
                            <button onclick="exportToCSV()" class="h-9 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                            <a href="/admin/my-courses" class="h-9 px-4 rounded-lg bg-blue-500 text-white font-bold text-[10px] shadow-lg shadow-blue-500/20 hover:bg-blue-600 hover:-translate-y-0.5 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">school</span> Your Course
                            </a>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-2 pr-1 text-center w-8">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity">
                                    </th>
                                    <th class="pl-1 pr-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-left">Course Detail</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-left">Subject</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-left">Class</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Total Enrolled</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-left">Access</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-left">Pricing</th>
                                    <th class="pr-8 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 text-right border-0 w-[140px]">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% if (!courses.length) { %>
                                <tr>
                                    <td colspan="8" class="px-4 py-16 text-center">
                                        <div class="flex flex-col items-center justify-center gap-3">
                                            <div class="size-16 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                                                <span class="material-symbols-rounded text-3xl">search_off</span>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-slate-600 dark:text-slate-300">No courses found</p>
                                                <p class="text-[11px] text-slate-500 dark:text-slate-500 mt-1">Try adjusting your filters or search query.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% courses.forEach(course => { %>
                                    <tr class="course-row group hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-all cursor-pointer" 
                                        ondblclick="toggleRowSelection('<%= course._id %>')"
                                        data-class="<%= (Array.isArray(course.classLevel) ? course.classLevel.join(',') : (course.classLevel || '')) %>" 
                                        data-title="<%= (course.title || '').toLowerCase() %>" 
                                        data-subject="<%= (Array.isArray(course.subject) ? course.subject.join(',') : (course.subject || '')).toLowerCase() %>">
                                        <td class="pl-2 pr-1 py-3" onclick="event.stopPropagation()">
                                            <input type="checkbox" id="cb-<%= course._id %>" name="courseSelect" value="<%= course._id %>" onchange="toggleSelection(this)" class="course-cb size-4 rounded border-slate-300 cursor-pointer text-primary focus:ring-primary opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-4 py-3">
                                            <div class="flex items-center gap-2">
                                                <div class="w-10 h-7 rounded-lg flex-shrink-0 overflow-hidden border border-slate-200/60 dark:border-slate-700/60 bg-slate-100 dark:bg-slate-800 shadow-sm relative group-hover:shadow-md transition-all">
                                                    <% if (course.thumbnail) { %>
                                                        <img src="<%= course.thumbnail %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                                    <% } else { %>
                                                        <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-600"><span class="material-symbols-rounded text-[14px]">image</span></div>
                                                    <% } %>
                                                </div>
                                                <p class="text-[12px] font-bold text-slate-900 dark:text-white leading-tight truncate max-w-[220px]" title="<%= course.title %>"><%= course.title %></p>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex flex-wrap gap-1">
                                                <% (Array.isArray(course.subject) ? course.subject : (course.subject || '').split(',')).forEach(sub => { %>
                                                    <% if (sub && sub.trim()) { %>
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-slate-50 dark:bg-slate-900 text-slate-500 dark:text-slate-400 text-[10px] font-bold border border-slate-100 dark:border-slate-800 whitespace-nowrap">
                                                            <%= sub.trim() %>
                                                        </span>
                                                    <% } %>
                                                <% }) %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[10px] font-bold text-slate-500 tracking-tight">Class: <%= (Array.isArray(course.classLevel) ? course.classLevel : [course.classLevel]).map(c => (c || '').toString().replace(/Class\s+/i, '')).join(', ') %></span>
                                        </td>
                                        <td class="px-6 py-3 text-center">
                                            <div class="flex flex-col items-center justify-center">
                                                <span class="text-[12px] font-bold text-slate-800 dark:text-slate-200"><%= course.studentCount || 0 %></span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <% if (course.accessType === 'free') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20">Premium</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex items-center gap-1">
                                                <% if (course.accessType === 'paid' || course.accessType === 'trial') { %>
                                                    <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 mt-0.5">&#2547;</span>
                                                    <span class="text-[13px] font-bold text-slate-800 dark:text-slate-100 tracking-tight"><%= course.price || 0 %></span>
                                                <% } else { %>
                                                    <span class="text-emerald-500 text-[10px] font-bold tracking-wider opacity-60">FREE</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="pr-8 py-3 border-0">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/admin/course/<%= course._id %>" class="size-8 rounded-xl bg-blue-500/10 dark:bg-blue-500/20 border border-blue-500/20 text-blue-600 dark:text-blue-400 hover:bg-blue-600 hover:text-white transition-all flex items-center justify-center shadow-sm group" title="View Details">
                                                    <span class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">visibility</span>
                                                </a>
                                                <% if (user.role === 'superadmin' || (course.instructor && course.instructor.toString() === user._id.toString())) { %>
                                                    <a href="/admin/edit-course/<%= course._id %>" class="size-8 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/20 text-amber-600 dark:text-amber-400 hover:bg-amber-600 hover:text-white transition-all flex items-center justify-center shadow-sm group" title="Edit Course">
                                                        <span class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">edit</span>
                                                    </a>
                                                <% } %>
                                                <button onclick="deleteCourse('<%= course._id %>')" class="size-8 rounded-xl bg-rose-500/10 dark:bg-rose-500/20 border border-rose-500/20 text-rose-600 dark:text-rose-400 hover:bg-rose-600 hover:text-white transition-all flex items-center justify-center shadow-sm group" title="Delete Course">
                                                    <span class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 bg-white dark:bg-[#0f172a] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-[1px]">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= encodeURIComponent(filters.q) %>&classLevel=<%= encodeURIComponent(filters.classLevel) %>&subject=<%= encodeURIComponent(filters.subject) %>&accessType=<%= encodeURIComponent(filters.accessType) %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Bulk Action Bar -->
                    <div id="bulkActions" class="hidden fixed bottom-8 left-1/2 -translate-x-1/2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl text-slate-800 dark:text-white px-8 py-4 flex items-center justify-between z-[100] animate-slide-up border border-slate-200/50 dark:border-white/5 rounded-[2.5rem] shadow-2xl shadow-slate-400/20 min-w-[500px]">
                        <div class="flex items-center gap-8">
                            <div class="flex items-center gap-3">
                                <div class="size-9 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-xl">verified</span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[10px] font-bold text-slate-400 leading-none mb-1">Batch Active</span>
                                    <span class="text-sm font-bold tracking-tight"><span id="selectedCount" class="text-primary">0</span> Entities Selected</span>
                                </div>
                            </div>
                            <div class="h-8 w-[1px] bg-slate-200 dark:bg-white/5"></div>
                            <button onclick="selectAllRows(true)" id="selectAllBtn" class="text-[10px] font-bold text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-white/10 px-4 py-2 rounded-lg bg-slate-50 dark:bg-white/5">Select All</button>
                        </div>
                        <div class="flex items-center gap-3">
                            <button onclick="clearSelection()" class="h-10 px-6 rounded-xl text-[11px] font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">Cancel</button>
                            <button onclick="handleBulkAction('delete')" class="h-10 px-8 bg-rose-500 text-white rounded-xl text-[11px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20">Purge Assets</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();
        function toggleSelectAll() { selectAllRows(document.getElementById('selectAll').checked); }
        
        function selectAllRows(force) {
            document.querySelectorAll('.course-cb').forEach(cb => { 
                cb.checked = force; 
                if(force) selectedItems.add(cb.value); 
                else selectedItems.delete(cb.value); 
            });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }

        function toggleRowSelection(id) { 
            const cb = document.getElementById(`cb-${id}`); 
            if (cb) { 
                cb.checked = !cb.checked; 
                toggleSelection(cb); 
            } 
        }

        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value); 
            else selectedItems.delete(el.value);
            
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = document.querySelectorAll('.course-cb').length === selectedItems.size;
            updateBulkUI();
        }

        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) { 
                bar.classList.remove('hidden'); 
                countEl.innerText = selectedItems.size; 
            } else { 
                bar.classList.add('hidden'); 
            }
        }

        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.course-cb').forEach(i => i.checked = false);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = false;
            updateBulkUI();
        }

        function togglePricing() {
            const type = document.getElementById('accessTypeSelect').value;
            document.getElementById('pricingSection').classList.toggle('hidden', type !== 'paid');
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({
                title: 'Bulk Action',
                text: `Are you sure you want to ${action} ${selectedItems.size} items?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec'
            });
            if (!res.isConfirmed) return;
            
            try {
                const response = await fetch('/admin/courses/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, courseIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        function deleteCourse(id) {
            Swal.fire({
                title: 'Delete Course?',
                text: 'All associated data will be removed forever.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, delete it'
            }).then((result) => {
                if (result.isConfirmed) window.location.href = `/admin/course/${id}/delete`;
            });
        }

        function exportToCSV() {
            const rows = [['Title', 'Subject', 'Class', 'Type', 'Price', 'Students']];
            document.querySelectorAll('.course-row').forEach(row => {
                if (row.style.display !== 'none') {
                    rows.push([
                        row.getAttribute('data-title'),
                        row.getAttribute('data-subject'),
                        row.getAttribute('data-class'),
                        row.querySelector('td:nth-child(6) span').innerText.includes('Premium') ? 'Premium' : 'Free',
                        row.querySelector('td:nth-child(7)').innerText.replace('৳', '').trim() || '0',
                        row.querySelector('td:nth-child(5) span').innerText
                    ]);
                }
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "odhay_courses.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        document.querySelector('input[name="thumbnail"]')?.addEventListener('change', function () {
            const label = document.getElementById('thumbLabel');
            const preview = document.getElementById('thumbPreview');
            
            if (this.files[0]) {
                label.innerHTML = `<span class="text-primary truncate font-bold">${this.files[0].name}</span>`;
                
                // Show preview image
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.style.backgroundImage = `url(${e.target.result})`;
                    preview.classList.remove('hidden');
                }
                reader.readAsDataURL(this.files[0]);
            } else {
                label.innerHTML = 'Drag & Drop or Click to Upload';
                preview.classList.add('hidden');
            }
        });

        // Add modal handlers
        window.openModal = function(id) {
            const modal = document.getElementById(id);
            const modalContent = modal.querySelector('div');
            
            modal.classList.remove('hidden');
            // Trigger reflow
            void modal.offsetWidth;
            
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
        };

        window.closeModal = function(id) {
            const modal = document.getElementById(id);
            const modalContent = modal.querySelector('div');
            
            modal.classList.add('opacity-0', 'pointer-events-none');
            modalContent.classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };
    </script>
</body>
</html>
