<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Question Bank Approvals | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; scroll-behavior: smooth; }
        @media (max-width: 1024px) { 
            #adminSidebar { transform: translateX(-100%); } 
            #adminSidebar.active { transform: translateX(0); box-shadow: 20px 0 50px rgba(0,0,0,0.2); }
            .admin-main { margin-left: 0; } 
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'questions' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] max-w-full overflow-x-hidden">
            <%- include('header_v2', { pageTitle: 'Question Bank Approvals' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 max-w-full">
                <!-- Top Status Header Grid: Pending, Approved, Rejected -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                        <!-- Pending Approvals Card -->
                        <div onclick="window.location.href='?status=pending'" class="bg-amber-50/50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md cursor-pointer <%= filters.status === 'pending' ? 'ring-2 ring-amber-500/80 shadow-md bg-white dark:bg-slate-800/60' : '' %>">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.08] pointer-events-none">pending_actions</span>
                            <div class="flex items-center gap-1.5 relative z-10">
                                <span class="material-symbols-rounded text-[16px] text-amber-500 flex items-center justify-center">pending_actions</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Pending Approvals</p>
                            </div>
                            <div class="flex-1 flex items-center justify-between relative z-10">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none tracking-tight"><%= stats.pendingCount %></h3>
                                <span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 flex items-center gap-0.5">Filter <span class="material-symbols-rounded text-xs flex items-center justify-center">chevron_right</span></span>
                            </div>
                        </div>

                        <!-- Approved Archives Card -->
                        <div onclick="window.location.href='?status=approved'" class="bg-emerald-50/50 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md cursor-pointer <%= filters.status === 'approved' ? 'ring-2 ring-emerald-500/80 shadow-md bg-white dark:bg-slate-800/60' : '' %>">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.08] pointer-events-none">check_circle</span>
                            <div class="flex items-center gap-1.5 relative z-10">
                                <span class="material-symbols-rounded text-[16px] text-emerald-500 flex items-center justify-center">check_circle</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Approved Archives</p>
                            </div>
                            <div class="flex-1 flex items-center justify-between relative z-10">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none tracking-tight"><%= stats.approvedCount %></h3>
                                <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-0.5">Filter <span class="material-symbols-rounded text-xs flex items-center justify-center">chevron_right</span></span>
                            </div>
                        </div>

                        <!-- Rejected Submissions Card -->
                        <div onclick="window.location.href='?status=rejected'" class="bg-rose-50/50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md cursor-pointer <%= filters.status === 'rejected' ? 'ring-2 ring-rose-500/80 shadow-md bg-white dark:bg-slate-800/60' : '' %>">
                            <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-rose-500 opacity-[0.08] pointer-events-none">cancel</span>
                            <div class="flex items-center gap-1.5 relative z-10">
                                <span class="material-symbols-rounded text-[16px] text-rose-500 flex items-center justify-center">cancel</span>
                                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Rejected Submissions</p>
                            </div>
                            <div class="flex-1 flex items-center justify-between relative z-10">
                                <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none tracking-tight"><%= stats.rejectedCount %></h3>
                                <span class="text-[10px] font-bold text-rose-600 dark:text-rose-400 flex items-center gap-0.5">Filter <span class="material-symbols-rounded text-xs flex items-center justify-center">chevron_right</span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Approval Inventory Container (matching quizzes.ejs) -->
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Sticky Filters & Action Bar -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-wrap">
                            <% if (filters.status === 'pending') { %>
                                <div class="h-10 px-4 bg-amber-500/10 border border-amber-500/20 rounded-lg flex items-center transition-all">
                                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-sm flex items-center justify-center">hourglass_empty</span>
                                        <span>Found <span><%= questions.length %></span> Pending Approvals</span>
                                    </span>
                                </div>
                            <% } else if (filters.status === 'approved') { %>
                                <div class="h-10 px-4 bg-emerald-500/10 border border-emerald-500/20 rounded-lg flex items-center transition-all">
                                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-sm flex items-center justify-center">verified</span>
                                        <span>Found <span><%= questions.length %></span> Approved Archives</span>
                                    </span>
                                </div>
                                <!-- Free / Paid Filter — only on Approved tab -->
                                <div class="flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-lg border border-slate-200 dark:border-slate-700">
                                    <a href="?status=approved&access=all&class=<%= filters.class %>&page=1"
                                       class="h-7 px-3 rounded-md text-[10px] font-bold transition-all flex items-center gap-1 <%= filters.access === 'all' ? 'bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-200' %>">
                                        All
                                    </a>
                                    <a href="?status=approved&access=Free&class=<%= filters.class %>&page=1"
                                       class="h-7 px-3 rounded-md text-[10px] font-bold transition-all flex items-center gap-1.5 <%= filters.access === 'Free' ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-200' %>">
                                        <span class="material-symbols-rounded text-[12px]">card_giftcard</span>
                                        Free
                                    </a>
                                    <a href="?status=approved&access=Paid&class=<%= filters.class %>&page=1"
                                       class="h-7 px-3 rounded-md text-[10px] font-bold transition-all flex items-center gap-1.5 <%= filters.access === 'Paid' ? 'bg-amber-500 text-white shadow-sm' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-200' %>">
                                        <span class="material-symbols-rounded text-[12px]">payments</span>
                                        Paid
                                    </a>
                                </div>
                            <% } else { %>
                                <div class="h-10 px-4 bg-rose-500/10 border border-rose-500/20 rounded-lg flex items-center transition-all">
                                    <span class="text-[11px] font-bold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-sm flex items-center justify-center">cancel</span>
                                        <span>Found <span><%= questions.length %></span> Rejected Submissions</span>
                                    </span>
                                </div>
                            <% } %>

                            <!-- Class Filter Dropdown (Superadmin-configured classes) -->
                            <% if (academicClasses && academicClasses.length > 0) { %>
                                <div class="relative w-[120px]">
                                    <select onchange="window.location.href='?status=<%= filters.status %>&access=<%= filters.access || 'all' %>&class=' + this.value + '&page=1'" class="w-full h-10 pl-3 pr-7 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                        <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                        <% academicClasses.forEach(ac => { %>
                                            <option value="<%= ac.name %>" <%= filters.class === ac.name ? 'selected' : '' %>><%= ac.name %></option>
                                        <% }) %>
                                    </select>
                                    <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px] flex items-center justify-center">expand_more</span>
                                </div>
                            <% } %>
                        </div>

                        <div class="flex items-center gap-2 ml-auto">
                            <a href="<%= (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? '/superadmin/question-bank' : '/admin/question-bank' %>" class="h-10 px-4 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-[10px] border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm flex items-center justify-center">arrow_back</span>
                                <span>Return to Main Archive</span>
                            </a>
                        </div>
                    </div>

                    <!-- Table Wrapper (Directly inside container) -->
                    <div class="table-wrapper overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-4 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Archive Name</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Teacher</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Board</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Year</th>
                                    <th class="px-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Subject</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Class</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Access</th>
                                    <th class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Status</th>
                                    <th class="pr-4 py-2 text-right text-[10px] font-bold text-slate-500 tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% if (questions.length === 0) { %>
                                    <tr>
                                        <td colspan="9" class="py-12 text-center text-slate-400 font-medium">
                                            <div class="flex flex-col items-center justify-center gap-2">
                                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 flex items-center justify-center">folder_open</span>
                                                <p class="text-xs font-bold text-slate-500">No Question Banks Found</p>
                                                <p class="text-[10px] text-slate-400">There are currently no items in this filter section.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% questions.forEach(item => { %>
                                        <tr class="question-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" onclick="window.location.href='<%= (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? '/superadmin' : '/admin' %>/question-bank/<%= item._id %>'">
                                            <td class="pl-4 pr-3 py-2">
                                                <div class="flex items-center gap-3">
                                                    <div class="size-8 rounded-lg overflow-hidden bg-orange-50 dark:bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-100 dark:border-orange-500/20 shrink-0">
                                                        <% if (item.fileUrl) { %>
                                                            <span class="material-symbols-rounded text-base flex items-center justify-center">picture_as_pdf</span>
                                                        <% } else { %>
                                                            <span class="material-symbols-rounded text-base flex items-center justify-center">inventory_2</span>
                                                        <% } %>
                                                    </div>
                                                    <div class="flex flex-col max-w-[200px]">
                                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight truncate"><%= item.title || item.topic || (item.board ? item.board + ' Archive' : 'Question Bank') %></p>
                                                        <p class="text-[9px] text-slate-400 font-medium mt-0.5"><%= item.year %> • <%= item.subject %></p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    <div class="size-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center shrink-0">
                                                        <% const avatar = item.addedBy && (item.addedBy.profilePicture || item.addedBy.profileImage); %>
                                                        <% if (avatar) { %>
                                                            <img src="<%= avatar %>" class="size-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                            <span class="hidden text-[9px] font-bold text-slate-400 flex items-center justify-center"><%= item.addedBy ? item.addedBy.name[0] : 'T' %></span>
                                                        <% } else { %>
                                                            <span class="text-[9px] font-bold text-slate-400 flex items-center justify-center"><%= item.addedBy ? item.addedBy.name[0] : 'T' %></span>
                                                        <% } %>
                                                    </div>
                                                    <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300 truncate max-w-[90px]"><%= item.addedBy ? item.addedBy.name : 'Teacher' %></span>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 whitespace-nowrap">
                                                    <%= item.board || 'General' %>
                                                </span>
                                            </td>
                                            <td class="px-3 py-2 text-center">
                                                <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400 whitespace-nowrap">
                                                    <%= item.year || '---' %>
                                                </span>
                                            </td>
                                            <td class="px-3 py-2 text-[10px] font-bold text-primary whitespace-nowrap">
                                                <%= item.subject %>
                                            </td>
                                            <td class="px-3 py-2 text-center">
                                                <span class="text-[10px] font-bold text-slate-500 whitespace-nowrap">Class <%= item.classLevel %></span>
                                            </td>
                                            <td class="px-3 py-2 text-center">
                                                 <button onclick="editAccessModal(event, '<%= item._id %>', '<%= item.accessType %>', '<%= item.price || 0 %>', '<%= (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? 'superadmin' : 'admin' %>')" class="group hover:scale-105 transition-transform" title="Click to edit access & price">
                                                     <% if (item.accessType === 'Paid') { %>
                                                         <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                             <span class="material-symbols-rounded text-[11px]">payments</span>
                                                             <span>Paid (৳<%= item.price || 0 %>)</span>
                                                             <span class="material-symbols-rounded text-[10px] text-amber-500 opacity-80">edit</span>
                                                         </span>
                                                     <% } else { %>
                                                         <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                             <span>Free</span>
                                                             <span class="material-symbols-rounded text-[10px] text-emerald-500 opacity-80">edit</span>
                                                         </span>
                                                     <% } %>
                                                 </button>
                                            </td>
                                            <td class="px-3 py-2 text-center">
                                                <% if (item.status === 'rejected') { %>
                                                    <span class="px-2.5 py-0.5 rounded-full bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[9px] font-bold border border-rose-100 dark:border-rose-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-[12px] flex items-center justify-center">cancel</span>
                                                        <span>Rejected</span>
                                                    </span>
                                                <% } else if (item.status === 'approved' || !item.status) { %>
                                                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-[12px] flex items-center justify-center">check_circle</span>
                                                        <span>Approved</span>
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2.5 py-0.5 rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                        <span class="size-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                        <span>Pending</span>
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td class="pr-4 py-2">
                                                <div class="flex items-center justify-end gap-1.5">
                                                    <% const rolePrefix = (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? 'superadmin' : 'admin'; %>
                                                                                                      <% if (item.status === 'pending') { %>
                                                         <!-- Approve Button -->
                                                         <button onclick="approveBank(event, '<%= item._id %>', '<%= rolePrefix %>')" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold transition-all border border-emerald-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Approve & Publish Archive">
                                                             <span class="material-symbols-rounded text-sm flex items-center justify-center">check_circle</span>
                                                             <span>Approve</span>
                                                         </button>
                                                         <!-- Reject Button -->
                                                         <button onclick="rejectBank(event, '<%= item._id %>', '<%= rolePrefix %>')" class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-[10px] font-bold transition-all border border-amber-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Reject Submission">
                                                             <span class="material-symbols-rounded text-sm flex items-center justify-center">cancel</span>
                                                             <span>Reject</span>
                                                         </button>
                                                     <% } else if (item.status === 'approved' || !item.status) { %>
                                                         <!-- Delete Button for Approved Archive -->
                                                         <button onclick="deleteBank(event, '<%= item._id %>', '<%= rolePrefix %>')" class="px-2.5 py-1 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-[10px] font-bold transition-all border border-rose-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Delete Approved Bank">
                                                             <span class="material-symbols-rounded text-sm flex items-center justify-center">delete</span>
                                                             <span>Delete</span>
                                                         </button>
                                                     <% } else if (item.status === 'rejected') { %>
                                                         <!-- Approve Button -->
                                                         <button onclick="approveBank(event, '<%= item._id %>', '<%= rolePrefix %>')" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold transition-all border border-emerald-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Approve & Publish Archive">
                                                             <span class="material-symbols-rounded text-sm flex items-center justify-center">check_circle</span>
                                                             <span>Approve</span>
                                                         </button>
                                                         <!-- Delete Button -->
                                                         <button onclick="deleteBank(event, '<%= item._id %>', '<%= rolePrefix %>')" class="px-2.5 py-1 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 text-[10px] font-bold transition-all border border-rose-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Delete Rejected Archive">
                                                             <span class="material-symbols-rounded text-sm flex items-center justify-center">delete</span>
                                                             <span>Delete</span>
                                                         </button>
                                                     <% } %>

                                                     <!-- Review Questions Button -->
                                                     <a href="/<%= rolePrefix %>/question-bank/<%= item._id %>" class="px-2.5 py-1 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 text-[10px] font-bold transition-all border border-blue-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Review All Questions in Archive">
                                                         <span class="material-symbols-rounded text-sm flex items-center justify-center">rate_review</span>
                                                         <span>Review</span>
                                                     </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination (At bottom of container matching quizzes.ejs) -->
                    <div class="px-4 py-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?status=<%= filters.status %>&page=<%= i %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        async function approveBank(e, bankId, rolePrefix) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            const res = await Swal.fire({
                title: 'Approve Question Bank?',
                text: 'This will publish the Question Bank to the student panel.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Approve & Publish',
                cancelButtonText: 'Cancel'
            });

            if (res.isConfirmed) {
                try {
                    const resp = await fetch(`/${rolePrefix}/question-bank/${bankId}/approve`, {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        }
                    });
                    const data = await resp.json();
                    if (data.success) {
                        await Swal.fire({
                            title: 'Approved!',
                            text: 'Question Bank published successfully.',
                            icon: 'success',
                            confirmButtonColor: '#10b981',
                            timer: 1500,
                            timerProgressBar: true
                        });
                        window.location.reload();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to approve', 'error');
                    }
                } catch (err) {
                    console.error('Approve error:', err);
                    window.location.href = `/${rolePrefix}/question-bank/${bankId}/approve`;
                }
            }
        }

        async function rejectBank(e, bankId, rolePrefix) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            const res = await Swal.fire({
                title: 'Reject Submission?',
                text: 'Are you sure you want to reject this Question Bank submission?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Reject',
                cancelButtonText: 'Cancel'
            });

            if (res.isConfirmed) {
                try {
                    const resp = await fetch(`/${rolePrefix}/question-bank/${bankId}/reject`, {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        }
                    });
                    const data = await resp.json();
                    if (data.success) {
                        await Swal.fire({
                            title: 'Rejected',
                            text: 'Submission has been marked as rejected.',
                            icon: 'info',
                            confirmButtonColor: '#64748b',
                            timer: 1500,
                            timerProgressBar: true
                        });
                        window.location.reload();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to reject', 'error');
                    }
                } catch (err) {
                    console.error('Reject error:', err);
                    window.location.href = `/${rolePrefix}/question-bank/${bankId}/reject`;
                }
            }
        }

        async function editAccessModal(e, bankId, currentAccess, currentPrice, rolePrefix) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const { value: formValues } = await Swal.fire({
                title: 'Edit Access & Pricing',
                html: `
                    <div class="space-y-4 text-left p-2">
                        <div>
                            <label class="text-xs font-bold text-slate-500 block mb-1">Access Type</label>
                            <select id="swal-accessType" class="w-full h-10 px-3 rounded-lg border border-slate-200 text-xs font-bold bg-white text-slate-800 outline-none focus:border-blue-500" onchange="document.getElementById('swal-price-container').style.display = this.value === 'Paid' ? 'block' : 'none'">
                                <option value="Free" ${currentAccess === 'Free' ? 'selected' : ''}>Free (Open Access)</option>
                                <option value="Paid" ${currentAccess === 'Paid' ? 'selected' : ''}>Paid (Premium)</option>
                            </select>
                        </div>
                        <div id="swal-price-container" style="display: ${currentAccess === 'Paid' ? 'block' : 'none'};" class="mt-3">
                            <label class="text-xs font-bold text-slate-500 block mb-1">Price (৳ BDT)</label>
                            <input id="swal-price" type="number" min="0" value="${currentPrice}" placeholder="Enter price in BDT" class="w-full h-10 px-3 rounded-lg border border-slate-200 text-xs font-bold bg-white text-slate-800 outline-none focus:border-blue-500">
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Save Access & Price',
                confirmButtonColor: '#137fec',
                preConfirm: () => {
                    const accessType = document.getElementById('swal-accessType').value;
                    const price = document.getElementById('swal-price').value;
                    return { accessType, price: parseFloat(price) || 0 };
                }
            });

            if (formValues) {
                try {
                    const response = await fetch(`/${rolePrefix}/question-bank/${bankId}/update-access`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(formValues)
                    });
                    const data = await response.json();
                    if (data.success) {
                        await Swal.fire({ icon: 'success', title: 'Access Updated', text: 'Question Bank access and price updated successfully.', timer: 1500, showConfirmButton: false });
                        window.location.reload();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to update access', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Network error', 'error');
                }
            }
        }

        async function deleteBank(e, bankId, rolePrefix) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const res = await Swal.fire({
                title: 'Delete Question Bank?',
                text: 'Are you sure you want to delete this archive? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            });

            if (res.isConfirmed) {
                try {
                    const resp = await fetch(`/${rolePrefix}/question-bank/${bankId}/delete`, { method: 'GET' });
                    await Swal.fire({
                        title: 'Deleted',
                        text: 'Archive deleted successfully.',
                        icon: 'success',
                        confirmButtonColor: '#10b981',
                        timer: 1500,
                        timerProgressBar: true
                    });
                    window.location.reload();
                } catch (err) {
                    window.location.href = `/${rolePrefix}/question-bank/${bankId}/delete`;
                }
            }
        }
    </script>
</body>
</html>
