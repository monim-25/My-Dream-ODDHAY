<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title><%= note.title %> | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }

        body, html { overflow: hidden; height: 100%; }

        .admin-main {
            margin-left: var(--admin-sidebar-width);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .page-body {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2px;
            padding: 2px;
            overflow: hidden;
        }

        .left-col, .right-col {
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .info-card {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: white;
            border: 1px solid #e2e8f0;
            padding: 16px;
        }

        .dark .info-card {
            background: rgba(15, 23, 42, 0.95);
            border-color: rgba(255,255,255,0.06);
        }

        .viewer-card {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: white;
            border: 1px solid #e2e8f0;
        }

        .dark .viewer-card {
            background: rgba(15, 23, 42, 0.95);
            border-color: rgba(255,255,255,0.06);
        }

        .viewer-header {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .dark .viewer-header { border-color: rgba(255,255,255,0.05); }

        .viewer-frame {
            flex: 1;
            min-height: 0;
        }

        .viewer-frame iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

        @media (max-width: 1024px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-main { margin-left: 0; }
            .page-body { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans">
    <div class="flex h-screen overflow-hidden">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'notes' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Material Options' }) %>

            <div class="page-body">
                <!-- ═══ LEFT COLUMN ═══ -->
                <div class="left-col">
                    <div class="info-card">

                        <!-- Icon + Title -->
                        <div class="flex items-center gap-3 mb-4">
                            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary border border-primary/20 flex-shrink-0">
                                <span class="material-symbols-rounded text-[22px]">description</span>
                            </div>
                            <h1 class="text-base font-black text-slate-900 dark:text-white leading-tight"><%= note.title %></h1>
                        </div>

                        <!-- Chapter — single line with icon -->
                        <div class="flex items-center gap-2 px-2.5 py-1.5 bg-amber-500/5 dark:bg-amber-500/10 border border-amber-500/15 rounded-md mb-3">
                            <span class="material-symbols-rounded text-amber-500 text-[16px] flex-shrink-0 leading-none">auto_stories</span>
                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate leading-none"><%= note.chapter || 'General Chapter' %></span>
                        </div>

                        <% if (note.course) { %>
                        <!-- Linked Course Badge -->
                        <a href="/admin/course/<%= note.course._id %>" class="flex items-center gap-2 px-2.5 py-1.5 bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/15 rounded-md mb-3 hover:bg-blue-500/10 transition-all">
                            <span class="material-symbols-rounded text-blue-500 text-[16px] flex-shrink-0 leading-none">school</span>
                            <span class="text-[11px] font-bold text-blue-600 dark:text-blue-400 truncate leading-none"><%= note.course.title %></span>
                        </a>
                        <% } %>

                        <!-- Subject / Class grid -->
                        <div class="grid grid-cols-2 gap-1.5 mb-3">
                            <div class="p-2.5 rounded-md border border-slate-100 dark:bg-slate-800/60 dark:border-white/5" style="background-color: #F8F6F1;">
                                <span class="text-[8px] font-black uppercase text-slate-400 tracking-widest block mb-0.5">Subject</span>
                                <span class="text-xs font-black text-slate-900 dark:text-white"><%= note.subject %></span>
                            </div>
                            <div class="p-2.5 rounded-md border border-slate-100 dark:bg-slate-800/60 dark:border-white/5" style="background-color: #F8F6F1;">
                                <span class="text-[8px] font-black uppercase text-slate-400 tracking-widest block mb-0.5">Class</span>
                                <span class="text-xs font-black text-slate-900 dark:text-white"><%= note.classLevel %></span>
                            </div>
                        </div>

                        <!-- Material Overview -->
                        <div class="mb-3">
                            <span class="text-[8px] font-black uppercase text-slate-400 tracking-widest block mb-1 ml-0.5">Material Overview</span>
                            <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 leading-relaxed">
                                <%= note.description || 'Comprehensive study notes and resources for the specified chapter and subject.' %>
                            </p>
                        </div>

                        <!-- Author + Meta — pushed to bottom -->
                        <div class="mt-auto pt-2">
                            <div class="rounded-md p-2.5 border border-slate-100 dark:border-white/5 dark:bg-slate-800/60" style="background-color: #F8F6F1;">
                                <div class="flex items-center gap-2.5 mb-2.5">
                                    <div class="size-9 rounded-md overflow-hidden border border-slate-200 dark:border-slate-700 flex-shrink-0">
                                        <img src="<%= note.addedBy && (note.addedBy.profilePicture || note.addedBy.profileImage) ? (note.addedBy.profilePicture || note.addedBy.profileImage) : '/images/default-avatar.png' %>"
                                             class="size-full object-cover"
                                             onerror="this.src='/images/default-avatar.png';">
                                    </div>
                                    <div>
                                        <h4 class="text-xs font-black text-slate-900 dark:text-white leading-tight"><%= note.addedBy ? note.addedBy.name : 'System Administrator' %></h4>
                                        <p class="text-[9px] font-bold text-slate-400 truncate max-w-[160px]"><%= note.addedBy ? (note.addedBy.email || 'admin@oddhay.com') : 'support@oddhay.com' %></p>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 border-t border-slate-200/60 dark:border-white/5">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= note.accessType === 'Paid' ? 'bg-amber-500/10 text-amber-600 border border-amber-500/20' : 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20' %>">
                                        <%= note.accessType %>
                                    </span>
                                    <div class="text-right">
                                        <span class="text-[8px] font-black uppercase text-slate-400 block">Published</span>
                                        <span class="text-[9px] font-bold text-slate-500">
                                            <%= new Date(note.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <% if (user.role === 'superadmin' || (note.addedBy && note.addedBy._id.toString() === user._id.toString())) { %>
                            <!-- Owner/Superadmin Actions -->
                            <div class="flex items-center gap-2 mt-3">
                                <button onclick="document.getElementById('editNoteModal').classList.remove('hidden')" class="flex-1 h-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[11px] font-bold border border-blue-500/20 hover:bg-blue-500/20 transition-all flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-rounded text-[15px] leading-none">edit</span>
                                    <span class="leading-none">Edit Material</span>
                                </button>
                                <button onclick="confirmDelete()" class="flex-1 h-9 rounded-md bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[11px] font-bold border border-rose-500/20 hover:bg-rose-500/20 transition-all flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-rounded text-[15px] leading-none">delete</span>
                                    <span class="leading-none">Delete</span>
                                </button>
                            </div>
                            <% } %>
                        </div>

                    </div>
                </div>

                <!-- ═══ RIGHT COLUMN ═══ -->
                <div class="right-col">
                    <div class="viewer-card">
                        <!-- Viewer Header -->
                        <div class="viewer-header">
                            <div class="flex items-center gap-2">
                                <div class="size-6 rounded bg-red-500/10 text-red-500 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-base">picture_as_pdf</span>
                                </div>
                                <span class="text-xs font-black text-slate-900 dark:text-white">Material Viewer</span>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <a href="<%= note.fileUrl %>" download class="size-7 rounded bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex-shrink-0" title="Download Material">
                                    <span class="material-symbols-rounded text-[18px]">download</span>
                                </a>
                                <button onclick="window.open('<%= note.fileUrl %>', '_blank')" class="size-7 rounded bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex-shrink-0" title="Open in new tab">
                                    <span class="material-symbols-rounded text-[18px]">open_in_new</span>
                                </button>
                            </div>
                        </div>

                        <!-- Viewer Frame -->
                        <div class="viewer-frame bg-slate-50 dark:bg-[#0f172a]/60">
                            <% if (note.fileUrl && note.fileUrl.toLowerCase().endsWith('.pdf')) { %>
                                <iframe src="<%= note.fileUrl %>"></iframe>
                            <% } else if (note.fileUrl) { %>
                                <div class="w-full h-full flex flex-col items-center justify-center p-8 text-center">
                                    <img src="<%= note.fileUrl %>" class="max-w-full max-h-full object-contain rounded shadow-xl">
                                    <a href="<%= note.fileUrl %>" target="_blank" class="mt-4 text-primary text-xs font-bold hover:underline">Open Full Size</a>
                                </div>
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center text-center p-8">
                                    <span class="material-symbols-rounded text-5xl text-slate-300 mb-3">error_outline</span>
                                    <h3 class="text-sm font-bold text-slate-400">No file attached to this note</h3>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Edit Note Modal -->
    <% if (user.role === 'superadmin' || (note.addedBy && note.addedBy._id.toString() === user._id.toString())) { %>
    <div id="editNoteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xl z-[250] hidden flex items-center justify-center p-6">
        <div class="bg-white dark:bg-[#0b1120] rounded-xl w-full max-w-lg overflow-hidden shadow-2xl border border-white/10 relative">
            <button onclick="document.getElementById('editNoteModal').classList.add('hidden')" class="absolute top-4 right-4 size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all">
                <span class="material-symbols-rounded text-base">close</span>
            </button>
            <div class="p-8">
                <h3 class="text-xl font-black mb-6">Edit <span class="text-primary italic">Material</span></h3>
                <form action="/admin/note/<%= note._id %>/edit" method="POST" class="space-y-4">
                    <div>
                        <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Title</label>
                        <input type="text" name="title" value="<%= note.title %>" required class="w-full h-10 px-4 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Subject</label>
                            <select name="subject" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <% ([...new Set((typeof globalAcademicClasses !== 'undefined' ? globalAcademicClasses : []).flatMap(c => c.subjects || []))]).forEach(s => { %>
                                    <option value="<%= s %>" <%= note.subject === s ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Class Level</label>
                            <select name="classLevel" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <% ((typeof globalAcademicClasses !== 'undefined' ? globalAcademicClasses : []).map(c => c.name)).forEach(c => { %>
                                    <option value="<%= c %>" <%= note.classLevel === c ? 'selected' : '' %>><%= c %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Chapter</label>
                            <input type="text" name="chapter" value="<%= note.chapter || '' %>" placeholder="Chapter 01" class="w-full h-10 px-4 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Access Type</label>
                            <select name="accessType" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <option value="Free" <%= note.accessType === 'Free' ? 'selected' : '' %>>Free</option>
                                <option value="Paid" <%= note.accessType === 'Paid' ? 'selected' : '' %>>Paid</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Description</label>
                        <textarea name="description" rows="2" placeholder="Brief overview..." class="w-full px-4 py-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none resize-none"><%= note.description || '' %></textarea>
                    </div>
                    <button type="submit" class="w-full h-10 bg-primary text-white rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 transition-all">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({ title: 'Delete Note?', text: 'This cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#f43f5e' })
                .then(r => { if (r.isConfirmed) window.location.href = '/admin/note/<%= note._id %>/delete'; });
        }
        <% if (locals.success) { %>
        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '<%= success %>', showConfirmButton: false, timer: 2500 });
        <% } %>
        document.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            if (params.get('edit') === 'true') {
                const editModal = document.getElementById('editNoteModal');
                if (editModal) editModal.classList.remove('hidden');
            }
        });
    </script>


<script>
    document.addEventListener('DOMContentLoaded', () => {
        const globalAcademicClasses = <%- typeof globalAcademicClasses !== 'undefined' ? JSON.stringify(globalAcademicClasses) : '[]' %>;
        if (!globalAcademicClasses || globalAcademicClasses.length === 0) return;

        function updateDynamicSubjects() {
            const classCheckboxes = document.querySelectorAll('input[name="classLevel[]"]:checked, input[name="classes"]:checked, input[name="classes[]"]:checked, input[name="targetClass"]:checked');
            const classSelects = document.querySelectorAll('select[name="applicableClass"], select[name="classLevel"], select[name="class"], select[name="targetClass"]');
            
            let selectedClasses = [];
            classCheckboxes.forEach(cb => selectedClasses.push(cb.value));
            classSelects.forEach(sel => { if(sel.value) selectedClasses.push(sel.value); });

            let allowedSubjects = new Set();
            if (selectedClasses.length === 0) {
                globalAcademicClasses.forEach(c => (c.subjects || []).forEach(s => allowedSubjects.add(s)));
            } else {
                globalAcademicClasses.forEach(c => {
                    const normalizedClass = c.name.replace('Class ', '');
                    if (selectedClasses.includes(c.name) || selectedClasses.includes(normalizedClass)) {
                        (c.subjects || []).forEach(s => allowedSubjects.add(s));
                    }
                });
            }

            const subjectCheckboxes = document.querySelectorAll('input[name="subject[]"], input[name="subjects"], input[name="subjects[]"], input[name="targetSubject"]');
            subjectCheckboxes.forEach(cb => {
                const optDiv = cb.closest('.multi-select-option');
                if (optDiv) {
                    if (allowedSubjects.has(cb.value)) {
                        optDiv.style.display = 'flex';
                    } else {
                        optDiv.style.display = 'none';
                        if (cb.checked) {
                            cb.checked = false;
                            const checkIcon = optDiv.querySelector('.material-symbols-rounded');
                            if (checkIcon) checkIcon.classList.add('hidden');
                            optDiv.classList.remove('bg-blue-50', 'dark:bg-blue-900/20');
                            if(checkIcon && checkIcon.parentElement) checkIcon.parentElement.classList.remove('bg-blue-500', 'border-blue-500');
                        }
                    }
                }
            });

            const subjectSelects = document.querySelectorAll('select[name="subject"], select[name="targetSubject"]');
            subjectSelects.forEach(sel => {
                const options = sel.querySelectorAll('option');
                let hasValidSelected = false;
                options.forEach(opt => {
                    if (!opt.value) return; 
                    if (allowedSubjects.has(opt.value)) {
                        opt.style.display = '';
                        if (sel.value === opt.value) hasValidSelected = true;
                    } else {
                        opt.style.display = 'none';
                    }
                });
                if (!hasValidSelected && sel.value) sel.value = '';
            });
            
            document.querySelectorAll('.multi-select-container').forEach(container => {
                const classLevelNames = ['classLevel', 'classes', 'targetClass', 'applicableClass'];
                const subjectNames = ['subject', 'subjects', 'targetSubject', 'applicableSubject'];
                const dataName = container.getAttribute('data-name');
                if (dataName && subjectNames.includes(dataName)) {
                    const triggerSpan = container.querySelector('.multi-select-trigger span');
                    const checkedBox = container.querySelectorAll('input[type="checkbox"]:checked');
                    if (triggerSpan) {
                        if (checkedBox.length === 0) {
                            triggerSpan.textContent = 'Select Subjects';
                            triggerSpan.classList.add('text-slate-400');
                            triggerSpan.classList.remove('text-slate-700', 'dark:text-slate-200');
                        } else {
                            triggerSpan.textContent = Array.from(checkedBox).map(cb => cb.value).join(', ');
                            triggerSpan.classList.remove('text-slate-400');
                            triggerSpan.classList.add('text-slate-700', 'dark:text-slate-200');
                        }
                    }
                }
            });
        }

        document.querySelectorAll('select[name="applicableClass"], select[name="classLevel"], select[name="class"], select[name="targetClass"]').forEach(sel => {
            sel.addEventListener('change', updateDynamicSubjects);
        });

        const observer = new MutationObserver(mutations => {
            let shouldUpdate = false;
            mutations.forEach(m => {
                const container = m.target.closest('.multi-select-container');
                if (container) {
                    const dataName = container.getAttribute('data-name') || '';
                    if (['classLevel', 'classes', 'targetClass', 'applicableClass'].includes(dataName) || container.querySelector('input[name="targetClass"]')) {
                        shouldUpdate = true;
                    }
                }
            });
            if (shouldUpdate) updateDynamicSubjects();
        });

        document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
            observer.observe(dropdown, { attributes: true, subtree: true, attributeFilter: ['class'] });
        });

        setTimeout(updateDynamicSubjects, 100);
    });
</script>
</body>
</html>
