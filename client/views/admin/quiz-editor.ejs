<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title><%= quiz.title %> | Assessment Studio</title>
    <style>
        :root { --sidebar-width: 260px; }
        .studio-main { margin-left: var(--sidebar-width); min-height: 100vh; }
        .studio-container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
        
        .q-card { 
            background: white; 
            border: 1px solid #f1f5f9; 
            border-radius: 2rem; 
            padding: 32px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }
        .dark .q-card { background: #0f172a; border-color: #1e293b; }
        .q-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px rgba(0,0,0,0.04); border-color: #e2e8f0; }
        .dark .q-card:hover { box-shadow: 0 30px 60px rgba(0,0,0,0.2); border-color: #334155; }
        
        .option-dot {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 900;
            background: #f8fafc;
            color: #64748b;
            border: 1px solid #e2e8f0;
            transition: all 0.2s;
        }
        .dark .option-dot { background: #1e293b; color: #94a3b8; border-color: #334155; }
        .option-dot.correct { background: #10b981; color: white; border-color: #10b981; box-shadow: 0 6px 15px rgba(16, 185, 129, 0.25); }

        .btn-action {
            height: 38px;
            padding: 0 18px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 800;

            letter-spacing: normal;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        
        .stat-card {
            background: white;
            border: 1px solid #f1f5f9;
            border-radius: 2rem;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .dark .stat-card { background: #0f172a; border-color: #1e293b; }

        .swal2-container { z-index: 9999 !important; }
        .swal2-popup { border-radius: 2rem !important; padding: 2rem !important; }
        .swal2-title { font-weight: 900 !important; tracking: -0.02em !important; }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'quizzes' }) %>
        </aside>

        <main class="studio-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { 
                pageTitle: quiz.title, 
                user: user,
                extraContent: `
                    <div class="flex items-center gap-3">
                        <button onclick="openBulkModal()" class="h-10 px-5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold text-[11px] tracking-tight hover:bg-slate-200 transition-all">
                            Matrix Import
                        </button>
                        <button onclick="openAddModal()" class="h-10 px-6 bg-black dark:bg-white text-white dark:text-black rounded-xl font-bold text-[11px] tracking-tight flex items-center gap-2 hover:opacity-90 transition-all shadow-xl shadow-black/10 active:scale-95">
                            <span class="material-symbols-rounded text-[18px]">add_circle</span> New Vector
                        </button>
                    </div>
                `
            }) %>

            <div class="studio-container space-y-10">
                <!-- Metrics Bar -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="stat-card">
                        <div class="size-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                            <span class="material-symbols-rounded text-2xl">layers</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Total Questions</p>
                            <h3 class="text-xl font-bold leading-none" id="total-count"><%= quiz.questions.length %></h3>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="size-12 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                            <span class="material-symbols-rounded text-2xl">timer</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Time Limit</p>
                            <h3 class="text-xl font-bold leading-none"><%= quiz.duration %> Min</h3>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="size-12 rounded-2xl bg-amber-500/10 flex items-center justify-center text-amber-500">
                            <span class="material-symbols-rounded text-2xl">verified_user</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Access Logic</p>
                            <h3 class="text-xl font-bold leading-none"><%= quiz.accessType %></h3>
                        </div>
                    </div>
                </div>

                <!-- Source Intelligence Toggle -->
                <div class="flex items-center justify-between mb-2 px-2">
                    <button onclick="document.getElementById('bankSelector').classList.toggle('hidden')" class="flex items-center gap-2 text-[11px] font-bold text-slate-400 hover:text-primary transition-all">
                        <span class="material-symbols-rounded text-[18px]">hub</span>
                        Automated Intelligence Tools
                    </button>
                </div>

                <!-- Collect Questions Hub (Smart Matrix Browser) -->
                <div id="bankSelector" class="p-8 rounded-[2rem] bg-white dark:bg-[#0f172a] border border-slate-100 dark:border-slate-800 flex flex-col shadow-sm gap-8 hidden">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 shadow-inner">
                                <span class="material-symbols-rounded text-2xl">collections_bookmark</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">Collect Questions from Bank</h4>
                                <p class="text-[10px] font-medium text-slate-400">Browse and selectively collect verified matrix vectors from the global repository.</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-4">
                            <div class="flex flex-col">
                                <span class="text-[9px] font-bold text-slate-400 mb-1 ml-1 tracking-tight">Matrix Type</span>
                                <select id="inj-type" onchange="fetchBankPreview()" class="h-10 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-[11px] font-bold outline-none focus:border-primary w-32 cursor-pointer">
                                    <option value="MCQ">MCQ</option>
                                    <option value="Short">Short</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Comprehension">Comprehension</option>
                                </select>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[9px] font-bold text-slate-400 mb-1 ml-1 tracking-tight">Topic Filter</span>
                                <select id="inj-topic" onchange="fetchBankPreview()" class="h-10 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-[11px] font-bold outline-none focus:border-primary w-56 cursor-pointer">
                                    <option value="">All Topics</option>
                                    <!-- Populated by JS -->
                                </select>
                            </div>
                            <button onclick="fetchBankPreview()" class="mt-4 h-10 px-6 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl font-bold text-[11px] hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-2">
                                <span class="material-symbols-rounded text-[18px]">sync</span>
                                Refresh Bank
                            </button>
                        </div>
                    </div>

                    <!-- Live Matrix Browser -->
                    <div id="bank-preview-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[400px] overflow-y-auto p-1 custom-scrollbar">
                        <!-- Questions will appear here -->
                        <div class="col-span-full py-12 flex flex-col items-center justify-center text-slate-400">
                            <span class="material-symbols-rounded text-4xl mb-2">find_in_page</span>
                            <p class="text-[11px] font-bold">Scanning bank matrices...</p>
                        </div>
                    </div>
                </div>

                <!-- Feed -->
                <div class="space-y-6" id="questions-feed">
                    <% quiz.questions.forEach((q, index) => { %>
                        <div class="q-card group animate-in fade-in slide-in-from-bottom-4 duration-500" id="q-<%= q._id %>" style="animation-delay: <%= index * 50 %>ms">
                            <div class="flex items-start justify-between mb-8">
                                <div class="flex items-center gap-3">
                                    <div class="size-9 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-[11px] font-bold text-slate-400">
                                        #<%= index + 1 %>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] font-bold text-emerald-500 tracking-tight">Enter <%= q.questionType %></span>
                                        <span class="text-[10px] font-bold text-slate-400">Awaiting Data Population</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0">
                                    <button onclick="replaceQuestion('<%= q._id %>')" class="btn-action bg-amber-50 dark:bg-amber-500/10 text-amber-600 hover:bg-amber-500 hover:text-white border border-amber-100 dark:border-amber-500/20" title="Swap with another from Bank">
                                        <span class="material-symbols-rounded text-[18px]">cached</span> Change
                                    </button>
                                    <button onclick="editQuestion('<%= q._id %>')" class="btn-action bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black">
                                        <span class="material-symbols-rounded text-[18px]">edit_note</span> Edit
                                    </button>
                                    <button onclick="deleteQuestion('<%= q._id %>')" class="btn-action bg-rose-50 dark:bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white border border-rose-100 dark:border-rose-500/20">
                                        <span class="material-symbols-rounded text-[18px]">delete_sweep</span> Delete
                                    </button>
                                </div>
                            </div>

                            <% if (!q.questionText) { %>
                                <!-- In-line Edit Form for Empty Placeholders -->
                                <div class="space-y-6 animate-pulse-subtle">
                                    <div class="p-6 rounded-2xl bg-amber-50/50 dark:bg-amber-500/5 border border-amber-100 dark:border-amber-500/20">
                                        <div class="flex items-center justify-between mb-4">
                                            <div class="flex items-center gap-3">
                                                <span class="material-symbols-rounded text-amber-500">edit_square</span>
                                                <span class="text-[11px] font-bold text-amber-600 tracking-tight">Direct Entry Mode: Compose your question below</span>
                                            </div>
                                            <!-- Type & Marks Badge -->
                                            <div class="flex items-center gap-2">
                                                <div class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 text-[9px] font-bold uppercase tracking-widest shadow-sm">
                                                    <% 
                                                        const marks = { 'MCQ': 1, 'Short': 1, 'Medium': 2, 'Comprehension': 4 };
                                                        const val = marks[q.questionType] || 1;
                                                    %>
                                                    <%= val %> <%= val > 1 ? 'Marks' : 'Mark' %>
                                                </div>
                                                <div class="px-3 py-1 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[9px] font-black uppercase tracking-widest shadow-sm">
                                                    <%= q.questionType %>
                                                </div>
                                            </div>
                                        </div>
                                        <textarea onchange="updatePlaceholder('<%= q._id %>', 'questionText', this.value)" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-[14px] font-bold outline-none focus:border-primary transition-all mb-4" rows="2" placeholder="Write the question here..."></textarea>
                                        
                                        <% if (q.questionType === 'MCQ') { %>
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                                <% [0,1,2,3].forEach(i => { %>
                                                    <input type="text" onchange="updatePlaceholderOption('<%= q._id %>', <%= i %>, this.value)" placeholder="Option <%= String.fromCharCode(65+i) %>" class="h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <textarea onchange="updatePlaceholder('<%= q._id %>', 'correctAnswer', this.value)" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all mb-4" rows="1" placeholder="Expected answer..."></textarea>
                                        <% } %>
                                        
                                        <button onclick="editQuestion('<%= q._id %>')" class="h-10 px-6 bg-amber-500 text-white rounded-xl font-bold text-[11px] hover:bg-amber-600 transition-all shadow-lg shadow-amber-500/20">
                                            Save & Finalize Vector
                                        </button>
                                    </div>
                                </div>
                            <% } else { %>
                                <h2 class="text-2xl font-bold text-slate-900 dark:text-white leading-[1.3] mb-8 max-w-3xl">
                                    <%= q.questionText %>
                                </h2>

                                <div class="mb-8">
                                    <% if (q.questionType === 'MCQ' || !q.questionType) { %>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <% (q.options || []).forEach((opt, optIdx) => { %>
                                                <div class="flex items-center gap-4 p-5 rounded-2xl border transition-all <%= optIdx === q.correctAnswerIndex ? 'bg-emerald-50/50 border-emerald-100 dark:bg-emerald-500/5 dark:border-emerald-500/20' : 'bg-slate-50/30 border-slate-100 dark:bg-slate-800/20 dark:border-slate-800' %>">
                                                    <div class="option-dot <%= optIdx === q.correctAnswerIndex ? 'correct' : '' %>">
                                                        <%= String.fromCharCode(65 + optIdx) %>
                                                    </div>
                                                    <span class="text-sm font-bold <%= optIdx === q.correctAnswerIndex ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-600 dark:text-slate-400' %>"><%= opt %></span>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-800">
                                            <div class="flex items-center gap-3 mb-3">
                                                <span class="text-[10px] font-bold text-violet-500">Expected Response</span>
                                                <div class="px-2 py-0.5 rounded-full bg-violet-500/10 text-violet-500 text-[9px] font-bold"><%= q.questionType %></div>
                                            </div>
                                            <p class="text-sm font-bold text-slate-600 dark:text-slate-300"><%= q.correctAnswer || 'No specific answer provided.' %></p>
                                        </div>
                                    <% } %>
                                </div>

                                <% if(q.explanation) { %>
                                    <div class="p-6 rounded-[1.8rem] bg-blue-50/30 dark:bg-blue-500/5 border border-blue-100/50 dark:border-blue-100/50 dark:border-blue-500/10 flex items-start gap-5">
                                        <div class="size-10 rounded-xl bg-white dark:bg-slate-800 flex items-center justify-center text-blue-500 shadow-sm">
                                            <span class="material-symbols-rounded text-xl">psychology</span>
                                        </div>
                                        <div class="space-y-1">
                                            <span class="text-[10px] font-bold text-blue-500">Pedagogical Logic</span>
                                            <p class="text-[13px] font-bold text-slate-600 dark:text-slate-400 leading-relaxed"><%= q.explanation %></p>
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <!-- Empty state handled by JS list or initial render -->
                <% if (quiz.questions.length === 0) { %>
                    <div class="py-32 flex flex-col items-center justify-center text-center">
                        <div class="size-24 rounded-[2.5rem] bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-300 mb-8 border border-slate-200 dark:border-slate-700">
                            <span class="material-symbols-rounded text-5xl">quiz</span>
                        </div>
                        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">Studio Empty</h2>
                        <p class="text-slate-500 dark:text-slate-400 font-bold mb-10 max-w-xs">Start building your assessment by adding the first evaluation vector.</p>
                        <button onclick="openAddModal()" class="h-14 px-10 bg-primary text-white rounded-[1.5rem] font-bold text-[13px] shadow-2xl shadow-primary/30 hover:scale-105 transition-all active:scale-95">
                            Initialize First Vector
                        </button>
                    </div>
                <% } %>
            </div>
            
            <!-- Safe Space -->
            <div class="h-10"></div>

            <!-- Final Launch Control -->
            <div class="max-w-5xl mx-auto mb-32 flex justify-center">
                <button onclick="preFlightCheck()" class="h-16 px-16 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl font-bold text-[14px] hover:scale-105 transition-all shadow-2xl shadow-slate-900/20">
                    Launch Exam
                </button>
            </div>

            <div class="h-20"></div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const questionsData = <%- JSON.stringify(quiz.questions) %>;
        const quizId = '<%= quiz._id %>';

        function openAddModal() {
            Swal.fire({
                title: 'New Evaluation Vector',
                html: `
                    <div class="space-y-4 text-left p-1">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Type of Vector</label>
                            <select id="swal-type" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer" onchange="toggleModalFields()">
                                <option value="MCQ">Multiple Choice (MCQ)</option>
                                <option value="Short">Short Question</option>
                                <option value="Medium">Medium Question</option>
                                <option value="Comprehension">Comprehension</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">The Proposition</label>
                            <textarea id="swal-question" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="3" placeholder="Enter question text..."></textarea>
                        </div>
                        <div id="mcq-fields" class="space-y-4">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option A</label>
                                    <input id="swal-opt-0" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option B</label>
                                    <input id="swal-opt-1" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option C</label>
                                    <input id="swal-opt-2" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option D</label>
                                    <input id="swal-opt-3" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                                </div>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Correct Matrix</label>
                                <select id="swal-correct-idx" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer">
                                    <option value="0">Option A (Alpha)</option>
                                    <option value="1">Option B (Beta)</option>
                                    <option value="2">Option C (Gamma)</option>
                                    <option value="3">Option D (Delta)</option>
                                </select>
                            </div>
                        </div>
                        <div id="non-mcq-fields" class="hidden">
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Target Response</label>
                            <textarea id="swal-correct-text" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2" placeholder="Enter expected answer..."></textarea>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Solution Logic</label>
                            <textarea id="swal-explanation" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2" placeholder="Explain the correct answer..."></textarea>
                        </div>
                    </div>
                `,
                width: '560px',
                showCancelButton: true,
                confirmButtonText: 'Deploy Vector',
                confirmButtonColor: '#000000',
                cancelButtonColor: '#94a3b8',
                preConfirm: () => {
                    const type = document.getElementById('swal-type').value;
                    const data = {
                        questionType: type,
                        questionText: document.getElementById('swal-question').value,
                        explanation: document.getElementById('swal-explanation').value
                    };
                    
                    if (type === 'MCQ') {
                        data.options = [
                            document.getElementById('swal-opt-0').value,
                            document.getElementById('swal-opt-1').value,
                            document.getElementById('swal-opt-2').value,
                            document.getElementById('swal-opt-3').value
                        ];
                        data.correctAnswerIndex = parseInt(document.getElementById('swal-correct-idx').value);
                    } else {
                        data.correctAnswer = document.getElementById('swal-correct-text').value;
                    }

                    if(!data.questionText) {
                        Swal.showValidationMessage('Please fulfill required fields');
                    }
                    return data;
                }
            }).then(result => {
                if(result.isConfirmed) saveQuestion(result.value);
            });
        }

        function toggleModalFields() {
            const type = document.getElementById('swal-type').value;
            const mcqFields = document.getElementById('mcq-fields');
            const nonMcqFields = document.getElementById('non-mcq-fields');
            
            if (type === 'MCQ') {
                mcqFields.classList.remove('hidden');
                nonMcqFields.classList.add('hidden');
            } else {
                mcqFields.classList.add('hidden');
                nonMcqFields.classList.remove('hidden');
            }
        }

        async function saveQuestion(data) {
            try {
                const response = await fetch(`/admin/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Failed to deploy vector', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function editQuestion(qid) {
            const q = questionsData.find(x => x._id === qid);
            if(!q) return;

            const isMCQ = q.questionType === 'MCQ' || !q.questionType;

            Swal.fire({
                title: 'Update Evaluation Vector',
                html: `
                    <div class="space-y-4 text-left p-1">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Type of Vector</label>
                            <select id="swal-type" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer" onchange="toggleModalFields()">
                                <option value="MCQ" ${q.questionType === 'MCQ' ? 'selected' : ''}>Multiple Choice (MCQ)</option>
                                <option value="Short" ${q.questionType === 'Short' ? 'selected' : ''}>Short Question</option>
                                <option value="Medium" ${q.questionType === 'Medium' ? 'selected' : ''}>Medium Question</option>
                                <option value="Comprehension" ${q.questionType === 'Comprehension' ? 'selected' : ''}>Comprehension</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">The Proposition</label>
                            <textarea id="swal-question" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="3">${q.questionText}</textarea>
                        </div>
                        <div id="mcq-fields" class="${isMCQ ? '' : 'hidden'} space-y-4">
                            <div class="grid grid-cols-2 gap-4">
                                <div><label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option A</label><input id="swal-opt-0" value="${q.options && q.options[0] ? q.options[0] : ''}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                                <div><label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option B</label><input id="swal-opt-1" value="${q.options && q.options[1] ? q.options[1] : ''}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                                <div><label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option C</label><input id="swal-opt-2" value="${q.options && q.options[2] ? q.options[2] : ''}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                                <div><label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Option D</label><input id="swal-opt-3" value="${q.options && q.options[3] ? q.options[3] : ''}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Correct Matrix</label>
                                <select id="swal-correct-idx" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer">
                                    <option value="0" ${q.correctAnswerIndex === 0 ? 'selected' : ''}>Option A (Alpha)</option>
                                    <option value="1" ${q.correctAnswerIndex === 1 ? 'selected' : ''}>Option B (Beta)</option>
                                    <option value="2" ${q.correctAnswerIndex === 2 ? 'selected' : ''}>Option C (Gamma)</option>
                                    <option value="3" ${q.correctAnswerIndex === 3 ? 'selected' : ''}>Option D (Delta)</option>
                                </select>
                            </div>
                        </div>
                        <div id="non-mcq-fields" class="${isMCQ ? 'hidden' : ''}">
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Target Response</label>
                            <textarea id="swal-correct-text" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2">${q.correctAnswer || ''}</textarea>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Solution Logic</label>
                            <textarea id="swal-explanation" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2">${q.explanation || ''}</textarea>
                        </div>
                    </div>
                `,
                width: '560px',
                showCancelButton: true,
                confirmButtonText: 'Update Vector',
                confirmButtonColor: '#000000',
                preConfirm: () => {
                    const type = document.getElementById('swal-type').value;
                    const data = {
                        questionType: type,
                        questionText: document.getElementById('swal-question').value,
                        explanation: document.getElementById('swal-explanation').value
                    };
                    if (type === 'MCQ') {
                        data.options = [
                            document.getElementById('swal-opt-0').value,
                            document.getElementById('swal-opt-1').value,
                            document.getElementById('swal-opt-2').value,
                            document.getElementById('swal-opt-3').value
                        ];
                        data.correctAnswerIndex = parseInt(document.getElementById('swal-correct-idx').value);
                    } else {
                        data.correctAnswer = document.getElementById('swal-correct-text').value;
                    }
                    return data;
                }
            }).then(result => {
                if(result.isConfirmed) updateQuestion(qid, result.value);
            });
        }

        async function updateQuestion(qid, data) {
            try {
                const response = await fetch(`/admin/quiz/${quizId}/question/${qid}/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Update failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function deleteQuestion(qid) {
            const res = await Swal.fire({
                title: 'Destroy Vector?',
                text: 'This removal is permanent.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Permanently Delete'
            });
            if (res.isConfirmed) {
                try {
                    const response = await fetch(`/admin/quiz/${quizId}/question/${qid}/delete`, { method: 'POST' });
                    if ((await response.json()).success) {
                        document.getElementById(`q-${qid}`).classList.add('fade-out', 'translate-x-4');
                        setTimeout(() => location.reload(), 300);
                    }
                } catch (err) { Swal.fire('Error', 'Failed to delete', 'error'); }
            }
        }

        function openBulkModal() {
            Swal.fire({
                title: 'Matrix Bulk Import',
                html: `
                    <div class="text-left">
                        <p class="text-[11px] font-bold text-slate-500 mb-4">Protocol: Question ### Opt1 ### Opt2 ### Opt3 ### Opt4 ### CorrectIndex (0-3) ### Explanation</p>
                        <textarea id="swal-bulk" class="w-full p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[11px] font-mono outline-none focus:border-primary" rows="10" placeholder="Question ### A ### B ### C ### D ### 0 ### Logic..."></textarea>
                    </div>
                `,
                width: '800px',
                showCancelButton: true,
                confirmButtonText: 'Initialize Protocol',
                confirmButtonColor: '#000000'
            }).then(result => {
                if(result.isConfirmed) {
                    const raw = document.getElementById('swal-bulk').value;
                    processBulk(raw);
                }
            });
        }

        async function processBulk(raw) {
            const lines = raw.split('\n').filter(l => l.trim().includes('###'));
            if(lines.length === 0) return;
            
            Swal.fire({ title: 'Processing Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            let count = 0;
            for(const line of lines) {
                const parts = line.split('###').map(p => p.trim());
                if(parts.length < 2) continue;

                let data = {};
                // If 6 or more parts, assume MCQ (Question ### OptA ### OptB ### OptC ### OptD ### CorrectIdx ### Explanation)
                if (parts.length >= 6) {
                    data = {
                        questionType: 'MCQ',
                        questionText: parts[0],
                        options: [parts[1], parts[2], parts[3], parts[4]],
                        correctAnswerIndex: parseInt(parts[5]),
                        explanation: parts[6] || ''
                    };
                } else {
                    // Assume Short/Other (Question ### Answer ### Explanation ### Type)
                    data = {
                        questionType: parts[3] || 'Short',
                        questionText: parts[0],
                        correctAnswer: parts[1],
                        explanation: parts[2] || ''
                    };
                }

                await fetch(`/admin/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                count++;
            }
            Swal.fire('Success', `${count} Vectors Deployed`, 'success').then(() => location.reload());
        }
        async function replaceQuestion(qid) {
            try {
                Swal.fire({ title: 'Swapping Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const response = await fetch(`/admin/quiz/${quizId}/question/${qid}/replace`, { method: 'POST' });
                const data = await response.json();
                if(data.success) location.reload();
                else Swal.fire('Notice', data.error || 'No replacement found', 'info');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function regenerateSmart() {
            const topic = document.getElementById('reg-topic').value;
            const board = document.getElementById('reg-board').value;

            try {
                const res = await Swal.fire({
                    title: 'Initiate Bulk Swap?',
                    text: 'This will attempt to replace all questions with random ones matching your criteria.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Deploy Protocol'
                });

                if (res.isConfirmed) {
                    Swal.fire({ title: 'Re-calculating Matrices...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    const response = await fetch(`/admin/quiz/${quizId}/bulk-replace`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ topic, board })
                    });
                    if((await response.json()).success) location.reload();
                    else Swal.fire('Error', 'Bulk swap failed', 'error');
                }
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }
        function updatePlaceholder(qid, field, value) {
            const q = questionsData.find(x => x._id === qid);
            if(q) q[field] = value;
        }

        function updatePlaceholderOption(qid, index, value) {
            const q = questionsData.find(x => x._id === qid);
            if(q) {
                if(!q.options) q.options = ['', '', '', ''];
                q.options[index] = value;
            }
        }
        async function injectSmartQuestions() {
            const type = document.getElementById('inj-type').value;
            const count = document.getElementById('inj-count').value;
            const topic = document.getElementById('inj-topic').value;

            try {
                Swal.fire({ title: 'Injecting Vectors...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const response = await fetch(`/admin/quiz/${quizId}/inject-questions`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type, count, topic })
                });
                const data = await response.json();
                if(data.success) {
                    Swal.fire('Success', `${data.count} questions added to quiz.`, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Notice', data.error || 'Failed to inject questions.', 'info');
                }
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }
        async function fetchTopics() {
            try {
                const classLevel = '<%= quiz.classLevel || "" %>';
                const subject = '<%= quiz.subject || "" %>';
                const response = await fetch(`/admin/api/bank-topics?classLevel=${classLevel}&subject=${subject}`);
                const data = await response.json();
                if(data.success) {
                    const list = document.getElementById('inj-topic');
                    const currentVal = list.value;
                    list.innerHTML = '<option value="">All Topics</option>' + data.topics.map(t => `<option value="${t}" ${t === currentVal ? 'selected' : ''}>${t}</option>`).join('');
                }
            } catch (err) { console.error('Failed to fetch topics'); }
        }

        async function fetchBankPreview() {
            const container = document.getElementById('bank-preview-container');
            const type = document.getElementById('inj-type').value;
            const topic = document.getElementById('inj-topic').value;
            
            container.innerHTML = '<div class="col-span-full py-12 flex flex-col items-center justify-center text-slate-400"><span class="material-symbols-rounded animate-spin text-4xl mb-2">sync</span><p class="text-[11px] font-bold">Scanning bank...</p></div>';

            try {
                const classLevel = '<%= quiz.classLevel || "" %>';
                const subject = '<%= quiz.subject || "" %>';
                const response = await fetch(`/admin/api/bank-preview?classLevel=${classLevel}&subject=${subject}&type=${type}&topic=${topic}`);
                const data = await response.json();
                
                if(data.success && data.questions.length > 0) {
                    container.innerHTML = data.questions.map(q => `
                        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-emerald-500/30 transition-all group">
                            <div class="flex items-start justify-between mb-4">
                                <span class="text-[9px] font-bold text-emerald-500 uppercase tracking-tighter">${q.topic || 'General'}</span>
                                <button onclick='collectSpecificQuestion(${JSON.stringify(q).replace(/'/g, "&apos;")})' class="size-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center hover:scale-110 transition-all shadow-lg shadow-emerald-500/20">
                                    <span class="material-symbols-rounded text-[18px]">add</span>
                                </button>
                            </div>
                            <p class="text-[12px] font-bold text-slate-700 dark:text-slate-300 line-clamp-2">${q.questionText}</p>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = '<div class="col-span-full py-12 flex flex-col items-center justify-center text-slate-400"><span class="material-symbols-rounded text-4xl mb-2">sentiment_dissatisfied</span><p class="text-[11px] font-bold">No matching matrices found.</p></div>';
                }
            } catch (err) { container.innerHTML = '<p class="text-rose-500 text-[11px] font-bold p-4">Sync Error</p>'; }
        }

        async function collectSpecificQuestion(qData) {
            try {
                Swal.fire({ title: 'Collecting Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const response = await fetch(`/admin/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(qData)
                });
                const data = await response.json();
                if(data.success) location.reload();
                else Swal.fire('Error', data.error, 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        window.onload = async () => {
            await fetchTopics();
            fetchBankPreview();
        };
        function preFlightCheck() {
            // Check for empty questions or missing answers
            const incomplete = questionsData.filter(q => {
                const noText = !q.questionText;
                let noAnswer = false;
                if (q.questionType === 'MCQ') {
                    noAnswer = q.correctAnswerIndex === undefined || q.correctAnswerIndex === null;
                } else {
                    noAnswer = !q.correctAnswer;
                }
                return noText || noAnswer;
            });
            
            if (incomplete.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Integrity Failure',
                    text: `You have ${incomplete.length} evaluation vectors missing text or answers. Please verify all data points before launching.`,
                    confirmButtonColor: '#e11d48'
                });
                return;
            }

            Swal.fire({
                html: `
                    <div class="text-left space-y-5 p-2">
                        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                            <p class="text-[11px] font-bold text-slate-400 mb-3 tracking-tight">Assessment Overview</p>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <span class="block text-[10px] font-bold text-slate-500 mb-0.5">Total questions</span>
                                    <span class="text-sm font-bold text-slate-900 dark:text-white">${questionsData.length} Items</span>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-bold text-slate-500 mb-0.5">Duration</span>
                                    <span class="text-sm font-bold text-slate-900 dark:text-white"><%= quiz.duration %> Minutes</span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2 ml-1">Schedule release (Optional)</label>
                            <input type="datetime-local" id="swal-schedule" class="w-full h-12 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                            <p class="mt-2 text-[10px] font-medium text-slate-400 ml-1">* Exam will be visible for 12 hours from release time.</p>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Confirm Launch',
                cancelButtonText: 'Abort',
                confirmButtonColor: '#000000',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const scheduledAt = document.getElementById('swal-schedule').value;
                    
                    try {
                        Swal.fire({ title: 'Deploying Exam...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                        const response = await fetch(`/admin/quiz/${quizId}/finalize-launch`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ scheduledAt })
                        });
                        const data = await response.json();
                        
                        if(data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Exam Launched',
                                text: 'Deployment successful. Redirection to command center...',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/admin/quizzes';
                            });
                        } else {
                            Swal.fire('Error', data.error || 'Failed to launch', 'error');
                        }
                    } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
                }
            });
        }
    </script>
</body>
</html>
