<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Instructors Directory | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .action-btn { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .action-btn:hover { transform: translateY(-1px); }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'academic' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Instructors Directory' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-4">
                    <!-- Filters Bar -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <div class="relative flex-1 max-w-[500px] flex items-center">
                                <input type="text" id="teacherSearch" onkeyup="filterTeachers()" placeholder="Search instructors by name..." class="w-full pl-3 pr-10 h-10 rounded-xl bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                            </div>
                            
                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-md flex items-center transition-all">
                                <span class="text-[11px] font-bold text-primary">Active Faculty: <span><%= teachers.length %></span></span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportToCSV()" class="h-10 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse" id="teachersTable">
                            <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[64px] z-20">
                                <tr>
                                    <th class="pl-4 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">Instructor Profile</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Courses</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Classes</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Notes</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Q's Added</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Questions Answered</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Rating</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-center">Status</th>
                                    <th class="pr-4 py-2 text-[10px] font-bold text-slate-500 tracking-wider text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% if(teachers && teachers.length > 0){ %>
                                    <% teachers.forEach(item => { %>
                                        <tr class="teacher-row hover:bg-slate-50 dark:hover:bg-white/5 transition-all cursor-default group">
                                            <td class="pl-4 pr-3 py-3">
                                                <div class="flex items-center gap-3">
                                                    <div class="size-9 rounded-md overflow-hidden bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-100 dark:border-blue-500/20 shadow-sm">
                                                        <% if (item.profilePicture) { %>
                                                            <img src="<%= item.profilePicture %>" class="size-full object-cover">
                                                        <% } else { %>
                                                            <span class="text-xs font-black"><%= item.name ? item.name.charAt(0).toUpperCase() : 'T' %></span>
                                                        <% } %>
                                                    </div>
                                                    <div class="flex flex-col">
                                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight"><%= item.name %></p>
                                                        <p class="text-[9px] text-slate-400 font-bold tracking-tight"><%= item.email %></p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.totalCourses %></span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.classesUploaded %></span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.notesUploaded %></span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.questionsAdded %></span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">
                                                    <%= item.qaResolved %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <div class="flex items-center justify-center gap-1">
                                                    <span class="material-symbols-rounded text-sm text-amber-500">star</span>
                                                    <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.rating %></span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <% if (item.status === 'suspended') { %>
                                                    <span class="px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[9px] font-bold border border-rose-100 dark:border-rose-500/20">Restricted</span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Active</span>
                                                <% } %>
                                            </td>
                                            <td class="pr-4 py-3 text-right">
                                                <div class="flex items-center justify-end gap-1.5">
                                                    <a href="/admin/user/<%= item.instructor %>" class="action-btn size-7 rounded bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white flex items-center justify-center shadow-sm" title="View Profile">
                                                        <span class="material-symbols-rounded text-sm">visibility</span>
                                                    </a>
                                                    <button onclick="openRestrictModal('<%= item.instructor %>', '<%= item.name %>')" class="action-btn size-7 rounded bg-amber-50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 text-amber-500 hover:bg-amber-500 hover:text-white flex items-center justify-center shadow-sm" title="Restrict Access">
                                                        <span class="material-symbols-rounded text-sm">block</span>
                                                    </button>
                                                    <button onclick="confirmDelete('<%= item.instructor %>', '<%= item.name %>')" class="action-btn size-7 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white flex items-center justify-center shadow-sm" title="Delete User">
                                                        <span class="material-symbols-rounded text-sm">delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9" class="px-4 py-12 text-center text-slate-400">
                                            <span class="material-symbols-rounded text-3xl mb-2 opacity-40">school</span>
                                            <p class="text-[11px] font-bold">No instructors found</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function filterTeachers() {
            const input = document.getElementById('teacherSearch');
            const filter = input.value.toLowerCase();
            const table = document.getElementById('teachersTable');
            const tr = table.getElementsByTagName('tr');

            for (let i = 1; i < tr.length; i++) {
                const nameCol = tr[i].getElementsByTagName('td')[0];
                if (nameCol) {
                    const txtValue = nameCol.textContent || nameCol.innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        async function openRestrictModal(id, name) {
            const { value: formValues } = await Swal.fire({
                title: `<p class="text-[15px] font-black tracking-tight">Restrict ${name}</p>`,
                html:
                    `<div class="flex flex-col gap-3 p-2">
                        <div class="text-left">
                            <label class="text-[11px] font-bold text-slate-500 ml-1">Duration (Days)</label>
                            <input id="swal-duration" type="number" value="7" min="1" class="w-full h-11 px-4 mt-1 rounded-xl bg-slate-50 border border-slate-200 text-[13px] font-bold outline-none focus:border-primary">
                        </div>
                        <div class="text-left">
                            <label class="text-[11px] font-bold text-slate-500 ml-1">Reason for Restriction</label>
                            <textarea id="swal-reason" class="w-full p-4 mt-1 rounded-xl bg-slate-50 border border-slate-200 text-[13px] font-bold outline-none focus:border-primary min-h-[100px]" placeholder="Violation of terms..."></textarea>
                        </div>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: 'Apply Restriction',
                confirmButtonColor: '#f59e0b',
                focusConfirm: false,
                preConfirm: () => {
                    return {
                        duration: document.getElementById('swal-duration').value,
                        reason: document.getElementById('swal-reason').value
                    }
                }
            });

            if (formValues) {
                try {
                    const response = await fetch(`/admin/users/${id}/restrict`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formValues)
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({ title: 'Success', text: 'User has been restricted.', icon: 'success', timer: 1500, showConfirmButton: false });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', data.error || 'Failed to restrict user', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Network error occurred', 'error');
                }
            }
        }

        async function confirmDelete(id, name) {
            const result = await Swal.fire({
                title: `<p class="text-[15px] font-black tracking-tight">Delete ${name}?</p>`,
                text: 'This will permanently remove the instructor account.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, Delete Permanently'
            });

            if (result.isConfirmed) {
                window.location.href = `/admin/users/${id}/delete`;
            }
        }

        function exportToCSV() {
            const rows = [['Instructor', 'Courses', 'Classes', 'Notes', 'Questions', 'Solved', 'Rating', 'Status']];
            document.querySelectorAll('.teacher-row').forEach(tr => {
                const name = tr.querySelectorAll('p')[0].innerText;
                const courses = tr.querySelectorAll('span')[0].innerText;
                const classes = tr.querySelectorAll('span')[1].innerText;
                const notes = tr.querySelectorAll('span')[2].innerText;
                const questions = tr.querySelectorAll('span')[3].innerText;
                const solved = tr.querySelectorAll('span')[4].innerText;
                const rating = tr.querySelectorAll('span')[5].innerText;
                const status = tr.querySelectorAll('span')[6].innerText;
                rows.push([name, courses, classes, notes, questions, solved, rating, status]);
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "instructor_roster.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function toggleAdminSidebar() { 
            const sidebar = document.getElementById('adminSidebar');
            sidebar.classList.toggle('-translate-x-full');
        }
    </script>
</body>

</html>
