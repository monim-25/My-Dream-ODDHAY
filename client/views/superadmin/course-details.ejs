<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>
            <%= course.title %> | ODDHAY Command Center
        </title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                overflow-y: auto;
                padding: 0;
                position: relative;
            }

            @keyframes slide-up {
                from {
                    transform: translateY(20px);
                    opacity: 0;
                }

                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            .animate-slide-up {
                animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .tab-btn.active {
                color: #137fec;
                border-bottom: 2px solid #137fec;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 4px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #e2e8f0;
                border-radius: 10px;
            }

            .dark .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #1e293b;
            }
        </style>
</head>

<body class="bg-[#EFF3F8] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'courses' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#EFF3F8]">
            <%- include('header_v2', { pageTitle: 'Course History' }) %>

                <div
                    class="content-scroll flex flex-col gap-[1px] p-[1px] border-l border-slate-900/10 dark:border-white/5 bg-[#EFF3F8] custom-scrollbar">

                    <!-- Main Combined Container -->
                    <div id="tabs-container"
                        class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-lg shadow-sm mb-3">

                        <!-- Hero Section -->
                        <div class="p-6 border-b border-slate-900/5 dark:border-white/5">
                            <div class="flex flex-col lg:flex-row gap-8 items-start">
                                <!-- Course Thumbnail -->
                                <div class="w-full lg:w-[320px] shrink-0">
                                    <div
                                        class="aspect-video rounded-[2rem] overflow-hidden bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/5 relative group flex items-center justify-center">
                                        <img src="<%= course.thumbnail || '/images/course-default.png' %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                            onerror="this.src='/images/course-default.png'">
                                    </div>
                                </div>

                                <!-- Course Info -->
                                <div class="flex-1 space-y-2">
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <h1 class="text-3xl font-bold text-slate-800 dark:text-white leading-tight">
                                            <%= course.title %>
                                        </h1>
                                        <span
                                            class="px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 text-xs font-bold border border-emerald-100 dark:border-emerald-500/20 capitalize shrink-0">
                                            <%= course.accessType %>
                                        </span>
                                        <span
                                            class="px-4 py-1.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 text-xs font-bold border border-blue-100 dark:border-blue-500/20 capitalize shrink-0">
                                            <%= course.category %>
                                        </span>
                                    </div>

                                    <p
                                        class="text-slate-600 dark:text-slate-400 text-base leading-relaxed max-w-2xl line-clamp-2">
                                        <%= course.description
                                            || 'Exploring classic Bengali literature. This course represents the intelligence standard for academic excellence.'
                                            %>
                                    </p>

                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 pt-1">
                                        <div
                                            class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Class Level</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight">
                                                <%= course.classLevel %>
                                            </p>
                                        </div>
                                        <div
                                            class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Active Students</p>
                                            <p class="text-xs font-bold text-primary leading-tight">
                                                <%= stats.studentCount %>
                                            </p>
                                        </div>
                                        <div
                                            class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Registration Fee</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight">
                                                <%= course.accessType==='free' ? 'Free' : '৳ ' +
                                                    (course.plans?.[0]?.price || 'N/A' ) %>
                                            </p>
                                        </div>
                                        <div
                                            class="p-2.5 rounded-xl bg-[#EFF3F8] dark:bg-white/5 border border-slate-900/5 dark:border-white/10">
                                            <p class="text-[10px] font-bold text-slate-500 mb-0.5">Primary Subject</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-white leading-tight">
                                                <%= course.subject %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabs + Content Section -->
                        <div>
                            <!-- Tabs Navigation -->
                            <div id="tabs-nav-bar"
                                class="sticky top-[1px] z-50 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-6 border-b border-slate-900/5 dark:border-white/5">
                                <div class="flex items-center gap-10">
                                    <button onclick="switchTab('details')"
                                        class="tab-btn active py-3.5 text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-primary"
                                        id="tab-details">Details</button>
                                    <button onclick="switchTab('instructor')"
                                        class="tab-btn py-3.5 text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-primary"
                                        id="tab-instructor">Instructor</button>
                                    <button onclick="switchTab('content')"
                                        class="tab-btn py-3.5 text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-primary"
                                        id="tab-content">Course Content</button>
                                    <button onclick="switchTab('students')"
                                        class="tab-btn py-3.5 text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-primary"
                                        id="tab-students">Enrolled Student</button>
                                    <button onclick="switchTab('exams')"
                                        class="tab-btn py-3.5 text-sm font-bold text-slate-600 dark:text-slate-300 transition-all border-b-2 border-transparent hover:text-primary"
                                        id="tab-exams">Examination</button>
                                </div>
                            </div>

                            <!-- Tab Panes -->
                            <div class="p-6 pb-16">

                                <!-- Details Tab -->
                                <div id="pane-details" class="tab-pane animate-slide-up">
                                    <div
                                        class="p-6 rounded-xl bg-[#F8FAFC] dark:bg-white/5 border border-slate-900/5 dark:border-white/5 shadow-sm max-w-4xl">
                                        <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-4">Course
                                            Description</h3>
                                        <div
                                            class="prose prose-slate dark:prose-invert max-w-none text-slate-600 dark:text-slate-400">
                                            <p>
                                                <%= course.description
                                                    || 'No detailed description available for this course.' %>
                                            </p>
                                        </div>

                                        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <div>
                                                <h4 class="text-sm font-bold text-slate-800 dark:text-white mb-2">
                                                    Subject</h4>
                                                <p class="text-slate-600 dark:text-slate-400 capitalize">
                                                    <%= course.subject || 'N/A' %>
                                                </p>
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-bold text-slate-800 dark:text-white mb-2">Access
                                                    Plan</h4>
                                                <p class="text-slate-600 dark:text-slate-400 capitalize">
                                                    <%= course.accessType %>
                                                </p>
                                            </div>
                                        </div>                                        <div class="mt-8 pt-8 border-t border-slate-900/5 dark:border-white/5">
                                            <div class="flex items-center justify-between mb-4">
                                                <h3 class="text-xl font-bold text-slate-800 dark:text-white">Class Routine</h3>
                                                <% if (course.routineImage) { %>
                                                    <a href="<%= course.routineImage %>" 
                                                       download="<%= course.title %> class routine.png"
                                                       class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-all text-xs font-bold">
                                                        <span class="material-symbols-rounded text-[16px]">download</span>
                                                        Download Image
                                                    </a>
                                                <% } %>
                                            </div>
                                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
                                                <% 
                                                    const routineList = course.routine && course.routine.length > 0 ? course.routine : [];
                                                    const colorThemes = [
                                                        { bg: 'bg-blue-50 dark:bg-blue-500/10', text: 'text-blue-500', subText: 'text-blue-600 dark:text-blue-400' },
                                                        { bg: 'bg-purple-50 dark:bg-purple-500/10', text: 'text-purple-500', subText: 'text-purple-600 dark:text-purple-400' },
                                                        { bg: 'bg-emerald-50 dark:bg-emerald-500/10', text: 'text-emerald-500', subText: 'text-emerald-600 dark:text-emerald-400' },
                                                        { bg: 'bg-rose-50 dark:bg-rose-500/10', text: 'text-rose-500', subText: 'text-rose-600 dark:text-rose-400' },
                                                        { bg: 'bg-amber-50 dark:bg-amber-500/10', text: 'text-amber-500', subText: 'text-amber-600 dark:text-amber-400' },
                                                        { bg: 'bg-cyan-50 dark:bg-cyan-500/10', text: 'text-cyan-500', subText: 'text-cyan-600 dark:text-cyan-400' },
                                                        { bg: 'bg-indigo-50 dark:bg-indigo-500/10', text: 'text-indigo-500', subText: 'text-indigo-600 dark:text-indigo-400' }
                                                    ];
                                                %>
                                                <% if (routineList.length > 0) { %>
                                                    <% routineList.forEach((rt, idx) => { %>
                                                        <% const theme = colorThemes[idx % colorThemes.length]; %>
                                                        <div class="p-3 rounded-xl bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 shadow-sm flex items-start gap-3 overflow-hidden">
                                                            <div class="size-8 rounded-lg <%= theme.bg %> flex items-center justify-center <%= theme.text %> shrink-0">
                                                                <span class="material-symbols-rounded text-[18px]">calendar_month</span>
                                                            </div>
                                                            <div class="min-w-0 flex-1">
                                                                <h4 class="text-[13px] font-bold text-slate-800 dark:text-white truncate">
                                                                    <%= rt.day %> 
                                                                    <% if (rt.note) { %>
                                                                        <span class="text-slate-400 font-medium px-0.5">-</span> 
                                                                        <span class="<%= theme.subText %> capitalize"><%= rt.note %></span>
                                                                    <% } %>
                                                                </h4>
                                                                <p class="text-[11px] font-bold text-slate-500 mt-0.5">
                                                                    <%= rt.startTime || 'TBD' %> - <%= rt.endTime || 'TBD' %>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                <% } else { %>
                                                    <div class="col-span-full p-8 text-center bg-slate-50 dark:bg-white/5 rounded-xl border border-dashed border-slate-200 dark:border-slate-700">
                                                        <p class="text-xs font-bold text-slate-400">No routine slots defined yet.</p>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <% if (course.routineImage) { %>
                                                <!-- Routine image is only for download in this view, not embedded -->
                                            <% } %>
                                        </div>
>
                                    </div>
                                </div>

                                <!-- Instructor & Creator Tab -->
                                <div id="pane-instructor" class="tab-pane hidden animate-slide-up">
                                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                        <!-- Instructor Profile -->
                                        <div
                                            class="p-8 rounded-2xl bg-[#F8FAFC] dark:bg-white/5 border border-slate-900/5 dark:border-white/5 shadow-sm flex flex-col md:flex-row items-center text-center md:text-left gap-6">
                                            <div
                                                class="size-24 rounded-2xl overflow-hidden border-4 border-white dark:border-slate-800 shadow-sm shrink-0">
                                                <img src="<%= course.instructor?.profileImage || '/images/default-avatar.png' %>"
                                                    class="size-full object-cover">
                                            </div>
                                            <div class="flex-1 space-y-1">
                                                <p
                                                    class="text-[10px] font-black text-blue-500 uppercase tracking-widest mb-1">
                                                    Lead Instructor</p>
                                                <h3 class="text-xl font-black text-slate-800 dark:text-white">
                                                    <%= course.instructor?.name || 'Unassigned Instructor' %>
                                                </h3>
                                                <p class="text-sm font-bold text-slate-500">
                                                    <%= course.instructor?.email || 'N/A' %>
                                                </p>

                                                <div
                                                    class="flex items-center justify-center md:justify-start gap-1 pt-2 text-amber-400">
                                                    <span class="material-symbols-rounded text-[18px]">star</span>
                                                    <span class="material-symbols-rounded text-[18px]">star</span>
                                                    <span class="material-symbols-rounded text-[18px]">star</span>
                                                    <span class="material-symbols-rounded text-[18px]">star</span>
                                                    <span class="material-symbols-rounded text-[18px]">star_half</span>
                                                    <span class="text-xs font-bold text-slate-400 ml-1">4.8
                                                        Rating</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Creator/Admin Profile -->
                                        <% if (course.addedBy) { %>
                                            <a href="/superadmin/user/<%= course.addedBy._id %>"
                                                class="p-8 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/5 shadow-sm flex flex-col md:flex-row items-center text-center md:text-left gap-6 group hover:border-blue-500/50 transition-all">
                                                <div
                                                    class="size-24 rounded-2xl overflow-hidden border-4 border-white dark:border-slate-800 shadow-sm shrink-0">
                                                    <img src="<%= course.addedBy.profileImage || '/images/default-avatar.png' %>"
                                                        class="size-full object-cover">
                                                </div>
                                                <div class="flex-1 space-y-1">
                                                    <div
                                                        class="flex items-center justify-center md:justify-start gap-2 mb-1">
                                                        <p
                                                            class="text-[10px] font-black text-emerald-500 uppercase tracking-widest">
                                                            Course Creator</p>
                                                        <span
                                                            class="px-2 py-0.5 rounded bg-emerald-500 text-white text-[8px] font-black uppercase">Admin</span>
                                                    </div>
                                                    <h3
                                                        class="text-xl font-black text-slate-800 dark:text-white group-hover:text-blue-500 transition-colors">
                                                        <%= course.addedBy.name %>
                                                    </h3>
                                                    <p class="text-sm font-bold text-slate-500">
                                                        <%= course.addedBy.email %>
                                                    </p>

                                                    <div class="pt-4 flex items-center justify-center md:justify-start">
                                                        <span
                                                            class="text-[11px] font-bold text-slate-400 flex items-center gap-1.5">
                                                            <span
                                                                class="material-symbols-rounded text-sm">visibility</span>
                                                            View Admin Intelligence
                                                        </span>
                                                    </div>
                                                </div>
                                            </a>
                                            <% } else { %>
                                                <div
                                                    class="p-8 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/5 shadow-sm flex items-center justify-center text-center">
                                                    <div class="space-y-2">
                                                        <span
                                                            class="material-symbols-rounded text-slate-300 text-4xl">person_off</span>
                                                        <p class="text-xs font-bold text-slate-400">Creator information
                                                            not available</p>
                                                    </div>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>

                                <!-- Content Tab -->
                                <div id="pane-content" class="tab-pane hidden animate-slide-up space-y-4">
                                    <div class="mt-4">
                                        <% if (course.curriculumNodes && course.curriculumNodes.length > 0) { %>
                                            <%- include('../partials/curriculum-readonly', { course: course }) %>
                                        <% } else { %>
                                            <div class="p-8 text-center bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-100 dark:border-slate-800">
                                                <span class="material-symbols-rounded text-4xl text-slate-300 mb-2">folder_off</span>
                                                <p class="text-sm font-bold text-slate-500">No content available</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Students Tab -->
                                <div id="pane-students" class="tab-pane hidden animate-slide-up">
                                    <% if (course.accessType==='free' ) { %>
                                        <div
                                            class="p-12 rounded-xl bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 shadow-md text-center space-y-4 max-w-2xl mx-auto">
                                            <div
                                                class="size-16 rounded-full bg-emerald-50 flex items-center justify-center mx-auto">
                                                <span
                                                    class="material-symbols-rounded text-emerald-500 text-3xl">verified_user</span>
                                            </div>
                                            <div>
                                                <h3 class="text-2xl font-bold text-slate-800 dark:text-white">Free
                                                    Access Course</h3>
                                                <p class="text-slate-500 mt-2 text-sm leading-relaxed">This course is
                                                    automatically available to all students in <span
                                                        class="font-bold text-primary">
                                                        <%= course.classLevel %>
                                                    </span> within the ODDHAY Network. No individual enrollment
                                                    required.</p>
                                            </div>
                                        </div>
                                        <% } else { %>
                                            <div
                                                class="bg-white dark:bg-[#0b1120] rounded-xl border border-slate-200 dark:border-white/10 shadow-md overflow-hidden">
                                                <table class="w-full text-left">
                                                    <thead
                                                        class="bg-slate-50 dark:bg-white/5 border-b border-slate-200 dark:border-white/10">
                                                        <tr>
                                                            <th class="px-6 py-4 text-xs font-bold text-slate-500">
                                                                Student Name</th>
                                                            <th class="px-6 py-4 text-xs font-bold text-slate-500">
                                                                Enrolled At</th>
                                                            <th class="px-6 py-4 text-xs font-bold text-slate-500">
                                                                Progress</th>
                                                            <th
                                                                class="px-6 py-4 text-xs font-bold text-slate-500 text-right">
                                                                Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                                        <% students.forEach(student=> { %>
                                                            <tr
                                                                class="hover:bg-slate-50 dark:hover:bg-white/5 transition-colors">
                                                                <td class="px-6 py-4">
                                                                    <div class="flex items-center gap-3">
                                                                        <div
                                                                            class="size-10 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
                                                                            <img src="<%= student.profileImage || student.profilePicture || '/images/default-avatar.png' %>"
                                                                                class="size-full object-cover">
                                                                        </div>
                                                                        <div>
                                                                            <p
                                                                                class="text-sm font-bold text-slate-800 dark:text-white">
                                                                                <%= student.name %>
                                                                            </p>
                                                                            <p class="text-xs text-slate-500">
                                                                                <%= student.email %>
                                                                            </p>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td
                                                                    class="px-6 py-4 text-sm font-bold text-slate-600 dark:text-slate-400">
                                                                    <%= new
                                                                        Date(student.enrolledAt).toLocaleDateString() %>
                                                                </td>
                                                                <td class="px-6 py-4">
                                                                    <div class="w-full max-w-[120px] space-y-1.5">
                                                                        <div
                                                                            class="flex items-center justify-between text-xs">
                                                                            <span class="font-bold text-primary">
                                                                                <%= student.progress %>%
                                                                            </span>
                                                                        </div>
                                                                        <div
                                                                            class="h-1.5 w-full bg-slate-100 dark:bg-white/5 rounded-full overflow-hidden">
                                                                            <div class="h-full bg-primary"
                                                                                style="width: <%= student.progress %>%">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="px-6 py-4 text-right">
                                                                    <span
                                                                        class="px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold border border-emerald-100 dark:border-emerald-500/20">Active</span>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </div>

                                <!-- Exams Tab -->
                                <div id="pane-exams" class="tab-pane hidden animate-slide-up">
                                    <% if (stats.examCount===0) { %>
                                        <div
                                            class="p-8 rounded-xl bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 shadow-sm text-center space-y-3 max-w-2xl mx-auto">
                                            <div
                                                class="size-16 rounded-full bg-slate-50 dark:bg-white/5 flex items-center justify-center mx-auto">
                                                <span
                                                    class="material-symbols-rounded text-slate-400 text-3xl">history_edu</span>
                                            </div>
                                            <div>
                                                <h3 class="text-xl font-bold text-slate-800 dark:text-white">No Exams
                                                    Found</h3>
                                                <p class="text-slate-500 mt-2 text-sm">No exams or quizzes have been
                                                    assigned to this course yet.</p>
                                            </div>
                                        </div>
                                        <% } else { %>
                                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                                <% course.chapters.forEach(chapter=> { %>
                                                    <% chapter.quizzes.forEach(quiz=> { %>
                                                        <div
                                                            class="p-4 rounded-xl bg-[#F8FAFC] dark:bg-white/5 border border-slate-200 dark:border-white/10 shadow-sm group hover:shadow-md transition-all duration-300">
                                                            <div class="flex items-center gap-4">
                                                                <div
                                                                    class="size-12 rounded-xl bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center text-amber-500 shrink-0">
                                                                    <span
                                                                        class="material-symbols-rounded text-xl">psychology</span>
                                                                </div>
                                                                <div class="flex-1 min-w-0">
                                                                    <p
                                                                        class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-1">
                                                                        Assessment</p>
                                                                    <h3
                                                                        class="text-lg font-bold text-slate-800 dark:text-white truncate">
                                                                        <%= quiz.title %>
                                                                    </h3>
                                                                    <div class="flex items-center gap-4 pt-1">
                                                                        <div
                                                                            class="flex items-center gap-1.5 text-xs font-bold text-slate-500">
                                                                            <span
                                                                                class="material-symbols-rounded text-[14px]">timer</span>
                                                                            <%= quiz.duration || 10 %> Min
                                                                        </div>
                                                                        <div
                                                                            class="flex items-center gap-1.5 text-xs font-bold text-slate-500">
                                                                            <span
                                                                                class="material-symbols-rounded text-[14px]">quiz</span>
                                                                            <%= quiz.questions?.length || 0 %> Qs
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <a href="/superadmin/quiz-details/<%= quiz._id %>"
                                                                    class="size-10 rounded-full bg-slate-50 dark:bg-white/5 flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-all shrink-0">
                                                                    <span
                                                                        class="material-symbols-rounded">arrow_forward</span>
                                                                </a>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                            <% }) %>
                                            </div>
                                            <% } %>
                                </div>
                            </div>

                        </div>
        </main>
    </div>

    <script>
        function switchTab(tabId) {
            // Update buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`tab-${tabId}`).classList.add('active');

            // Update panes
            document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.add('hidden'));
            document.getElementById(`pane-${tabId}`).classList.remove('hidden');

            // Auto-scroll to the top of the tabs navigation bar
            const tabsNavBar = document.getElementById('tabs-nav-bar');
            if (tabsNavBar) {
                tabsNavBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function filterContent(type) {
            // Update filter buttons
            document.querySelectorAll('.content-filter').forEach(btn => {
                btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-800', 'dark:text-white', 'shadow-sm', 'active');
                btn.classList.add('text-slate-500');
            });
            event.target.classList.remove('text-slate-500');
            event.target.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-800', 'dark:text-white', 'shadow-sm', 'active');

            // Filter items
            const items = document.querySelectorAll('.asset-item');
            if (type === 'all') {
                items.forEach(i => i.classList.remove('hidden'));
            } else {
                items.forEach(i => {
                    if (i.classList.contains(`asset-${type}`)) i.classList.remove('hidden');
                    else i.classList.add('hidden');
                });
            }
        }
    </script>
</body>

</html>