<%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { name: 'Super Admin', theme: 'light' };
    const safeClasses = (typeof classes !== 'undefined' && Array.isArray(classes)) ? classes : [];
    const safeArchived = (typeof archivedClasses !== 'undefined' && Array.isArray(archivedClasses)) ? archivedClasses : [];
    const groupCount = safeClasses.filter(c => c.hasGroups).length;
%>
<!DOCTYPE html>
<html lang="en" class="<%= (safeUser.theme === 'dark') ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Academic Setup | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) {
            #adminSidebar { transform: translateX(-100%); }
            #adminSidebar.active { transform: translateX(0); }
            .admin-main { margin-left: 0; }
        }
        
        .drag-handle { cursor: grab; }
        .drag-handle:active { cursor: grabbing; }

        /* Custom toggle switch matching SuperAdmin Primary */
        .toggle-switch-checkbox:checked + .toggle-switch-label {
            background-color: #137fec;
        }
        .toggle-switch-checkbox:checked + .toggle-switch-label .toggle-switch-dot {
            transform: translateX(18px);
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased min-h-screen">

    <div class="flex">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-white/5">
            <%- include('sidebar_content', { active: 'academic-setup', user: safeUser }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#FFFFFF] dark:bg-[#020617] flex flex-col min-h-screen relative w-full">
            <%- include('header_v2', { pageTitle: 'Academic Setup', user: safeUser }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 flex-1">
                
                <!-- Action & Filter Bar (Sticky Header matching Command Center) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 px-3 sm:px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 sticky top-0 z-30 shadow-xs">
                    <!-- Tab Switcher -->
                    <div class="flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-md border border-slate-200 dark:border-slate-700/60">
                        <button type="button" id="tabActiveBtn" onclick="switchAcademicTab('active')"
                                class="px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs">
                            <span class="material-symbols-rounded text-[17px]">domain</span>
                            <span>Live Classes</span>
                            <span id="tabBadgeActive" class="px-1.5 py-0.5 rounded-full text-[10px] bg-primary/10 text-primary font-black leading-none"><%= safeClasses.length %></span>
                        </button>
                        <button type="button" id="tabArchiveBtn" onclick="switchAcademicTab('archive')"
                                class="px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white">
                            <span class="material-symbols-rounded text-[17px]">inventory_2</span>
                            <span>History Bucket</span>
                            <span id="tabBadgeArchive" class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-black leading-none"><%= safeArchived.length %></span>
                        </button>
                    </div>

                    <!-- Right Action Buttons -->
                    <div class="flex items-center gap-2">
                        <button type="button" id="addClassBtn"
                                class="h-9 px-3.5 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold flex items-center gap-1.5 transition-all border border-slate-200 dark:border-slate-700 shadow-xs">
                            <span class="material-symbols-rounded text-[18px] text-primary">add_circle</span>
                            <span>Add New Class</span>
                        </button>
                        <button type="button" onclick="openBatchAddSubjectModal()"
                                class="h-9 px-3.5 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold flex items-center gap-1.5 transition-all border border-slate-200 dark:border-slate-700 shadow-xs cursor-pointer">
                            <span class="material-symbols-rounded text-[18px] text-emerald-500">menu_book</span>
                            <span>Add Subject to Classes</span>
                        </button>
                        <button type="button" id="saveBtn"
                                class="h-9 px-4 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-bold flex items-center gap-1.5 shadow-sm shadow-primary/20 transition-all">
                            <span class="material-symbols-rounded text-[18px]">save</span>
                            <span>Save Changes</span>
                        </button>
                        <div id="archiveViewNotice" class="hidden items-center gap-1 px-3 py-1 rounded-md bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-semibold border border-amber-200/80 dark:border-amber-800/40">
                            <span class="material-symbols-rounded text-sm">info</span>
                            <span>History Bucket (Archived Classes)</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Active Classes Content View -->
                <div id="activeClassesView" class="p-3 sm:p-4 space-y-3">
                    <div id="classesContainer" class="grid grid-cols-1 gap-3">
                        <% safeClasses.forEach((cls, index) => { %>
                            <div class="class-item bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-md p-3.5 sm:p-4 shadow-xs transition-all hover:border-primary/40" data-id="<%= cls._id %>">
                                <div class="flex items-start gap-3">
                                    <!-- Drag Handle -->
                                    <div class="drag-handle text-slate-300 hover:text-primary dark:hover:text-primary mt-2 px-1 cursor-grab active:cursor-grabbing transition-colors shrink-0" title="Drag to reorder sequence">
                                        <span class="material-symbols-rounded text-2xl">drag_indicator</span>
                                    </div>

                                    <div class="flex-1 space-y-3">
                                        <!-- Top Row: Class Name, Stream Toggle, Action -->
                                        <div class="flex flex-wrap items-center justify-between gap-3 pb-2.5 border-b border-slate-100 dark:border-slate-800/60">
                                            <div class="flex items-center gap-2 flex-1 min-w-[220px] max-w-sm">
                                                <div class="size-7 rounded-md bg-primary/10 text-primary font-black text-xs flex items-center justify-center shrink-0 border border-primary/20">
                                                    <%= index + 1 %>
                                                </div>
                                                <div class="flex-1">
                                                    <input type="text" class="class-name-input w-full h-9 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all" value="<%= cls.name %>" placeholder="e.g. Class 10">
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-3">
                                                <!-- Stream / Group Toggle Pill -->
                                                <label class="flex items-center gap-2 cursor-pointer select-none px-3 py-1.5 rounded-md bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-700/80 transition-colors">
                                                    <div class="relative inline-block w-9 h-5 align-middle select-none">
                                                        <input type="checkbox" class="class-has-groups-input toggle-switch-checkbox sr-only" <%= cls.hasGroups ? 'checked' : '' %>>
                                                        <div class="toggle-switch-label block overflow-hidden h-5 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer transition-colors duration-200">
                                                            <span class="toggle-switch-dot absolute left-0.5 top-0.5 bg-white w-4 h-4 rounded-full transition-transform duration-200 shadow-xs"></span>
                                                        </div>
                                                    </div>
                                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-sm text-primary">account_tree</span>
                                                        <span>বিভাগ/গ্রুপ আছে (Science / Commerce / Humanities)</span>
                                                    </span>
                                                </label>

                                                <!-- Move to History Bucket (Soft Delete) -->
                                                <button type="button" 
                                                        onclick="moveToBucket(this.getAttribute('data-id'), this.getAttribute('data-name'))"
                                                        class="delete-class-btn h-8 px-2.5 rounded-md bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/30 dark:hover:bg-amber-900/40 text-amber-700 dark:text-amber-400 font-bold text-xs flex items-center gap-1 transition-all border border-amber-200/80 dark:border-amber-800/40" 
                                                        title="Move to History Bucket" 
                                                        data-id="<%= cls._id %>" 
                                                        data-name="<%= cls.name %>">
                                                    <span class="material-symbols-rounded text-base">inventory_2</span>
                                                    <span class="hidden sm:inline">Move to Bucket</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Standard Flat Subjects (shown if hasGroups is false) -->
                                        <div class="standard-subjects-block <%= cls.hasGroups ? 'hidden' : '' %> space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-0.5 block">
                                                Class Curriculum Subjects (Comma separated)
                                            </label>
                                            <textarea rows="2" class="class-subjects-input w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-xs font-medium p-2.5 rounded-md focus:border-primary outline-none transition-all resize-y min-h-[44px]" placeholder="Bangla, English, Mathematics, General Science, Religion, ICT..."><%= cls.subjects ? cls.subjects.join(', ') : '' %></textarea>
                                        </div>

                                        <!-- Stream / Group Subjects (shown if hasGroups is true) -->
                                        <div class="groups-block space-y-3 <%= cls.hasGroups ? '' : 'hidden' %> bg-slate-50/50 dark:bg-slate-900/40 p-3 rounded-md border border-slate-200 dark:border-slate-700/60">
                                            <div>
                                                <label class="text-[11px] font-bold text-primary dark:text-blue-400 pl-0.5 flex items-center gap-1 mb-1">
                                                    <span class="material-symbols-rounded text-sm">menu_book</span>
                                                    <span>Common / আবশ্যিক বিষয় (সকল গ্রুপের সাধারণ শিক্ষার্থীদের জন্য)</span>
                                                </label>
                                                <input type="text" class="class-common-subjects-input w-full h-9 bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-700 text-xs font-semibold px-3 rounded-md focus:border-primary outline-none transition-all" value="<%= (cls.commonSubjects || []).join(', ') %>" placeholder="Bangla, English, ICT, General Mathematics, Religion & Moral Education">
                                            </div>

                                            <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5">
                                                <%
                                                    const scienceGroup = (cls.groups || []).find(g => (g.name || '').toLowerCase() === 'science') || {};
                                                    const commerceGroup = (cls.groups || []).find(g => (g.name || '').toLowerCase() === 'commerce') || {};
                                                    const humanitiesGroup = (cls.groups || []).find(g => (g.name || '').toLowerCase() === 'humanities') || {};
                                                %>
                                                <!-- Science Group -->
                                                <div class="p-2.5 bg-white dark:bg-[#0f172a] rounded-md border border-emerald-200/80 dark:border-emerald-900/40 space-y-1.5 shadow-xs">
                                                    <label class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400 flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-sm">biotech</span>
                                                        <span>বিজ্ঞান (Science Group)</span>
                                                    </label>
                                                    <textarea rows="2" class="group-science-input w-full text-[11.5px] font-medium p-2 border border-slate-200 dark:border-slate-700 rounded-md bg-slate-50/50 dark:bg-slate-900/50 focus:border-emerald-500 outline-none resize-y" placeholder="Physics, Chemistry, Biology, Higher Mathematics"><%= (scienceGroup.subjects || []).join(', ') %></textarea>
                                                </div>

                                                <!-- Commerce Group -->
                                                <div class="p-2.5 bg-white dark:bg-[#0f172a] rounded-md border border-amber-200/80 dark:border-amber-900/40 space-y-1.5 shadow-xs">
                                                    <label class="text-[11px] font-bold text-amber-700 dark:text-amber-400 flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-sm">bar_chart</span>
                                                        <span>ব্যবসায় শিক্ষা (Commerce)</span>
                                                    </label>
                                                    <textarea rows="2" class="group-commerce-input w-full text-[11.5px] font-medium p-2 border border-slate-200 dark:border-slate-700 rounded-md bg-slate-50/50 dark:bg-slate-900/50 focus:border-amber-500 outline-none resize-y" placeholder="Accounting, Business Entrepreneurship, Finance & Banking"><%= (commerceGroup.subjects || []).join(', ') %></textarea>
                                                </div>

                                                <!-- Humanities Group -->
                                                <div class="p-2.5 bg-white dark:bg-[#0f172a] rounded-md border border-purple-200/80 dark:border-purple-900/40 space-y-1.5 shadow-xs">
                                                    <label class="text-[11px] font-bold text-purple-700 dark:text-purple-400 flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-sm">history_edu</span>
                                                        <span>মানবিক (Humanities)</span>
                                                    </label>
                                                    <textarea rows="2" class="group-humanities-input w-full text-[11.5px] font-medium p-2 border border-slate-200 dark:border-slate-700 rounded-md bg-slate-50/50 dark:bg-slate-900/50 focus:border-purple-500 outline-none resize-y" placeholder="Geography & Environment, Civics, Economics, History"><%= (humanitiesGroup.subjects || []).join(', ') %></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <% if (safeClasses.length === 0) { %>
                        <div id="emptyState" class="p-10 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                            <div class="size-11 rounded-md bg-primary/10 text-primary flex items-center justify-center mx-auto mb-2">
                                <span class="material-symbols-rounded text-2xl">school</span>
                            </div>
                            <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-1">No Active Academic Classes</h3>
                            <p class="text-xs text-slate-500 max-w-sm mx-auto mb-3">You haven't defined any active classes yet. Click the button below to add your first class.</p>
                            <button type="button" onclick="document.getElementById('addClassBtn').click()" class="h-8 px-3.5 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-bold inline-flex items-center gap-1.5 shadow-xs">
                                <span class="material-symbols-rounded text-base">add_circle</span> Add Class
                            </button>
                        </div>
                    <% } %>
                </div>

                <!-- 4. History Bucket (Archived Classes View) -->
                <div id="archivedClassesView" class="hidden p-3 sm:p-4 space-y-3">
                    <div class="p-3 bg-amber-50/60 dark:bg-amber-950/20 rounded-md border border-amber-200/80 dark:border-amber-900/40 text-xs text-amber-800 dark:text-amber-300 flex items-center gap-2">
                        <span class="material-symbols-rounded text-lg text-amber-600 shrink-0">inventory_2</span>
                        <span>These classes are safely archived and hidden from live registration, student dashboards, and teacher portals. All historic questions, student records, and exam results remain 100% intact.</span>
                    </div>

                    <div id="archivedContainer" class="grid grid-cols-1 gap-2.5">
                        <% safeArchived.forEach(ac => { %>
                            <div class="archived-item bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-md p-3.5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3" data-id="<%= ac._id %>">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white"><%= ac.name %></h4>
                                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/60">
                                            Archived in Bucket
                                        </span>
                                        <% if (ac.hasGroups) { %>
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-400 border border-purple-200/60 dark:border-purple-900/60">
                                                Streams Enabled
                                            </span>
                                        <% } %>
                                    </div>
                                    <% if (ac.hasGroups) { %>
                                        <p class="text-[11px] text-slate-500">
                                            Common: <span class="font-medium text-slate-700 dark:text-slate-300"><%= (ac.commonSubjects || []).join(', ') || 'None' %></span>
                                        </p>
                                    <% } %>
                                    <p class="text-[11px] text-slate-500">
                                        Subjects: <span class="font-medium text-slate-700 dark:text-slate-300"><%= (ac.subjects || []).join(', ') || 'None' %></span>
                                    </p>
                                </div>
                                <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                                    <button type="button" 
                                            onclick="restoreClass(this.getAttribute('data-id'), this.getAttribute('data-name'))"
                                            data-id="<%= ac._id %>" 
                                            data-name="<%= ac.name %>"
                                            class="h-8 px-3 rounded-md bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:hover:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800 font-bold text-xs flex items-center gap-1 transition-all">
                                        <span class="material-symbols-rounded text-sm">settings_backup_restore</span>
                                        <span>Restore to Live</span>
                                    </button>
                                    <button type="button" 
                                            onclick="permanentDeleteClass(this.getAttribute('data-id'), this.getAttribute('data-name'))"
                                            data-id="<%= ac._id %>" 
                                            data-name="<%= ac.name %>"
                                            class="h-8 px-2.5 rounded-md bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200/80 dark:border-rose-900/60 font-bold text-xs flex items-center gap-1 transition-all" title="Permanently delete from database">
                                        <span class="material-symbols-rounded text-sm">delete_forever</span>
                                    </button>
                                </div>
                            </div>
                        <% }) %>

                        <% if (safeArchived.length === 0) { %>
                            <div id="archivedEmptyState" class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                <span class="material-symbols-rounded text-3xl text-slate-400 mb-1">inventory_2</span>
                                <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300">History Bucket is Empty</h4>
                                <p class="text-[11px] text-slate-500">When you remove any class from the live list, it will safely appear here.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Template for new class -->
    <template id="newClassTemplate">
        <div class="class-item bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-md p-3.5 sm:p-4 shadow-xs transition-all hover:border-primary/40" data-id="">
            <div class="flex items-start gap-3">
                <div class="drag-handle text-slate-300 hover:text-primary dark:hover:text-primary mt-2 px-1 cursor-grab active:cursor-grabbing transition-colors shrink-0" title="Drag to reorder sequence">
                    <span class="material-symbols-rounded text-2xl">drag_indicator</span>
                </div>

                <div class="flex-1 space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-3 pb-2.5 border-b border-slate-100 dark:border-slate-800/60">
                        <div class="flex items-center gap-2 flex-1 min-w-[220px] max-w-sm">
                            <div class="size-7 rounded-md bg-primary/10 text-primary font-black text-xs flex items-center justify-center shrink-0 border border-primary/20">
                                +
                            </div>
                            <div class="flex-1">
                                <input type="text" class="class-name-input w-full h-9 px-3 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-900 dark:text-white outline-none focus:border-primary transition-all" value="" placeholder="e.g. Class 5">
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <label class="flex items-center gap-2 cursor-pointer select-none px-3 py-1.5 rounded-md bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-700/80 transition-colors">
                                <div class="relative inline-block w-9 h-5 align-middle select-none">
                                    <input type="checkbox" class="class-has-groups-input toggle-switch-checkbox sr-only">
                                    <div class="toggle-switch-label block overflow-hidden h-5 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer transition-colors duration-200">
                                        <span class="toggle-switch-dot absolute left-0.5 top-0.5 bg-white w-4 h-4 rounded-full transition-transform duration-200 shadow-xs"></span>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm text-primary">account_tree</span>
                                    <span>বিভাগ/গ্রুপ আছে (Science / Commerce / Humanities)</span>
                                </span>
                            </label>

                            <button type="button" class="delete-class-btn h-8 px-2.5 rounded-md bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/30 dark:hover:bg-amber-900/40 text-amber-700 dark:text-amber-400 font-bold text-xs flex items-center gap-1 transition-all border border-amber-200/80 dark:border-amber-800/40" title="Move to History Bucket" data-id="" data-name="">
                                <span class="material-symbols-rounded text-base">inventory_2</span>
                                <span class="hidden sm:inline">Move to Bucket</span>
                            </button>
                        </div>
                    </div>

                    <div class="standard-subjects-block space-y-1.5">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-0.5 block">
                            Class Curriculum Subjects (Comma separated)
                        </label>
                        <textarea rows="2" class="class-subjects-input w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-xs font-medium p-2.5 rounded-md focus:border-primary outline-none transition-all resize-y min-h-[44px]" placeholder="Bangla, English, Mathematics, General Science, Religion, ICT..."></textarea>
                    </div>

                    <div class="groups-block space-y-3 hidden bg-slate-50/50 dark:bg-slate-900/40 p-3 rounded-md border border-slate-200 dark:border-slate-700/60">
                        <div>
                            <label class="text-[11px] font-bold text-primary dark:text-blue-400 pl-0.5 flex items-center gap-1 mb-1">
                                <span class="material-symbols-rounded text-sm">menu_book</span>
                                <span>Common / আবশ্যিক বিষয় (সকল গ্রুপের সাধারণ শিক্ষার্থীদের জন্য)</span>
                            </label>
