    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const apiBase = window.location.pathname.startsWith('/admin') ? '/admin' : '/superadmin';

        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('active');
        }

        function switchAcademicTab(tab) {
            const activeView = document.getElementById('activeClassesView');
            const archiveView = document.getElementById('archivedClassesView');
            const tabActiveBtn = document.getElementById('tabActiveBtn');
            const tabArchiveBtn = document.getElementById('tabArchiveBtn');
            const addClassBtn = document.getElementById('addClassBtn');
            const saveBtn = document.getElementById('saveBtn');
            const notice = document.getElementById('archiveViewNotice');

            if (!activeView || !archiveView) return;

            if (tab === 'active') {
                activeView.classList.remove('hidden');
                archiveView.classList.add('hidden');
                if (tabActiveBtn) tabActiveBtn.className = 'px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                if (tabArchiveBtn) tabArchiveBtn.className = 'px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (addClassBtn) addClassBtn.classList.remove('hidden');
                if (saveBtn) saveBtn.classList.remove('hidden');
                if (notice) notice.classList.add('hidden');
                if (window.history.replaceState) {
                    window.history.replaceState(null, '', window.location.pathname + '?tab=active');
                }
            } else {
                activeView.classList.add('hidden');
                archiveView.classList.remove('hidden');
                if (tabArchiveBtn) tabArchiveBtn.className = 'px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                if (tabActiveBtn) tabActiveBtn.className = 'px-3 py-1.5 rounded-md font-bold text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (addClassBtn) addClassBtn.classList.add('hidden');
                if (saveBtn) saveBtn.classList.add('hidden');
                if (notice) notice.classList.remove('hidden');
                if (window.history.replaceState) {
                    window.history.replaceState(null, '', window.location.pathname + '?tab=archive');
                }
            }
        }

        // Global Move to Bucket (Soft Delete)
        async function moveToBucket(id, name) {
            name = (name || '').trim();
            id = (id || '').trim();

            // If unsaved draft
            if (!id) {
                if (name) {
                    const unsavedChoice = await Swal.fire({
                        title: 'Discard or Archive to Bucket?',
                        text: `"${name}" has not been saved yet. Do you want to discard it or save it directly to the History Bucket?`,
                        icon: 'question',
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonColor: '#137fec',
                        denyButtonColor: '#d97706',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Discard Draft',
                        denyButtonText: 'Archive to Bucket'
                    });

                    if (unsavedChoice.isConfirmed) {
                        const items = document.querySelectorAll('.class-item');
                        items.forEach(it => {
                            const inp = it.querySelector('.class-name-input');
                            if (inp && inp.value.trim() === name && !it.getAttribute('data-id')) {
                                it.remove();
                            }
                        });
                        return;
                    } else if (unsavedChoice.isDenied) {
                        try {
                            const res = await fetch(`${apiBase}/academic-setup/archive`, {
                                method: 'POST',
                                headers: { 
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({ name })
                            });
                            const text = await res.text();
                            let data = {};
                            try { data = JSON.parse(text); } catch(e) { data = { error: text }; }

                            if (res.ok && data.success !== false) {
                                window.location.href = window.location.pathname + '?tab=archive';
                            } else {
                                Swal.fire('Error', (data && data.error) || 'Failed to archive class', 'error');
                            }
                        } catch (err) {
                            Swal.fire('Error', 'Connection error: ' + (err.message || err), 'error');
                        }
                        return;
                    } else {
                        return;
                    }
                } else {
                    const emptyItems = document.querySelectorAll('.class-item:not([data-id])');
                    if (emptyItems.length > 0) emptyItems[0].remove();
                    return;
                }
            }

            // Existing class in database
            const result = await Swal.fire({
                title: 'Move to History Bucket?',
                text: `"${name}" will be safely removed from the live platform (registration, student dashboard, teacher assignment), and preserved in the History Bucket.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#d97706',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Move to History Bucket'
            });

            if (result.isConfirmed) {
                try {
                    Swal.fire({
                        title: 'Archiving...',
                        text: `Moving "${name}" to History Bucket...`,
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const target = id || name;
                    let res = await fetch(`${apiBase}/academic-setup/archive`, { 
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ id: target, name, action: 'archive' })
                    });

                    if (!res.ok) {
                        res = await fetch(`${apiBase}/academic-setup?action=archive`, { 
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ id: target, name, action: 'archive' })
                        });
                    }

                    const text = await res.text();
                    let data = {};
                    try { 
                        data = JSON.parse(text); 
                    } catch(e) { 
                        const clean = text.replace(/<[^>]*>?/gm, '').trim();
                        data = { error: clean || 'Server returned invalid response' }; 
                    }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Moved to History Bucket!',
                            text: `"${name}" is now safely archived in the History Bucket.`,
                            timer: 1400,
                            showConfirmButton: false
                        });
                        window.location.href = window.location.pathname + '?tab=archive';
                    } else {
                        // Helpful diagnosis if node process is still running old routes in memory
                        if (res.status === 404 || (data && (data.error === 'Invalid data' || data.error.includes('Cannot POST')))) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Server Restart Required',
                                html: `সার্ভারটি মেমোরিতে আগের কোড ধরে রেখেছে।<br><br>দয়া করে আপনার টার্মিনালে Node.js সার্ভারটি একবার রিস্টার্ট করুন (<kbd class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded font-mono text-xs text-rose-600 font-bold">Ctrl + C</kbd> দিয়ে বন্ধ করে <kbd class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded font-mono text-xs text-blue-600 font-bold">node server/server.js</kbd> বা <kbd class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded font-mono text-xs text-blue-600 font-bold">npm run dev</kbd> চালান)।<br><br>এরপর রিলোড দিয়ে Move to Bucket এ ক্লিক করলে কাজ করবে।`
                            });
                        } else {
                            Swal.fire('Error', (data && data.error) || 'Failed to move to History Bucket', 'error');
                        }
                    }
                } catch (err) {
                    console.error('Move to bucket error:', err);
                    Swal.fire('Error', 'Connection error: ' + (err.message || err), 'error');
                }
            }
        }

        async function restoreClass(id, name) {
            const result = await Swal.fire({
                title: 'Restore Class to Live?',
                text: `"${name}" will be restored back to live registration, student dashboards, and teacher portals.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#137fec',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Restore Now'
            });

            if (result.isConfirmed) {
                try {
                    Swal.fire({
                        title: 'Restoring...',
                        text: `Restoring "${name}" to live platform...`,
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const target = id || name;
                    let res = await fetch(`${apiBase}/academic-setup/restore`, { 
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ id: target, name, action: 'restore' })
                    });

                    if (!res.ok) {
                        res = await fetch(`${apiBase}/academic-setup/${encodeURIComponent(target)}/restore`, { 
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ name, action: 'restore' })
                        });
                    }

                    if (!res.ok) {
                        res = await fetch(`${apiBase}/academic-setup?action=restore`, { 
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ id: target, name, action: 'restore' })
                        });
                    }

                    const text = await res.text();
                    let data = {};
                    try { 
                        data = JSON.parse(text); 
                    } catch(e) { 
                        const clean = text.replace(/<[^>]*>?/gm, '').trim();
                        data = { error: clean || 'Server returned invalid response' }; 
                    }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Restored to Live!',
                            text: `"${name}" is now active across the platform.`,
                            timer: 1400,
                            showConfirmButton: false
                        });
                        window.location.href = window.location.pathname + '?tab=active';
                    } else {
                        Swal.fire('Error', (data && data.error) || 'Failed to restore class', 'error');
