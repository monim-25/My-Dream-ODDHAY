                </div>

                <div>
                    <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Stream / Group Placement</label>
                    <select id="selectBatchSubjectGroup" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                        <option value="common">Common / আবশ্যিক (All Students of Selected Classes)</option>
                        <option value="Science">Science (বিজ্ঞান বিভাগ)</option>
                        <option value="Commerce">Commerce (ব্যবসায় শিক্ষা বিভাগ)</option>
                        <option value="Humanities">Humanities (মানবিক বিভাগ)</option>
                    </select>
                </div>

                <!-- Target Classes Checkboxes -->
                <div class="space-y-1.5 p-2.5 rounded-md bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
                    <div class="flex items-center justify-between flex-wrap gap-1">
                        <label class="text-[11px] font-bold text-slate-700 dark:text-slate-200 flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm text-primary">domain</span>
                            <span>Target Classes *</span>
                        </label>
                        <div class="flex items-center gap-1 text-[10px]">
                            <button type="button" onclick="selectBatchSubjectClasses('all')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-primary hover:text-white transition-all font-medium">All</button>
                            <button type="button" onclick="selectBatchSubjectClasses('9-10')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-primary hover:text-white transition-all font-medium">Class 9 & 10</button>
                            <button type="button" onclick="selectBatchSubjectClasses('11-12')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-primary hover:text-white transition-all font-medium">Class 11 & 12</button>
                            <button type="button" onclick="selectBatchSubjectClasses('clear')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-rose-500 hover:text-white transition-all font-medium">Clear</button>
                        </div>
                    </div>
                    <div id="batchAddSubjectClassGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 pt-1">
                        <% safeClasses.forEach(c => { %>
                            <label class="flex items-center gap-1.5 p-1.5 rounded border border-slate-200 dark:border-slate-700 hover:border-primary/50 cursor-pointer bg-white dark:bg-slate-900 text-xs transition-colors select-none">
                                <input type="checkbox" name="batchClass" value="<%= c.name %>" class="size-3.5 accent-primary rounded cursor-pointer">
                                <span class="font-medium text-slate-800 dark:text-slate-200 truncate"><%= c.name %></span>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" onclick="closeModal('batchAddSubjectModal')" class="h-9 px-3 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</button>
                    <button type="submit" id="btnSubmitBatchSubject" class="h-9 px-4 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium transition-all flex items-center gap-1">
                        <span class="material-symbols-rounded text-[17px]">add_circle</span>
                        <span>Add Subject to Classes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openBatchAddSubjectModal() {
            document.getElementById('batchAddSubjectForm').reset();
            document.querySelectorAll('#batchAddSubjectClassGrid input[name="batchClass"]').forEach(cb => cb.checked = false);
            document.getElementById('batchAddSubjectModal').classList.remove('hidden');
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('hidden');
        }

        function selectBatchSubjectClasses(mode) {
            const cbs = document.querySelectorAll('#batchAddSubjectClassGrid input[name="batchClass"]');
            if (mode === 'all') cbs.forEach(cb => cb.checked = true);
            else if (mode === 'clear') cbs.forEach(cb => cb.checked = false);
            else if (mode === '9-10') cbs.forEach(cb => {
                const v = cb.value.toLowerCase();
                cb.checked = (v.includes('9') || v.includes('10')) && !v.includes('11') && !v.includes('12');
            });
            else if (mode === '11-12') cbs.forEach(cb => {
                const v = cb.value.toLowerCase();
                cb.checked = v.includes('11') || v.includes('12');
            });
        }

        async function submitBatchAddSubject(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitBatchSubject');
            const orig = btn.innerText;
            btn.disabled = true;
            btn.innerText = 'Adding...';

            const subjectName = document.getElementById('inputBatchSubjectName').value.trim();
            const group = document.getElementById('selectBatchSubjectGroup').value;
            const checkedClasses = Array.from(document.querySelectorAll('#batchAddSubjectClassGrid input[name="batchClass"]:checked')).map(cb => cb.value);

            if (!subjectName) {
                btn.disabled = false;
                btn.innerText = orig;
                return Swal.fire('Subject Name', 'Please enter a subject name', 'warning');
            }
            if (checkedClasses.length === 0) {
                btn.disabled = false;
                btn.innerText = orig;
                return Swal.fire('Select Classes', 'Please select at least one class for this subject', 'warning');
            }

            try {
                const res = await fetch(`/superadmin/topics/add-subject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ subjectName, classLevels: checkedClasses, group })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({ icon: 'success', title: 'Subject Added!', text: data.message, timer: 1500, showConfirmButton: false });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to add subject', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Network error', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = orig;
            }
        }
    </script>
</body>
</html>