                } catch (e) {
                    Swal.fire('Error', 'Connection error: ' + (e.message || e), 'error');
                }
            }
        }

        async function permanentDeleteClass(id, name) {
            const result = await Swal.fire({
                title: 'Permanent Delete?',
                text: `Warning: This will permanently delete "${name}" from the database. All historic links to this class may be broken!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete Permanently'
            });

            if (result.isConfirmed) {
                try {
                    Swal.fire({
                        title: 'Deleting...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const target = id || name;
                    let res = await fetch(`${apiBase}/academic-setup/permanent`, { 
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ id: target, name, action: 'permanent' })
                    });

                    if (!res.ok) {
                        res = await fetch(`${apiBase}/academic-setup/${encodeURIComponent(target)}/permanent`, { 
                            method: 'DELETE',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ name, action: 'permanent' })
                        });
                    }

                    if (!res.ok) {
                        res = await fetch(`${apiBase}/academic-setup?action=permanent`, { 
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ id: target, name, action: 'permanent' })
                        });
                    }

                    const text = await res.text();
                    let data = {};
                    try { 
                        data = JSON.parse(text); 
                    } catch(e) { 
                        const clean = text.replace(/<[^>]*>?/gm, '').trim();
                        data = { error: clean || 'Server returned invalid response' }; 
                    }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Deleted Forever!',
                            timer: 1400,
                            showConfirmButton: false
                        });
                        window.location.href = window.location.pathname + '?tab=archive';
                    } else {
                        Swal.fire('Error', (data && data.error) || 'Failed to delete permanently', 'error');
                    }
                } catch (e) {
                    Swal.fire('Error', 'Connection error: ' + (e.message || e), 'error');
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('classesContainer');
            const addBtn = document.getElementById('addClassBtn');
            const saveBtn = document.getElementById('saveBtn');
            const template = document.getElementById('newClassTemplate');
            const emptyState = document.getElementById('emptyState');

            // Auto-detect Tab from URL
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tab') === 'archive' || window.location.hash === '#archive' || window.location.hash === '#history') {
                switchAcademicTab('archive');
            } else {
                switchAcademicTab('active');
            }

            // Initialize Sortable safely
            if (container && typeof Sortable !== 'undefined') {
                try {
                    new Sortable(container, {
                        animation: 150,
                        handle: '.drag-handle',
                        ghostClass: 'opacity-50'
                    });
                } catch (e) {
                    console.warn('Sortable init warning:', e);
                }
            }

            // Toggle Groups Display
            if (container) {
                container.addEventListener('change', (e) => {
                    if (e.target.classList.contains('class-has-groups-input')) {
                        const item = e.target.closest('.class-item');
                        if (!item) return;
                        const standardBlock = item.querySelector('.standard-subjects-block');
                        const groupsBlock = item.querySelector('.groups-block');
                        if (e.target.checked) {
                            if (standardBlock) standardBlock.classList.add('hidden');
                            if (groupsBlock) groupsBlock.classList.remove('hidden');
                        } else {
                            if (standardBlock) standardBlock.classList.remove('hidden');
                            if (groupsBlock) groupsBlock.classList.add('hidden');
                        }
                    }
                });
            }

            // Add new class
            if (addBtn && template && container) {
                addBtn.addEventListener('click', () => {
                    if (emptyState) emptyState.style.display = 'none';
                    const clone = template.content.cloneNode(true);
                    container.prepend(clone);
                    const newInputs = container.querySelectorAll('.class-name-input');
                    if (newInputs.length > 0) newInputs[0].focus();
                });
            }

            // Move to History Bucket click listener delegation (fallback)
            if (container) {
                container.addEventListener('click', async (e) => {
                    const btn = e.target.closest('.delete-class-btn');
                    if (!btn) return;
                    
                    // If button already has inline onclick, let it handle
                    const inlineClick = btn.getAttribute('onclick');
                    if (inlineClick && inlineClick.includes('moveToBucket')) return;

                    const item = btn.closest('.class-item');
                    const id = btn.getAttribute('data-id') || (item ? item.getAttribute('data-id') : null);
                    const nameInput = item ? item.querySelector('.class-name-input') : null;
                    const name = (nameInput && nameInput.value.trim()) ? nameInput.value.trim() : (btn.getAttribute('data-name') || '');

                    moveToBucket(id, name);
                });
            }

            // Save all active classes
            if (saveBtn) {
                saveBtn.addEventListener('click', async () => {
                    const items = container.querySelectorAll('.class-item');
                    const classData = [];
                    let hasError = false;

                    items.forEach((item, index) => {
                        const id = item.getAttribute('data-id');
                        const name = item.querySelector('.class-name-input').value.trim();
                        const hasGroups = item.querySelector('.class-has-groups-input').checked;

                        if (!name) {
                            item.querySelector('.class-name-input').classList.add('border-rose-500');
                            hasError = true;
                            return;
                        } else {
                            item.querySelector('.class-name-input').classList.remove('border-rose-500');
                        }

                        if (hasGroups) {
                            const commonSubjects = item.querySelector('.class-common-subjects-input').value.trim();
                            const scienceSubs = item.querySelector('.group-science-input').value.trim();
                            const commerceSubs = item.querySelector('.group-commerce-input').value.trim();
                            const humanitiesSubs = item.querySelector('.group-humanities-input').value.trim();

                            const groups = [
                                { name: 'Science', subjects: scienceSubs },
                                { name: 'Commerce', subjects: commerceSubs },
                                { name: 'Humanities', subjects: humanitiesSubs }
                            ];

                            classData.push({
                                _id: id || null,
                                name,
                                hasGroups: true,
                                commonSubjects,
                                groups,
                                subjects: '',
                                order: index
                            });
                        } else {
                            const subjects = item.querySelector('.class-subjects-input').value.trim();
                            classData.push({
                                _id: id || null,
                                name,
                                hasGroups: false,
                                commonSubjects: '',
                                groups: [],
                                subjects,
                                order: index
                            });
                        }
                    });

                    if (hasError) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Validation Error',
                            text: 'Please fill out all class names before saving.'
                        });
                        return;
                    }
                    
                    const origText = saveBtn.innerHTML;
                    saveBtn.innerHTML = '<span class="material-symbols-rounded animate-spin text-base">progress_activity</span> Saving...';
                    saveBtn.disabled = true;

                    try {
                        const res = await fetch(`${apiBase}/academic-setup`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ classData })
                        });
                        
                        if (res.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Academic setup saved successfully.',
                                timer: 1400,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = window.location.pathname + '?tab=active';
                            });
                        } else {
                            Swal.fire('Error', 'Failed to save data', 'error');
                            saveBtn.innerHTML = origText;
                            saveBtn.disabled = false;
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Network error', 'error');
                        saveBtn.innerHTML = origText;
                        saveBtn.disabled = false;
                    }
                });
            }
        });
    </script>

