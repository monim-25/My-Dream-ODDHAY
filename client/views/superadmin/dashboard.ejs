<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Superadmin | ODDHAY Command Center</title>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                min-height: 100vh;
                transition: all 0.3s ease;
            }

            .dash-card {
                background: #ffffff;
                border: 1px solid #f1f5f9;
                border-radius: 0.375rem;
                transition: all 0.3s ease;
            }

            .dark .dash-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            .stat-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 0.375rem;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                cursor: pointer;
            }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .dark .stat-card {
                background: #1e293b;
                border: 1px solid #334155;
            }



            .pending-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 0.375rem;
                transition: all 0.3s ease;
                cursor: pointer;
            }

            .pending-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .dark .pending-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            .pulse-dot {
                animation: pulse 2s infinite;
            }

            @keyframes pulse {

                0%,
                100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.5;
                }
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }

                .admin-sidebar.active {
                    transform: translateX(0);
                }
            }
        </style>
</head>

<body class="bg-[#F8F8FF] text-slate-800 dark:text-slate-200 font-sans min-h-screen">

    <div class="flex">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'dashboard' }) %>
        </aside>

        <main class="admin-main flex-1 ml-[260px] bg-[#F8F8FF] flex flex-col min-h-screen">
            <%- include('header_v2', { pageTitle: 'Dashboard' }) %>

                <section class="flex flex-col gap-0.5 bg-[#F8F8FF] border-l border-slate-900/10 dark:border-white/5 p-0.5">
                    <!-- Unified Dashboard Metrics & Actions Container -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2 flex flex-col gap-1">
                            
                            <!-- Quick Actions Grid -->
                            <div class="grid grid-cols-2 lg:grid-cols-4 gap-1">
                                <!-- Add Staff -->
                                <a href="/superadmin/create-role" 
                                    class="group relative flex items-center gap-3 p-3 bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all duration-300">
                                    <div class="size-10 rounded-md bg-blue-500/10 text-blue-500 flex items-center justify-center group-hover:scale-110 transition-transform flex-shrink-0">
                                        <span class="material-symbols-rounded text-xl">person_add</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white">Add Staff</p>
                                        <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Create account</p>
                                    </div>
                                </a>

                                <!-- Add Course -->
                                <a href="/superadmin/courses" 
                                    class="group relative flex items-center gap-3 p-3 bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all duration-300">
                                    <div class="size-10 rounded-md bg-emerald-500/10 text-emerald-500 flex items-center justify-center group-hover:scale-110 transition-transform flex-shrink-0">
                                        <span class="material-symbols-rounded text-xl">auto_stories</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white">Add Course</p>
                                        <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">New content</p>
                                    </div>
                                </a>

                                <!-- Send Notification -->
                                <a href="/superadmin/notifications" 
                                    class="group relative flex items-center gap-3 p-3 bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all duration-300">
                                    <div class="size-10 rounded-md bg-violet-500/10 text-violet-500 flex items-center justify-center group-hover:scale-110 transition-transform flex-shrink-0">
                                        <span class="material-symbols-rounded text-xl">notifications_active</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white">Send Notice</p>
                                        <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Broadcast</p>
                                    </div>
                                </a>

                                <!-- View Payments -->
                                <a href="/superadmin/payments" 
                                    class="group relative flex items-center gap-3 p-3 bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all duration-300">
                                    <div class="size-10 rounded-md bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform flex-shrink-0">
                                        <span class="material-symbols-rounded text-xl">payments</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[11px] font-bold text-slate-900 dark:text-white">Financials</p>
                                        <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">History</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Primary Stat Cards Grid -->
                            <div class="grid grid-cols-2 lg:grid-cols-5 gap-1">
                                <!-- Students -->
                                <a href="/superadmin/users?role=student" class="p-3 flex flex-col group h-[85px] bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all relative overflow-hidden">
                                    <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">group</span>
                                    <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                        <span class="material-symbols-rounded text-[14px]">group</span> Students
                                    </p>
                                    <div class="flex-1 flex items-center relative z-10">
                                        <h3 id="stat-student-count" class="text-xl font-black text-slate-800 dark:text-white leading-none tracking-tight">
                                            <%= (typeof studentCount !=='undefined' ) ? studentCount.toLocaleString() : '0' %>
                                        </h3>
                                    </div>
                                    <p class="text-[9px] text-slate-400 font-bold tracking-tight relative z-10">Database &rarr;</p>
                                </a>

                                <!-- Courses -->
                                <a href="/superadmin/courses" class="p-3 flex flex-col group h-[85px] bg-indigo-50/40 dark:bg-indigo-500/10 border border-indigo-100/20 dark:border-indigo-500/20 rounded-md hover:bg-indigo-100/40 dark:hover:bg-indigo-500/20 transition-all relative overflow-hidden">
                                    <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-indigo-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">school</span>
                                    <p class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                        <span class="material-symbols-rounded text-[14px]">school</span> Courses
                                    </p>
                                    <div class="flex-1 flex items-center relative z-10">
                                        <h3 id="stat-course-count" class="text-xl font-black text-slate-800 dark:text-white leading-none tracking-tight">
                                            <%= courseCount %>
                                        </h3>
                                    </div>
                                    <p class="text-[9px] text-slate-400 font-bold tracking-tight relative z-10">Content &rarr;</p>
                                </a>

                                <!-- Staff -->
                                <a href="/superadmin/users?role=guardian" class="p-3 flex flex-col group h-[85px] bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all relative overflow-hidden">
                                    <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-violet-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">shield_person</span>
                                    <p class="text-[11px] font-bold text-violet-600 dark:text-violet-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                        <span class="material-symbols-rounded text-[14px]">shield_person</span> Staff
                                    </p>
                                    <div class="flex-1 flex items-center relative z-10">
                                        <h3 id="stat-guardian-count" class="text-xl font-black text-slate-800 dark:text-white leading-none tracking-tight">
                                            <%= staffCount %>
                                        </h3>
                                    </div>
                                    <p class="text-[9px] text-slate-400 font-bold tracking-tight relative z-10">Access Control &rarr;</p>
                                </a>

                                <!-- Revenue -->
                                <a href="/superadmin/payments" class="p-3 flex flex-col group h-[85px] bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all relative overflow-hidden">
                                    <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">payments</span>
                                    <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                        <span class="material-symbols-rounded text-[14px]">payments</span> Revenue
                                    </p>
                                    <div class="flex-1 flex items-center relative z-10">
                                        <h3 id="stat-monthly-revenue" class="text-xl font-black text-slate-800 dark:text-white leading-none tracking-tight">
                                            ৳<%= ((revenue.monthly || 0)/1000).toFixed(1) %>K
                                        </h3>
                                    </div>
                                    <p class="text-[9px] text-slate-400 font-bold tracking-tight relative z-10">Financials &rarr;</p>
                                </a>

                                <!-- Today -->
                                <div class="p-3 flex flex-col group h-[85px] bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-md hover:bg-rose-100/40 dark:hover:bg-rose-500/20 transition-all relative overflow-hidden">
                                    <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-rose-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">event</span>
                                    <p class="text-[11px] font-bold text-rose-600 dark:text-rose-400 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                        <span class="material-symbols-rounded text-[14px]">event</span> Today
                                    </p>
                                    <div class="flex-1 flex items-center relative z-10">
                                        <h3 id="stat-today-revenue" class="text-xl font-black text-slate-800 dark:text-white leading-none tracking-tight">
                                            +৳<%= (revenue.today || 0).toLocaleString() %>
                                        </h3>
                                    </div>
                                    <p class="text-[9px] text-slate-400 font-bold tracking-tight relative z-10">Live Pulse &bull;</p>
                                </div>
                            </div>

                            <!-- Pending Items Grid (Conditional) -->
                            <% if (pendingPayments> 0 || scheduledNotifications > 0 || openQas > 0 || failedPayments > 0) { %>
                                <div class="grid grid-cols-2 lg:grid-cols-4 gap-1 pt-1 border-t border-slate-100 dark:border-white/5">
                                    <% if (pendingPayments> 0) { %>
                                        <a href="/superadmin/payments?status=pending"
                                            class="p-3 flex flex-col items-center justify-center h-[80px] bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all shadow-sm">
                                            <span class="material-symbols-rounded text-2xl text-amber-500 mb-1">pending_payments</span>
                                            <p class="text-lg font-bold text-amber-600 leading-none"><%= pendingPayments %></p>
                                            <p class="text-[11px] font-bold text-amber-500 mt-0.5">Pending Payments</p>
                                        </a>
                                    <% } %>
                                    <% if (scheduledNotifications> 0) { %>
                                        <a href="/superadmin/notifications"
                                            class="p-3 flex flex-col items-center justify-center h-[80px] bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all shadow-sm">
                                            <span class="material-symbols-rounded text-2xl text-blue-500 mb-1">schedule</span>
                                            <p class="text-lg font-bold text-blue-600 leading-none"><%= scheduledNotifications %></p>
                                            <p class="text-[11px] font-bold text-blue-500 mt-0.5">Scheduled</p>
                                        </a>
                                    <% } %>
                                    <% if (openQas> 0) { %>
                                        <a href="/superadmin/qas"
                                            class="p-3 flex flex-col items-center justify-center h-[80px] bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all shadow-sm">
                                            <span class="material-symbols-rounded text-2xl text-violet-500 mb-1">help</span>
                                            <p class="text-lg font-bold text-violet-600 leading-none"><%= openQas %></p>
                                            <p class="text-[11px] font-bold text-violet-500 mt-0.5">Open Q&As</p>
                                        </a>
                                    <% } %>
                                    <% if (failedPayments> 0) { %>
                                        <a href="/superadmin/payments?status=failed"
                                            class="p-3 flex flex-col items-center justify-center h-[80px] bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-md hover:bg-rose-100/40 dark:hover:bg-rose-500/20 transition-all shadow-sm">
                                            <span class="material-symbols-rounded text-2xl text-rose-500 mb-1">error</span>
                                            <p class="text-lg font-bold text-rose-600 leading-none"><%= failedPayments %></p>
                                            <p class="text-[11px] font-bold text-rose-500 mt-0.5">Failed</p>
                                        </a>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>





                    <!-- Revenue Flow Chart - Unified Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-1">
                            <div class="lg:col-span-2 flex flex-col bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                                <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                    <div>
                                        <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Revenue Flow</h3>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 font-bold tracking-wide opacity-80">
                                            Last 7 Days
                                            <% if (revenueComparison.hasComparison) { %>
                                                <span class="ml-2 <%= revenueComparison.monthlyVsLastMonth >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                                                    <%= revenueComparison.monthlyVsLastMonth>= 0 ? '↑' : '↓' %>
                                                        <%= Math.abs(revenueComparison.monthlyVsLastMonth) %>% vs last month
                                                </span>
                                            <% } %>
                                        </p>
                                    </div>
                                </div>
                                <div class="p-4 h-[200px] w-full">
                                    <canvas id="revenueChart"></canvas>
                                </div>
                            </div>
                                <div class="grid grid-rows-3 gap-1">
                                    <div class="p-4 flex flex-col items-start justify-center bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm hover:bg-slate-50/50 dark:hover:bg-white/5 transition-colors">
                                        <p class="text-[11px] font-bold text-slate-500 opacity-80 mb-1">Yearly Earning</p>
                                        <h3 class="text-xl font-black tracking-tight text-slate-800 dark:text-white leading-none">৳<%= ((revenue.yearly || 0) / 1000).toFixed(1) %>K</h3>
                                    </div>
                                    <div class="p-4 flex flex-col items-start justify-center bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm hover:bg-slate-50/50 dark:hover:bg-white/5 transition-colors">
                                        <p class="text-[11px] font-bold text-slate-500 opacity-80 mb-1">Monthly Earning</p>
                                        <h3 class="text-xl font-black tracking-tight text-slate-800 dark:text-white leading-none">৳<%= ((revenue.monthly || 0) / 1000).toFixed(1) %>K</h3>
                                    </div>
                                    <div class="p-4 flex flex-col items-start justify-center bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm hover:bg-slate-50/50 dark:hover:bg-white/5 transition-colors">
                                        <p class="text-[11px] font-bold text-slate-500 opacity-80 mb-1">Today Earning</p>
                                        <h3 class="text-xl font-black tracking-tight text-emerald-600 dark:text-emerald-400 leading-none">+৳<%= revenue.today || 0 %></h3>
                                    </div>
                                </div>
                            </div>
                        

                    <!-- Categories Revenue - Framed -->
                    <div class="bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                        <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5">
                            <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">
                                Categories Revenue
                            </h3>
                        </div>
                        <div class="p-4">
                            <div class="flex flex-col lg:flex-row items-center justify-start">
                                <!-- Legend / Stats on Left -->
                                <div id="categoryLegend" class="w-full lg:w-[75%] space-y-3.5 lg:pl-8">
                                    <!-- Populated via JS -->
                                </div>
                                
                                <!-- Chart on Right -->
                                <div class="size-[150px] lg:size-[180px] relative flex-shrink-0">
                                    <canvas id="categoryChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity + Recent Users - Unified Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-1">
                                 <!-- Recent Activity Feed -->
                                 <div class="flex flex-col overflow-hidden bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                                     <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                         <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                             Recent Activity
                                         </h3>
                                         <a href="/superadmin/logs"
                                             class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                                     </div>
                                     <div class="p-2 space-y-1">
                                         <% if (recentActivity && recentActivity.length> 0) { %>
                                             <% recentActivity.forEach(log=> { %>
                                                 <div
                                                     class="flex items-start gap-3 p-2 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all">
                                                     <div
                                                         class="size-8 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-500 flex items-center justify-center flex-shrink-0">
                                                         <span class="material-symbols-rounded text-sm">
                                                             <%= log.action==='CREATE' ? 'add_circle' :
                                                                 log.action==='DELETE' ? 'delete' : log.action==='UPDATE'
                                                                 ? 'edit' : 'info' %>
                                                         </span>
                                                     </div>
                                                     <div class="flex-1 min-w-0">
                                                         <p
                                                             class="text-[11px] font-bold text-slate-900 dark:text-slate-100 truncate">
                                                             <%= log.performedBy ? log.performedBy.name : 'System' %>
                                                         </p>
                                                         <p
                                                             class="text-[9px] text-slate-500 dark:text-slate-400 truncate">
                                                             <%= log.actionDetails %>
                                                         </p>
                                                         <p class="text-[8px] text-slate-400 mt-0.5">
                                                             <%= new Date(log.createdAt).toLocaleString('en-GB', {
                                                                 day: '2-digit' , month: 'short' , hour: '2-digit' ,
                                                                 minute: '2-digit' }) %>
                                                         </p>
                                                     </div>
                                                 </div>
                                                 <% }) %>
                                                     <% } else { %>
                                                         <div
                                                             class="flex flex-col items-center justify-center py-8 opacity-40">
                                                             <span
                                                                 class="material-symbols-rounded text-3xl mb-1">history</span>
                                                             <p class="text-[10px] font-bold">No recent activity</p>
                                                         </div>
                                                         <% } %>
                                     </div>
                                 </div>                                             <!-- Recent Users Table -->
                                 <div class="flex flex-col overflow-hidden bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                                     <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                         <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                             Recent Users
                                         </h3>
                                         <a href="/superadmin/users"
                                             class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                                     </div>
                                     <div class="p-2 space-y-1">
                                         <% if (recentUsers && recentUsers.length> 0) { %>
                                             <% recentUsers.forEach(u=> { %>
                                                 <div
                                                     class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-all group">
                                                     <div
                                                         class="size-8 rounded-md bg-slate-100 dark:bg-slate-700 overflow-hidden flex-shrink-0 shadow-sm">
                                                         <% if (u.profilePicture) { %>
                                                             <img src="<%= u.profilePicture %>"
                                                                 class="w-full h-full object-cover" alt="">
                                                             <% } else { %>
                                                                 <div
                                                                     class="w-full h-full flex items-center justify-center text-xs font-bold text-slate-400">
                                                                     <%= u.name ? u.name[0].toUpperCase() : '?' %>
                                                                 </div>
                                                                 <% } %>
                                                     </div>
                                                     <div class="flex-1 min-w-0">
                                                         <p
                                                             class="text-[11px] font-bold text-slate-900 dark:text-slate-100 truncate tracking-tight">
                                                             <%= u.name %>
                                                         </p>
                                                         <p
                                                             class="text-[9px] text-slate-500 dark:text-slate-400 truncate opacity-80">
                                                             <%= u.email %>
                                                         </p>
                                                     </div>
                                                     <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
                                                         <span class="text-[9px] font-bold px-2 py-0.5 rounded-md capitalize tracking-wider
                                                     <%= u.role === 'superadmin' ? 'bg-purple-500/10 text-purple-500 border border-purple-500/20' :
                                                        u.role === 'admin' ? 'bg-blue-500/10 text-blue-500 border border-blue-500/20' :
                                                        u.role === 'teacher' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/20' :
                                                        u.role === 'student' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' :
                                                        'bg-slate-500/10 text-slate-500 border border-slate-500/20' %>">
                                                              <%= u.role %>
                                                         </span>
                                                          <span
                                                              class="text-[8px] font-bold text-slate-400">
                                                              <%= new Date(u.createdAt).toLocaleDateString('en-GB', {
                                                                 day: '2-digit' , month: 'short' }) %>
                                                          </span>
                                                     </div>
                                                 </div>
                                                 <% }) %>
                                                     <% } else { %>
                                                         <div
                                                             class="flex flex-col items-center justify-center py-8 opacity-40">
                                                             <span
                                                                 class="material-symbols-rounded text-3xl mb-1">person_off</span>
                                                             <p class="text-[10px] font-bold">No users yet</p>
                                                         </div>
                                                         <% } %>
                                     </div>
                                 </div>
                             </div>
  


                             <!-- Recent Courses + Top Courses - Unified Grid -->
                             <div class="grid grid-cols-1 lg:grid-cols-2 gap-1">
                                 <!-- Recent Courses -->
                                 <div
                                     class="bg-white dark:bg-[#0b1120] flex flex-col overflow-hidden border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                                     <div
                                         class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                         <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">
                                             Recent Courses</h3>
                                         <a href="/superadmin/courses"
                                             class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                                     </div>
                                     <div class="p-2 space-y-1">
                                         <% if (recentCourses && recentCourses.length> 0) { %>
                                             <% recentCourses.forEach(c=> { %>
                                                 <div
                                                     class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-all group">
                                                     <div
                                                         class="size-8 rounded-md bg-amber-500/10 text-amber-500 flex items-center justify-center flex-shrink-0 shadow-sm border border-amber-500/10">
                                                         <span
                                                             class="material-symbols-rounded text-sm">auto_stories</span>
                                                     </div>
                                                     <div class="flex-1 min-w-0">
                                                         <p
                                                             class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate tracking-tight">
                                                             <%= c.title %> - <span class="text-blue-500 text-[10px]"><%= c.classLevel %></span>
                                                         </p>
                                                          <p
                                                              class="text-[9px] text-slate-500 dark:text-slate-400 opacity-80 font-bold">
                                                              <%= c.subject || '—' %>
                                                          </p>
                                                     </div>
                                                 </div>
                                                 <% }) %>
                                                     <% } else { %>
                                                         <div
                                                             class="flex flex-col items-center justify-center py-4 opacity-40">
                                                              <p class="text-[9px] font-bold">No Courses Yet</p>
                                                         </div>
                                                         <% } %>
                                     </div>
                                 </div>
 
                                 <!-- Top Courses by Enrollment -->
                                 <div
                                     class="bg-white dark:bg-[#0b1120] flex flex-col overflow-hidden border border-slate-200 dark:border-slate-700/50 rounded-md shadow-sm">
                                     <div
                                         class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                         <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">
                                             Top Courses</h3>
                                         <span
                                             class="text-[11px] font-bold tracking-wide text-slate-500">Enrollment</span>
                                     </div>
                                     <div class="p-2 space-y-1">
                                         <% if (topCourses && topCourses.length> 0) { %>
                                             <% topCourses.forEach((c, i)=> { %>
                                                 <div class="flex items-center gap-3">
                                                     <span
                                                         class="text-xs font-black text-slate-800 dark:text-white w-4">
                                                         <%= i + 1 %>
                                                     </span>
                                                      <div class="flex-1 min-w-0">
                                                           <p
                                                               class="text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate mb-1 tracking-wide">
                                                               <%= c.title %> - <span class="text-blue-500 text-[9px]"><%= c.classLevel %></span>
                                                           </p>
                                                         <div class="flex items-center gap-3">
                                                             <div
                                                                 class="flex-1 h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                                 <div class="h-full bg-primary rounded-full shadow-[0_0_8px_rgba(59,130,246,0.3)] transition-all duration-1000"
                                                                     style="width: <%= (topCourses.length > 0 && topCourses[0].studentCount > 0) ? Math.round((c.studentCount / topCourses[0].studentCount) * 100) + '%' : '0' %>">
                                                                 </div>
                                                             </div>
                                                             <span
                                                                 class="text-[9px] font-bold text-slate-400 dark:text-slate-500 whitespace-nowrap">
                                                                 <%= c.studentCount %>
                                                             </span>
                                                         </div>
                                                     </div>
                                                 </div>
                                                 <% }) %>
                                                     <% } else { %>
                                                         <p
                                                             class="text-[9px] text-slate-400 text-center py-4 font-bold">
                                                              No Enrollment Data</p>
                                                         <% } %>
                                     </div>
                                 </div>
                             </div>
                </section>
        </main>
    </div>

    <!-- Passing Data to JS via JSON script tag -->
    <script type="application/json" id="chartData">
        {
            "revenue": <%- JSON.stringify(revenue.chart || []) %>,
            "categories": <%- JSON.stringify(revenue.byCategory || []) %>
        }
    </script>

    <script>
        // Block 1: Basic UI
        (function () {
            window.toggleAdminSidebar = function () {
                const s = document.getElementById('adminSidebar');
                if (s) s.classList.toggle('active');
            };
        })();

        // Block 2: Live Stats Polling & Performance Tracking
        (function () {
            let updateInterval;

            async function refreshStats() {
                const startTime = Date.now();
                try {
                    const r = await fetch('/superadmin/stats/live');
                    const latency = Date.now() - startTime;
                    const d = await r.json();

                    if (d.success) {
                        const s = d.stats;
                        const set = (id, v) => { const e = document.getElementById(id); if (e) e.innerText = v; };
                        set('stat-student-count', s.studentCount.toLocaleString());
                        set('stat-guardian-count', s.guardianCount.toLocaleString());
                        set('stat-today-revenue', '+৳' + (s.revenue.today || 0));
                        set('stat-total-revenue', '৳' + ((s.revenue.total || 0) / 1000).toFixed(1) + 'K');
                        set('stat-monthly-revenue', '৳' + ((s.revenue.monthly || 0) / 1000).toFixed(1) + 'K');
                        set('stat-course-count', s.courseCount);
                        set('stat-staff-count', s.staffCount);

                        // Update Header Badges
                        const msgBadge = document.getElementById('msg-badge');
                        if (msgBadge) {
                            msgBadge.innerText = s.unreadMessageCount || 0;
                            msgBadge.classList.toggle('hidden', s.unreadMessageCount <= 0);
                        }
                        const notifBadge = document.getElementById('notif-badge');
                        if (notifBadge) {
                            notifBadge.classList.toggle('hidden', s.unreadNotificationCount <= 0);
                        }

                        // Update Chart Live
                        if (window.revenueChartInstance && s.revenue.chart) {
                            const labels = [];
                            const amounts = [];
                            const today = new Date();
                            for (let i = 6; i >= 0; i--) {
                                const d = new Date(); d.setDate(today.getDate() - i);
                                const ds = d.toISOString().split('T')[0];
                                labels.push(d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }));
                                const match = s.revenue.chart.find(item => item._id === ds);
                                amounts.push(match ? match.total : 0);
                            }
                            window.revenueChartInstance.data.labels = labels;
                            window.revenueChartInstance.data.datasets[0].data = amounts;
                            window.revenueChartInstance.update('none');
                        }

                        // Update Category Chart Live
                        if (window.categoryChartInstance && s.revenue.byCategory) {
                            const labels = s.revenue.byCategory.map(c => c._id || 'Uncategorized');
                            const data = s.revenue.byCategory.map(c => c.total);
                            window.categoryChartInstance.data.labels = labels;
                            window.categoryChartInstance.data.datasets[0].data = data;
                            window.categoryChartInstance.update('none');
                            
                            // Update Custom Legend
                            updateCustomLegend(s.revenue.byCategory);
                        }
                    }
                } catch (e) {
                    console.error('Stats Sync Error:', e);
                }
            }

            function updateCustomLegend(catData) {
                const legendEl = document.getElementById('categoryLegend');
                if (!legendEl) return;
                
                const colors = ['#137fec', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'];
                legendEl.innerHTML = catData.map((c, i) => `
                    <div class="flex items-center gap-4 group cursor-default">
                        <div class="flex items-center gap-2.5 min-w-[120px]">
                            <div class="size-2.5 rounded-full flex-shrink-0" style="background-color: ${colors[i % colors.length]}"></div>
                            <span class="text-[13px] font-bold text-slate-600 dark:text-slate-400 truncate">${c._id || 'Uncategorized'}</span>
                        </div>
                        <span class="text-[13px] font-black text-slate-600 dark:text-slate-400">৳${c.total.toLocaleString()}</span>
                    </div>
                `).join('');
            }

            // Start polling
            updateInterval = setInterval(refreshStats, 10000);
            refreshStats();

            // Cleanup on page unload
            window.addEventListener('beforeunload', () => {
                if (updateInterval) clearInterval(updateInterval);
            });
        })();

        // Block 3: Chart Initialization
        window.addEventListener('DOMContentLoaded', () => {
            try {
                const dataContainer = document.getElementById('chartData');
                if (!dataContainer) return;

                const data = JSON.parse(dataContainer.textContent);
                const rawData = data.revenue || [];
                const catData = data.categories || [];

                // Revenue Chart
                const revenueCanvas = document.getElementById('revenueChart');
                if (revenueCanvas) {
                    const ctx = revenueCanvas.getContext('2d');
                    const labels = [];
                    const amounts = [];
                    const today = new Date();
                    for (let i = 6; i >= 0; i--) {
                        const d = new Date(); d.setDate(today.getDate() - i);
                        const ds = d.toISOString().split('T')[0];
                        labels.push(d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }));
                        const match = rawData.find(item => item._id === ds);
                        amounts.push(match ? match.total : 0);
                    }

                    window.revenueChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Revenue (৳)',
                                data: amounts,
                                borderColor: '#137fec',
                                backgroundColor: 'rgba(19, 127, 236, 0.1)',
                                fill: true,
                                tension: 0.4,
                                borderWidth: 3,
                                pointBackgroundColor: '#137fec',
                                pointBorderColor: '#fff',
                                pointBorderWidth: 2,
                                pointRadius: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#1e293b',
                                    padding: 12,
                                    cornerRadius: 10,
                                    callbacks: {
                                        label: (c) => ' ৳' + c.parsed.y.toLocaleString()
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(0,0,0,0.03)' },
                                    ticks: {
                                        callback: (v) => '৳' + v,
                                        font: { size: 10 }
                                    }
                                },
                                x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                            }
                        }
                    });
                }

                // Category Doughnut Chart
                const catCanvas = document.getElementById('categoryChart');
                if (catCanvas && catData && catData.length > 0) {
                    const catCtx = catCanvas.getContext('2d');
                    window.categoryChartInstance = new Chart(catCtx, {
                        type: 'doughnut',
                        data: {
                            labels: catData.map(c => c._id || 'Uncategorized'),
                            datasets: [{
                                data: catData.map(c => c.total),
                                backgroundColor: [
                                    '#137fec', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'
                                ],
                                borderWidth: 0,
                                hoverOffset: 10
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#1e293b',
                                    padding: 12,
                                    cornerRadius: 10,
                                    callbacks: {
                                        label: (c) => {
                                            const total = catData.reduce((a, b) => a + b.total, 0);
                                            const percentage = total > 0 ? ((c.raw / total) * 100).toFixed(1) : 0;
                                            return ` ৳${c.raw.toLocaleString()} (${percentage}%)`;
                                        }
                                    }
                                }
                            },
                            cutout: '75%'
                        }
                    });
                    
                    // Initial Legend
                    updateCustomLegend(catData);
                }
            } catch (e) {
                console.error('Chart Init Error:', e);
            }
        });
    </script>
</body>

</html>
