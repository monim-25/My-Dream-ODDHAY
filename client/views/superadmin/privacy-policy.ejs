<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Privacy Policy Control | ODDHAY Command Center</title>
    <style>
        :root {
            --admin-sidebar-width: 260px;
        }

        .admin-sidebar {
            width: var(--admin-sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .admin-main {
            margin-left: var(--admin-sidebar-width);
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        @media (max-width: 1024px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-sidebar.active {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen antialiased">

    <div class="flex">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'privacy-policy' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 ml-[260px] bg-[#FFFFFF] dark:bg-[#020617] flex flex-col min-h-screen w-full">
            <%- include('header_v2', { pageTitle: 'Privacy Policy Control' }) %>

            <section class="p-4 sm:p-6 max-w-5xl w-full mx-auto space-y-6">

                <!-- Success Alert -->
                <% if (locals.success) { %>
                    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-emerald-800 dark:text-emerald-200 flex items-center justify-between shadow-xs">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-xl">check_circle</span>
                            <span class="text-xs sm:text-sm font-semibold">Privacy Policy settings updated successfully!</span>
                        </div>
                        <a href="/privacy-policy" target="_blank" class="text-xs font-semibold underline text-emerald-700 dark:text-emerald-300 hover:text-emerald-900">
                            View Live Page &rarr;
                        </a>
                    </div>
                <% } %>

                <!-- Header Actions Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg">policy</span>
                            <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">Public Privacy Policy Management</h2>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            Update the official public Privacy Policy displayed at <code class="px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-[11px] text-emerald-600 dark:text-emerald-400">/privacy-policy</code>
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/privacy-policy" target="_blank" class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 flex items-center gap-1.5 shadow-2xs">
                            <span class="material-symbols-rounded text-sm">open_in_new</span>
                            <span>View Live</span>
                        </a>
                    </div>
                </div>

                <!-- Form -->
                <form action="/superadmin/privacy-policy" method="POST" class="space-y-6">
                    
                    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-5">
                        
                        <!-- Meta Title & Last Updated -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    Browser Page Title
                                </label>
                                <input type="text" name="metaTitle"
                                    value="<%= (settings.privacyPolicy && settings.privacyPolicy.metaTitle) ? settings.privacyPolicy.metaTitle : 'Privacy Policy | ODDHAY' %>"
                                    placeholder="Privacy Policy | ODDHAY"
                                    class="w-full h-10 px-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                                    Last Updated Text
                                </label>
                                <input type="text" name="lastUpdated"
                                    value="<%= (settings.privacyPolicy && settings.privacyPolicy.lastUpdated) ? settings.privacyPolicy.lastUpdated : 'February 2026' %>"
                                    placeholder="February 2026"
                                    class="w-full h-10 px-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                            </div>
                        </div>

                        <!-- Custom Content Textarea -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                    Custom Privacy Policy Content (HTML / Text)
                                </label>
                                <span class="text-[11px] text-slate-400">Leave blank to use the built-in concise policy</span>
                            </div>
                            <textarea name="customContent" id="policyContentEditor" rows="14"
                                placeholder="Write custom privacy policy content here or leave blank to display the built-in English sections..."
                                class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed"><%= (settings.privacyPolicy && settings.privacyPolicy.customContent) ? settings.privacyPolicy.customContent : '' %></textarea>
                            <p class="text-[11px] text-slate-400 mt-1.5 leading-relaxed">
                                <span class="font-semibold text-slate-500">Tip:</span> You can insert paragraphs with <code class="text-emerald-500">&lt;p&gt;</code>, headings with <code class="text-emerald-500">&lt;h3&gt;</code>, and lists with <code class="text-emerald-500">&lt;ul&gt;&lt;li&gt;</code>. If this field is left empty, the site automatically displays the clean default policy.
                            </p>
                        </div>

                    </div>

                    <!-- Submit Button -->
                    <div class="flex items-center justify-end gap-3 pt-2">
                        <button type="submit"
                            class="px-6 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs transition-all shadow-xs flex items-center gap-2 cursor-pointer active:scale-98">
                            <span class="material-symbols-rounded text-sm">save</span>
                            <span>Save Privacy Policy</span>
                        </button>
                    </div>

                </form>

            </section>
        </main>
    </div>

</body>

</html>
