                                <span>Sub-topics under "${escapeSuperHtml(t.name)}"</span>
                            </label>
                            <span class="text-[10px] text-slate-400 font-normal">Press Enter to add</span>
                        </div>
                        
                        <!-- Add Sub-topic Input & Button -->
                        <div class="flex items-center gap-1.5">
                            <input type="text" id="superNewSubTopicInput_${idx}" placeholder="e.g. গতি ও স্থিতি, ত্বরণ..." onkeydown="if(event.key==='Enter'){event.preventDefault(); addSuperadminSubTopic(${idx});}" class="flex-1 h-8 px-2.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                            <button type="button" onclick="addSuperadminSubTopic(${idx})" class="h-8 px-3 rounded bg-primary hover:bg-primary-dark text-white text-xs font-medium flex items-center gap-1 transition-colors shrink-0">
                                <span class="material-symbols-rounded text-sm">add</span>
                                <span>Add</span>
