        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('hidden');
        }

        let superCurrentStep = 1;
        let superStagedTopics = [];

        function escapeSuperHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function openUnifiedModal(chapterName = '', chapterNum = 1, defaultMode = 'single', prefillSegment = '') {
            const form = document.getElementById('unifiedTopicForm');
            if (form) form.reset();
            superStagedTopics = [];
            goToSuperadminTopicStep(1);

            if (chapterName) {
                document.getElementById('unifiedChapterName').value = chapterName;
                document.getElementById('unifiedChapterNumber').value = chapterNum;
            } else {
                document.getElementById('unifiedChapterName').value = '';
                document.getElementById('unifiedChapterNumber').value = '1';
            }
            setTopicMode(defaultMode);
            document.getElementById('unifiedTopicModal').classList.remove('hidden');

            const targetSeg = prefillSegment || ('<%= (selSegment !== "all") ? selSegment : "" %>');
            checkUnifiedModalSegments(targetSeg);
        }

        async function checkUnifiedModalSegments(prefillVal = '') {
            const wrap = document.getElementById('unifiedModalSegmentWrap');
            const select = document.getElementById('unifiedSegmentSelect');
            if (!wrap || !select) return;

            const subject = document.getElementById('unifiedSubject')?.value.trim();
            const checkedClasses = Array.from(document.querySelectorAll('#unifiedModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            const classLevel = checkedClasses[0] || '<%= selClass %>';

            if (!subject) {
                wrap.classList.add('hidden');
                select.innerHTML = '<option value="">Select Segment...</option>';
                select.required = false;
                return;
            }

            try {
                const res = await fetch(`/api/subjects/segments?subject=${encodeURIComponent(subject)}&classLevel=${encodeURIComponent(classLevel)}`);
                const data = await res.json();
                if (data && data.hasSegments && Array.isArray(data.segments) && data.segments.length > 0) {
                    wrap.classList.remove('hidden');
                    select.required = true;
                    let opts = '<option value="">Select Segment...</option>';
                    data.segments.forEach(seg => {
                        const isSel = (prefillVal && prefillVal === seg) ? 'selected' : '';
                        opts += `<option value="${seg}" ${isSel}>${seg}</option>`;
                    });
                    select.innerHTML = opts;
                    if (prefillVal) {
                        select.value = prefillVal;
                    }
                } else {
                    wrap.classList.add('hidden');
                    select.required = false;
                    select.innerHTML = '<option value="">Select Segment...</option>';
                    select.value = '';
                }
            } catch (err) {
                console.error('Error fetching segments:', err);
            }
        }

        function collectSuperadminStep1Topics() {
            const checkedClasses = Array.from(document.querySelectorAll('#unifiedModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            if (checkedClasses.length === 0) {
                Swal.fire('Select Class', 'Please select at least one class for these topics.', 'warning');
                return false;
            }
            const subject = document.getElementById('unifiedSubject')?.value.trim();
            if (!subject) {
                Swal.fire('Select Subject', 'Please enter or select a subject.', 'warning');
                return false;
            }

            const segmentWrap = document.getElementById('unifiedModalSegmentWrap');
            const segmentSelect = document.getElementById('unifiedSegmentSelect');
            if (segmentWrap && !segmentWrap.classList.contains('hidden')) {
                if (!segmentSelect || !segmentSelect.value) {
                    Swal.fire('Segment Required', 'Please select a Segment / বিভাগ for this subject.', 'warning');
                    return false;
                }
            }

            const chapterName = document.getElementById('unifiedChapterName')?.value.trim();
            if (!chapterName) {
                Swal.fire('Chapter Required', 'Please enter a Chapter Name.', 'warning');
                return false;
            }
            const chapterNumber = parseInt(document.getElementById('unifiedChapterNumber')?.value, 10);
            if (isNaN(chapterNumber) || chapterNumber < 1) {
                Swal.fire('Invalid Chapter #', 'Please enter a valid Chapter Number (1 or greater).', 'warning');
                return false;
            }

            if (currentModalMode === 'single') {
                const singleName = document.getElementById('singleTopicName')?.value.trim();
                if (!singleName && superStagedTopics.length === 0) {
                    Swal.fire('Topic Name Required', 'Please enter a Topic Name.', 'warning');
                    return false;
                }
                if (singleName) {
                    const existingSubs = (superStagedTopics[0] && superStagedTopics[0].subTopics) ? superStagedTopics[0].subTopics : [];
                    superStagedTopics = [{
                        name: singleName,
                        code: document.getElementById('singleTopicCode')?.value.trim() || '',
                        difficulty: document.getElementById('singleTopicDifficulty')?.value || 'Medium',
                        description: document.getElementById('singleTopicDesc')?.value.trim() || '',
                        subTopics: existingSubs
                    }];
                }
            } else {
                const bulkText = document.getElementById('bulkTopicList')?.value.trim();
                if (!bulkText && superStagedTopics.length === 0) {
                    Swal.fire('Topics Required', 'Please enter topic names (one per line).', 'warning');
                    return false;
                }
                if (bulkText) {
                    const lines = bulkText.split('\n').map(l => l.trim()).filter(Boolean);
                    const subTopicsMap = new Map();
                    superStagedTopics.forEach(t => {
                        if (t && t.name) subTopicsMap.set(t.name.toLowerCase(), t.subTopics || []);
                    });
                    const bulkDiff = document.getElementById('bulkTopicDifficulty')?.value || 'Medium';
                    superStagedTopics = lines.map(lineName => ({
                        name: lineName,
                        code: '',
                        difficulty: bulkDiff,
                        description: '',
                        subTopics: subTopicsMap.get(lineName.toLowerCase()) || []
                    }));
                }
            }

            if (superStagedTopics.length === 0) {
                Swal.fire('No Topics', 'Please enter at least one topic name.', 'warning');
                return false;
            }
            return true;
        }

        function submitSuperadminDirectlyFromStep1() {
            if (!collectSuperadminStep1Topics()) return;
            submitSuperadminStagedTopics();
        }

        function goToSuperadminTopicStep(step) {
            if (step === 2) {
                if (!collectSuperadminStep1Topics()) return;

                const subject = document.getElementById('unifiedSubject')?.value.trim();
                const chapterName = document.getElementById('unifiedChapterName')?.value.trim();
