                                <span id="superExpandIcon_${idx}" class="material-symbols-rounded text-base transition-transform">expand_more</span>
                                <span id="superExpandText_${idx}">Expand</span>
                            </button>
                            <button type="button" onclick="removeSuperadminStagedTopic(${idx})" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors" title="Delete topic">
                                <span class="material-symbols-rounded text-sm">delete</span>
                            </button>
                        </div>
                    </div>

                    <!-- Expandable Sub-topics Section -->
                    <div id="superSubtopicsPanel_${idx}" class="hidden p-3 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/50 space-y-2">
