                `;
            }).join('');
        }

        function renderSuperadminSubTopicsList(subTopics, topicIdx) {
            if (!Array.isArray(subTopics) || subTopics.length === 0) {
                return '<p class="text-[11px] text-slate-400 italic py-1">No sub-topics added yet. Type a sub-topic above and click Add.</p>';
            }
            return subTopics.map((st, sIdx) => `
                <div class="flex items-center justify-between p-1.5 px-2.5 rounded bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs shadow-2xs">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                        <span class="size-1.5 rounded-full bg-primary shrink-0"></span>
                        <span class="text-slate-700 dark:text-slate-200 break-words font-medium text-[11px]">${escapeSuperHtml(st)}</span>
                    </div>
                    <button type="button" onclick="removeSuperadminSubTopic(${topicIdx}, ${sIdx})" class="size-5 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors shrink-0" title="Remove sub-topic">
                        <span class="material-symbols-rounded text-xs">close</span>
                    </button>
                </div>
            `).join('');
        }

        function toggleSuperadminExpandTopic(idx) {
            const panel = document.getElementById(`superSubtopicsPanel_${idx}`);
            const icon = document.getElementById(`superExpandIcon_${idx}`);
            const text = document.getElementById(`superExpandText_${idx}`);
            if (!panel) return;
            const isHidden = panel.classList.contains('hidden');
            if (isHidden) {
                panel.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
                if (text) text.textContent = 'Collapse';
                const input = document.getElementById(`superNewSubTopicInput_${idx}`);
                if (input) setTimeout(() => input.focus(), 50);
            } else {
                panel.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
                if (text) text.textContent = 'Expand';
            }
        }

        function addSuperadminSubTopic(idx) {
            const input = document.getElementById(`superNewSubTopicInput_${idx}`);
            if (!input) return;
            const val = input.value.trim();
            if (!val) return;

            if (!Array.isArray(superStagedTopics[idx].subTopics)) {
                superStagedTopics[idx].subTopics = [];
            }
            if (!superStagedTopics[idx].subTopics.includes(val)) {
                superStagedTopics[idx].subTopics.push(val);
            }
            input.value = '';

            const listEl = document.getElementById(`superSubtopicsList_${idx}`);
            if (listEl) {
                listEl.innerHTML = renderSuperadminSubTopicsList(superStagedTopics[idx].subTopics, idx);
            }
            const countEl = document.getElementById(`superStagedTopicCount_${idx}`);
            if (countEl) {
                const c = superStagedTopics[idx].subTopics.length;
                countEl.textContent = `${c} sub-topic${c === 1 ? '' : 's'}`;
                countEl.className = `text-[10px] font-medium px-2 py-0.5 rounded ${c > 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'}`;
            }
            input.focus();
        }

        function removeSuperadminSubTopic(topicIdx, subIdx) {
            if (superStagedTopics[topicIdx] && Array.isArray(superStagedTopics[topicIdx].subTopics)) {
                superStagedTopics[topicIdx].subTopics.splice(subIdx, 1);
                const listEl = document.getElementById(`superSubtopicsList_${topicIdx}`);
                if (listEl) {
                    listEl.innerHTML = renderSuperadminSubTopicsList(superStagedTopics[topicIdx].subTopics, topicIdx);
                }
                const countEl = document.getElementById(`superStagedTopicCount_${topicIdx}`);
                if (countEl) {
                    const c = superStagedTopics[topicIdx].subTopics.length;
                    countEl.textContent = `${c} sub-topic${c === 1 ? '' : 's'}`;
                    countEl.className = `text-[10px] font-medium px-2 py-0.5 rounded ${c > 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'}`;
                }
            }
        }

        function removeSuperadminStagedTopic(idx) {
            if (superStagedTopics.length <= 1) {
                Swal.fire('Notice', 'At least one topic is required.', 'info');
                return;
            }
            superStagedTopics.splice(idx, 1);
            renderSuperadminStagedTopics();
        }

        async function addSuperadminAnotherTopicPrompt() {
            const { value: topicName } = await Swal.fire({
                title: 'Add Another Topic',
                input: 'text',
                inputLabel: 'Topic Name',
                inputPlaceholder: 'Enter topic name...',
                showCancelButton: true,
                confirmButtonText: 'Add Topic',
                confirmButtonColor: '#137fec',
                inputValidator: (value) => {
                    if (!value || !value.trim()) return 'Topic name cannot be empty';
                }
            });
            if (topicName && topicName.trim()) {
                superStagedTopics.push({
                    name: topicName.trim(),
                    code: '',
                    difficulty: 'Medium',
                    description: '',
                    subTopics: []
                });
                renderSuperadminStagedTopics();
                setTimeout(() => toggleSuperadminExpandTopic(superStagedTopics.length - 1), 50);
            }
        }

        async function submitSuperadminStagedTopics() {
            if (superStagedTopics.length === 0) {
                return Swal.fire('No Topics', 'Please add at least one topic.', 'warning');
            }

            const checkedClasses = Array.from(document.querySelectorAll('#unifiedModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            if (checkedClasses.length === 0) {
                return Swal.fire('Select Class', 'Please select at least one class for these topics.', 'warning');
            }

            const form = document.getElementById('unifiedTopicForm');
            const classLevels = checkedClasses;
            const classLevel = checkedClasses[0];
            const group = form.group ? form.group.value : 'None';
            const subject = form.subject ? form.subject.value.trim() : '';
            const segment = document.getElementById('unifiedSegmentSelect')?.value.trim() || '';
            const chapterName = form.chapterName.value.trim();
            const chapterNumber = form.chapterNumber.value;

            const payload = {
                classLevels,
                classLevel,
                group,
                subject,
                segment,
                chapterName,
                chapterNumber,
                topics: superStagedTopics
            };

            const btn = document.getElementById('superUnifiedFinalSubmitBtn');
            const origText = btn ? btn.innerHTML : 'Save Topics';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-rounded text-sm animate-spin">refresh</span> Processing...';
            }

            try {
                const res = await fetch(`${apiBase}/topics/bulk`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });
                const text = await res.text();
                let data = {};
                try { data = JSON.parse(text); } catch(e) { data = { error: text.replace(/<[^>]*>?/gm, '').trim() }; }

                if (res.ok && data.success) {
                    await Swal.fire({ icon: 'success', title: 'Topics Saved!', text: data.message, timer: 1200, showConfirmButton: false });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to save topics', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                }
            }
        }

        async function submitUnifiedForm(e) {
            e.preventDefault();
            if (superCurrentStep === 1) {
                goToSuperadminTopicStep(2);
            } else {
                submitSuperadminStagedTopics();
            }
        }

