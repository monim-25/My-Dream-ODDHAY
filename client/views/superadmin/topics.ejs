                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span id="superStagedTopicCount_${idx}" class="text-[10px] font-medium px-2 py-0.5 rounded ${subCount > 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'}">
