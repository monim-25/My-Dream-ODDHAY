        // ==========================================
        // TEACHER SUBMISSION APPROVAL SYSTEM
        // ==========================================
        function toggleSelectAllPending(checked) {
            const checkboxes = document.querySelectorAll('.pending-topic-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = checked;
            });
            updateSelectedPendingCount();
        }

        function updateSelectedPendingCount() {
            const checkboxes = document.querySelectorAll('.pending-topic-checkbox');
            const checkedBoxes = document.querySelectorAll('.pending-topic-checkbox:checked');
            const count = checkedBoxes.length;

            const selectAll = document.getElementById('selectAllPending');
            if (selectAll) {
                selectAll.checked = (checkboxes.length > 0 && count === checkboxes.length);
                selectAll.indeterminate = (count > 0 && count < checkboxes.length);
            }

            const btnApprove = document.getElementById('btnBulkApprovePending');
            const btnReject = document.getElementById('btnBulkRejectPending');
            const btnApproveText = document.getElementById('btnBulkApproveText');

            if (btnApprove) btnApprove.disabled = (count === 0);
            if (btnReject) btnReject.disabled = (count === 0);
            if (btnApproveText) {
                btnApproveText.textContent = count > 0 ? `Approve Selected (${count})` : 'Approve Selected';
            }
        }

        async function approveSingleTopic(id, name) {
            const result = await Swal.fire({
                title: 'Approve Topic?',
                html: `Are you sure you want to approve <strong>"${name}"</strong>?<br><span class="text-xs text-slate-500">This topic will immediately become available in the live curriculum & question bank.</span>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Approve',
                cancelButtonText: 'Cancel'
            });

            if (!result.isConfirmed) return;

            try {
                const res = await fetch(`${apiBase}/topics/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, topicId: id })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Approved!',
                        text: data.message || `Topic "${name}" approved successfully.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=pending';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to approve topic', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function rejectSingleTopic(id, name) {
            const { value: reason } = await Swal.fire({
                title: 'Reject Topic Submission',
                text: `Provide revision feedback for "${name}" so the teacher knows what to correct:`,
                input: 'textarea',
                inputPlaceholder: 'e.g. Please format chapter name properly, or add detailed topic descriptions...',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Reject Submission',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please provide a reason or guidance for the teacher!';
                    }
                }
            });

            if (!reason) return;

            try {
                const res = await fetch(`${apiBase}/topics/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, topicId: id, reason: reason.trim() })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'info',
                        title: 'Submission Rejected',
                        text: data.message || 'Topic sent back to teacher for revisions.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=pending';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to reject topic', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function bulkApproveSelectedPending() {
            const checkedBoxes = document.querySelectorAll('.pending-topic-checkbox:checked');
            const topicIds = Array.from(checkedBoxes).map(cb => cb.dataset.id).filter(Boolean);

            if (topicIds.length === 0) {
                Swal.fire('Notice', 'Please select at least one pending topic to approve.', 'info');
                return;
            }

            const result = await Swal.fire({
                title: `Approve ${topicIds.length} Selected Topics?`,
                text: 'All selected topics will immediately be published into the live syllabus.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: `Yes, Approve (${topicIds.length})`,
                cancelButtonText: 'Cancel'
            });

            if (!result.isConfirmed) return;

            try {
                const res = await fetch(`${apiBase}/topics/bulk-approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topicIds })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Approved!',
                        text: data.message || `${topicIds.length} topics approved successfully.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=pending';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to bulk approve topics', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function bulkRejectSelectedPending() {
            const checkedBoxes = document.querySelectorAll('.pending-topic-checkbox:checked');
            const topicIds = Array.from(checkedBoxes).map(cb => cb.dataset.id).filter(Boolean);

            if (topicIds.length === 0) {
                Swal.fire('Notice', 'Please select at least one pending topic to reject.', 'info');
                return;
            }

            const { value: reason } = await Swal.fire({
                title: `Reject ${topicIds.length} Selected Submissions`,
                text: `Provide revision reason/feedback for these ${topicIds.length} topics:`,
                input: 'textarea',
                inputPlaceholder: 'Reason for rejection/revision guidance...',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: `Reject ${topicIds.length} Topics`,
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please provide a reason or guidance for the teacher!';
                    }
                }
            });

            if (!reason) return;

            try {
                const res = await fetch(`${apiBase}/topics/bulk-reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topicIds, reason: reason.trim() })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'info',
                        title: 'Submissions Rejected',
                        text: data.message || `${topicIds.length} topics marked as rejected.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=pending';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to bulk reject topics', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        // ==========================================
        // DELETION REQUEST MANAGEMENT (ADMIN)
        // ==========================================
        function toggleSelectAllDeletion(checked) {
            const checkboxes = document.querySelectorAll('.deletion-request-checkbox');
            checkboxes.forEach(cb => cb.checked = checked);
            updateSelectedDeletionCount();
        }

        function updateSelectedDeletionCount() {
            const checkedBoxes = document.querySelectorAll('.deletion-request-checkbox:checked');
            const count = checkedBoxes.length;
            const btnApprove = document.getElementById('btnBulkApproveDeletion');
            const btnDecline = document.getElementById('btnBulkDeclineDeletion');
            const btnApproveText = document.getElementById('btnBulkApproveDeletionText');

            if (btnApprove) btnApprove.disabled = (count === 0);
            if (btnDecline) btnDecline.disabled = (count === 0);
            if (btnApproveText) {
                btnApproveText.textContent = count > 0 ? `Approve Selected (${count})` : 'Approve Selected';
            }
        }

        async function approveSingleDeletion(id, name) {
            const { value: deleteMode } = await Swal.fire({
                title: 'Approve Deletion Request?',
                html: `
                    <p class="text-xs text-slate-600 dark:text-slate-300 mb-3">Topic <strong>"${name}"</strong> deletion request was submitted by teacher.</p>
                    <p class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1">Choose deletion method:</p>
                `,
                input: 'radio',
                inputOptions: {
                    'archive': 'Move to History Bucket (Recommended - keeps question attempts intact)',
                    'permanent': 'Permanently Delete from Database'
                },
                inputValue: 'archive',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Confirm & Approve',
                cancelButtonText: 'Cancel'
            });

            if (!deleteMode) return;

            try {
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/deletion-request/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds: [id], deleteMode })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Approved!',
                        text: data.message || 'Deletion request approved successfully.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=deletion';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to approve deletion', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function declineSingleDeletion(id, name) {
            const { value: reason } = await Swal.fire({
                title: 'Decline Deletion Request',
                text: `Provide a reason to inform the teacher why "${name}" will not be deleted:`,
                input: 'textarea',
                inputPlaceholder: 'e.g. This topic is essential for the upcoming exam syllabus...',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Decline Request',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please provide a reason for declining!';
                    }
                }
            });

            if (!reason) return;

            try {
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/deletion-request/decline`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds: [id], reason: reason.trim() })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'info',
                        title: 'Request Declined',
                        text: data.message || 'Deletion request declined and feedback sent to teacher.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=deletion';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to decline deletion', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function bulkApproveSelectedDeletion() {
            const checkedBoxes = document.querySelectorAll('.deletion-request-checkbox:checked');
            const topicIds = Array.from(checkedBoxes).map(cb => cb.dataset.id).filter(Boolean);

            if (topicIds.length === 0) {
                Swal.fire('Notice', 'Please select at least one topic to approve deletion.', 'info');
                return;
            }

            const { value: deleteMode } = await Swal.fire({
                title: `Approve ${topicIds.length} Deletion Requests?`,
                html: `
                    <p class="text-xs text-slate-600 dark:text-slate-300 mb-3">You are about to approve deletion requests for <strong>${topicIds.length}</strong> topic(s).</p>
                    <p class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1">Choose deletion method:</p>
                `,
                input: 'radio',
                inputOptions: {
                    'archive': 'Move to History Bucket (Recommended)',
                    'permanent': 'Permanently Delete from Database'
                },
                inputValue: 'archive',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: `Yes, Approve (${topicIds.length})`,
                cancelButtonText: 'Cancel'
            });

            if (!deleteMode) return;

            try {
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/deletion-request/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds, deleteMode })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Approved!',
                        text: data.message || `${topicIds.length} topic deletion requests approved.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=deletion';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to bulk approve deletion requests', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        async function bulkDeclineSelectedDeletion() {
            const checkedBoxes = document.querySelectorAll('.deletion-request-checkbox:checked');
            const topicIds = Array.from(checkedBoxes).map(cb => cb.dataset.id).filter(Boolean);

            if (topicIds.length === 0) {
                Swal.fire('Notice', 'Please select at least one topic to decline deletion.', 'info');
                return;
            }

            const { value: reason } = await Swal.fire({
                title: `Decline ${topicIds.length} Deletion Requests`,
                text: 'Provide a reason why these deletion requests are being declined:',
                input: 'textarea',
                inputPlaceholder: 'e.g. These topics are required for the standard curriculum...',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: `Decline Selected (${topicIds.length})`,
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please provide a reason for declining!';
                    }
                }
            });

            if (!reason) return;

            try {
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/deletion-request/decline`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds, reason: reason.trim() })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'info',
                        title: 'Requests Declined',
                        text: data.message || `${topicIds.length} deletion requests declined.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = window.location.pathname + '?tab=deletion';
                } else {
                    Swal.fire('Error', (data && data.error) || 'Failed to bulk decline deletion requests', 'error');
                }
            } catch (err) {
                Swal.fire('Network Error', err.message || 'Could not connect to server', 'error');
            }
        }

        // Auto Tab from URL
        document.addEventListener('DOMContentLoaded', () => {
            const p = new URLSearchParams(window.location.search);
            if (p.get('tab') === 'archive' || window.location.hash === '#archive') {
                switchTopicTab('archive');
            } else if (p.get('tab') === 'pending' || window.location.hash === '#pending') {
                switchTopicTab('pending');
            } else if (p.get('tab') === 'deletion' || window.location.hash === '#deletion') {
                switchTopicTab('deletion');
            } else {
                switchTopicTab('active');
            }

            const modalSubInput = document.getElementById('unifiedSubject');
            if (modalSubInput) {
                modalSubInput.addEventListener('change', () => checkUnifiedModalSegments());
                modalSubInput.addEventListener('input', () => checkUnifiedModalSegments());
            }
            const modalClassGrid = document.getElementById('unifiedModalClassGrid');
            if (modalClassGrid) {
                modalClassGrid.addEventListener('change', () => checkUnifiedModalSegments());
            }
        });

        // Multi-Class Quick Selectors for Unified Modal
        function selectModalClasses(mode) {
            const cbs = document.querySelectorAll('#unifiedModalClassGrid input[name="targetClass"]');
            if (mode === 'all') {
                cbs.forEach(cb => cb.checked = true);
            } else if (mode === 'clear') {
                cbs.forEach(cb => cb.checked = false);
            } else if (mode === '9-10') {
                cbs.forEach(cb => {
                    const v = cb.value.toLowerCase();
                    cb.checked = (v.includes('9') || v.includes('10')) && !v.includes('11') && !v.includes('12');
                });
            } else if (mode === '11-12') {
                cbs.forEach(cb => {
                    const v = cb.value.toLowerCase();
                    cb.checked = v.includes('11') || v.includes('12');
                });
            }
            checkUnifiedModalSegments();
        }

        // Multi-Class Filter Dropdown Toggle & Apply
        function toggleMultiClassDropdown() {
            const menu = document.getElementById('multiClassFilterMenu');
            if (menu) menu.classList.toggle('hidden');
        }

        function applyMultiClassFilter() {
            const checked = Array.from(document.querySelectorAll('#multiClassFilterMenu input[name="filterClass"]:checked')).map(cb => cb.value);
            if (checked.length === 0) {
                return Swal.fire('Select Class', 'Please select at least one class to filter.', 'info');
            }
            const u = new URL(window.location.href);
            u.searchParams.set('classLevels', checked.join(','));
            u.searchParams.delete('classLevel');
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function selectFilterClasses(mode) {
            const cbs = document.querySelectorAll('#multiClassFilterMenu input[name="filterClass"]');
            if (mode === 'all') cbs.forEach(cb => cb.checked = true);
            else if (mode === '9-10') cbs.forEach(cb => cb.checked = (cb.value.includes('9') || cb.value.includes('10')) && !cb.value.includes('11') && !cb.value.includes('12'));
            else if (mode === '11-12') cbs.forEach(cb => cb.checked = cb.value.includes('11') || cb.value.includes('12'));
            else if (mode === 'clear') cbs.forEach(cb => cb.checked = false);
        }

        // Add Subject to Multiple Classes Modal
        function openAddSubjectModal() {
            document.getElementById('addSubjectForm').reset();
            const currentC = '<%= selClass %>';
            document.querySelectorAll('#addSubjectClassGrid input[name="addSubjectClass"]').forEach(cb => {
                cb.checked = (cb.value.toLowerCase() === currentC.toLowerCase());
            });
            document.getElementById('addSubjectModal').classList.remove('hidden');
        }

        function selectAddSubjectClasses(mode) {
            const cbs = document.querySelectorAll('#addSubjectClassGrid input[name="addSubjectClass"]');
            if (mode === 'all') cbs.forEach(cb => cb.checked = true);
            else if (mode === 'clear') cbs.forEach(cb => cb.checked = false);
            else if (mode === '9-10') cbs.forEach(cb => {
                const v = cb.value.toLowerCase();
                cb.checked = (v.includes('9') || v.includes('10')) && !v.includes('11') && !v.includes('12');
            });
            else if (mode === '11-12') cbs.forEach(cb => {
                const v = cb.value.toLowerCase();
                cb.checked = v.includes('11') || v.includes('12');
            });
        }

        async function submitAddSubject(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitAddSubject');
            const orig = btn.innerText;
            btn.disabled = true;
            btn.innerText = 'Adding...';

            const subjectName = document.getElementById('inputAddSubjectName').value.trim();
            const group = document.getElementById('selectAddSubjectGroup').value;
            const checkedClasses = Array.from(document.querySelectorAll('#addSubjectClassGrid input[name="addSubjectClass"]:checked')).map(cb => cb.value);

            if (!subjectName) {
                btn.disabled = false;
                btn.innerText = orig;
                return Swal.fire('Subject Name', 'Please enter a subject name', 'warning');
            }
            if (checkedClasses.length === 0) {
                btn.disabled = false;
                btn.innerText = orig;
                return Swal.fire('Select Classes', 'Please select at least one class for this subject', 'warning');
            }

            try {
                const res = await fetch(`${apiBase}/topics/add-subject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ subjectName, classLevels: checkedClasses, group })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({ icon: 'success', title: 'Subject Added!', text: data.message, timer: 1500, showConfirmButton: false });
                    const u = new URL(window.location.href);
                    u.searchParams.set('classLevel', checkedClasses[0]);
                    u.searchParams.set('subject', subjectName);
                    window.location.href = u.toString();
                } else {
                    Swal.fire('Error', data.error || 'Failed to add subject', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Network error', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = orig;
            }
        }

        // Copy Topics to Other Classes Modal
        function openCopyTopicsModal() {
            const ids = getSelectedLiveTopicIds();
            if (ids.length === 0) {
                return Swal.fire('Select Topics', 'Please select at least one topic first.', 'info');
            }
            document.getElementById('copyTopicsCountBadge').innerText = `${ids.length} Topics Selected`;
            const currentC = '<%= selClass %>';
            document.querySelectorAll('#copyTopicsClassGrid input[name="copyTargetClass"]').forEach(cb => {
                cb.checked = false;
                if (cb.value.toLowerCase() === currentC.toLowerCase()) {
                    cb.disabled = true;
                    cb.title = 'Current class (source)';
                } else {
                    cb.disabled = false;
                    cb.title = '';
                }
            });
            document.getElementById('copyTopicsModal').classList.remove('hidden');
        }

        async function submitCopyTopics(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitCopyTopics');
            const orig = btn.innerText;
            btn.disabled = true;
            btn.innerText = 'Copying...';

            const ids = getSelectedLiveTopicIds();
            const targetClasses = Array.from(document.querySelectorAll('#copyTopicsClassGrid input[name="copyTargetClass"]:checked')).map(cb => cb.value);

            if (targetClasses.length === 0) {
                btn.disabled = false;
                btn.innerText = orig;
                return Swal.fire('Select Target Class', 'Please select at least one class to copy topics into.', 'warning');
            }

            try {
                const res = await fetch(`${apiBase}/topics/copy-to-classes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds: ids, targetClasses })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({ icon: 'success', title: 'Topics Copied!', text: data.message, timer: 1500, showConfirmButton: false });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to copy topics', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Network error', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = orig;
            }
        }
    </script>
</body>
</html>
