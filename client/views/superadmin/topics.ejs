    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const apiBase = '<%= baseUrl %>';
        const currentClassLevel = '<%= selClass %>';
        const currentSubject = '<%= selSubject %>';
        let currentModalMode = 'single';
        let isSelectionMode = false;

        // Selection Mode Controls (Beside Add Button)
        function toggleSelectionMode() {
            if (isSelectionMode) {
                exitSelectionMode();
            } else {
                enterSelectionMode();
            }
        }

        function enterSelectionMode() {
            isSelectionMode = true;
            document.body.classList.add('selection-mode-active');
            const toolbar = document.getElementById('selectionToolbar');
            if (toolbar) toolbar.classList.remove('hidden');

            const btn = document.getElementById('btnToggleSelection');
            const icon = document.getElementById('btnSelectionIcon');
            const label = document.getElementById('btnSelectionLabel');
            if (btn) btn.className = 'h-8 px-2.5 sm:px-3 rounded-md bg-primary/10 text-primary border border-primary/40 font-semibold text-xs flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all shrink-0 cursor-pointer';
            if (icon) {
                icon.innerText = 'close';
                icon.className = 'material-symbols-rounded text-[17px] text-primary';
            }
            if (label) label.innerText = 'Exit Selection';

            updateSelectedTopicsCount();
        }

        function exitSelectionMode() {
            isSelectionMode = false;
            document.body.classList.remove('selection-mode-active');
            const toolbar = document.getElementById('selectionToolbar');
            if (toolbar) toolbar.classList.add('hidden');

            const btn = document.getElementById('btnToggleSelection');
            const icon = document.getElementById('btnSelectionIcon');
            const label = document.getElementById('btnSelectionLabel');
            if (btn) btn.className = 'h-8 px-2.5 sm:px-3 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all shrink-0 cursor-pointer';
            if (icon) {
                icon.innerText = 'checklist';
                icon.className = 'material-symbols-rounded text-[17px] text-slate-500';
            }
            if (label) label.innerText = 'Select Topics';

            deselectAllLive();
        }

        function selectAllLiveTopics() {
            document.querySelectorAll('.topic-checkbox').forEach(cb => cb.checked = true);
            document.querySelectorAll('.chapter-checkbox').forEach(cb => {
                cb.checked = true;
                cb.indeterminate = false;
            });
            updateSelectedTopicsCount();
        }

        function onChapterHeaderClick(event, chIdx) {
            if (isSelectionMode) {
                // If clicked on action buttons or the checkbox itself, don't double-trigger
                if (event.target.closest('button') || event.target.closest('input[type="checkbox"]')) {
                    return;
                }
                const chCb = document.getElementById(`chapter_cb_${chIdx}`);
                if (chCb) {
                    const newChecked = !chCb.checked;
                    chCb.checked = newChecked;
                    toggleSelectChapterTopics(chIdx, newChecked);
                }
                return;
            }
            toggleChapterAccordion('ch_' + chIdx);
        }

        function onTopicItemClick(event, topicId, chIdx) {
            if (!isSelectionMode) return;
            // Prevent toggling if clicked on action buttons or the checkbox itself
            if (event.target.closest('button') || event.target.closest('input[type="checkbox"]')) {
                return;
            }
            const cb = document.querySelector(`.topic-checkbox[data-id="${topicId}"]`);
            if (cb) {
                cb.checked = !cb.checked;
                updateSelectedTopicsCount();
            }
        }

        // Tab Switcher
        let currentTopicTab = 'active';

        function switchTopicTab(tab) {
            currentTopicTab = tab || 'active';
            const liveView = document.getElementById('liveTopicsView');
            const pendingView = document.getElementById('pendingTopicsView');
            const deletionView = document.getElementById('deletionRequestsView');
            const archiveView = document.getElementById('archivedTopicsView');
            const tabActiveBtn = document.getElementById('tabActiveBtn');
            const tabPendingBtn = document.getElementById('tabPendingBtn');
            const tabDeletionBtn = document.getElementById('tabDeletionBtn');
            const tabArchiveBtn = document.getElementById('tabArchiveBtn');
            const btnToggleSelection = document.getElementById('btnToggleSelection');
            const unifiedModalOpenBtn = document.getElementById('unifiedModalOpenBtn');
            const liveFiltersBar = document.getElementById('liveFiltersBar');

            exitSelectionMode();
            deselectAllArchive();

            // Clear search when switching tabs
            const searchInput = document.getElementById('topicSearchInput');
            if (searchInput && searchInput.value) {
                searchInput.value = '';
                filterTopicsClientSide('');
            }

            // Reset tab button styles
            const inactiveClass = 'px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white shrink-0 whitespace-nowrap';
            const activeClass = 'px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs shrink-0 whitespace-nowrap';

            if (tabActiveBtn) tabActiveBtn.className = inactiveClass;
            if (tabPendingBtn) tabPendingBtn.className = inactiveClass;
            if (tabDeletionBtn) tabDeletionBtn.className = inactiveClass;
            if (tabArchiveBtn) tabArchiveBtn.className = inactiveClass;

            if (liveView) liveView.classList.add('hidden');
            if (pendingView) pendingView.classList.add('hidden');
            if (deletionView) deletionView.classList.add('hidden');
            if (archiveView) archiveView.classList.add('hidden');

            if (tab === 'active') {
                if (liveView) liveView.classList.remove('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.remove('hidden');
                if (document.getElementById('topBarToggleAllLiveChapters')) document.getElementById('topBarToggleAllLiveChapters').classList.remove('hidden');
                if (tabActiveBtn) tabActiveBtn.className = activeClass;
                if (btnToggleSelection) btnToggleSelection.classList.remove('hidden');
                if (unifiedModalOpenBtn) unifiedModalOpenBtn.classList.remove('hidden');
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.delete('tab');
                    window.history.replaceState(null, '', u.toString());
                }
            } else if (tab === 'pending') {
                if (pendingView) pendingView.classList.remove('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.add('hidden');
                if (document.getElementById('topBarToggleAllLiveChapters')) document.getElementById('topBarToggleAllLiveChapters').classList.add('hidden');
                if (tabPendingBtn) tabPendingBtn.className = activeClass;
                if (btnToggleSelection) btnToggleSelection.classList.add('hidden');
                if (unifiedModalOpenBtn) unifiedModalOpenBtn.classList.remove('hidden');
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.set('tab', 'pending');
                    window.history.replaceState(null, '', u.toString());
                }
            } else if (tab === 'deletion') {
                if (deletionView) deletionView.classList.remove('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.add('hidden');
                if (tabDeletionBtn) tabDeletionBtn.className = activeClass;
                if (btnToggleSelection) btnToggleSelection.classList.add('hidden');
                if (unifiedModalOpenBtn) unifiedModalOpenBtn.classList.add('hidden');
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.set('tab', 'deletion');
                    window.history.replaceState(null, '', u.toString());
                }
            } else {
                if (archiveView) archiveView.classList.remove('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.add('hidden');
                if (tabArchiveBtn) tabArchiveBtn.className = activeClass;
                if (btnToggleSelection) btnToggleSelection.classList.add('hidden');
                if (unifiedModalOpenBtn) unifiedModalOpenBtn.classList.add('hidden');
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.set('tab', 'archive');
                    window.history.replaceState(null, '', u.toString());
                }
            }
        }

        // Navigation filters
        function onClassChange(newClass) {
            const u = new URL(window.location.href);
            u.searchParams.set('classLevel', newClass);
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function onGroupChange(newGroup) {
            const u = new URL(window.location.href);
            u.searchParams.set('group', newGroup);
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function onSubjectChange(newSub) {
            const u = new URL(window.location.href);
            u.searchParams.set('subject', newSub);
            u.searchParams.delete('segment');
            window.location.href = u.toString();
        }

        function onSegmentChange(newSeg) {
            const u = new URL(window.location.href);
            if (newSeg && newSeg !== 'all') {
                u.searchParams.set('segment', newSeg);
            } else {
                u.searchParams.delete('segment');
            }
            window.location.href = u.toString();
        }

        // Accordion toggle
        function toggleChapterAccordion(chId) {
            const content = document.getElementById('content_' + chId);
            const icon = document.getElementById('icon_' + chId);
            if (!content) return;
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(-90deg)';
            }
        }

        let allLiveChaptersExpanded = true;
        function toggleAllLiveChapters() {
            allLiveChaptersExpanded = !allLiveChaptersExpanded;
            const contents = document.querySelectorAll('#chaptersContainer [id^="content_ch_"]');
            const icons = document.querySelectorAll('#chaptersContainer [id^="icon_ch_"]');

            contents.forEach(c => {
                if (allLiveChaptersExpanded) c.classList.remove('hidden');
                else c.classList.add('hidden');
            });
            icons.forEach(ic => {
                ic.style.transform = allLiveChaptersExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
            });

            const topText = document.getElementById('topBarTextToggleLive');
            const topIcon = document.getElementById('topBarIconToggleLive');
            if (topText) topText.textContent = allLiveChaptersExpanded ? 'Collapse All' : 'Expand All';
            if (topIcon) topIcon.textContent = allLiveChaptersExpanded ? 'unfold_less' : 'unfold_more';

            const inText = document.getElementById('textToggleAllLiveChapters');
            const inIcon = document.getElementById('iconToggleAllLiveChapters');
            if (inText) inText.textContent = allLiveChaptersExpanded ? 'Collapse All' : 'Expand All';
            if (inIcon) inIcon.textContent = allLiveChaptersExpanded ? 'unfold_less' : 'unfold_more';
