                document.getElementById('superStagedChapterBadge').textContent = `Ch ${chapterNumber}: ${chapterName}`;
                document.getElementById('superStagedTotalBadge').textContent = `${superStagedTopics.length} Topic${superStagedTopics.length === 1 ? '' : 's'}`;

                renderSuperadminStagedTopics();
            } else {
                // Step 1
                superCurrentStep = 1;
                document.getElementById('superStep2Container').classList.add('hidden');
                document.getElementById('superStep1Container').classList.remove('hidden');

                document.getElementById('unifiedModalSubtitle').textContent = 'Step 1: Enter chapter details and topics.';
                const s1Pill = document.getElementById('superStep1Indicator');
                const s2Pill = document.getElementById('superStep2Indicator');
                const s1Badge = document.getElementById('superStep1Badge');
                const s2Badge = document.getElementById('superStep2Badge');
                const progressLine = document.getElementById('superStepProgressLine');

                if (s1Pill) {
                    s1Pill.className = 'flex items-center gap-1.5 font-semibold text-primary transition-all';
                    s1Badge.className = 'size-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold';
                    s1Badge.textContent = '1';
                }
                if (s2Pill) {
                    s2Pill.className = 'flex items-center gap-1.5 font-medium text-slate-400 transition-all';
                    s2Badge.className = 'size-5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-500 flex items-center justify-center text-[10px] font-bold';
                    s2Badge.textContent = '2';
                }
                if (progressLine) progressLine.className = 'h-0.5 flex-1 mx-3 bg-slate-200 dark:bg-slate-700 transition-colors';
            }
        }

