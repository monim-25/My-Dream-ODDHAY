                if (s2Pill) {
                    s2Pill.className = 'flex items-center gap-1.5 font-semibold text-primary transition-all';
                    s2Badge.className = 'size-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold';
