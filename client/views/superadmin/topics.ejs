                document.getElementById('unifiedModalSubtitle').textContent = 'Step 2: Review topics and click Expand to add sub-topics.';
                const s1Pill = document.getElementById('superStep1Indicator');
                const s2Pill = document.getElementById('superStep2Indicator');
                const s1Badge = document.getElementById('superStep1Badge');
                const s2Badge = document.getElementById('superStep2Badge');
