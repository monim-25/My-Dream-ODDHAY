<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title><%= bank.board %> <%= bank.year %> | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-h-screen; display: flex; flex-direction: column; background: #F8FAFC; position: relative; }
        .content-scroll { flex: 1; padding: 0; overflow-y: auto; }
        
        .cockpit-unit { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.375rem; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        
        .stat-pill { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 0.375rem; padding: 0.75rem; transition: all 0.2s ease; }
        .stat-pill:hover { background: #ffffff; border-color: #3b82f6; transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }

        .q-table th { background: #f8fafc; color: #64748b; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1rem; border-bottom: 1px solid #f1f5f9; text-align: left; }
        .q-table td { padding: 0.75rem 1rem; font-size: 12px; font-weight: 600; color: #1e293b; border-bottom: 1px solid #f8fafc; }
        .q-table tr:hover td { background: #f8fafc; }

        .pill { padding: 0.25rem 0.6rem; rounded-full: 9999px; font-size: 10px; font-weight: 800; text-transform: uppercase; display: inline-flex; align-items: center; gap: 4px; }
        .pill-blue { background: #eff6ff; color: #2563eb; }
        .pill-emerald { background: #ecfdf5; color: #059669; }
        .pill-amber { background: #fffbeb; color: #d97706; }
        .pill-rose { background: #fff1f2; color: #e11d48; }

        @media (max-width: 1024px) { .admin-main { margin-left: 0; } }
    </style>
</head>

<body class="bg-[#F8FAFC] text-slate-800 font-sans min-h-screen">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'questions' }) %>
        </aside>

        <main class="admin-main flex-1">
            <%- include('header_v2', { pageTitle: 'Bank Intelligence' }) %>

            <div class="content-scroll flex flex-col gap-0 border-l border-slate-200 dark:border-white/5">
                <!-- Top Summary Container -->
                <div class="bg-white rounded-md p-4 border border-slate-200 shadow-sm flex flex-col gap-4">
                    <div class="flex justify-between items-start">
                        <div>
                            <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight"><%= bank.board %> - <%= bank.year %></h1>
                            <div class="flex items-center gap-5 mt-3">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">book</span>
                                    <p class="text-[13px] font-bold text-slate-700"><%= bank.subject %></p>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">school</span>
                                    <p class="text-[13px] font-bold text-slate-600">Class <%= bank.classLevel.replace('Class', '').trim() %></p>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">sell</span>
                                    <p class="text-[13px] font-bold text-slate-600"><%= bank.accessType %> Tier</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="text-right mr-2">
                                <h2 class="text-[11px] font-black text-slate-700 dark:text-slate-200 leading-tight"><%= bank.addedBy ? bank.addedBy.name : 'System' %></h2>
                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Contributor</p>
                            </div>
                            <div class="size-9 rounded-full bg-slate-100 dark:bg-slate-800 border-2 border-white dark:border-slate-700 shadow-sm overflow-hidden">
                                <img src="<%= bank.addedBy && bank.addedBy.profileImage ? bank.addedBy.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                            </div>
                        </div>
                    </div>

                    <!-- Intelligence Ring Hub -->
                    <div class="border-t border-slate-50 mt-4 pt-6 pb-2">
                        <div class="flex items-center gap-6 px-2">
                            <!-- Donut Chart (Left) -->
                            <div class="relative size-32 flex-shrink-0">
                                <% 
                                    const t = stats.total || 1;
                                    const pM = (stats.MCQ / t) * 100;
                                    const pS = (stats.Short / t) * 100;
                                    const pMed = (stats.Medium / t) * 100;
                                    const pC = (stats.Comprehension / t) * 100;
                                %>
                                <svg viewBox="0 0 42 42" class="size-full -rotate-90">
                                    <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f1f5f9" stroke-width="4.5"></circle>
                                    <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="4.5" stroke-dasharray="<%= pM %> <%= 100 - pM %>" stroke-dashoffset="0" class="transition-all duration-1000"></circle>
                                    <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="4.5" stroke-dasharray="<%= pS %> <%= 100 - pS %>" stroke-dashoffset="<%= -pM %>" class="transition-all duration-1000"></circle>
                                    <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f59e0b" stroke-width="4.5" stroke-dasharray="<%= pMed %> <%= 100 - pMed %>" stroke-dashoffset="<%= -(pM + pS) %>" class="transition-all duration-1000"></circle>
                                    <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f43f5e" stroke-width="4.5" stroke-dasharray="<%= pC %> <%= 100 - pC %>" stroke-dashoffset="<%= -(pM + pS + pMed) %>" class="transition-all duration-1000"></circle>
                                </svg>
                                <div class="absolute inset-0 flex flex-col items-center justify-center">
                                    <span class="text-2xl font-black text-slate-700 leading-none"><%= stats.total %></span>
                                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter mt-0.5">Total</span>
                                </div>
                            </div>

                            <!-- Legend (Middle) -->
                            <div class="flex-1 grid grid-cols-1 gap-y-2 ml-2">
                                <div class="flex items-center gap-3">
                                    <div class="size-1.5 rounded-full bg-blue-500"></div>
                                    <div class="flex items-baseline gap-1.5">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide">MCQ:</p>
                                        <h3 class="text-base font-black text-slate-700 leading-none"><%= stats.MCQ %> <span class="text-[10px] font-bold text-slate-400">Items</span></h3>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                                    <div class="flex items-baseline gap-1.5">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide">Short Ques:</p>
                                        <h3 class="text-base font-black text-slate-700 leading-none"><%= stats.Short %> <span class="text-[10px] font-bold text-slate-400">Items</span></h3>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-1.5 rounded-full bg-amber-500"></div>
                                    <div class="flex items-baseline gap-1.5">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide">Medium Ques:</p>
                                        <h3 class="text-base font-black text-slate-700 leading-none"><%= stats.Medium %> <span class="text-[10px] font-bold text-slate-400">Items</span></h3>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-1.5 rounded-full bg-rose-500"></div>
                                    <div class="flex items-baseline gap-1.5">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide">Comprehension:</p>
                                        <h3 class="text-base font-black text-slate-700 leading-none"><%= stats.Comprehension %> <span class="text-[10px] font-bold text-slate-400">Items</span></h3>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Engagement (Right) -->
                            <div class="w-96 border-l border-slate-50 pl-6 flex flex-col gap-4">
                                <div class="flex flex-col gap-2">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide leading-none">Active Exam Takers</p>
                                        <p class="text-[11px] font-black text-indigo-500 leading-none"><%= engagement.activeTakers %></p>
                                    </div>
                                    <div class="h-3 w-full bg-slate-100 rounded-sm overflow-hidden shadow-inner">
                                        <div class="h-full bg-indigo-500 transition-all duration-1000" style="width: <%= (engagement.activeTakers / engagement.maxTakers) * 100 %>%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide leading-none">Avg. Study Duration</p>
                                        <p class="text-[11px] font-black text-cyan-500 leading-none"><%= engagement.studyDuration %>m</p>
                                    </div>
                                    <div class="h-3 w-full bg-slate-100 rounded-sm overflow-hidden shadow-inner">
                                        <div class="h-full bg-cyan-500 transition-all duration-1000" style="width: <%= (engagement.studyDuration / engagement.maxDuration) * 100 %>%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-bold text-slate-400 tracking-wide leading-none">Popularity Score</p>
                                        <p class="text-[11px] font-black text-rose-500 leading-none"><%= engagement.popularityScore %>%</p>
                                    </div>
                                    <div class="h-3 w-full bg-slate-100 rounded-sm overflow-hidden shadow-inner">
                                        <div class="h-full bg-rose-500 transition-all duration-1000" style="width: <%= engagement.popularityScore %>%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Material Action Bar -->
                    <div class="bg-slate-50/50 dark:bg-slate-900/50 border-t border-slate-100 dark:border-slate-800 px-4 py-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="size-8 rounded bg-orange-50 dark:bg-orange-500/10 border border-orange-100 dark:border-orange-500/20 flex items-center justify-center text-orange-500">
                                <span class="material-symbols-rounded text-base">picture_as_pdf</span>
                            </div>
                            <div>
                                <p class="text-[11px] font-black text-slate-700 dark:text-slate-200 leading-none">Primary Material Asset</p>
                                <p class="text-[9px] font-bold text-slate-400 mt-1 uppercase tracking-wider">PDF Document</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="<%= bank.fileUrl %>" download class="h-9 px-4 rounded-md bg-primary text-white text-[11px] font-bold flex items-center gap-2 hover:bg-blue-600 transition-all shadow-lg shadow-primary/20">
                                <span class="material-symbols-rounded text-base leading-none">download</span>
                                <span class="leading-none">Download Material</span>
                            </a>
                            <a href="<%= bank.fileUrl %>" target="_blank" class="h-9 px-4 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[11px] font-bold flex items-center gap-2 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
                                <span class="material-symbols-rounded text-base leading-none">open_in_new</span>
                                <span class="leading-none">Open Viewer</span>
                            </a>
                        </div>
                    </div>

                <!-- Filters & List -->
                <div class="bg-white rounded-md border border-slate-200 shadow-sm overflow-hidden mb-10">
                    <div class="px-5 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50/30">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-[20px]">inventory_2</span>
                            <h3 class="text-base font-black text-slate-600 tracking-tight">Question Archive (<%= stats.total %>)</h3>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[12px] font-bold text-slate-500 whitespace-nowrap">Filter:</span>
                            <select onchange="filterQuestions(this.value)" class="h-9 px-4 rounded-md border border-slate-200 text-[11px] font-bold text-slate-700 outline-none bg-white focus:border-blue-500">
                                <option value="all">All Types</option>
                                <option value="MCQ">MCQ</option>
                                <option value="Short">Short</option>
                                <option value="Medium">Medium</option>
                                <option value="Comprehension">Comprehension</option>
                            </select>
                            <button type="button" onclick="toggleAllAnswers(this)" class="h-9 px-3 rounded-md border border-slate-200 bg-white text-slate-600 text-[11px] font-bold flex items-center gap-2 hover:bg-slate-50 transition-all">
                                <span class="material-symbols-rounded text-sm">visibility</span>
                                <span>Show All Answers</span>
                            </button>
                        </div>
                    </div>

                    <div class="p-2 space-y-1">
                        <% questions.forEach((q, i) => { %>
                            <div class="q-item p-4 rounded-md border border-slate-100 hover:border-blue-100 transition-all bg-white" data-type="<%= q.questionType %>">
                                <div class="flex justify-between items-start gap-4">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-3">
                                            <span class="text-[13px] font-black text-slate-400"><%= i + 1 %></span>
                                            <span class="px-2 py-0.5 rounded-md bg-blue-50 text-[10px] font-bold text-blue-600 border border-blue-100/50"><%= q.questionType %></span>
                                        </div>
                                        <div class="text-[15px] font-bold text-slate-600 leading-relaxed mb-5">
                                            <%- q.questionText || q.title || 'Untitled Question' %>
                                        
                                        <!-- Answer Section (Hidden by default) -->
                                        <div id="ans-<%= i %>" class="hidden mt-4 pt-4 border-t border-slate-50">
                                            <% if (q.questionType === 'MCQ') { %>
                                                <div class="grid grid-cols-2 gap-3 mb-4">
                                                    <% (q.options || []).forEach((opt, idx) => { %>
                                                        <div class="p-2.5 rounded-md border <%= q.correctAnswerIndex === idx ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-slate-50 border-slate-100 text-slate-500' %> text-[12px] font-bold">
                                                            <span class="mr-2"><%= String.fromCharCode(65 + idx) %>.</span>
                                                            <%= opt %>
                                                        </div>
                                                    <% }) %>
                                                </div>

                                                <% if (q.explanation) { %>
                                                    <div class="mt-4 p-3 rounded-md bg-blue-50/50 border-l-4 border-blue-200">
                                                        <p class="text-[10px] font-bold text-blue-400 italic mb-1">Explanation</p>
                                                        <p class="text-[13px] font-medium text-slate-600 leading-relaxed italic"><%= q.explanation %></p>
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                    <p class="text-[10px] font-bold text-emerald-600 mb-2">Answer</p>
                                                    <div class="text-[13px] font-semibold text-slate-700 bg-slate-50 p-3 rounded-md border border-slate-100">
                                                        <%- q.correctAnswer || q.answer || 'Answer not provided.' %>
                                                    </div>
                                                    <% const expOther = String(q.explanation || q.explanationText || q.solution || '').trim(); %>
                                                    <% if (expOther !== '') { %>
                                                        <div class="mt-3 p-3 rounded-md bg-amber-50 border-l-4 border-amber-300 flex gap-3 items-start">
                                                            <span class="material-symbols-rounded text-amber-500 text-lg mt-0.5">lightbulb</span>
                                                            <div>
                                                                <p class="text-[10px] font-bold text-amber-600 mb-0.5">Explanation</p>
                                                                <p class="text-[12px] font-medium text-slate-600 leading-relaxed"><%= expOther %></p>
                                                            </div>
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <button onclick="toggleAnswer('<%= i %>')" class="flex-shrink-0 flex items-center gap-2 px-3 py-1.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-black transition-all">
                                        <span class="material-symbols-rounded text-sm">visibility</span>
                                        <span class="text-[10px] font-bold">Show Answer</span>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/50">
                        <p class="text-[10px] font-bold text-slate-400 tracking-wide">Showing all <%= stats.total %> questions</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleAnswer(id) {
            const ans = document.getElementById(`ans-${id}`);
            const btn = event.currentTarget;
            if (ans.classList.contains('hidden')) {
                ans.classList.remove('hidden');
                btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility_off</span><span class="text-[10px] font-bold">Hide Answer</span>';
                btn.classList.add('border-blue-500', 'text-blue-600');
            } else {
                ans.classList.add('hidden');
                btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility</span><span class="text-[10px] font-bold">Show Answer</span>';
                btn.classList.remove('border-blue-500', 'text-blue-600');
            }
        }

        let allAnswersVisible = false;
        function toggleAllAnswers(btn) {
            allAnswersVisible = !allAnswersVisible;
            document.querySelectorAll('[id^="ans-"]').forEach(ans => {
                if (allAnswersVisible) {
                    ans.classList.remove('hidden');
                } else {
                    ans.classList.add('hidden');
                }
            });
            document.querySelectorAll('.q-item button[onclick^="toggleAnswer"]').forEach(b => {
                b.innerHTML = allAnswersVisible
                    ? '<span class="material-symbols-rounded text-sm">visibility_off</span><span class="text-[10px] font-bold">Hide Answer</span>'
                    : '<span class="material-symbols-rounded text-sm">visibility</span><span class="text-[10px] font-bold">Show Answer</span>';
                if (allAnswersVisible) b.classList.add('border-blue-500', 'text-blue-600');
                else b.classList.remove('border-blue-500', 'text-blue-600');
            });
            if (btn) {
                const icon = btn.querySelector('.material-symbols-rounded');
                const label = btn.querySelector('span:last-child');
                if (icon) icon.textContent = allAnswersVisible ? 'visibility_off' : 'visibility';
                if (label) label.textContent = allAnswersVisible ? 'Hide All Answers' : 'Show All Answers';
            }
        }

        function filterQuestions(type) {
            const items = document.querySelectorAll('.q-item');
            items.forEach(item => {
                if (type === 'all' || item.getAttribute('data-type') === type) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>
