<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Support Hub | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        .stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.5rem; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
        .dark .stat-card { background: #1e293b; border: 1px solid #334155; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }
        <% 
            function formatText(str) {
                if (!str) return '';
                if (Array.isArray(str)) str = str[0] || '';
                if (typeof str !== 'string') str = String(str);
                return str.trim().split(/\s+/).map(word => {
                    if (word.length === 0) return '';
                    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
                }).join(' ');
            }
        %>
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'qas' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Student Support Center' }) %>

            <% 
                const oneWeekAgo = new Date();
                oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
                const weeklyQas = allQas.filter(q => new Date(q.createdAt) >= oneWeekAgo);
                const weeklySolved = weeklyQas.filter(q => q.status === 'resolved').length;
                const weeklyUnsolved = weeklyQas.filter(q => q.status === 'open').length;
                const solutionRate = weeklyQas.length > 0 ? Math.round((weeklySolved / weeklyQas.length) * 100) : 0;
                
                const lifetimeTotal = allQas.length;
                const lifetimeSolved = allQas.filter(q => q.status === 'resolved').length;
                const lifetimeUnsolved = allQas.filter(q => q.status === 'open').length;
            %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                <!-- Support Stats & Lifetime Overview -->
                <!-- Support Stats & Lifetime Overview -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-1 lg:grid-cols-5 gap-1">
                        <!-- Total Questions (1 Week) -->
                        <div class="bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/20 dark:border-blue-500/20 rounded-md p-3 flex flex-col group h-[85px] relative overflow-hidden transition-all hover:bg-blue-100/40 dark:hover:bg-blue-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">forum</span>
                            <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400 tracking-wider relative z-10">Total Questions</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= weeklyQas.length %></h3>
                            </div>
                            <p class="text-[10px] text-blue-500/70 font-medium relative z-10">Last 7 Days &rarr;</p>
                        </div>

                        <!-- Unsolved (1 Week) -->
                        <div class="bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-md p-3 flex flex-col group h-[85px] relative overflow-hidden transition-all hover:bg-amber-100/40 dark:hover:bg-amber-500/20 cursor-pointer">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">hourglass_empty</span>
                            <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400 tracking-wider relative z-10">Unsolved</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= weeklyUnsolved %></h3>
                            </div>
                            <p class="text-[10px] text-amber-500/70 font-medium relative z-10">Waiting Response &rarr;</p>
                        </div>

                        <!-- Solved (1 Week) -->
                        <div class="bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/20 dark:border-emerald-500/20 rounded-md p-3 flex flex-col group h-[85px] relative overflow-hidden transition-all hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">check_circle</span>
                            <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 tracking-wider relative z-10">Solved</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= weeklySolved %></h3>
                            </div>
                            <p class="text-[10px] text-emerald-500/70 font-medium relative z-10">Solutions Sent &rarr;</p>
                        </div>

                        <!-- Solution Rate (1 Week) -->
                        <div class="bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/20 dark:border-violet-500/20 rounded-md p-3 flex flex-col group h-[85px] relative overflow-hidden transition-all hover:bg-violet-100/40 dark:hover:bg-violet-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-purple-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">speed</span>
                            <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400 tracking-wider relative z-10">Solution Rate</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= solutionRate %>%</h3>
                            </div>
                            <p class="text-[10px] text-purple-500/70 font-medium relative z-10">Efficiency &rarr;</p>
                        </div>

                        <div class="bg-slate-50/40 dark:bg-slate-500/10 border border-slate-200 dark:border-slate-500/20 rounded-md p-2 flex flex-col h-[85px] relative overflow-hidden">
                            <p class="text-[10px] font-bold text-slate-500 mb-1">Lifetime Overview</p>
                            <div class="grid grid-cols-3 gap-1 flex-1">
                                <div class="flex flex-col items-center justify-center bg-white dark:bg-slate-900/50 rounded-md border border-slate-100 dark:border-slate-800">
                                    <span class="text-sm font-black text-slate-900 dark:text-white"><%= lifetimeTotal %></span>
                                    <span class="text-[8px] font-bold text-slate-400 uppercase tracking-tighter">Total</span>
                                </div>
                                <div class="flex flex-col items-center justify-center bg-emerald-50/50 dark:bg-emerald-500/10 rounded-md border border-emerald-100/50 dark:border-emerald-500/20">
                                    <span class="text-sm font-black text-emerald-600 dark:text-emerald-400"><%= lifetimeSolved %></span>
                                    <span class="text-[8px] font-bold text-emerald-500/70 uppercase tracking-tighter">Solved</span>
                                </div>
                                <div class="flex flex-col items-center justify-center bg-amber-50/50 dark:bg-amber-500/10 rounded-md border border-amber-100/50 dark:border-amber-500/20">
                                    <span class="text-sm font-black text-amber-600 dark:text-amber-400"><%= lifetimeUnsolved %></span>
                                    <span class="text-[8px] font-bold text-amber-500/70 uppercase tracking-tighter">Open</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (typeof filterTeacher !== 'undefined' && filterTeacher) { %>
                <!-- Teacher Filter Banner -->
                <div class="mb-3 px-4 py-2.5 bg-primary/5 border border-primary/20 rounded-md flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary text-base">person</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500">Filtering Answers by Faculty</p>
                            <p class="text-xs font-black text-slate-900 dark:text-white"><%= filterTeacher.name %></p>
                        </div>
                        <% if (filterTeacher.teachingSubject) { %>
                            <span class="px-2 py-0.5 rounded-md bg-fuchsia-50 dark:bg-fuchsia-500/10 border border-fuchsia-200 dark:border-fuchsia-500/20 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-semibold"><%= filterTeacher.teachingSubject %></span>
                        <% } %>
                    </div>
                    <a href="/superadmin/qas" class="h-7 px-3 text-[10px] font-bold rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:text-primary transition-all flex items-center gap-1">
                        <span class="material-symbols-rounded text-[13px]">close</span> Clear Filter
                    </a>
                </div>
                <% } %>

                <!-- Ticket Hub -->
                <div class="bg-white dark:bg-slate-800/50 rounded-md border border-slate-200 dark:border-slate-700/50 flex flex-col relative mb-10">
                    <!-- Filters (Sticky at top of page scroll) -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3 rounded-t-md">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <div class="relative flex-1 max-w-sm">
                                <input type="text" id="qaSearch" onkeyup="if(event.key === 'Enter') handleSearch()" placeholder="Search questions or students..." value="<%= filters.q || '' %>"
                                    class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
                                    <span class="material-symbols-rounded text-[20px]">search</span>
                                </div>
                            </div>
                            <!-- Segmented Status Filter (Easy Access) -->
                            <div class="flex items-center bg-slate-100 dark:bg-slate-900/80 p-0.5 rounded-md border border-slate-200 dark:border-slate-700">
                                <button onclick="window.location.href='?status=all&q=<%= filters.q || '' %><% if(filters.answeredBy) { %>&answeredBy=<%= filters.answeredBy %><% } %>'" 
                                    class="px-3 h-7 rounded-md text-[10px] font-bold transition-all flex items-center gap-1.5 <%= filters.status === 'all' ? 'bg-white dark:bg-slate-800 text-primary shadow-sm border border-slate-200 dark:border-slate-700' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-300' %>">
                                    All
                                </button>
                                <button onclick="window.location.href='?status=open&q=<%= filters.q || '' %><% if(filters.answeredBy) { %>&answeredBy=<%= filters.answeredBy %><% } %>'" 
                                    class="px-3 h-7 rounded-md text-[10px] font-bold transition-all flex items-center gap-1.5 <%= filters.status === 'open' ? 'bg-white dark:bg-slate-800 text-amber-600 shadow-sm border border-slate-200 dark:border-slate-700' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-300' %>">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    Unsolved
                                </button>
                                <button onclick="window.location.href='?status=resolved&q=<%= filters.q || '' %><% if(filters.answeredBy) { %>&answeredBy=<%= filters.answeredBy %><% } %>'" 
                                    class="px-3 h-7 rounded-md text-[10px] font-bold transition-all flex items-center gap-1.5 <%= filters.status === 'resolved' ? 'bg-white dark:bg-slate-800 text-emerald-600 shadow-sm border border-slate-200 dark:border-slate-700' : 'text-slate-500 hover:text-slate-700 dark:hover:text-slate-300' %>">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    Solved
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportQAsToCSV()" class="h-8 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                        </div>
                    </div>
                    
                    <div class="table-wrapper">



                    <div class="table-wrapper">
                        <table class="w-full text-left">
                        <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                            <tr>
                                <th class="pl-4 pr-1 text-center w-10">
                                    <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity">
                                </th>
                                <th class="pl-1 pr-4 py-2 text-left text-[10px] font-bold text-slate-500 tracking-wider">Student Profile</th>
                                <th class="px-4 py-2 text-left text-[10px] font-bold text-slate-500 tracking-wider">Question</th>
                                <th class="px-4 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Timestamp</th>
                                <th class="px-4 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">Status</th>
                                <th class="px-4 py-2 text-right text-[10px] font-bold text-slate-500 tracking-wider">Actions</th>
                            </tr>
                        </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% qas.forEach(item => { %>
                                    <tr class="qa-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" 
                                        data-status="<%= item.status %>"
                                        data-student="<%= item.askedBy ? item.askedBy.name.toLowerCase() : 'anonymous' %>"
                                        onclick="showReplyArea('<%= item._id %>')"
                                        ondblclick="toggleRowSelection('<%= item._id %>')">
                                        <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= item._id %>" id="cb-<%= item._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-4 py-2">
                                            <div class="flex items-center gap-2">
                                                <div class="size-8 rounded-md overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-xs text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 shadow-sm">
                                                    <% if (item.askedBy && item.askedBy.profilePicture) { %>
                                                        <img src="<%= item.askedBy.profilePicture %>" class="size-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=<%= item.askedBy.name %>';">
                                                    <% } else { %>
                                                        <%= item.askedBy ? item.askedBy.name[0].toUpperCase() : 'S' %>
                                                    <% } %>
                                                </div>
                                                <div class="flex flex-col">
                                                    <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">
                                                        <%= item.askedBy ? formatText(item.askedBy.name) : 'Anonymous student' %>
                                                    </p>
                                                    <p class="text-[9px] text-slate-400 font-medium lowercase">
                                                        <%= item.askedBy ? item.askedBy.email || 'UID: ' + item.askedBy._id.toString().slice(-6).toUpperCase() : 'N/A' %>
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2 max-w-xs">
                                            <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 line-clamp-1 truncate"><%= formatText(item.question) %></p>
                                            <p class="text-[9px] font-medium text-slate-400">Click to view details</p>
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <div class="flex flex-col">
                                                <span class="text-[10px] font-bold text-slate-600 dark:text-slate-300"><%= item.createdAt.toLocaleDateString('en-GB') %></span>
                                                <span class="text-[9px] text-slate-400 font-medium tracking-tight"><%= item.createdAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <span class="px-2 py-0.5 rounded-md text-[9px] font-bold border <%= item.status === 'open' ? 'bg-amber-50 text-amber-600 border-amber-100 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20' : 'bg-emerald-50 text-emerald-600 border-emerald-100 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20' %>">
                                                <%= item.status === 'open' ? 'Unsolved' : 'Solved' %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-2 text-right" onclick="event.stopPropagation()">
                                            <div class="flex items-center justify-end gap-1">
                                                <button onclick="deleteQA('<%= item._id %>')" class="size-7 rounded-md bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm">
                                                    <span class="material-symbols-rounded text-[16px]">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <!-- Dynamic Reply Section -->
                                    <tr id="reply-<%= item._id %>" class="hidden bg-slate-50/50 dark:bg-slate-900/50">
                                        <td colspan="6" class="p-6">
                                            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm animate-fade-in">
                                                <div class="flex flex-col md:flex-row gap-8">
                                                    <div class="flex-1">
                                                        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 tracking-widest mb-3 block">Question</span>
                                                        <div class="text-[13px] font-bold text-slate-800 dark:text-slate-100 bg-slate-50 dark:bg-slate-900/50 p-4 rounded-xl border border-slate-100 dark:border-slate-800 relative">
                                                            <span class="text-primary opacity-20 absolute top-2 left-2 text-2xl font-serif">"</span>
                                                            <p class="px-4"><%= formatText(item.question) %></p>
                                                            <span class="text-primary opacity-20 absolute bottom-2 right-2 text-2xl font-serif">"</span>
                                                        </div>
                                                    </div>

                                                    <!-- Answer Column (Right) -->
                                                    <div class="flex-1">
                                                        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 tracking-widest mb-3 block">Answer</span>
                                                        <% if(item.status === 'open' && (user.role === 'admin' || user.role === 'teacher')) { %>
                                                            <form action="/superadmin/qa-answer/<%= item._id %>" method="POST" class="space-y-4">
                                                                <textarea name="answer" required placeholder="Provide a detailed and sharp solution..." class="w-full h-32 p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-[13px] font-bold focus:border-primary outline-none transition-all"></textarea>
                                                                <div class="flex justify-end">
                                                                    <button type="submit" class="h-9 px-6 bg-primary text-white rounded-lg font-bold text-[10px] uppercase tracking-widest shadow-lg shadow-primary/20 hover:bg-blue-600 transition-all">Submit Answer</button>
                                                                </div>
                                                            </form>
                                                        <% } else { %>
                                                            <div class="space-y-4">
                                                                <div class="text-[13px] font-bold text-slate-700 dark:text-slate-300 bg-emerald-50/30 dark:bg-emerald-500/5 p-4 rounded-xl border border-emerald-100/50 dark:border-emerald-500/10 relative">
                                                                    <span class="text-emerald-500 opacity-20 absolute top-2 left-2 text-2xl font-serif">"</span>
                                                                    <p class="px-4"><%= item.answer ? formatText(item.answer) : 'Pending evaluation by faculty member.' %></p>
                                                                    <span class="text-emerald-500 opacity-20 absolute bottom-2 right-2 text-2xl font-serif">"</span>
                                                                </div>
                                                                
                                                                <% if(item.answeredBy) { %>
                                                                    <div class="flex items-center gap-3 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                                                                        <img src="<%= item.answeredBy.profilePicture || 'https://ui-avatars.com/api/?name=' + item.answeredBy.name %>" class="size-9 rounded-md border border-white dark:border-slate-700 shadow-sm object-cover" />
                                                                        <div class="flex flex-col">
                                                                            <span class="text-[11px] font-bold text-slate-900 dark:text-white"><%= formatText(item.answeredBy.name) %></span>
                                                                            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Expert Faculty</p>
                                                                        </div>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    
                    </div> <!-- End table-wrapper -->

                    <!-- Pagination -->
                    <% if(totalPages > 1) { %>
                        <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <p class="text-[9px] font-bold text-slate-500">Page <%= currentPage %> of <%= totalPages %></p>
                            <div class="flex items-center gap-0.5">
                                <% for(var i=1; i<=totalPages; i++) { %>
                                    <a href="?page=<%= i %>&status=<%= filters.status %>&q=<%= encodeURIComponent(filters.q || '') %><% if(filters.answeredBy) { %>&answeredBy=<%= filters.answeredBy %><% } %>"
                                        class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold <% if(currentPage === i) { %> bg-primary text-white <% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 <% } %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Bulk Action Bar (Light Glassmorphic) -->
                    <div id="bulkActions" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-between z-50 animate-slide-up border border-slate-200 dark:border-slate-700 mx-4 rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                                </div>
                                <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <div class="flex items-center gap-3">
                                <button onclick="selectAllRows(true)" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select All</button>
                                <button onclick="selectByStatus('resolved')" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-emerald-500 transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select Solved</button>
                                <button onclick="selectByStatus('open')" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-amber-500 transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select Unsolved</button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="handleBulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-lg text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20">Delete</button>
                            <button onclick="clearSelection()" class="h-8 px-4 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();
        let lastOpenId = null;

        function handleSearch() {
            const q = document.getElementById('qaSearch').value;
            const status = '<%= filters.status || 'all' %>';
            let url = `?q=${encodeURIComponent(q)}&status=${status}`;
            <% if (filters.answeredBy) { %> url += `&answeredBy=<%= filters.answeredBy %>`; <% } %>
            window.location.href = url;
        }

        function toggleRowSelection(id) {
            const cb = document.getElementById(`cb-${id}`);
            cb.checked = !cb.checked;
            toggleSelection(cb);
        }

        function showReplyArea(id) {
            const area = document.getElementById(`reply-${id}`);
            if(lastOpenId && lastOpenId !== id) {
                document.getElementById(`reply-${lastOpenId}`).classList.add('hidden');
            }
            area.classList.toggle('hidden');
            lastOpenId = area.classList.contains('hidden') ? null : id;
        }

        function selectAllRows(force) {
            const cbs = document.querySelectorAll('.item-cb');
            cbs.forEach(cb => {
                cb.checked = force;
                if(force) selectedItems.add(cb.value);
                else selectedItems.delete(cb.value);
            });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }

        function selectByStatus(status) {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(cb => {
                const row = cb.closest('tr');
                if(row && row.getAttribute('data-status') === status) {
                    cb.checked = true;
                    selectedItems.add(cb.value);
                } else {
                    cb.checked = false;
                }
            });
            updateBulkUI();
        }

        function toggleSelectAll() {
            const isChecked = document.getElementById('selectAll').checked;
            selectAllRows(isChecked);
        }

        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value);
            else selectedItems.delete(el.value);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = document.querySelectorAll('.item-cb').length === selectedItems.size;
            updateBulkUI();
        }

        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) {
                bar.classList.remove('hidden');
                countEl.innerText = selectedItems.size;
            } else { bar.classList.add('hidden'); }
        }

        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkUI();
        }

        function filterQAs() {
            const q = document.getElementById('qaSearch').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;
            document.querySelectorAll('.qa-row').forEach(row => {
                const s = row.getAttribute('data-status');
                const student = row.getAttribute('data-student');
                const text = row.querySelector('.max-w-xs p').innerText.toLowerCase();
                const matchSearch = student.includes(q) || text.includes(q);
                const matchStatus = status === 'all' || s === status;
                row.style.display = (matchSearch && matchStatus) ? '' : 'none';
                if(row.style.display === 'none' && lastOpenId === row.getAttribute('onclick')?.split("'")[1]) {
                    document.getElementById(`reply-${lastOpenId}`).classList.add('hidden');
                    lastOpenId = null;
                }
            });
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({
                title: 'Bulk Action',
                text: `Are you sure you want to ${action} ${selectedItems.size} tickets?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec'
            });
            if (!res.isConfirmed) return;
            
            try {
                const response = await fetch('/superadmin/qas/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        function deleteQA(id) {
            Swal.fire({
                title: 'Delete Question?',
                text: 'This ticket will be removed from the system forever.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, delete it'
            }).then((result) => {
                if (result.isConfirmed) window.location.href = `/superadmin/qa/${id}/delete`;
            });
        }

        function exportQAsToCSV() {
            const rows = [['Student', 'Question', 'Status', 'Date']];
            document.querySelectorAll('.qa-row').forEach(row => {
                if (row.style.display !== 'none') {
                    rows.push([
                        row.querySelector('p.text-slate-900').innerText,
                        row.querySelector('.max-w-xs p').innerText.replace(/,/g, ''),
                        row.getAttribute('data-status'),
                        row.querySelector('td:nth-child(4) span').innerText
                    ]);
                }
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "odhay_support.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>