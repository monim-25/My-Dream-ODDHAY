<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>AI Knowledge Hub | SuperAdmin ODDHAY</title>
    <!-- Marked.js & KaTeX for live formula previews -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>

    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .form-label { display: block; font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 5px; }
        .dark .form-label { color: #94a3b8; }
        .form-input { height: 42px; width: 100%; padding: 0 14px; border-radius: 8px; background: #f8fafc; border: 1px solid #e2e8f0; font-size: 13px; font-weight: 600; color: #1e293b; outline: none; transition: border-color 0.2s; }
        .dark .form-input { background: #0f172a; border-color: rgba(255,255,255,0.08); color: #e2e8f0; }
        .form-input:focus { border-color: #6366f1; }
        .form-input::placeholder { font-size: 11px; font-weight: 500; color: #94a3b8; }
        
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'ai-knowledge' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'AI Knowledge Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <!-- Stats Overview Bar -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-3 sm:p-4">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="bg-indigo-50/50 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/30 rounded-xl p-3 flex items-center justify-between">
                            <div>
                                <p class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Total Rules & Notes</p>
                                <h3 class="text-2xl font-black text-slate-900 dark:text-white mt-0.5"><%= stats.total %></h3>
                            </div>
                            <div class="size-10 rounded-xl bg-indigo-600/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                <span class="material-symbols-rounded text-xl leading-none">smart_toy</span>
                            </div>
                        </div>

                        <div class="bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/30 rounded-xl p-3 flex items-center justify-between">
                            <div>
                                <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Active In Production</p>
                                <h3 class="text-2xl font-black text-slate-900 dark:text-white mt-0.5"><%= stats.active %></h3>
                            </div>
                            <div class="size-10 rounded-xl bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                <span class="material-symbols-rounded text-xl leading-none">verified</span>
                            </div>
                        </div>

                        <div class="bg-purple-50/50 dark:bg-purple-950/20 border border-purple-100 dark:border-purple-900/30 rounded-xl p-3 flex items-center justify-between">
                            <div>
                                <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider">Subjects Covered</p>
                                <h3 class="text-2xl font-black text-slate-900 dark:text-white mt-0.5"><%= stats.subjects %></h3>
                            </div>
                            <div class="size-10 rounded-xl bg-purple-600/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                <span class="material-symbols-rounded text-xl leading-none">menu_book</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action & Filter Bar -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
                    <form method="GET" action="/superadmin/ai-knowledge" class="flex flex-wrap items-center gap-2 flex-1">
                        <!-- Search Box -->
                        <div class="relative min-w-[200px] flex-1 max-w-sm">
                            <input type="text" name="search" value="<%= searchQuery %>" placeholder="Search keywords, formulas, topics..." class="form-input !h-9 !text-xs !pl-8">
                            <span class="material-symbols-rounded text-slate-400 text-sm absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                        </div>

                        <!-- Class Level Filter -->
                        <select name="classLevel" onchange="this.form.submit()" class="h-9 px-3 rounded-lg text-xs font-bold bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 focus:ring-1 focus:ring-indigo-500 cursor-pointer">
                            <option value="all">All Classes</option>
                            <% classList.forEach(cls => { %>
                                <option value="<%= cls %>" <%= selectedClass === cls ? 'selected' : '' %>><%= cls %></option>
                            <% }) %>
                        </select>

                        <!-- Subject Filter -->
                        <select name="subject" onchange="this.form.submit()" class="h-9 px-3 rounded-lg text-xs font-bold bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 focus:ring-1 focus:ring-indigo-500 cursor-pointer">
                            <option value="all">All Subjects</option>
                            <% subjectList.forEach(sub => { %>
                                <option value="<%= sub %>" <%= selectedSubject === sub ? 'selected' : '' %>><%= sub %></option>
                            <% }) %>
                        </select>

                        <% if (selectedSubject !== 'all' || selectedClass !== 'all' || searchQuery) { %>
                            <a href="/superadmin/ai-knowledge" class="h-9 px-3 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-rose-500 flex items-center gap-1 transition-colors">
                                <span class="material-symbols-rounded text-sm">close</span> Clear
                            </a>
                        <% } %>
                    </form>

                    <!-- Add Knowledge Button -->
                    <button type="button" onclick="openCreateModal()" class="h-9 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-sm transition-all">
                        <span class="material-symbols-rounded text-base">add_circle</span>
                        <span>Add Knowledge Rule</span>
                    </button>
                </div>

                <!-- Knowledge Items Feed -->
                <div class="p-4 sm:p-6 space-y-4">
                    <% if (knowledgeList && knowledgeList.length > 0) { %>
                        <div class="grid grid-cols-1 gap-4">
                            <% knowledgeList.forEach((item, idx) => { %>
                                <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-xs transition-all hover:border-indigo-300 dark:hover:border-indigo-800 flex flex-col gap-3">
                                    
                                    <!-- Header Row -->
                                    <div class="flex flex-wrap items-start justify-between gap-2">
                                        <div class="space-y-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 font-bold text-[10.5px] border border-indigo-200/60 dark:border-indigo-800">
                                                    <%= item.subject %>
                                                </span>
                                                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold text-[10.5px]">
                                                    <%= item.classLevel %>
                                                </span>
                                                <% if (item.topic) { %>
                                                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                                                        • <%= item.topic %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                                                <%= item.title %>
                                            </h4>
                                        </div>

                                        <!-- Actions -->
                                        <div class="flex items-center gap-2">
                                            <!-- Priority Badge -->
                                            <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900 text-[10px] font-bold" title="Higher number = higher override priority">
                                                Priority: <%= item.priority %>
                                            </span>

                                            <!-- Toggle Active -->
                                            <button type="button" onclick="toggleStatus('<%= item._id %>', this)" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all <%= item.isActive ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800' %>">
                                                <%= item.isActive ? 'Active' : 'Disabled' %>
                                            </button>

                                            <!-- Edit -->
                                            <button type="button" onclick="openEditModal(<%= JSON.stringify(item) %>)" class="size-8 rounded-lg bg-slate-100 hover:bg-indigo-50 dark:bg-slate-800 dark:hover:bg-indigo-950/40 text-slate-600 hover:text-indigo-600 dark:text-slate-300 flex items-center justify-center transition-colors" title="Edit">
                                                <span class="material-symbols-rounded text-base">edit</span>
                                            </button>

                                            <!-- Delete -->
                                            <form method="POST" action="/superadmin/ai-knowledge/<%= item._id %>/delete" onsubmit="return confirm('Are you sure you want to delete this knowledge rule?');">
                                                <button type="submit" class="size-8 rounded-lg bg-slate-100 hover:bg-rose-50 dark:bg-slate-800 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-300 flex items-center justify-center transition-colors" title="Delete">
                                                    <span class="material-symbols-rounded text-base">delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Keywords Chips -->
                                    <% if (item.keywords && item.keywords.length > 0) { %>
                                        <div class="flex flex-wrap items-center gap-1.5 pt-1">
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Triggers:</span>
                                            <% item.keywords.forEach(k => { %>
                                                <span class="px-2 py-0.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-300 text-[11px] font-mono">
                                                    #<%= k %>
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } %>

                                    <!-- Content Body / LaTeX Preview -->
                                    <div class="bg-slate-50/80 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/80 rounded-xl p-3.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal whitespace-pre-wrap math-renderable">
<%= item.content %>
                                    </div>

                                    <!-- Footer info -->
                                    <div class="flex items-center justify-between text-[10.5px] text-slate-400 pt-1">
                                        <span>Added <%= new Date(item.createdAt).toLocaleDateString('en-GB') %></span>
                                        <% if (item.createdBy && item.createdBy.name) { %>
                                            <span>By <%= item.createdBy.name %></span>
                                        <% } %>
                                    </div>

                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <!-- Empty State -->
                        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl p-10 text-center max-w-lg mx-auto flex flex-col items-center justify-center space-y-4">
                            <div class="size-16 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                <span class="material-symbols-rounded text-3xl">smart_toy</span>
                            </div>
                            <div class="space-y-1">
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">No AI Knowledge Rules Yet</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Add custom textbook definitions, formula shortcuts, and institutional solutions that Oddhay AI will prioritize above all general answers.
                                </p>
                            </div>
                            <button type="button" onclick="openCreateModal()" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm">
                                Create First Knowledge Rule
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <!-- Create / Edit Knowledge Modal -->
    <div id="knowledgeModal" class="fixed inset-0 z-[200] bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
            
            <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <h3 id="modalTitle" class="text-sm sm:text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-symbols-rounded text-indigo-500">add_circle</span>
                    <span>Add Custom Knowledge Rule</span>
                </h3>
                <button type="button" onclick="closeModal()" class="size-8 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white flex items-center justify-center">
                    <span class="material-symbols-rounded text-lg">close</span>
                </button>
            </div>

            <form id="modalForm" method="POST" action="/superadmin/ai-knowledge/create" class="flex-1 overflow-y-auto p-5 space-y-4">
                
                <div>
                    <label class="form-label">Rule / Topic Title *</label>
                    <input type="text" name="title" id="formTitle" required placeholder="e.g., অধ্যায় ২: গতির সমীকরণ ও বিশেষ শর্টকাট" class="form-input">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="form-label">Subject *</label>
                        <select name="subject" id="formSubject" required class="form-input">
                            <% subjectList.forEach(sub => { %>
                                <option value="<%= sub %>"><%= sub %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Target Class *</label>
                        <select name="classLevel" id="formClassLevel" required class="form-input">
                            <option value="All Classes">All Classes</option>
                            <% classList.forEach(cls => { %>
                                <option value="<%= cls %>"><%= cls %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="form-label">Topic / Sub-Topic (Optional)</label>
                    <input type="text" name="topic" id="formTopic" placeholder="e.g., Kinetic Energy & Potential Energy" class="form-input">
                </div>

                <div>
                    <label class="form-label">Keywords / Trigger Terms (Comma Separated) *</label>
                    <input type="text" name="keywords" id="formKeywords" placeholder="e.g., গতিশক্তি, বিভবশক্তি, E_k, E_p, 1/2mv^2" class="form-input">
                    <p class="text-[10px] text-slate-400 mt-1">When students mention any of these keywords in their question, this authority rule will be injected directly into the AI's prompt.</p>
                </div>

                <div>
                    <label class="form-label">Exact Knowledge / Formula Content (Markdown & LaTeX Supported) *</label>
                    <textarea name="content" id="formContent" rows="6" required placeholder="Write the exact definition, formula ($...$), derivation steps, or marking rules..." class="form-input !h-auto !py-2.5 font-normal leading-relaxed"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                    <div>
                        <label class="form-label">Priority (1 - 1000)</label>
                        <input type="number" name="priority" id="formPriority" value="100" min="1" max="1000" class="form-input">
                        <p class="text-[10px] text-slate-400 mt-1">Higher priority rules take precedence over lower priority rules.</p>
                    </div>

                    <div class="flex items-center gap-2 pt-6">
                        <input type="checkbox" name="isActive" id="formIsActive" checked class="size-4 text-indigo-600 rounded">
                        <label for="formIsActive" class="text-xs font-bold text-slate-700 dark:text-slate-200">Active in Production</label>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm">Save Rule</button>
                </div>

            </form>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            renderMathInElement(document.body, {
                delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', display: false}
                ],
                throwOnError: false
            });
        });

        function openCreateModal() {
            document.getElementById('modalTitle').innerHTML = '<span class="material-symbols-rounded text-indigo-500">add_circle</span><span>Add Custom Knowledge Rule</span>';
            document.getElementById('modalForm').action = '/superadmin/ai-knowledge/create';
            document.getElementById('formTitle').value = '';
            document.getElementById('formTopic').value = '';
            document.getElementById('formKeywords').value = '';
            document.getElementById('formContent').value = '';
            document.getElementById('formPriority').value = '100';
            document.getElementById('formIsActive').checked = true;
            document.getElementById('knowledgeModal').classList.remove('hidden');
            document.getElementById('knowledgeModal').classList.add('flex');
        }

        function openEditModal(item) {
            document.getElementById('modalTitle').innerHTML = '<span class="material-symbols-rounded text-indigo-500">edit</span><span>Edit Knowledge Rule</span>';
            document.getElementById('modalForm').action = '/superadmin/ai-knowledge/' + item._id + '/edit';
            document.getElementById('formTitle').value = item.title || '';
            document.getElementById('formSubject').value = item.subject || '';
            document.getElementById('formClassLevel').value = item.classLevel || 'All Classes';
            document.getElementById('formTopic').value = item.topic || '';
            document.getElementById('formKeywords').value = (item.keywords || []).join(', ');
            document.getElementById('formContent').value = item.content || '';
            document.getElementById('formPriority').value = item.priority || 100;
            document.getElementById('formIsActive').checked = item.isActive !== false;
            document.getElementById('knowledgeModal').classList.remove('hidden');
            document.getElementById('knowledgeModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('knowledgeModal').classList.add('hidden');
            document.getElementById('knowledgeModal').classList.remove('flex');
        }

        async function toggleStatus(id, btn) {
            try {
                const res = await fetch('/superadmin/ai-knowledge/' + id + '/toggle', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    btn.textContent = data.isActive ? 'Active' : 'Disabled';
                    btn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold transition-all ' + 
                        (data.isActive ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800');
                }
            } catch (e) {
                console.error(e);
            }
        }
    </script>
</body>

</html>
