<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Question Bank | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-slide-up { animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'questions' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Question Bank Archive' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                <!-- Archive Stats -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div onclick="window.location.href='?board=all'" class="bg-blue-50/50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-blue-500/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">database</span>
                        <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400 relative z-10">Total Archive</p>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.totalArchive %></h3></div>
                        <p class="text-[9px] text-slate-400 font-bold relative z-10">Past Paper Assets</p>
                    </div>
                    <div onclick="window.location.href='?q=<%= filters.q %>&board=<%= filters.board %>&subject=<%= filters.subject %>&class=<%= filters.class %>&access=Paid'" class="bg-emerald-50/50 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-500/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">workspace_premium</span>
                        <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 relative z-10">Paid Questions</p>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.paidQuestionsCount %></h3></div>
                        <p class="text-[9px] text-slate-400 font-bold relative z-10">Premium Content</p>
                    </div>
                    <div onclick="window.location.href='?q=<%= filters.q %>&board=<%= filters.board %>&subject=<%= filters.subject %>&class=<%= filters.class %>&access=Free'" class="bg-amber-50/50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">money_off</span>
                        <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400 relative z-10">Free Questions</p>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.freeQuestionsCount %></h3></div>
                        <p class="text-[9px] text-slate-400 font-bold relative z-10">Open Access</p>
                    </div>
                    <div class="bg-purple-50/50 dark:bg-purple-500/10 border border-purple-100 dark:border-purple-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-500/20">
                        <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-purple-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">groups</span>
                        <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400 relative z-10">Total Paid Students</p>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.totalPaidStudents %></h3></div>
                        <p class="text-[9px] text-slate-400 font-bold relative z-10">Active Subscribers</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Filters Bar -->
                    <div class="sticky top-[-0.5rem] z-30 bg-white dark:bg-slate-800 px-3 py-2 border-b border-slate-50 dark:border-slate-700/50 flex flex-wrap items-center justify-between gap-3 shadow-sm rounded-t-md">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <form action="" method="GET" class="relative flex-1 max-w-[500px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search archive..." class="w-full pl-3 pr-10 h-10 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                <input type="hidden" name="board" value="<%= filters.board %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                <input type="hidden" name="access" value="<%= filters.access %>">
                            </form>
                            
                            <div class="relative w-[110px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&class=<%= filters.class %>&subject=<%= filters.subject %>&access=<%= filters.access %>&board=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all">All Boards</option>
                                    <% boards.forEach(board => { %>
                                        <option value="<%= board %>" <%= filters.board === board ? 'selected' : '' %>><%= board %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&board=<%= filters.board %>&subject=<%= filters.subject %>&access=<%= filters.access %>&class=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                    <% [6,7,8,9,10,11,12].forEach(c => { %>
                                        <option value="<%= c %>" <%= filters.class == c ? 'selected' : '' %>>Class <%= c %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[110px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&board=<%= filters.board %>&class=<%= filters.class %>&access=<%= filters.access %>&subject=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all">All Subjects</option>
                                    <% subjects.forEach(sub => { %>
                                        <option value="<%= sub %>" <%= filters.subject === sub ? 'selected' : '' %>><%= sub %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='?q=<%= filters.q %>&board=<%= filters.board %>&class=<%= filters.class %>&subject=<%= filters.subject %>&access=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.access === 'all' ? 'selected' : '' %>>All Access</option>
                                    <option value="Free" <%= filters.access === 'Free' ? 'selected' : '' %>>Free</option>
                                    <option value="Paid" <%= filters.access === 'Paid' ? 'selected' : '' %>>Paid</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all"><span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalQuestions %></span> Matches</span></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/superadmin/question-bank-approvals" class="h-10 px-4 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-[10px] border border-amber-500/20 hover:bg-amber-500/20 transition-all flex items-center gap-1.5 relative">
                                <span class="material-symbols-rounded text-sm">pending_actions</span> Pending Approvals
                                <% if (stats && stats.pendingCount > 0) { %>
                                    <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                                    <span class="px-1.5 py-0.2 bg-amber-500 text-white text-[9px] rounded-full font-extrabold"><%= stats.pendingCount %></span>
                                <% } %>
                            </a>
                            <button onclick="document.getElementById('addQuestionModal').classList.remove('hidden')" class="h-10 px-4 rounded-lg bg-primary text-white font-bold text-[10px] shadow-lg shadow-primary/20 hover:bg-blue-600 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">upload_file</span> New Question
                            </button>
                            <button onclick="exportToCSV()" class="h-10 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-2 text-[10px] font-bold text-slate-500">Question Material</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Board</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Year</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Subject</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Class</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Access</th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Author</th>
                                    <th class="pr-4 py-2 text-[10px] font-bold text-slate-500 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% questions.forEach(item => { %>
                                    <tr class="question-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" ondblclick="toggleRowSelection('<%= item._id %>')">
                                        <td class="pl-4 pr-1 py-3" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= item._id %>" id="cb-<%= item._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-3">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg overflow-hidden bg-orange-50 dark:bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-100 dark:border-orange-500/20 shadow-sm transition-transform hover:scale-105">
                                                    <% if (item.thumbnail) { %>
                                                        <img src="<%= item.thumbnail %>" class="size-full object-cover" onerror="this.outerHTML='<span class=\'material-symbols-rounded text-lg\'>description</span>'">
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-lg">description</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex flex-col">
                                                     <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight"><%= item.title || item.topic || (item.board ? item.board + ' ' + item.year : 'Question Bank') %></p>
                                                 </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="px-2 py-0.5 rounded-md bg-slate-50 dark:bg-slate-900 text-slate-500 text-[9px] font-bold border border-slate-100 dark:border-slate-800">
                                                <%= item.board %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= item.year %></span>
                                        </td>
                                        <td class="px-6 py-3 text-[10px] font-bold text-primary">
                                            <%= item.subject %>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[10px] font-bold text-slate-500">Class: <%= item.classLevel %></span>
                                        </td>
                                        <td class="px-6 py-3">
                                             <button onclick="editAccessModal(event, '<%= item._id %>', '<%= item.accessType %>', '<%= item.price || 0 %>', 'superadmin')" class="group hover:scale-105 transition-transform" title="Click to edit access & price">
                                                 <% if (item.accessType === 'Paid') { %>
                                                     <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                         <span class="material-symbols-rounded text-[11px]">payments</span>
                                                         <span>Paid (৳<%= item.price || 0 %>)</span>
                                                         <span class="material-symbols-rounded text-[10px] text-amber-500 opacity-80">edit</span>
                                                     </span>
                                                 <% } else { %>
                                                     <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20 whitespace-nowrap inline-flex items-center gap-1">
                                                         <span>Free</span>
                                                         <span class="material-symbols-rounded text-[10px] text-emerald-500 opacity-80">edit</span>
                                                     </span>
                                                 <% } %>
                                             </button>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex items-center gap-2">
                                                <div class="size-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center flex-shrink-0">
                                                    <% const avatar = item.addedBy && (item.addedBy.profilePicture || item.addedBy.profileImage); %>
                                                    <% if (avatar) { %>
                                                        <img src="<%= avatar %>" class="size-full object-cover" onerror="this.src='/images/default-avatar.png';">
                                                    <% } else { %>
                                                        <img src="/images/default-avatar.png" class="size-full object-cover">
                                                    <% } %>
                                                </div>
                                                <span class="text-[10px] font-bold text-slate-400 truncate max-w-[80px]"><%= item.addedBy ? item.addedBy.name : 'System' %></span>
                                            </div>
                                        </td>
                                        <td class="pr-4 py-3">
                                            <div class="flex items-center justify-end gap-1.5">
                                                 <a href="/superadmin/question-bank/<%= item._id %>" class="px-2.5 py-1 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 text-[10px] font-bold transition-all border border-blue-500/25 flex items-center gap-1 shadow-xs active:scale-95" title="Review All Questions in Archive">
                                                     <span class="material-symbols-rounded text-sm flex items-center justify-center">rate_review</span>
                                                     <span>Review</span>
                                                 </a>
                                                <button onclick="deleteResource('<%= item._id %>')" class="size-7 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Delete Entry">
                                                    <span class="material-symbols-rounded text-[18px]">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= filters.q %>&board=<%= filters.board %>&class=<%= filters.class %>&subject=<%= filters.subject %>&access=<%= filters.access %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Bulk Action Bar -->
                    <div id="bulkActions" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-between z-50 animate-slide-up border border-slate-200 dark:border-slate-700 mx-4 rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                                </div>
                                <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <button onclick="selectAllRows(true)" id="selectAllBtn" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select All</button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="handleBulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-lg text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20">Delete</button>
                            <button onclick="clearSelection()" class="h-8 px-4 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();
        function toggleSelectAll() { selectAllRows(document.getElementById('selectAll').checked); }
        function selectAllRows(force) {
            document.querySelectorAll('.item-cb').forEach(cb => { cb.checked = force; if(force) selectedItems.add(cb.value); else selectedItems.delete(cb.value); });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }
        function toggleRowSelection(id) { const cb = document.getElementById(`cb-${id}`); if (cb) { cb.checked = !cb.checked; toggleSelection(cb); } }
        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value); else selectedItems.delete(el.value);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = document.querySelectorAll('.item-cb').length === selectedItems.size;
            updateBulkUI();
        }
        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) { bar.classList.remove('hidden'); countEl.innerText = selectedItems.size; } else { bar.classList.add('hidden'); }
        }
        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkUI();
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({ title: 'Bulk Action', text: `Apply ${action} to ${selectedItems.size} items?`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#137fec' });
            if (!res.isConfirmed) return;
            try {
                const response = await fetch('/superadmin/question-bank/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function deleteResource(id) {
            const res = await Swal.fire({ title: 'Confirm Deletion', text: 'This action cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#f43f5e' });
            if (res.isConfirmed) { window.location.href = `/superadmin/question-bank/${id}/delete`; }
        }

        function exportToCSV() {
            const rows = [['Board', 'Year', 'Subject', 'Class']];
            // Extract from DOM
            document.querySelectorAll('.question-row').forEach(tr => {
                const board = tr.querySelectorAll('span')[1].innerText;
                const year = tr.querySelectorAll('span')[2].innerText;
                const subject = tr.querySelector('.text-primary').innerText;
                const classLevel = tr.querySelectorAll('span')[3].innerText;
                rows.push([board, year, subject, classLevel]);
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "question_bank.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
    <!-- Add Question Modal -->
    <div id="addQuestionModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xl z-[250] hidden flex items-center justify-center p-6">
        <div class="bg-white dark:bg-[#0b1120] rounded-xl w-full max-w-lg overflow-hidden shadow-2xl border border-white/10 relative">
            <button onclick="document.getElementById('addQuestionModal').classList.add('hidden')" class="absolute top-4 right-4 size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all">
                <span class="material-symbols-rounded text-base">close</span>
            </button>
            <div class="p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-rounded text-[22px]">upload_file</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight">Upload Question</h3>
                        <p class="text-[10px] font-bold text-slate-400">Add a new board or entrance question</p>
                    </div>
                </div>
                <form action="/superadmin/add-question-bank" method="POST" enctype="multipart/form-data" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Board / Exam</label>
                            <input type="text" name="board" placeholder="Dhaka Board" required class="w-full h-10 px-4 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Year</label>
                            <input type="number" name="year" placeholder="2024" required class="w-full h-10 px-4 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Subject</label>
                            <select name="subject" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <% ['Physics','Chemistry','Biology','Higher Mathematics','General Mathematics','Bangla','English','ICT','Accounting','Business Organization','Finance & Banking','Economics'].forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Class Level</label>
                            <select name="classLevel" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <% [6,7,8,9,10,11,12].forEach(c => { %><option value="<%= c %>">Class <%= c %></option><% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Access Type</label>
                            <select name="accessType" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <option value="Free">Free</option>
                                <option value="Paid">Paid</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1 block mb-1">Select File (PDF)</label>
                            <input type="file" name="file" required class="w-full text-xs font-bold text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-[10px] file:font-black file:bg-primary/10 file:text-primary hover:file:bg-primary/20 cursor-pointer">
                        </div>
                    </div>
                    <button type="submit" class="w-full h-10 bg-primary text-white rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 transition-all shadow-lg shadow-primary/20">Submit Asset</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>