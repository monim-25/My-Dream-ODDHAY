<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Create Staff Account | ODDHAY Command Center</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                min-height: 100vh;
                transition: all 0.3s ease;
            }

            .form-card {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 0.375rem;
                overflow: hidden;
            }

            .dark .form-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            .role-card {
                background: #f8fafc;
                border: 2px solid #e2e8f0;
                border-radius: 0.375rem;
                padding: 1rem;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .role-card:hover {
                border-color: #3b82f6;
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .role-card.selected {
                border-color: #3b82f6;
                background: #eff6ff;
            }

            .dark .role-card {
                background: #0f172a;
                border-color: #334155;
            }

            .dark .role-card:hover {
                border-color: #3b82f6;
            }

            .dark .role-card.selected {
                border-color: #3b82f6;
                background: #1e3a8a;
            }

            .perm-list {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                gap: 0.5rem;
                margin-top: 0.5rem;
            }

            .perm-item {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.75rem;
                color: #64748b;
            }

            .perm-item .material-symbols-rounded {
                font-size: 16px;
                color: #10b981;
            }

            @keyframes slideUpFade {
                from { opacity: 0; transform: translateY(15px); }
                to { opacity: 1; transform: translateY(0); }
            }

            .animate-form-reveal {
                animation: slideUpFade 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }
            }
        </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen">

    <div class="flex">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'create-role' }) %>
        </aside>

        <main class="admin-main flex-1 ml-[260px] bg-[#F8FAFC] dark:bg-[#020617] flex flex-col min-h-screen">
            <%- include('header_v2', { pageTitle: 'Create Staff Account' }) %>

                <section class="p-0.5 flex flex-col gap-0.5">
                    <!-- Form Card -->
                    <div class="form-card">

                        <form id="createRoleForm" class="p-3 lg:p-4">
                            <!-- Error/Success Messages -->
                            <% if (error) { %>
                                <div
                                    class="mb-3 bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-2.5 rounded-md flex items-center gap-2 text-[11px] font-bold">
                                    <span class="material-symbols-rounded text-[16px]">error</span>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <% if (success) { %>
                                        <div
                                            class="mb-3 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-3 py-2.5 rounded-md flex items-center gap-2 text-[11px] font-bold">
                                            <span class="material-symbols-rounded text-[16px]">check_circle</span>
                                            <%= success %>
                                        </div>
                                        <% } %>

                                            <!-- Step 1: Role Selection -->
                                            <div class="mb-4">
                                                <h4
                                                    class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                                                    1. Select Role Type</h4>
                                                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-2">
                                                    <!-- Teacher -->
                                                    <div class="role-card" onclick="selectRole('teacher')"
                                                        id="role-teacher">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <div
                                                                class="size-8 rounded-md bg-amber-500/10 flex items-center justify-center">
                                                                <span
                                                                    class="material-symbols-rounded text-lg text-amber-500">school</span>
                                                            </div>
                                                            <span class="text-[11px] font-bold">Teacher</span>
                                                        </div>
                                                        <p class="text-[9px] text-slate-500">Create courses, manage
                                                            quizzes, answer Q&A</p>
                                                    </div>

                                                    <!-- Admin -->
                                                    <div class="role-card" onclick="selectRole('admin')"
                                                        id="role-admin">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <div
                                                                class="size-8 rounded-md bg-blue-500/10 flex items-center justify-center">
                                                                <span
                                                                    class="material-symbols-rounded text-lg text-blue-500">admin_panel_settings</span>
                                                            </div>
                                                            <span class="text-[11px] font-bold">Admin</span>
                                                        </div>
                                                        <p class="text-[9px] text-slate-500">Full platform management
                                                            access</p>
                                                    </div>

                                                    <!-- Content Manager -->
                                                    <div class="role-card" onclick="selectRole('content_manager')"
                                                        id="role-content_manager">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <div
                                                                class="size-8 rounded-md bg-violet-500/10 flex items-center justify-center">
                                                                <span
                                                                    class="material-symbols-rounded text-lg text-violet-500">edit_note</span>
                                                            </div>
                                                            <span class="text-[11px] font-bold">Content Mgr</span>
                                                        </div>
                                                        <p class="text-[9px] text-slate-500">Manage courses, notes,
                                                            quizzes only</p>
                                                    </div>

                                                    <!-- Support Agent -->
                                                    <div class="role-card" onclick="selectRole('support')"
                                                        id="role-support">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <div
                                                                class="size-8 rounded-md bg-emerald-500/10 flex items-center justify-center">
                                                                <span
                                                                    class="material-symbols-rounded text-lg text-emerald-500">headset_mic</span>
                                                            </div>
                                                            <span class="text-[11px] font-bold">Support</span>
                                                        </div>
                                                        <p class="text-[9px] text-slate-500">Handle Q&A, messages, user
                                                            support</p>
                                                    </div>

                                                    <!-- Moderator -->
                                                    <div class="role-card" onclick="selectRole('moderator')"
                                                        id="role-moderator">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <div
                                                                class="size-8 rounded-md bg-rose-500/10 flex items-center justify-center">
                                                                <span
                                                                    class="material-symbols-rounded text-lg text-rose-500">gavel</span>
                                                            </div>
                                                            <span class="text-[11px] font-bold">Moderator</span>
                                                        </div>
                                                        <p class="text-[9px] text-slate-500">Moderate Q&A forum, chat,
                                                            comments</p>
                                                    </div>
                                                </div>

                                                <!-- Permissions Preview -->
                                                <div id="permissionsPreview"
                                                    class="mt-3 p-3 bg-slate-50 dark:bg-slate-900/50 rounded-md border border-slate-200 dark:border-slate-700/50 <%= error || success || (typeof role !== 'undefined' && role) ? '' : 'hidden' %>">
                                                    <p
                                                        class="text-[9px] font-bold text-slate-400 tracking-tight mb-1">
                                                        Permissions</p>
                                                    <div class="perm-list" id="permList">
                                                        <div class="perm-item"><span
                                                                class="material-symbols-rounded">check_circle</span>
                                                            View dashboard</div>
                                                        <div class="perm-item"><span
                                                                class="material-symbols-rounded">check_circle</span>
                                                            View users</div>
                                                        <div class="perm-item"><span
                                                                class="material-symbols-rounded">check_circle</span>
                                                            View courses</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Rest of Form (Hidden until role selected) -->
                                            <div id="roleFormContents" class="<%= error || success || (typeof role !== 'undefined' && role) ? '' : 'hidden' %>">
                                                <!-- Step 2: Personal Info -->
                                                <div class="mb-4">
                                                <h4
                                                    class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                                                    2. Personal Information</h4>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                    <!-- Full Name -->
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Full
                                                            Name <span class="text-rose-500">*</span></label>
                                                        <input type="text" name="name" required
                                                            placeholder="Md Monim Islam"
                                                            value="<%= typeof name !== 'undefined' ? name : '' %>"
                                                            class="w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-2.5 text-[11px] font-bold focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none">
                                                    </div>

                                                    <!-- Email -->
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Email
                                                            Address <span class="text-rose-500">*</span></label>
                                                        <div class="relative">
                                                            <input type="email" name="email" required
                                                                placeholder="staff@oddhay.com"
                                                                value="<%= typeof email !== 'undefined' ? email : '' %>"
                                                                id="emailInput" onblur="checkEmailUnique()"
                                                                class="w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-2.5 text-[11px] font-bold focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none">
                                                            <span id="emailStatus"
                                                                class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] font-bold"></span>
                                                        </div>
                                                    </div>

                                                    <!-- Phone -->
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Phone
                                                            Number</label>
                                                        <input type="tel" name="phone" placeholder="01XXXXXXXXX"
                                                            pattern="01[3-9]\d{8}"
                                                            value="<%= typeof phone !== 'undefined' ? phone : '' %>"
                                                            class="w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-2.5 text-[11px] font-bold focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none">
                                                        <p class="text-[9px] text-slate-400">Format: 01XXXXXXXXX
                                                            (Bangladesh)</p>
                                                    </div>

                                                    <!-- Account Status -->
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Account
                                                            Status</label>
                                                        <select name="status"
                                                            class="w-full bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-2.5 text-[11px] font-bold focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none cursor-pointer">
                                                            <option value="active" <%=typeof status==='undefined' ||
                                                                status==='active' ? 'selected' : '' %>>Active</option>
                                                            <option value="suspended" <%=typeof status !=='undefined' &&
                                                                status==='suspended' ? 'selected' : '' %>>Suspended
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Step 3: Teacher-specific Fields -->
                                            <div id="teacherFields" class="mb-4 hidden">
                                                <h4
                                                    class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                                                    3. Teaching Details</h4>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                    <!-- Class Selection (Multiple) -->
                                                    <div class="col-span-full space-y-2">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Teaching
                                                            Classes <span class="text-rose-500">*</span></label>
                                                        <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-2">
                                                            <% (globalAcademicClasses || []).forEach(cls => { %>
                                                                <label
                                                                    class="flex items-center gap-2 p-2 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 cursor-pointer hover:border-blue-500 transition-all group">
                                                                    <input type="checkbox" name="classes"
                                                                        value="<%= cls.name %>" onchange="handleClassChange()"
                                                                        class="size-3.5 rounded border-slate-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500">
                                                                    <span class="text-[10px] font-bold"><%= cls.name %></span>
                                                                </label>
                                                                <% }) %>
                                                        </div>
                                                    </div>

                                                    <!-- Subject Selection (Multiple Pills) -->
                                                    <div id="subjectField" class="col-span-full space-y-2 hidden">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Primary
                                                            Subjects <span class="text-rose-500">*</span></label>
                                                        <div id="subjectPills" class="flex flex-wrap gap-1.5">
                                                            <!-- Pills generated via JS -->
                                                        </div>
                                                        <input type="hidden" name="subjects" id="subjectsInput">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Step 4: Password & Security -->
                                            <div class="mb-4">
                                                <h4
                                                    class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                                                    <%= typeof teacherFieldsHidden==='undefined' ||
                                                        teacherFieldsHidden==='hidden' ? '3' : '4' %>. Password &
                                                        Security
                                                </h4>
                                                <div class="space-y-3">
                                                    <!-- Password with Generate Button -->
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[9px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Login
                                                            Password <span class="text-rose-500">*</span></label>
                                                        <div class="flex items-center gap-2">
                                                            <input type="text" name="password" required
                                                                id="passwordInput"
                                                                class="flex-1 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-2.5 text-[11px] font-bold focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none">
                                                            <button type="button" onclick="generatePassword()"
                                                                class="px-3 py-2.5 bg-blue-500 text-white rounded-md text-[10px] font-bold hover:bg-blue-600 transition-all flex items-center gap-1">
                                                                <span
                                                                    class="material-symbols-rounded text-[14px]">autorenew</span>
                                                                Generate
                                                            </button>
                                                            <button type="button" onclick="copyPassword()"
                                                                class="px-3 py-2.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-md text-[10px] font-bold hover:bg-slate-300 dark:hover:bg-slate-600 transition-all flex items-center gap-1">
                                                                <span
                                                                    class="material-symbols-rounded text-[14px]">content_copy</span>
                                                                Copy
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <!-- Security Options -->
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                        <div
                                                            class="flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-900/50 rounded-md border border-slate-200 dark:border-slate-700/50">
                                                            <input type="checkbox" name="forcePasswordChange"
                                                                id="forcePwChange" checked class="size-4 rounded">
                                                            <label for="forcePwChange"
                                                                class="text-[10px] font-bold text-slate-700 dark:text-slate-300">
                                                                Force password change on first login
                                                            </label>
                                                        </div>
                                                        <div
                                                            class="flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-900/50 rounded-md border border-slate-200 dark:border-slate-700/50">
                                                            <input type="checkbox" name="sendInviteEmail"
                                                                id="sendInvite" checked class="size-4 rounded">
                                                            <label for="sendInvite"
                                                                class="text-[10px] font-bold text-slate-700 dark:text-slate-300">
                                                                Send welcome email with credentials
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                                <!-- Submit Button -->
                                                <div
                                                    class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                                    <p class="text-[10px] text-slate-400 flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-[14px]">info</span>
                                                        Account will be created with selected role permissions
                                                    </p>
                                                    <button type="submit"
                                                        class="px-6 py-2.5 bg-black dark:bg-white text-white dark:text-black rounded-md font-bold text-sm flex items-center gap-2 shadow-[0_4px_12px_rgba(0,0,0,0.1)] dark:shadow-none hover:bg-slate-800 dark:hover:bg-slate-100 active:scale-[0.98] transition-all">
                                                         Create account
                                                        <span class="material-symbols-rounded text-[18px]">done</span>
                                                    </button>
                                                </div>
                                                <input type="hidden" name="role" id="hiddenRoleInput" value="<%= typeof role !== 'undefined' ? role : '' %>">
                                            </div>
                        </form>
                    </div>
                </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleAdminSidebar() {
            document.getElementById('adminSidebar').classList.toggle('active');
        }

        // Role permissions mapping
        const rolePermissions = {
            'teacher': [
                'View dashboard',
                'Create courses',
                'Manage quizzes',
                'Upload notes',
                'Answer Q&A',
                'View enrolled students',
                'Track student progress'
            ],
            'admin': [
                'Full platform access',
                'Manage all users',
                'Manage all courses',
                'View payments',
                'Send notifications',
                'Manage coupons',
                'View analytics',
                'System settings'
            ],
            'content_manager': [
                'Create courses',
                'Upload videos',
                'Manage notes',
                'Create quizzes',
                'Manage question bank',
                'View course stats'
            ],
            'support': [
                'View users',
                'Answer Q&A',
                'Manage messages',
                'View user tickets',
                'Send notifications'
            ],
            'moderator': [
                'Moderate Q&A',
                'Moderate chat',
                'Moderate comments',
                'Ban users (temporary)',
                'View reports'
            ]
        };

        function selectRole(role) {
            // Update hidden input
            document.getElementById('hiddenRoleInput').value = role;

            // Update visual selection
            document.querySelectorAll('.role-card').forEach(card => card.classList.remove('selected'));
            document.getElementById('role-' + role).classList.add('selected');

            // Update permissions preview
            const perms = rolePermissions[role] || [];
            const permList = document.getElementById('permList');
            permList.innerHTML = perms.map(perm =>
                `<div class="perm-item"><span class="material-symbols-rounded">check_circle</span> ${perm}</div>`
            ).join('');

            // Show form contents with animation
            const formContents = document.getElementById('roleFormContents');
            const permsPreview = document.getElementById('permissionsPreview');

            if (formContents.classList.contains('hidden')) {
                formContents.classList.remove('hidden');
                permsPreview.classList.remove('hidden');
                formContents.classList.add('animate-form-reveal');
                permsPreview.classList.add('animate-form-reveal');
            }

            // Show/hide teacher fields
            const teacherFields = document.getElementById('teacherFields');
            if (role === 'teacher') {
                teacherFields.classList.remove('hidden');
            } else {
                teacherFields.classList.add('hidden');
            }
        }

        // Subject data by class dynamically from globalAcademicClasses
        const subjectsByClass = {};
        <% (globalAcademicClasses || []).forEach(cls => { %>
            subjectsByClass['<%= cls.name %>'] = <%- JSON.stringify(cls.subjects || []) %>;
        <% }); %>

        let selectedSubjects = [];

        function handleClassChange() {
            const selectedClasses = Array.from(document.querySelectorAll('input[name="classes"]:checked')).map(cb => cb.value);
            const subjectField = document.getElementById('subjectField');
            const subjectPills = document.getElementById('subjectPills');

            if (selectedClasses.length > 0) {
                const allSubjects = new Set();
                selectedClasses.forEach(lvl => {
                    if (subjectsByClass[lvl]) {
                        subjectsByClass[lvl].forEach(s => allSubjects.add(s));
                    }
                });

                const sortedSubjects = Array.from(allSubjects).sort();
                
                // Clear and rebuild pills
                subjectPills.innerHTML = '';
                sortedSubjects.forEach(subject => {
                    const isSelected = selectedSubjects.includes(subject);
                    const pill = document.createElement('div');
                    pill.className = `px-3 py-1.5 rounded-full border text-[10px] font-bold cursor-pointer transition-all ${isSelected ? 'bg-blue-600 border-blue-600 text-white shadow-md shadow-blue-500/20' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-blue-400'}`;
                    pill.textContent = subject;
                    pill.onclick = () => toggleSubject(subject, pill);
                    subjectPills.appendChild(pill);
                });

                subjectField.classList.remove('hidden');
            } else {
                subjectField.classList.add('hidden');
                selectedSubjects = [];
                updateSubjectsInput();
            }
        }

        function toggleSubject(subject, pill) {
            const index = selectedSubjects.indexOf(subject);
            if (index > -1) {
                selectedSubjects.splice(index, 1);
                pill.classList.remove('bg-blue-600', 'border-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/20');
                pill.classList.add('bg-white', 'dark:bg-slate-800', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-400');
            } else {
                selectedSubjects.push(subject);
                pill.classList.remove('bg-white', 'dark:bg-slate-800', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-400');
                pill.classList.add('bg-blue-600', 'border-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/20');
            }
            updateSubjectsInput();
        }

        function updateSubjectsInput() {
            document.getElementById('subjectsInput').value = selectedSubjects.join(',');
        }

        // Password Generator
        function generatePassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%';
            let password = '';
            for (let i = 0; i < 12; i++) {
                password += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('passwordInput').value = password;
        }

        function copyPassword() {
            const pw = document.getElementById('passwordInput');
            pw.select();
            document.execCommand('copy');
            Swal.fire({
                title: 'Copied!',
                text: 'Password copied to clipboard.',
                icon: 'success',
                timer: 1500,
                showConfirmButton: false
            });
        }

        // Email uniqueness check
        async function checkEmailUnique() {
            const email = document.getElementById('emailInput').value.trim();
            const statusEl = document.getElementById('emailStatus');

            if (!email || !email.includes('@')) {
                statusEl.textContent = '';
                return;
            }

            statusEl.innerHTML = '<span class="material-symbols-rounded text-[14px] animate-spin text-blue-500">progress_activity</span>';

            try {
                const res = await fetch('/api/check-email?email=' + encodeURIComponent(email));
                const data = await res.json();

                if (data.exists) {
                    statusEl.innerHTML = '<span class="text-rose-500">Already in use</span>';
                } else {
                    statusEl.innerHTML = '<span class="text-emerald-500">Available</span>';
                }
            } catch (e) {
                statusEl.textContent = '';
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-generate password on load
            if (!document.getElementById('passwordInput').value) {
                generatePassword();
            }

            // Restore state if error/success
            const initialRole = document.getElementById('hiddenRoleInput').value;
            if (initialRole) {
                // Restore subjects if they were passed back
                const initialSubjects = "<%= typeof subjects !== 'undefined' ? subjects : '' %>";
                if (initialSubjects) {
                    selectedSubjects = initialSubjects.split(',').filter(Boolean);
                    updateSubjectsInput();
                }

                selectRole(initialRole);
                handleClassChange();
            }

            // Clear URL query parameters after a short delay
            if (window.location.search) {
                setTimeout(() => {
                    const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
                    window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
                }, 1000);
            }
        });

        // AJAX Form Submission
        document.getElementById('createRoleForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalContent = submitBtn.innerHTML;
            
            try {
                // Show loading state
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="material-symbols-rounded animate-spin text-[18px]">progress_activity</span> Creating...';
                
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                
                // Add multi-select classes manually if they exist
                const classes = Array.from(document.querySelectorAll('input[name="classes"]:checked')).map(cb => cb.value);
                if (classes.length > 0) data.classes = classes;

                const response = await fetch('/superadmin/create-role', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: result.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    // Reset form and UI
                    this.reset();
                    document.getElementById('roleFormContents').classList.add('hidden');
                    document.getElementById('permissionsPreview').classList.add('hidden');
                    document.getElementById('hiddenRoleInput').value = '';
                    document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
                    document.getElementById('subjectField').classList.add('hidden');
                    selectedSubjects = [];
                    generatePassword();
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: result.error || 'Failed to create account',
                        icon: 'error'
                    });
                }
            } catch (err) {
                console.error('Submission error:', err);
                Swal.fire({
                    title: 'Error',
                    text: 'A connection error occurred. Please try again.',
                    icon: 'error'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalContent;
            }
        });
    </script>
</body>

</html>