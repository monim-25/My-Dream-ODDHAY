<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Coupon Engine | ODDHAY Command Center</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                overflow-y: auto;
                padding: 0;
                position: relative;
            }

            .stat-card {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            }

            .dark .stat-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }
            }

            /* Premium Modal Animations */
            .animate-in {
                animation-duration: 0.2s;
                animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
                animation-fill-mode: both;
            }
            .fade-in {
                animation-name: fadeIn;
            }
            .zoom-in {
                animation-name: zoomIn;
            }
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
            @keyframes zoomIn {
                from { opacity: 0.95; transform: scale(0.95); }
                to { opacity: 1; transform: scale(1); }
            }
        </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-screen">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'coupons' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] w-full">
            <%- include('header_v2', { pageTitle: 'Coupon Engine' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                    <!-- Success/Error Messages (Auto-hide) -->
                    <div id="alert-container">
                        <% if (success) { %>
                            <div id="alert-msg"
                                class="mb-1 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-3 py-2 rounded-md flex items-center gap-2 text-[11px] font-bold">
                                <span class="material-symbols-rounded text-[16px]">check_circle</span>
                                <%= success==='created' ? 'Coupon created successfully!'
                                    : 'Coupon updated successfully!' %>
                            </div>
                            <% } %>
                                <% if (error) { %>
                                    <div id="alert-msg"
                                        class="mb-1 bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-2 rounded-md flex items-center gap-2 text-[11px] font-bold">
                                        <span class="material-symbols-rounded text-[16px]">error</span>
                                        <%= error==='duplicate_code' ? 'Coupon code already exists!'
                                            : 'Operation failed. Please try again.' %>
                                    </div>
                                    <% } %>
                    </div>

                    <!-- Charts & Advanced Metrics -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-0.5 shrink-0">
                        <!-- Redemptions Chart -->
                        <div class="lg:col-span-2 bg-white dark:bg-[#0b1120] rounded-md border border-slate-200 dark:border-slate-700/50 flex flex-col min-h-[220px]">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-white/5 flex items-center justify-between">
                                <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight">Redemption Flow</h3>
                                <p class="text-[10px] font-bold text-slate-400 tracking-wide">Last 30 Days Usage</p>
                            </div>
                            <div class="p-3 h-[180px] relative w-full">
                                <canvas id="redemptionChartCanvas"></canvas>
                            </div>
                        </div>

                        <!-- Stat Cards Grid -->
                        <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2 grid grid-cols-2 gap-2 h-full">
                            <!-- Total Coupons -->
                            <div class="p-3 flex flex-col group h-[80px] bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 rounded-xl shadow-sm hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">local_offer</span>
                                <p class="text-[11px] font-bold text-blue-600 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                    <span class="material-symbols-rounded text-[14px]">local_offer</span> Total Coupons
                                </p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= coupons.length %></h3>
                                </div>
                            </div>
                            <!-- Live -->
                            <div class="p-3 flex flex-col group h-[80px] bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 rounded-xl shadow-sm hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-emerald-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">check_circle</span>
                                <p class="text-[11px] font-bold text-emerald-600 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                    <span class="material-symbols-rounded text-[14px]">check_circle</span> Live Coupons
                                </p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= coupons.filter(c => c.isActive && (!c.expiresAt || new Date(c.expiresAt) > new Date())).length %></h3>
                                </div>
                            </div>
                            <!-- Total Usage -->
                            <div class="p-3 flex flex-col group h-[80px] bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/20 dark:border-amber-500/20 rounded-xl shadow-sm hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-amber-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">sell</span>
                                <p class="text-[11px] font-bold text-amber-600 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                    <span class="material-symbols-rounded text-[14px]">sell</span> Total Uses
                                </p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none"><%= coupons.reduce((acc, curr) => acc + (curr.usedCount || 0), 0) %></h3>
                                </div>
                            </div>
                            <!-- Value Saved (Est) -->
                            <div class="p-3 flex flex-col group h-[80px] bg-rose-50/40 dark:bg-rose-500/10 border border-rose-100/20 dark:border-rose-500/20 rounded-xl shadow-sm hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                                <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-rose-500 opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-transform">savings</span>
                                <p class="text-[11px] font-bold text-rose-600 tracking-tight flex items-center gap-1.5 mb-1 relative z-10">
                                    <span class="material-symbols-rounded text-[14px]">savings</span> Value Saved*
                                </p>
                                <div class="flex-1 flex items-center relative z-10">
                                    <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white leading-none">৳<%= (totalValueSaved || 0).toLocaleString('en-IN') %></h3>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Coupon Table (Sticky Filter) -->
                    <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-4">
                        <!-- Search & Filter Header (Sticky) -->
                        <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                            <div class="flex items-center justify-between w-full gap-2">
                                <form action="/superadmin/coupons" method="GET" class="flex-1 flex items-center gap-2">
                                    <div class="relative flex-1">
                                        <input type="text" name="q" value="<%= filters.q || '' %>"
                                            placeholder="Search coupons by code or description..."
                                            class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all text-slate-900 dark:text-white placeholder:text-slate-400">
                                        <button type="submit" class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] hover:text-blue-500 transition-colors">search</button>
                                    </div>

                                    <select name="status"
                                        onchange="this.form.submit()"
                                        class="h-10 px-3 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50 text-[11px] font-bold text-slate-600 dark:text-slate-300 focus:ring-1 focus:ring-blue-500 cursor-pointer min-w-[120px]">
                                        <option value="all" <%=filters.status==='all' ? 'selected' : '' %>>All Status</option>
                                        <option value="active" <%=filters.status==='active' ? 'selected' : '' %>>Active</option>
                                        <option value="inactive" <%=filters.status==='inactive' ? 'selected' : '' %>>Inactive</option>
                                        <option value="expired" <%=filters.status==='expired' ? 'selected' : '' %>>Expired</option>
                                    </select>
                                </form>

                                <div class="flex items-center gap-2">
                                    <div class="flex items-center gap-1.5 px-3 h-10 rounded-md bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
                                        <span class="text-[10px] font-bold text-slate-400">Found:</span>
                                        <span class="text-[12px] font-black text-primary"><%= (typeof totalCount !== 'undefined') ? totalCount : coupons.length %></span>
                                        <span class="text-[10px] font-bold text-slate-400">Coupons</span>
                                    </div>
                                    <button onclick="exportCSV()"
                                        class="h-10 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-sm">download</span> Export
                                    </button>
                                    <button onclick="openModal()"
                                        class="h-10 px-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-md font-bold text-[10px] flex items-center gap-1.5 hover:opacity-90 transition-all shadow-lg shadow-slate-900/10 dark:shadow-white/5">
                                        <span class="material-symbols-rounded text-sm">add</span> Create Coupon
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Table Area -->
                        <div class="table-wrapper">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[64px] z-20">
                                    <tr>
                                        <th class="pl-4 pr-1 py-2 text-[11px] font-semibold text-slate-500 w-10">
                                            <input type="checkbox" id="selectAllCoupons" onchange="toggleAllCoupons()"
                                                class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer accent-primary">
                                        </th>
                                        <th class="pl-2 pr-4 py-2 text-[11px] font-semibold text-slate-500">Coupon Code</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500">Discount</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500">Usage</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500">Validity</th>
                                        <th class="px-4 py-2 text-[11px] font-semibold text-slate-500 text-right w-32">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                    <% coupons.forEach(c=> { %>
                                        <% const isExpired=c.expiresAt && new Date(c.expiresAt) < new Date(); %>
                                            <tr class="hover:bg-slate-50 dark:hover:bg-white/5 transition-all cursor-pointer group"
                                                id="row-<%= c._id %>"
                                                ondblclick="toggleSelectRow('<%= c._id %>')">
                                                <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                                    <input type="checkbox" class="coupon-checkbox size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100 accent-primary" value="<%= c._id %>" id="cb-<%= c._id %>" onchange="updateBulkBarUI()">
                                                </td>
                                                <td class="pl-2 pr-4 py-2">
                                                    <div class="flex flex-col gap-0.5">
                                                        <span class="text-[11px] font-mono font-bold text-indigo-600 dark:text-indigo-400 tracking-wider leading-none">
                                                            <%= c.code %>
                                                        </span>
                                                        <span class="text-[9px] font-bold text-slate-400 leading-none mt-0.5">
                                                            <%= c.description || 'No description' %>
                                                        </span>
                                                        <% if (c.courseType === 'specific') { %>
                                                            <span class="inline-flex items-center gap-1 mt-1 px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[8px] font-bold text-slate-500 w-fit leading-none">
                                                                <span class="material-symbols-rounded text-[10px] block leading-none">category</span> Course Specific
                                                            </span>
                                                        <% } else if (c.applicableClass) { %>
                                                            <span class="inline-flex items-center gap-1 mt-1 px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[8px] font-bold text-slate-500 w-fit leading-none">
                                                                <span class="material-symbols-rounded text-[10px] block leading-none">school</span> Class <%= c.applicableClass %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <div class="flex flex-col gap-0.5">
                                                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200 leading-none">
                                                            <%= c.discountType === 'percentage' ? c.discountValue + '%' : '৳' + c.discountValue %>
                                                            <span class="text-[9px] text-slate-400 font-bold uppercase tracking-wider ml-0.5"><%= c.discountType === 'percentage' ? 'OFF' : 'FLAT' %></span>
                                                        </span>
                                                        <% if (c.maxDiscount) { %>
                                                            <span class="text-[9px] font-bold text-slate-400 leading-none mt-0.5">
                                                                Max: ৳<%= c.maxDiscount %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <div class="flex flex-col gap-1 w-24">
                                                        <div class="flex items-center justify-between">
                                                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200 leading-none">
                                                                <%= c.usedCount %> <span class="text-[9px] text-slate-400">/ <%= c.usageLimit || '∞' %></span>
                                                            </span>
                                                            <% if (c.usageLimit) { %>
                                                                <span class="text-[9px] font-bold text-blue-500 leading-none"><%= Math.round((c.usedCount / c.usageLimit) * 100) %>%</span>
                                                            <% } %>
                                                        </div>
                                                        <% if (c.usageLimit) { %>
                                                            <div class="h-1.5 w-full bg-slate-100 dark:bg-slate-700/50 rounded-full overflow-hidden">
                                                                <div class="h-full bg-blue-500 rounded-full" style="width: <%= Math.min((c.usedCount / c.usageLimit) * 100, 100) %>%"></div>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="h-1.5 w-full bg-slate-100 dark:bg-slate-700/50 rounded-full overflow-hidden">
                                                                <div class="h-full bg-emerald-500 rounded-full" style="width: 100%"></div>
                                                            </div>
                                                        <% } %>
                                                        <span class="text-[8px] font-bold text-slate-400 leading-none mt-0.5">
                                                            Per user: <%= c.perUserLimit || '∞' %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <div class="flex flex-col gap-0.5">
                                                        <% if (c.expiresAt) { %>
                                                            <% const daysLeft = Math.ceil((new Date(c.expiresAt) - new Date()) / (1000 * 60 * 60 * 24)); %>
                                                            <span class="text-[11px] font-bold <%= isExpired ? 'text-rose-500' : 'text-slate-700 dark:text-slate-200' %> leading-none">
                                                                <%= new Date(c.expiresAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                            </span>
                                                            <div class="flex items-center gap-1 mt-1">
                                                                <span class="px-1.5 py-0.5 rounded text-[8px] font-bold tracking-wider uppercase <%= isExpired ? 'bg-rose-50 text-rose-500 dark:bg-rose-500/10 dark:text-rose-400' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400' %> leading-none">
                                                                    <%= isExpired ? 'Expired' : 'Active' %>
                                                                </span>
                                                                <% if (!isExpired) { %>
                                                                    <span class="text-[9px] font-bold <%= daysLeft <= 3 ? 'text-amber-500' : 'text-slate-400' %> leading-none">
                                                                        <%= daysLeft %>d left
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                        <% } else { %>
                                                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200 leading-none">No expiry</span>
                                                            <div class="mt-1 flex">
                                                                <span class="px-1.5 py-0.5 rounded text-[8px] font-bold tracking-wider uppercase bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 leading-none">Permanent</span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2 text-right">
                                                    <div class="flex items-center justify-end gap-1">
                                                        <button onclick="viewUsage('<%= c._id %>', '<%= c.code %>')"
                                                            class="size-7 rounded-md bg-slate-50 dark:bg-slate-800 text-slate-400 hover:bg-blue-50 hover:text-blue-500 dark:hover:bg-blue-500/10 flex items-center justify-center transition-all border border-slate-200 dark:border-slate-700 leading-none"
                                                            title="View usage history">
                                                            <span class="material-symbols-rounded text-[16px] block leading-none">history</span>
                                                        </button>
                                                        <button onclick="openEditModal('<%= c._id %>')"
                                                            class="size-7 rounded-md bg-slate-50 dark:bg-slate-800 text-slate-400 hover:bg-amber-50 hover:text-amber-500 dark:hover:bg-amber-500/10 flex items-center justify-center transition-all border border-slate-200 dark:border-slate-700 leading-none"
                                                            title="Edit coupon">
                                                            <span class="material-symbols-rounded text-[16px] block leading-none">edit</span>
                                                        </button>
                                                        <button onclick="toggleCoupon('<%= c._id %>', this)"
                                                            class="w-10 h-7 rounded-md text-[9px] font-bold transition-all flex items-center justify-center leading-none <%= c.isActive && !isExpired ? 'bg-emerald-50 text-emerald-600 border border-emerald-100 dark:border-emerald-500/20 dark:bg-emerald-500/10' : 'bg-slate-50 text-slate-400 border border-slate-200 dark:bg-slate-800 dark:border-slate-700' %>">
                                                            <%= c.isActive && !isExpired ? 'Live' : 'Off' %>
                                                        </button>
                                                        <button onclick="deleteCoupon('<%= c._id %>')"
                                                            class="size-7 rounded-md bg-slate-50 dark:bg-slate-800 text-slate-400 hover:bg-rose-50 hover:text-rose-500 dark:hover:bg-rose-500/10 flex items-center justify-center transition-all border border-slate-200 dark:border-slate-700 leading-none">
                                                            <span class="material-symbols-rounded text-[16px] block leading-none">delete</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                </tbody>
                            </table>
                        </div>

                            <!-- Empty State -->
                            <% if (coupons.length===0) { %>
                                <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                                    <span class="material-symbols-rounded text-3xl mb-2 opacity-40">local_offer</span>
                                    <p class="text-[10px] font-bold">No coupons found</p>
                                </div>
                                <% } %>
                    <!-- Bulk Action Bar - Question Bank Style -->
                    <div id="bulkBar" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-between z-50 border border-slate-200 dark:border-slate-700 mx-4 rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50 transition-all duration-300 transform translate-y-10 opacity-0">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-blue-500/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-blue-500 text-base">check_circle</span>
                                </div>
                                <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-blue-600 dark:text-blue-400">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <button onclick="selectAllRows(true)" id="selectAllBtn" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-blue-600 transition-colors border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-md bg-slate-50/50 dark:bg-slate-900/50">Select All</button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="bulkAction('activate')" class="h-8 px-4 bg-emerald-500 text-white rounded-md text-[10px] font-bold hover:bg-emerald-600 transition-all shadow-lg shadow-emerald-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">play_arrow</span> Activate
                            </button>
                            <button onclick="bulkAction('deactivate')" class="h-8 px-4 bg-amber-500 text-white rounded-md text-[10px] font-bold hover:bg-amber-600 transition-all shadow-lg shadow-amber-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">pause</span> Deactivate
                            </button>
                            <button onclick="bulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-md text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20 flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">delete</span> Delete
                            </button>
