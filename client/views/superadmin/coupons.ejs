    <script>
        const selectedCoupons = new Set();

        function toggleSelectRow(id) {
            const row = document.getElementById('row-' + id);
            const cb = document.getElementById('cb-' + id);
            if (selectedCoupons.has(id)) {
                selectedCoupons.delete(id);
                row.classList.remove('bg-blue-50/50', 'dark:bg-blue-500/10');
                if(cb) cb.checked = false;
            } else {
                selectedCoupons.add(id);
                row.classList.add('bg-blue-50/50', 'dark:bg-blue-500/10');
                if(cb) cb.checked = true;
            }
            updateBulkBarUI();
        }

        function toggleAllCoupons() {
            const headerCb = document.getElementById('selectAllCoupons');
            const isChecked = headerCb.checked;
            selectAllRows(isChecked);
        }

        function updateBulkBarUI() {
            const bar = document.getElementById('bulkBar');
            const headerCb = document.getElementById('selectAllCoupons');
            const totalOnPage = document.querySelectorAll('.coupon-checkbox').length;
            
            if (headerCb) {
                if (selectedCoupons.size === 0) {
                    headerCb.checked = false;
                    headerCb.indeterminate = false;
                } else if (selectedCoupons.size >= totalOnPage) {
                    headerCb.checked = true;
                    headerCb.indeterminate = false;
                } else {
                    headerCb.checked = false;
                    headerCb.indeterminate = true;
                }
            }
            
            if(selectedCoupons.size > 0) {
                bar.classList.remove('hidden');
                setTimeout(() => {
                    bar.classList.remove('translate-y-10', 'opacity-0');
                }, 10);
            } else {
                bar.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => {
                    bar.classList.add('hidden');
                }, 300);
            }
            document.getElementById('selectedCount').textContent = selectedCoupons.size;
        }

        function selectAllRows(force) {
            document.querySelectorAll('.coupon-checkbox').forEach(cb => {
                cb.checked = force;
            });
            document.querySelectorAll('tr[id^="row-"]').forEach(row => {
                const id = row.id.replace('row-', '');
                if (force) {
                    selectedCoupons.add(id);
                    row.classList.add('bg-blue-50/50', 'dark:bg-blue-500/10');
                } else {
                    selectedCoupons.delete(id);
                    row.classList.remove('bg-blue-50/50', 'dark:bg-blue-500/10');
                }
            });
            updateBulkBarUI();
        }

        function clearSelection() {
            selectAllRows(false);
            const headerCb = document.getElementById('selectAllCoupons');
            if(headerCb) headerCb.checked = false;
        }

        async function bulkAction(action) {
            const ids = Array.from(selectedCoupons);
            if (ids.length === 0) return;

            const msg = action === 'delete' ? `Delete ${ids.length} coupon(s)?` : `Perform ${action} on ${ids.length} coupon(s)?`;
            if (!confirm(msg)) return;

            try {
                const res = await fetch('/superadmin/coupons/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, ids })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert(data.error || 'Bulk action failed');
            } catch (err) {
                alert('Error performing bulk action');
            }
        }

        function openModal() { document.getElementById('create-modal').classList.remove('hidden'); }
        function closeModal() { document.getElementById('create-modal').classList.add('hidden'); }
        
        async function openEditModal(id) {
            try {
                const res = await fetch(`/superadmin/coupons/${id}/edit`);
                const coupon = await res.json();
                document.getElementById('edit-coupon-id').value = coupon._id;
                document.getElementById('edit-code').value = coupon.code;
                document.getElementById('edit-description').value = coupon.description || '';
                document.getElementById('edit-discountType').value = coupon.discountType;
                document.getElementById('edit-discountValue').value = coupon.discountValue;
                document.getElementById('edit-maxDiscount').value = coupon.maxDiscount || '';
                document.getElementById('edit-minPurchase').value = coupon.minOrderAmount || '';
                document.getElementById('edit-usageLimit').value = coupon.usageLimit || '';
                document.getElementById('edit-perUserLimit').value = coupon.perUserLimit || '';
                document.getElementById('edit-userType').value = coupon.userType || 'all';
                document.getElementById('edit-courseType').value = coupon.courseType || 'all';
                if (coupon.expiresAt) {
                    const d = new Date(coupon.expiresAt);
                    document.getElementById('edit-expiresAt').value = d.toISOString().slice(0, 16);
                }
                handleEditUserTypeChange();
                if (coupon.applicableClass) document.getElementById('edit-classSelect').value = coupon.applicableClass;
                document.getElementById('edit-modal').classList.remove('hidden');
            } catch (err) {
                alert('Error loading coupon');
            }
        }

        function closeEditModal() { document.getElementById('edit-modal').classList.add('hidden'); }

        function handleUserTypeChange() {
            const type = document.getElementById('userTypeSelect').value;
            document.getElementById('specificClassField').classList.toggle('hidden', type !== 'specific_class');
        }

        function handleEditUserTypeChange() {
            const type = document.getElementById('edit-userType').value;
            document.getElementById('edit-specificClassField').classList.toggle('hidden', type !== 'specific_class');
        }

        function handleCourseTypeChange() {
            const type = document.getElementById('courseTypeSelect').value;
            document.getElementById('specificCourseField').classList.toggle('hidden', type !== 'specific');
        }

        async function toggleCoupon(id, btn) {
            try {
                const res = await fetch(`/superadmin/coupons/${id}/toggle`, { method: 'POST' });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (err) { alert('Failed to toggle coupon'); }
        }

        async function deleteCoupon(id) {
            if (!confirm('Are you sure you want to delete this coupon?')) return;
            try {
                const res = await fetch(`/superadmin/coupons/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (err) { alert('Failed to delete coupon'); }
        }

        async function viewUsage(id, code) {
            try {
                const res = await fetch(`/superadmin/coupons/${id}/usage`);
                const data = await res.json();
                
                document.getElementById('usage-coupon-code').textContent = data.couponCode || code;
                document.getElementById('stat-total-uses').textContent = data.usedCount || 0;
                document.getElementById('stat-total-saved').textContent = `৳${(data.stats?.totalSaved || 0).toLocaleString('en-IN')}`;

                const container = document.getElementById('usage-list');
                container.innerHTML = '';

                if (data.usedBy && data.usedBy.length > 0) {
                    data.usedBy.forEach(u => {
                        const date = new Date(u.usedAt);
                        const initials = u.userName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                        
                        const div = document.createElement('div');
                        div.className = 'flex items-center gap-3 px-5 py-4 hover:bg-slate-50 dark:hover:bg-white/5 transition-colors group';
                        div.innerHTML = `
                            <div class="size-9 rounded-full bg-blue-500/10 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-[11px] font-black tracking-tighter border border-blue-500/20">
                                ${initials}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between mb-0.5">
                                    <p class="text-[11px] font-bold text-slate-700 dark:text-slate-200 truncate pr-2">${u.userName}</p>
                                    <p class="text-[9px] font-bold text-slate-400 group-hover:text-blue-500 transition-colors tracking-tight whitespace-nowrap">${getRelativeTime(date)}</p>
                                </div>
                                <div class="flex items-center justify-between">
                                    <p class="text-[9px] font-bold text-slate-400 truncate tracking-wide">${u.orderId || 'N/A'}</p>
                                    <p class="text-[10px] font-black text-emerald-600 dark:text-emerald-400">-৳${u.amount || 0}</p>
                                </div>
                            </div>
                        `;
                        container.appendChild(div);
                    });
                } else {
                    container.innerHTML = `
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400 opacity-60">
                            <span class="material-symbols-rounded text-4xl mb-2">history</span>
                            <p class="text-[10px] font-bold uppercase tracking-widest">No usage recorded</p>
                        </div>`;
                }
                document.getElementById('usage-modal').classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            } catch (err) { 
                console.error(err);
                alert('Error loading usage history'); 
            }
        }

        function getRelativeTime(date) {
            const now = new Date();
            const diffInSeconds = Math.floor((now - date) / 1000);
            if (diffInSeconds < 60) return 'Just now';
            const diffInMinutes = Math.floor(diffInSeconds / 60);
            if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
            const diffInHours = Math.floor(diffInMinutes / 60);
            if (diffInHours < 24) return `${diffInHours}h ago`;
            const diffInDays = Math.floor(diffInHours / 24);
            if (diffInDays < 7) return `${diffInDays}d ago`;
            return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
        }

        function closeUsageModal() { 
            document.getElementById('usage-modal').classList.add('hidden'); 
            document.body.classList.remove('overflow-hidden');
        }
        function exportCSV() { window.location.href = '/superadmin/coupons/export'; }

        document.addEventListener('DOMContentLoaded', function () {
            const alertMsg = document.getElementById('alert-msg');
            if (alertMsg) setTimeout(() => { alertMsg.style.display = 'none'; }, 3000);
            
            const chartData = <%- JSON.stringify(typeof redemptionChart !== 'undefined' ? redemptionChart : []) %>;
            const ctx = document.getElementById('redemptionChartCanvas');
            if (chartData && chartData.length > 0 && ctx) {
                const isDark = document.documentElement.classList.contains('dark');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: chartData.map(d => d.date),
                        datasets: [{
                            label: 'Uses',
                            data: chartData.map(d => d.total),
                            backgroundColor: '#8b5cf6',
                            borderRadius: 4,
                            barThickness: 6,
                            hoverBackgroundColor: '#7c3aed'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: isDark ? '#94a3b8' : '#64748b', font: { size: 9 }, maxRotation: 0 } },
                            y: { grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, ticks: { color: isDark ? '#94a3b8' : '#64748b', font: { size: 9 } } }
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>