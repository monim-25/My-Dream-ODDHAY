<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>System Settings | ODDHAY Command Center</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-sidebar {
                width: var(--admin-sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 100;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                min-height: 100vh;
                transition: all 0.3s ease;
            }

            .stat-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

            .dark .stat-card {
                background: #1e293b;
                border: 1px solid #334155;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }

                .admin-sidebar.active {
                    transform: translateX(0);
                }
            }
        </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen antialiased">

    <div class="flex">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'settings' }) %>
        </aside>

        <main class="admin-main flex-1 ml-[260px] bg-[#F8FAFC] dark:bg-[#020617] flex flex-col min-h-screen w-full">
            <%- include('header_v2', { pageTitle: 'System Settings' }) %>

                <section class="p-0.5 flex flex-col gap-0.5 w-full flex-1 border-l border-slate-900/10 dark:border-white/5">
                    <!-- Unified Stats Header (Matches History Style) -->
                    <!-- High-Density Stats Header (Question Bank Style) -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-1.5 p-1.5 bg-white dark:bg-slate-800/50 rounded-md border border-slate-200 dark:border-slate-700/50 relative">
                        <!-- Platform Status -->
                        <div class="<%= settings.isMaintenanceMode ? 'bg-amber-50/50 dark:bg-amber-500/10 border border-amber-100/30' : 'bg-emerald-50/50 dark:bg-emerald-500/10 border border-emerald-100/30' %> rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg <%= settings.isMaintenanceMode ? 'hover:shadow-amber-500/20' : 'hover:shadow-emerald-500/20' %>">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl <%= settings.isMaintenanceMode ? 'text-amber-500' : 'text-emerald-500' %> opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform"><%= settings.isMaintenanceMode ? 'construction' : 'verified_user' %></span>
                            <p class="text-[11px] font-bold <%= settings.isMaintenanceMode ? 'text-amber-600' : 'text-emerald-600' %> tracking-wider relative z-10">System State</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= settings.isMaintenanceMode ? 'Maintenance' : 'Live Mode' %></h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Platform Integrity</p>
                        </div>

                        <!-- Revenue -->
                        <div class="bg-blue-50/50 dark:bg-blue-500/10 border border-blue-100/30 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-blue-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-blue-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">payments</span>
                            <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400 tracking-wider relative z-10">Total Revenue</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight">
                                    <span class="text-sm text-blue-500/50 mr-0.5">&#2547;</span><%= (stats.revenue || 0).toLocaleString() %>
                                </h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Verified Earnings</p>
                        </div>

                        <!-- Staff -->
                        <div class="bg-indigo-50/50 dark:bg-indigo-500/10 border border-indigo-100/30 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-indigo-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">badge</span>
                            <p class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 tracking-wider relative z-10">Active Staff</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.staffCount %></h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Management Team</p>
                        </div>

                        <!-- Users -->
                        <div class="bg-slate-50 dark:bg-slate-500/10 border border-slate-200/50 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-500/20">
                            <span class="material-symbols-rounded absolute -right-2 -bottom-2 text-5xl text-slate-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">group</span>
                            <p class="text-[11px] font-bold text-slate-500 tracking-wider relative z-10">Total Users</p>
                            <div class="flex-1 flex items-center">
                                <h3 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= stats.allUsersCount %></h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Platform Reach</p>
                        </div>
                    </div>

                    <form action="/superadmin/settings" method="POST" class="flex flex-col gap-0">

                        <!-- Configuration Grid (Compact Command Center Style) -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 border-x border-slate-200 dark:border-slate-700/50 border-t border-slate-100 dark:border-slate-800/50">
                            
                            <!-- Financial Hub -->
                            <div class="p-4 bg-white dark:bg-[#0b1120]">
                                <div class="bg-white dark:bg-[#0b1120] rounded-lg border border-slate-200/60 dark:border-slate-700/50 p-4 flex flex-col gap-4 hover:shadow-md transition-all group shadow-sm">
                                    <div class="flex items-center gap-2 mb-1">
                                        <div class="size-2 rounded-sm bg-emerald-500 shadow-sm shadow-emerald-500/50"></div>
                                        <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight leading-none">Financial Hub</h3>
                                    </div>
                                    <div class="space-y-4">
                                        <% [['bkash', 'bKash Personal'], ['nagad', 'Nagad Personal'], ['rocket', 'Rocket Personal']].forEach(([id, name]) => { %>
                                            <div class="space-y-1.5">
                                                <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1"><%= name %></label>
                                                <input type="text" name="<%= id %>" value="<%= settings.paymentNumbers[id] %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>

                            <!-- Public Presence -->
                            <div class="p-4 bg-white dark:bg-[#0b1120] border-l border-slate-100 dark:border-slate-800/50">
                                <div class="bg-white dark:bg-[#0b1120] rounded-lg border border-slate-200/60 dark:border-slate-700/50 p-4 flex flex-col gap-4 hover:shadow-md transition-all group shadow-sm">
                                    <div class="flex items-center gap-2 mb-1">
                                        <div class="size-2 rounded-sm bg-blue-500 shadow-sm shadow-blue-500/50"></div>
                                        <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight leading-none">Public Presence</h3>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1">Hotline</label>
                                            <input type="text" name="phone" value="<%= settings.contactInfo.phone %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                        </div>
                                        <div class="space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1">WhatsApp</label>
                                            <input type="text" name="whatsapp" value="<%= settings.contactInfo.whatsapp %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                        </div>
                                        <div class="col-span-2 space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1">Admin Email</label>
                                            <input type="email" name="email" value="<%= settings.contactInfo.email %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                        </div>
                                        <div class="space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1">Facebook</label>
                                            <input type="url" name="facebook" value="<%= settings.socialLinks.facebook %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                        </div>
                                        <div class="space-y-1.5">
                                            <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 pl-1">YouTube</label>
                                            <input type="url" name="youtube" value="<%= settings.socialLinks.youtube %>" class="w-full h-10 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold px-3 focus:outline-none focus:border-blue-500 transition-all rounded-md">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Maintenance Protocol + Deploy (Unified Bottom) -->
                        <div class="bg-white dark:bg-[#0b1120] border-x border-slate-200 dark:border-slate-700/50 border-t border-slate-100 dark:border-slate-800/50 rounded-b-lg">
                            <div class="px-4 py-4 flex items-center justify-between border-b border-slate-50 dark:border-slate-700/30">
                                <div class="flex items-center gap-3">
                                    <div class="size-8 rounded-lg <%= settings.isMaintenanceMode ? 'bg-amber-100 text-amber-600' : 'bg-slate-100 text-slate-600' %> flex items-center justify-center border border-current opacity-70">
                                        <span class="material-symbols-rounded text-[18px]"><%= settings.isMaintenanceMode ? 'construction' : 'verified_user' %></span>
                                    </div>
                                    <div>
                                        <h3 class="text-[13px] font-bold text-slate-900 dark:text-white tracking-tight leading-tight">Maintenance Protocol</h3>
                                        <p class="text-[11px] font-medium text-slate-400">Restrict platform access to authorized personnel</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="isMaintenanceMode" class="sr-only peer" <%=settings.isMaintenanceMode ? 'checked' : '' %>>
                                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600 shadow-inner"></div>
                                </label>
                            </div>
                            <div class="p-4 bg-slate-50/20 dark:bg-slate-800/5 flex flex-col md:flex-row items-center justify-between gap-4">
                                <div>
                                    <h3 class="text-[13px] font-bold text-slate-900 dark:text-white flex items-center gap-1.5 tracking-tight leading-none">Confirm Platform Configurations</h3>
                                    <p class="text-[11px] text-slate-400 mt-1.5">Authorized changes are permanently logged</p>
                                </div>
                                <button type="submit" class="h-10 px-8 rounded-md bg-slate-950 dark:bg-white dark:text-slate-950 text-white font-bold text-[11px] hover:opacity-90 transition-all active:scale-[0.98]">
                                    Deploy Changes
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Factory Reset Protocol (Perfectly Designed Card) -->
                    <div class="bg-white dark:bg-[#0b1120] rounded-lg border border-slate-200 dark:border-slate-700/50 shadow-sm overflow-hidden">
                        <div class="bg-rose-50/50 dark:bg-rose-500/10 border-b border-rose-100/50 dark:border-rose-500/20 px-5 py-3 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="size-8 rounded-md bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-rose-600 dark:text-rose-400 text-[18px]">security</span>
                                </div>
                                <div>
                                    <h3 class="text-[13px] font-bold text-rose-700 dark:text-rose-400 tracking-tight leading-none">System Purge Protocol</h3>
                                    <p class="text-[10px] font-bold text-rose-500/60 mt-1">Authorized Factory Reset</p>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-rose-500 text-white shadow-sm">SUPERADMIN ONLY</span>
                        </div>
                        <div class="p-5 flex flex-col md:flex-row items-center justify-between gap-6">
                            <div class="flex items-start gap-4">
                                <div class="size-12 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-rose-500 text-[24px]">lock_reset</span>
                                </div>
                                <div>
                                    <h4 class="text-[14px] font-bold text-slate-900 dark:text-white leading-tight">Execute Factory Reset</h4>
                                    <p class="text-[12px] text-slate-400 mt-1.5 max-w-[400px]">This action permanently purges all activity logs, system notifications, and broadcast history. This process is irreversible.</p>
                                </div>
                            </div>
                            <button type="button" onclick="initiateSystemReset()"
                                class="shrink-0 h-10 px-8 rounded-md bg-rose-500 text-white font-bold text-[11px] hover:bg-rose-600 transition-all active:scale-[0.98] flex items-center gap-2 shadow-lg shadow-rose-500/30">
                                <span class="material-symbols-rounded text-[18px]">dangerous</span>
                                Execute Reset
                            </button>
                        </div>
                    </div>
                </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleAdminSidebar() {
            document.getElementById('adminSidebar').classList.toggle('active');
        }

        // Auto-hide alerts after 3 seconds
        document.addEventListener('DOMContentLoaded', function () {
            const alertMsg = document.getElementById('alert-msg');
            if (alertMsg) {
                setTimeout(function () {
                    alertMsg.style.transition = 'opacity 0.5s ease';
                    alertMsg.style.opacity = '0';
                    setTimeout(function () {
                        const container = document.getElementById('alert-container');
                        if (container) container.style.display = 'none';
                    }, 500);
                }, 3000);
            }
        });

        async function initiateSystemReset() {
            // Step 1: Intent confirmation
            const step1 = await Swal.fire({
                title: 'Factory Reset Protocol',
                html: `
                    <div style="text-align:left">
                        <div style="display:flex;align-items:center;gap:12px;padding:12px;background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;margin-bottom:16px">
                            <span class="material-symbols-rounded" style="color:#f43f5e;font-size:24px">warning</span>
                            <div>
                                <p style="font-size:12px;font-weight:700;color:#be123c;margin:0 0 2px">This action is irreversible</p>
                                <p style="font-size:11px;color:#f43f5e;margin:0">All system logs and broadcast history will be permanently deleted</p>
                            </div>
                        </div>
                        <p style="font-size:12px;color:#64748b">To proceed, you must verify your superadmin identity in the next step.</p>
                    </div>
                `,
                icon: null,
                showCancelButton: true,
                confirmButtonText: 'Continue to Verification',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b',
                width: '480px'
            });

            if (!step1.isConfirmed) return;

            // Step 2: Password verification
            const step2 = await Swal.fire({
                title: 'Identity Verification',
                html: `
                    <div style="text-align:left">
                        <p style="font-size:12px;color:#64748b;margin:0 0 16px">Enter your superadmin password to authorize this critical operation.</p>
                        <label style="font-size:11px;font-weight:700;color:#64748b;display:block;margin-bottom:6px">Superadmin Password</label>
                        <input id="swal-reset-password" type="password" placeholder="Enter your password"
                            class="swal2-input" style="width:100%;height:44px;margin:0;font-size:13px;border-radius:8px;padding:0 12px;border:2px solid #e2e8f0;box-sizing:border-box">
                    </div>
                `,
                icon: null,
                showCancelButton: true,
                confirmButtonText: 'Verify & Execute',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b',
                width: '420px',
                didOpen: () => document.getElementById('swal-reset-password').focus(),
                preConfirm: () => {
                    const pw = document.getElementById('swal-reset-password').value;
                    if (!pw || pw.trim() === '') {
                        Swal.showValidationMessage('Password is required');
                        return false;
                    }
                    return pw;
                }
            });

            if (!step2.isConfirmed) return;

            const enteredPassword = step2.value;

            // Step 3: Verify password via API
            Swal.fire({
                title: 'Verifying Identity...',
                allowOutsideClick: false,
                showConfirmButton: false,
                background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b',
                didOpen: () => Swal.showLoading()
            });

            try {
                const verifyRes = await fetch('/superadmin/verify-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ password: enteredPassword })
                });
                const verifyData = await verifyRes.json();

                if (!verifyData.verified) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Verification Failed',
                        text: 'Incorrect password. Access denied.',
                        confirmButtonColor: '#e11d48',
                        background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                        color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b'
                    });
                    return;
                }

                // Step 4: Execute the reset
                Swal.fire({
                    title: 'Executing System Reset...',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                    color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b',
                    didOpen: () => Swal.showLoading()
                });

                const resetRes = await fetch('/superadmin/system-reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ verifiedPassword: enteredPassword })
                });
                const resetData = await resetRes.json();

                if (resetData.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'System Reset Complete',
                        text: `${resetData.count || 0} logs have been permanently purged.`,
                        confirmButtonColor: '#10b981',
                        background: document.documentElement.classList.contains('dark') ? '#1e293b' : '#fff',
                        color: document.documentElement.classList.contains('dark') ? '#fff' : '#1e293b'
                    });
                    window.location.href = '/superadmin/settings';
                } else {
                    Swal.fire({ icon: 'error', title: 'Reset Failed', text: resetData.error || 'Unknown error' });
                }
            } catch (err) {
                console.error('Frontend Fetch Error:', err);
                Swal.fire({ icon: 'error', title: 'Connection Failed', text: 'Could not contact the server. Check logs.' });
            }
        }
    </script>
</body>
</html>