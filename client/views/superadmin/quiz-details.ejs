<!DOCTYPE html>
<html lang="bn">
<head>
    <%- include('../partials/head') %>
    <title>Exam Cockpit | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; background: #F8FAFC; }
        .dark .content-scroll { background: #0b1120; }
        .cockpit-card { position: relative; width: 100%; margin-bottom: 0.125rem; }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'quizzes' }) %>
        </aside>

        <main class="admin-main flex-1 flex flex-col h-screen overflow-hidden">
            <%- include('header_v2', { pageTitle: 'Exam Cockpit' }) %>

            <div class="content-scroll">
                <div class="max-w-6xl mx-auto flex flex-col">
                    
                    <!-- 1. Unified Command Section (Header + Hub) -->
                    <div class="cockpit-card bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden z-10">
                        <!-- Header Part -->
                        <div class="p-5 border-b border-slate-50 dark:border-white/5 flex justify-between items-center">
                            <div class="flex flex-col gap-2">
                                <div class="flex items-center gap-3">
                                    <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight leading-none"><%= quiz.title %></h1>
                                    <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-500/10 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-500/20"><%= quiz.accessType %></span>
                                </div>
                                <div class="flex items-center gap-4 text-[12px] font-bold text-slate-400">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-[18px]">school</span>
                                        <span><%= quiz.classLevel || (quiz.course ? quiz.course.classLevel : 'N/A') %></span>
                                    </div>
                                    <div class="size-1 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-[18px]">book</span>
                                        <span><%= quiz.subject || (quiz.course ? quiz.course.subject : 'Common') %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Author Part -->
                            <div class="flex items-center gap-4 pl-6 border-l border-slate-100 dark:border-white/5">
                                <div class="flex flex-col items-end">
                                    <span class="text-[14px] font-black text-slate-800 dark:text-white leading-none"><%= quiz.addedBy?.name || 'Monim Islam' %></span>
                                    <span class="text-[10px] font-bold text-slate-400 mt-1">Author</span>
                                </div>
                                <div class="size-11 rounded-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden flex items-center justify-center">
                                    <% if (quiz.addedBy?.profilePicture) { %>
                                        <img src="<%= quiz.addedBy.profilePicture %>" class="size-full object-cover">
                                    <% } else { %>
                                        <span class="material-symbols-rounded text-xl text-slate-400">person</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Hub Part (Analytics) -->
                        <div class="p-5 bg-slate-50/20 dark:bg-slate-800/10 flex items-center gap-12">
                            <!-- Donut Ring -->
                            <div class="relative size-24 flex-shrink-0">
                                <svg class="size-full" viewBox="0 0 100 100" style="transform: rotate(-90deg);">
                                    <circle cx="50" cy="50" r="42" fill="transparent" stroke="#e2e8f0" stroke-width="8" class="dark:stroke-slate-700"></circle>
                                    <circle cx="50" cy="50" r="42" fill="transparent" stroke="#137fec" stroke-width="8" stroke-dasharray="180 263.8" stroke-linecap="round"></circle>
                                </svg>
                                <div class="absolute inset-0 flex flex-col items-center justify-center">
                                    <h3 class="text-xl font-black text-slate-800 dark:text-white leading-none"><%= quiz.questions.length || 0 %></h3>
                                    <p class="text-[8px] font-bold text-slate-400 mt-0.5">Items</p>
                                </div>
                            </div>

                            <!-- Stats List -->
                            <div class="flex-1 grid grid-cols-1 gap-y-2">
                                <div class="flex items-center gap-3">
                                    <div class="size-2 rounded-full bg-indigo-500 shadow-sm"></div>
                                    <div class="flex items-baseline gap-2">
                                        <p class="text-[10px] font-bold text-slate-400">Timing:</p>
                                        <h3 class="text-[14px] font-black text-slate-700 dark:text-white leading-none"><%= quiz.duration || 10 %> <span class="text-[10px] font-bold text-slate-400">min</span></h3>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-2 rounded-full bg-emerald-500 shadow-sm"></div>
                                    <div class="flex items-baseline gap-2">
                                        <p class="text-[10px] font-bold text-slate-400">Marks:</p>
                                        <h3 class="text-[14px] font-black text-slate-700 dark:text-white leading-none"><%= (quiz.questions.length || 0) * 5 %></h3>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-2 rounded-full bg-amber-500 shadow-sm"></div>
                                    <div class="flex items-baseline gap-2">
                                        <p class="text-[10px] font-bold text-slate-400">Type:</p>
                                        <h3 class="text-[14px] font-black text-slate-700 dark:text-white leading-none">MCQ</h3>
                                    </div>
                                </div>
                            </div>

                            <!-- Engagement Bars -->
                            <div class="w-[350px] border-l border-slate-100 dark:border-white/5 pl-8 flex flex-col gap-3">
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[9px] font-bold text-slate-400">Attendees</p>
                                        <p class="text-[11px] font-black text-indigo-500"><%= engagement?.attendees || 42 %></p>
                                    </div>
                                    <div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-sm overflow-hidden">
                                        <div class="h-full bg-indigo-500 transition-all duration-1000" style="width: 55%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[9px] font-bold text-slate-400">Avg. Time</p>
                                        <p class="text-[11px] font-black text-cyan-500"><%= engagement?.avgTimeUsed || 12 %>m</p>
                                    </div>
                                    <div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-sm overflow-hidden">
                                        <div class="h-full bg-cyan-500 transition-all duration-1000" style="width: 75%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[9px] font-bold text-slate-400">Popularity</p>
                                        <p class="text-[11px] font-black text-rose-500">92%</p>
                                    </div>
                                    <div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-sm overflow-hidden">
                                        <div class="h-full bg-rose-500 transition-all duration-1000" style="width: 92%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Questions Section -->
                    <div class="cockpit-card bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                        <div class="px-5 py-2 border-b border-slate-100 dark:border-white/5 bg-slate-50/20 dark:bg-slate-800/20 flex items-center gap-2">
                            <span class="material-symbols-rounded text-slate-400 text-[16px]">quiz</span>
                            <h3 class="text-[12px] font-black text-slate-800 dark:text-white uppercase tracking-wider">Questions</h3>
                        </div>
                        
                        <div class="divide-y divide-slate-100 dark:divide-white/5">
                            <% quiz.questions.forEach((q, index) => { %>
                                <div class="p-6 hover:bg-slate-50/10 dark:hover:bg-slate-800/5 transition-colors">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="flex items-center gap-3">
                                            <span class="text-[12px] font-black text-slate-400">Q<%= index + 1 %></span>
                                            <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-500/10 text-[8px] font-bold text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-500/20">MCQ</span>
                                        </div>
                                        <div class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                                            <span class="material-symbols-rounded text-[16px]">verified</span>
                                            <span class="text-[10px] font-bold">5 Marks</span>
                                        </div>
                                    </div>
                                    <h3 class="text-base font-bold text-slate-800 dark:text-white mb-4 leading-relaxed"><%= q.questionText %></h3>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                        <% q.options.forEach((opt, optIndex) => { %>
                                            <div class="flex items-center gap-3 p-3 rounded-lg border <%= optIndex === q.correctAnswerIndex ? 'border-emerald-200 bg-emerald-50/50 dark:bg-emerald-500/5' : 'border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900' %> transition-all">
                                                <div class="size-5 rounded-full border-2 <%= optIndex === q.correctAnswerIndex ? 'border-emerald-500 bg-emerald-500' : 'border-slate-200 dark:border-slate-700' %> flex items-center justify-center text-[9px] font-black <%= optIndex === q.correctAnswerIndex ? 'text-white' : 'text-slate-400' %>">
                                                    <%= String.fromCharCode(65 + optIndex) %>
                                                </div>
                                                <span class="text-[13px] font-bold <%= optIndex === q.correctAnswerIndex ? 'text-emerald-800 dark:text-emerald-400' : 'text-slate-700 dark:text-slate-400' %>"><%= opt %></span>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
