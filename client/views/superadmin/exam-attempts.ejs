<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Exam Attempts | ODDHAY Command Center</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                overflow-y: auto;
                padding: 0;
                position: relative;
            }

            @keyframes slide-up {
                from {
                    transform: translateY(100%);
                    opacity: 0;
                }

                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            .animate-slide-up {
                animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            @media (max-width: 1024px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0;
                }
            }
        </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'exam-attempts' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Student Exam History' }) %>

                <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                    <!-- Stats Grid -->
                    <div
                        class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                        <!-- Total Students -->
                        <div
                            class="bg-blue-50/50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-blue-500/20 cursor-pointer">
                            <span
                                class="material-symbols-rounded absolute -right-2 -bottom-2 text-6xl text-blue-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">school</span>
                            <p
                                class="text-[11px] font-bold text-blue-600 dark:text-blue-400 tracking-wider relative z-10">
                                Students</p>
                            <div class="flex-1 flex items-center">
                                <h3
                                    class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight">
                                    <%= stats.totalStudents %>
                                </h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Took Exams</p>
                        </div>

                        <!-- Model Tests -->
                        <div onclick="window.location.href='?type=model'"
                            class="bg-emerald-50/50 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-500/20 cursor-pointer">
                            <span
                                class="material-symbols-rounded absolute -right-2 -bottom-2 text-6xl text-emerald-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">quiz</span>
                            <p
                                class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 tracking-wider relative z-10">
                                Model Tests</p>
                            <div class="flex-1 flex items-center">
                                <h3
                                    class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight">
                                    <%= stats.modelTestAttempts %>
                                </h3>
                            </div>
                            <p class="text-[9px] text-slate-400 font-bold relative z-10">Attempts by Students</p>
                        </div>

                        <!-- Course Exam -->
                        <div onclick="window.location.href='?type=course'"
                            class="bg-amber-50/50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/20 cursor-pointer">
                            <span
                                class="material-symbols-rounded absolute -right-2 -bottom-2 text-6xl text-amber-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">menu_book</span>
                            <p
                                class="text-[11px] font-bold text-amber-600 dark:text-amber-400 tracking-wider relative z-10">
                                Course Exam</p>
                            <div class="flex-1 flex items-center">
                                <h3
                                    class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight">
                                    <%= stats.courseExamAttempts %>
                                </h3>
                            </div>
                             <p class="text-[9px] text-slate-400 font-bold relative z-10">Attempts by Students</p>
                         </div>

                         <!-- Manual Attempts -->
                         <div onclick="window.location.href='?type=manual'"
                             class="bg-green-50/50 dark:bg-green-500/10 border border-green-100 dark:border-green-500/20 rounded-md p-3 flex flex-col group h-[90px] relative overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-green-500/20 cursor-pointer">
                             <span
                                 class="material-symbols-rounded absolute -right-2 -bottom-2 text-6xl text-green-500 opacity-10 group-hover:scale-110 group-hover:rotate-12 transition-transform">question_mark</span>
                             <p
                                 class="text-[11px] font-bold text-green-600 dark:text-green-400 tracking-wider relative z-10">
                                 Manual</p>
                             <div class="flex-1 flex items-center">
                             <h3
                                 class="text-xl font-black text-slate-900 dark:text-white leading-none relative z-10 tracking-tight">
                                 <%= stats.manualAttempts %>
                             </h3>
                             </div>
                             <p class="text-[9px] text-slate-400 font-bold relative z-10">Manual Exam</p>
                         </div>


                    </div>

                    <!-- Main Table Container -->
                    <div
                        class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                        <div
                            class="sticky top-[-0.5rem] z-30 bg-white dark:bg-slate-800 px-3 py-2 border-b border-slate-50 dark:border-slate-700/50 flex flex-wrap items-center justify-between gap-3 shadow-sm rounded-t-md">
                            <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                                <form action="" method="GET" class="relative flex-1 max-w-[400px] flex items-center">
                                    <input type="text" name="q" value="<%= filters.q %>" placeholder="Search by student or exam..."
                                        class="w-full pl-3 pr-10 h-10 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                    <input type="hidden" name="type" value="<%= filters.type %>">
                                    <input type="hidden" name="class" value="<%= filters.class %>">
                                    <input type="hidden" name="access" value="<%= filters.access %>">
                                </form>
                                <div class="relative w-[100px]">
                                    <select onchange="window.location.href='?q=<%= filters.q %>&class=<%= filters.class %>&access=<%= filters.access %>&type=' + this.value"
                                        class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                            <option value="all" <%= (filters.type === 'all' || !filters.type) ? 'selected' : '' %>>All Types</option>
                                            <option value="model" <%= filters.type === 'model' ? 'selected' : '' %>>Model Test</option>
                                            <option value="manual" <%= filters.type === 'manual' ? 'selected' : '' %>>Manual</option>
                                            <option value="course" <%= filters.type === 'course' ? 'selected' : '' %>>Course</option>
                                    </select>
                                    <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                                </div>
                                <div class="relative w-[100px]">
                                    <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&access=<%= filters.access %>&class=' + this.value"
                                        class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                        <option value="all" <%= (filters.class === 'all' || !filters.class) ? 'selected' : '' %>>All Class</option>
                                        <% (globalAcademicClasses || []).forEach(cls => { 
                                        let val = cls.name.replace('Class ', '');
                                    %>
                                        <option value="<%= val %>" <%= typeof filters !== 'undefined' && filters.class === val ? 'selected' : '' %>><%= cls.name %></option>
                                    <% }) %>
                                    </select>
                                    <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                                </div>
                                <div class="relative w-[100px]">
                                    <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&access=<%= filters.access %>&subject=' + this.value"
                                        class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                        <option value="all" <%= filters.subject === 'all' ? 'selected' : '' %>>All Subjects</option>
                                        <% (subjects || []).forEach(sub => { %>
                                            <option value="<%= sub %>" <%= filters.subject === sub ? 'selected' : '' %>><%= sub %></option>
                                        <% }) %>
                                    </select>
                                    <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                                </div>
                                <div class="relative w-[100px]">
                                    <select onchange="window.location.href='?q=<%= filters.q %>&type=<%= filters.type %>&class=<%= filters.class %>&subject=<%= filters.subject %>&access=' + this.value"
                                        class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                        <option value="all" <%= filters.access === 'all' ? 'selected' : '' %>>All Access</option>
                                        <option value="Free" <%= filters.access === 'Free' ? 'selected' : '' %>>Free</option>
                                        <option value="Paid" <%= filters.access === 'Paid' ? 'selected' : '' %>>Paid</option>
                                    </select>
                                    <span class="material-symbols-rounded absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                                </div>
                                <div
                                    class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all">
                                    <span class="text-[11px] font-bold text-primary">
                                        Found <span><%= filters.totalAttempts %></span> Matches
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 ml-auto">
                                <button onclick="exportAttemptsToCSV()" class="h-10 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-sm">download</span> Export
                                </button>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="table-wrapper">
                            <table class="w-full text-left border-collapse">
                                <thead
                                    class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                    <tr>
                                        <th class="pl-3 pr-1 py-2 text-[10px] font-bold text-slate-500 tracking-wider">
                                            Student</th>
                                        <th class="pl-3 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">
                                            Class</th>
                                        <th class="pl-3 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">
                                            Exam Name</th>
                                        <th class="pl-3 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">
                                            Type</th>
                                        <th class="pl-3 pr-3 py-2 text-[10px] font-bold text-slate-500 tracking-wider">
                                            Subject</th>
                                        <th class="pl-3 pr-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">
                                            Access</th>
                                        <th
                                            class="px-3 py-2 text-center text-[10px] font-bold text-slate-500 tracking-wider">
                                            Score</th>
                                        <th
                                            class="pr-4 py-2 text-right text-[10px] font-bold text-slate-500 tracking-wider">
                                            Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                    <% if(attempts.length===0) { %>
                                        <tr>
                                            <td colspan="7" class="px-3 py-8 text-center text-slate-400 text-[12px]">No
                                                exam attempts found</td>
                                        </tr>
                                        <% } %>
                                            <% attempts.forEach(attempt=> { %>
                                                <tr
                                                    class="hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all">
                                                    <td class="pl-3 pr-1 py-2">
                                                        <div class="flex flex-col">
                                                            <p
                                                                class="text-[11px] font-bold text-slate-900 dark:text-white">
                                                                <%= attempt.studentName %>
                                                            </p>
                                                            <p class="text-[9px] text-slate-400">
                                                                <%= attempt.studentEmail %>
                                                            </p>
                                                        </div>
                                                    </td>
                                                    <td class="pl-3 pr-3 py-2">
                                                        <p
                                                            class="text-[11px] font-bold text-slate-600 dark:text-slate-400">
                                                            <%= attempt.studentClass || '---' %>
                                                        </p>
                                                    </td>
                                                    <td class="pl-3 pr-3 py-2">
                                                        <p
                                                            class="text-[11px] font-bold text-slate-900 dark:text-white truncate max-w-[150px]">
                                                            <%= attempt.quizTitle %>
                                                        </p>
                                                    </td>
                                                    <td class="pl-3 pr-3 py-2">
                                                        <span
                                                            class="text-[10px] font-bold <%= attempt.quizCourse ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400' %>">
                                                            <%= attempt.quizCourse ? 'Course' : 'Model test' %>
                                                        </span>
                                                    </td>
                                                    <td class="pl-3 pr-3 py-2">
                                                        <p class="text-[11px] text-slate-600 dark:text-slate-400">
                                                            <%= attempt.quizSubject %>
                                                        </p>
                                                    </td>
                                                    <td class="pl-3 pr-3 py-2 text-center">
                                                        <% if(attempt.quizAccess === 'Paid') { %>
                                                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[9px] font-bold border border-rose-100 dark:border-rose-500/20"><span class="material-symbols-rounded text-[12px]">lock</span> Paid</span>
                                                        <% } else { %>
                                                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20"><span class="material-symbols-rounded text-[12px]">lock_open</span> Free</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="px-3 py-2 text-center">
                                                        <span
                                                            class="inline-flex items-center justify-center px-2 py-1 rounded-md text-[11px] font-bold <%= attempt.percentage >= 50 ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/20' : 'bg-rose-50 text-rose-600 dark:bg-rose-500/20' %>">
                                                            <%= attempt.score %>/<%= attempt.total %> (<%=
                                                                        attempt.percentage %>%)
                                                        </span>
                                                    </td>
                                                    <td class="pr-4 py-2 text-right">
                                                        <p class="text-[10px] text-slate-500">
                                                            <%= new Date(attempt.date).toLocaleDateString() %>
                                                        </p>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
        </main>
    </div>


    <script>
        function exportAttemptsToCSV() {
            const rows = [['Student', 'Email', 'Class', 'Exam Name', 'Type', 'Subject', 'Access', 'Score', 'Percentage', 'Date']];
            <% attempts.forEach(a => { %>
                rows.push([
                    '<%= a.studentName %>',
                    '<%= a.studentEmail %>',
                    '<%= a.studentClass || '---' %>',
                    '<%= a.quizTitle %>',
                    '<%= a.quizCourse ? 'Course' : 'Model test' %>',
                    '<%= a.quizSubject %>',
                    '<%= a.quizAccess %>',
                    '<%= a.score %>/<%= a.total %>',
                    '<%= a.percentage %>%',
                    '<%= new Date(a.date).toLocaleDateString() %>'
                ]);
            <% }) %>
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "exam_attempts_export.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>

</html>