<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Video Hub | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow: auto; padding: 0; position: relative; }
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-slide-up { animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .table-wrapper { flex: 1; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'classes' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header_v2', { pageTitle: 'Video Lesson Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 overflow-auto border-l border-slate-200 dark:border-white/5">
                <div class="min-w-[1300px] flex flex-col gap-0">
                    <!-- Lesson Stats -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-5 gap-2">
                    <div onclick="filterByAccess('all')" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-blue-500 opacity-[0.05]">movie</span>
                        <div class="flex items-center gap-1 relative z-10">
                            <span class="material-symbols-rounded text-[14px] text-blue-500">movie</span>
                            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Inventory</p>
                        </div>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= hubStats.totalVideos %></h3></div>
                    </div>
                    <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                        <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-emerald-500 opacity-[0.05]">timelapse</span>
                        <div class="flex items-center gap-1 relative z-10">
                            <span class="material-symbols-rounded text-[14px] text-emerald-500">timelapse</span>
                            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Learning Time</p>
                        </div>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= (hubStats.totalDuration / 60).toFixed(1) %>h</h3></div>
                    </div>
                    <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20">
                        <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-orange-500 opacity-[0.05]">trending_up</span>
                        <div class="flex items-center gap-1 relative z-10">
                            <span class="material-symbols-rounded text-[14px] text-orange-500">trending_up</span>
                            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Total Views</p>
                        </div>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= hubStats.totalViews || 0 %></h3></div>
                    </div>
                    <div onclick="filterByAccess('free')" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-amber-500 opacity-[0.05]">lock_open</span>
                        <div class="flex items-center gap-1 relative z-10">
                            <span class="material-symbols-rounded text-[14px] text-amber-500">lock_open</span>
                            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Free Access</p>
                        </div>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= hubStats.freeCount %></h3></div>
                    </div>
                    <div onclick="filterByAccess('paid')" class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 rounded-xl p-3 flex flex-col group h-[80px] relative overflow-hidden transition-all hover:bg-white dark:hover:bg-slate-800/50 hover:shadow-md hover:border-primary/20 cursor-pointer">
                        <span class="material-symbols-rounded absolute -right-3 -bottom-3 text-5xl text-violet-500 opacity-[0.05]">workspace_premium</span>
                        <div class="flex items-center gap-1 relative z-10">
                            <span class="material-symbols-rounded text-[14px] text-violet-500">workspace_premium</span>
                            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 tracking-tight">Premium Content</p>
                        </div>
                        <div class="flex-1 flex items-center"><h3 class="text-xl font-bold text-slate-900 dark:text-white leading-none relative z-10 tracking-tight"><%= hubStats.premiumCount %></h3></div>
                    </div>
                </div>

                <% if (typeof filterTeacher !== 'undefined' && filterTeacher) { %>
                <!-- Teacher Filter Banner -->
                <div class="mt-0.5 px-4 py-2.5 bg-primary/5 border border-primary/20 rounded-md flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary text-base">person</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500">Filtering Classes by Instructor</p>
                            <p class="text-xs font-black text-slate-900 dark:text-white"><%= filterTeacher.name %></p>
                        </div>
                        <% if (filterTeacher.teachingSubject) { %>
                            <span class="px-2 py-0.5 rounded-md bg-fuchsia-50 dark:bg-fuchsia-500/10 border border-fuchsia-200 dark:border-fuchsia-500/20 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-semibold"><%= filterTeacher.teachingSubject %></span>
                        <% } %>
                    </div>
                    <a href="/superadmin/video-classes" class="h-7 px-3 text-[10px] font-bold rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:text-primary transition-all flex items-center gap-1">
                        <span class="material-symbols-rounded text-[13px]">close</span> Clear Filter
                    </a>
                </div>
                <% } %>

                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-sm mb-10">
                    <!-- Filters Bar -->
                    <div class="sticky top-[-0.5rem] z-30 bg-white dark:bg-slate-800 px-3 py-2 border-b border-slate-50 dark:border-slate-700/50 flex flex-wrap items-center justify-between gap-3 shadow-sm rounded-t-md">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <form action="/superadmin/video-classes" method="GET" class="relative flex-1 max-w-[400px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search archive..." class="w-full pl-3 pr-10 h-10 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-bold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                <input type="hidden" name="courseId" value="<%= filters.courseId %>">
                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="access" value="<%= filters.access %>">
                                <% if (filters.instructor) { %><input type="hidden" name="instructor" value="<%= filters.instructor %>"><% } %>
                            </form>
                            
                            <div class="relative w-[110px]">
                                <select onchange="window.location.href='/superadmin/video-classes?courseId=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all">All Courses</option>
                                    <% (courses || []).filter(c => c.chapters && c.chapters.length > 0).forEach(c => { %>
                                        <option value="<%= c._id %>" <%= filters.courseId == c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='/superadmin/video-classes?subject=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all">All Subjects</option>
                                    <% (subjects || []).forEach(s => { %>
                                        <option value="<%= s %>" <%= filters.subject === s ? 'selected' : '' %>><%= s %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="relative w-[100px]">
                                <select onchange="window.location.href='/superadmin/video-classes?class=' + this.value" class="w-full h-10 pl-3 pr-7 rounded-lg bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-bold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all">All Classes</option>
                                    <% [6,7,8,9,10,11,12].forEach(c => { %>
                                        <option value="<%= c %>" <%= filters.class == c ? 'selected' : '' %>>Class <%= c %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-lg flex items-center transition-all"><span class="text-[11px] font-bold text-primary">Found <span><%= filters.totalMatching %></span> Matches</span></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportClassesToCSV()" class="h-10 px-4 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                            <button onclick="document.getElementById('addClassModal').classList.remove('hidden')" class="h-10 px-4 rounded-lg bg-primary text-white font-bold text-[10px] shadow-lg shadow-primary/20 flex items-center gap-2 hover:bg-blue-600 transition-all">
                                <span class="material-symbols-rounded text-sm">add</span> New Lesson
                            </button>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="w-max text-left border-collapse">
                            <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-2 text-[10px] font-bold text-slate-500">Lesson intelligence</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-left">Subject</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-center">Class</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-left">Course relation</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-left">Instructor</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-center">Metrics</th>
                                    <th class="px-4 py-2 text-[10px] font-bold text-slate-500 text-center">Access</th>
                                    <th class="pr-4 py-2 text-[10px] font-bold text-slate-500 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% classes.forEach(item => { %>
                                    <tr class="class-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" ondblclick="toggleRowSelection('<%= item._id %>')">
                                        <td class="pl-4 pr-1 py-3" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= item._id %>" id="cb-<%= item._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-3">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg overflow-hidden bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-100 dark:border-blue-500/20 shadow-sm transition-transform hover:scale-105">
                                                    <% if (item.thumbnail) { %>
                                                        <img src="<%= item.thumbnail %>" class="size-full object-cover">
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-lg">play_circle</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex flex-col">
                                                    <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight truncate max-w-[200px]" title="<%= item.title %>"><%= item.title %></p>
                                                    <p class="text-[9px] font-bold text-slate-400 mt-0.5"><%= item._id.toString().slice(-8) %> • <%= item.duration || '0:00' %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2">
                                            <span class="px-2 py-0.5 rounded-md bg-slate-50 dark:bg-slate-900 text-slate-500 text-[9px] font-bold border border-slate-100 dark:border-slate-800">
                                                <%= item.subject || 'N/A' %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <span class="text-[10px] font-bold text-slate-500">Class <%= item.classLevel %></span>
                                        </td>
                                        <td class="px-4 py-2 text-[10px] font-bold text-primary">
                                            <p class="truncate max-w-[150px]"><%= item.courseTitle %></p>
                                            <p class="text-[8px] text-slate-400 mt-0.5"><%= item.chapterTitle %></p>
                                        </td>
                                        <td class="px-4 py-2">
                                            <div class="flex items-center gap-2">
                                                <div class="size-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center flex-shrink-0">
                                                    <img src="/images/default-avatar.png" class="size-full object-cover">
                                                </div>
                                                <span class="text-[10px] font-bold text-slate-400 truncate max-w-[80px]"><%= item.instructor || 'System' %></span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <div class="flex flex-col items-center">
                                                <span class="text-[11px] font-black text-slate-700 dark:text-slate-300"><%= item.views || 0 %></span>
                                                <span class="text-[8px] font-bold text-slate-400 tracking-tighter">Views</span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <% if (item.accessType === 'free') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20">Paid</span>
                                            <% } %>
                                        </td>
                                        <td class="pr-4 py-3">
                                            <div class="flex items-center justify-end gap-1">
                                                <% if (item.videoPath) { %>
                                                    <button onclick="previewVideo('<%= item.videoPath %>', '<%= item.title %>', '<%= item.subject %>', '<%= item.classLevel %>', '<%= item.instructor %>')" class="size-7 rounded bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm">
                                                        <span class="material-symbols-rounded text-sm">visibility</span>
                                                    </button>
                                                <% } %>
                                                <button onclick="deleteLesson('<%= item._id %>')" class="size-7 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm">
                                                    <span class="material-symbols-rounded text-sm">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= filters.q %>&courseId=<%= filters.courseId %>&subject=<%= filters.subject %>&class=<%= filters.class %>&access=<%= filters.access %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                </div>

                <!-- Bulk Action Bar -->
                <div id="bulkActions" class="hidden sticky bottom-4 bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-3 flex items-center justify-center gap-12 z-50 animate-slide-up border border-slate-200 dark:border-slate-700 max-w-[750px] mx-auto rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50">
                    <div class="flex items-center gap-6">
                        <div class="flex items-center gap-2">
                            <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center shadow-lg shadow-primary/10">
                                <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                            </div>
                            <span class="text-[11px] font-bold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span> Items</span>
                        </div>
                        <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                        <button onclick="selectAllRows(true)" id="selectAllBtn" class="text-[9px] font-bold tracking-widest text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select All</button>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="handleBulkAction('delete')" class="h-8 px-4 bg-rose-500 text-white rounded-lg text-[10px] font-bold hover:bg-rose-600 transition-all shadow-lg shadow-rose-500/20">Delete</button>
                        <button onclick="clearSelection()" class="h-8 px-4 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Add Video Modal -->
    <div id="addClassModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xl z-[250] hidden flex items-center justify-center p-6">
        <div class="bg-white dark:bg-[#0f172a] rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl border border-white/10 relative">
            <button onclick="document.getElementById('addClassModal').classList.add('hidden')" class="absolute top-6 right-6 size-10 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all z-10"><span class="material-symbols-rounded">close</span></button>
            <div class="p-10">
                <h3 class="text-2xl font-black mb-8">Deploy Video Asset</h3>
                <form action="/superadmin/add-class" method="POST" class="space-y-5">
                    <div class="grid grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Asset title</label>
                            <input type="text" name="title" required placeholder="e.g Physics Lecture 01" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Video link</label>
                            <input type="url" name="videoPath" required placeholder="YouTube or Drive link" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Chapter</label>
                            <select name="chapterId" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none cursor-pointer">
                                <% (courses || []).forEach(course => { %>
                                    <optgroup label="<%= course.title %>">
                                        <% (course.chapters || []).forEach(chap => { %>
                                            <option value="<%= chap._id %>"><%= chap.title %></option>
                                        <% }) %>
                                    </optgroup>
                                <% }) %>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Duration</label>
                            <div class="relative">
                                <input type="text" name="duration" id="syncDuration" placeholder="e.g 45:30" class="w-full h-11 pl-4 pr-12 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                                <button type="button" onclick="syncVideoDuration()" class="absolute right-2 top-1/2 -translate-y-1/2 size-7 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white transition-all flex items-center justify-center">
                                    <span class="material-symbols-rounded text-sm">sync</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Instructor</label>
                            <input type="text" name="instructor" value="<%= user.name %>" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-bold text-slate-400 ml-1">Access protocol</label>
                            <select name="accessType" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm font-bold focus:border-primary outline-none cursor-pointer">
                                <option value="free">Free Access</option>
                                <option value="paid">Premium required</option>
                            </select>
                        </div>
                    </div>
                    <div class="pt-4 flex items-center gap-3">
                        <button type="submit" class="w-full h-12 bg-primary text-white font-black rounded-2xl shadow-xl shadow-primary/20 hover:scale-[1.01] active:scale-[0.98] transition-all">Authorize deployment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div id="videoPreviewModal" class="fixed inset-0 bg-slate-900/20 backdrop-blur-md z-[300] hidden flex items-center justify-center p-8">
        <div class="bg-white dark:bg-[#0b1120] rounded-[2rem] w-full max-w-4xl overflow-hidden shadow-2xl border border-white/10 relative animate-slide-up">
            <button onclick="document.getElementById('videoPreviewModal').classList.add('hidden')" class="absolute top-5 right-5 size-9 rounded-2xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all z-50"><span class="material-symbols-rounded text-base">close</span></button>
            <div class="flex flex-col md:flex-row h-full">
                <!-- Left: Video & Title -->
                <div class="w-full md:w-3/5 p-6 border-r border-slate-100 dark:border-slate-800/50 bg-slate-50/30 dark:bg-slate-900/10">
                    <div class="mb-4">
                        <p class="text-[9px] font-bold text-slate-400 mb-1 tracking-tight">Preview Mode</p>
                        <h3 id="previewTitle" class="text-[14px] font-bold text-slate-800 dark:text-white leading-tight"></h3>
                    </div>
                    
                    <div class="aspect-video rounded-2xl bg-black overflow-hidden shadow-xl border border-slate-200 dark:border-white/5">
                        <iframe id="previewFrame" class="w-full h-full border-none" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    </div>
                </div>

                <!-- Right: Metadata -->
                <div class="w-full md:w-2/5 p-6 bg-white dark:bg-[#0b1120] flex flex-col justify-between">
                    <div class="space-y-6">
                        <div>
                            <p class="text-[10px] font-bold text-slate-400 tracking-tight mb-2">Details</p>
                            <p id="previewDescription" class="text-xs font-medium text-slate-600 dark:text-slate-400 leading-relaxed">This lesson provides an in-depth exploration of core concepts designed to optimize student performance through strategic intelligence tracking and verified instructor methodology.</p>
                        </div>

                        <div class="flex items-center justify-between p-4 rounded-xl bg-[#F8FAFC] dark:bg-[#F8F6F1]/5 border border-slate-200/50 dark:border-white/10">
                            <div class="flex flex-col">
                                <span class="text-[9px] font-bold text-slate-400 tracking-tight">Subject</span>
                                <span id="previewSubject" class="text-xs font-bold text-slate-800 dark:text-slate-200"></span>
                            </div>
                            <div class="flex flex-col text-right">
                                <span class="text-[9px] font-bold text-slate-400 tracking-tight">Class Level</span>
                                <span id="previewClass" class="text-xs font-bold text-slate-800 dark:text-slate-200"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-slate-50 dark:border-slate-800/50">
                        <div class="flex items-center gap-3 p-1">
                            <div class="size-11 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                                <img src="/images/default-avatar.png" class="size-full rounded-full object-cover">
                            </div>
                            <div>
                                <p id="previewInstructor" class="text-xs font-bold text-slate-800 dark:text-white"></p>
                                <p class="text-[10px] font-bold text-slate-400 tracking-tight">Lead Instructor • Verified Authority</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function filterByAccess(type) { window.location.href = `/superadmin/video-classes?access=${type}`; }

        function previewVideo(path, title, subject, classLevel, instructor) {
            const modal = document.getElementById('videoPreviewModal');
            const frame = document.getElementById('previewFrame');
            document.getElementById('previewTitle').innerText = title;
            document.getElementById('previewSubject').innerText = subject;
            document.getElementById('previewClass').innerText = `Class ${classLevel}`;
            document.getElementById('previewInstructor').innerText = instructor || 'System Authority';

            if (path.includes('youtube.com') || path.includes('youtu.be')) {
                let videoId = path.includes('v=') ? path.split('v=')[1].split('&')[0] : path.split('/').pop();
                frame.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            } else { frame.src = path; }
            modal.classList.remove('hidden');
        }

        async function deleteLesson(id) {
            const res = await Swal.fire({ title: 'Confirm purge', text: "Permanently delete this video asset?", icon: 'warning', showCancelButton: true, confirmButtonColor: '#137fec', cancelButtonColor: '#f43f5e' });
            if (res.isConfirmed) window.location.href = `/superadmin/class/${id}/delete`;
        }

        const selectedItems = new Set();
        function toggleSelectAll() { selectAllRows(document.getElementById('selectAll').checked); }
        function selectAllRows(force) {
            document.querySelectorAll('.item-cb').forEach(cb => { cb.checked = force; if(force) selectedItems.add(cb.value); else selectedItems.delete(cb.value); });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            updateBulkUI();
        }
        function toggleRowSelection(id) { const cb = document.getElementById(`cb-${id}`); if (cb) { cb.checked = !cb.checked; toggleSelection(cb); } }
        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value); else selectedItems.delete(el.value);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = document.querySelectorAll('.item-cb').length === selectedItems.size;
            updateBulkUI();
        }
        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) { bar.classList.remove('hidden'); countEl.innerText = selectedItems.size; } else { bar.classList.add('hidden'); }
        }
        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkUI();
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({ title: 'Bulk action', text: `Apply ${action} to ${selectedItems.size} items?`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#137fec' });
            if (!res.isConfirmed) return;
            try {
                const response = await fetch('/superadmin/video-classes/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Communication failure', 'error'); }
        }

        function exportClassesToCSV() {
            const rows = [['Title', 'Course', 'Chapter', 'Instructor', 'Duration', 'Access']];
            document.querySelectorAll('.class-row').forEach(row => {
                rows.push([
                    row.querySelector('p.text-slate-900, p.dark\\:text-white').innerText.replace(/,/g, ''),
                    row.querySelector('p.text-primary').innerText.replace(/,/g, ''),
                    row.querySelector('p.text-slate-400').innerText.replace(/,/g, ''),
                    row.querySelector('span.text-slate-400').innerText.replace(/,/g, ''),
                    row.querySelector('td:nth-child(9)').innerText.trim(),
                    row.querySelector('td:nth-child(10) span').innerText
                ]);
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "video_archive.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function syncVideoDuration() {
            const btn = event.currentTarget;
            btn.classList.add('animate-spin');
            setTimeout(() => {
                btn.classList.remove('animate-spin');
                document.getElementById('syncDuration').value = "18:42";
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Asset duration synced', showConfirmButton: false, timer: 1500 });
            }, 800);
        }
    </script>
</body>

</html>