<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Policies & Legal Control Center | ODDHAY Command Center</title>
    <style>
        :root {
            --admin-sidebar-width: 260px;
        }

        .admin-sidebar {
            width: var(--admin-sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .admin-main {
            margin-left: var(--admin-sidebar-width);
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        @media (max-width: 1024px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-sidebar.active {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen antialiased">

    <div class="flex">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar_content', { active: 'policies' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 ml-[260px] bg-[#FFFFFF] dark:bg-[#020617] flex flex-col min-h-screen w-full">
            <%- include('header_v2', { pageTitle: 'Policies & Legal Control Center' }) %>

            <section class="p-4 sm:p-6 max-w-5xl w-full mx-auto space-y-6">

                <!-- Success Alert -->
                <% if (locals.success) { %>
                    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-emerald-800 dark:text-emerald-200 flex items-center justify-between shadow-xs">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-xl">check_circle</span>
                            <span class="text-xs sm:text-sm font-semibold">Policy content updated successfully!</span>
                        </div>
                        <span class="text-xs text-emerald-600 font-medium">Changes are now live.</span>
                    </div>
                <% } %>

                <!-- Control Header with Tabs -->
                <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-emerald-500 text-xl">gavel</span>
                                <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">Policies & Legal Content Studio</h2>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Manage and customize the public content for Privacy Policy, Refund Policy, Terms, and About ODDHAY.
                            </p>
                        </div>
                    </div>

                    <!-- Navigation Tabs -->
                    <div class="flex flex-wrap items-center gap-1.5 border-t border-slate-200/80 dark:border-slate-800 pt-3">
                        <% 
                        const curTab = locals.activeTab || 'privacy';
                        const tabs = [
                            { id: 'privacy', label: 'Privacy Policy', path: '/privacy-policy', icon: 'security' },
                            { id: 'refund', label: 'Refund Policy', path: '/refund-policy', icon: 'currency_exchange' },
                            { id: 'terms', label: 'Terms & Conditions', path: '/terms', icon: 'gavel' },
                            { id: 'about', label: 'About ODDHAY', path: '/about', icon: 'info' }
                        ];
                        %>
                        <% tabs.forEach(t => { %>
                            <a href="/superadmin/policies?tab=<%= t.id %>"
                                class="px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all <%= curTab === t.id ? 'bg-[#18a957] text-white shadow-xs' : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 border border-slate-200 dark:border-slate-700' %>">
                                <span class="material-symbols-rounded text-sm"><%= t.icon %></span>
                                <span><%= t.label %></span>
                            </a>
                        <% }); %>
                    </div>
                </div>

                <!-- Form Card -->
                <form action="/superadmin/policies" method="POST" class="space-y-6">
                    <input type="hidden" name="tab" value="<%= curTab %>">

                    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
                        
                        <!-- TAB: PRIVACY POLICY -->
                        <% if (curTab === 'privacy') { %>
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                                <div>
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Privacy Policy Content Editor</h3>
                                    <p class="text-[11px] text-slate-400">Controls content displayed at <code class="text-emerald-600 font-mono">/privacy-policy</code></p>
                                </div>
                                <a href="/privacy-policy" target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 text-xs font-semibold flex items-center gap-1">
                                    <span class="material-symbols-rounded text-xs">open_in_new</span>
                                    <span>Preview Live</span>
                                </a>
                            </div>

                            <div>
                                <textarea name="privacyPolicy" rows="15"
                                    placeholder="Write custom HTML or text for Privacy Policy here. If left empty, ODDHAY displays the built-in concise English policy..."
                                    class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed"><%= (settings.policiesAndLegal && settings.policiesAndLegal.privacyPolicy) ? settings.policiesAndLegal.privacyPolicy : ((settings.privacyPolicy && settings.privacyPolicy.customContent) ? settings.privacyPolicy.customContent : '') %></textarea>
                            </div>
                        <% } %>

                        <!-- TAB: REFUND POLICY -->
                        <% if (curTab === 'refund') { %>
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                                <div>
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Refund Policy Content Editor</h3>
                                    <p class="text-[11px] text-slate-400">Controls content displayed at <code class="text-emerald-600 font-mono">/refund-policy</code></p>
                                </div>
                                <a href="/refund-policy" target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 text-xs font-semibold flex items-center gap-1">
                                    <span class="material-symbols-rounded text-xs">open_in_new</span>
                                    <span>Preview Live</span>
                                </a>
                            </div>

                            <div>
                                <textarea name="refundPolicy" rows="15"
                                    placeholder="Write custom HTML or text for Refund Policy here. If left empty, ODDHAY displays the built-in concise English policy..."
                                    class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed"><%= (settings.policiesAndLegal && settings.policiesAndLegal.refundPolicy) ? settings.policiesAndLegal.refundPolicy : '' %></textarea>
                            </div>
                        <% } %>

                        <!-- TAB: TERMS & CONDITIONS -->
                        <% if (curTab === 'terms') { %>
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                                <div>
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Terms & Conditions Content Editor</h3>
                                    <p class="text-[11px] text-slate-400">Controls content displayed at <code class="text-emerald-600 font-mono">/terms</code></p>
                                </div>
                                <a href="/terms" target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 text-xs font-semibold flex items-center gap-1">
                                    <span class="material-symbols-rounded text-xs">open_in_new</span>
                                    <span>Preview Live</span>
                                </a>
                            </div>

                            <div>
                                <textarea name="termsConditions" rows="15"
                                    placeholder="Write custom HTML or text for Terms & Conditions here. If left empty, ODDHAY displays the built-in concise English policy..."
                                    class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed"><%= (settings.policiesAndLegal && settings.policiesAndLegal.termsConditions) ? settings.policiesAndLegal.termsConditions : '' %></textarea>
                            </div>
                        <% } %>

                        <!-- TAB: ABOUT ODDHAY -->
                        <% if (curTab === 'about') { %>
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                                <div>
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">About ODDHAY Content Editor</h3>
                                    <p class="text-[11px] text-slate-400">Controls content displayed at <code class="text-emerald-600 font-mono">/about</code></p>
                                </div>
                                <a href="/about" target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 text-xs font-semibold flex items-center gap-1">
                                    <span class="material-symbols-rounded text-xs">open_in_new</span>
                                    <span>Preview Live</span>
                                </a>
                            </div>

                            <div>
                                <textarea name="aboutContent" rows="15"
                                    placeholder="Write custom HTML or text for About ODDHAY here. If left empty, ODDHAY displays the built-in concise English overview..."
                                    class="w-full p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed"><%= (settings.policiesAndLegal && settings.policiesAndLegal.aboutContent) ? settings.policiesAndLegal.aboutContent : '' %></textarea>
                            </div>
                        <% } %>

                        <p class="text-[11px] text-slate-400 leading-relaxed">
                            <span class="font-semibold text-slate-500">Note:</span> If you leave the box empty, the platform automatically renders the built-in, highly structured concise English policy.
                        </p>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex items-center justify-end gap-3">
                        <button type="submit"
                            class="px-6 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs transition-all shadow-xs flex items-center gap-2 cursor-pointer active:scale-98">
                            <span class="material-symbols-rounded text-sm">save</span>
                            <span>Save Changes</span>
                        </button>
                    </div>

                </form>

            </section>
        </main>
    </div>

</body>

</html>
