<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Compose Assessment | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; transition: all 0.3s ease; }
        .form-label { font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 0.5rem; display: block; letter-spacing: -0.01em; }
        .dark .form-label { color: #94a3b8; }
        .form-input { width: 100%; height: 42px; padding: 0 0.85rem; font-size: 11.5px; font-weight: 700; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 0.5rem; outline: none; transition: all 0.2s ease; appearance: none; }
        .dark .form-input { background: #020617; border: 1px solid #334155; color: #f1f5f9; }
        .form-input::placeholder { color: #94a3b8; font-weight: 500; opacity: 0.8; font-size: 12px; }
        .form-input:hover { border-color: #94a3b8; }
        .dark .form-input:hover { border-color: #475569; }
        .form-input:focus { border-color: #1e293b; }
        .dark .form-input:focus { border-color: #f1f5f9; }
        @media (max-width: 1024px) { .admin-main { margin-left: 0; } }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-700 dark:text-slate-300 font-sans min-h-screen antialiased">
    <div class="flex">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100] lg:translate-x-0 -translate-x-full">
            <%- include('sidebar_content', { active: 'quizzes' }) %>
        </aside>

        <main class="admin-main flex-1 flex flex-col w-full">
            <%- include('header_v2', { pageTitle: 'Compose Assessment' }) %>

            <section class="flex-1 flex flex-col bg-[#FFFFFF] dark:bg-[#0b1120] border-l border-slate-900/10 dark:border-white/5">
                <form action="/superadmin/add-quiz" method="POST" class="w-full" onsubmit="return handleQuizFormSubmit(event);">
                    <div class="divide-y divide-slate-100 dark:divide-white/5 bg-white dark:bg-[#0f172a]">
                        <!-- Messages -->
                        <% if (locals.success || locals.error) { %>
                        <div class="p-6 pb-0">
                            <% if (locals.success) { %>
                                <div class="bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-3 py-2.5 rounded-lg flex items-center gap-2 text-[12px] font-bold">
                                    <span class="material-symbols-rounded text-[16px]">check_circle</span>
                                    <%= success %>
                                </div>
                            <% } %>
                            <% if (locals.error) { %>
                                <div class="bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-2.5 rounded-lg flex items-center gap-2 text-[12px] font-bold">
                                    <span class="material-symbols-rounded text-[16px]">error</span>
                                    <%= error %>
                                </div>
                            <% } %>
                        </div>
                        <% } %>

                        <!-- Basic Information -->
                        <div class="p-8">
                            <h3 class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-6 flex items-center gap-2">
                                <span class="material-symbols-rounded text-[20px] text-blue-500">quiz</span> Exam Identification
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                                <div class="md:col-span-2">
                                    <label class="form-label">Exam Title</label>
                                    <input type="text" name="title" required placeholder="e.g Physics Mock Test 01" class="form-input">
                                </div>
                                <div class="md:col-span-1">
                                    <label class="form-label">Duration (Minutes)</label>
                                    <input type="number" name="duration" required value="10" min="1" class="form-input">
                                </div>
                                <div class="md:col-span-1">
                                    <label class="form-label">Access Model</label>
                                    <select name="accessType" class="form-input cursor-pointer">
                                        <option value="Free">Free Access</option>
                                        <option value="Paid">Premium (Paid)</option>
                                    </select>
                                </div>
                                <div class="md:col-span-4 pt-1">
                                    <label class="form-label flex items-center justify-between">
                                        <span>Question Language / অপশন ও প্রশ্নের ভাষা</span>
                                        <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded-full">ডিফল্ট: বাংলা</span>
                                    </label>
                                    <div class="grid grid-cols-2 gap-2.5 max-w-md">
                                        <button type="button" onclick="setQuizLanguage('bn')" id="quizLangBnBtn"
                                            class="h-9 rounded-xl border border-emerald-400 dark:border-emerald-600 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer">
                                            <span class="material-symbols-rounded text-sm">language</span>
                                            <span>বাংলা (ক, খ, গ, ঘ)</span>
                                        </button>
                                        <button type="button" onclick="setQuizLanguage('en')" id="quizLangEnBtn"
                                            class="h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer">
                                            <span class="material-symbols-rounded text-sm">translate</span>
                                            <span>English (A, B, C, D)</span>
                                        </button>
                                    </div>
                                    <input type="hidden" name="language" id="quizLanguageInput" value="bn">
                                    <input type="hidden" name="isBangla" id="quizIsBanglaInput" value="true">
                                </div>
                            </div>
                        </div>

                        <!-- Categorization -->
                        <div class="p-8">
                            <h3 class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-6 flex items-center gap-2">
                                <span class="material-symbols-rounded text-[20px] text-emerald-500">account_tree</span> Logic & Routing
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                                <div class="md:col-span-1">
                                    <label class="form-label">Exam Type</label>
                                    <select name="examCategory" id="examCategory" onchange="updateView()" class="form-input cursor-pointer font-bold">
                                        <option value="model" selected>Standalone Model Test</option>
                                        <option value="course">Course-Linked Exam</option>
                                        <option value="mock">Mock Test</option>
                                    </select>
                                    <!-- Compatibility flags for backend -->
                                    <input type="hidden" name="isModelTest" id="isModelTest" value="true">
                                    <input type="hidden" name="isMockTest" id="isMockTest" value="false">
                                </div>
                                <div class="md:col-span-1">
                                    <label class="form-label">Class Level</label>
                                    <select name="classLevel" id="classLevel" onchange="updateView()" class="form-input cursor-pointer" required>
                                        <option value="">-- Select Class --</option>
                                        <% ['6', '7', '8', '9', '10', '11', '12', 'HSC', 'Admission'].forEach(lvl => { %>
                                            <option value="<%= lvl %>"><%= lvl.includes('Class') || ['HSC', 'Admission'].includes(lvl) ? lvl : 'Class ' + lvl %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div id="courseContainer" class="md:col-span-2 hidden">
                                    <label class="form-label">Link to Course</label>
                                    <select name="courseId" id="courseId" onchange="onCourseSelected()" class="form-input cursor-pointer" disabled>
                                        <option value="">-- Select Course --</option>
                                        <% courses.forEach(course => { %>
                                            <option value="<%= course._id %>" data-class="<%= course.classLevel %>" data-subject="<%= course.subject %>"><%= course.title %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div id="subjectContainer" class="md:col-span-2">
                                    <label class="form-label">Subject</label>
                                    <select name="subject" id="subjectSelect" onchange="onSubjectOrClassChanged()" class="form-input cursor-pointer" required>
                                        <option value="">-- Select Subject --</option>
                                        <% (subjects || []).forEach(sub => { %>
                                            <option value="<%= sub %>"><%= sub %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div id="segmentContainer" class="md:col-span-2 hidden">
                                    <label class="form-label flex items-center justify-between">
                                        <span class="flex items-center gap-1.5">
                                            <span class="material-symbols-rounded text-sm text-indigo-500">segment</span>
                                            <span>Subject Segment / বিভাগ</span>
                                        </span>
                                        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-semibold bg-indigo-50 dark:bg-indigo-950/50 px-2 py-0.5 rounded-full">Ruled Subject</span>
                                    </label>
                                    <select name="segment" id="quizSegmentSelect" onchange="onQuizSegmentChanged()" class="form-input cursor-pointer">
                                        <option value="all">All Segments (সকল বিভাগ)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Chapter Selection (Optional - Multi Select) -->
                            <div id="chapterSection" class="mt-6 pt-6 border-t border-slate-100 dark:border-white/5">
                                <div class="flex items-center justify-between mb-2">
                                    <label class="form-label mb-0 flex items-center gap-2">
                                        <span>Select Chapters</span>
                                        <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">(Optional)</span>
                                    </label>
                                    <div class="flex items-center gap-2.5">
                                        <button type="button" id="selectAllChaptersBtn" onclick="toggleSelectAllChapters()" class="hidden text-[11px] font-bold text-primary hover:underline cursor-pointer transition-all active:scale-95">Select All</button>
                                        <span id="chapterCountBadge" class="text-[11px] font-medium text-slate-400">0 selected</span>
                                    </div>
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-500 mb-3">You can select one or more chapters to scope this assessment, or leave unselected for full syllabus coverage.</p>

                                <!-- Chapter Pills Container -->
                                <div id="chaptersContainer" class="min-h-[44px] p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 flex flex-wrap gap-2 items-center">
                                    <span id="chapterPlaceholder" class="text-[11px] text-slate-400 italic">Select Class Level and Subject to load syllabus chapters...</span>
                                </div>
                                <input type="hidden" name="chapter" id="chapterSummaryInput" value="">

                                <!-- Topics under Selected Chapters -->
                                <div id="topicsSection" class="mt-4 pt-4 border-t border-dashed border-slate-200 dark:border-slate-800 hidden">
                                    <div class="flex items-center justify-between mb-2">
                                        <label class="form-label mb-0 flex items-center gap-2">
                                            <span>Topics in Selected Chapters</span>
                                            <span id="topicCountBadge" class="text-[10px] font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 px-2 py-0.5 rounded-full">0 available</span>
                                        </label>
                                    </div>
                                    <div id="topicsContainer" class="flex flex-wrap gap-2"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Creation Strategy -->
                        <div class="p-8">
                            <h3 class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-6 flex items-center gap-2">
                                <span class="material-symbols-rounded text-[20px] text-violet-500">design_services</span> Composition Strategy
                            </h3>
                            <div class="flex flex-col md:flex-row items-start md:items-center gap-8">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="radio" name="strategy" value="manual" onchange="toggleStrategy('manual')" checked class="w-4 h-4 text-violet-600 border-slate-300 focus:ring-violet-500">
                                    <div class="flex flex-col">
                                        <span class="text-[12px] font-bold text-slate-700 dark:text-slate-200">Manual Studio</span>
                                        <span class="text-[10px] text-slate-400 font-medium italic">Create an empty exam and add questions manually.</span>
                                    </div>
                                </label>
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="radio" name="strategy" value="automated" onchange="toggleStrategy('automated')" class="w-4 h-4 text-violet-600 border-slate-300 focus:ring-violet-500">
                                    <div class="flex flex-col">
                                        <span class="text-[12px] font-bold text-slate-700 dark:text-slate-200">Smart Generation</span>
                                        <span class="text-[10px] text-slate-400 font-medium italic">Auto-populate using Question Bank data.</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Question Distribution -->
                        <div id="distributionSection" class="p-8">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                    <span class="material-symbols-rounded text-[20px] text-amber-500">format_list_numbered</span> Question slots by type <span class="text-rose-500">*</span>
                                </h3>
                                <span id="quizTotalSlotsBadge" class="text-[11px] font-semibold text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-lg">Total: 0 slots</span>
                            </div>
                            
                            <!-- Bank Filters (Shown for Smart Generation) -->
                            <div id="bankFilters" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 hidden">
                                <div>
                                    <label class="form-label">Filter by Board</label>
                                    <select name="bankBoard" id="bankBoard" onchange="syncBankMetadata()" class="form-input cursor-pointer">
                                        <option value="">Any Board</option>
                                        <% if (typeof boards !== 'undefined' && boards && boards.length > 0) { %>
                                            <% boards.forEach(function(b) { const bName = typeof b === 'object' ? b.name : b; %>
                                                <option value="<%= bName %>"><%= bName %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Filter by Year</label>
                                    <select name="bankYear" id="bankYear" onchange="syncBankMetadata()" class="form-input cursor-pointer">
                                        <option value="">Any Year</option>
                                        <% if (typeof years !== 'undefined' && years && years.length > 0) { %>
                                            <% years.forEach(function(y) { const yVal = typeof y === 'object' ? y.year : y; %>
                                                <option value="<%= yVal %>"><%= yVal %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4">
                                <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus-within:border-primary/60 transition-all shadow-2xs">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">MCQ</span>
                                        <span class="material-symbols-rounded text-sm text-primary">check_circle</span>
                                    </div>
                                    <input type="number" name="mcqCount" id="mcqCount" min="0" class="form-input q-config-field text-center font-bold" placeholder="0" oninput="updateTotalQuizSlots(); validateQuestionConfig();" onfocus="if(this.value==='0') this.value='';">
                                </div>
                                <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus-within:border-blue-500/60 transition-all shadow-2xs">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Short</span>
                                        <span class="material-symbols-rounded text-sm text-blue-500">short_text</span>
                                    </div>
                                    <input type="number" name="shortCount" id="shortCount" min="0" class="form-input q-config-field text-center font-bold" placeholder="0" oninput="updateTotalQuizSlots(); validateQuestionConfig();" onfocus="if(this.value==='0') this.value='';">
                                </div>
                                <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus-within:border-amber-500/60 transition-all shadow-2xs">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Medium</span>
                                        <span class="material-symbols-rounded text-sm text-amber-500">subject</span>
                                    </div>
                                    <input type="number" name="mediumCount" id="mediumCount" min="0" class="form-input q-config-field text-center font-bold" placeholder="0" oninput="updateTotalQuizSlots(); validateQuestionConfig();" onfocus="if(this.value==='0') this.value='';">
                                </div>
                                <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus-within:border-purple-500/60 transition-all shadow-2xs">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Compr.</span>
                                        <span class="material-symbols-rounded text-sm text-purple-500">article</span>
                                    </div>
                                    <input type="number" name="comprehensionCount" id="comprehensionCount" min="0" class="form-input q-config-field text-center font-bold" placeholder="0" oninput="updateTotalQuizSlots(); validateQuestionConfig();" onfocus="if(this.value==='0') this.value='';">
                                </div>
                            </div>
                            <div id="qConfigAlert" class="hidden mt-3 p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 text-xs font-semibold flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base">error</span>
                                <span>Please configure at least one question count (MCQ, Short, Medium, or Comprehension) to compose this assessment.</span>
                            </div>
                            <p id="strategyDesc" class="mt-4 text-[11px] text-slate-400 font-medium italic">
                                * System will create empty slots for you to fill manually.
                            </p>
                        </div>
                    </div>

                    <!-- Action Bar -->
                    <div class="p-6 border-t border-slate-100 dark:border-white/5 bg-slate-50 dark:bg-slate-900/30">
                        <div class="flex items-center justify-end gap-4">
                            <a href="/superadmin/quizzes" class="text-[12px] font-bold text-slate-400 hover:text-slate-600 transition-all px-4">Cancel</a>
                            <button type="submit" class="h-11 px-10 bg-black dark:bg-white text-white dark:text-black rounded-lg font-bold text-[12px] transition-all shadow-sm hover:opacity-90 active:scale-[0.98]">
                                Create & Add Questions
                            </button>
                        </div>
                    </div>
                </form>
            </section>
        </main>
    </div>

    <script>
        const allCourses = Array.from(document.querySelectorAll('#courseId option')).slice(1);
        let selectedChapters = new Set();

        function getActiveSubject() {
            const category = document.getElementById('examCategory').value;
            if (category === 'course') {
                const courseSelect = document.getElementById('courseId');
                const selectedOpt = courseSelect.options[courseSelect.selectedIndex];
                if (selectedOpt && selectedOpt.value) {
                    return selectedOpt.getAttribute('data-subject') || selectedOpt.text.split('-')[0].trim();
                }
                return '';
            } else {
                const subSelect = document.getElementById('subjectSelect');
                return subSelect ? subSelect.value : '';
            }
        }

        async function syncBankMetadata() {
            const classLevel = document.getElementById('classLevel').value;
            const subject = getActiveSubject();

            const board = document.getElementById('bankBoard') ? document.getElementById('bankBoard').value : '';
            const year = document.getElementById('bankYear') ? document.getElementById('bankYear').value : '';

            if (!classLevel || !subject) return;

            const chaps = Array.from(selectedChapters).join(',');

            try {
                const url = `/superadmin/api/bank-metadata?classLevel=${encodeURIComponent(classLevel)}&subject=${encodeURIComponent(subject)}&chapters=${encodeURIComponent(chaps)}&board=${encodeURIComponent(board)}&year=${encodeURIComponent(year)}`;
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    updateDropdown('bankBoard', data.boards, board, 'Any Board');
                    updateDropdown('bankYear', data.years, year, 'Any Year');
                }
            } catch (err) { console.error('Failed to sync metadata'); }
        }

        async function fetchChapters() {
            const classLevel = document.getElementById('classLevel').value;
            const subject = getActiveSubject();
            const container = document.getElementById('chaptersContainer');
            const topicsSection = document.getElementById('topicsSection');
            const selectAllBtn = document.getElementById('selectAllChaptersBtn');

            if (!classLevel || !subject) {
                container.innerHTML = '<span id="chapterPlaceholder" class="text-[11px] text-slate-400 italic">Select Class Level and Subject to load syllabus chapters...</span>';
                selectedChapters.clear();
                updateChapterSummary();
                if (selectAllBtn) selectAllBtn.classList.add('hidden');
                if (topicsSection) topicsSection.classList.add('hidden');
                return;
            }

            container.innerHTML = '<span class="text-[11px] text-slate-400 italic flex items-center gap-1.5"><span class="material-symbols-rounded animate-spin text-sm">sync</span> Loading chapters...</span>';

            try {
                // Fetch chapters & topics concurrently with optional segment
                const selectedSegment = document.getElementById('quizSegmentSelect')?.value || 'all';
                let chapUrl = `/superadmin/api/chapters?classLevel=${encodeURIComponent(classLevel)}&subject=${encodeURIComponent(subject)}`;
                let topUrl = `/superadmin/api/topics?classLevel=${encodeURIComponent(classLevel)}&subject=${encodeURIComponent(subject)}`;
                if (selectedSegment && selectedSegment !== 'all') {
                    chapUrl += `&segment=${encodeURIComponent(selectedSegment)}`;
                    topUrl += `&segment=${encodeURIComponent(selectedSegment)}`;
                }
                const [chapRes, topicRes] = await Promise.all([
                    fetch(chapUrl),
                    fetch(topUrl)
                ]);
                const data = await chapRes.json();
                const topicData = await topicRes.json();

                window._superCachedTopics = (topicData && Array.isArray(topicData.topics)) ? topicData.topics : [];

                container.innerHTML = '';
                selectedChapters.clear();

                if (data.success && Array.isArray(data.chapters) && data.chapters.length > 0) {
                    data.chapters.forEach((ch, idx) => {
                        const chapterName = (typeof ch === 'string') ? ch : (ch.name || `Chapter ${ch.number || (idx + 1)}`);
                        const pill = createChapterPill(chapterName);
                        container.appendChild(pill);
                    });
                    if (selectAllBtn) selectAllBtn.classList.remove('hidden');
                } else {
                    container.innerHTML = '<span class="text-[11px] text-slate-400 italic">No predefined chapters found for this subject.</span>';
                    if (selectAllBtn) selectAllBtn.classList.add('hidden');
                }

                updateChapterSummary();
                renderSuperTopicsForSelectedChapters();

            } catch (err) {
                console.error('Failed to fetch chapters:', err);
                container.innerHTML = '<span class="text-[11px] text-rose-500 italic">Failed to load chapters. You can proceed with full syllabus coverage.</span>';
                if (selectAllBtn) selectAllBtn.classList.add('hidden');
            }
        }

        function createChapterPill(chapterName) {
            const label = document.createElement('label');
            label.className = 'chapter-pill cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold border transition-all select-none bg-white dark:bg-slate-800/80 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-primary/50';
            
            const isChecked = selectedChapters.has(chapterName);
            if (isChecked) {
                label.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
            }

            label.innerHTML = `
                <input type="checkbox" name="chapters[]" value="${chapterName}" ${isChecked ? 'checked' : ''} class="w-3.5 h-3.5 rounded text-primary border-slate-300 focus:ring-primary accent-primary">
                <span>${chapterName}</span>
            `;

            const input = label.querySelector('input');
            input.onchange = function() {
                if (this.checked) {
                    selectedChapters.add(chapterName);
                    label.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                } else {
                    selectedChapters.delete(chapterName);
                    label.classList.remove('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                }
                updateChapterSummary();
                renderSuperTopicsForSelectedChapters();
                syncBankMetadata();
            };

            return label;
        }

        function toggleSelectAllChapters() {
            const container = document.getElementById('chaptersContainer');
            const checkboxes = container.querySelectorAll('input[type="checkbox"][name="chapters[]"]');
            if (checkboxes.length === 0) return;

            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            const btn = document.getElementById('selectAllChaptersBtn');

            checkboxes.forEach(cb => {
                cb.checked = !allChecked;
                const pill = cb.closest('.chapter-pill');
                const chapterVal = cb.value;
                if (!allChecked) {
                    selectedChapters.add(chapterVal);
                    if (pill) pill.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                } else {
                    selectedChapters.delete(chapterVal);
                    if (pill) pill.classList.remove('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                }
            });

            if (btn) btn.innerText = allChecked ? 'Select All' : 'Deselect All';
            updateChapterSummary();
            renderSuperTopicsForSelectedChapters();
            syncBankMetadata();
        }

        function renderSuperTopicsForSelectedChapters() {
            const topicsSection = document.getElementById('topicsSection');
            const container = document.getElementById('topicsContainer');
            const countBadge = document.getElementById('topicCountBadge');
            if (!topicsSection || !container) return;

            const selectedList = Array.from(selectedChapters).map(c => c.trim().toLowerCase());

            // ONLY show topics when chapter(s) are selected
            if (selectedList.length === 0) {
                topicsSection.classList.add('hidden');
                container.innerHTML = '';
                if (countBadge) countBadge.innerText = '0 available';
                return;
            }

            const allTopics = window._superCachedTopics || [];
            const matchingTopics = allTopics.filter(t => {
                const cName = (typeof t.chapter === 'string') ? t.chapter : (t.chapter?.name || '');
                return selectedList.includes(cName.trim().toLowerCase());
            });

            if (matchingTopics.length > 0) {
                topicsSection.classList.remove('hidden');
                container.innerHTML = '';
                const seen = new Set();
                matchingTopics.forEach(t => {
                    const name = (t.name || '').trim();
                    if (!name || seen.has(name.toLowerCase())) return;
                    seen.add(name.toLowerCase());
                    const cName = (typeof t.chapter === 'string') ? t.chapter : (t.chapter?.name || '');
                    const chip = document.createElement('div');
                    chip.className = 'px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs flex flex-col min-w-0';
                    chip.innerHTML = `<span class="font-bold text-slate-800 dark:text-slate-100">${name}</span>${cName ? `<span class="text-[9.5px] text-slate-400 font-medium">${cName}</span>` : ''}`;
                    container.appendChild(chip);
                });
                if (countBadge) countBadge.innerText = `${seen.size} available`;
            } else {
                topicsSection.classList.remove('hidden');
                container.innerHTML = '<span class="text-[11px] text-slate-400 italic">No topics assigned under the selected chapter(s) yet.</span>';
                if (countBadge) countBadge.innerText = '0 available';
            }
        }

        function updateChapterSummary() {
            const count = selectedChapters.size;
            const badge = document.getElementById('chapterCountBadge');
            const summaryInput = document.getElementById('chapterSummaryInput');
            const btn = document.getElementById('selectAllChaptersBtn');
            const checkboxes = document.querySelectorAll('#chaptersContainer input[type="checkbox"][name="chapters[]"]');

            if (badge) badge.innerText = `${count} selected`;
            if (summaryInput) summaryInput.value = Array.from(selectedChapters).join(', ');
            if (btn && checkboxes.length > 0) {
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                btn.innerText = allChecked ? 'Deselect All' : 'Select All';
            }
        }

        async function checkQuizSubjectSegments() {
            const classLevel = document.getElementById('classLevel')?.value;
            const subject = getActiveSubject();
            const segmentContainer = document.getElementById('segmentContainer');
            const segmentSelect = document.getElementById('quizSegmentSelect');
            if (!segmentContainer || !segmentSelect) return;

            if (!classLevel || !subject) {
                segmentContainer.classList.add('hidden');
                segmentSelect.innerHTML = '<option value="all">All Segments (সকল বিভাগ)</option>';
                return;
            }

            try {
                const res = await fetch(`/api/subjects/segments?subject=${encodeURIComponent(subject)}&classLevel=${encodeURIComponent(classLevel)}`);
                const data = await res.json();
                if (data && data.hasSegments && Array.isArray(data.segments) && data.segments.length > 0) {
                    segmentContainer.classList.remove('hidden');
                    let opts = '<option value="all">All Segments (সকল বিভাগ)</option>';
                    data.segments.forEach(seg => {
                        opts += `<option value="${seg}">${seg}</option>`;
                    });
                    segmentSelect.innerHTML = opts;
                } else {
                    segmentContainer.classList.add('hidden');
                    segmentSelect.innerHTML = '<option value="all">All Segments (সকল বিভাগ)</option>';
                }
            } catch (e) {
                console.warn('Error checking quiz subject segments:', e);
            }
        }

        function onQuizSegmentChanged() {
            fetchChapters();
        }

        async function onCourseSelected() {
            const courseSelect = document.getElementById('courseId');
            const selectedOpt = courseSelect.options[courseSelect.selectedIndex];
            if (selectedOpt && selectedOpt.value) {
                const courseClass = selectedOpt.getAttribute('data-class');
                if (courseClass) {
                    const classSelect = document.getElementById('classLevel');
                    for (let opt of classSelect.options) {
                        if (opt.value && courseClass.includes(opt.value)) {
                            classSelect.value = opt.value;
                            break;
                        }
                    }
                }
            }
            syncBankMetadata();
            await checkQuizSubjectSegments();
            fetchChapters();
        }

        async function onSubjectOrClassChanged() {
            syncBankMetadata();
            await checkQuizSubjectSegments();
            fetchChapters();
        }

        function updateDropdown(id, items, currentVal, placeholder) {
            const select = document.getElementById(id);
            let html = `<option value="">${placeholder}</option>`;
            items.forEach(item => {
                html += `<option value="${item}" ${item === currentVal ? 'selected' : ''}>${item}</option>`;
            });
            select.innerHTML = html;
        }

        function updateView() {
            const category = document.getElementById('examCategory').value;
            const isModelTestInput = document.getElementById('isModelTest');
            const isMockTestInput = document.getElementById('isMockTest');

            const isModelOrMock = (category === 'model' || category === 'mock');
            isModelTestInput.value = isModelOrMock ? 'true' : 'false';
            isMockTestInput.value = (category === 'mock') ? 'true' : 'false';

            const selectedClass = document.getElementById('classLevel').value;
            const courseContainer = document.getElementById('courseContainer');
            const subjectContainer = document.getElementById('subjectContainer');
            const courseSelect = document.getElementById('courseId');
            const subjectSelect = document.getElementById('subjectSelect');

            if (isModelOrMock) {
                courseContainer.classList.add('hidden');
                if (courseSelect) {
                    courseSelect.disabled = true;
                    courseSelect.removeAttribute('required');
                }
                subjectContainer.classList.remove('hidden');
                if (subjectSelect) subjectSelect.setAttribute('required', 'required');
            } else {
                courseContainer.classList.remove('hidden');
                if (courseSelect) {
                    courseSelect.disabled = false;
                }
                subjectContainer.classList.add('hidden');
                if (subjectSelect) subjectSelect.removeAttribute('required');
            }

            courseSelect.innerHTML = '<option value="">-- Select Course --</option>';
            if (selectedClass) {
                const filtered = allCourses.filter(opt => {
                    const courseClass = opt.getAttribute('data-class') || '';
                    return courseClass.includes(selectedClass) || courseClass.includes('Class ' + selectedClass);
                });
                filtered.forEach(opt => courseSelect.appendChild(opt.cloneNode(true)));
            }

            syncBankMetadata();
            fetchChapters();
        }

        function toggleStrategy(strategy) {
            const bankFilters = document.getElementById('bankFilters');
            const strategyDesc = document.getElementById('strategyDesc');
            
            if (strategy === 'automated') {
                bankFilters.classList.remove('hidden');
                strategyDesc.innerText = '* Questions will be pulled automatically from the Question Bank based on these counts.';
                syncBankMetadata();
            } else {
                bankFilters.classList.add('hidden');
                strategyDesc.innerText = '* System will create empty slots for you to fill manually.';
            }
        }

        function setQuizLanguage(lang) {
            const isBn = lang === 'bn';
            const langInput = document.getElementById('quizLanguageInput');
            const isBanglaInput = document.getElementById('quizIsBanglaInput');
            if (langInput) langInput.value = isBn ? 'bn' : 'en';
            if (isBanglaInput) isBanglaInput.value = isBn ? 'true' : 'false';

            const bnBtn = document.getElementById('quizLangBnBtn');
            const enBtn = document.getElementById('quizLangEnBtn');
            if (bnBtn && enBtn) {
                if (isBn) {
                    bnBtn.className = 'h-9 rounded-xl border border-emerald-400 dark:border-emerald-600 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer';
                    enBtn.className = 'h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer';
                } else {
                    enBtn.className = 'h-9 rounded-xl border border-primary bg-primary/10 text-primary text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer';
                    bnBtn.className = 'h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer';
                }
            }
        }

        function updateTotalQuizSlots() {
            const mcq = parseInt(document.getElementById('mcqCount')?.value || 0) || 0;
            const short = parseInt(document.getElementById('shortCount')?.value || 0) || 0;
            const medium = parseInt(document.getElementById('mediumCount')?.value || 0) || 0;
            const comp = parseInt(document.getElementById('comprehensionCount')?.value || 0) || 0;
            const total = mcq + short + medium + comp;
            const badge = document.getElementById('quizTotalSlotsBadge');
            if (badge) badge.innerText = `Total: ${total} ${total === 1 ? 'slot' : 'slots'}`;
        }

        function validateQuestionConfig() {
            const fields = ['mcqCount', 'shortCount', 'mediumCount', 'comprehensionCount'].map(id => document.getElementById(id));
            const hasAnyFilled = fields.some(f => f && parseInt(f.value) > 0);
            const badges = document.querySelectorAll('.q-config-badge');
            const alertBox = document.getElementById('qConfigAlert');

            if (hasAnyFilled) {
                badges.forEach(b => {
                    b.innerHTML = '<span class="text-slate-400 font-normal text-[10px]">(Optional)</span>';
                });
                fields.forEach(f => {
                    if (f) f.removeAttribute('required');
                });
                if (alertBox) alertBox.classList.add('hidden');
            } else {
                badges.forEach(b => {
                    b.innerHTML = '<span class="text-rose-500 font-bold text-xs">*</span>';
                });
                fields.forEach(f => {
                    if (f) f.setAttribute('required', 'required');
                });
            }
            return hasAnyFilled;
        }

        function handleQuizFormSubmit(event) {
            const hasAnyFilled = validateQuestionConfig();
            if (!hasAnyFilled) {
                if (event) event.preventDefault();
                const alertBox = document.getElementById('qConfigAlert');
                if (alertBox) alertBox.classList.remove('hidden');
                const firstField = document.getElementById('mcqCount');
                firstField?.focus();
                firstField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }
            return true;
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateView();
            toggleStrategy('manual');
            updateTotalQuizSlots();
            validateQuestionConfig();
        });
    </script>
</body>

</html>
