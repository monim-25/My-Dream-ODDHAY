                                <span class="material-symbols-rounded text-base">save</span>
                                <span>Save All Landing Page & Footer Settings</span>
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </main>
    </div>

    <script>
        // Real-time Transform Engine
        let currentPreviewMode = 'desktop';

        function setPreviewMode(mode) {
            currentPreviewMode = mode;
            const desktopBtn = document.getElementById('previewDesktopBtn');
            const mobileBtn = document.getElementById('previewMobileBtn');
            const container = document.getElementById('imagePreviewContainer');

            if (mode === 'desktop') {
                if (desktopBtn) desktopBtn.className = "px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 bg-white dark:bg-slate-700 text-[#18a957] shadow-xs cursor-pointer transition-all";
                if (mobileBtn) mobileBtn.className = "px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 text-slate-500 hover:text-slate-900 dark:hover:text-white cursor-pointer transition-all";
                if (container) container.classList.remove('max-w-[340px]', 'mx-auto', 'border-emerald-500/50', 'ring-2', 'ring-emerald-500/20');
            } else {
                if (mobileBtn) mobileBtn.className = "px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 bg-white dark:bg-slate-700 text-[#18a957] shadow-xs cursor-pointer transition-all";
                if (desktopBtn) desktopBtn.className = "px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 text-slate-500 hover:text-slate-900 dark:hover:text-white cursor-pointer transition-all";
                if (container) container.classList.add('max-w-[340px]', 'mx-auto', 'border-emerald-500/50', 'ring-2', 'ring-emerald-500/20');
            }
            updateImageTransforms();
        }

        function onDesktopControlInput() {
            if (currentPreviewMode !== 'desktop') {
                setPreviewMode('desktop');
            } else {
                updateImageTransforms();
            }
        }

        function onMobileControlInput() {
            if (currentPreviewMode !== 'mobile') {
                setPreviewMode('mobile');
            } else {
                updateImageTransforms();
            }
        }

        function updateImageTransforms() {
            const scale = document.getElementById('heroImageScale').value;
            const mobileScale = document.getElementById('heroImageMobileScale') ? document.getElementById('heroImageMobileScale').value : 100;
            const rotate = document.getElementById('heroImageRotate').value;
            const offsetX = document.getElementById('heroImageOffsetX').value;
            const offsetY = document.getElementById('heroImageOffsetY').value;

            // Update badge indicators
            if (document.getElementById('scaleDisplay')) document.getElementById('scaleDisplay').textContent = scale + '%';
            if (document.getElementById('mobileScaleDisplay')) document.getElementById('mobileScaleDisplay').textContent = mobileScale + '%';
            if (document.getElementById('rotateDisplay')) document.getElementById('rotateDisplay').textContent = rotate + '°';
            if (document.getElementById('offsetXDisplay')) document.getElementById('offsetXDisplay').textContent = offsetX + 'px';
            if (document.getElementById('offsetYDisplay')) document.getElementById('offsetYDisplay').textContent = offsetY + 'px';

            // Apply transform to preview image
            const img = document.getElementById('screenshotPreviewImg');
            if (img) {
                if (currentPreviewMode === 'mobile') {
                    const ms = mobileScale / 100;
                    img.style.transform = '';
                    img.style.maxWidth = Math.round(380 * ms) + 'px';
                    img.style.maxHeight = Math.round(340 * ms) + 'px';
                    img.style.width = '100%';
                    img.style.height = 'auto';
                } else {
                    const s = scale / 100;
                    img.style.maxWidth = '100%';
                    img.style.maxHeight = '340px';
                    img.style.width = 'auto';
                    img.style.height = 'auto';
                    img.style.transform = 'translate(' + offsetX + 'px, ' + offsetY + 'px) scale(' + s + ') rotate(' + rotate + 'deg)';
                }
            }
        }

        function resetImageTransforms() {
            document.getElementById('heroImageScale').value = 100;
            if (document.getElementById('heroImageMobileScale')) document.getElementById('heroImageMobileScale').value = 100;
            document.getElementById('heroImageRotate').value = 0;
            document.getElementById('heroImageOffsetX').value = 0;
            document.getElementById('heroImageOffsetY').value = 0;
            updateImageTransforms();
        }

        function updateLiveImagePreview(url) {
            const img = document.getElementById('screenshotPreviewImg');
            const placeholder = document.getElementById('noScreenshotPlaceholder');
            if (!img) return;

            if (url && url.trim().length > 5) {
                img.src = url.trim();
                img.classList.remove('hidden');
                if (placeholder) placeholder.classList.add('hidden');
                updateImageTransforms();
            } else {
                img.classList.add('hidden');
                if (placeholder) placeholder.classList.remove('hidden');
            }
        }

        function previewSelectedImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('screenshotPreviewImg');
                    const placeholder = document.getElementById('noScreenshotPlaceholder');
                    if (img) {
                        img.src = e.target.result;
                        img.classList.remove('hidden');
                        updateImageTransforms();
                    }
                    if (placeholder) placeholder.classList.add('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function updateLiveVideoPreview(url) {
            const container = document.getElementById('videoPreviewContainer');
            if (!container) return;
            const cleanUrl = (url || '').trim();

            let ytId = null;
            if (cleanUrl.includes('youtube.com/watch')) {
                const m = cleanUrl.match(/[?&]v=([^&]+)/);
                if (m) ytId = m[1];
            } else if (cleanUrl.includes('youtu.be/')) {
                const p = cleanUrl.split('youtu.be/');
                if (p[1]) ytId = p[1].split(/[?&]/)[0];
            } else if (cleanUrl.includes('youtube.com/embed/')) {
                const p = cleanUrl.split('youtube.com/embed/');
                if (p[1]) ytId = p[1].split(/[?&]/)[0];
            }

            if (ytId) {
                container.innerHTML = '<iframe src="https://www.youtube.com/embed/' + ytId + '?rel=0" class="w-full h-full border-0" allowfullscreen></iframe>';
            } else if (cleanUrl.endsWith('.mp4') || cleanUrl.endsWith('.webm') || cleanUrl.includes('cloudinary.com')) {
                container.innerHTML = '<video src="' + cleanUrl + '" controls class="w-full h-full object-contain"></video>';
            } else {
                container.innerHTML = '<div class="p-4 text-center text-slate-400 space-y-1"><span class="material-symbols-rounded text-3xl">play_circle</span><p class="text-xs">Enter a valid YouTube or direct video URL above to see preview</p></div>';
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            const vInput = document.getElementById('videoUrl');
            if (vInput) updateLiveVideoPreview(vInput.value);
            updateImageTransforms();
        });
    </script>
</body>
</html>
