<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <title>Landing Page Control | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-sidebar { width: var(--admin-sidebar-width); height: 100vh; position: fixed; left: 0; top: 0; z-index: 100; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; transition: all 0.3s ease; }
        @media (max-width: 1024px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-main { margin-left: 0; }
        }

        /* Custom slider styles */
        input[type=range] {
            accent-color: #18a957;
        }
    </style>
</head>

<body class="bg-slate-50 dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar bg-white dark:bg-[#0f172a] border-r border-slate-200 dark:border-white/5 transition-transform duration-300">
            <%- include('sidebar_content', { active: 'landing-control' }) %>
        </aside>

        <div id="sidebarBackdrop" onclick="toggleAdminSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-90 lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 flex flex-col">
            <%- include('header_v2', { pageTitle: 'Landing Page Control Center', backUrl: '/superadmin' }) %>

            <div class="p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full space-y-6">
                
                <!-- Page Top Title -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Landing Page Control Center</h1>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">Control the hero image sizing, rotation, placement, and video tour on the landing page.</p>
                    </div>
                    <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-primary transition-colors shadow-2xs">
                        <span class="material-symbols-rounded text-sm">open_in_new</span>
                        <span>View Live Landing Page</span>
                    </a>
                </div>

                <% if (locals.success) { %>
                    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs sm:text-sm font-semibold flex items-center gap-2">
                        <span class="material-symbols-rounded text-lg text-emerald-600">check_circle</span>
                        <span>Landing page controls have been updated successfully!</span>
                    </div>
                <% } %>

                <!-- Main Form with Multipart Support -->
                <form action="/superadmin/landing-control" method="POST" enctype="multipart/form-data" class="space-y-6">
                    <% 
                        const landing = (settings && settings.landingPage) ? settings.landingPage : {};
                        const scaleVal = typeof landing.heroImageScale === 'number' ? landing.heroImageScale : 100;
                        const mobileScaleVal = typeof landing.heroImageMobileScale === 'number' ? landing.heroImageMobileScale : 100;
                        const rotateVal = typeof landing.heroImageRotate === 'number' ? landing.heroImageRotate : 0;
                        const offsetXVal = typeof landing.heroImageOffsetX === 'number' ? landing.heroImageOffsetX : 0;
                        const offsetYVal = typeof landing.heroImageOffsetY === 'number' ? landing.heroImageOffsetY : 0;
                        const legal = (settings && settings.legalInfo) ? settings.legalInfo : {};
                        const contact = (settings && settings.contactInfo) ? settings.contactInfo : {};
                        const social = (settings && settings.socialLinks) ? settings.socialLinks : {};
                        const footer = (settings && settings.footerInfo) ? settings.footerInfo : {};
                    %>
                    
                    <!-- 1. HERO PLATFORM IMAGE & FINE-TUNING STUDIO CARD -->
                    <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 space-y-6 shadow-2xs">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="material-symbols-rounded text-[#18a957] text-2xl">crop_rotate</span>
                                <div>
                                    <h2 class="text-base font-bold text-slate-900 dark:text-white">Hero Platform Visual & Position Studio</h2>
                                    <p class="text-xs text-slate-400 font-normal">Upload any PNG/Image and fine-tune its size, angle, and position in real time.</p>
                                </div>
                            </div>
                            <button type="button" onclick="resetImageTransforms()" class="text-xs font-semibold text-slate-500 hover:text-[#18a957] inline-flex items-center gap-1 cursor-pointer">
                                <span class="material-symbols-rounded text-sm">restart_alt</span>
                                <span>Reset Position</span>
                            </button>
                        </div>

                        <!-- Upload & URL Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Direct File Upload -->
                            <div class="space-y-1.5">
                                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                    Upload New Image (PNG / Transparent Image)
                                </label>
                                <input type="file" id="heroScreenshotFile" name="heroScreenshotFile" accept="image/*"
                                    onchange="previewSelectedImage(this)"
                                    class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3.5 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#18a957]/10 file:text-[#18a957] hover:file:bg-[#18a957]/20 cursor-pointer">
                                <p class="text-[11px] text-slate-400">Works with transparent PNGs, isometric cut-outs, device screens, or graphics.</p>
                            </div>

                            <!-- Image URL Alternative -->
                            <div class="space-y-1.5">
                                <label for="heroScreenshotUrl" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                    OR Image URL (Hosted Link / CDN)
                                </label>
                                <input type="text" id="heroScreenshotUrl" name="heroScreenshotUrl" value="<%= landing.heroScreenshotUrl || '' %>"
                                    placeholder="https://example.com/mockup.png"
                                    oninput="updateLiveImagePreview(this.value)"
                                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-[#18a957] transition-colors">
                            </div>
                        </div>

                        <!-- Fine-Tuning Controls (Size, Rotate, Move X, Move Y) -->
                        <div class="rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-4 space-y-4">
                            <span class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm text-[#18a957]">tune</span>
                                <span>Image Placement Controls (Real-Time Adjustment)</span>
                            </span>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                                <!-- Desktop Size / Scale -->
                                <div class="space-y-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <label for="heroImageScale" class="font-semibold text-slate-600 dark:text-slate-300 flex items-center gap-1">
                                            <span class="material-symbols-rounded text-sm text-slate-400">desktop_windows</span>
                                            <span>Desktop Scale</span>
                                        </label>
                                        <span id="scaleDisplay" class="font-bold text-[#18a957] font-mono"><%= scaleVal %>%</span>
                                    </div>
                                    <input type="range" id="heroImageScale" name="heroImageScale" min="40" max="180" step="1" value="<%= scaleVal %>"
                                        oninput="onDesktopControlInput()" class="w-full cursor-pointer">
                                </div>

                                <!-- Mobile Size / Scale (Small Screen) -->
                                <div class="space-y-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <label for="heroImageMobileScale" class="font-semibold text-slate-600 dark:text-slate-300 flex items-center gap-1">
                                            <span class="material-symbols-rounded text-sm text-emerald-500">smartphone</span>
                                            <span>Mobile Scale</span>
                                        </label>
                                        <span id="mobileScaleDisplay" class="font-bold text-[#18a957] font-mono"><%= mobileScaleVal %>%</span>
                                    </div>
                                    <input type="range" id="heroImageMobileScale" name="heroImageMobileScale" min="40" max="180" step="1" value="<%= mobileScaleVal %>"
                                        oninput="onMobileControlInput()" class="w-full cursor-pointer">
                                </div>

                                <!-- Rotate / Angle -->
                                <div class="space-y-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <label for="heroImageRotate" class="font-semibold text-slate-600 dark:text-slate-300">Rotation Angle</label>
                                        <span id="rotateDisplay" class="font-bold text-[#18a957] font-mono"><%= rotateVal %>°</span>
                                    </div>
                                    <input type="range" id="heroImageRotate" name="heroImageRotate" min="-180" max="180" step="1" value="<%= rotateVal %>"
                                        oninput="onDesktopControlInput()" class="w-full cursor-pointer">
                                </div>

                                <!-- Move Horizontal (X) -->
                                <div class="space-y-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <label for="heroImageOffsetX" class="font-semibold text-slate-600 dark:text-slate-300">Move Horizontally (X)</label>
                                        <span id="offsetXDisplay" class="font-bold text-[#18a957] font-mono"><%= offsetXVal %>px</span>
                                    </div>
                                    <input type="range" id="heroImageOffsetX" name="heroImageOffsetX" min="-250" max="250" step="2" value="<%= offsetXVal %>"
                                        oninput="onDesktopControlInput()" class="w-full cursor-pointer">
                                </div>

                                <!-- Move Vertical (Y) -->
                                <div class="space-y-1.5">
                                    <div class="flex items-center justify-between text-xs">
                                        <label for="heroImageOffsetY" class="font-semibold text-slate-600 dark:text-slate-300">Move Vertically (Y)</label>
                                        <span id="offsetYDisplay" class="font-bold text-[#18a957] font-mono"><%= offsetYVal %>px</span>
                                    </div>
                                    <input type="range" id="heroImageOffsetY" name="heroImageOffsetY" min="-200" max="200" step="2" value="<%= offsetYVal %>"
                                        oninput="onDesktopControlInput()" class="w-full cursor-pointer">
                                </div>
                            </div>
                        </div>

                        <!-- Live Visual Stage Preview -->
                        <div class="space-y-2 pt-1">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div class="flex items-center gap-3">
                                    <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Live Visual Stage Preview</span>
                                    <!-- Desktop vs Mobile Preview Switcher -->
                                    <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-200/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs select-none">
                                        <button type="button" id="previewDesktopBtn" onclick="setPreviewMode('desktop')" class="px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 bg-white dark:bg-slate-700 text-[#18a957] shadow-xs cursor-pointer transition-all">
                                            <span class="material-symbols-rounded text-sm">desktop_windows</span>
                                            <span>Desktop View</span>
                                        </button>
                                        <button type="button" id="previewMobileBtn" onclick="setPreviewMode('mobile')" class="px-2.5 py-1 rounded-md font-semibold text-xs flex items-center gap-1 text-slate-500 hover:text-slate-900 dark:hover:text-white cursor-pointer transition-all">
                                            <span class="material-symbols-rounded text-sm">smartphone</span>
                                            <span>Mobile View</span>
                                        </button>
                                    </div>
                                </div>
                                <% if (landing.heroScreenshotUrl) { %>
                                    <label class="inline-flex items-center gap-1.5 text-xs text-rose-500 font-medium cursor-pointer">
                                        <input type="checkbox" name="clearHeroScreenshot" value="1" class="rounded border-slate-300 text-rose-600 focus:ring-rose-500">
                                        <span>Remove current image</span>
                                    </label>
                                <% } %>
                            </div>

                            <!-- Preview Stage Area with Ambient Dots Backdrop -->
                            <div id="imagePreviewContainer" class="min-h-[280px] max-h-[420px] w-full rounded-2xl bg-slate-50 dark:bg-slate-950/70 p-6 flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-800 relative overflow-visible select-none">
                                <!-- Stage Center Guideline Dot -->
                                <div class="size-2 rounded-full bg-slate-300 dark:bg-slate-700 absolute pointer-events-none opacity-40"></div>

                                <% if (landing.heroScreenshotUrl) { %>
                                    <img id="screenshotPreviewImg" src="<%= landing.heroScreenshotUrl %>" alt="Hero Image Preview"
                                        class="max-h-[340px] w-auto max-w-full object-contain drop-shadow-xl transition-transform duration-75">
                                    <div id="noScreenshotPlaceholder" class="p-6 text-center text-slate-400 space-y-2 hidden">
                                        <span class="material-symbols-rounded text-4xl">image</span>
                                        <p class="text-xs">Select or enter an image above to preview</p>
                                    </div>
                                <% } else { %>
                                    <div id="noScreenshotPlaceholder" class="p-6 text-center text-slate-400 space-y-2">
                                        <span class="material-symbols-rounded text-4xl">image</span>
                                        <p class="text-xs">No custom image uploaded yet. Select an image file or enter URL to adjust size, angle and position.</p>
                                    </div>
                                    <img id="screenshotPreviewImg" src="" alt="Hero Image Preview"
                                        class="max-h-[340px] w-auto max-w-full object-contain drop-shadow-xl transition-transform duration-75 hidden">
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- 2. OVERVIEW VIDEO CARD -->
                    <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 space-y-5 shadow-2xs">
                        <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-3">
                            <span class="material-symbols-rounded text-primary text-xl">smart_display</span>
                            <div>
                                <h2 class="text-base font-bold text-slate-900 dark:text-white">Walkthrough Video Section</h2>
                                <p class="text-xs text-slate-400 font-normal">Controls the 'প্ল্যাটফর্ম অভিজ্ঞতা' video tour on the landing page.</p>
                            </div>
                        </div>

                        <!-- Video URL -->
                        <div class="space-y-1.5">
                            <label for="videoUrl" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Video URL (YouTube, Vimeo, or Direct MP4 / Cloudinary link)
                            </label>
                            <input type="text" id="videoUrl" name="videoUrl" value="<%= landing.videoUrl || '' %>"
                                placeholder="e.g. https://www.youtube.com/watch?v=dQw4w9WgXcQ or https://youtu.be/..."
                                oninput="updateLiveVideoPreview(this.value)"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors">
                            <p class="text-[11px] text-slate-400">Supports standard YouTube links, shortened youtu.be links, Vimeo embeds, and direct MP4/Cloudinary video files.</p>
                        </div>

                        <!-- Video Title -->
                        <div class="space-y-1.5">
                            <label for="videoTitle" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Section Headline / Title
                            </label>
                            <input type="text" id="videoTitle" name="videoTitle" value="<%= landing.videoTitle || 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>"
                                placeholder="অধ্যায় প্ল্যাটফর্ম পরিচিতি"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors">
                        </div>

                        <!-- Video Caption -->
                        <div class="space-y-1.5">
                            <label for="videoCaption" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Section Subtitle / Caption
                            </label>
                            <textarea id="videoCaption" name="videoCaption" rows="2"
                                placeholder="এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors"><%= landing.videoCaption || 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %></textarea>
                        </div>

                        <!-- Video Live Preview -->
                        <div class="space-y-2 pt-2">
                            <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Video Live Preview</span>
                            <div id="videoPreviewContainer" class="aspect-video w-full max-w-xl rounded-2xl bg-slate-950 overflow-hidden flex items-center justify-center border border-slate-800 relative">
                                <p class="text-xs text-slate-400">Loading preview...</p>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-end">
                            <button type="submit" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold transition-all shadow-sm active:scale-95 cursor-pointer flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base">save</span>
                                <span>Save Video & Hero Controls</span>
                            </button>
                        </div>
                    </div>

                    <!-- 3. FOOTER, LEGAL CREDENTIALS & PUBLIC INFO CONTROL -->
                    <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 space-y-6 shadow-2xs">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-4">
                            <div class="flex items-center gap-2.5">
                                <div class="size-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-xl">verified_user</span>
                                </div>
                                <div>
                                    <h2 class="text-base font-bold text-slate-900 dark:text-white">Footer, Legal & Public Presence Control</h2>
                                    <p class="text-xs text-slate-400 font-normal">Manage trade license, e-TIN certificate, head office address, hotline, WhatsApp, social links, and footer bio.</p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 text-[11px] font-bold border border-emerald-200 dark:border-emerald-800 hidden sm:inline-flex items-center gap-1">
                                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                Live on Landing Page
                            </span>
                        </div>

                        <!-- 3.1 Government Legal & Licensing Credentials -->
                        <div class="p-4 sm:p-5 rounded-xl bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 space-y-4">
                            <div class="flex items-center gap-2 text-slate-900 dark:text-white text-xs sm:text-sm font-bold">
                                <span class="material-symbols-rounded text-emerald-500 text-lg">policy</span>
                                <span>১. আইনি নিবন্ধন ও সনদ (Legal & Official Information)</span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="space-y-1.5">
                                    <label for="tradeLicense" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                        ট্রেড লাইসেন্স নং (Trade License No)
                                    </label>
                                    <input type="text" id="tradeLicense" name="tradeLicense" 
                                        value="<%= legal.tradeLicense || 'TRAD/DNCC/041285/2026' %>"
                                        placeholder="e.g. TRAD/DNCC/041285/2026"
                                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-emerald-500 transition-colors">
                                </div>

                                <div class="space-y-1.5">
                                    <label for="tinNumber" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                        ই-টিন সার্টিফিকেট নং (e-TIN Certificate No)
                                    </label>
                                    <input type="text" id="tinNumber" name="tinNumber" 
                                        value="<%= legal.tinNumber || '8491-7302-6194' %>"
                                        placeholder="e.g. 8491-7302-6194"
                                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-emerald-500 transition-colors">
                                </div>

                                <div class="col-span-1 md:col-span-2 space-y-1.5">
                                    <label for="address" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                        প্রধান কার্যালয়ের ঠিকানা (Official Corporate Address)
                                    </label>
                                    <input type="text" id="address" name="address" 
                                        value="<%= legal.address || 'বাড়ি #১২, রোড #০৪, ধানমন্ডি, ঢাকা - ১২০৯, বাংলাদেশ' %>"
                                        placeholder="বাড়ি #১২, রোড #০৪, ধানমন্ডি, ঢাকা - ১২০৯, বাংলাদেশ"
                                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-emerald-500 transition-colors">
                                </div>
                            </div>
                        </div>

                        <!-- 3.2 Helpdesk & Direct Contact Channels -->
                        <div class="p-4 sm:p-5 rounded-xl bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 space-y-4">
                            <div class="flex items-center gap-2 text-slate-900 dark:text-white text-xs sm:text-sm font-bold">
                                <span class="material-symbols-rounded text-blue-500 text-lg">contact_phone</span>
                                <span>২. সরাসরি যোগাযোগ ও হেল্পডেস্ক (Helpdesk & Contacts)</span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="space-y-1.5">
                                    <label for="phone" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                        হটলাইন / কল সাপোর্ট নম্বর (Hotline Phone)
                                    </label>
                                    <input type="text" id="phone" name="phone" 
