<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <title>Landing Page Control | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-sidebar { width: var(--admin-sidebar-width); height: 100vh; position: fixed; left: 0; top: 0; z-index: 100; }
        .admin-main { margin-left: var(--admin-sidebar-width); min-height: 100vh; transition: all 0.3s ease; }
        @media (max-width: 1024px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-main { margin-left: 0; }
        }
    </style>
</head>

<body class="bg-slate-50 dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar bg-white dark:bg-[#0f172a] border-r border-slate-200 dark:border-white/5 transition-transform duration-300">
            <%- include('sidebar') %>
        </aside>

        <div id="sidebarBackdrop" onclick="toggleAdminSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-90 lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 flex flex-col">
            <%- include('header_v2', { pageTitle: 'Landing Page Control Center', backUrl: '/superadmin' }) %>

            <div class="p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full space-y-6">
                
                <!-- Page Top Title -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Landing Page Control Center</h1>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">Control the video, headlines, and presentation shown on the public landing page.</p>
                    </div>
                    <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-primary transition-colors shadow-2xs">
                        <span class="material-symbols-rounded text-sm">open_in_new</span>
                        <span>View Live Landing Page</span>
                    </a>
                </div>

                <% if (locals.success) { %>
                    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs sm:text-sm font-semibold flex items-center gap-2">
                        <span class="material-symbols-rounded text-lg text-emerald-600">check_circle</span>
                        <span>Landing page controls have been updated successfully!</span>
                    </div>
                <% } %>

                <!-- Main Form Card -->
                <form action="/superadmin/landing-control" method="POST" class="space-y-6">
                    <% const landing = (settings && settings.landingPage) ? settings.landingPage : {}; %>
                    
                    <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 space-y-5 shadow-2xs">
                        <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-3">
                            <span class="material-symbols-rounded text-primary text-xl">smart_display</span>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white">Overview & Walkthrough Video Section</h2>
                        </div>

                        <!-- Video URL -->
                        <div class="space-y-1.5">
                            <label for="videoUrl" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Video URL (YouTube, Vimeo, or Direct MP4 / Cloudinary link)
                            </label>
                            <input type="text" id="videoUrl" name="videoUrl" value="<%= landing.videoUrl || '' %>"
                                placeholder="e.g. https://www.youtube.com/watch?v=dQw4w9WgXcQ or https://youtu.be/..."
                                oninput="updateLiveVideoPreview(this.value)"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors">
                            <p class="text-[11px] text-slate-400">Supports standard YouTube links, shortened youtu.be links, Vimeo embeds, and direct MP4/Cloudinary video files.</p>
                        </div>

                        <!-- Video Title -->
                        <div class="space-y-1.5">
                            <label for="videoTitle" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Section Headline / Title
                            </label>
                            <input type="text" id="videoTitle" name="videoTitle" value="<%= landing.videoTitle || 'অধ্যায় প্ল্যাটফর্ম পরিচিতি' %>"
                                placeholder="অধ্যায় প্ল্যাটফর্ম পরিচিতি"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors">
                        </div>

                        <!-- Video Caption -->
                        <div class="space-y-1.5">
                            <label for="videoCaption" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                                Section Subtitle / Caption
                            </label>
                            <textarea id="videoCaption" name="videoCaption" rows="2"
                                placeholder="এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs sm:text-sm font-medium text-slate-900 dark:text-white outline-none focus:border-primary transition-colors"><%= landing.videoCaption || 'এক নজরে দেখে নাও অধ্যায় কীভাবে তোমার পড়াশোনাকে করবে আরও সহজ ও কার্যকর' %></textarea>
                        </div>

                        <!-- Live Preview Box -->
                        <div class="space-y-2 pt-2">
                            <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Live Preview</span>
                            <div id="videoPreviewContainer" class="aspect-video w-full max-w-2xl rounded-2xl bg-slate-950 overflow-hidden flex items-center justify-center border border-slate-800 relative">
                                <!-- Injected via JS or fallback -->
                                <p class="text-xs text-slate-400">Loading preview...</p>
                            </div>
                        </div>

                        <!-- Save Button -->
                        <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-end">
                            <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs sm:text-sm font-semibold transition-all shadow-sm active:scale-95 cursor-pointer flex items-center gap-2">
                                <span class="material-symbols-rounded text-base">save</span>
                                <span>Save Changes</span>
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </main>
    </div>

    <script>
        function updateLiveVideoPreview(url) {
            const container = document.getElementById('videoPreviewContainer');
            if (!container) return;

            if (!url || !url.trim()) {
                container.innerHTML = \`
                    <div class="text-center p-6 text-slate-500 space-y-2">
                        <span class="material-symbols-rounded text-4xl">smart_display</span>
                        <p class="text-xs">No video URL set yet. Default interactive cockpit tour will be displayed on the landing page.</p>
                    </div>
                \`;
                return;
            }

            const cleanUrl = url.trim();

            // Check if YouTube
            let ytId = null;
            if (cleanUrl.includes('youtube.com/watch')) {
                const match = cleanUrl.match(/[?&]v=([^&]+)/);
                if (match) ytId = match[1];
            } else if (cleanUrl.includes('youtu.be/')) {
                const parts = cleanUrl.split('youtu.be/');
                if (parts[1]) ytId = parts[1].split(/[?&]/)[0];
            } else if (cleanUrl.includes('youtube.com/embed/')) {
                const parts = cleanUrl.split('youtube.com/embed/');
                if (parts[1]) ytId = parts[1].split(/[?&]/)[0];
            }

            if (ytId) {
                container.innerHTML = \`<iframe src="https://www.youtube.com/embed/\${ytId}?rel=0" class="w-full h-full border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>\`;
                return;
            }

            // Check if Vimeo
            if (cleanUrl.includes('vimeo.com/')) {
                const vParts = cleanUrl.split('vimeo.com/');
                const vId = vParts[1] ? vParts[1].split(/[?&]/)[0] : '';
                if (vId) {
                    container.innerHTML = \`<iframe src="https://player.vimeo.com/video/\${vId}" class="w-full h-full border-0" allowfullscreen></iframe>\`;
                    return;
                }
            }

            // Direct Video (mp4, webm, Cloudinary)
            container.innerHTML = \`<video src="\${cleanUrl}" controls class="w-full h-full object-contain"></video>\`;
        }

        // Initialize preview on load
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.getElementById('videoUrl');
            if (input) updateLiveVideoPreview(input.value);
        });
    </script>
</body>
</html>
