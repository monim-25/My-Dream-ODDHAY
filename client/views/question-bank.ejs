<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Question Bank | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'questions' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative">
            
            <!-- ON-SCREEN SEARCH & CUSTOM FILTER BAR (Placed directly on screen, ideal for small screens) -->
            <div class="sticky top-0 z-20 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 px-3 sm:px-4 py-2.5 sm:py-3 shadow-2xs shrink-0">
                <div class="max-w-7xl w-full mx-auto space-y-2">
                    
                    <!-- ROW 1: LIVE SEARCH INPUT (Placed on screen in normal place) -->
                    <div class="relative w-full">
                        <div class="absolute left-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none select-none text-slate-400 dark:text-slate-500">
                            <span class="material-symbols-rounded text-[19px] leading-none">search</span>
                        </div>
                        <input type="text" id="qb-screen-search-input"
                            oninput="qbExplorer.onSearch(this.value)"
                            onkeyup="qbExplorer.onSearch(this.value)"
                            placeholder="Search question bank, subject, board, year..."
                            value="<%= locals.search || '' %>"
                            class="w-full h-11 pl-10 pr-9 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 rounded-xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 shadow-2xs transition-all">
                        <button type="button" id="qb-screen-clear-search-btn" onclick="qbExplorer.clearSearch()"
                            class="<%= (locals.search && locals.search.trim().length > 0) ? 'flex' : 'hidden' %> absolute right-2.5 top-1/2 -translate-y-1/2 size-6 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white items-center justify-center transition-colors cursor-pointer select-none">
                            <span class="material-symbols-rounded text-base">cancel</span>
                        </button>
                    </div>

                    <!-- ROW 2: TOUCH-FRIENDLY PLATFORM DROPDOWNS (Unclipped 2x2 Grid on Mobile, 4-Col on Desktop) -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 w-full">
                        
                        <!-- 1. SUBJECT DROPDOWN -->
                        <div class="relative w-full" id="qb-subject-dropdown-container">
                            <button type="button" id="qb-subject-dropdown-btn" onclick="toggleQbDropdown('subject', event)"
                                class="w-full h-10 sm:h-10.5 px-2.5 sm:px-3 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs sm:text-[13px] font-bold rounded-xl flex items-center justify-between gap-1 transition-all active:scale-95 shadow-2xs"
                                title="Filter by Subject">
                                <div class="flex items-center gap-1.5 min-w-0 truncate">
                                    <span class="material-symbols-rounded text-primary text-base sm:text-lg leading-none shrink-0">menu_book</span>
                                    <span id="qb-subject-selected-label" class="truncate font-bold">
                                        <%= activeSubject && activeSubject !== 'all' ? activeSubject : 'All Subjects' %>
                                    </span>
                                </div>
                                <span id="qb-subject-arrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                            </button>

                            <!-- Subject Popover Menu -->
                            <div id="qb-subject-dropdown-menu"
                                class="hidden absolute left-0 top-full mt-1.5 w-56 sm:w-64 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-2xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                                <button type="button" onclick="selectQbSubject('all')" data-subject-opt="all"
                                    class="qb-subject-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeSubject === 'all' ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                    <span class="flex items-center gap-2">
                                        <span class="opt-dot size-1.5 rounded-full <%= activeSubject === 'all' ? 'bg-primary' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                        <span>All Subjects</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-primary <%= activeSubject === 'all' ? 'inline' : 'hidden' %>">check</span>
                                </button>
                                <% (subjects || []).forEach(function(sub) { %>
                                    <button type="button" onclick="selectQbSubject('<%= sub.replace(/'/g, "\\'") %>')" data-subject-opt="<%= sub %>"
                                        class="qb-subject-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeSubject === sub ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                        <span class="flex items-center gap-2 min-w-0">
                                            <span class="opt-dot size-1.5 rounded-full shrink-0 <%= activeSubject === sub ? 'bg-primary' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                            <span class="truncate"><%= sub %></span>
                                        </span>
                                        <span class="opt-check material-symbols-rounded text-base text-primary shrink-0 <%= activeSubject === sub ? 'inline' : 'hidden' %>">check</span>
                                    </button>
                                <% }); %>
                            </div>
                        </div>

                        <!-- 2. BOARD DROPDOWN -->
                        <div class="relative w-full" id="qb-board-dropdown-container">
                            <button type="button" id="qb-board-dropdown-btn" onclick="toggleQbDropdown('board', event)"
                                class="w-full h-10 sm:h-10.5 px-2.5 sm:px-3 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs sm:text-[13px] font-bold rounded-xl flex items-center justify-between gap-1 transition-all active:scale-95 shadow-2xs"
                                title="Filter by Board">
                                <div class="flex items-center gap-1.5 min-w-0 truncate">
                                    <span class="material-symbols-rounded text-indigo-500 text-base sm:text-lg leading-none shrink-0">account_balance</span>
                                    <span id="qb-board-selected-label" class="truncate font-bold">
                                        <%= activeBoard && activeBoard !== 'all' ? activeBoard : 'All Boards' %>
                                    </span>
                                </div>
                                <span id="qb-board-arrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                            </button>

                            <!-- Board Popover Menu -->
                            <div id="qb-board-dropdown-menu"
                                class="hidden absolute right-0 sm:left-0 top-full mt-1.5 w-52 sm:w-56 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-2xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                                <button type="button" onclick="selectQbBoard('all')" data-board-opt="all"
                                    class="qb-board-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeBoard === 'all' ? 'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                    <span class="flex items-center gap-2">
                                        <span class="opt-dot size-1.5 rounded-full <%= activeBoard === 'all' ? 'bg-indigo-500' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                        <span>All Boards</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-indigo-600 dark:text-indigo-400 <%= activeBoard === 'all' ? 'inline' : 'hidden' %>">check</span>
                                </button>
                                <% (boards || []).forEach(function(b) { %>
                                    <button type="button" onclick="selectQbBoard('<%= b.replace(/'/g, "\\'") %>')" data-board-opt="<%= b %>"
                                        class="qb-board-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeBoard === b ? 'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                        <span class="flex items-center gap-2 min-w-0">
                                            <span class="opt-dot size-1.5 rounded-full shrink-0 <%= activeBoard === b ? 'bg-indigo-500' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                            <span class="truncate"><%= b %></span>
                                        </span>
                                        <span class="opt-check material-symbols-rounded text-base text-indigo-600 dark:text-indigo-400 shrink-0 <%= activeBoard === b ? 'inline' : 'hidden' %>">check</span>
                                    </button>
                                <% }); %>
                            </div>
                        </div>

                        <!-- 3. YEAR DROPDOWN -->
                        <div class="relative w-full" id="qb-year-dropdown-container">
                            <button type="button" id="qb-year-dropdown-btn" onclick="toggleQbDropdown('year', event)"
                                class="w-full h-10 sm:h-10.5 px-2.5 sm:px-3 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs sm:text-[13px] font-bold rounded-xl flex items-center justify-between gap-1 transition-all active:scale-95 shadow-2xs"
                                title="Filter by Year">
                                <div class="flex items-center gap-1.5 min-w-0 truncate">
                                    <span class="material-symbols-rounded text-amber-500 text-base sm:text-lg leading-none shrink-0">calendar_today</span>
                                    <span id="qb-year-selected-label" class="truncate font-bold">
                                        <%= activeYear && activeYear !== 'all' ? activeYear : 'All Years' %>
                                    </span>
                                </div>
                                <span id="qb-year-arrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                            </button>

                            <!-- Year Popover Menu -->
                            <div id="qb-year-dropdown-menu"
                                class="hidden absolute left-0 top-full mt-1.5 w-44 sm:w-48 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-2xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                                <button type="button" onclick="selectQbYear('all')" data-year-opt="all"
                                    class="qb-year-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeYear === 'all' ? 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                    <span class="flex items-center gap-2">
                                        <span class="opt-dot size-1.5 rounded-full <%= activeYear === 'all' ? 'bg-amber-500' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                        <span>All Years</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-amber-600 dark:text-amber-400 <%= activeYear === 'all' ? 'inline' : 'hidden' %>">check</span>
                                </button>
                                <% (years || []).forEach(function(y) { %>
                                    <button type="button" onclick="selectQbYear('<%= y %>')" data-year-opt="<%= y %>"
                                        class="qb-year-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors <%= activeYear === y ? 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold' : 'hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium' %>">
                                        <span class="flex items-center gap-2 min-w-0">
                                            <span class="opt-dot size-1.5 rounded-full shrink-0 <%= activeYear === y ? 'bg-amber-500' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
                                            <span class="truncate"><%= y %></span>
                                        </span>
                                        <span class="opt-check material-symbols-rounded text-base text-amber-600 dark:text-amber-400 shrink-0 <%= activeYear === y ? 'inline' : 'hidden' %>">check</span>
                                    </button>
                                <% }); %>
                            </div>
                        </div>

                        <!-- 4. ACCESS / TYPE DROPDOWN -->
                        <div class="relative w-full" id="qb-access-dropdown-container">
                            <button type="button" id="qb-access-dropdown-btn" onclick="toggleQbDropdown('access', event)"
                                class="w-full h-10 sm:h-10.5 px-2.5 sm:px-3 bg-slate-50 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-xs sm:text-[13px] font-bold rounded-xl flex items-center justify-between gap-1 transition-all active:scale-95 shadow-2xs"
                                title="Filter by Type/Access">
                                <div class="flex items-center gap-1.5 min-w-0 truncate">
                                    <span class="material-symbols-rounded text-teal-600 dark:text-teal-400 text-base sm:text-lg leading-none shrink-0">tune</span>
                                    <span id="qb-access-selected-label" class="truncate font-bold">All Types</span>
                                </div>
                                <span id="qb-access-arrow" class="material-symbols-rounded text-slate-400 dark:text-slate-500 text-base leading-none shrink-0 transition-transform duration-200">expand_more</span>
                            </button>

                            <!-- Access Popover Menu -->
                            <div id="qb-access-dropdown-menu"
                                class="hidden absolute right-0 top-full mt-1.5 w-52 sm:w-56 max-h-64 overflow-y-auto no-scrollbar rounded-xl bg-white dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 shadow-2xl z-50 py-1 divide-y divide-slate-100 dark:divide-slate-800/60">
                                <button type="button" onclick="selectQbAccess('all')" data-access-opt="all"
                                    class="qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-teal-50 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400 font-bold">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-teal-600 dark:text-teal-400">auto_awesome</span>
                                        <span>All Types</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-teal-600 dark:text-teal-400 inline">check</span>
                                </button>
                                <button type="button" onclick="selectQbAccess('free')" data-access-opt="free"
                                    class="qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-emerald-500">card_giftcard</span>
                                        <span>Free</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-teal-600 dark:text-teal-400 hidden">check</span>
                                </button>
                                <button type="button" onclick="selectQbAccess('paid')" data-access-opt="paid"
                                    class="qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-amber-500">diamond</span>
                                        <span>Paid</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-teal-600 dark:text-teal-400 hidden">check</span>
                                </button>
                                <button type="button" onclick="selectQbAccess('bought')" data-access-opt="bought"
                                    class="qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-indigo-500">verified_user</span>
                                        <span>My Archives</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-teal-600 dark:text-teal-400 hidden">check</span>
                                </button>
                                <button type="button" onclick="selectQbAccess('saved')" data-access-opt="saved"
                                    class="qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-amber-500" style="font-variation-settings: 'FILL' 1;">bookmark</span>
                                        <span>Saved</span>
                                    </span>
                                    <span class="opt-check material-symbols-rounded text-base text-teal-600 dark:text-teal-400 hidden">check</span>
                                </button>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <!-- MAIN WORKSPACE CONTAINER FOR CARDS -->
            <div id="qb-workspace-content" class="max-w-7xl w-full mx-auto px-3 sm:px-4 pt-3 sm:pt-4 flex-1 flex flex-col space-y-3 pb-24 sm:pb-28 lg:pb-8">
                
                <!-- BREADCRUMB, RESET & ITEMS COUNTER -->
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 truncate">
                            <span id="qb-breadcrumb-container">All Question Archives</span>
                        </span>
                        <% const hasInitialFilters = (activeSubject !== 'all' || activeBoard !== 'all' || activeYear !== 'all' || (search && search.trim().length > 0)); %>
                        <button type="button" onclick="resetAllQbFilters()" id="qb-reset-filters-btn"
                            class="<%= hasInitialFilters ? 'flex' : 'hidden' %> text-[11px] font-bold text-rose-600 dark:text-rose-400 hover:underline items-center gap-0.5 shrink-0 bg-rose-50 dark:bg-rose-500/10 px-2 py-0.5 rounded-md border border-rose-200 dark:border-rose-500/20">
                            <span class="material-symbols-rounded text-xs leading-none">restart_alt</span>
                            <span>Reset</span>
                        </button>
                    </div>

                    <span id="qb-items-counter" class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary border border-primary/20 text-[11px] font-semibold flex items-center gap-1.5 shrink-0">
                        <span class="material-symbols-rounded text-xs sm:text-sm leading-none">archive</span>
                        <span id="qb-items-counter-text"><%= questions.length %> Available</span>
                    </span>
                </div>

                <!-- QUESTION PAPERS GRID -->
                <div id="qb-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
                    <% questions.forEach(function(q) { %>
                        <% 
                           const qTitle = q.title || ((q.subject || 'Subject') + ' - ' + (q.board || 'Board Exam'));
                           const qBoard = (q.board || 'General Board').trim();
                           const qSubject = (q.subject || 'General Academic').trim();
                           const qYear = (q.year || '').trim();
                           const qClass = Array.isArray(q.classLevel) ? q.classLevel.join(', ') : (q.classLevel || userClass);
                           const fileUrl = q.fileUrl || q.filePath || '#';
                           const isPdf = Boolean(fileUrl && fileUrl !== '#' && fileUrl !== 'undefined' && fileUrl.toLowerCase().endsWith('.pdf'));
                           const hasFile = Boolean(fileUrl && fileUrl !== '#' && fileUrl !== 'undefined');
                           const searchable = [qTitle, qBoard, qSubject, qYear, qClass].join(' ').toLowerCase();
                           const safeTitle = qTitle.replace(/'/g, "\\'");
                           const safeFileUrl = fileUrl.replace(/'/g, "\\'");
                        %>
                        <div class="qb-paper-card bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/70 rounded-xl sm:rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-primary/50 dark:hover:border-primary/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-2.5"
                             data-id="<%= q._id %>"
                             data-search="<%= searchable %>"
                             data-board="<%= qBoard.toLowerCase() %>"
                             data-subject="<%= qSubject.toLowerCase() %>"
                             data-year="<%= qYear.toLowerCase() %>"
                             data-class="<%= qClass.toLowerCase() %>"
                             data-free="<%= q.isFree ? 'true' : 'false' %>"
                             data-paid="<%= !q.isFree ? 'true' : 'false' %>"
                             data-bought="<%= q.isBought ? 'true' : 'false' %>"
                             data-saved="<%= q.isSaved ? 'true' : 'false' %>">
                            
                            <div>
                                <!-- BADGES & SAVE HEADER -->
                                <div class="flex items-center justify-between gap-1.5 mb-2">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold bg-primary/10 text-primary border border-primary/20">
                                            <%= qSubject %>
                                        </span>
                                        <% if (qYear) { %>
                                            <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600">
                                                <%= qYear %>
                                            </span>
                                        <% } %>
                                        <% if (!q.isFree) { %>
                                            <% if (q.isBought) { %>
                                                <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold bg-teal-50 dark:bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-200 dark:border-teal-500/20 flex items-center gap-0.5">
                                                    <span class="material-symbols-rounded text-xs text-teal-500">verified</span>
                                                    <span>Purchased</span>
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/20 flex items-center gap-0.5">
                                                    <span class="material-symbols-rounded text-xs text-amber-500">diamond</span>
                                                    <span>Paid (৳<%= q.price || 0 %>)</span>
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 flex items-center gap-0.5">
                                                <span class="material-symbols-rounded text-xs text-emerald-500">auto_awesome</span>
                                                <span>Free</span>
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- SAVE / BOOKMARK BUTTON -->
                                    <button type="button" onclick="qbExplorer.toggleSave(event, '<%= q._id %>', this)" 
                                            class="qb-save-btn size-7.5 sm:size-8 rounded-xl bg-slate-100 dark:bg-slate-700/80 hover:bg-amber-50 dark:hover:bg-amber-500/20 text-slate-400 hover:text-amber-500 transition-all flex items-center justify-center border border-slate-200 dark:border-slate-600 shrink-0" 
                                            title="<%= q.isSaved ? 'Remove from Saved' : 'Save Question Bank' %>">
                                        <span class="material-symbols-rounded text-sm sm:text-base leading-none flex items-center justify-center select-none <%= q.isSaved ? 'text-amber-500' : '' %>"
                                              style="<%= q.isSaved ? "font-variation-settings: 'FILL' 1;" : "font-variation-settings: 'FILL' 0;" %>">
                                            <%= q.isSaved ? 'bookmark' : 'bookmark_border' %>
                                        </span>
                                    </button>
                                </div>

                                <!-- CARD TITLE -->
                                <% if (!q.isFree && !q.isBought) { %>
                                    <h3 class="text-xs sm:text-[13px] font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 mb-2">
                                        <%= qTitle %>
                                    </h3>
                                <% } else { %>
                                    <a href="/question-bank/view/<%= q._id %>" class="block mb-2 group/title">
                                        <h3 class="text-xs sm:text-[13px] font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover/title:text-primary transition-colors">
                                            <%= qTitle %>
                                        </h3>
                                    </a>
                                <% } %>

                                <!-- BOARD & PRACTICE INFO -->
                                <div class="space-y-1 mb-2.5 text-[11px] font-medium text-slate-400 dark:text-slate-500">
                                    <p class="flex items-center gap-1.5 truncate">
                                        <span class="material-symbols-rounded text-sm text-primary leading-none flex items-center justify-center select-none">account_balance</span>
                                        <span class="truncate"><%= qBoard %></span>
                                    </p>
                                    <% if (q.hasPractice) { %>
                                        <p class="flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400 font-bold truncate">
                                            <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center select-none">quiz</span>
                                            <span><%= q.questionCount %> MCQs Practice</span>
                                        </p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- CARD ACTIONS -->
                            <div class="pt-2.5 border-t border-slate-100 dark:border-slate-700/60">
                                <% if (!q.isFree && !q.isBought) { %>
                                    <!-- Locked Paid State: Show Buy / Unlock Button Only -->
                                    <a href="/question-bank/checkout/<%= q._id %>" class="w-full h-9 sm:h-9.5 px-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 hover:from-amber-600 hover:to-orange-600 text-white text-xs font-bold transition-all duration-200 flex items-center justify-center gap-1.5 shadow-md shadow-amber-500/20 hover:shadow-amber-500/30 active:scale-95 group">
                                        <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none group-hover:scale-110 transition-transform">shopping_cart</span>
                                        <span>Purchase ৳<%= q.price || 0 %></span>
                                    </a>
                                <% } else { %>
                                    <!-- Unlocked / Free State -> View (always opens view page), Download (if PDF), Solve (if MCQs) -->
                                    <div class="flex items-center justify-between gap-1.5 sm:gap-2">
                                        <div class="flex items-center gap-1.5 flex-1">
                                            <a href="/question-bank/view/<%= q._id %>" class="h-9 sm:h-9.5 px-3 rounded-xl bg-gradient-to-r from-sky-500/10 via-blue-500/10 to-indigo-500/10 hover:from-sky-500/20 hover:via-blue-500/20 hover:to-indigo-500/20 text-sky-600 dark:text-sky-400 text-xs font-bold transition-all duration-200 flex items-center justify-center gap-1.5 border border-sky-500/25 hover:border-sky-500/40 active:scale-95 flex-1 group">
                                                <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none group-hover:scale-110 transition-transform">visibility</span>
                                                <span>View</span>
                                            </a>
                                            <% if (isPdf) { %>
                                                <a href="<%= fileUrl %>" download class="size-9 sm:size-9.5 rounded-xl bg-slate-100 dark:bg-slate-700/80 hover:bg-emerald-500/15 text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-200 flex items-center justify-center border border-slate-200 dark:border-slate-600 hover:border-emerald-500/30 active:scale-95 shrink-0" title="Download PDF Asset">
                                                    <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none group-hover:scale-110 transition-transform">download</span>
                                                </a>
                                            <% } %>
                                        </div>
                                        <% if (q.hasPractice) { %>
                                            <a href="/question-bank/solve/<%= q._id %>" class="h-9 sm:h-9.5 px-3.5 rounded-xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500 hover:from-emerald-500 hover:via-teal-500 hover:to-emerald-400 text-white text-xs font-bold transition-all duration-200 flex items-center justify-center gap-1.5 shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-600/40 active:scale-95 group shrink-0">
                                                <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none group-hover:scale-110 transition-transform">play_arrow</span>
                                                <span>Take Exam</span>
                                            </a>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>

                        </div>
                    <% }); %>
                </div>

                <!-- EMPTY STATE -->
                <div id="qb-empty-state" class="hidden py-10 text-center bg-white dark:bg-[#0f172a] rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                    <div class="size-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-2">
                        <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center select-none">search_off</span>
                    </div>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white">No Question Papers Found</h3>
                    <p class="text-[10px] font-medium text-slate-400 mt-0.5">Try adjusting your search or filter selection</p>
                    <button onclick="qbExplorer.resetAllFilters()" class="mt-2.5 px-3 py-1 rounded-lg bg-primary hover:bg-primary/90 text-white text-xs font-bold transition-colors">
                        Reset Filters
                    </button>
                </div>
            </div>

        </main>
    </div>

    <!-- PDF PREVIEW MODAL -->
    <div id="qb-pdf-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-3 lg:p-6">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-4xl h-[85vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-800/50">
                <div class="flex items-center gap-2 truncate pr-2">
                    <span class="material-symbols-rounded text-primary text-xl leading-none flex items-center justify-center select-none">picture_as_pdf</span>
                    <h3 id="qb-modal-title" class="font-bold text-xs sm:text-sm text-slate-800 dark:text-white truncate">Question Paper Document</h3>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <a id="qb-modal-download" href="#" download class="px-3 py-1 rounded-lg bg-primary hover:bg-primary/90 text-white text-xs font-bold transition-colors flex items-center gap-1">
                        <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center select-none">download</span>
                        <span>Download</span>
                    </a>
                    <button onclick="qbExplorer.closePdfModal()" class="size-7 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-rose-500 flex items-center justify-center transition-colors">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center select-none">close</span>
                    </button>
                </div>
            </div>
            <div class="flex-1 bg-slate-100 dark:bg-slate-900 overflow-hidden relative">
                <iframe id="qb-modal-iframe" src="" class="w-full h-full border-none"></iframe>
            </div>
        </div>
    </div>

    <!-- INTERACTIVE SOLVE & PRACTICE MODAL -->
    <div id="qb-practice-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-3 lg:p-6">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-3.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-indigo-50 dark:bg-indigo-500/10">
                <div class="flex items-center gap-2 truncate pr-2">
                    <span class="material-symbols-rounded text-indigo-600 dark:text-indigo-400 text-xl leading-none flex items-center justify-center select-none">quiz</span>
                    <div>
                        <h3 id="qb-practice-title" class="font-bold text-xs sm:text-sm text-slate-800 dark:text-white truncate">Interactive Solve & Practice</h3>
                        <p id="qb-practice-progress" class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400">Loading questions...</p>
                    </div>
                </div>
                <button onclick="qbExplorer.closePracticeModal()" class="size-7 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-rose-500 flex items-center justify-center transition-colors shrink-0">
                    <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center select-none">close</span>
                </button>
