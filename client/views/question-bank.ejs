    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'questions' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        // Standalone Dropdown Toggle & Filter Handlers
        function toggleQbDropdown(type, e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const types = ['subject', 'board', 'year', 'access'];
            types.forEach(t => {
                if (t !== type) {
                    const menu = document.getElementById(`qb-${t}-dropdown-menu`);
                    const arrow = document.getElementById(`qb-${t}-arrow`);
                    if (menu) menu.classList.add('hidden');
                    if (arrow) arrow.style.transform = 'rotate(0deg)';
                }
            });

            const targetMenu = document.getElementById(`qb-${type}-dropdown-menu`);
            const targetArrow = document.getElementById(`qb-${type}-arrow`);
            if (targetMenu) {
                const isHidden = targetMenu.classList.contains('hidden');
                if (isHidden) {
                    targetMenu.classList.remove('hidden');
                    if (targetArrow) targetArrow.style.transform = 'rotate(180deg)';
                } else {
                    targetMenu.classList.add('hidden');
                    if (targetArrow) targetArrow.style.transform = 'rotate(0deg)';
                }
            }
        }

        function closeAllQbDropdowns() {
            ['subject', 'board', 'year', 'access'].forEach(t => {
                const menu = document.getElementById(`qb-${t}-dropdown-menu`);
                const arrow = document.getElementById(`qb-${t}-arrow`);
                if (menu) menu.classList.add('hidden');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
            });
        }

        function selectQbSubject(val) {
            if (window.qbExplorer) {
                window.qbExplorer.selectSubject(val);
            }
        }

        function selectQbBoard(val) {
            if (window.qbExplorer) {
                window.qbExplorer.selectBoard(val);
            }
        }

        function selectQbYear(val) {
            if (window.qbExplorer) {
                window.qbExplorer.selectYear(val);
            }
        }

        function selectQbAccess(val) {
            if (window.qbExplorer) {
                window.qbExplorer.selectAccess(val);
            }
        }

        function resetAllQbFilters() {
            if (window.qbExplorer) {
                window.qbExplorer.resetAllFilters();
            }
        }

        class QuestionBankExplorer {
            constructor() {
                const screenInput = document.getElementById('qb-screen-search-input');
                const headerNavInput = document.getElementById('qb-search-input-header');
                const initialSearch = (screenInput && screenInput.value) || (headerNavInput && headerNavInput.value) || '<%= (locals.search || "").replace(/'/g, "\\'") %>';
                this.searchQuery = (initialSearch || '').trim().toLowerCase();
                this.selectedSubject = '<%= activeSubject || "all" %>'.trim();
                this.selectedBoard = '<%= activeBoard || "all" %>'.trim();
                this.selectedYear = '<%= activeYear || "all" %>'.trim();
                this.selectedAccess = 'all';
                this.userClass = '<%= userClass %>'.trim().toLowerCase();

                this.init();
            }

            init() {
                const screenInput = document.getElementById('qb-screen-search-input');
                if (screenInput && !screenInput.value && this.searchQuery) {
                    screenInput.value = this.searchQuery;
                }
                const headerNavInput = document.getElementById('qb-search-input-header');
                if (headerNavInput && !headerNavInput.value && this.searchQuery) {
                    headerNavInput.value = this.searchQuery;
                }
                const screenClearBtn = document.getElementById('qb-screen-clear-search-btn');
                if (screenClearBtn) {
                    if (this.searchQuery.length > 0) {
                        screenClearBtn.classList.remove('hidden');
                        screenClearBtn.classList.add('flex');
                    } else {
                        screenClearBtn.classList.add('hidden');
                        screenClearBtn.classList.remove('flex');
                    }
                }
                const clearBtn = document.getElementById('qb-clear-search-btn');
                if (clearBtn) {
                    if (this.searchQuery.length > 0) clearBtn.classList.remove('hidden');
                    else clearBtn.classList.add('hidden');
                }
                this.render();
            }

            toggleDropdown(type, event) {
                if (event) {
                    event.stopPropagation();
                }
                const types = ['subject', 'board', 'year', 'access'];
                types.forEach(t => {
                    if (t !== type) {
                        const menu = document.getElementById(`qb-${t}-dropdown-menu`);
                        const arrow = document.getElementById(`qb-${t}-arrow`);
                        if (menu) menu.classList.add('hidden');
                        if (arrow) arrow.classList.remove('rotate-180');
                    }
                });
                const targetMenu = document.getElementById(`qb-${type}-dropdown-menu`);
                const targetArrow = document.getElementById(`qb-${type}-arrow`);
                if (targetMenu) {
                    const isHidden = targetMenu.classList.contains('hidden');
                    if (isHidden) {
                        targetMenu.classList.remove('hidden');
                        if (targetArrow) targetArrow.classList.add('rotate-180');
                    } else {
                        targetMenu.classList.add('hidden');
                        if (targetArrow) targetArrow.classList.remove('rotate-180');
                    }
                }
            }

            closeAllDropdowns() {
                ['subject', 'board', 'year', 'access'].forEach(t => {
                    const menu = document.getElementById(`qb-${t}-dropdown-menu`);
                    const arrow = document.getElementById(`qb-${t}-arrow`);
                    if (menu) menu.classList.add('hidden');
                    if (arrow) arrow.classList.remove('rotate-180');
                });
            }

            onSearch(val) {
                this.searchQuery = (val || '').trim().toLowerCase();
                const screenInput = document.getElementById('qb-screen-search-input');
                if (screenInput && screenInput.value !== val) {
                    screenInput.value = val;
                }
                const headerNavInput = document.getElementById('qb-search-input-header');
                if (headerNavInput && headerNavInput.value !== val) {
                    headerNavInput.value = val;
                }
                const screenClearBtn = document.getElementById('qb-screen-clear-search-btn');
                if (screenClearBtn) {
                    if (this.searchQuery.length > 0) {
                        screenClearBtn.classList.remove('hidden');
                        screenClearBtn.classList.add('flex');
                    } else {
                        screenClearBtn.classList.add('hidden');
                        screenClearBtn.classList.remove('flex');
                    }
                }
                const clearBtn = document.getElementById('qb-clear-search-btn');
                if (clearBtn) {
                    if (this.searchQuery.length > 0) clearBtn.classList.remove('hidden');
                    else clearBtn.classList.add('hidden');
                }
                this.render();
            }

            clearSearch() {
                const screenInput = document.getElementById('qb-screen-search-input');
                if (screenInput) screenInput.value = '';
                const navInput = document.getElementById('qb-search-input-header');
                if (navInput) navInput.value = '';
                this.onSearch('');
            }

            selectSubject(val) {
                this.selectedSubject = (val || 'all').trim();
                const label = document.getElementById('qb-subject-selected-label');
                if (label) label.textContent = this.selectedSubject !== 'all' ? this.selectedSubject : 'All Subjects';

                document.querySelectorAll('.qb-subject-opt').forEach(opt => {
                    const optVal = opt.getAttribute('data-subject-opt');
                    const isMatch = optVal === this.selectedSubject;
                    const dot = opt.querySelector('.opt-dot');
                    const check = opt.querySelector('.opt-check');
                    if (isMatch) {
                        opt.className = 'qb-subject-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-primary/10 text-primary font-bold';
                        if (dot) { dot.classList.remove('bg-slate-300', 'dark:bg-slate-600'); dot.classList.add('bg-primary'); }
                        if (check) check.classList.remove('hidden');
                    } else {
                        opt.className = 'qb-subject-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium';
                        if (dot) { dot.classList.remove('bg-primary'); dot.classList.add('bg-slate-300', 'dark:bg-slate-600'); }
                        if (check) check.classList.add('hidden');
                    }
                });
                this.closeAllDropdowns();
                this.render();
            }

            selectBoard(val) {
                this.selectedBoard = (val || 'all').trim();
                const label = document.getElementById('qb-board-selected-label');
                if (label) label.textContent = this.selectedBoard !== 'all' ? this.selectedBoard : 'All Boards';

                document.querySelectorAll('.qb-board-opt').forEach(opt => {
                    const optVal = opt.getAttribute('data-board-opt');
                    const isMatch = optVal === this.selectedBoard;
                    const dot = opt.querySelector('.opt-dot');
                    const check = opt.querySelector('.opt-check');
                    if (isMatch) {
                        opt.className = 'qb-board-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold';
                        if (dot) { dot.classList.remove('bg-slate-300', 'dark:bg-slate-600'); dot.classList.add('bg-indigo-500'); }
                        if (check) check.classList.remove('hidden');
                    } else {
                        opt.className = 'qb-board-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium';
                        if (dot) { dot.classList.remove('bg-indigo-500'); dot.classList.add('bg-slate-300', 'dark:bg-slate-600'); }
                        if (check) check.classList.add('hidden');
                    }
                });
                this.closeAllDropdowns();
                this.render();
            }

            selectYear(val) {
                this.selectedYear = (val || 'all').trim();
                const label = document.getElementById('qb-year-selected-label');
                if (label) label.textContent = this.selectedYear !== 'all' ? this.selectedYear : 'All Years';

                document.querySelectorAll('.qb-year-opt').forEach(opt => {
                    const optVal = opt.getAttribute('data-year-opt');
                    const isMatch = optVal === this.selectedYear;
                    const dot = opt.querySelector('.opt-dot');
                    const check = opt.querySelector('.opt-check');
                    if (isMatch) {
                        opt.className = 'qb-year-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold';
                        if (dot) { dot.classList.remove('bg-slate-300', 'dark:bg-slate-600'); dot.classList.add('bg-amber-500'); }
                        if (check) check.classList.remove('hidden');
                    } else {
                        opt.className = 'qb-year-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium';
                        if (dot) { dot.classList.remove('bg-amber-500'); dot.classList.add('bg-slate-300', 'dark:bg-slate-600'); }
                        if (check) check.classList.add('hidden');
                    }
                });
                this.closeAllDropdowns();
                this.render();
            }

            selectAccess(val) {
                this.selectedAccess = (val || 'all').trim().toLowerCase();
                const labelMap = {
                    'all': 'All Types',
                    'free': 'Free Only',
                    'paid': 'Paid Only',
                    'bought': 'My Archives',
                    'saved': 'Saved Only'
                };
                const label = document.getElementById('qb-access-selected-label');
                if (label) label.textContent = labelMap[this.selectedAccess] || 'All Types';

                document.querySelectorAll('.qb-access-opt').forEach(opt => {
                    const optVal = opt.getAttribute('data-access-opt');
                    const isMatch = optVal === this.selectedAccess;
                    const check = opt.querySelector('.opt-check');
                    if (isMatch) {
                        opt.className = 'qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors bg-teal-50 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400 font-bold';
                        if (check) check.classList.remove('hidden');
                    } else {
                        opt.className = 'qb-access-opt w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium';
                        if (check) check.classList.add('hidden');
                    }
                });
                this.closeAllDropdowns();
                this.render();
            }

            // Compatibility wrappers
            onSelectSubject(val) { this.selectSubject(val); }
            onSelectBoard(val) { this.selectBoard(val); }
            onSelectYear(val) { this.selectYear(val); }
            onSelectAccess(val) { this.selectAccess(val); }

            async toggleSave(e, bankId, btn) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                try {
                    const response = await fetch(`/api/question-bank/${bankId}/save`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        const card = btn.closest('.qb-paper-card');
                        if (card) {
                            card.setAttribute('data-saved', data.isSaved ? 'true' : 'false');
                        }
                        const icon = btn.querySelector('.material-symbols-rounded');
                        if (icon) {
                            if (data.isSaved) {
                                icon.textContent = 'bookmark';
                                icon.classList.add('text-amber-500');
                                icon.style.fontVariationSettings = "'FILL' 1";
                                btn.title = 'Remove from Saved';
                            } else {
                                icon.textContent = 'bookmark_border';
                                icon.classList.remove('text-amber-500');
                                icon.style.fontVariationSettings = "'FILL' 0";
                                btn.title = 'Save Question Bank';
                            }
                        }
                        if (this.selectedAccess === 'saved') this.render();
                    }
                } catch (err) {
                    console.error('Bookmark error:', err);
                }
            }

            resetAllFilters() {
                this.clearSearch();
                this.selectSubject('all');
                this.selectBoard('all');
                this.selectYear('all');
                this.selectAccess('all');
            }

            render() {
                const cards = document.querySelectorAll('.qb-paper-card');
                let visibleCount = 0;

                cards.forEach(card => {
                    const searchable = card.getAttribute('data-search') || '';
                    const board = card.getAttribute('data-board') || '';
                    const subject = card.getAttribute('data-subject') || '';
                    const year = card.getAttribute('data-year') || '';
                    const isFree = card.getAttribute('data-free') === 'true';
                    const isPaid = card.getAttribute('data-paid') === 'true';
                    const isBought = card.getAttribute('data-bought') === 'true';
                    const isSaved = card.getAttribute('data-saved') === 'true';

                    // 1. Search Query Filter (Multi-keyword smart match)
                    let matchesSearch = true;
                    if (this.searchQuery) {
                        const terms = this.searchQuery.toLowerCase().split(/\s+/).filter(Boolean);
                        matchesSearch = terms.every(term => searchable.includes(term));
                    }

                    // 2. Subject Filter
                    let matchesSubject = true;
                    if (this.selectedSubject !== 'all') {
                        const targetSub = this.selectedSubject.toLowerCase().trim();
                        const cleanCardSub = subject.toLowerCase().trim();

                        matchesSubject = cleanCardSub === targetSub || 
                                         cleanCardSub.includes(targetSub) || 
                                         targetSub.includes(cleanCardSub) ||
                                         (targetSub.includes('math') && cleanCardSub.includes('math')) ||
                                         (targetSub.includes('bangla') && cleanCardSub.includes('bangla')) ||
                                         (targetSub.includes('english') && cleanCardSub.includes('english')) ||
                                         searchable.includes(targetSub);
                    }

                    // 3. Board Filter
                    let matchesBoard = true;
                    if (this.selectedBoard !== 'all') {
                        const targetBoard = this.selectedBoard.toLowerCase();
                        matchesBoard = board.includes(targetBoard) || searchable.includes(targetBoard);
                    }

                    // 4. Year Filter
                    let matchesYear = true;
                    if (this.selectedYear !== 'all') {
                        matchesYear = year === this.selectedYear.toLowerCase();
                    }

                    // 5. Access Filter (All, Free, Paid, Bought, Saved)
                    let matchesAccess = true;
                    if (this.selectedAccess === 'free') {
                        matchesAccess = isFree;
                    } else if (this.selectedAccess === 'paid') {
                        matchesAccess = isPaid;
                    } else if (this.selectedAccess === 'bought') {
                        matchesAccess = isBought && !isFree;
                    } else if (this.selectedAccess === 'saved') {
                        matchesAccess = isSaved;
                    }

                    if (matchesSearch && matchesSubject && matchesBoard && matchesYear && matchesAccess) {
                        card.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                // Update Breadcrumb & Counters
                const counterTextEl = document.getElementById('qb-items-counter-text');
                if (counterTextEl) counterTextEl.textContent = visibleCount + (visibleCount === 1 ? ' Available' : ' Available');

                const breadcrumbContainer = document.getElementById('qb-breadcrumb-container');
                if (breadcrumbContainer) {
                    let parts = [];
                    if (this.selectedAccess !== 'all') {
                        const accessNames = {
                            'free': 'Free',
                            'paid': 'Paid',
                            'bought': 'My Archives',
                            'saved': 'Saved'
                        };
                        parts.push(`Type: ${accessNames[this.selectedAccess] || this.selectedAccess}`);
                    }
                    if (this.selectedSubject !== 'all') parts.push(`Subject: ${this.selectedSubject}`);
                    if (this.selectedBoard !== 'all') parts.push(`Board: ${this.selectedBoard}`);
                    if (this.selectedYear !== 'all') parts.push(`Year: ${this.selectedYear}`);
                    if (this.searchQuery) parts.push(`"${this.searchQuery}"`);

                    let text = parts.length > 0 ? parts.join(' • ') : 'All Question Archives';
                    breadcrumbContainer.textContent = text;
                }

                // Empty State
                const emptyState = document.getElementById('qb-empty-state');
                if (emptyState) {
                    if (visibleCount === 0) emptyState.classList.remove('hidden');
                    else emptyState.classList.add('hidden');
                }

                // Update Reset Button Visibility and Button Highlighting
                this.updateResetButtonVisibility();
            }

            updateResetButtonVisibility() {
                const resetBtn = document.getElementById('qb-reset-filters-btn');
                const isFiltered = Boolean(
                    (this.searchQuery && this.searchQuery.trim().length > 0) ||
                    (this.selectedSubject && this.selectedSubject !== 'all') ||
                    (this.selectedBoard && this.selectedBoard !== 'all') ||
                    (this.selectedYear && this.selectedYear !== 'all') ||
                    (this.selectedAccess && this.selectedAccess !== 'all')
                );
                if (resetBtn) {
                    if (isFiltered) {
                        resetBtn.classList.remove('hidden');
                        resetBtn.classList.add('flex');
                    } else {
                        resetBtn.classList.add('hidden');
                        resetBtn.classList.remove('flex');
                    }
                }

                // Highlight active dropdown buttons
                const subBtn = document.getElementById('qb-subject-dropdown-btn');
                if (subBtn) {
                    if (this.selectedSubject !== 'all') {
                        subBtn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
                    } else {
                        subBtn.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
                    }
                }
                const boardBtn = document.getElementById('qb-board-dropdown-btn');
                if (boardBtn) {
                    if (this.selectedBoard !== 'all') {
                        boardBtn.classList.add('border-indigo-500', 'bg-indigo-50/60', 'dark:bg-indigo-950/40', 'text-indigo-600', 'dark:text-indigo-400');
                    } else {
                        boardBtn.classList.remove('border-indigo-500', 'bg-indigo-50/60', 'dark:bg-indigo-950/40', 'text-indigo-600', 'dark:text-indigo-400');
                    }
                }
                const yearBtn = document.getElementById('qb-year-dropdown-btn');
                if (yearBtn) {
                    if (this.selectedYear !== 'all') {
                        yearBtn.classList.add('border-amber-500', 'bg-amber-50/60', 'dark:bg-amber-950/40', 'text-amber-600', 'dark:text-amber-400');
                    } else {
                        yearBtn.classList.remove('border-amber-500', 'bg-amber-50/60', 'dark:bg-amber-950/40', 'text-amber-600', 'dark:text-amber-400');
                    }
                }
                const accessBtn = document.getElementById('qb-access-dropdown-btn');
                if (accessBtn) {
                    if (this.selectedAccess !== 'all') {
                        accessBtn.classList.add('border-teal-500', 'bg-teal-50/60', 'dark:bg-teal-950/40', 'text-teal-600', 'dark:text-teal-400');
                    } else {
                        accessBtn.classList.remove('border-teal-500', 'bg-teal-50/60', 'dark:bg-teal-950/40', 'text-teal-600', 'dark:text-teal-400');
                    }
                }
            }

            openPdfModal(url, title) {
                const modal = document.getElementById('qb-pdf-modal');
                const iframe = document.getElementById('qb-modal-iframe');
                const titleEl = document.getElementById('qb-modal-title');
                const downloadBtn = document.getElementById('qb-modal-download');

                if (!modal || !iframe) return;

                titleEl.textContent = title || 'Question Paper Document';
                const isPdf = url && url !== '#' && url.toLowerCase().endsWith('.pdf');

                if (url && url !== '#') {
                    iframe.src = url;
                } else {
                    iframe.src = 'about:blank';
                }

                if (isPdf) {
                    downloadBtn.href = url;
                    downloadBtn.classList.remove('hidden');
                } else {
                    downloadBtn.classList.add('hidden');
                }

                modal.classList.remove('hidden');
            }

            closePdfModal() {
                const modal = document.getElementById('qb-pdf-modal');
                const iframe = document.getElementById('qb-modal-iframe');
                if (modal) modal.classList.add('hidden');
                if (iframe) iframe.src = 'about:blank';
            }

            async openPracticeModal(bankId, title) {
                const modal = document.getElementById('qb-practice-modal');
                const titleEl = document.getElementById('qb-practice-title');
                const progressEl = document.getElementById('qb-practice-progress');
                const bodyEl = document.getElementById('qb-practice-body');

                if (!modal || !bodyEl) return;

                titleEl.textContent = title;
                progressEl.textContent = 'Loading questions...';
                bodyEl.innerHTML = '<div class="py-6 text-center"><span class="material-symbols-rounded animate-spin text-2xl text-indigo-500 flex items-center justify-center select-none">sync</span></div>';
                modal.classList.remove('hidden');

                try {
                    const res = await fetch('/api/question-bank/' + bankId + '/questions');
                    const data = await res.json();

                    if (data.success && data.questions && data.questions.length > 0) {
                        progressEl.textContent = `${data.questions.length} Practice Questions`;
                        this.renderPracticeQuestions(data.questions, bodyEl);
                    } else {
                        progressEl.textContent = 'No practice questions found';
                        bodyEl.innerHTML = `
                            <div class="py-6 text-center space-y-1.5">
                                <span class="material-symbols-rounded text-2xl text-slate-400 flex items-center justify-center select-none">quiz</span>
                                <p class="text-xs font-bold text-slate-500">No practice questions attached to this paper yet.</p>
                            </div>
                        `;
                    }
                } catch (err) {
                    console.error('Practice load error:', err);
                    progressEl.textContent = 'Failed to load questions';
                    bodyEl.innerHTML = '<div class="py-6 text-center text-xs font-bold text-rose-500">Error loading questions.</div>';
                }
            }

            renderPracticeQuestions(questions, container) {
                let html = '';
                questions.forEach((q, idx) => {
                    const options = q.options || [];
                    html += `
                        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60 space-y-2.5">
                            <div class="flex items-center justify-between gap-2">
                                <span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-[10px] font-bold">
                                    Question ${idx + 1}
                                </span>
                                <span class="text-[10px] font-bold text-slate-400">${q.questionType || 'MCQ'}</span>
                            </div>
                            <h4 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-white leading-relaxed">
                                ${q.questionText}
                            </h4>
                    `;

                    if (options.length > 0) {
                        html += `<div class="grid grid-cols-1 gap-1.5 pt-0.5">`;
                        options.forEach((opt, optIdx) => {
                            const isCorrect = optIdx === q.correctAnswerIndex || opt === q.correctAnswer;
                            html += `
                                <button onclick="qbExplorer.checkOption(this, ${isCorrect}, '${(q.explanation || '').replace(/'/g, "\\'")}')" class="w-full text-left p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-all text-xs font-semibold text-slate-700 dark:text-slate-200 flex items-center justify-between group">
                                    <span>${opt}</span>
                                    <span class="material-symbols-rounded text-sm opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center select-none">radio_button_unchecked</span>
                                </button>
                            `;
                        });
                        html += `</div>`;
                    }

                    html += `<div class="qb-explanation-box hidden p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-xs text-emerald-800 dark:text-emerald-300 font-medium"></div>`;
                    html += `</div>`;
                });
                container.innerHTML = html;
            }

            checkOption(btn, isCorrect, explanation) {
                const parent = btn.closest('.space-y-2\\.5') || btn.closest('.space-y-3');
                if (!parent) return;

                const buttons = parent.querySelectorAll('button');
                buttons.forEach(b => b.disabled = true);

                const explBox = parent.querySelector('.qb-explanation-box');

                if (isCorrect) {
                    btn.className = 'w-full text-left p-2 rounded-xl border border-emerald-500 bg-emerald-500 text-white text-xs font-bold flex items-center justify-between shadow-xs';
                    if (explBox) {
                        explBox.innerHTML = `<strong>Correct Answer!</strong> ${explanation || ''}`;
                        explBox.classList.remove('hidden');
                    }
                } else {
                    btn.className = 'w-full text-left p-2 rounded-xl border border-rose-500 bg-rose-500 text-white text-xs font-bold flex items-center justify-between shadow-xs';
                    if (explBox) {
                        explBox.innerHTML = `<strong>Incorrect!</strong> ${explanation || 'Please review the correct option.'}`;
                        explBox.classList.remove('hidden');
                    }
                }
            }

            closePracticeModal() {
                const modal = document.getElementById('qb-practice-modal');
                if (modal) modal.classList.add('hidden');
            }
        }

        window.qbExplorer = new QuestionBankExplorer();
        document.addEventListener('DOMContentLoaded', () => {
            if (!window.qbExplorer) {
                window.qbExplorer = new QuestionBankExplorer();
            }
        });

        // Close all dropdowns when clicking anywhere outside
        document.addEventListener('click', (e) => {
            const isInside = e.target.closest('#qb-subject-dropdown-container, #qb-board-dropdown-container, #qb-year-dropdown-container, #qb-access-dropdown-container');
            if (!isInside) {
                closeAllQbDropdowns();
            }
        });
    </script>
</body>
</html>