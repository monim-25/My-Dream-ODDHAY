<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>আমাদের সম্পর্কে | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়) — বাংলাদেশের মাধ্যমিক ও উচ্চ মাধ্যমিক শিক্ষার্থীদের আধুনিক ডিজিটাল শিক্ষা প্ল্যাটফর্ম।">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Clean Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
                <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 mb-2 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">হোম</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">আমাদের সম্পর্কে</span>
                </nav>
                <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    আমাদের লক্ষ্য ও পরিচয়
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-normal">
                    ODDHAY (অধ্যায়) — বাংলাদেশের শিক্ষার্থীদের আধুনিক শিক্ষা সহায়িকা
                </p>
            </div>

            <!-- Intro Card -->
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed shadow-2xs space-y-2">
                <p>
                    <strong>ODDHAY (অধ্যায়)</strong> হলো নবম থেকে দ্বাদশ শ্রেণির (SSC & HSC) শিক্ষার্থীদের বোর্ড পরীক্ষার পূর্ণাঙ্গ প্রস্তুতি, অধ্যায়ভিত্তিক অনুশীলন এবং লাইভ মডেল টেস্টের এক নির্ভরযোগ্য মাধ্যম।
                </p>
                <p class="text-slate-500 dark:text-slate-400">
                    প্রযুক্তি ও মানসম্মত শিক্ষাদানের সমন্বয়ে দেশের যেকোনো প্রান্তের শিক্ষার্থীর কাছে বোর্ড স্ট্যান্ডার্ড শিক্ষা সেবা পৌঁছে দেওয়াই ODDHAY-এর মূল লক্ষ্য।
                </p>
            </div>

            <!-- Core Features (Compact 2-col) -->
            <div class="space-y-3">
                <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white">
                    মূল সেবাসমূহ
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-base">timer</span>
                            <h3 class="text-xs font-semibold text-slate-900 dark:text-white">স্মার্ট টাইমার ও লাইভ পরীক্ষা</h3>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">বোর্ড পরীক্ষার পরিবেশে রিয়েল-টাইম মূল্যায়ন ও লিডারবোর্ড র‍্যাঙ্কিং।</p>
                    </div>

                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-indigo-500 text-base">menu_book</span>
                            <h3 class="text-xs font-semibold text-slate-900 dark:text-white">বোর্ড প্রশ্নব্যাংক</h3>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">সকল সাধারণ শিক্ষা বোর্ডের বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যা।</p>
                    </div>

                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-amber-500 text-base">verified</span>
                            <h3 class="text-xs font-semibold text-slate-900 dark:text-white">স্বচ্ছতা ও সুরক্ষা</h3>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">১০০% নিরাপদ পেমেন্ট ও স্বচ্ছ শিক্ষার্থী-বান্ধব রিফান্ড নীতি।</p>
                    </div>

                    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-rose-500 text-base">headset_mic</span>
                            <h3 class="text-xs font-semibold text-slate-900 dark:text-white">সার্বক্ষণিক হেল্পডেস্ক</h3>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">সরাসরি ফোন, ইমেইল এবং দ্রুততম হোয়াটসঅ্যাপ সহায়তা।</p>
                    </div>
                </div>
            </div>

            <!-- Stats (Compact) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-1">
                <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                    <p class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 num-font">১০,০০০+</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">শিক্ষার্থী</p>
                </div>
                <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                    <p class="text-lg font-semibold text-indigo-600 dark:text-indigo-400 num-font">৫০,০০০+</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">প্রশ্ন ব্যাংক</p>
                </div>
                <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                    <p class="text-lg font-semibold text-amber-500 num-font">৯টি</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">শিক্ষা বোর্ড</p>
                </div>
                <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                    <p class="text-lg font-semibold text-purple-600 dark:text-purple-400 num-font">১০০%</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">বোর্ড প্যাটার্ন</p>
                </div>
            </div>

            <!-- Official Registration Reference -->
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2 shadow-2xs">
                <h3 class="text-xs font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                    <span class="material-symbols-rounded text-emerald-500 text-base">verified</span>
                    <span>সরকারি নিবন্ধন তথ্য</span>
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600 dark:text-slate-400">
                    <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60">
                        <span class="text-slate-400 block text-[10px]">ট্রেড লাইসেন্স নম্বর:</span>
                        <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tradeLicense) ? siteSettings.legalInfo.tradeLicense : 'TRAD/DNCC/041285/2026' %></span>
                    </div>
                    <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60">
                        <span class="text-slate-400 block text-[10px]">ই-টিন সার্টিফিকেট নম্বর:</span>
                        <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tinNumber) ? siteSettings.legalInfo.tinNumber : '8491-7302-6194' %></span>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
