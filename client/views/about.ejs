<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>আমাদের সম্পর্কে | ODDHAY (অধ্যায়)</title>
    <meta name="description" content="ODDHAY (অধ্যায়) — বাংলাদেশের মাধ্যমিক ও উচ্চ মাধ্যমিক শিক্ষার্থীদের আধুনিক ডিজিটাল শিক্ষা প্ল্যাটফর্ম। আমাদের লক্ষ্য ও স্বপ্ন সম্পর্কে জানুন।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans">
    <%- include('partials/nav') %>

    <main class="flex-1">
        <!-- Hero Banner -->
        <section class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-500/5 via-slate-50 to-white dark:from-emerald-950/20 dark:via-slate-950 dark:to-slate-900">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-emerald-500/8 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/8 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3"></div>
                <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="grid-about" width="60" height="60" patternUnits="userSpaceOnUse">
                            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#grid-about)" />
                </svg>
            </div>
            <div class="relative z-10 text-center px-6 pt-32 pb-16">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] mb-6 border border-emerald-500/20 uppercase tracking-widest">
                    <span class="material-symbols-rounded text-sm">info</span>
                    অধ্যায় সম্পর্কে
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
                    আমাদের <span class="text-emerald-600 dark:text-emerald-400">লক্ষ্য ও স্বপ্ন</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
                    বাংলাদেশের প্রতিটি শিক্ষার্থীর কাছে বোর্ড মানসম্মত আধুনিক ডিজিটাল শিক্ষা পৌঁছে দেওয়াই আমাদের সংকল্প।
                </p>
            </div>
        </section>

        <!-- Main Content -->
        <section class="pb-20 px-4 sm:px-6 lg:px-8 pt-8">
            <div class="max-w-4xl mx-auto space-y-12">

                <!-- Section: Who We Are -->
                <div class="reveal">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="size-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                            <span class="material-symbols-rounded text-xl">groups</span>
                        </div>
                        <h2 class="text-xl font-bold text-slate-900 dark:text-white">আমরা কে?</h2>
                    </div>
                    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs leading-relaxed text-slate-600 dark:text-slate-300 text-sm sm:text-base space-y-3">
                        <p>
                            <strong>ODDHAY (অধ্যায়)</strong> হলো বাংলাদেশের শিক্ষার্থীদের জন্য একটি বিশেষায়িত ডিজিটাল লার্নিং প্ল্যাটফর্ম। নবম থেকে দ্বাদশ শ্রেণির (SSC & HSC) শিক্ষার্থীদের বোর্ড পরীক্ষার পূর্ণাঙ্গ প্রস্তুতি, অধ্যায়ভিত্তিক অনুশীলন এবং লাইভ মডেল টেস্টের মাধ্যমে নিজেকে যাচাই করার এক বিশ্বস্ত মাধ্যম।
                        </p>
                        <p>
                            আমরা বিশ্বাস করি, প্রযুক্তি ও মানসম্মত শিক্ষাদানের সমন্বয়ে দেশের যেকোনো প্রান্তের শিক্ষার্থী ঘরে বসেই তার সেরা ফলাফল অর্জন করতে সক্ষম।
                        </p>
                    </div>
                </div>

                <!-- Section: Core Values -->
                <div class="reveal">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="size-10 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center">
                            <span class="material-symbols-rounded text-xl">verified</span>
                        </div>
                        <h2 class="text-xl font-bold text-slate-900 dark:text-white">আমাদের মূল স্তম্ভ</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                            <div class="flex items-center gap-2.5 mb-2">
                                <span class="material-symbols-rounded text-emerald-500 text-lg">psychology</span>
                                <h3 class="font-bold text-sm text-slate-900 dark:text-white">স্মার্ট টাইমার ও লাইভ পরীক্ষা</h3>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed">
                                রিয়েল-টাইম বোর্ড পরীক্ষার পরিবেশে নেগেটিভ মার্কিং ও তাৎক্ষণিক র‍্যাঙ্কিং এনালাইসিস।
                            </p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                            <div class="flex items-center gap-2.5 mb-2">
                                <span class="material-symbols-rounded text-indigo-500 text-lg">menu_book</span>
                                <h3 class="font-bold text-sm text-slate-900 dark:text-white">বিগত বছরের বোর্ড প্রশ্নব্যাংক</h3>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed">
                                সকল শিক্ষা বোর্ডের অধ্যায়ভিত্তিক বিগত বছরের প্রশ্ন ও নির্ভুল ব্যাখ্যাসহ সমাধান।
                            </p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                            <div class="flex items-center gap-2.5 mb-2">
                                <span class="material-symbols-rounded text-amber-500 text-lg">shield</span>
                                <h3 class="font-bold text-sm text-slate-900 dark:text-white">স্বচ্ছতা ও সুরক্ষা</h3>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed">
                                ১০০% নিরাপদ পেমেন্ট, স্বচ্ছ রিফান্ড পলিসি এবং সরকারি সকল আইনি নিয়মনীতির প্রতি পূর্ণ আনুগত্য।
                            </p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-500/30 transition-all shadow-2xs">
                            <div class="flex items-center gap-2.5 mb-2">
                                <span class="material-symbols-rounded text-rose-500 text-lg">headset_mic</span>
                                <h3 class="font-bold text-sm text-slate-900 dark:text-white">সার্বক্ষণিক সহায়তা</h3>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm leading-relaxed">
                                হটলাইন, সরাসরি হোয়াটসঅ্যাপ এবং ডেডিকেটেড ইমেইল হেল্পডেস্কের মাধ্যমে দ্রুত সমাধান।
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section: Stats & Achievements -->
                <div class="reveal">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="size-10 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center">
                            <span class="material-symbols-rounded text-xl">insights</span>
                        </div>
                        <h2 class="text-xl font-bold text-slate-900 dark:text-white">এক নজরে ODDHAY</h2>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mb-1 num-font">১০,০০০+</p>
                            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">সক্রিয় শিক্ষার্থী</p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-2xl sm:text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 mb-1 num-font">৫০,০০০+</p>
                            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">প্রশ্ন ব্যাংক ও কুইজ</p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-2xl sm:text-3xl font-extrabold text-amber-500 mb-1 num-font">৯টি</p>
                            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">সাধারণ শিক্ষা বোর্ড</p>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-2xl sm:text-3xl font-extrabold text-purple-600 dark:text-purple-400 mb-1 num-font">১০০%</p>
                            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">এনসিটিবি প্যাটার্ন</p>
                        </div>
                    </div>
                </div>

                <!-- Section: Legal Credentials & Office Reference -->
                <div class="reveal p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-4">
                    <div class="flex items-center gap-2.5 text-slate-900 dark:text-white font-bold text-base sm:text-lg">
                        <span class="material-symbols-rounded text-emerald-500">verified</span>
                        <h3>আইনি ও প্রাতিষ্ঠানিক পরিচয়</h3>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                        ODDHAY প্ল্যাটফর্মটি বাংলাদেশ সরকারের প্রচলিত সকল বাণিজ্য ও কর নীতিমালা অনুসরণ করে পরিচালিত।
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs text-slate-600 dark:text-slate-400">
                        <div class="p-4 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700">
                            <span class="text-slate-400 block mb-0.5 font-medium">ট্রেড লাইসেন্স নম্বর:</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200 num-font text-sm"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tradeLicense) ? siteSettings.legalInfo.tradeLicense : 'TRAD/DNCC/041285/2026' %></span>
                        </div>
                        <div class="p-4 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700">
                            <span class="text-slate-400 block mb-0.5 font-medium">ই-টিন সার্টিফিকেট নম্বর:</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200 num-font text-sm"><%= (locals.siteSettings && siteSettings.legalInfo && siteSettings.legalInfo.tinNumber) ? siteSettings.legalInfo.tinNumber : '8491-7302-6194' %></span>
                        </div>
                    </div>
                </div>

                <!-- Call to Action -->
                <div class="reveal p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-emerald-500/10 via-white to-indigo-500/10 dark:from-emerald-950/40 dark:via-slate-900 dark:to-indigo-950/30 border border-emerald-500/20 text-center space-y-4">
                    <div class="size-14 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto">
                        <span class="material-symbols-rounded text-3xl">rocket_launch</span>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">আজই শুরু হোক তোমার সেরা প্রস্তুতি</h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
                        বোর্ড স্ট্যান্ডার্ড পরীক্ষা ও নিয়মিত অনুশীলনে নিজেকে এক ধাপ এগিয়ে রাখো।
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3 justify-center">
                        <a href="/register" class="px-6 py-2.5 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-xs sm:text-sm transition-all shadow-xs">
                            বিনামূল্যে শুরু করো
                        </a>
                        <a href="/contact" class="px-6 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-xs sm:text-sm transition-all border border-slate-200 dark:border-slate-700">
                            যোগাযোগ করুন
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
            }, { threshold: 0.1 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        });
    </script>
</body>

</html>
