<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>About ODDHAY | Digital Education Platform</title>
    <meta name="description" content="Learn about ODDHAY, the modern digital learning platform designed for Class 9 to 12 (SSC & HSC) students in Bangladesh.">
    <%- include('partials/head') %>
</head>

<body class="bg-[#f8fafc] dark:bg-[#091122] text-slate-800 dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased">
    <%- include('partials/nav') %>

    <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Clean Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
                <nav class="flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 mb-1.5 font-medium">
                    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-slate-600 dark:text-slate-300">About ODDHAY</span>
                </nav>
                <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight">
                    About ODDHAY
                </h1>
            </div>

            <!-- Custom Content from SuperAdmin if provided -->
            <% const customAbout = (locals.siteSettings && siteSettings.policiesAndLegal && siteSettings.policiesAndLegal.aboutContent) ? siteSettings.policiesAndLegal.aboutContent : ''; %>
            <% if (customAbout && customAbout.trim().length > 0) { %>
                <div class="prose dark:prose-invert max-w-none text-sm sm:text-[15px] text-slate-600 dark:text-slate-300 leading-relaxed space-y-4">
                    <%- customAbout %>
                </div>
            <% } else { %>
                <!-- Standard Concise English About Content -->
                <div class="space-y-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    
                    <!-- Intro Card -->
                    <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-2.5">
                        <p>
                            <strong>ODDHAY</strong> is an academic technology platform dedicated to secondary and higher secondary students (Class 9 to 12) across Bangladesh. ODDHAY integrates board curriculum standards, smart timer examinations, comprehensive question banks, and live model tests into a cohesive learning journey.
                        </p>
                        <p class="text-slate-500 dark:text-slate-400 font-normal">
                            ODDHAY's mission is to empower learners everywhere with accessible, reliable, and high-standard academic resources.
                        </p>
                    </div>

                    <!-- Core Pillars (Compact 2x2) -->
                    <div class="space-y-3.5">
                        <h2 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white">
                            Core Pillars
                        </h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-rounded text-emerald-500 text-lg">timer</span>
                                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white">Smart Timed Examinations</h3>
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Real-time board exam simulation with negative marking and instant ranking analytics.</p>
                            </div>

                            <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-rounded text-indigo-500 text-lg">menu_book</span>
                                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white">Board Question Bank</h3>
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Curated previous years' board exam questions with detailed expert explanations.</p>
                            </div>

                            <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-rounded text-amber-500 text-lg">verified</span>
                                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white">Integrity & Reliability</h3>
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Secure payment processing, transparent refund principles, and regulatory compliance.</p>
                            </div>

                            <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-rounded text-rose-500 text-lg">headset_mic</span>
                                    <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white">Dedicated Support</h3>
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Multi-channel assistance via phone, email, and direct WhatsApp support.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Platform Milestones -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                        <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-xl sm:text-2xl font-semibold text-emerald-600 dark:text-emerald-400 num-font">10,000+</p>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Active Students</p>
                        </div>
                        <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-xl sm:text-2xl font-semibold text-indigo-600 dark:text-indigo-400 num-font">50,000+</p>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Question Bank</p>
                        </div>
                        <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-xl sm:text-2xl font-semibold text-amber-500 num-font">9 Boards</p>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Education Boards</p>
                        </div>
                        <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-center shadow-2xs">
                            <p class="text-xl sm:text-2xl font-semibold text-purple-600 dark:text-purple-400 num-font">100%</p>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">NCTB Pattern</p>
                        </div>
                    </div>

                    <!-- Official Credentials Info -->
                    <% 
                        const aboutLegal = (locals.siteSettings && siteSettings.legalInfo) ? siteSettings.legalInfo : {};
                        const isBlankOrNA = (val) => {
                            if (!val || typeof val !== 'string') return true;
                            const s = val.trim();
                            if (!s) return true;
                            const clean = s.toLowerCase().replace(/[\s\/\-\.]+/g, '');
                            return clean === 'na' || clean === 'none' || clean === 'null' || clean === 'undefined';
                        };
                        const aboutTrade = !isBlankOrNA(aboutLegal.tradeLicense) ? aboutLegal.tradeLicense.trim() : '';
                        const aboutTin = !isBlankOrNA(aboutLegal.tinNumber) ? aboutLegal.tinNumber.trim() : '';
                    %>
                    <% if (aboutTrade || aboutTin) { %>
                        <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-2.5 shadow-2xs">
                            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-emerald-500 text-lg">verified</span>
                                <span>Official Legal Credentials</span>
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm text-slate-600 dark:text-slate-400">
                                <% if (aboutTrade) { %>
                                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60">
                                        <span class="text-slate-400 block text-xs">Trade License No:</span>
                                        <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= aboutTrade %></span>
                                    </div>
                                <% } %>
                                <% if (aboutTin) { %>
                                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60">
                                        <span class="text-slate-400 block text-xs">e-TIN Certificate No:</span>
                                        <span class="font-semibold text-slate-800 dark:text-slate-200 num-font"><%= aboutTin %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer', { lang: 'en' }) %>
</body>

</html>