<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>আমাদের সম্পর্কে | ODDHAY</title>
    <meta name="description"
        content="ODDHAY — বাংলাদেশের শিক্ষার্থীদের জন্য আধুনিক লার্নিং প্ল্যাটফর্ম। আমাদের লক্ষ্য ও স্বপ্ন সম্পর্কে জানুন।">
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">
    <%- include('partials/nav') %>

        <main>
            <!-- Hero Banner (Similar to FAQ Design) -->
            <section
                class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-50 to-white dark:from-slate-950 dark:to-slate-900">
                <div class="absolute inset-0 pointer-events-none">
                    <div
                        class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] translate-x-1/3 -translate-y-1/3">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-indigo-500/5 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3">
                    </div>
                    <!-- Subtle grid -->
                    <svg class="absolute inset-0 w-full h-full opacity-[0.02]" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="grid-about" width="60" height="60" patternUnits="userSpaceOnUse">
                                <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#137fec" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid-about)" />
                    </svg>
                </div>
                <div class="relative z-10 text-center px-6 pt-32 pb-16">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary/8 text-primary font-bold text-[11px] mb-6 border border-primary/15 uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[14px]">info</span>
                        অধ্যায় সম্পর্কে
                    </div>
                    <h1 class="font-black tracking-tight leading-tight mb-4"
                        style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
                        আমাদের <span class="text-primary">লক্ষ্য ও স্বপ্ন</span>
                    </h1>
                    <p class="text-slate-500 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
                        বাংলাদেশের প্রতিটি শিক্ষার্থীর কাছে মানসম্মত শিক্ষা পৌঁছে দেয়াই আমাদের সঙ্কল্প।
                    </p>
                </div>
            </section>

            <!-- About Content (Following FAQ Categorized Box Style) -->
            <section class="pb-24 px-6 pt-12">
                <div class="max-w-3xl mx-auto space-y-12">

                    <!-- Section: Who We Are -->
                    <div class="reveal">
                        <div class="flex items-center gap-3 mb-6">
                            <div
                                class="size-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                                <span class="material-symbols-outlined text-xl">groups</span>
                            </div>
                            <h2 class="text-lg font-black text-slate-900 dark:text-white">আমরা কে?</h2>
                        </div>
                        <div
                            class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-sm leading-relaxed text-slate-600 dark:text-slate-400">
                            ODDHAY হলো একটি ডিজিটাল লার্নিং প্ল্যাটফর্ম যা বাংলাদেশের শিক্ষার্থীদের পড়াশোনার ধরণ বদলে
                            দিতে কাজ করছে। আমরা বিশ্বাস করি সঠিক কোচিং এবং গাইডলাইন পেলে প্রতিটি শিক্ষার্থী তার স্বপ্নের
                            লক্ষ্যে পৌঁছাতে সক্ষম।
                        </div>
                    </div>

                    <!-- Section: Our Values -->
                    <div class="reveal">
                        <div class="flex items-center gap-3 mb-6">
                            <div
                                class="size-10 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center">
                                <span class="material-symbols-outlined text-xl">verified</span>
                            </div>
                            <h2 class="text-lg font-black text-slate-900 dark:text-white">আমাদের মূল্যবোধ</h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div
                                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-primary/20 transition-all">
                                <h3 class="font-black text-sm text-slate-900 dark:text-white mb-2">উদ্ভাবন</h3>
                                <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">সর্বাধুনিক
                                    প্রযুক্তি ব্যবহার করে শেখার অভিজ্ঞতা উন্নত করা।</p>
                            </div>
                            <div
                                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-primary/20 transition-all">
                                <h3 class="font-black text-sm text-slate-900 dark:text-white mb-2">স্বচ্ছতা</h3>
                                <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">শিক্ষার্থী ও
                                    অভিভাবকদের সাথে স্বচ্ছ সম্পর্ক বজায় রাখা।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Stats (Boxed Style) -->
                    <div class="reveal">
                        <div class="flex items-center gap-3 mb-6">
                            <div
                                class="size-10 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center">
                                <span class="material-symbols-outlined text-xl">insights</span>
                            </div>
                            <h2 class="text-lg font-black text-slate-900 dark:text-white">আমাদের অর্জন</h2>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div
                                class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 text-center">
                                <p class="text-3xl font-black text-primary mb-1">১০K+</p>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">সক্রিয়
                                    শিক্ষার্থী</p>
                            </div>
                            <div
                                class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 text-center">
                                <p class="text-3xl font-black text-primary mb-1">৫০+</p>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">সেরা মেন্টর
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- CTA Section (Consistent with FAQ) -->
            <section class="pb-24 px-6">
                <div class="max-w-3xl mx-auto">
                    <div
                        class="reveal p-10 rounded-[3rem] bg-gradient-to-br from-primary/5 to-indigo-500/5 border border-primary/10 text-center">
                        <div
                            class="size-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-6">
                            <span class="material-symbols-outlined text-3xl">rocket_launch</span>
                        </div>
                        <h3 class="text-xl font-black mb-4">আমাদের সাথে আপনার যাত্রা শুরু করুন</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-sm mb-8 max-w-md mx-auto">মানসম্মত শিক্ষার
                            মাধ্যমে আপনার ভবিষ্যৎ গড়ার পথে আমরা আছি আপনার সাথে।</p>
                        <div class="flex flex-wrap gap-4 justify-center">
                            <a href="/register" class="btn-primary !py-3 !px-8 !text-sm !rounded-xl">
                                আজই শুরু করুন
                            </a>
                            <a href="/contact" class="btn-secondary !py-3 !px-8 !text-sm !rounded-xl">
                                যোগাযোগ করুন
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Footer removed -->

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('active'));
                    }, { threshold: 0.1 });
                    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
                });
            </script>
</body>

</html>