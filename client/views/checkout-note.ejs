<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Checkout | Oddhay</title>
    <%- include('partials/head') %>
    <style>
        /* Universal scrollbar killer: absolute zero scrollbars while maintaining smooth touch/wheel scroll */
        *::-webkit-scrollbar,
        ::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            background: transparent !important;
        }
        *, html, body, main {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }

        @media (max-width: 1023px) {
            .mobile-step-hidden {
                display: none !important;
            }
        }
        @media (min-width: 1024px) {
            #stepPayment, #stepSummary {
                display: block !important;
            }
            .desktop-step-hidden {
                display: none !important;
            }
        }
    </style>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-900 dark:text-slate-100 h-[100dvh] w-full flex flex-col font-sans antialiased overflow-hidden no-scrollbar">
    <%- include('partials/student-header', { pageTitle: 'Checkout', activePage: note.itemType === 'question_bank' ? 'exams' : 'library', backUrl: note.itemType === 'question_bank' ? '/question-bank' : '/library' }) %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: note.itemType === 'question_bank' ? 'exams' : 'library' }) %>

        <!-- Main Content Responsive Viewport with Safe Bottom Clearance for Mobile Nav -->
        <main class="flex-1 overflow-y-auto px-3 sm:px-6 lg:px-8 pt-3 pb-24 sm:pb-28 lg:py-6 no-scrollbar flex justify-center items-start">
            <%
                function resolveImg(p) {
                    if (!p) return '';
                    if (typeof p !== 'string') p = String(p);
                    if (p.startsWith('http://') || p.startsWith('https://')) return p;
                    let normalized = p.replace(/\\/g, '/');
                    if (!normalized.startsWith('/')) normalized = '/' + normalized;
                    return normalized;
                }

                const basePrice = Number(note.price) || 50;
                const isQB = note.itemType === 'question_bank';
                const noteThumb = resolveImg(note.thumbnail || note.image || note.coverImage);
                
                // Build available payment methods as set by superadmin
                const availableMethods = [];
                if (siteSettings?.paymentNumbers?.bkash) {
                    availableMethods.push({ id: 'bkash', name: 'bKash', color: '#e2136e' });
                }
                if (siteSettings?.paymentNumbers?.nagad) {
                    availableMethods.push({ id: 'nagad', name: 'Nagad', color: '#f7931e' });
                }
                if (siteSettings?.paymentNumbers?.rocket) {
                    availableMethods.push({ id: 'rocket', name: 'Rocket', color: '#8c3494' });
                }
                if (availableMethods.length === 0) {
                    availableMethods.push(
                        { id: 'bkash', name: 'bKash', color: '#e2136e' },
                        { id: 'nagad', name: 'Nagad', color: '#f7931e' }
                    );
                }
                const defaultMethod = availableMethods[0].id;
                const defaultMethodName = availableMethods[0].name;
            %>

            <!-- Responsive Container: 1-col on mobile, 2-col on large screens -->
            <div class="w-full max-w-md lg:max-w-4xl xl:max-w-5xl mx-auto">
                
                <!-- Error Alert if any -->
                <% if (locals.error) { %>
                    <div class="p-3 mb-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 flex items-center gap-2 text-rose-700 dark:text-rose-300 text-xs">
                        <span class="material-symbols-rounded text-base shrink-0 leading-none flex items-center justify-center">error</span>
                        <p class="font-medium"><%= error %></p>
                    </div>
                <% } %>

                <!-- Responsive Grid: On large screens both columns show side-by-side -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start">
                    
                    <!-- LEFT COLUMN ON DESKTOP: Payment Methods & Direct Action -->
                    <div id="stepPayment" class="space-y-3 mobile-step-hidden lg:col-span-7 lg:order-1">
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs p-4 sm:p-5 space-y-4">
                            
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                                <div class="flex items-center gap-2">
                                    <!-- Mobile-only back button to summary -->
                                    <button type="button" id="backToSummaryBtn" onclick="goToSummaryStep()" class="desktop-step-hidden p-1 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer flex items-center justify-center" title="Back to Summary">
                                        <span class="material-symbols-rounded text-base leading-none shrink-0">arrow_back</span>
                                    </button>
                                    <div class="flex items-center gap-2">
                                        <span class="size-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
                                            <span class="material-symbols-rounded text-base">payments</span>
                                        </span>
                                        <h2 class="text-sm font-bold text-slate-900 dark:text-white">
                                            Payment Method
                                        </h2>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400" id="step2TotalAmount">৳<%= basePrice.toLocaleString() %></span>
                            </div>

                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                Choose your preferred mobile wallet to complete your secure payment.
                            </p>

                            <!-- Superadmin-configured Payment Methods List -->
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="methodsContainer">
                                <% availableMethods.forEach((m, idx) => { %>
                                    <div onclick="selectPaymentMethod('<%= m.id %>', '<%= m.name %>')" id="methodCard_<%= m.id %>"
                                        class="method-option-card p-3 rounded-xl border-2 transition-all cursor-pointer flex items-center justify-between gap-2 <%= idx === 0 ? 'border-emerald-500 bg-emerald-50/40 dark:bg-emerald-950/20 shadow-xs' : 'border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 hover:border-slate-300 dark:hover:border-slate-600' %>">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="size-8 rounded-lg flex items-center justify-center shrink-0 font-bold text-xs" style="color: <%= m.color %>; background-color: <%= m.color %>18;">
                                                <span class="material-symbols-rounded text-base leading-none shrink-0 flex items-center justify-center">account_balance_wallet</span>
                                            </div>
                                            <div class="min-w-0">
                                                <span class="text-xs font-bold text-slate-900 dark:text-white leading-none block truncate"><%= m.name %></span>
                                                <span class="text-[10px] text-slate-400 font-medium block mt-0.5">Instant Pay</span>
                                            </div>
                                        </div>
                                        <span id="checkIcon_<%= m.id %>" class="material-symbols-rounded text-emerald-500 text-sm leading-none shrink-0 <%= idx === 0 ? '' : 'hidden' %>">check_circle</span>
                                    </div>
                                <% }) %>
                            </div>

                            <!-- Security Guarantee Callout -->
                            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 flex items-center gap-2.5 text-slate-600 dark:text-slate-300 text-xs">
                                <span class="material-symbols-rounded text-emerald-500 text-lg shrink-0">verified_user</span>
                                <div class="min-w-0 flex-1">
                                    <p class="font-bold text-[11px] text-slate-800 dark:text-slate-200">100% Secure & Encrypted</p>
                                    <p class="text-[10px] text-slate-400 mt-0.5">Automated tokenized payment gateway with instant unlock.</p>
                                </div>
                            </div>

                            <!-- Direct Gateway Pay Button -->
                            <div class="pt-1">
                                <button type="button" onclick="startDirectGateway()" id="startGatewayBtn"
                                    class="group w-full h-11 sm:h-12 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-500/35 transition-all duration-200 active:scale-[0.99] cursor-pointer">
                                    <span class="material-symbols-rounded text-base leading-none shrink-0 flex items-center justify-center">lock</span>
                                    <span id="gatewayBtnText">Pay with <%= defaultMethodName %> • ৳<%= basePrice.toLocaleString() %></span>
                                    <span class="material-symbols-rounded text-base leading-none shrink-0 flex items-center justify-center group-hover:translate-x-1 transition-transform">arrow_forward</span>
                                </button>
                            </div>

                            <input type="hidden" id="inputAppliedCoupon" value="">
                        </div>
                    </div>

                    <!-- RIGHT COLUMN ON DESKTOP: Order Summary & Preview -->
                    <div id="stepSummary" class="space-y-3 w-full lg:col-span-5 lg:order-2">
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs p-4 sm:p-5 space-y-3.5 sticky top-3">
                            <div class="flex items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
                                <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-emerald-500 text-base leading-none shrink-0 flex items-center justify-center">shopping_bag</span>
                                    <span>Order Summary</span>
                                </h2>
                                <span class="px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
                                    Get Premium Access
                                </span>
                            </div>

                            <!-- Item Preview Card -->
                            <div class="space-y-2.5">
                                <% if (noteThumb) { %>
                                    <div class="h-36 sm:h-40 w-full rounded-xl overflow-hidden relative border border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 flex items-center justify-center shadow-xs">
                                        <img src="<%= noteThumb %>" 
                                             class="w-full h-full object-cover" 
                                             alt="<%= note.title %>"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <div class="w-full h-full items-center justify-center bg-slate-900 text-white font-black text-2xl hidden">
                                            <%= isQB ? 'QB' : 'PDF' %>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <div class="h-28 w-full rounded-xl bg-gradient-to-tr <%= isQB ? 'from-amber-600 to-indigo-600' : 'from-indigo-600 to-sky-500' %> flex flex-col items-center justify-center text-white p-3 text-center shadow-xs">
                                        <span class="material-symbols-rounded text-3xl mb-1"><%= isQB ? 'quiz' : 'menu_book' %></span>
                                        <span class="text-xs font-bold uppercase tracking-widest opacity-90"><%= isQB ? 'Question Bank' : 'Digital Resource' %></span>
                                    </div>
                                <% } %>

                                <div>
                                    <span class="text-[10.5px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider block mb-1">
                                        <%= isQB ? 'Question Bank Paper' : (note.subject || 'Lecture Note') %>
                                    </span>
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug">
                                        <%= note.title %>
                                    </h3>
                                </div>
                            </div>

                            <!-- Price Breakdown -->
                            <div class="pt-3.5 border-t border-slate-100 dark:border-slate-800 space-y-2">
                                <div class="flex justify-between items-center text-xs text-slate-600 dark:text-slate-400">
                                    <span>Item Price</span>
                                    <span class="font-medium text-slate-800 dark:text-slate-200" id="displayOriginalPrice">৳<%= basePrice.toLocaleString() %></span>
                                </div>

                                <div id="couponDiscountRow" class="justify-between items-center text-xs text-emerald-600 dark:text-emerald-400 hidden">
                                    <span>Coupon Discount</span>
                                    <span class="font-medium" id="displayCouponDiscount">-৳0</span>
                                </div>

                                <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center">
                                    <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Total Amount</span>
                                    <span class="text-lg sm:text-xl font-black text-emerald-600 dark:text-emerald-400" id="displayFinalPrice">৳<%= basePrice.toLocaleString() %></span>
                                </div>
                            </div>

                            <!-- Coupon Code Section -->
                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-1">
                                <label for="couponInput" class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                                    Coupon Code (Optional)
                                </label>
                                <div class="flex gap-2">
                                    <input type="text" id="couponInput" placeholder="Enter coupon code"
                                        class="flex-1 h-9 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-xs font-medium text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition-all font-mono">
                                    <button type="button" onclick="applyCoupon()" id="couponApplyBtn"
                                        class="h-9 px-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-emerald-950/40 dark:hover:text-emerald-400 text-xs font-bold text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer shrink-0">
                                        Apply
                                    </button>
                                </div>
                                <p id="couponFeedback" class="text-[10.5px] font-medium hidden"></p>
                            </div>

                            <!-- Proceed Button (Mobile only) -->
                            <div class="pt-1 desktop-step-hidden">
                                <button type="button" onclick="goToPaymentStep()" id="proceedBtn"
                                    class="group w-full h-11 sm:h-11.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-500/35 transition-all duration-200 active:scale-[0.99] cursor-pointer">
                                    <span>Proceed to Payment</span>
                                    <span class="material-symbols-rounded text-base leading-none shrink-0 group-hover:translate-x-1 transition-transform">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: note.itemType === 'question_bank' ? 'exams' : 'library' }) %>
    <%- include('partials/payment-gateway-modal') %>

    <script>
        let currentStep = 'summary';

        // Header back arrow controller for Note & Question Bank Checkout
        window.onBeforeHeaderNavBack = function(proceed) {
            if (window.innerWidth < 1024 && typeof currentStep !== 'undefined' && currentStep === 'payment') {
                goToSummaryStep();
                return true;
            }
            return false;
        };

        const noteId = '<%= note._id %>';
        const isQB = <%= isQB %>;
        const rawBasePrice = Number('<%= basePrice %>');
        let currentFinalPrice = rawBasePrice;
        let selectedMethod = '<%= defaultMethod %>';
        let selectedMethodName = '<%= defaultMethodName %>';

        function goToPaymentStep() {
            if (window.innerWidth < 1024) {
                currentStep = 'payment';
                document.getElementById('stepSummary').classList.add('mobile-step-hidden');
                document.getElementById('stepPayment').classList.remove('mobile-step-hidden');
                document.getElementById('step2TotalAmount').innerText = `৳${currentFinalPrice.toLocaleString()}`;
                document.getElementById('gatewayBtnText').innerText = `Pay with ${selectedMethodName} • ৳${currentFinalPrice.toLocaleString()}`;
                const mainViewport = document.querySelector('main');
                if (mainViewport) mainViewport.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function goToSummaryStep() {
            if (window.innerWidth < 1024) {
                currentStep = 'summary';
                document.getElementById('stepPayment').classList.add('mobile-step-hidden');
                document.getElementById('stepSummary').classList.remove('mobile-step-hidden');
                const mainViewport = document.querySelector('main');
                if (mainViewport) mainViewport.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function selectPaymentMethod(methodId, methodName) {
            selectedMethod = methodId;
            selectedMethodName = methodName || (methodId.charAt(0).toUpperCase() + methodId.slice(1));

            document.querySelectorAll('.method-option-card').forEach(card => {
                card.classList.remove('border-emerald-500', 'bg-emerald-50/40', 'dark:bg-emerald-950/20', 'shadow-xs');
                card.classList.add('border-slate-200', 'dark:border-slate-700', 'bg-slate-50/50', 'dark:bg-slate-800/40');
            });

            document.querySelectorAll('[id^="checkIcon_"]').forEach(icon => {
                icon.classList.add('hidden');
            });

            const activeCard = document.getElementById('methodCard_' + methodId);
            if (activeCard) {
                activeCard.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-slate-50/50', 'dark:bg-slate-800/40');
                activeCard.classList.add('border-emerald-500', 'bg-emerald-50/40', 'dark:bg-emerald-950/20', 'shadow-xs');
            }

            const activeCheck = document.getElementById('checkIcon_' + methodId);
            if (activeCheck) {
                activeCheck.classList.remove('hidden');
            }

            const btnText = document.getElementById('gatewayBtnText');
            if (btnText) {
                btnText.innerText = `Pay with ${selectedMethodName} • ৳${currentFinalPrice.toLocaleString()}`;
            }
        }

        function startDirectGateway() {
            openPgwModal({
                noteId: noteId,
                isQuestionBank: isQB,
                amount: currentFinalPrice,
                paymentMethod: selectedMethod,
                couponCode: document.getElementById('inputAppliedCoupon')?.value || ''
            });
        }

        async function applyCoupon() {
            const codeInput = document.getElementById('couponInput');
            const feedback = document.getElementById('couponFeedback');
            const code = (codeInput?.value || '').trim();

            if (!code) {
                feedback.innerText = 'Please enter a coupon code.';
                feedback.className = 'text-[10.5px] font-medium text-rose-500 block';
                return;
            }

            try {
                feedback.innerText = 'Validating coupon...';
                feedback.className = 'text-[10.5px] font-medium text-slate-400 block';

                const res = await fetch('/payment/validate-coupon', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        code: code,
                        noteId: noteId,
                        amount: rawBasePrice
                    })
                });
                const data = await res.json();

                if (data.valid) {
                    const discount = Number(data.discount) || 0;
                    currentFinalPrice = Number(data.finalAmount) || Math.max(0, rawBasePrice - discount);

                    document.getElementById('inputAppliedCoupon').value = code;

                    const couponRow = document.getElementById('couponDiscountRow');
                    const couponDisplay = document.getElementById('displayCouponDiscount');
                    if (couponRow && couponDisplay) {
                        couponDisplay.innerText = `-৳${discount.toLocaleString()}`;
                        couponRow.classList.remove('hidden');
                        couponRow.classList.add('flex');
                    }

                    document.getElementById('displayFinalPrice').innerText = `৳${currentFinalPrice.toLocaleString()}`;
                    const s2Total = document.getElementById('step2TotalAmount');
                    if (s2Total) s2Total.innerText = `৳${currentFinalPrice.toLocaleString()}`;
                    const gwBtnText = document.getElementById('gatewayBtnText');
                    if (gwBtnText) gwBtnText.innerText = `Pay with ${selectedMethodName} • ৳${currentFinalPrice.toLocaleString()}`;

                    feedback.innerText = `Coupon applied! You saved ৳${discount.toLocaleString()}.`;
                    feedback.className = 'text-[10.5px] font-medium text-emerald-600 dark:text-emerald-400 block';
                    codeInput.disabled = true;
                    document.getElementById('couponApplyBtn').disabled = true;
                } else {
                    feedback.innerText = data.error || 'Invalid or expired coupon code.';
                    feedback.className = 'text-[10.5px] font-medium text-rose-500 block';
                }
            } catch (err) {
                feedback.innerText = 'Error validating coupon. Please try again.';
                feedback.className = 'text-[10.5px] font-medium text-rose-500 block';
            }
        }
    </script>
</body>
</html>
