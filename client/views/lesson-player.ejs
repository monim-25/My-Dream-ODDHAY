<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= course.title %> | ODDHAY - Lesson Player</title>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <style>
        body {
            background-color: #f8f8ff;
            overflow: hidden;
            height: 100vh;
        }

        .dark body {
            background-color: #0b1120;
        }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        .tab-btn {
            padding: 0.75rem 0;
            font-size: 0.75rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: rgb(148 163 184);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
        }
        .tab-btn.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }
    </style>
</head>

<body class="text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">

    <!-- Topbar -->
    <% const playerBackUrl = (locals.from === 'dashboard') ? '/dashboard' : ('/course-details/' + course._id); %>
    <%- include('partials/student-header', { pageTitle: course.title, activePage: 'courses', backUrl: playerBackUrl }) %>

    <!-- Main Layout -->
    <div class="flex-1 flex overflow-hidden">
        
        <%- include('partials/student-sidebar', { activePage: 'courses' }) %>

        <main class="flex-1 overflow-y-auto p-1.5 lg:p-1.5 no-scrollbar z-10 bg-[#F8F8FF] dark:bg-[#0b1120] relative">
            <div class="w-full h-full flex flex-col gap-1">

                <% 
                    const enrollment = locals.user && user.enrolledCourses ? user.enrolledCourses.find(e => e.course.toString() === course._id.toString()) : null;
                    if (enrollment && enrollment.progress === 100) { 
                %>
                <!-- Completion Banner -->
                <div class="w-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-md p-4 md:p-3 shadow-lg shadow-emerald-500/20 flex flex-col md:flex-row items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <div class="size-12 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0">
                            <span class="material-symbols-rounded text-2xl">workspace_premium</span>
                        </div>
                        <div>
                            <h3 class="text-white font-bold text-lg leading-tight">অভিনন্দন! আপনি কোর্সটি সফলভাবে Completed করেছেন</h3>
                            <p class="text-white/80 text-[13px] font-medium mt-0.5">Congratulations on your dedication and hard work. Now it's time to collect your certificate.</p>
                        </div>
                    </div>
                    <button class="px-6 py-2.5 bg-white text-emerald-600 font-bold rounded-md shadow-sm hover:scale-105 transition-transform flex items-center gap-2 whitespace-nowrap">
                        <span class="material-symbols-rounded text-xl">download</span>
                        Download Certificate
                    </button>
                </div>
                <% } %>

                <!-- TOP ROW: Video (left) | Playlist (right) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-2 lg:gap-2 items-start">
                    
                    <!-- LEFT: Video Player & Metadata -->
                    <div class="lg:col-span-8 flex flex-col">
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col">
                            <div class="w-full aspect-video bg-black relative group">
                                <video id="playerVideoEl" controls class="w-full h-full object-contain hidden" controlsList="nodownload" style="background:#000"></video>
                                <iframe id="playerIframeEl" class="w-full h-full border-0 hidden" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                                <div id="playerEmptyState" class="w-full h-full flex flex-col items-center justify-center bg-slate-900 text-center p-3">
                                    <span class="material-symbols-rounded text-slate-600 text-6xl mb-3">play_circle</span>
                                    <p class="text-slate-400 font-medium text-sm">Select a lesson from the curriculum on the right</p>
                                </div>
                                <div id="live-badge" class="hidden absolute top-4 left-4 px-3 py-1.5 bg-rose-600 text-white rounded-full flex items-center gap-2 text-[9px] font-black uppercase tracking-widest z-10 shadow-xl shadow-rose-500/20">
                                    <span class="size-1.5 bg-white rounded-full animate-pulse"></span>LIVE
                                </div>
                            </div>
                            
                            <!-- METADATA BLOCK -->
                            <div class="space-y-4 py-4 px-4 md:px-6">
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white leading-snug flex items-center gap-2">
                                    <span id="playerVideoTitle">Course Lesson</span>
                                </h2>

                                <div class="flex items-center gap-2 pb-3 border-b border-slate-100 dark:border-slate-800/50">
                                    <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500">
                                        <span class="material-symbols-rounded text-[16px] text-slate-400">visibility</span>
                                        <span id="playerVideoViews">0</span> views
                                    </div>
                                </div>

                                <div class="pt-2 pb-1 flex items-center gap-3">
                                    <div class="size-10 rounded-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 shrink-0">
                                        <img src="<%= (course.instructor && course.instructor.profileImage) ? course.instructor.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover" alt="Author">
                                    </div>
                                    <div class="flex-1 min-w-0 flex flex-col">
                                        <h4 class="text-[13px] font-bold text-slate-800 dark:text-slate-200 leading-tight"><%= course.instructor ? course.instructor.name : 'ODDHAY Mentor' %></h4>
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Instructor</span>
                                    </div>
                                </div>

                                <div class="relative group !mt-3 p-3 bg-[#F8F8FF] dark:bg-white/5 rounded-md border border-slate-200 dark:border-slate-800 shadow-inner">
                                    <p id="playerVideoDesc" class="text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed font-medium whitespace-pre-wrap break-words">
                                        No description available for this lesson.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- TABS BLOCK: Q&A, Notes -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800 shadow-sm mt-4 overflow-hidden">
                            <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 px-6 overflow-x-auto no-scrollbar">
                                <div onclick="switchPlayerTab('notes')" class="tab-btn active player-tab-trigger" id="tab-notes">Notes & PDF</div>
                                <div onclick="switchPlayerTab('comments')" class="tab-btn player-tab-trigger" id="tab-comments">Comments</div>
                                <div onclick="switchPlayerTab('qa')" class="tab-btn player-tab-trigger" id="tab-qa">Questions & Answers (Q&A)</div>
                            </div>
                            
                            <div class="p-3">
                                <!-- Notes Tab -->
                                <div id="content-notes" class="player-content-section">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="notes-container">
                                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest text-center py-8 col-span-full">কোনো Notes পাওয়া যায়নি</p>
                                    </div>
                                </div>
                                <!-- Comments Tab -->
                                <div id="content-comments" class="hidden player-content-section">
                                    <div class="space-y-4">
                                        <div id="commentsDisabledBanner" class="hidden p-2.5 mb-3 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/30 text-amber-800 dark:text-amber-300 text-xs font-semibold rounded-none flex items-center gap-2 shrink-0">
                                            <span class="material-symbols-rounded text-[16px]">info</span>
                                            <span>Comments are currently turned off for students.</span>
                                        </div>
                                        
                                        <form id="commentForm" onsubmit="submitComment(event)" class="mb-4 shrink-0">
                                            <textarea id="commentInput" rows="2" oninput="this.style.height = 'auto'; this.style.height = this.scrollHeight + 'px';" placeholder="Add a public comment..." required class="w-full text-sm p-2.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed min-h-[50px]"></textarea>
                                            <div class="flex justify-end mt-2">
                                                <button type="submit" class="px-4 py-1.5 bg-primary hover:bg-primary/95 text-white text-[11px] font-bold uppercase tracking-wider rounded-none shadow transition-all">Comment</button>
                                            </div>
                                        </form>
                                        
                                        <div id="commentsList" class="space-y-4 pr-1">
                                            <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                                                <p class="text-xs font-medium text-slate-500">No comments yet</p>
                                                <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                                            </div>
                                        </div>
                                        
                                        <div id="loadMoreCommentsContainer" class="mt-4 pt-2 text-center hidden shrink-0">
                                            <button type="button" onclick="loadNextCommentsPage()" class="w-full py-2 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all rounded-none uppercase tracking-wider">
                                                Load More Comments
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <!-- QA Tab -->
                                <div id="content-qa" class="hidden player-content-section">
                                    <div class="flex flex-col max-h-[400px]">
                                        <!-- Post Question Form -->
                                        <form action="/qa-ask" method="POST" class="mb-4 flex items-start gap-3 bg-[#F8F8FF] dark:bg-slate-800/50 p-3 rounded-md border border-slate-200 dark:border-slate-700">
                                            <input type="hidden" name="courseId" value="<%= course._id %>">
                                            <input type="hidden" name="redirectUrl" value="/course-details/<%= course._id %>?lesson=qa">
                                            <div class="size-8 rounded-full overflow-hidden shrink-0">
                                                <img src="<%= (locals.user && user.profileImage) ? user.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                                            </div>
                                            <div class="flex-1 flex flex-col gap-2">
                                                <textarea name="question" rows="2" placeholder="Write your question or problem..." required class="w-full bg-transparent border-none outline-none text-[13px] font-medium text-slate-700 dark:text-slate-300 resize-none p-0 focus:ring-0"></textarea>
                                                <div class="flex justify-end">
                                                    <button type="submit" class="px-4 py-1.5 bg-primary hover:bg-primary/90 text-white text-[11px] font-bold uppercase tracking-widest rounded-lg transition-colors">Post</button>
                                                </div>
                                            </div>
                                        </form>

                                        <!-- QAs List -->
                                        <div class="flex-1 overflow-y-auto no-scrollbar pr-2 space-y-4">
                                            <% if (locals.qas && qas.length > 0) { %>
                                                <% qas.forEach(function(qa) { %>
                                                    <div class="p-4 rounded-md border border-slate-100 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-sm relative group">
                                                        <div class="flex items-start gap-3">
                                                            <div class="size-8 rounded-full overflow-hidden shrink-0 bg-slate-100">
                                                                <img src="<%= (qa.askedBy && qa.askedBy.profileImage) ? qa.askedBy.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                                                            </div>
                                                            <div class="flex-1 min-w-0">
                                                                <div class="flex items-center gap-2">
                                                                    <h5 class="text-[12px] font-bold text-slate-800 dark:text-slate-200"><%= qa.askedBy ? qa.askedBy.name : (qa.askedByName || 'Student') %></h5>
                                                                    <span class="text-[9px] text-slate-400 font-bold"><%= new Date(qa.createdAt).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short' }) %></span>
                                                                </div>
                                                                <p class="text-[13px] text-slate-600 dark:text-slate-400 mt-1 font-medium"><%= qa.question %></p>
                                                            </div>
                                                        </div>

                                                        <% if (qa.answer) { %>
                                                            <div class="mt-3 ml-11 p-3 bg-primary/5 dark:bg-primary/10 rounded-md border border-primary/10 relative">
                                                                <div class="flex items-start gap-3">
                                                                    <div class="size-6 rounded-full overflow-hidden shrink-0 bg-primary/20">
                                                                        <img src="<%= (qa.answeredBy && qa.answeredBy.profileImage) ? qa.answeredBy.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                                                                    </div>
                                                                    <div class="flex-1 min-w-0">
                                                                        <div class="flex items-center gap-2">
                                                                            <h5 class="text-[11px] font-bold text-primary"><%= qa.answeredBy ? qa.answeredBy.name : 'Teacher' %> <span class="text-[9px] text-slate-400 ml-1">Answered</span></h5>
                                                                        </div>
                                                                        <p class="text-[12px] text-slate-700 dark:text-slate-300 mt-1 font-medium"><%= qa.answer %></p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="flex flex-col items-center justify-center text-center py-8">
                                                    <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-700 mb-2">forum</span>
                                                    <p class="text-[11px] text-slate-400 font-bold uppercase tracking-widest">No questions asked yet</p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- RIGHT: Course Playlist (Curriculum) -->
                    <div class="lg:col-span-4 flex flex-col">
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col sticky top-3 overflow-hidden" style="max-height: calc(100vh - 120px);">
                            <div class="flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800 shrink-0 gap-2">
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">playlist_play</span>
                                    <h3 class="text-sm font-bold text-slate-800 dark:text-white">Curriculum</h3>
                                </div>
                            </div>
                            
                            <div id="playlistContainer" class="flex-1 overflow-y-auto p-3 space-y-1 no-scrollbar">
                                <% if (course.curriculumNodes && course.curriculumNodes.length > 0) { %>
                                    <%
                                        function renderPlayerSidebarTree(nodes, parentId, depth) {
                                            var currentNodes = nodes.filter(function(n) {
                                                return String(n.parentId || '') === String(parentId || '');
                                            });
                
                                            currentNodes.forEach(function(node) {
                                                var isFolder = node.type === 'folder';
                
                                                if (isFolder) {
                                    %>
                                                    <div class="mb-1">
                                                        <div class="px-3 py-2 bg-slate-50 dark:bg-slate-800/30 text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center justify-between rounded-lg" style="margin-left: <%= depth * 0.5 %>rem">
                                                            <span class="flex items-center gap-1.5 truncate">
                                                                <span class="material-symbols-rounded text-amber-500 text-[14px] shrink-0">folder</span>
                                                                <span class="truncate"><%= node.name %></span>
                                                            </span>
                                                            <span class="material-symbols-rounded text-[14px] shrink-0">expand_more</span>
                                                        </div>
                                                        <div class="mt-1">
                                                            <% renderPlayerSidebarTree(nodes, node._id.toString(), depth + 1); %>
                                                        </div>
                                                    </div>
                                    <%
                                                } else if (node.type === 'video' || node.type === 'liveClass') {
                                                    var isRecordedLive = (node.type === 'liveClass') && (node.isRecorded || !!node.videoPath);
                                                    var isNormalVideo = (node.type === 'video');
                                                    var hasVideo = !!node.videoPath;
                
                                                    if (isNormalVideo || (isRecordedLive && hasVideo)) {
                                                        var iconBg = 'bg-slate-100 dark:bg-slate-800/50 text-slate-400';
                                                        var iconName = 'play_circle';
                                                        var badgeText = 'Video Lesson';
                                                        if (isRecordedLive) {
                                                            badgeText = node.duration ? node.duration : 'Recorded Video';
                                                        }
                
                                                        var siblingNotes = nodes.filter(function(n) {
                                                            return String(n.parentId || '') === String(node.parentId || '') && n.type === 'note';
                                                        }).map(function(n) {
                                                            return { title: n.name, filePath: n.filePath, _id: n._id };
                                                        });
                                    %>
                                                        <button
                                                            onclick="playLesson('<%= node.videoPath %>', '<%= (node.name || '').replace(/'/g, "\\'") %>', '<%= node.duration || '' %>', this)"
                                                            data-lesson-id="<%= node._id %>"
                                                            data-notes='<%= JSON.stringify(siblingNotes) %>'
                                                            class="lesson-item w-full p-2.5 flex items-start gap-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all rounded-lg text-left group" style="margin-left: <%= depth * 0.5 %>rem">
                                                            <div class="size-7 rounded border border-slate-200 dark:border-slate-700 <%= iconBg %> flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:border-primary group-hover:text-white transition-all shadow-sm">
                                                                <span class="material-symbols-rounded text-[16px]"><%= iconName %></span>
                                                            </div>
                                                            <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                                <h5 class="text-[12px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-primary transition-colors truncate"><%= node.name %></h5>
                                                                <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mt-0.5"><%= badgeText %></span>
                                                            </div>
                                                        </button>
                                    <%
                                                    } else if (node.type === 'liveClass') {
                                    %>
                                                        <button onclick="joinLive('<%= node.meetingUrl %>', '<%= (node.name || '').replace(/'/g, "\\'") %>')"
                                                            class="lesson-item w-full p-2.5 flex items-start gap-3 hover:bg-rose-50/50 dark:hover:bg-rose-500/5 transition-all rounded-lg text-left group" style="margin-left: <%= depth * 0.5 %>rem">
                                                            <div class="size-7 rounded border border-rose-200 dark:border-rose-500/20 bg-rose-50 dark:bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0 group-hover:bg-rose-500 group-hover:text-white transition-all shadow-sm">
                                                                <span class="material-symbols-rounded text-[16px]">live_tv</span>
                                                            </div>
                                                            <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                                <h5 class="text-[12px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-rose-500 transition-colors truncate"><%= node.name %></h5>
                                                                <div class="flex items-center gap-1 mt-0.5">
                                                                    <span class="text-[7px] font-black text-rose-500 uppercase tracking-widest">LIVE</span>
                                                                    <% if (node.date) { %>
                                                                        <span class="size-1 bg-slate-200 rounded-full"></span>
                                                                        <span class="text-[8px] font-bold text-slate-400"><%= new Date(node.date).toLocaleTimeString('bn-BD', {hour: '2-digit', minute:'2-digit'}) %></span>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </button>
                                    <%
                                                    }
                                                } else if (node.type === 'quiz') {
                                                    var quizObj = node.quizId;
                                    %>
                                                        <a href="/quiz/<%= quizObj ? (quizObj._id || quizObj) : '' %>?courseId=<%= course._id %>&from=course"
                                                            class="lesson-item w-full p-2.5 flex items-start gap-3 hover:bg-amber-50/50 dark:hover:bg-amber-500/5 transition-all rounded-lg text-left group" style="margin-left: <%= depth * 0.5 %>rem">
                                                            <div class="size-7 rounded border border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0 group-hover:bg-amber-500 group-hover:text-white transition-all shadow-sm">
                                                                <span class="material-symbols-rounded text-[16px]">psychology</span>
                                                            </div>
                                                            <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                                <h5 class="text-[12px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-amber-600 transition-colors truncate"><%= node.name %></h5>
                                                                <span class="text-[7px] font-black text-amber-600 uppercase tracking-widest mt-0.5 inline-block">EXAM</span>
                                                            </div>
                                                        </a>
                                    <%
                                                } else if (node.type === 'note') {
                                                    const ext = (node.filePath || '').split('.').pop().toLowerCase().split('?')[0];
                                                    const isImg = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'avif'].includes(ext);
                                    %>
                                                        <div onclick="<%= isImg ? `openImageViewer('${node.filePath}', '${(node.name || 'Note').replace(/'/g, "\\'")}')` : `openPdfViewer('${node.filePath}', '${(node.name || 'Note').replace(/'/g, "\\'")}')` %>"
                                                            class="lesson-item w-full p-2.5 flex items-start gap-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all rounded-lg text-left group cursor-pointer" style="margin-left: <%= depth * 0.5 %>rem">
                                                            <div class="size-7 rounded border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800/50 text-slate-500 flex items-center justify-center shrink-0 group-hover:bg-slate-700 group-hover:text-white transition-all shadow-sm">
                                                                <span class="material-symbols-rounded text-[16px]">description</span>
                                                            </div>
                                                            <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                                <h5 class="text-[12px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-slate-800 dark:group-hover:text-white transition-colors truncate"><%= node.name %></h5>
                                                                <span class="text-[7px] font-black text-slate-400 uppercase tracking-widest mt-0.5 inline-block">Note</span>
                                                            </div>
                                                        </div>
                                    <%
                                                }
                                            });
                                        }
                                        renderPlayerSidebarTree(course.curriculumNodes, null, 0);
                                    %>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center text-center py-12 opacity-60">
                                        <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">playlist_play</span>
                                        <p class="text-xs font-medium text-slate-500">No lessons available</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'courses' }) %>

    <script>
        function toggleTheme() {
            if (window.OddhayTheme) {
                window.OddhayTheme.toggle();
            } else {
                document.documentElement.classList.toggle('dark');
                const isDark = document.documentElement.classList.contains('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                const icon = document.getElementById('themeIcon');
                if (icon) icon.innerText = isDark ? 'light_mode' : 'dark_mode';
            }
        }

        function switchPlayerTab(tabId) {
            document.querySelectorAll('.player-tab-trigger').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.player-content-section').forEach(s => s.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.add('active');
            document.getElementById('content-' + tabId).classList.remove('hidden');
        }

        let activeLessonId = null;
        let lastProgressSaveTime = 0;

        // Custom back button handler: flush playback progress before navigating back
        window.onBeforeHeaderNavBack = function(proceed) {
            const videoEl = document.getElementById('playerVideoEl');
            if (videoEl && videoEl.currentTime > 0 && activeLessonId) {
                const nowSec = Math.floor(videoEl.currentTime);
                const durSec = Math.floor(videoEl.duration || 0);
                const isCompleted = durSec > 0 && (
                    (nowSec / durSec >= 0.92) ||
                    (durSec >= 300 && durSec - nowSec <= 25)
                );
                try {
                    fetch('/api/progress', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        keepalive: true,
                        body: JSON.stringify({ 
                            lessonId: activeLessonId, 
                            courseId: '<%= course._id %>', 
                            lessonTitle: document.getElementById('playerVideoTitle')?.innerText || 'Lesson', 
                            lastPosition: nowSec, 
                            duration: durSec, 
                            completed: isCompleted 
                        })
                    });
                } catch(e) {}
            }
            return false; // let executeCoreBackNavigation handle navigation to playerBackUrl
        };

        function playLesson(url, title, duration, btn) {
            const iframe = document.getElementById('playerIframeEl');
            const videoEl = document.getElementById('playerVideoEl');
            const emptyState = document.getElementById('playerEmptyState');

            emptyState.classList.add('hidden');

            const lessonId = btn ? btn.getAttribute('data-lesson-id') : null;
            activeLessonId = lessonId;
            const courseId = '<%= course._id %>';
            const currentUserId = '<%= user ? user._id : "" %>';

            // Determine saved resume timestamp (URL query param > localStorage > server timestamp)
            const urlParams = new URLSearchParams(window.location.search);
            const paramTime = parseFloat(urlParams.get('time'));
            const localSavedTime = parseFloat(localStorage.getItem(`video-progress-${currentUserId}-${lessonId}`));
            const serverSavedTime = <%= (user && user.lastWatchedLesson && user.lastWatchedLesson.lastPosition) || 0 %>;
            
            let targetResumeTime = 0;
            if (!isNaN(paramTime) && paramTime > 0) {
                targetResumeTime = paramTime;
            } else if (!isNaN(localSavedTime) && localSavedTime > 0) {
                targetResumeTime = localSavedTime;
            } else if (serverSavedTime > 0) {
                targetResumeTime = serverSavedTime;
            }

            let hasResumedPlayback = (targetResumeTime <= 0);

            const isLocalFile = url && (url.startsWith('/uploads/') || url.startsWith('/api/') || /\.(mp4|webm|ogg|mov)$/i.test(url));

            if (isLocalFile) {
                iframe.classList.add('hidden');
                iframe.src = '';
                videoEl.classList.remove('hidden');
                videoEl.src = url;
                videoEl.load();

                // Seek to targetResumeTime on metadata load with multi-stage fallback
                if (targetResumeTime > 0) {
                    const seekHandler = function() {
                        if (hasResumedPlayback) return;
                        if (!videoEl.duration || targetResumeTime < videoEl.duration - 2) {
                            try { videoEl.currentTime = targetResumeTime; } catch(e) {}
                        }
                        if (Math.abs(videoEl.currentTime - targetResumeTime) <= 1 || videoEl.currentTime >= targetResumeTime) {
                            hasResumedPlayback = true;
                        }
                    };
                    if (videoEl.readyState >= 1) {
                        seekHandler();
                    }
                    videoEl.addEventListener('loadedmetadata', seekHandler);
                    videoEl.addEventListener('canplay', seekHandler);
                    videoEl.addEventListener('playing', function onPlayResume() {
                        if (!hasResumedPlayback && targetResumeTime > 0) {
                            seekHandler();
                            setTimeout(() => {
                                if (videoEl.currentTime < 1 && targetResumeTime > 1) {
                                    try { videoEl.currentTime = targetResumeTime; } catch(e) {}
                                }
                                hasResumedPlayback = true;
                            }, 150);
                        }
                    });
                }

                const playPromise = videoEl.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => { console.log('Autoplay prevented:', error); });
                }

                // Track and save video progress dynamically
                videoEl.ontimeupdate = function() {
                    if (videoEl.currentTime > 0 && activeLessonId) {
                        // Guard against saving near 0 while seeking to resume timestamp
                        if (!hasResumedPlayback && targetResumeTime > 1 && videoEl.currentTime < 1) return;

                        localStorage.setItem(`video-progress-${currentUserId}-${activeLessonId}`, videoEl.currentTime);
                        const nowSec = Math.floor(videoEl.currentTime);
                        const durSec = Math.floor(videoEl.duration || 0);
                        const isCompleted = durSec > 0 && (
                            (nowSec / durSec >= 0.92) ||
                            (durSec >= 300 && durSec - nowSec <= 25)
                        );
                        if (Math.abs(nowSec - lastProgressSaveTime) >= 5 || (isCompleted && !videoEl.__hasAutoCompleted)) {
                            lastProgressSaveTime = nowSec;
                            if (isCompleted) videoEl.__hasAutoCompleted = true;
                            fetch('/api/progress', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                keepalive: true,
                                body: JSON.stringify({ 
                                    lessonId: activeLessonId, 
                                    courseId, 
                                    lessonTitle: title || 'Lesson', 
                                    lastPosition: nowSec, 
                                    duration: durSec, 
                                    completed: isCompleted 
                                })
                            }).catch(err => console.log('Progress update error:', err));
                        }
                    }
                };

                videoEl.onended = function() {
                    if (activeLessonId) {
                        videoEl.__hasAutoCompleted = true;
                        fetch('/api/progress', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                lessonId: activeLessonId, 
                                courseId, 
                                lessonTitle: title || 'Lesson', 
                                lastPosition: Math.floor(videoEl.duration || videoEl.currentTime),
                                duration: Math.floor(videoEl.duration || 0),
                                completed: true
                            })
                        }).catch(err => console.log('Progress onended error:', err));
                    }
                };
            } else {
                videoEl.classList.add('hidden');
                videoEl.pause();
                videoEl.src = '';
                iframe.classList.remove('hidden');
                let embedUrl = url || '';
                if (embedUrl && embedUrl.includes('vimeo.com') && !embedUrl.includes('player.vimeo.com')) {
                    embedUrl = embedUrl.replace('vimeo.com', 'player.vimeo.com/video');
                }
                if (targetResumeTime > 0) {
                    if (embedUrl.includes('youtube.com') || embedUrl.includes('youtu.be')) {
                        embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'start=' + Math.floor(targetResumeTime);
                    } else if (embedUrl.includes('vimeo.com')) {
                        embedUrl += '#t=' + Math.floor(targetResumeTime) + 's';
                    }
                }
                iframe.src = embedUrl;
            }

            document.getElementById('playerVideoTitle').innerText = title || 'Course Lesson';
            document.getElementById('live-badge').classList.add('hidden');
            
            // --- Save last watched lesson to server immediately on play ---
            console.log('[ODDHAY XP] Sending play event for lessonId:', lessonId, 'courseId:', courseId);
            fetch('/api/progress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lessonId: lessonId || null, courseId: courseId || null, lessonTitle: title || 'Lesson', lastPosition: Math.floor(targetResumeTime), isPlayEvent: true })
            })
            .then(r => r.json())
            .then(data => console.log('[ODDHAY XP] Progress response:', data))
            .catch(err => console.log('[ODDHAY XP] Progress save failed:', err));

            // Async views tracking and comments fetch
            if (activeLessonId) {
                incrementNodeView(activeLessonId);
                loadNodeComments(activeLessonId);
            }

            document.querySelectorAll('.lesson-item').forEach(b => {
                b.classList.remove('bg-primary/10', 'border-primary', 'shadow-md');
                const iconContainer = b.querySelector('.size-7');
                if (iconContainer && !b.innerHTML.includes('LIVE') && !b.innerHTML.includes('EXAM')) {
                    iconContainer.classList.remove('bg-primary', 'text-white', 'border-primary');
                }
            });

            if (btn) {
                btn.classList.add('bg-primary/5', 'border-primary', 'shadow-sm');
                const iconContainer = btn.querySelector('.size-7');
                if (iconContainer) iconContainer.classList.add('bg-primary', 'text-white', 'border-primary');
            }

            const notesContainer = document.getElementById('notes-container');
            notesContainer.innerHTML = '';
            let notes = [];
            try { notes = JSON.parse((btn && btn.getAttribute('data-notes')) || '[]'); } catch(e) {}
            
            if (notes.length > 0) {
                notes.forEach(function(note) {
                    const ext = (note.filePath || '').split('.').pop().toLowerCase().split('?')[0];
                    const isImg = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'avif'].includes(ext);
                    if (isImg) {
                        notesContainer.innerHTML += `
                            <div onclick="openImageViewer('${note.filePath}', '${(note.title || 'Note').replace(/'/g, "\\'")}')" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 flex items-center gap-3 group hover:border-emerald-500/50 transition-all cursor-pointer">
                                <div class="size-9 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center border border-emerald-500/20 shrink-0">
                                    <span class="material-symbols-rounded text-[18px]">image</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-black text-slate-700 dark:text-slate-200 truncate">${note.title}</h4>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Note</p>
                                </div>
                                <span class="material-symbols-rounded text-slate-400 group-hover:text-emerald-500 transition-colors">zoom_in</span>
                            </div>
                        `;
                    } else {
                        const canDownload = (typeof window.canDownloadMaterial !== 'undefined') ? !!window.canDownloadMaterial : false;
                        notesContainer.innerHTML += `
                            <div onclick="openPdfViewer('${note.filePath}', '${(note.title || 'Note').replace(/'/g, "\\'")}')" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 flex items-center gap-3 group hover:border-primary/50 transition-all cursor-pointer">
                                <div class="size-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center border border-primary/20 shrink-0">
                                    <span class="material-symbols-rounded text-[18px]">description</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-black text-slate-700 dark:text-slate-200 truncate">${note.title}</h4>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Note</p>
                                </div>
                                <span class="material-symbols-rounded text-slate-400 group-hover:text-primary transition-colors" title="View Document">visibility</span>
                            </div>
                        `;
                    }
                });
            } else {
                notesContainer.innerHTML = '<p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest text-center py-8 col-span-full">No notes available for this lesson</p>';
            }

            // Scroll to top
            document.querySelector('main').scrollTo({ top: 0, behavior: 'smooth' });
        }

        async function incrementNodeView(nodeId) {
            try {
                const res = await fetch(`/api/curriculum/node/${nodeId}/view`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('playerVideoViews').innerText = formatCount(data.views);
                }
            } catch (err) {
                console.error('Error incrementing views:', err);
            }
        }

        <% 
            const isFreeCourse = (course.accessType === 'free' || course.accessType === 'Free');
            const isInstructorOrAdmin = (course.instructor?._id?.toString() === (locals.user ? user._id.toString() : '') || (locals.user && ['admin', 'superadmin', 'teacher'].includes(user.role)));
            const isPaidEnrolled = (locals.user && user.enrolledCourses && user.enrolledCourses.some(e => e && e.course && e.course.toString() === course._id.toString() && (!e.expiresAt || new Date(e.expiresAt) > new Date())));
            const userCanDownload = isFreeCourse || isPaidEnrolled || isInstructorOrAdmin;
        %>
        window.canDownloadMaterial = <%= userCanDownload ? 'true' : 'false' %>;

        // Comments System Logic
        let commentsSkip = 0;
        const commentsLimit = 10;
        let commentsHasMore = false;
        let loadedCommentsArray = [];
        const openCommentReplies = new Set();
        const currentUserId = '<%= locals.user ? user._id : "" %>';
        const userRole = '<%= locals.user ? user.role : "student" %>';
        const currentCourseId = '<%= course._id %>';

        async function loadNodeComments(nodeId, append = false, isSilent = false) {
            const list = document.getElementById('commentsList');
            const loadMoreContainer = document.getElementById('loadMoreCommentsContainer');
            if (!list) return;

            if (!append && !isSilent) {
                commentsSkip = 0;
                loadedCommentsArray = [];
                list.innerHTML = `
                    <div class="flex items-center justify-center py-10">
                        <div class="animate-spin rounded-full h-5 w-5 border-2 border-primary border-t-transparent"></div>
                    </div>
                `;
            }

            try {
                const res = await fetch(`/api/curriculum/node/${nodeId}/comments?limit=${commentsLimit}&skip=${commentsSkip}`);
                const data = await res.json();
                if (data.success && data.comments) {
                    commentsHasMore = data.hasMore;
                    
                    if (append) {
                        loadedCommentsArray = loadedCommentsArray.concat(data.comments);
                    } else {
                        loadedCommentsArray = data.comments;
                    }

                    const banner = document.getElementById('commentsDisabledBanner');
                    if (banner) {
                        if (data.commentsDisabled) banner.classList.remove('hidden');
                        else banner.classList.add('hidden');
                    }

                    if (loadedCommentsArray.length === 0) {
                        list.innerHTML = `
                            <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                                <p class="text-xs font-medium text-slate-500">No comments yet</p>
                                <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                            </div>
                        `;
                        if (loadMoreContainer) loadMoreContainer.classList.add('hidden');
                        return;
                    }

                    renderCommentsList(loadedCommentsArray);

                    if (loadMoreContainer) {
                        if (commentsHasMore) {
                            loadMoreContainer.classList.remove('hidden');
                        } else {
                            loadMoreContainer.classList.add('hidden');
                        }
                    }
                }
            } catch (err) {
                console.error('Error loading comments:', err);
                if (!isSilent) {
                    list.innerHTML = `<p class="text-xs text-rose-500 text-center py-4">Failed to load comments</p>`;
                }
            }
        }

        function timeAgo(date) {
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);
            let interval = Math.floor(seconds / 31536000);
            if (interval >= 1) return interval === 1 ? '1 year ago' : interval + ' years ago';
            interval = Math.floor(seconds / 2592000);
            if (interval >= 1) return interval === 1 ? '1 month ago' : interval + ' months ago';
            interval = Math.floor(seconds / 86400);
            if (interval >= 1) return interval === 1 ? '1 day ago' : interval + ' days ago';
            interval = Math.floor(seconds / 3600);
            if (interval >= 1) return interval === 1 ? '1 hour ago' : interval + ' hours ago';
            interval = Math.floor(seconds / 60);
            if (interval >= 1) return interval === 1 ? '1 minute ago' : interval + ' minutes ago';
            return seconds < 10 ? 'just now' : seconds + ' seconds ago';
        }

