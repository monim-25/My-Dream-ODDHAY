                    : '';

                return `
                    <div class="flex gap-3 group border-b border-slate-100 dark:border-white/5 pb-3">
                        <div class="size-8 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-white/10 bg-slate-50">
                            <img src="${avatar}" class="size-full object-cover" alt="${c.userName}">
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2 w-full relative">
                                <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate">${c.userName}</span>
                                    ${badgeText ? `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-none shrink-0 ${badgeClass}">${badgeText}</span>` : ''}
                                    ${c.highlighted ? `<span class="text-[9px] font-bold bg-yellow-400 dark:bg-yellow-500 text-slate-900 dark:text-slate-950 px-1.5 py-0.5 rounded-none shrink-0 flex items-center gap-0.5"><span class="material-symbols-rounded text-[11px] font-bold">push_pin</span>Highlighted</span>` : ''}
                                    <span class="text-[10px] text-slate-400 shrink-0">${dateDisplay}</span>
                                </div>
                                
                                <div class="relative shrink-0">
                                    <button type="button" onclick="toggleCommentDropdown(event, '${c._id}')" class="p-1 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-700 dark:text-slate-200 rounded-none transition-all flex items-center justify-center font-extrabold" title="Options">
                                        <span class="material-symbols-rounded text-sm font-bold leading-none">more_vert</span>
                                    </button>
                                    <div id="dropdown-${c._id}" class="hidden absolute right-0 mt-1 w-32 bg-[#FFFFFF] dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-lg rounded-none py-0.5 z-30">
                                        ${isStaffUser ? `
                                            <button type="button" onclick="toggleCommentHighlight('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-[14px]">${c.highlighted ? 'explore_off' : 'push_pin'}</span> ${c.highlighted ? 'Unhighlight' : 'Highlight'}
                                            </button>
                                        ` : ''}
                                        ${isCommentAuthor ? `
                                            <button type="button" onclick="triggerEditComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-[14px]">edit</span> Edit
                                            </button>
                                            <button type="button" onclick="triggerDeleteComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/20 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-[14px]">delete</span> Delete
                                            </button>
                                        ` : (isStaffUser ? `
                                            <button type="button" onclick="triggerDeleteComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/20 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-[14px]">delete</span> Delete
                                            </button>
                                        ` : `
                                            <button type="button" onclick="triggerReportComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/20 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-[14px]">flag</span> Report
                                            </button>
                                        `)}
                                    </div>
                                </div>
                            </div>
                            ${renderExpandableText(c.text, c._id)}
                            
                            <div class="flex items-center gap-3 mt-1">
                                <button type="button" onclick="toggleReplyForm('${c._id}', '${c.userName}')" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-1">
                                    <span class="material-symbols-rounded text-[13px]">reply</span> Reply
                                </button>
                            </div>
                            
                            <div id="reply-form-${c._id}" class="hidden mt-2 pl-4 w-full max-w-[350px]">
                                <form onsubmit="submitReply(event, '${c._id}', '${c._id}')" class="flex gap-2 items-start w-full">
                                    <textarea required rows="1" oninput="this.style.height = 'auto'; this.style.height = this.scrollHeight + 'px';" placeholder="Write a reply..." class="flex-1 text-xs p-2 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed w-full min-h-[36px]"></textarea>
                                    <div class="flex gap-1 shrink-0">
                                        <button type="button" onclick="toggleReplyForm('${c._id}', '', true)" class="px-2 py-1 text-[9px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 text-slate-500 rounded-none">Cancel</button>
                                        <button type="submit" class="px-2.5 py-1 bg-primary hover:bg-primary/95 text-white text-[9px] font-bold uppercase tracking-wider rounded-none">Reply</button>
                                    </div>
                                </form>
                            </div>

                            <div id="edit-comment-form-${c._id}" class="hidden mt-2 w-full max-w-[350px]">
                                <form onsubmit="submitEditComment(event, '${c._id}')" class="flex gap-2 items-start w-full">
                                    <textarea required rows="1" oninput="this.style.height = 'auto'; this.style.height = this.scrollHeight + 'px';" class="flex-1 text-xs p-2 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed w-full min-h-[36px]">${escapeHTML(c.text)}</textarea>
                                    <div class="flex gap-1 shrink-0">
                                        <button type="button" onclick="toggleEditCommentForm('${c._id}', true)" class="px-2 py-1 text-[9px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 text-slate-500 rounded-none">Cancel</button>
                                        <button type="submit" class="px-2.5 py-1 bg-primary hover:bg-primary/95 text-white text-[9px] font-bold uppercase tracking-wider rounded-none">Save</button>
                                    </div>
                                </form>
                            </div>

                            ${repliesBlock}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleRepliesList(commentId) {
            const block = document.getElementById(`replies-block-${commentId}`);
            const btn = document.getElementById(`toggle-replies-btn-${commentId}`);
            if (block && btn) {
                const isHidden = block.classList.contains('hidden');
                if (isHidden) {
                    block.classList.remove('hidden');
                    openCommentReplies.add(commentId);
                    btn.innerHTML = `<span class="material-symbols-rounded text-sm">unfold_less</span> Hide replies`;
                } else {
                    block.classList.add('hidden');
                    openCommentReplies.delete(commentId);
                    const count = block.querySelectorAll('.pl-6 > div, div.flex.gap-3').length || block.children.length;
                    btn.innerHTML = `<span class="material-symbols-rounded text-sm">unfold_more</span> View ${count} ${count === 1 ? 'reply' : 'replies'}`;
                }
            }
        }

        async function loadNextCommentsPage() {
            if (!activeLessonId || !commentsHasMore) return;
            commentsSkip += commentsLimit;
            await loadNodeComments(activeLessonId, true);
        }

        async function submitComment(e) {
            e.preventDefault();
            if (!activeLessonId) return;

            const input = document.getElementById('commentInput');
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn ? btn.innerText : 'Comment';
            if (btn) {
                btn.disabled = true;
                btn.innerText = 'Posting...';
            }

            try {
                const res = await fetch(`/api/curriculum/node/${activeLessonId}/comments`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, courseId: currentCourseId })
                });
                const data = await res.json();
                if (data.success) {
                    if (input) input.value = '';
                    await loadNodeComments(activeLessonId);
                } else {
                    alert('Error: ' + (data.error || 'Could not post comment'));
                }
            } catch (err) {
                console.error('Error posting comment:', err);
                alert('Failed to post comment');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            }
        }

        function toggleReplyForm(formId, replyToUser = '', forceHide = false) {
            const formDiv = document.getElementById(`reply-form-${formId}`);
            if (formDiv) {
                if (forceHide) {
                    formDiv.classList.add('hidden');
                    const textarea = formDiv.querySelector('textarea');
                    if (textarea) textarea.value = '';
                } else {
                    const isHidden = formDiv.classList.contains('hidden');
                    if (isHidden) {
                        document.querySelectorAll('[id^="reply-form-"]').forEach(el => {
                            if (el.id !== `reply-form-${formId}`) {
                                el.classList.add('hidden');
                                const ta = el.querySelector('textarea');
                                if (ta) ta.value = '';
                            }
                        });

                        formDiv.classList.remove('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) {
                            if (replyToUser) {
                                textarea.value = `@${replyToUser} `;
                            } else {
                                textarea.value = '';
                            }
                            textarea.focus();
                        }
                    } else {
                        formDiv.classList.add('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) textarea.value = '';
                    }
                }
            }
        }

        async function submitReply(e, commentId, formId) {
            e.preventDefault();
            const formDiv = document.getElementById(`reply-form-${formId}`);
            const textarea = formDiv ? formDiv.querySelector('textarea') : null;
            if (!textarea) return;
            const text = textarea.value.trim();
            if (!text) return;

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn ? btn.innerText : 'Reply';
            if (btn) {
                btn.disabled = true;
                btn.innerText = '...';
            }

            try {
                const res = await fetch(`/api/curriculum/comment/${commentId}/reply`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text })
                });
                const data = await res.json();
                if (data.success) {
                    textarea.value = '';
                    openCommentReplies.add(commentId);
                    toggleReplyForm(formId, '', true);
                    if (activeLessonId) {
                        await loadNodeComments(activeLessonId);
                    }
                } else {
                    alert('Error posting reply: ' + (data.error || 'Server error'));
                }
            } catch (err) {
                console.error('Error posting reply:', err);
                alert('Failed to post reply');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            }
        }

        function toggleEditCommentForm(commentId, forceHide = false) {
            const formDiv = document.getElementById(`edit-comment-form-${commentId}`);
            if (formDiv) {
                if (forceHide) {
                    formDiv.classList.add('hidden');
                } else {
                    const isHidden = formDiv.classList.contains('hidden');
                    if (isHidden) {
                        formDiv.classList.remove('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) textarea.focus();
                    } else {
                        formDiv.classList.add('hidden');
                    }
                }
            }
        }

        function toggleEditReplyForm(commentId, replyId, forceHide = false) {
            const formDiv = document.getElementById(`edit-reply-form-${replyId}`);
            if (formDiv) {
                if (forceHide) {
                    formDiv.classList.add('hidden');
                } else {
                    const isHidden = formDiv.classList.contains('hidden');
                    if (isHidden) {
                        formDiv.classList.remove('hidden');
                        const textarea = formDiv.querySelector('textarea');
                        if (textarea) textarea.focus();
                    } else {
                        formDiv.classList.add('hidden');
                    }
                }
            }
        }

        async function submitEditComment(e, commentId) {
            e.preventDefault();
            const textarea = e.target.querySelector('textarea');
            const text = textarea ? textarea.value.trim() : '';
            if (!text) return;

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn ? btn.innerText : 'Save';
            if (btn) {
                btn.disabled = true;
                btn.innerText = '...';
            }

            try {
                const res = await fetch(`/api/curriculum/comment/${commentId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text })
                });
                const data = await res.json();
                if (data.success) {
                    toggleEditCommentForm(commentId, true);
                    if (activeLessonId) {
                        await loadNodeComments(activeLessonId);
                    }
                } else {
                    alert('Error editing comment: ' + (data.error || 'Server error'));
                }
            } catch (err) {
                console.error('Error editing comment:', err);
                alert('Failed to edit comment');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            }
        }

        async function submitEditReply(e, commentId, replyId) {
            e.preventDefault();
            const textarea = e.target.querySelector('textarea');
            const text = textarea ? textarea.value.trim() : '';
            if (!text) return;

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn ? btn.innerText : 'Save';
            if (btn) {
                btn.disabled = true;
                btn.innerText = '...';
            }

            try {
                const res = await fetch(`/api/curriculum/comment/${commentId}/reply/${replyId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text })
                });
                const data = await res.json();
                if (data.success) {
                    toggleEditReplyForm(commentId, replyId, true);
                    if (activeLessonId) {
                        await loadNodeComments(activeLessonId);
                    }
                } else {
                    alert('Error editing reply: ' + (data.error || 'Server error'));
                }
            } catch (err) {
                console.error('Error editing reply:', err);
                alert('Failed to edit reply');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            }
        }

        function toggleCommentDropdown(e, id) {
            e.stopPropagation();
            const dropdown = document.getElementById(`dropdown-${id}`);
            if (dropdown) {
                const isHidden = dropdown.classList.contains('hidden');
                document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
                if (isHidden) {
                    dropdown.classList.remove('hidden');
                }
            }
        }

        function renderExpandableText(text, id) {
            const escaped = escapeHTML(text);
            if (text.length <= 220) {
                return `<p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed whitespace-pre-wrap">${escaped}</p>`;
            }
            const shortText = escapeHTML(text.substring(0, 220));
            return `
                <div id="text-container-${id}" class="mt-1">
                    <p id="text-short-${id}" class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${shortText}... <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read more</button></p>
                    <p id="text-full-${id}" class="hidden text-xs text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${escaped} <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read less</button></p>
                </div>
            `;
        }

        function toggleCommentTextExpand(id) {
            const shortEl = document.getElementById(`text-short-${id}`);
            const fullEl = document.getElementById(`text-full-${id}`);
            if (shortEl && fullEl) {
                if (shortEl.classList.contains('hidden')) {
                    shortEl.classList.remove('hidden');
                    fullEl.classList.add('hidden');
                } else {
                    shortEl.classList.add('hidden');
                    fullEl.classList.remove('hidden');
                }
            }
        }

        function triggerEditComment(id) {
            toggleEditCommentForm(id);
        }

        function triggerEditReply(commentId, replyId) {
            toggleEditReplyForm(commentId, replyId);
        }

        function triggerDeleteComment(commentId) {
            const modalText = document.getElementById('deleteModalText');
            if (modalText) {
                modalText.innerText = `Are you sure you want to delete this comment? This action is permanent and cannot be undone.`;
            }
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            if (confirmBtn) {
                confirmBtn.onclick = async () => {
                    const originalText = confirmBtn.innerText;
                    confirmBtn.disabled = true;
                    confirmBtn.innerText = 'Deleting...';
                    try {
                        const res = await fetch(`/api/curriculum/comment/${commentId}`, {
                            method: 'DELETE'
                        });
                        const data = await res.json();
                        if (data.success) {
                            closeDeleteModal();
                            if (activeLessonId) {
                                await loadNodeComments(activeLessonId);
                            }
                        } else {
                            alert('Error deleting comment: ' + (data.error || 'Server error'));
                        }
                    } catch (err) {
                        console.error('Error deleting comment:', err);
                        alert('Failed to delete comment');
                    } finally {
                        confirmBtn.disabled = false;
                        confirmBtn.innerText = originalText;
                    }
                };
            }
            document.getElementById('deleteModal')?.classList.remove('hidden');
        }

        function triggerDeleteReply(commentId, replyId) {
            const modalText = document.getElementById('deleteModalText');
            if (modalText) {
                modalText.innerText = `Are you sure you want to delete this reply? This action is permanent and cannot be undone.`;
            }
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            if (confirmBtn) {
                confirmBtn.onclick = async () => {
                    const originalText = confirmBtn.innerText;
                    confirmBtn.disabled = true;
                    confirmBtn.innerText = 'Deleting...';
                    try {
                        const res = await fetch(`/api/curriculum/comment/${commentId}/reply/${replyId}`, {
                            method: 'DELETE'
                        });
                        const data = await res.json();
                        if (data.success) {
                            closeDeleteModal();
                            if (activeLessonId) {
                                await loadNodeComments(activeLessonId);
                            }
                        } else {
                            alert('Error deleting reply: ' + (data.error || 'Server error'));
                        }
                    } catch (err) {
                        console.error('Error deleting reply:', err);
                        alert('Failed to delete reply');
                    } finally {
                        confirmBtn.disabled = false;
                        confirmBtn.innerText = originalText;
                    }
                };
            }
            document.getElementById('deleteModal')?.classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal')?.classList.add('hidden');
        }

        function triggerReportComment(id) {
            alert('Comment has been reported to the site administrator. Thank you.');
        }

        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        function formatCount(num) {
            if (!num) return '0';
            num = parseInt(num, 10);
            if (isNaN(num)) return '0';
            if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'm';
            if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
            return num.toString();
        }

        // Global outside click listener to auto-close all dropdowns
        document.addEventListener('click', () => {
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
        });

        function joinLive(roomId, title) {
            document.getElementById('playerVideoTitle').innerText = title || 'Live Class';
            document.getElementById('live-badge').classList.remove('hidden');
            window.location.href = '/live/' + roomId;
        }

        function trackNoteRead(noteId) {
            // First track activity for XP
            fetch('/api/track-activity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type: 'note' })
            }).catch(e => {});

            // Then save progress for course completion
            if (noteId) {
                const courseId = '<%= course._id %>';
                fetch('/api/progress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lessonId: noteId, courseId: courseId })
                }).catch(e => {});
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const lessonId = urlParams.get('lesson');
            
            let targetBtn = null;
            if (lessonId) {
                targetBtn = document.querySelector(`button[data-lesson-id="${lessonId}"]`);
                if (!targetBtn) {
                    targetBtn = Array.from(document.querySelectorAll('button[onclick^="playLesson"]')).find(btn => btn.getAttribute('onclick').includes(lessonId));
                }
            }
            
            if (!targetBtn) {
                targetBtn = document.querySelector('button[data-notes]');
            }
            
            if (targetBtn) {
                targetBtn.click();
                setTimeout(() => {
                    targetBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 500);
            }
        });

    </script>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#000]/80 backdrop-blur-sm transition-all duration-300">
        <div class="w-full max-w-md bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-2xl shadow-2xl p-6 relative">
            <h3 class="text-base font-bold text-slate-800 dark:text-white mb-2">Confirm Delete</h3>
            <p id="deleteModalText" class="text-xs text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">Are you sure you want to delete this comment? This action is permanent and cannot be undone.</p>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-slate-50 dark:hover:bg-white/5 transition-all">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-sm">Delete</button>
            </div>
        </div>
    </div>

    <%- include('partials/image-viewer') %>
</body>
</html>