<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Progress & Analytics | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'progress' }) %>
        
        <main class="flex-1 overflow-y-auto p-2 lg:p-3 space-y-2.5 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120]">
            
            <!-- Page Header -->
            <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3.5 shadow-sm">
                <h1 class="text-lg lg:text-xl font-black text-slate-800 dark:text-white leading-tight">Academic Progress & Analytics</h1>
                <p class="text-[10px] font-semibold text-slate-400">Track quiz performance, subject mastery, and learning activity</p>
            </div>

            <!-- Stats Bar Grid (Tight) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 text-center shadow-sm">
                    <div class="text-xl font-black text-primary mb-0.5"><%= locals.stats ? stats.totalQuizzes : 0 %></div>
                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Total Quizzes</div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 text-center shadow-sm">
                    <div class="text-xl font-black text-emerald-500 mb-0.5"><%= locals.stats ? stats.avgScore : 0 %>%</div>
                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Avg Score</div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 text-center shadow-sm">
                    <div class="text-xl font-black text-blue-500 mb-0.5"><%= locals.stats ? stats.totalCourses : 0 %></div>
                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Enrolled Courses</div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 text-center shadow-sm">
                    <div class="text-xl font-black text-purple-500 mb-0.5"><%= locals.stats ? stats.completedLessons : 0 %></div>
                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Lessons Done</div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3 text-center shadow-sm col-span-2 sm:col-span-1">
                    <div class="text-xl font-black text-orange-500 mb-0.5"><%= locals.stats ? stats.daysLearning : 0 %></div>
                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Active Days</div>
                </div>
            </div>

            <!-- Main Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5">
                
                <!-- Weekly Activity Bar Chart -->
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-4 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                        <span class="material-symbols-rounded text-primary text-lg">bar_chart</span>
                        <h2 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">Weekly Activity</h2>
                    </div>

                    <% if (locals.weeklyActivity && weeklyActivity.length > 0) { %>
                        <div class="flex items-end gap-2 h-40 border-b border-slate-100 dark:border-slate-800 pb-2 pt-4">
                            <% const maxCount = Math.max(...weeklyActivity.map(d => d.count), 1); %>
                            <% weeklyActivity.forEach(function(day) { %>
                                <div class="flex-1 flex flex-col items-center gap-2">
                                    <div class="w-full bg-primary/20 hover:bg-primary rounded-lg transition-all relative group flex flex-col justify-end"
                                        style="height: <%= Math.max((day.count / maxCount) * 110, 10) %>px;">
                                        <% if (day.count > 0) { %>
                                            <div class="absolute -top-7 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-[8px] font-bold px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                                                <%= day.count %> Quizzes
                                            </div>
                                        <% } %>
                                    </div>
                                    <span class="text-[9px] font-bold text-slate-400 uppercase"><%= day.day %></span>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="py-10 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                            <span class="material-symbols-rounded text-3xl text-slate-300 mb-1">bar_chart</span>
                            <p class="text-xs font-bold text-slate-400">No activity logged this week</p>
                        </div>
                    <% } %>
                </div>

                <!-- Subject Performance Breakdown -->
                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-4 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                        <span class="material-symbols-rounded text-primary text-lg">school</span>
                        <h2 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">Subject Performance</h2>
                    </div>

                    <% const subjects = locals.subjectPerformance ? Object.entries(subjectPerformance) : []; %>
                    <% if (subjects.length > 0) { %>
                        <div class="space-y-3">
                            <% subjects.slice(0, 4).forEach(function([subject, data]) { %>
                                <% const pct = Math.round((data.score / Math.max(data.total, 1)) * 100); %>
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= subject %></span>
                                        <span class="text-xs font-bold <%= pct >= 70 ? 'text-emerald-500' : pct >= 50 ? 'text-amber-500' : 'text-rose-500' %>"><%= pct %>%</span>
                                    </div>
                                    <div class="h-1.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full rounded-full transition-all duration-700 <%= pct >= 70 ? 'bg-emerald-500' : pct >= 50 ? 'bg-amber-500' : 'bg-rose-500' %>" style="width: <%= pct %>%;"></div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="py-10 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                            <span class="material-symbols-rounded text-3xl text-slate-300 mb-1">quiz</span>
                            <p class="text-xs font-bold text-slate-400">Subject stats will appear after taking quizzes</p>
                        </div>
                    <% } %>
                </div>

            </div>

            <!-- Recent Quiz Results List -->
            <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-4 shadow-sm space-y-3">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                    <span class="material-symbols-rounded text-primary text-lg">history</span>
                    <h2 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">Recent Quiz Results</h2>
                </div>

                <% if (locals.recentQuizzes && recentQuizzes.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <% recentQuizzes.forEach(function(r) { %>
                            <% const pct = Math.round((r.score / Math.max(r.total || 1, 1)) * 100); %>
                            <div class="flex items-center justify-between p-3 bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="size-9 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 <%= pct >= 70 ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 border border-emerald-200/50' : pct >= 50 ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-500 border border-amber-200/50' : 'bg-rose-50 dark:bg-rose-500/10 text-rose-500 border border-rose-200/50' %>">
                                        <%= pct %>%
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate"><%= r.quiz?.title || 'Practice Quiz' %></p>
                                        <p class="text-[9px] font-semibold text-slate-400">
                                            <%= new Date(r.date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="font-black text-sm text-slate-800 dark:text-slate-200"><%= r.score %>/<%= r.total %></span>
                                    <span class="text-[9px] font-bold text-slate-400 uppercase block">Score</span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="py-8 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                        <p class="text-xs font-bold text-slate-400">No quiz attempts recorded yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Performance Insight Alert Banner -->
            <% if (locals.stats && stats.totalQuizzes > 0) { %>
                <div class="bg-white dark:bg-[#0f172a] border-l-4 <%= stats.avgScore >= 70 ? 'border-l-emerald-500 bg-emerald-50/40 dark:bg-emerald-500/5' : stats.avgScore >= 50 ? 'border-l-amber-500 bg-amber-50/40 dark:bg-amber-500/5' : 'border-l-rose-500 bg-rose-50/40 dark:bg-rose-500/5' %> border-y border-r border-slate-200/80 dark:border-slate-800/80 rounded-xl p-3.5 shadow-sm">
                    <div class="flex items-center gap-3">
                        <div class="size-9 rounded-lg flex items-center justify-center shrink-0 <%= stats.avgScore >= 70 ? 'bg-emerald-100 text-emerald-600' : stats.avgScore >= 50 ? 'bg-amber-100 text-amber-600' : 'bg-rose-100 text-rose-600' %>">
                            <span class="material-symbols-rounded text-xl">
                                <%= stats.avgScore >= 70 ? 'emoji_events' : stats.avgScore >= 50 ? 'trending_up' : 'school' %>
                            </span>
                        </div>
                        <div>
                            <h3 class="font-bold text-xs text-slate-800 dark:text-white leading-tight">
                                <%= stats.avgScore >= 70 ? 'Outstanding Performance! 🎉' : stats.avgScore >= 50 ? 'Good Progress - Keep Going! 💪' : 'Needs Practice & Revision 📚' %>
                            </h3>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">
                                Your current average score is <%= stats.avgScore %>%. Continue taking quizzes and reviewing lecture notes for maximum mastery.
                            </p>
                        </div>
                    </div>
                </div>
            <% } %>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'progress' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>