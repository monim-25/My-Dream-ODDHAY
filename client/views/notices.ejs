<!DOCTYPE html>
<html lang="bn" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Notice & Updates | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'notices' }) %>

        <main class="flex-1 overflow-y-auto p-3 lg:p-5 space-y-4 no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120]">

            <!-- Page Header -->
            <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-xl p-4 lg:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="size-11 rounded-xl bg-rose-50 dark:bg-rose-950/50 border border-rose-100 dark:border-rose-900/40 flex items-center justify-center text-rose-500 shadow-sm shrink-0">
                        <span class="material-symbols-rounded text-2xl">campaign</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-lg lg:text-xl font-black text-slate-800 dark:text-white leading-tight">নোটিশ ও আপডেট কেন্দ্র</h1>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-rose-500/10 text-rose-500 border border-rose-500/20">
                                <%= notices.length %> টি নোটিশ
                            </span>
                        </div>
                        <p class="text-xs font-semibold text-slate-400 mt-0.5">আপনার সকল কোর্স নোটিশ, পরীক্ষা এবং প্ল্যাটফর্ম ঘোষণার বিস্তারিত তথ্য</p>
                    </div>
                </div>

                <!-- Filter & Search Controls -->
                <div class="flex items-center gap-2">
                    <div class="relative flex-1 sm:w-64">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                        <input type="text" id="noticeSearch" placeholder="নোটিশ খুঁজুন..." onkeyup="filterNotices()"
                            class="w-full pl-9 pr-4 py-2 text-xs font-semibold bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg focus:outline-none focus:border-rose-500 dark:text-slate-100 transition-colors">
                    </div>
                    <button onclick="window.location.reload()" class="p-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg transition-colors shadow-sm" title="Refresh">
                        <span class="material-symbols-rounded text-lg">refresh</span>
                    </button>
                </div>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
                <button onclick="setFilter('all')" id="tab-all" class="filter-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0 bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                    <span class="material-symbols-rounded text-sm">all_inbox</span> সকল নোটিশ
                </button>
                <button onclick="setFilter('important')" id="tab-important" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 bg-white dark:bg-[#0f172a] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600">
                    <span class="material-symbols-rounded text-sm text-rose-500">priority_high</span> হাই-প্রায়োরিটি
                </button>
                <button onclick="setFilter('course')" id="tab-course" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 bg-white dark:bg-[#0f172a] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600">
                    <span class="material-symbols-rounded text-sm text-blue-500">auto_stories</span> কোর্স নোটিশ
                </button>
                <button onclick="setFilter('system')" id="tab-system" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 bg-white dark:bg-[#0f172a] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:text-emerald-600">
                    <span class="material-symbols-rounded text-sm text-emerald-500">notifications</span> সিস্টেম আপডেট
                </button>
            </div>

            <!-- Notice Cards Feed Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="noticeGrid">
                <% if (notices && notices.length > 0) { %>
                    <% notices.forEach(n => { %>
                        <div class="notice-card bg-white dark:bg-[#0f172a] border <%= n.isHighPriority ? 'border-rose-400 dark:border-rose-500/50 shadow-rose-500/5' : 'border-slate-200/80 dark:border-slate-800/80' %> rounded-xl p-4 lg:p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group relative overflow-hidden"
                             data-category="<%= n.isHighPriority ? 'important' : (n.courseTitle.includes('কোর্স') || n.courseTitle !== 'সিস্টেম ঘোষণা' ? 'course' : 'system') %>"
                             data-title="<%= n.title.toLowerCase() %>"
                             data-message="<%= n.message.toLowerCase() %>"
                             id="card-<%= n.rawId %>">
                            
                            <% if (n.isHighPriority) { %>
                                <div class="absolute top-0 right-0 bg-rose-500 text-white text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-bl-lg shadow-sm flex items-center gap-1">
                                    <span class="material-symbols-rounded text-[11px] animate-pulse">priority_high</span> Important
                                </div>
                            <% } %>

                            <div>
                                <!-- Top Metadata Badges -->
                                <div class="flex items-center gap-2 mb-2 flex-wrap pr-16">
                                    <% if (n.courseTitle) { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                            <span class="material-symbols-rounded text-xs text-rose-500">auto_stories</span>
                                            <span class="truncate max-w-[140px]"><%= n.courseTitle %></span>
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Notice Title -->
                                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white leading-snug mb-2 group-hover:text-rose-500 transition-colors">
                                    <%= n.title %>
                                </h3>

                                <!-- Notice Content (Message Body) -->
                                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-4 whitespace-pre-line mb-3 font-medium">
                                    <%= n.message %>
                                </p>
                            </div>

                            <!-- Footer Details -->
                            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between mt-auto">
                                <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-400">
                                    <span class="material-symbols-rounded text-xs shrink-0 flex items-center justify-center -mt-0.5">schedule</span>
                                    <span><%= n.timeAgo %></span>
                                </div>

                                <div class="flex items-center gap-2">
                                    <button onclick="openNoticeModal('<%= n.title.replace(/'/g, "\\'") %>', '<%= n.message.replace(/'/g, "\\'").replace(/\n/g, "\\n") %>', '<%= n.courseTitle %>', '<%= n.timeAgo %>', '<%= n.link %>', '<%= n.id %>')"
                                            class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold rounded-lg transition-colors">
                                        বিস্তারিত
                                    </button>
                                    <% if (n.link && n.link !== '/dashboard') { %>
                                        <a href="<%= n.link %>" onclick="attendNotice('<%= n.id %>')"
                                           class="px-3.5 py-1.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-lg transition-colors shadow-sm">
                                            গন্তব্যে যান
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-10 text-center text-slate-400 flex flex-col items-center justify-center gap-3">
                        <div class="size-14 rounded-full bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-500 shadow-sm">
                            <span class="material-symbols-rounded text-3xl">check_circle</span>
                        </div>
                        <h3 class="text-sm font-bold text-slate-700 dark:text-slate-200">কোনো নতুন নোটিশ নেই</h3>
                        <p class="text-xs text-slate-400">আপনার সকল নোটিশ ও আপডেট ক্লিয়ার আছে!</p>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <!-- Notice Detail Modal -->
    <div id="noticeModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-5 lg:p-6 shadow-2xl space-y-4 relative animate-in fade-in zoom-in-95 duration-200">
            <button onclick="closeNoticeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-white p-1 rounded-lg transition-colors">
                <span class="material-symbols-rounded text-xl">close</span>
            </button>

            <div class="flex items-center gap-2 pr-8">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-rose-500/10 text-rose-500 border border-rose-500/20" id="modalCourseTitle">
                    কোর্স নোটিশ
                </span>
                <span class="text-xs font-semibold text-slate-400 flex items-center gap-1">
                    <span class="material-symbols-rounded text-xs">schedule</span>
                    <span id="modalTimeAgo">সম্প্রতি</span>
                </span>
            </div>

            <h2 class="text-base lg:text-lg font-black text-slate-900 dark:text-white leading-snug" id="modalTitle">
                নোটিশ শিরোনাম
            </h2>

            <div class="bg-slate-50 dark:bg-slate-900/80 border border-slate-100 dark:border-slate-800 rounded-xl p-4 text-xs lg:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium whitespace-pre-wrap max-h-60 overflow-y-auto" id="modalMessage">
                নোটিশ বার্তা...
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                <button onclick="closeNoticeModal()" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-bold transition-colors">
                    বন্ধ করুন
                </button>
                <a id="modalActionLink" href="#" class="px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white rounded-xl text-xs font-bold transition-colors shadow-sm hidden">
                    গন্তব্যে যান
                </a>
            </div>
        </div>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'notices' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        function setFilter(cat) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.className = 'filter-btn px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 bg-white dark:bg-[#0f172a] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-50';
            });
            const activeBtn = document.getElementById('tab-' + cat);
            if (activeBtn) {
                activeBtn.className = 'filter-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm';
            }

            const cards = document.querySelectorAll('.notice-card');
            cards.forEach(c => {
                if (cat === 'all' || c.dataset.category === cat) {
                    c.style.display = 'flex';
                } else {
                    c.style.display = 'none';
                }
            });
        }

        function filterNotices() {
            const query = document.getElementById('noticeSearch').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.notice-card');
            cards.forEach(c => {
                const title = c.dataset.title || '';
                const msg = c.dataset.message || '';
                if (title.includes(query) || msg.includes(query)) {
                    c.style.display = 'flex';
                } else {
                    c.style.display = 'none';
                }
            });
        }

        let currentActiveNoticeId = null;

        function openNoticeModal(title, message, courseTitle, timeAgo, link, noticeId) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            document.getElementById('modalCourseTitle').innerText = courseTitle || 'নোটিশ';
            document.getElementById('modalTimeAgo').innerText = timeAgo || 'সম্প্রতি';
            
            const btn = document.getElementById('modalActionLink');
            currentActiveNoticeId = noticeId;

            if (link && link !== '/dashboard' && link !== '#') {
                btn.href = link;
                btn.onclick = function() { attendNotice(noticeId); };
                btn.classList.remove('hidden');
            } else {
                btn.classList.add('hidden');
            }

            document.getElementById('noticeModal').classList.remove('hidden');
        }

        function closeNoticeModal() {
            document.getElementById('noticeModal').classList.add('hidden');
            if (currentActiveNoticeId) {
                attendNotice(currentActiveNoticeId);
            }
        }

        function attendNotice(noticeId) {
            if (!noticeId) return;
            try {
                fetch('/api/attend-notice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ noticeId })
                }).catch(err => {});
            } catch (e) {}
        }
    </script>
</body>
</html>
