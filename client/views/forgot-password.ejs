<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Forgot Password | ODDHAY</title>
    <%- include('partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Main Auth Card Container (Vertically centered) -->
    <main class="w-full flex-1 flex items-center justify-center my-auto py-3 sm:py-5 relative z-10">
        <div class="w-full max-w-[405px] mx-auto transition-all duration-300">
            
            <!-- The Form Card -->
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-5 sm:p-6 pb-4 sm:pb-4.5 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text on Form -->
                <div class="text-center mb-4 sm:mb-5">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- Header -->
                <div class="text-center mb-4">
                    <h1 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-1">
                        Forgot Password
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                        Enter your email and we'll send you a reset link.
                    </p>
                </div>

                <!-- Alert: Error Message -->
                <% if (locals.error && error) { %>
                    <div class="mb-4 p-3 rounded-xl bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0">error</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Alert: Success Message -->
                <% if (locals.message && message) { %>
                    <div class="mb-4 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-base shrink-0 text-emerald-600 dark:text-emerald-400">mark_email_read</span>
                        <span><%= message %></span>
                    </div>
                    <div class="pt-2 text-center">
                        <a href="/login"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm inline-flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span class="material-symbols-outlined text-lg">login</span>
                            <span>Return to Sign In</span>
                        </a>
                    </div>
                <% } else { %>
                    <form action="/forgot-password" method="POST" id="forgotForm" class="space-y-3.5">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email Address
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    mail
                                </span>
                                <input type="email" name="email" id="email" placeholder="name@example.com"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autofocus autocomplete="email">
                            </div>
                        </div>

                        <button type="submit" id="submitBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="btnText">Send Reset Link</span>
                            <span id="btnIcon" class="material-symbols-outlined text-lg">send</span>
                        </button>
                    </form>

                    <!-- Back to Sign In -->
                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <a href="/login" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 hover:text-[#18a957] font-medium inline-flex items-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-base">west</span>
                            <span>Back to Sign In</span>
                        </a>
                    </div>
                <% } %>

            </div>

        </div>
    </main>

    <!-- Footer Copyright (Strictly placed at the very bottom) -->
    <footer class="w-full text-center py-3 mt-auto relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <script>
        document.getElementById('forgotForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            const text = document.getElementById('btnText');
            const icon = document.getElementById('btnIcon');
            if (btn && text) {
                btn.disabled = true;
                btn.classList.add('opacity-80', 'cursor-not-allowed');
                text.textContent = 'Sending link...';
                if (icon) {
                    icon.textContent = 'sync';
                    icon.classList.add('animate-spin');
                }
            }
        });
    </script>
</body>

</html>
