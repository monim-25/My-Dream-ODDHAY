<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Forgot Password | ODDHAY</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        .strength-bar {
            height: 3px;
            border-radius: 9999px;
            transition: all 0.25s ease;
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-slate-100 flex flex-col justify-between p-4 relative overflow-x-hidden selection:bg-[#18a957] selection:text-white transition-colors duration-300">

    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-[#18a957]/10 dark:bg-[#18a957]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Main Auth Card Container (Vertically centered) -->
    <main class="w-full flex-1 flex items-center justify-center my-auto py-3 sm:py-5 relative z-10">
        <div class="w-full max-w-[405px] mx-auto transition-all duration-300">
            
            <!-- The Form Card -->
            <div class="bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800/90 rounded-2xl sm:rounded-3xl p-5 sm:p-6 pb-4 sm:pb-4.5 shadow-xl shadow-slate-200/40 dark:shadow-none">

                <!-- Logo Type Text on Form -->
                <div class="text-center mb-4 sm:mb-5">
                    <a href="/" class="inline-block group" title="ODDHAY">
                        <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            ODDHAY<span class="text-[#18a957]">.</span>
                        </span>
                    </a>
                </div>

                <!-- ================= STEP 1: Enter Email or Phone ================= -->
                <div id="step1Section" class="transition-all duration-200">
                    <div class="text-center mb-4">
                        <h1 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-1">
                            Reset Password
                        </h1>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Enter your email or phone number to receive a 6-digit OTP code.
                        </p>
                    </div>

                    <form id="step1Form" class="space-y-3.5">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Email or Phone Number
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    contact_phone
                                </span>
                                <input type="text" name="identifier" id="resetIdentifier" placeholder="Email or phone number"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autofocus autocomplete="username">
                            </div>
                        </div>

                        <button type="submit" id="sendOtpBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="sendOtpText">Send OTP Code</span>
                            <span id="sendOtpIcon" class="material-symbols-outlined text-lg">send</span>
                        </button>
                    </form>

                    <!-- Back to Sign In -->
                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <a href="/login" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 hover:text-[#18a957] font-medium inline-flex items-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-base">west</span>
                            <span>Back to Sign In</span>
                        </a>
                    </div>
                </div>

                <!-- ================= STEP 2: Prove / Verify OTP Only ================= -->
                <div id="step2Section" class="hidden transition-all duration-200">
                    <div class="text-center mb-4">
                        <h2 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-1">
                            Verify Code
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Enter the 6-digit code sent to <span id="targetDisplay" class="font-medium text-slate-800 dark:text-slate-200"></span>
                        </p>
                    </div>

                    <form id="step2Form" class="space-y-3.5">
                        <!-- 6-digit OTP -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                6-Digit OTP Code
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    pin
                                </span>
                                <input type="text" name="otp" id="otpCode" placeholder="••••••" maxlength="6" inputmode="numeric" pattern="[0-9]*"
                                    class="w-full pl-10 pr-3.5 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-mono text-center text-lg tracking-[0.4em] placeholder:tracking-normal placeholder:font-normal placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="one-time-code">
                            </div>
                        </div>

                        <button type="submit" id="verifyOtpBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="verifyOtpText">Verify Code</span>
                            <span id="verifyOtpIcon" class="material-symbols-outlined text-lg">verified</span>
                        </button>
                    </form>

                    <!-- Resend OTP and Back Controls -->
                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs sm:text-sm">
                        <button type="button" onclick="goToStep1()" class="text-slate-500 dark:text-slate-400 hover:text-[#18a957] font-medium inline-flex items-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-base">west</span>
                            <span>Change Info</span>
                        </button>

                        <button type="button" id="resendOtpBtn" onclick="resendOtp()" disabled
                            class="text-slate-400 font-medium transition-colors disabled:cursor-not-allowed">
                            <span>Resend Code</span>
                            <span id="countdownText" class="ml-1 text-slate-400 font-mono">(60s)</span>
                        </button>
                    </div>
                </div>

                <!-- ================= STEP 3: Set New Password (Allowed Only After Proving OTP) ================= -->
                <div id="step3Section" class="hidden transition-all duration-200">
                    <div class="text-center mb-3">
                        <h2 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-white tracking-tight mb-1">
                            Set New Password
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
                            Code verified. Create a new password for your account.
                        </p>
                    </div>

                    <form id="step3Form" class="space-y-3.5">
                        <!-- New Password -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                New Password (min 6 characters)
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock
                                </span>
                                <input type="password" name="password" id="newPassword" placeholder="••••••••" minlength="6"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="new-password" oninput="checkStrength(this.value)">
                                <button type="button" onclick="togglePasswordVisibility('newPassword', 'eyeIcon1')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span class="material-symbols-outlined text-lg" id="eyeIcon1">visibility</span>
                                </button>
                            </div>

                            <!-- Strength Indicator -->
                            <div class="mt-2 flex gap-1" id="strengthBars">
                                <div class="strength-bar flex-1 bg-slate-200 dark:bg-slate-800" id="bar1"></div>
                                <div class="strength-bar flex-1 bg-slate-200 dark:bg-slate-800" id="bar2"></div>
                                <div class="strength-bar flex-1 bg-slate-200 dark:bg-slate-800" id="bar3"></div>
                                <div class="strength-bar flex-1 bg-slate-200 dark:bg-slate-800" id="bar4"></div>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-1 ml-0.5 hidden" id="strengthText"></p>
                        </div>

                        <!-- Confirm New Password -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5 ml-0.5">
                                Confirm New Password
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-lg">
                                    lock_reset
                                </span>
                                <input type="password" name="confirmPassword" id="confirmNewPassword" placeholder="••••••••" minlength="6"
                                    class="w-full pl-10 pr-10 h-11 rounded-xl bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-[#18a957] focus:border-[#18a957] text-slate-900 dark:text-white font-normal text-sm placeholder:text-slate-400 transition-all outline-none"
                                    required autocomplete="new-password" oninput="checkMatch()">
                                <button type="button" onclick="togglePasswordVisibility('confirmNewPassword', 'eyeIcon2')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-0.5"
                                    title="Show or hide password">
                                    <span class="material-symbols-outlined text-lg" id="eyeIcon2">visibility</span>
                                </button>
                            </div>
                            <p class="text-[11px] mt-1 ml-0.5 hidden" id="matchMsg"></p>
                        </div>

                        <button type="submit" id="savePasswordBtn"
                            class="w-full h-11 rounded-xl bg-[#18a957] hover:bg-[#148e49] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm active:scale-[0.99] transition-all">
                            <span id="savePasswordText">Update Password</span>
                            <span id="savePasswordIcon" class="material-symbols-outlined text-lg">check_circle</span>
                        </button>
                    </form>

                    <!-- Back to Login -->
                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-center">
                        <a href="/login" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 hover:text-[#18a957] font-medium inline-flex items-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-base">west</span>
                            <span>Cancel and Back to Sign In</span>
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </main>

    <!-- Footer Copyright (Strictly placed at the very bottom) -->
    <footer class="w-full text-center py-3 mt-auto relative z-10 shrink-0">
        <p class="text-xs text-slate-400 dark:text-slate-500 font-normal">
            &copy; <%= new Date().getFullYear() %> ODDHAY. All rights reserved.
        </p>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] scale-0 transition-transform duration-300 pointer-events-none w-max max-w-[90vw]">
        <div id="toast-body" class="px-4 py-2.5 rounded-full bg-red-500 text-white font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm">
            <span id="toast-icon" class="material-symbols-outlined text-base">error</span>
            <span id="toast-msg">Error occurred</span>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        let currentTargetIdentifier = '';
        let currentResetToken = '';
        let countdownTimer = null;
        let countdownSeconds = 60;

        function showToast(msg, type = 'error') {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-msg');

            body.className = `px-4 py-2.5 rounded-full font-medium shadow-lg flex items-center gap-2 text-xs sm:text-sm ${type === 'success' ? 'bg-[#18a957]' : 'bg-red-500'} text-white`;
            icon.textContent = type === 'success' ? 'check_circle' : 'error';
            message.textContent = msg;

            toast.classList.remove('scale-0');
            toast.classList.add('scale-100');

            setTimeout(() => {
                toast.classList.remove('scale-100');
                toast.classList.add('scale-0');
            }, 3500);
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function checkStrength(pw) {
            const bars = ['bar1', 'bar2', 'bar3', 'bar4'];
            const colors = ['bg-red-500', 'bg-amber-500', 'bg-yellow-500', 'bg-[#18a957]'];
            const labels = ['Weak', 'Fair', 'Good', 'Strong'];

            let score = 0;
            if (pw.length >= 6) score++;
            if (pw.length >= 10) score++;
            if (/[A-Z]/.test(pw) && /[0-9]/.test(pw)) score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;

            bars.forEach((id, i) => {
                const bar = document.getElementById(id);
                bar.className = 'strength-bar flex-1';
                if (i < score) {
                    bar.classList.add(colors[score - 1]);
                } else {
                    bar.classList.add('bg-slate-200', 'dark:bg-slate-800');
                }
            });

            const txt = document.getElementById('strengthText');
            if (pw.length > 0) {
                txt.classList.remove('hidden');
                txt.textContent = labels[score - 1] || 'Weak';
                txt.className = `text-[11px] mt-1 ml-0.5 ${score >= 3 ? 'text-[#18a957]' : score >= 2 ? 'text-amber-500' : 'text-red-500'}`;
            } else {
                txt.classList.add('hidden');
            }
        }

        function checkMatch() {
            const pw = document.getElementById('newPassword').value;
            const cpw = document.getElementById('confirmNewPassword').value;
            const msg = document.getElementById('matchMsg');
            if (!cpw) { msg.classList.add('hidden'); return; }
            msg.classList.remove('hidden');
            if (pw === cpw) {
                msg.textContent = '✓ Passwords match';
                msg.className = 'text-[11px] mt-1 ml-0.5 text-[#18a957] font-medium';
            } else {
                msg.textContent = '✗ Passwords do not match';
                msg.className = 'text-[11px] mt-1 ml-0.5 text-red-500 font-medium';
            }
        }

        function startCountdown() {
            clearInterval(countdownTimer);
            countdownSeconds = 60;
            const resendBtn = document.getElementById('resendOtpBtn');
            const countdownText = document.getElementById('countdownText');
            resendBtn.disabled = true;
            resendBtn.className = 'text-slate-400 font-medium transition-colors cursor-not-allowed';
            countdownText.textContent = `(${countdownSeconds}s)`;

            countdownTimer = setInterval(() => {
                countdownSeconds--;
                if (countdownSeconds <= 0) {
                    clearInterval(countdownTimer);
                    resendBtn.disabled = false;
                    resendBtn.className = 'text-[#18a957] hover:underline font-medium cursor-pointer transition-colors';
                    countdownText.textContent = '';
                } else {
                    countdownText.textContent = `(${countdownSeconds}s)`;
                }
            }, 1000);
        }

        function goToStep2(maskedTarget) {
            document.getElementById('step1Section').classList.add('hidden');
            document.getElementById('step2Section').classList.remove('hidden');
            document.getElementById('step3Section').classList.add('hidden');
            document.getElementById('targetDisplay').textContent = maskedTarget || currentTargetIdentifier;

            const otpInput = document.getElementById('otpCode');
            otpInput.value = '';
            otpInput.focus();
            startCountdown();
        }

        function goToStep3() {
            clearInterval(countdownTimer);
            document.getElementById('step1Section').classList.add('hidden');
            document.getElementById('step2Section').classList.add('hidden');
            document.getElementById('step3Section').classList.remove('hidden');

            const pwInput = document.getElementById('newPassword');
            pwInput.value = '';
            document.getElementById('confirmNewPassword').value = '';
            pwInput.focus();
        }

        function goToStep1() {
            clearInterval(countdownTimer);
            document.getElementById('step2Section').classList.add('hidden');
            document.getElementById('step3Section').classList.add('hidden');
            document.getElementById('step1Section').classList.remove('hidden');
            document.getElementById('resetIdentifier').focus();
        }

        // STEP 1 Form Submission: Send OTP Code
        document.getElementById('step1Form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const idInput = document.getElementById('resetIdentifier');
            const raw = idInput.value.trim();

            if (!raw) {
                idInput.classList.add('!border-red-500');
                return showToast('Please enter your email or phone number');
            } else {
                idInput.classList.remove('!border-red-500');
            }

            // Quick format validation
            const isEmail = raw.includes('@');
            if (isEmail) {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(raw)) {
                    idInput.classList.add('!border-red-500');
                    return showToast('Please enter a valid email address');
                }
            } else {
                const bengaliDigits = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
                const norm = raw.replace(/[০-৯]/g, d => bengaliDigits[d]).replace(/[\s\-\+\(\)]/g, '');
                const cleanPhone = norm.startsWith('880') ? '0' + norm.substring(3) : norm;
                if (!/^01[3-9]\d{8}$/.test(cleanPhone)) {
                    idInput.classList.add('!border-red-500');
                    return showToast('Please enter a valid 11-digit phone number');
                }
            }

            const btn = document.getElementById('sendOtpBtn');
            const text = document.getElementById('sendOtpText');
            const icon = document.getElementById('sendOtpIcon');
            btn.disabled = true;
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            text.textContent = 'Sending OTP...';
            icon.textContent = 'sync';
            icon.classList.add('animate-spin');

            try {
                const res = await fetch('/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ identifier: raw })
                });

                const data = await res.json();
                if (data.success) {
                    currentTargetIdentifier = raw;
                    showToast(data.message || 'OTP sent successfully!', 'success');
                    goToStep2(data.maskedTarget);
                } else {
                    showToast(data.error || 'Failed to send OTP. Please try again.');
                }
            } catch (err) {
                showToast('Network error, please try again');
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-80', 'cursor-not-allowed');
                text.textContent = 'Send OTP Code';
                icon.textContent = 'send';
                icon.classList.remove('animate-spin');
            }
        });

        // Resend OTP handler
        async function resendOtp() {
            if (!currentTargetIdentifier) return goToStep1();
            const resendBtn = document.getElementById('resendOtpBtn');
            resendBtn.disabled = true;

            try {
                const res = await fetch('/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ identifier: currentTargetIdentifier })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('A new verification code has been sent!', 'success');
                    startCountdown();
                } else {
                    showToast(data.error || 'Failed to resend code');
                    resendBtn.disabled = false;
                }
            } catch (err) {
                showToast('Network error while resending');
                resendBtn.disabled = false;
            }
        }

        // STEP 2 Form Submission: Prove / Verify OTP ONLY
        document.getElementById('step2Form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const otpInput = document.getElementById('otpCode');
            const otp = otpInput.value.trim();

            if (!otp || otp.length !== 6) {
                otpInput.classList.add('!border-red-500');
                return showToast('Please enter the 6-digit verification code');
            } else {
                otpInput.classList.remove('!border-red-500');
            }

            const btn = document.getElementById('verifyOtpBtn');
            const text = document.getElementById('verifyOtpText');
            const icon = document.getElementById('verifyOtpIcon');

            btn.disabled = true;
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            text.textContent = 'Verifying...';
            icon.textContent = 'sync';
            icon.classList.add('animate-spin');

            try {
                const res = await fetch('/forgot-password/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        identifier: currentTargetIdentifier,
                        otp: otp
                    })
                });

                const data = await res.json();
                if (data.success) {
                    currentResetToken = data.resetToken;
                    showToast('Verification code confirmed!', 'success');
                    goToStep3();
                } else {
                    otpInput.classList.add('!border-red-500');
                    showToast(data.error || 'Invalid or expired verification code');
                }
            } catch (err) {
                showToast('Network error, please try again');
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-80', 'cursor-not-allowed');
                text.textContent = 'Verify Code';
                icon.textContent = 'verified';
                icon.classList.remove('animate-spin');
            }
        });

        // STEP 3 Form Submission: Set New Password (Allowed Only After Proving OTP)
        document.getElementById('step3Form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const pwInput = document.getElementById('newPassword');
            const cpwInput = document.getElementById('confirmNewPassword');

            const password = pwInput.value;
            const confirmPassword = cpwInput.value;

            if (!password || password.length < 6) {
                pwInput.classList.add('!border-red-500');
                return showToast('Password must be at least 6 characters');
            } else {
                pwInput.classList.remove('!border-red-500');
            }

            if (password !== confirmPassword) {
                cpwInput.classList.add('!border-red-500');
                return showToast('Passwords do not match');
            } else {
                cpwInput.classList.remove('!border-red-500');
            }

            const btn = document.getElementById('savePasswordBtn');
            const text = document.getElementById('savePasswordText');
            const icon = document.getElementById('savePasswordIcon');

            btn.disabled = true;
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            text.textContent = 'Updating...';
            icon.textContent = 'sync';
            icon.classList.add('animate-spin');

            try {
                const res = await fetch('/forgot-password/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        identifier: currentTargetIdentifier,
                        resetToken: currentResetToken,
                        password: password,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (data.success) {
                    if (typeof confetti === 'function') {
                        confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 }, colors: ['#18a957', '#ffffff', '#3b82f6'] });
                    }
                    showToast('Password updated successfully! Redirecting...', 'success');
                    setTimeout(() => {
                        window.location.href = data.redirect || '/login?reset=success';
                    }, 1200);
                } else {
                    showToast(data.error || 'Password update failed. Please try again.');
                    btn.disabled = false;
                    btn.classList.remove('opacity-80', 'cursor-not-allowed');
                    text.textContent = 'Update Password';
                    icon.textContent = 'check_circle';
                    icon.classList.remove('animate-spin');
                }
            } catch (err) {
                showToast('Server error, please try again');
                btn.disabled = false;
                btn.classList.remove('opacity-80', 'cursor-not-allowed');
                text.textContent = 'Update Password';
                icon.textContent = 'check_circle';
                icon.classList.remove('animate-spin');
            }
        });
    </script>
</body>

</html>
