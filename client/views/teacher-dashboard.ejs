<!DOCTYPE html>
<html lang="bn" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Teacher Panel | ODDHAY Academic Console</title>
    <%- include('partials/head') %>
        <%- include('partials/app-styles') %>
            <style>
                /* Professional Teacher Console Design */
                body {
                    background-color: #f8fafc;
                    overflow: hidden;
                    height: 100vh;
                }

                .dark body {
                    background-color: #0b1120;
                }

                .console-card {
                    background: #ffffff;
                    border: 1px solid #f1f5f9;
                    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02);
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                }

                .dark .console-card {
                    background: #1e293b;
                    border: 1px solid #334155;
                    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
                }

                .no-scrollbar::-webkit-scrollbar {
                    display: none;
                }

                .no-scrollbar {
                    -ms-overflow-style: none;
                    scrollbar-width: none;
                }
            </style>
</head>

<body class="text-slate-800 dark:text-slate-200 font-sans flex transition-colors duration-300">

    <!-- Sidebar Navigation -->
    <aside
        class="w-20 lg:w-64 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] h-screen flex flex-col shrink-0 z-50">
        <%- include('admin/sidebar_content', { active: 'dashboard' }) %>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 flex flex-col h-screen relative overflow-hidden">
        <!-- Intelligent Header -->
        <header
            class="h-[76px] shrink-0 bg-white/50 dark:bg-[#0f172a]/50 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-8 z-40">
            <div class="flex items-center gap-3">
                <div class="size-2 rounded-full bg-primary animate-pulse"></div>
                <h2 class="text-sm font-black uppercase tracking-widest text-slate-400">Teacher <span
                        class="text-primary italic">Console</span></h2>
            </div>

            <div class="flex items-center gap-6">
                <button onclick="document.documentElement.classList.toggle('dark')"
                    class="size-10 rounded-xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary transition-all shadow-sm">
                    <span class="material-symbols-rounded dark:hidden">dark_mode</span>
                    <span class="material-symbols-rounded hidden dark:block text-amber-400">light_mode</span>
                </button>

                <div class="flex items-center gap-4 border-l border-slate-100 dark:border-slate-800 pl-6">
                    <div class="text-right hidden sm:block">
                        <p class="text-[11px] font-black leading-none mb-1 capitalize">
                            <%= user.name %>
                        </p>
                        <p class="text-[9px] font-black text-primary/60 uppercase tracking-widest">Active Instructor</p>
                    </div>
                    <div
                        class="size-10 rounded-xl bg-primary text-white flex items-center justify-center font-black shadow-lg shadow-primary/20">
                        <%= user.name[0] %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Scrollable content Area -->
        <div class="flex-1 overflow-y-auto no-scrollbar p-6 lg:p-10 space-y-10">
            <!-- Welcome Row -->
            <div class="flex flex-col md:flex-row items-end justify-between gap-6">
                <div>
                    <h1 class="text-2xl lg:text-3xl font-black tracking-tighter italic">Welcome Back, <span
                            class="text-primary not-italic">
                            <%= user.name.split(' ')[0] %></span>!</h1>
                    <p class="text-slate-500 font-bold text-xs mt-2 max-w-md tracking-wider">আজকের একাডেমিক কার্যক্রম এবং সাপোর্ট টিকেটগুলো একনজরে দেখে নিন।</p>
                </div>
                <div class="flex gap-3">
                    <button onclick="window.location=' /admin/courses'"
                                class="px-8 py-3.5 bg-slate-900 dark:bg-white dark:text-slate-900 text-white rounded-[1.5rem] font-black text-[11px] uppercase tracking-widest shadow-xl transition-all hover:scale-105 active:scale-95">
                                কোর্স ম্যানেজার</button>
                                <button onclick="document.getElementById('quickActionModal').classList.remove('hidden')"
                                    class="px-8 py-4 bg-primary text-white rounded-[1.5rem] font-black text-[11px] uppercase tracking-widest shadow-xl shadow-primary/20 transition-all hover:scale-105 active:scale-95">নতুন
                                    সেশন</button>
                </div>
            </div>

            <!-- Dashboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                <!-- Left Column (8 units) -->
                <div class="lg:col-span-8 space-y-8">

                    <!-- Performance Metrics -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="console-card rounded-[2.5rem] p-8 group hover:border-primary/30">
                            <div
                                class="size-14 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center mb-6 shadow-sm group-hover:scale-110 transition-transform">
                                <span class="material-symbols-rounded text-3xl italic">import_contacts</span>
                            </div>
                            <p
                                class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none mb-2">
                                মোট ক্লাস</p>
                            <h3 class="text-3xl font-black tracking-tighter">
                                <%= stats.totalClasses %>
                            </h3>
                        </div>
                        <div class="console-card rounded-[2.5rem] p-8 group hover:border-emerald-500/30">
                            <div
                                class="size-14 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-6 shadow-sm group-hover:scale-110 transition-transform">
                                <span class="material-symbols-rounded text-3xl">question_answer</span>
                            </div>
                            <p
                                class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none mb-2">
                                স্টুডেন্ট প্রশ্ন</p>
                            <h3 class="text-3xl font-black tracking-tighter">
                                <%= pendingQas.length %>
                            </h3>
                        </div>
                        <div class="console-card rounded-[2.5rem] p-8 group hover:border-amber-500/30">
                            <div
                                class="size-14 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center mb-6 shadow-sm group-hover:scale-110 transition-transform">
                                <span class="material-symbols-rounded text-3xl">task_alt</span>
                            </div>
                            <p
                                class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none mb-2">
                                লেকচার নোটস</p>
                            <h3 class="text-3xl font-black tracking-tighter">
                                <%= stats.totalNotes %>
                            </h3>
                        </div>
                    </div>

                    <!-- Pending Support (Q&A) -->
                    <div class="console-card rounded-[3rem] p-10">
                        <div class="flex items-center justify-between mb-10">
                            <h3 class="text-2xl font-black tracking-tighter flex items-center gap-3">
                                <span class="size-2 bg-emerald-500 rounded-full animate-pulse"></span> সাপোর্ট
                                রিকোয়েস্ট
                            </h3>
                            <a href="/superadmin/qas"
                                class="px-5 py-2.5 bg-slate-50 dark:bg-slate-800 text-[10px] rounded-xl font-black uppercase tracking-widest hover:bg-primary hover:text-white transition-all">সবগুলো
                                দেখুন</a>
                        </div>

                        <div class="space-y-4">
                            <% if(pendingQas && pendingQas.length> 0) { %>
                                <% pendingQas.forEach(qa=> { %>
                                    <div
                                        class="p-6 bg-slate-50 dark:bg-slate-800/40 rounded-[2rem] border border-slate-100 dark:border-slate-700 flex flex-col md:flex-row items-center gap-6 group hover:border-primary/20 transition-all">
                                        <div
                                            class="size-12 rounded-xl overflow-hidden shrink-0 border-2 border-white dark:border-slate-800 shadow-sm">
                                            <img src="<%= (qa.user && qa.user.profileImage) ? qa.user.profileImage : `https://ui-avatars.com/api/?name=${encodeURI(qa.user?.name || 'S')}&background=random` %>"
                                                class="w-full h-full object-cover">
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-2 mb-1">
                                                <h5 class="text-sm font-black text-slate-800 dark:text-white">
                                                    <%= qa.user?.name || 'Anonymous Student' %>
                                                </h5>
                                                <span
                                                    class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">•
                                                    <%= qa.user?.classLevel || 'HSC' %>
                                                </span>
                                            </div>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 italic">"
                                                <%= qa.question %>"
                                            </p>
                                        </div>
                                        <button onclick="window.location='/admin/qas'"
                                            class="px-6 py-2.5 bg-white dark:bg-slate-800 text-[10px] font-black uppercase tracking-widest rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 hover:text-primary transition-all">উত্তর
                                            দিন</button>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="py-12 text-center opacity-50">
                                                <span
                                                    class="material-symbols-rounded text-5xl mb-4">sentiment_satisfied</span>
                                                <p class="text-[10px] font-black uppercase tracking-widest">আপাতত কোনো
                                                    পেন্ডিং রিকোয়েস্ট নেই</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Right Column (4 units) -->
                <div class="lg:col-span-4 space-y-8">

                    <!-- Schedule Box -->
                    <div class="console-card rounded-[3rem] p-8 border-primary/20 bg-primary/5">
                        <h3 class="text-sm font-black italic mb-6 flex items-center gap-2 text-primary">
                            <span class="material-symbols-rounded text-xl">event_upcoming</span> আজকের শিডিউল
                        </h3>
                        <div class="space-y-4">
                            <div
                                class="p-4 bg-white dark:bg-slate-800 rounded-2xl border border-primary/10 relative overflow-hidden group hover:scale-[1.02] transition-all">
                                <div
                                    class="absolute right-0 top-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
                                    <span class="material-symbols-rounded text-5xl">live_tv</span>
                                </div>
                                <p class="text-[9px] font-black text-primary uppercase tracking-widest mb-1">Physics
                                    Chapter 3</p>
                                <h4 class="text-xs font-black text-slate-800 dark:text-white mb-2">লাইভ রিভিশন ক্লাস
                                </h4>
                                <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400">
                                    <span class="material-symbols-rounded text-sm">schedule</span> ০৮:৩০ টা - রাত
                                </div>
                                <button
                                    class="mt-4 w-full py-2.5 bg-primary text-white text-[9px] font-black uppercase tracking-widest rounded-xl">জয়েন
                                    করুন</button>
                            </div>
                        </div>
                    </div>

                    <!-- Guardian Connect -->
                    <div class="console-card rounded-[3rem] p-8">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-sm font-black italic flex items-center gap-2">
                                <span class="material-symbols-rounded text-xl">guardian</span> অভিভাবক ফিডব্যাক
                            </h3>
                        </div>
                        <div class="space-y-4">
                            <div
                                class="p-4 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-700">
                                <div class="flex items-center gap-3 mb-3">
                                    <div
                                        class="size-8 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center font-black text-[10px]">
                                        P</div>
                                    <div>
                                        <p class="text-[10px] font-black leading-none">অভিভাবক - সাদমান ইসলাম</p>
                                        <p class="text-[8px] text-slate-400 mt-1">Class 10 Student's parent</p>
                                    </div>
                                </div>
                                <p class="text-[10px] text-slate-500 italic leading-relaxed">"আমার সন্তানের প্রগ্রেস
                                    রিপোর্টে কিছু বিষয় বুঝতে সমস্যা হচ্ছে, কথা বলা সম্ভব?"</p>
                                <button
                                    class="mt-4 text-[9px] font-black text-primary uppercase tracking-widest flex items-center gap-1 group">কথা
                                    বলুন <span
                                        class="material-symbols-rounded text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span></button>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="space-y-4">
                        <p class="text-[11px] font-black text-slate-400 uppercase tracking-widest px-4">সাম্প্রতিক আপডেট
                        </p>
                        <% recentActivity.forEach(act=> { %>
                            <div class="flex items-start gap-4 px-4 py-3 group">
                                <div
                                    class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0 text-slate-400 group-hover:text-primary transition-all">
                                    <span class="material-symbols-rounded text-xl">
                                        <%= act.icon %>
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 leading-tight">
                                        <%= act.text %>
                                    </p>
                                    <p class="text-[9px] text-slate-400 mt-1 uppercase font-black">
                                        <%= act.time %>
                                    </p>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal for Quick Actions -->
    <div id="quickActionModal"
        class="fixed inset-0 bg-slate-900/40 backdrop-blur-xl z-[100] hidden flex items-center justify-center p-6">
        <div
            class="bg-white dark:bg-[#0f172a] rounded-[3.5rem] w-full max-w-lg overflow-hidden shadow-2xl animate-fade-up">
            <div class="p-12 text-center relative">
                <button onclick="document.getElementById('quickActionModal').classList.add('hidden')"
                    class="absolute top-8 right-8 size-10 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 transition-all">
                    <span class="material-symbols-rounded">close</span>
                </button>
                <div
                    class="size-16 rounded-[1.5rem] bg-primary/10 text-primary flex items-center justify-center mx-auto mb-6">
                    <span class="material-symbols-rounded text-3xl">add_to_photos</span>
                </div>
                <h3 class="text-2xl font-black italic mb-2 tracking-tighter">নতুন সেশন তৈরি</h3>
                <p class="text-slate-400 font-bold text-[10px] uppercase tracking-widest mb-10">নিচে থেকে আপনার পছন্দ
                    বেছে নিন</p>

                <div class="grid grid-cols-1 gap-4">
                    <a href="/superadmin/classes"
                        class="p-6 bg-slate-50 dark:bg-slate-800/40 rounded-[2rem] border border-slate-100 dark:border-slate-700 flex items-center gap-6 group hover:border-primary/30 transition-all">
                        <div
                            class="size-12 rounded-xl bg-primary text-white flex items-center justify-center shadow-lg shadow-primary/20">
                            <span class="material-symbols-rounded">video_call</span>
                        </div>
                        <div class="text-left">
                            <h4 class="text-xs font-black">রেকর্ড ক্লাস আপলোড</h4>
                            <p class="text-[9px] text-slate-400 font-bold uppercase mt-1">ভিডিও ফাইল প্রসেসিং</p>
                        </div>
                    </a>
                    <a href="/superadmin/courses"
                        class="p-6 bg-slate-50 dark:bg-slate-800/40 rounded-[2rem] border border-slate-100 dark:border-slate-700 flex items-center gap-6 group hover:border-rose-500/30 transition-all">
                        <div
                            class="size-12 rounded-xl bg-rose-500 text-white flex items-center justify-center shadow-lg shadow-rose-500/20">
                            <span class="material-symbols-rounded">live_tv</span>
                        </div>
                        <div class="text-left">
                            <h4 class="text-xs font-black">লাইভ সেশন শিডিউল</h4>
                            <p class="text-[9px] text-slate-400 font-bold uppercase mt-1">রিয়েল-টাইম স্ট্রিমিং</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Smooth theme handle
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</body>

</html>