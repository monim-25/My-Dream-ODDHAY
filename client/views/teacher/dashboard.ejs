<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Teacher Dashboard | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .admin-sidebar.active { transform: translateX(0); }
    </style>
</head>
<body class="bg-[#F8F8FF] text-slate-800 dark:text-slate-200 font-sans min-h-screen">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-100 dark:border-white/5">
            <%- include('sidebar', { active: 'dashboard' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 ml-[260px] bg-[#F8F8FF] flex flex-col min-h-screen">
            <%- include('../admin/header_v2', { pageTitle: 'Teacher Intelligence Hub' }) %>

            <div class="content-scroll border-l border-slate-900/10 dark:border-white/5">
                <!-- Stats Grid - 5 Cards -->
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-1 mb-1">

                    <!-- Assigned Courses -->
                    <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                        <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-slate-50/50 dark:bg-white/[0.02] h-full min-h-[110px]">
                            <div class="size-9 rounded-md bg-blue-500/10 flex items-center justify-center text-blue-500 mb-1.5">
                                <span class="material-symbols-rounded text-[18px]">auto_stories</span>
                            </div>
                            <p class="text-[11px] font-semibold text-blue-600 dark:text-blue-400">Assigned Courses</p>
                            <div class="flex-1"></div>
                            <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter"><%= stats.totalCourses %></h3>
                        </div>
                    </div>

                    <!-- Total Classes -->
                    <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                        <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-slate-50/50 dark:bg-white/[0.02] h-full min-h-[110px]">
                            <div class="size-9 rounded-md bg-emerald-500/10 flex items-center justify-center text-emerald-500 mb-1.5">
                                <span class="material-symbols-rounded text-[18px]">play_circle</span>
                            </div>
                            <p class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Total Classes</p>
                            <div class="flex-1"></div>
                            <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter"><%= stats.totalClasses %></h3>
                        </div>
                    </div>

                    <!-- Pending Q&A -->
                    <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                        <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-slate-50/50 dark:bg-white/[0.02] h-full min-h-[110px]">
                            <div class="size-9 rounded-md bg-amber-500/10 flex items-center justify-center text-amber-500 mb-1.5">
                                <span class="material-symbols-rounded text-[18px]">forum</span>
                            </div>
                            <p class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Pending Q&A</p>
                            <div class="flex-1"></div>
                            <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter"><%= pendingQas.length %></h3>
                        </div>
                    </div>

                    <!-- Questions Answered -->
                    <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                        <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-slate-50/50 dark:bg-white/[0.02] h-full min-h-[110px]">
                            <div class="size-9 rounded-md bg-rose-500/10 flex items-center justify-center text-rose-500 mb-1.5">
                                <span class="material-symbols-rounded text-[18px]">mark_chat_read</span>
                            </div>
                            <p class="text-[11px] font-semibold text-rose-600 dark:text-rose-400">Questions Answered</p>
                            <div class="flex-1"></div>
                            <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter"><%= stats.answeredQas %></h3>
                        </div>
                    </div>

                    <!-- Your Contents (unchanged) -->
                    <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                        <div class="p-4 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-slate-50/50 dark:bg-white/[0.02] h-full min-h-[120px]">
                            <p class="text-[11px] font-bold text-violet-600 dark:text-violet-400 mb-3 flex items-center gap-1.5"><span class="material-symbols-rounded text-[14px]">folder_open</span> Your Contents</p>
                            <div class="space-y-2 flex-1">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] text-slate-500 flex items-center gap-1.5"><span class="material-symbols-rounded text-[13px] text-slate-400">videocam</span>Recorded</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= contents.totalRecorded %></span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] text-slate-500 flex items-center gap-1.5"><span class="material-symbols-rounded text-[13px] text-rose-400">stream</span>Live</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= contents.totalLive %></span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] text-slate-500 flex items-center gap-1.5"><span class="material-symbols-rounded text-[13px] text-blue-400">description</span>Notes</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= contents.totalNotes %></span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] text-slate-500 flex items-center gap-1.5"><span class="material-symbols-rounded text-[13px] text-emerald-400">quiz</span>Questions</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= contents.totalAddedQuestions %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-1">
                    <!-- Left Column -->
                    <div class="lg:col-span-2 flex flex-col gap-1">
                        <!-- Upcoming Live Classes -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-100 dark:border-white/5 overflow-hidden shadow-sm">
                            <div class="px-6 py-5 border-b border-slate-50 dark:border-white/5 flex items-center justify-between">
                                <h3 class="font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2"><span class="material-symbols-rounded text-rose-500 text-[18px]">stream</span> Upcoming Live Classes</h3>
                            </div>
                            <div class="p-2">
                                <% if (upcomingLiveClasses && upcomingLiveClasses.length > 0) { %>
                                    <% upcomingLiveClasses.forEach(lc => { %>
                                        <div class="p-4 rounded-md hover:bg-slate-50 dark:hover:bg-white/5 transition-all group border border-transparent hover:border-slate-100 dark:hover:border-white/5 mb-1 flex items-center justify-between">
                                            <div class="flex items-center gap-4">
                                                <div class="size-10 rounded-md bg-rose-500/10 text-rose-500 flex items-center justify-center flex-shrink-0">
                                                    <span class="material-symbols-rounded">calendar_today</span>
                                                </div>
                                                <div>
                                                    <h4 class="text-sm font-bold text-slate-900 dark:text-white"><%= lc.classTitle %></h4>
                                                    <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 mt-0.5"><%= lc.courseTitle %> &bull; <%= new Date(lc.date).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></p>
                                                </div>
                                            </div>
                                            <a href="/live/<%= lc.meetingUrl %>" target="_blank" class="px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-md shadow-sm transition-all flex items-center gap-2 flex-shrink-0">
                                                <span class="material-symbols-rounded text-[14px]">videocam</span> Start Class
                                            </a>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="py-12 text-center">
                                        <span class="material-symbols-rounded text-4xl text-slate-200 dark:text-slate-800 mb-2">event_available</span>
                                        <p class="text-xs font-medium text-slate-400">No upcoming live classes scheduled.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Pending Q&A Feed -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-100 dark:border-white/5 overflow-hidden shadow-sm">
                            <div class="px-6 py-5 border-b border-slate-50 dark:border-white/5 flex items-center justify-between">
                                <h3 class="font-bold text-slate-900 dark:text-white tracking-tight">Recent Student Queries</h3>
                                <a href="/teacher/qa" class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-1"><span class="material-symbols-rounded text-[14px]">open_in_new</span> View All</a>
                            </div>
                            <div class="p-2">
                                <% if (pendingQas.length > 0) { %>
                                    <% pendingQas.forEach(qa => { %>
                                        <div class="p-4 rounded-md hover:bg-slate-50 dark:hover:bg-white/5 transition-all group border border-transparent hover:border-slate-100 dark:hover:border-white/5 mb-1">
                                            <div class="flex items-start gap-4">
                                                <div class="size-10 rounded-full bg-slate-100 dark:bg-slate-800 flex-shrink-0 overflow-hidden">
                                                    <% if (qa.user && qa.user.profilePicture) { %>
                                                        <img src="<%= qa.user.profilePicture %>" class="size-full object-cover">
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-slate-400 size-full flex items-center justify-center">person</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate"><%= qa.user ? qa.user.name : 'Unknown Student' %></h4>
                                                        <span class="text-[9px] font-bold text-slate-400"><%= new Date(qa.createdAt).toLocaleDateString() %></span>
                                                    </div>
                                                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2"><%= qa.question %></p>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="py-12 text-center">
                                        <span class="material-symbols-rounded text-4xl text-slate-200 dark:text-slate-800 mb-2">done_all</span>
                                        <p class="text-xs font-medium text-slate-400">All queries have been answered!</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="flex flex-col gap-1">
                        <!-- Quick Actions -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-100 dark:border-white/5 overflow-hidden shadow-sm">
                            <div class="px-5 py-4 border-b border-slate-50 dark:border-white/5 flex items-center justify-between">
                                <h3 class="font-bold text-slate-900 dark:text-white tracking-tight">Quick Actions</h3>
                            </div>
                            <div class="p-3 grid grid-cols-2 gap-2">
                                <a href="/teacher/courses" class="w-full flex flex-col items-center justify-center py-5 bg-slate-50 dark:bg-slate-800/50 rounded-md hover:bg-blue-500 hover:text-white transition-all duration-200 group border border-slate-100 dark:border-white/5">
                                    <span class="material-symbols-rounded text-[24px] text-blue-500 group-hover:text-white mb-2 transition-colors">video_call</span>
                                    <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200 group-hover:text-white text-center leading-tight">Schedule Class</span>
                                </a>
                                <a href="/teacher/qa" class="w-full flex flex-col items-center justify-center py-5 bg-slate-50 dark:bg-slate-800/50 rounded-md hover:bg-amber-500 hover:text-white transition-all duration-200 group border border-slate-100 dark:border-white/5">
                                    <span class="material-symbols-rounded text-[24px] text-amber-500 group-hover:text-white mb-2 transition-colors">forum</span>
                                    <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200 group-hover:text-white text-center leading-tight">Answer Q&A</span>
                                </a>
                                <a href="/teacher/courses" class="w-full flex flex-col items-center justify-center py-5 bg-slate-50 dark:bg-slate-800/50 rounded-md hover:bg-emerald-500 hover:text-white transition-all duration-200 group border border-slate-100 dark:border-white/5">
                                    <span class="material-symbols-rounded text-[24px] text-emerald-500 group-hover:text-white mb-2 transition-colors">upload_file</span>
                                    <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200 group-hover:text-white text-center leading-tight">Upload Note</span>
                                </a>
                                <a href="/teacher/courses" class="w-full flex flex-col items-center justify-center py-5 bg-slate-50 dark:bg-slate-800/50 rounded-md hover:bg-violet-500 hover:text-white transition-all duration-200 group border border-slate-100 dark:border-white/5">
                                    <span class="material-symbols-rounded text-[24px] text-violet-500 group-hover:text-white mb-2 transition-colors">quiz</span>
                                    <span class="text-[10px] font-bold text-slate-700 dark:text-slate-200 group-hover:text-white text-center leading-tight">Add Quiz</span>
                                </a>
                            </div>
                        </div>

                        <!-- Course Engagement -->
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-100 dark:border-white/5 overflow-hidden shadow-sm flex-1">
                            <div class="px-6 py-5 border-b border-slate-50 dark:border-white/5 flex items-center justify-between">
                                <h3 class="font-bold text-slate-900 dark:text-white tracking-tight">Top Course Engagement</h3>
                            </div>
                            <div class="p-4 space-y-4">
                                <% if (courseEngagement && courseEngagement.length > 0) { %>
                                    <% courseEngagement.forEach(ce => { %>
                                        <div>
                                            <div class="flex items-center justify-between mb-1.5">
                                                <div class="flex-1 min-w-0 pr-2">
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= ce.title %></p>
                                                    <p class="text-[9px] font-bold text-slate-400 truncate"><%= ce.classLevel ? ce.classLevel.join(', ') : '' %></p>
                                                </div>
                                                <span class="text-[10px] font-bold text-slate-500 flex-shrink-0"><%= ce.studentCount %> Students</span>
                                            </div>
                                            <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                <!-- Assume 500 is a mock target for a full bar, adjust later if needed -->
                                                <div class="h-full bg-blue-500 rounded-full" style="width: <%= Math.min((ce.studentCount / 500) * 100, 100) %>%"></div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 text-center py-4">No enrollment data yet.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>
