<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Teacher Dashboard | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .admin-sidebar.active { transform: translateX(0); }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'dashboard' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Teacher Intelligence Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <!-- SECTION 1: TOP METRICS & QUICK ACTIONS (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5 flex flex-col gap-2">
                    
                    <!-- Quick Actions Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                        <a href="/teacher/courses" 
                           class="group flex items-center gap-2.5 p-2.5 bg-blue-50/40 dark:bg-blue-500/10 border border-blue-100/30 dark:border-blue-500/20 rounded-md hover:bg-blue-100/40 dark:hover:bg-blue-500/20 transition-all">
                            <div class="size-8 rounded-md bg-blue-500/10 text-blue-500 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-lg">video_call</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">Schedule Class</p>
                                <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Live session</p>
                            </div>
                        </a>

                        <a href="/teacher/qa" 
                           class="group flex items-center gap-2.5 p-2.5 bg-amber-50/40 dark:bg-amber-500/10 border border-amber-100/30 dark:border-amber-500/20 rounded-md hover:bg-amber-100/40 dark:hover:bg-amber-500/20 transition-all">
                            <div class="size-8 rounded-md bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-lg">forum</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">Answer Q&A</p>
                                <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Student queries</p>
                            </div>
                        </a>

                        <a href="/teacher/notes" 
                           class="group flex items-center gap-2.5 p-2.5 bg-emerald-50/40 dark:bg-emerald-500/10 border border-emerald-100/30 dark:border-emerald-500/20 rounded-md hover:bg-emerald-100/40 dark:hover:bg-emerald-500/20 transition-all">
                            <div class="size-8 rounded-md bg-emerald-500/10 text-emerald-500 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-lg">upload_file</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">Manage Notes</p>
                                <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Study materials</p>
                            </div>
                        </a>

                        <a href="/teacher/written-evaluations" 
                           class="group flex items-center gap-2.5 p-2.5 bg-violet-50/40 dark:bg-violet-500/10 border border-violet-100/30 dark:border-violet-500/20 rounded-md hover:bg-violet-100/40 dark:hover:bg-violet-500/20 transition-all">
                            <div class="size-8 rounded-md bg-violet-500/10 text-violet-500 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-lg">rate_review</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight">Written Exams</p>
                                <p class="text-[9px] text-slate-500 dark:text-slate-400 truncate">Evaluation queue</p>
                            </div>
                        </a>
                    </div>

                    <!-- Stats Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        
                        <!-- Assigned Courses Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400">Assigned Courses</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.totalCourses %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">auto_stories</span>
                                </div>
                            </div>
                        </div>

                        <!-- Total Classes Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Total Classes</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.totalClasses %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">play_circle</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pending Q&A Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400">Pending Q&A</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= pendingQas.length %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">forum</span>
                                </div>
                            </div>
                        </div>

                        <!-- Questions Answered Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400">Questions Answered</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.answeredQas %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">mark_chat_read</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SECTION 2: MAIN PANELS GRID (PERFECTLY DIVIDED WITH BORDER) -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-0 border-b border-slate-200 dark:border-slate-800/80">
                    
                    <!-- Left Column (2 Cols wide) -->
                    <div class="lg:col-span-2 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800/80 flex flex-col bg-white dark:bg-[#0f172a]">
                        
                        <!-- Panel A: Upcoming Live Classes -->
                        <div class="border-b border-slate-200 dark:border-slate-800/80">
                            <div class="px-4 sm:px-6 py-3 border-b border-slate-100 dark:border-white/5 flex items-center justify-between bg-slate-50/30 dark:bg-white/[0.01]">
                                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                    <span class="material-symbols-rounded text-rose-500 text-base">stream</span>
                                    Upcoming Live Classes
                                </h3>
                                <a href="/teacher/courses" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-1">
                                    View Courses &rarr;
                                </a>
                            </div>

                            <div class="p-3 sm:p-4 space-y-2">
                                <% if (upcomingLiveClasses && upcomingLiveClasses.length > 0) { %>
                                    <% upcomingLiveClasses.forEach(lc => { %>
                                        <div class="p-3 rounded-lg border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0b1120] hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="size-10 rounded-md bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-rounded text-lg">calendar_today</span>
                                                </div>
                                                <div class="min-w-0">
                                                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate"><%= lc.classTitle %></h4>
                                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">
                                                        <%= lc.courseTitle %> &bull; <span class="text-rose-600 dark:text-rose-400 font-semibold"><%= new Date(lc.date).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                                    </p>
                                                </div>
                                            </div>
                                            <a href="/live/<%= lc.meetingUrl %>" target="_blank" class="px-3.5 py-1.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-lg shadow-2xs transition-all flex items-center justify-center gap-1.5 shrink-0 self-end sm:self-center">
                                                <span class="material-symbols-rounded text-sm">videocam</span> Start Class
                                            </a>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="py-10 text-center">
                                        <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-700 mb-2">event_available</span>
                                        <p class="text-xs font-semibold text-slate-400">No upcoming live classes scheduled.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Panel B: Recent Student Queries (Pending Q&A) -->
                        <div>
                            <div class="px-4 sm:px-6 py-3 border-b border-slate-100 dark:border-white/5 flex items-center justify-between bg-slate-50/30 dark:bg-white/[0.01]">
                                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                    <span class="material-symbols-rounded text-amber-500 text-base">forum</span>
                                    Recent Student Queries
                                </h3>
                                <a href="/teacher/qa" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-2xs flex items-center gap-1">
                                    <span class="material-symbols-rounded text-[13px]">open_in_new</span> Answer All
                                </a>
                            </div>

                            <div class="p-3 sm:p-4 space-y-2">
                                <% if (pendingQas && pendingQas.length > 0) { %>
                                    <% pendingQas.slice(0, 4).forEach(qa => { %>
                                        <div class="p-3 rounded-lg border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0b1120] hover:border-slate-300 dark:hover:border-slate-700 transition-all flex items-start gap-3">
                                            <div class="size-9 rounded-full bg-slate-100 dark:bg-slate-800 shrink-0 overflow-hidden border border-slate-200/60 dark:border-white/5 flex items-center justify-center">
                                                <% if (qa.user && qa.user.profilePicture) { %>
                                                    <img src="<%= qa.user.profilePicture %>" class="size-full object-cover">
                                                <% } else { %>
                                                    <span class="material-symbols-rounded text-slate-400 text-base">person</span>
                                                <% } %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center justify-between mb-1">
                                                    <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate"><%= qa.user ? qa.user.name : 'Student' %></h4>
                                                    <span class="text-[10px] font-semibold text-slate-400"><%= new Date(qa.createdAt).toLocaleDateString() %></span>
                                                </div>
                                                <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed italic bg-slate-50 dark:bg-white/[0.02] p-2 rounded-md border border-slate-100 dark:border-white/5">
                                                    "<%= qa.question %>"
                                                </p>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="py-10 text-center">
                                        <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-700 mb-2">done_all</span>
                                        <p class="text-xs font-semibold text-slate-400">All student queries have been answered!</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column (1 Col wide) -->
                    <div class="flex flex-col bg-white dark:bg-[#0f172a]">
                        
                        <!-- Panel C: Content Repository Breakdown -->
                        <div class="border-b border-slate-200 dark:border-slate-800/80">
                            <div class="px-4 sm:px-6 py-3 border-b border-slate-100 dark:border-white/5 bg-slate-50/30 dark:bg-white/[0.01]">
                                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                    <span class="material-symbols-rounded text-blue-500 text-base">folder_open</span>
                                    Content Repository
                                </h3>
                            </div>

                            <div class="p-4 space-y-2.5">
                                <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                    <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-slate-400">videocam</span> Recorded Classes
                                    </span>
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-100"><%= contents.totalRecorded %></span>
                                </div>

                                <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                    <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-rose-500">stream</span> Live Classes
                                    </span>
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-100"><%= contents.totalLive %></span>
                                </div>

                                <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                    <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-blue-500">description</span> Notes & Handouts
                                    </span>
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-100"><%= contents.totalNotes %></span>
                                </div>

                                <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                    <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base text-emerald-500">quiz</span> Question Bank Items
                                    </span>
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-100"><%= contents.totalAddedQuestions %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel D: Top Course Engagement -->
                        <div class="flex-1">
                            <div class="px-4 sm:px-6 py-3 border-b border-slate-100 dark:border-white/5 bg-slate-50/30 dark:bg-white/[0.01]">
                                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                    <span class="material-symbols-rounded text-emerald-500 text-base">trending_up</span>
                                    Course Engagement
                                </h3>
                            </div>

                            <div class="p-4 space-y-4">
                                <% if (courseEngagement && courseEngagement.length > 0) { %>
                                    <% courseEngagement.forEach(ce => { %>
                                        <div class="space-y-1.5">
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= ce.title %></p>
                                                    <p class="text-[10px] text-slate-400 truncate"><%= ce.classLevel ? (Array.isArray(ce.classLevel) ? ce.classLevel.join(', ') : ce.classLevel) : '' %></p>
                                                </div>
                                                <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 shrink-0"><%= ce.studentCount %> Students</span>
                                            </div>
                                            <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: <%= Math.min((ce.studentCount / 200) * 100, 100) %>%"></div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 text-center py-6">No enrollment data available.</p>
                                <% } %>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </main>
    </div>

    <script>
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>
