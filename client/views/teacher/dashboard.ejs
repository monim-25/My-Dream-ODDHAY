<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Teacher Dashboard | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden h-[100dvh]">

    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'dashboard' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-sm z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Teacher Intelligence Hub' }) %>

            <div class="content-scroll flex flex-col min-h-0 flex-1 border-l-0 lg:border-l border-slate-200/80 dark:border-white/5">
                
                <div class="p-2 sm:p-5 lg:p-6 space-y-2 sm:space-y-4 max-w-7xl mx-auto w-full pb-6 sm:pb-8 lg:pb-8">

                    <!-- TEACHER WELCOME GREETING (Shown only on first login, dismissible with X) -->
                    <%
                        const tUser = locals.user || {};
                        const tLoginCount = (typeof tUser.loginCount === 'number') ? tUser.loginCount : 1;
                        const showWelcome = tLoginCount <= 1;
                    %>
                    <% if (showWelcome) { %>
                    <div id="teacherWelcomeBanner" class="rounded-xl p-3.5 sm:p-4 bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center justify-between gap-3 transition-all duration-300">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center font-medium text-sm shadow-xs shrink-0 overflow-hidden">
                                <% if (user.profilePicture) { %>
                                    <img src="<%= user.profilePicture %>" alt="<%= user.name %>" class="size-full object-cover">
                                <% } else { %>
                                    <span><%= (user.name || 'T')[0].toUpperCase() %></span>
                                <% } %>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h2 class="text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200 tracking-normal truncate leading-tight">Welcome, <%= user.name %></h2>
                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        Instructor
                                    </span>
                                </div>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-normal truncate">Here is your daily teaching and course overview</p>
                            </div>
                        </div>
                        <button type="button" onclick="dismissTeacherWelcome()" class="size-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center justify-center shrink-0 cursor-pointer active:scale-90" title="Dismiss">
                            <span class="material-symbols-rounded text-base">close</span>
                        </button>
                    </div>
                    <% } %>

                    <!-- QUICK ACTIONS (Only icon + text on small screen, responsive cards on sm+) -->
                    <div class="grid grid-cols-4 gap-1 sm:gap-3 py-1 sm:py-0">
                        <a href="/teacher/courses" 
                           class="group flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-1 sm:gap-3.5 p-1 sm:p-4 bg-transparent sm:bg-white sm:dark:bg-[#0f172a] border-0 sm:border border-slate-200/80 dark:border-slate-800 rounded-xl hover:border-blue-400 dark:hover:border-blue-500/50 shadow-none sm:shadow-xs hover:shadow-sm transition-all active:scale-95">
                            <div class="size-11 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">video_call</span>
                            </div>
                            <div class="min-w-0 text-center sm:text-left">
                                <p class="text-[11px] sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-tight line-clamp-2 sm:line-clamp-none">Schedule Class</p>
                                <p class="hidden sm:block text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">Live session</p>
                            </div>
                        </a>

                        <a href="/teacher/qa" 
                           class="group flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-1 sm:gap-3.5 p-1 sm:p-4 bg-transparent sm:bg-white sm:dark:bg-[#0f172a] border-0 sm:border border-slate-200/80 dark:border-slate-800 rounded-xl hover:border-amber-400 dark:hover:border-amber-500/50 shadow-none sm:shadow-xs hover:shadow-sm transition-all active:scale-95">
                            <div class="size-11 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">forum</span>
                            </div>
                            <div class="min-w-0 text-center sm:text-left">
                                <p class="text-[11px] sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-tight line-clamp-2 sm:line-clamp-none">Answer Q&A</p>
                                <p class="hidden sm:block text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5"><%= pendingQas.length %> pending</p>
                            </div>
                        </a>

                        <a href="/teacher/notes" 
                           class="group flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-1 sm:gap-3.5 p-1 sm:p-4 bg-transparent sm:bg-white sm:dark:bg-[#0f172a] border-0 sm:border border-slate-200/80 dark:border-slate-800 rounded-xl hover:border-emerald-400 dark:hover:border-emerald-500/50 shadow-none sm:shadow-xs hover:shadow-sm transition-all active:scale-95">
                            <div class="size-11 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">upload_file</span>
                            </div>
                            <div class="min-w-0 text-center sm:text-left">
                                <p class="text-[11px] sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-tight line-clamp-2 sm:line-clamp-none">Manage Notes</p>
                                <p class="hidden sm:block text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">Study materials</p>
                            </div>
                        </a>

                        <a href="/teacher/written-evaluations" 
                           class="group flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-1 sm:gap-3.5 p-1 sm:p-4 bg-transparent sm:bg-white sm:dark:bg-[#0f172a] border-0 sm:border border-slate-200/80 dark:border-slate-800 rounded-xl hover:border-violet-400 dark:hover:border-violet-500/50 shadow-none sm:shadow-xs hover:shadow-sm transition-all active:scale-95">
                            <div class="size-11 rounded-2xl bg-violet-500/10 text-violet-600 dark:text-violet-400 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">rate_review</span>
                            </div>
                            <div class="min-w-0 text-center sm:text-left">
                                <p class="text-[11px] sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-tight line-clamp-2 sm:line-clamp-none">Written Exams</p>
                                <p class="hidden sm:block text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">Evaluation queue</p>
                            </div>
                        </a>
                    </div>

                    <!-- METRICS / STATS GRID (Bigger size, close gap on small screens, soft font weights) -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-1.5 sm:gap-3">
                        
                        <!-- Assigned Courses Card -->
                        <div class="p-3.5 sm:p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center justify-between min-w-0 transition-all hover:border-slate-300 dark:hover:border-slate-700">
                            <div class="min-w-0 pr-2 space-y-0.5">
                                <p class="text-xs font-medium text-blue-600 dark:text-blue-400 truncate">Assigned Courses</p>
                                <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.totalCourses %></h3>
                            </div>
                            <div class="size-10 sm:size-11 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">auto_stories</span>
                            </div>
                        </div>

                        <!-- Total Classes Card -->
                        <div class="p-3.5 sm:p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center justify-between min-w-0 transition-all hover:border-slate-300 dark:hover:border-slate-700">
                            <div class="min-w-0 pr-2 space-y-0.5">
                                <p class="text-xs font-medium text-emerald-600 dark:text-emerald-400 truncate">Total Classes</p>
                                <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.totalClasses %></h3>
                            </div>
                            <div class="size-10 sm:size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">play_circle</span>
                            </div>
                        </div>

                        <!-- Pending Q&A Card -->
                        <div class="p-3.5 sm:p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center justify-between min-w-0 transition-all hover:border-slate-300 dark:hover:border-slate-700">
                            <div class="min-w-0 pr-2 space-y-0.5">
                                <p class="text-xs font-medium text-amber-600 dark:text-amber-400 truncate">Pending Q&A</p>
                                <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= pendingQas.length %></h3>
                            </div>
                            <div class="size-10 sm:size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">forum</span>
                            </div>
                        </div>

                        <!-- Questions Answered Card -->
                        <div class="p-3.5 sm:p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center justify-between min-w-0 transition-all hover:border-slate-300 dark:hover:border-slate-700">
                            <div class="min-w-0 pr-2 space-y-0.5">
                                <p class="text-xs font-medium text-purple-600 dark:text-purple-400 truncate">Q&A Answered</p>
                                <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.answeredQas %></h3>
                            </div>
                            <div class="size-10 sm:size-11 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-2xl sm:text-[26px]">mark_chat_read</span>
                            </div>
                        </div>

                    </div>

                    <!-- MAIN PANELS GRID -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 sm:gap-5">
                        
                        <!-- Left Column (2 Cols wide) -->
                        <div class="lg:col-span-2 space-y-2 sm:space-y-4 flex flex-col">
                            
                            <!-- Panel A: Upcoming Live Classes -->
                            <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs overflow-hidden">
                                <div class="px-4 sm:px-5 py-3.5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.01]">
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                        <span class="material-symbols-rounded text-rose-500 text-base">stream</span>
                                        Upcoming Live Classes
                                    </h3>
                                    <a href="/teacher/courses" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-1">
                                        View Courses &rarr;
                                    </a>
                                </div>

                                <div class="p-3 sm:p-4 space-y-2.5">
                                    <% if (upcomingLiveClasses && upcomingLiveClasses.length > 0) { %>
                                        <% upcomingLiveClasses.forEach(lc => { %>
                                            <div class="p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/40 dark:bg-[#0b1120] hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                                <div class="flex items-center gap-3 min-w-0">
                                                    <div class="size-10 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0">
                                                        <span class="material-symbols-rounded text-lg">calendar_today</span>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate"><%= lc.classTitle %></h4>
                                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">
                                                            <%= lc.courseTitle %> &bull; <span class="text-rose-600 dark:text-rose-400 font-semibold"><%= new Date(lc.date).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                                        </p>
                                                    </div>
                                                </div>
                                                <a href="/live/<%= lc.meetingUrl %>" target="_blank" class="w-full sm:w-auto px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center justify-center gap-1.5 shrink-0 active:scale-95">
                                                    <span class="material-symbols-rounded text-sm">videocam</span>
                                                    <span>Start Class</span>
                                                </a>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="py-8 sm:py-10 text-center">
                                            <div class="size-12 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto mb-2.5">
                                                <span class="material-symbols-rounded text-2xl">event_available</span>
                                            </div>
                                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">No upcoming live classes scheduled</p>
                                            <p class="text-[11px] text-slate-400 mt-0.5">Schedule a live class from your assigned courses</p>
                                            <a href="/teacher/courses" class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-xs font-bold hover:bg-primary/20 transition-all">
                                                <span>Schedule Now</span>
                                                <span class="material-symbols-rounded text-sm">arrow_forward</span>
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Panel B: Recent Student Queries (Pending Q&A) -->
                            <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs overflow-hidden">
                                <div class="px-4 sm:px-5 py-3.5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.01]">
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                        <span class="material-symbols-rounded text-amber-500 text-base">forum</span>
                                        Recent Student Queries
                                    </h3>
                                    <a href="/teacher/qa" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-[11px] font-bold text-slate-800 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-2xs flex items-center gap-1">
                                        <span class="material-symbols-rounded text-[13px]">open_in_new</span>
                                        <span>Answer All</span>
                                    </a>
                                </div>

                                <div class="p-3 sm:p-4 space-y-2.5">
                                    <% if (pendingQas && pendingQas.length > 0) { %>
                                        <% pendingQas.slice(0, 4).forEach(qa => { %>
                                            <div class="p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/40 dark:bg-[#0b1120] hover:border-slate-300 dark:hover:border-slate-700 transition-all flex items-start gap-3">
                                                <div class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 shrink-0 overflow-hidden border border-slate-200/60 dark:border-white/5 flex items-center justify-center">
                                                    <% if (qa.user && qa.user.profilePicture) { %>
                                                        <img src="<%= qa.user.profilePicture %>" class="size-full object-cover">
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-slate-400 text-base">person</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate"><%= qa.user ? qa.user.name : 'Student' %></h4>
                                                        <span class="text-[10px] font-semibold text-slate-400"><%= new Date(qa.createdAt).toLocaleDateString() %></span>
                                                    </div>
                                                    <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed italic bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-100 dark:border-white/5">
                                                        "<%= qa.question %>"
                                                    </p>
                                                    <div class="mt-2 flex justify-end">
                                                        <a href="/teacher/qa" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-1">
                                                            <span>Reply to query</span>
                                                            <span class="material-symbols-rounded text-xs">arrow_forward</span>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="py-8 sm:py-10 text-center">
                                            <div class="size-12 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center mx-auto mb-2.5">
                                                <span class="material-symbols-rounded text-2xl">done_all</span>
                                            </div>
                                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">All queries resolved!</p>
                                            <p class="text-[11px] text-slate-400 mt-0.5">There are no pending questions from your students right now</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column (1 Col wide) -->
                        <div class="space-y-4 sm:space-y-5 flex flex-col">
                            
                            <!-- Panel C: Content Repository Breakdown -->
                            <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs overflow-hidden">
                                <div class="px-4 sm:px-5 py-3.5 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-white/[0.01] flex items-center justify-between">
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                        <span class="material-symbols-rounded text-blue-500 text-base">folder_open</span>
                                        Content Repository
                                    </h3>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Overview</span>
                                </div>

                                <div class="p-3.5 sm:p-4 space-y-2.5">
                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50/70 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                        <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                            <span class="material-symbols-rounded text-base text-slate-400">videocam</span> Recorded Classes
                                        </span>
                                        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700 text-slate-800 dark:text-slate-100"><%= contents.totalRecorded %></span>
                                    </div>

                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50/70 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                        <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                            <span class="material-symbols-rounded text-base text-rose-500">stream</span> Live Classes
                                        </span>
                                        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700 text-slate-800 dark:text-slate-100"><%= contents.totalLive %></span>
                                    </div>

                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50/70 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                        <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                            <span class="material-symbols-rounded text-base text-blue-500">description</span> Notes & Handouts
                                        </span>
                                        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700 text-slate-800 dark:text-slate-100"><%= contents.totalNotes %></span>
                                    </div>

                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50/70 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                        <span class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center gap-2">
                                            <span class="material-symbols-rounded text-base text-emerald-500">quiz</span> Question Bank
                                        </span>
                                        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700 text-slate-800 dark:text-slate-100"><%= contents.totalAddedQuestions %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Panel D: Top Course Engagement -->
                            <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs overflow-hidden">
                                <div class="px-4 sm:px-5 py-3.5 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-white/[0.01] flex items-center justify-between">
                                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                                        <span class="material-symbols-rounded text-emerald-500 text-base">trending_up</span>
                                        Course Engagement
                                    </h3>
                                    <a href="/teacher/courses" class="text-[11px] font-bold text-primary hover:underline">All &rarr;</a>
                                </div>

                                <div class="p-3.5 sm:p-4 space-y-3.5">
                                    <% if (courseEngagement && courseEngagement.length > 0) { %>
                                        <% courseEngagement.forEach(ce => { %>
                                            <div class="space-y-1.5 p-2.5 rounded-xl bg-slate-50/50 dark:bg-white/[0.02] border border-slate-100 dark:border-white/5">
                                                <div class="flex items-center justify-between gap-2">
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= ce.title %></p>
                                                        <p class="text-[10px] text-slate-400 truncate"><%= ce.classLevel ? (Array.isArray(ce.classLevel) ? ce.classLevel.join(', ') : ce.classLevel) : '' %></p>
                                                    </div>
                                                    <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 shrink-0"><%= ce.studentCount %> Students</span>
                                                </div>
                                                <div class="w-full h-1.5 bg-slate-200/70 dark:bg-slate-800 rounded-full overflow-hidden">
                                                    <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: <%= Math.min((ce.studentCount / 200) * 100, 100) %>%"></div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="py-6 text-center">
                                            <span class="material-symbols-rounded text-2xl text-slate-300 dark:text-slate-600 mb-1">analytics</span>
                                            <p class="text-xs text-slate-400">No enrollment data available yet</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <%- include('bottom-nav', { activePage: 'dashboard' }) %>
        </main>
    </div>

    <script>
        (function() {
            try {
                const teacherId = "<%= (locals.user && (user._id || user.id)) || '' %>";
                const banner = document.getElementById('teacherWelcomeBanner');
                if (banner && teacherId) {
                    if (localStorage.getItem('teacher_welcome_dismissed_' + teacherId) === 'true') {
                        banner.remove();
                    }
                }
            } catch (e) {}
        })();

        function dismissTeacherWelcome() {
            const teacherId = "<%= (locals.user && (user._id || user.id)) || '' %>";
            const banner = document.getElementById('teacherWelcomeBanner');
            if (banner) {
                banner.style.opacity = '0';
                banner.style.transform = 'translateY(-8px)';
                setTimeout(() => {
                    banner.remove();
                }, 300);
            }
            if (teacherId) {
                try {
                    localStorage.setItem('teacher_welcome_dismissed_' + teacherId, 'true');
                } catch(e) {}
            }
        }
    </script>
</body>
</html>
