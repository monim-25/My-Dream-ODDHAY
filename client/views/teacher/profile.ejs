<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Teacher Profile | ODDHAY Command Center</title>
    <style>
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
        .profile-avatar-container { position: relative; display: inline-block; }
        .avatar-upload-btn {
            position: absolute; bottom: 4px; right: 4px; width: 34px; height: 34px;
            background: #3b82f6; color: white; border-radius: 9999px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; border: 3px solid white; transition: transform 0.2s;
        }
        .dark .avatar-upload-btn { border-color: #0f172a; }
        .avatar-upload-btn:hover { transform: scale(1.08); }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'profile' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#FFFFFF] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Profile Management' }) %>

            <!-- Success Popup -->
            <div id="successPopup" class="fixed top-20 right-6 z-[110] transform translate-x-full opacity-0 transition-all duration-500 pointer-events-none">
                <div class="bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-lg flex items-center gap-2.5 border border-emerald-500/20 text-xs font-bold">
                    <span class="material-symbols-rounded text-base">check_circle</span>
                    <span>Profile updated successfully</span>
                </div>
            </div>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-20 sm:pb-24 lg:pb-0">
                <form action="/teacher/profile/update" method="POST" class="flex flex-col gap-0">
                    
                    <!-- Error Alerts -->
                    <div id="errorAlert" class="hidden bg-rose-50 dark:bg-rose-950/30 border-b border-rose-200 dark:border-rose-900/40 px-6 py-3 flex items-center gap-2.5 text-rose-700 dark:text-rose-300 text-xs font-semibold">
                        <span class="material-symbols-rounded text-base text-rose-500">warning</span>
                        <p id="errorText"></p>
                    </div>

                    <!-- PROFILE COMPLETION AUDIT & SUGGESTION NOTICE -->
                    <%
                        const pHasPhoto = Boolean(user.profilePicture || user.profileImage);
                        const pHasBio = Boolean(user.bio && String(user.bio).trim().length > 5);
                        const pHasAcademics = Boolean(user.schoolName && user.collegeName && user.universityName);
                        const pHasAddresses = Boolean(user.presentAddress && user.permanentAddress);

                        let pScore = 0;
                        const pPendingFields = [];
                        if (pHasPhoto) pScore += 25; else pPendingFields.push('Profile Photo');
                        if (pHasBio) pScore += 25; else pPendingFields.push('Teaching Bio');
                        if (pHasAcademics) pScore += 25; else pPendingFields.push('Academic History');
                        if (pHasAddresses) pScore += 25; else pPendingFields.push('Address Details');

                        const isTeacherProfileComplete = (pScore === 100);
                    %>

                    <% if (!isTeacherProfileComplete) { %>
                    <div id="profileCompletionSuggestion" class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border-b border-amber-200/90 dark:border-amber-900/60 p-3.5 sm:p-5 transition-all">
                        <div class="max-w-5xl mx-auto space-y-2.5">
                            <!-- Header Row -->
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2 min-w-0">
                                    <div class="size-7 sm:size-8 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-rounded text-base">verified</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5 truncate">
                                            <span>Profile Strength:</span>
                                            <span class="text-amber-600 dark:text-amber-400 font-black"><%= pScore %>%</span>
                                        </h4>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/20 shrink-0">
                                    Action Suggested
                                </span>
                            </div>

                            <!-- Sleek Modern Progress Bar -->
                            <div class="w-full h-1.5 bg-slate-200/80 dark:bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-amber-500 to-amber-600 rounded-full transition-all duration-500" style="width: <%= pScore %>%;"></div>
                            </div>

                            <!-- Guidance & Direct Action CTA -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-0.5">
                                <p class="text-[11.5px] sm:text-xs text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
                                    Completing all fields builds trust with students. Recommended: <strong class="text-amber-800 dark:text-amber-200 font-semibold"><%= pPendingFields.join(', ') %></strong>
                                </p>
                                <div class="flex items-center gap-2 shrink-0">
                                    <% if (!pHasPhoto) { %>
                                    <label for="avatarInput" class="h-7 px-3 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold text-[11px] shadow-xs flex items-center justify-center gap-1 cursor-pointer transition-all active:scale-95">
                                        <span class="material-symbols-rounded text-sm">photo_camera</span>
                                        <span>Add Photo</span>
                                    </label>
                                    <% } %>
                                    <% if (!pHasBio) { %>
                                    <a href="#teachingBio" onclick="document.getElementById('teachingBio')?.focus()" class="h-7 px-3 rounded-lg bg-amber-500/15 hover:bg-amber-500/20 border border-amber-500/30 text-amber-800 dark:text-amber-200 font-semibold text-[11px] flex items-center justify-center gap-1 transition-all active:scale-95">
                                        <span class="material-symbols-rounded text-sm">edit_note</span>
                                        <span>Add Bio</span>
                                    </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                    
                    <!-- SECTION 1: Profile Header Card (ATTACHED WITH BORDER) -->
                    <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-4 sm:p-6 lg:p-8 flex flex-col md:flex-row items-center md:items-start gap-4 sm:gap-6 relative text-center md:text-left">
                        <div class="profile-avatar-container shrink-0">
                            <div class="size-20 sm:size-24 md:size-28 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-3xl font-black text-slate-300 dark:text-slate-600 border-2 border-slate-200 dark:border-slate-700 overflow-hidden shadow-2xs">
                                <img id="profilePreview" 
                                     src="<%= user.profilePicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=f1f5f9&color=64748b` %>" 
                                     class="w-full h-full object-cover">
                            </div>
                            <label for="avatarInput" class="avatar-upload-btn shadow-md" title="Upload new photo">
                                <span class="material-symbols-rounded text-sm sm:text-base">photo_camera</span>
                            </label>
                            <input type="file" id="avatarInput" class="hidden" accept="image/*" onchange="uploadAvatar(this)">
                        </div>

                        <div class="flex-1 min-w-0 w-full">
                            <div class="flex flex-col gap-1.5 sm:gap-2">
                                <!-- Name & Role Badge -->
                                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                                    <h1 class="text-lg sm:text-xl md:text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= user.name %></h1>
                                    <span class="hidden sm:inline-flex px-2.5 py-0.5 bg-primary/10 border border-primary/20 text-[11px] sm:text-xs font-bold text-primary rounded-full leading-none">
                                        Instructor
                                    </span>
                                    <% if (user.designation && user.designation.toLowerCase() !== 'instructor') { %>
                                        <span class="hidden sm:inline-flex px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-[10px] sm:text-[11px] font-semibold text-slate-500 dark:text-slate-400 rounded-md">
                                            <%= user.designation %>
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Email / Contact (Hidden on mobile) -->
                                <div class="hidden sm:flex items-center justify-center md:justify-start gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
                                    <span class="material-symbols-rounded text-sm text-slate-400">mail</span>
                                    <span class="truncate"><%= user.email %><%= user.phone ? ' • ' + user.phone : '' %></span>
                                </div>

                                <% const subDisplay = (typeof teachingSubjectDisplay !== 'undefined' && teachingSubjectDisplay !== 'Not Assigned') ? teachingSubjectDisplay : (user.teachingSubject || (user.teachingSubjects && user.teachingSubjects.length > 0 ? user.teachingSubjects.join(', ') : '')); %>
                                <% const clsDisplay = (typeof teachingClassesDisplay !== 'undefined' && teachingClassesDisplay !== 'Not Assigned') ? teachingClassesDisplay : (user.classLevel || (user.assignedClasses && user.assignedClasses.length > 0 ? user.assignedClasses.join(', ') : '')); %>

                                <!-- Assigned Subjects & Classes -->
                                <% if (subDisplay || clsDisplay) { %>
                                <!-- Mobile View: Show Subject and Class in One Clean Line -->
                                <div class="sm:hidden w-full mt-1.5 pt-1.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-center text-center">
                                    <p class="text-[11.5px] font-medium text-slate-700 dark:text-slate-300 truncate max-w-full leading-snug">
                                        <% if (subDisplay) { %><strong class="font-bold text-slate-900 dark:text-white">Subject:</strong> <%= subDisplay %><% } %><% if (subDisplay && clsDisplay) { %> <span class="text-slate-400 dark:text-slate-500 mx-1">•</span> <% } %><% if (clsDisplay) { %><strong class="font-bold text-slate-900 dark:text-white">Class:</strong> <%= clsDisplay %><% } %>
                                    </p>
                                </div>

                                <!-- Tablet & Desktop View: Structured Cards -->
                                <div class="hidden sm:grid sm:grid-cols-2 gap-2 mt-2.5 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 w-full text-left">
                                    <% if (subDisplay) { %>
                                    <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800">
                                        <div class="size-7 rounded-lg bg-fuchsia-500/10 text-fuchsia-600 dark:text-fuchsia-400 flex items-center justify-center shrink-0 mt-0.5">
                                            <span class="material-symbols-rounded text-sm">menu_book</span>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Assigned Subjects</span>
                                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-snug break-words"><%= subDisplay %></span>
                                        </div>
                                    </div>
                                    <% } %>
                                    <% if (clsDisplay) { %>
                                    <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800">
                                        <div class="size-7 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                                            <span class="material-symbols-rounded text-sm">school</span>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Teaching Classes</span>
                                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-snug break-words"><%= clsDisplay %></span>
                                        </div>
                                    </div>
                                    <% } %>
                                </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Expertise & Tenure Stack (Hidden on small screens) -->
                        <div class="hidden lg:flex flex-wrap items-center lg:items-start justify-center lg:justify-end gap-3 shrink-0">
                            <!-- Expertise Stack -->
                            <div class="grid <%= (expertise && expertise.length > 2) ? 'grid-cols-2' : 'grid-cols-1' %> gap-2">
                                <% if (expertise && expertise.length > 0) { %>
                                    <% expertise.forEach(exp => { %>
                                        <div class="px-3.5 py-2 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-slate-800 text-left md:text-right min-w-[130px]">
                                            <p class="text-[10px] font-bold text-slate-400 mb-0.5"><%= exp.classLevel %>:</p>
                                            <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= exp.subjects %></p>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>

                            <!-- Tenure Stack -->
                            <div class="flex flex-col gap-2">
                                <div class="px-3.5 py-2 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-slate-800 text-center min-w-[110px]">
                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Experience</p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= user.experience || 'N/A' %></p>
                                </div>
                                <div class="px-3.5 py-2 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-slate-800 text-center min-w-[110px]">
                                    <p class="text-[10px] font-bold text-slate-400 mb-0.5">Member Since</p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= new Date(user.createdAt).toLocaleDateString() %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: FORM SECTIONS (ATTACHED WITH BORDER) -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 border-b border-slate-200 dark:border-slate-800/80">
                        
                        <!-- Account Details -->
                        <div class="bg-white dark:bg-[#0f172a] p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-5 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800/80">
                            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2 leading-none">
                                <span class="material-symbols-rounded text-lg text-primary leading-none">account_circle</span>
                                Account Details
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">Full Name</label>
                                    <input type="text" name="name" value="<%= user.name %>" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none" required>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">Professional Designation</label>
                                    <input type="text" name="designation" value="<%= user.designation %>" placeholder="e.g. Senior Physics Instructor" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">Email Address</label>
                                    <input type="email" value="<%= user.email %>" class="w-full h-9 px-3 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold text-slate-500 cursor-not-allowed outline-none" readonly>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">Teaching Experience</label>
                                    <input type="text" name="experience" value="<%= user.experience %>" placeholder="e.g. 5+ Years" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                            </div>
                        </div>

                        <!-- Social Branding -->
                        <div class="bg-white dark:bg-[#0f172a] p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-5">
                            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2 leading-none">
                                <span class="material-symbols-rounded text-lg text-primary leading-none">share</span>
                                Social & Web Presence
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">Facebook URL</label>
                                    <input type="text" name="socialLinks[facebook]" value="<%= (user.socialLinks && user.socialLinks.facebook) ? user.socialLinks.facebook : '' %>" placeholder="https://facebook.com/..." class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">LinkedIn Profile</label>
                                    <input type="text" name="socialLinks[linkedin]" value="<%= (user.socialLinks && user.socialLinks.linkedin) ? user.socialLinks.linkedin : '' %>" placeholder="https://linkedin.com/in/..." class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Academic History (ATTACHED WITH BORDER) -->
                    <div class="bg-white dark:bg-[#0f172a] p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-5 border-b border-slate-200 dark:border-slate-800/80">
                        <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2 leading-none">
                            <span class="material-symbols-rounded text-lg text-primary leading-none">history_edu</span>
                            Academic Credentials
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-5">
                            <div class="space-y-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/20">
                                <p class="text-xs font-bold text-primary">Secondary Education (SSC)</p>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">School Name</label>
                                    <input type="text" name="schoolName" value="<%= user.schoolName %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">SSC GPA</label>
                                    <input type="text" name="sscGpa" value="<%= user.sscGpa %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                            </div>

                            <div class="space-y-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/20">
                                <p class="text-xs font-bold text-primary">Higher Secondary (HSC)</p>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">College Name</label>
                                    <input type="text" name="collegeName" value="<%= user.collegeName %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">HSC GPA</label>
                                    <input type="text" name="hscGpa" value="<%= user.hscGpa %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                            </div>

                            <div class="space-y-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/20">
                                <p class="text-xs font-bold text-primary">Graduation (Undergraduate)</p>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">University Name</label>
                                    <input type="text" name="universityName" value="<%= user.universityName %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-500">CGPA</label>
                                    <input type="text" name="cgpa" value="<%= user.cgpa %>" class="w-full h-9 px-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bio & Address Info (ATTACHED WITH BORDER) -->
                    <div class="bg-white dark:bg-[#0f172a] p-4 sm:p-6 lg:p-8 space-y-5 sm:space-y-6 border-b border-slate-200 dark:border-slate-800/80">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-500">Professional Bio</label>
                                <textarea id="teachingBio" name="bio" rows="3" class="w-full p-2.5 sm:p-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium focus:border-primary transition-all outline-none resize-none"><%= user.bio %></textarea>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-500">Key Achievements</label>
                                <textarea name="achievements" rows="3" class="w-full p-2.5 sm:p-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium focus:border-primary transition-all outline-none resize-none"><%= user.achievements %></textarea>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-500">Present Address</label>
                                <textarea name="presentAddress" rows="2" class="w-full p-2.5 sm:p-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium focus:border-primary transition-all outline-none resize-none"><%= user.presentAddress %></textarea>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-500">Permanent Address</label>
                                <textarea name="permanentAddress" rows="2" class="w-full p-2.5 sm:p-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium focus:border-primary transition-all outline-none resize-none"><%= user.permanentAddress %></textarea>
                            </div>
                        </div>

                        <div class="flex justify-end pt-4 border-t border-slate-100 dark:border-white/5">
                            <button type="submit" class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-primary hover:bg-blue-600 text-white font-bold text-xs shadow-2xs flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95">
                                <span>Save Changes</span>
                                <span class="material-symbols-rounded text-base">check</span>
                            </button>
                        </div>
                    </div>

                </form>

                <!-- Password Update Section (ATTACHED WITH BORDER) -->
                <form action="/teacher/profile/change-password" method="POST" class="bg-white dark:bg-[#0f172a] p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-5 border-b border-slate-200 dark:border-slate-800/80">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2 leading-none">
                        <span class="material-symbols-rounded text-lg text-primary leading-none">security</span>
                        Security & Password
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-500">Current Password</label>
                            <input type="password" name="oldPassword" placeholder="••••••••" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none" required>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-500">New Password</label>
                            <input type="password" name="newPassword" placeholder="••••••••" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none" required>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-500">Confirm New Password</label>
                            <input type="password" name="confirmPassword" placeholder="••••••••" class="w-full h-9 px-3 bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-semibold focus:border-primary transition-all outline-none" required>
                        </div>
                    </div>
                    <div class="flex justify-end pt-3">
                        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-lg bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 text-white font-bold text-xs shadow-2xs flex items-center justify-center gap-1.5 cursor-pointer transition-all active:scale-95">
                            <span>Update Password</span>
                            <span class="material-symbols-rounded text-base">lock_reset</span>
                        </button>
                    </div>
                </form>

            </div>
            <%- include('bottom-nav', { activePage: 'dashboard' }) %>
        </main>
    </div>

    <script>
        /* toggleAdminSidebar handled by header.ejs */

        async function uploadAvatar(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];

            if (!file.type.startsWith('image/')) {
                showError('Please select a valid image file (PNG, JPG, JPEG, WEBP).');
                input.value = '';
                return;
            }

            if (file.size > 25 * 1024 * 1024) {
                showError('Image size exceeds 25MB limit. Please choose a smaller photo.');
                input.value = '';
                return;
            }

            const alert = document.getElementById('errorAlert');
            if (alert) alert.classList.add('hidden');

            const uploadBtn = document.querySelector('.avatar-upload-btn');
            const originalBtnContent = uploadBtn ? uploadBtn.innerHTML : '';
            if (uploadBtn) {
                uploadBtn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">progress_activity</span>';
                uploadBtn.style.pointerEvents = 'none';
            }

            const formData = new FormData();
            formData.append('profilePicture', file);

            try {
                const res = await fetch('/teacher/profile/avatar', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    const newUrl = data.url || data.filePath;
                    const preview = document.getElementById('profilePreview');
                    if (preview) preview.src = newUrl;

                    // Also update any sidebar / header profile avatar images on the page
                    document.querySelectorAll('img[alt="Profile"]').forEach(img => {
                        img.src = newUrl;
                    });

                    showSuccess();
                } else {
                    showError(data.error || 'Avatar upload failed.');
                }
            } catch (err) {
                console.error(err);
                showError('Avatar upload failed. Please try again.');
            } finally {
                if (uploadBtn) {
                    uploadBtn.innerHTML = originalBtnContent;
                    uploadBtn.style.pointerEvents = '';
                }
                input.value = '';
            }
        }

        function showSuccess() {
            const popup = document.getElementById('successPopup');
            if (!popup) return;
            popup.classList.remove('translate-x-full', 'opacity-0');
            popup.classList.add('translate-x-0', 'opacity-100');
            setTimeout(() => {
                popup.classList.remove('translate-x-0', 'opacity-100');
                popup.classList.add('translate-x-full', 'opacity-0');
            }, 3500);
        }

        function showError(msg) {
            const alert = document.getElementById('errorAlert');
            const txt = document.getElementById('errorText');
            if (alert && txt) {
                txt.textContent = msg;
                alert.classList.remove('hidden');
                alert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('updated') === 'true' || urlParams.get('success') === 'profile_updated') {
            showSuccess();
            // Clean up the URL query params so the popup doesn't repeatedly appear on subsequent page refreshes
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    </script>
</body>
</html>
