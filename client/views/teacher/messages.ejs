<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <%- include('../partials/app-styles') %>
    <title>Student Messages | Instructor Portal</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow: hidden; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .admin-sidebar.active { transform: translateX(0); }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'messages' }) %>
        </aside>

        <!-- Main Messaging Studio -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] flex flex-col h-screen overflow-hidden">
            <%- include('../admin/header_v2', { pageTitle: 'Student Messages' }) %>

            <div class="content-scroll flex-1 flex overflow-hidden border-l border-slate-200 dark:border-white/5">
                <div class="flex-1 bg-white dark:bg-[#0f172a] overflow-hidden flex flex-col md:flex-row h-full">
                
                <!-- Left Sidebar: Students List -->
                <div id="teacher-messages-sidebar" class="w-full md:w-80 border-r border-slate-200/80 dark:border-slate-800/80 flex flex-col shrink-0 bg-slate-50/50 dark:bg-slate-900/40 h-full">
                    
                    <!-- Search Box with Toggle Icon beside it -->
                    <div class="p-3 border-b border-slate-200/80 dark:border-slate-800/80 h-16 flex items-center gap-2 shrink-0">
                        <div class="relative flex items-center flex-1">
                            <input type="text" id="student-search-input" oninput="filterStudentList(this.value)" placeholder="Search here..."
                                class="w-full pl-9 pr-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl outline-none focus:border-primary text-slate-900 dark:text-white placeholder:text-slate-400 font-medium transition-all shadow-2xs">
                            <span class="material-symbols-rounded absolute left-3 text-slate-400 text-lg leading-none flex items-center justify-center pointer-events-none select-none">search</span>
                        </div>
                        <button type="button" 
                            onclick="const s=document.getElementById('teacher-messages-sidebar'), b=document.getElementById('chat-teacher-sidebar-toggle-btn'), e=document.getElementById('empty-teacher-sidebar-toggle-btn'); if(s) s.style.setProperty('display','none','important'); if(b) b.style.setProperty('display','flex','important'); if(e) e.style.setProperty('display','flex','important');" 
                            id="teacher-sidebar-toggle-search-btn" title="Hide Students" 
                            class="size-10 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center shrink-0 transition-all cursor-pointer shadow-2xs select-none active:scale-95">
                            <span class="material-symbols-rounded text-xl leading-none pointer-events-none">dock_to_left</span>
                        </button>
                    </div>

                    <!-- Student Conversations Scroll List -->
                    <div class="flex-1 overflow-y-auto p-2 space-y-1.5 no-scrollbar" id="student-conversations-list">
                        <% if (locals.conversations && conversations.length > 0) { %>
                            <% conversations.forEach(item => { %>
                                <% const stu = item.student; %>
                                <% const isActive = locals.activeStudent && activeStudent._id.toString() === stu._id.toString(); %>
                                <div onclick="selectStudentThread('<%= stu._id %>')"
                                    data-student-id="<%= stu._id %>"
                                    data-student-name="<%= stu.name.toLowerCase() %>"
                                    data-student-class="<%= (stu.classLevel || '').toLowerCase() %>"
                                    class="student-thread-item p-3 rounded-xl cursor-pointer transition-all flex items-center gap-3 relative <%= isActive ? 'bg-slate-200/90 dark:bg-slate-800 shadow-2xs' : 'hover:bg-slate-100/80 dark:hover:bg-slate-800/50' %>">
                                    
                                    <!-- Avatar -->
                                    <div class="size-10 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                        <% if (stu.profilePicture || stu.profileImage) { %>
                                            <img src="<%= stu.profilePicture || stu.profileImage %>" alt="<%= stu.name %>" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <span><%= stu.name ? stu.name[0].toUpperCase() : 'S' %></span>
                                        <% } %>
                                    </div>

                                    <!-- Student Info & Latest Msg -->
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-1 mb-1">
                                            <h4 class="student-item-name text-sm font-semibold tracking-tight antialiased truncate <%= isActive ? 'text-primary dark:text-primary font-bold' : 'text-slate-700 dark:text-slate-200' %>"><%= stu.name %></h4>
                                            <% if (item.latestMessage) { %>
                                                <span class="text-[10px] font-semibold text-slate-400 shrink-0">
                                                    <%= new Date(item.latestMessage.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <p class="text-xs <%= item.unreadCount > 0 ? 'text-slate-800 dark:text-slate-100 font-semibold' : 'text-slate-500 dark:text-slate-400 font-medium' %> truncate flex-1 leading-snug">
                                                <%= item.latestMessage ? item.latestMessage.text : 'Student enrolled in your curriculum' %>
                                            </p>
                                            <% if (item.unreadCount > 0) { %>
                                                <span class="unread-badge size-5 rounded-full bg-[#E3E2E6] dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-[11px] font-bold flex items-center justify-center shrink-0 leading-none antialiased">
                                                    <%= item.unreadCount %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="flex items-center gap-1 mt-1.5">
                                            <span class="px-2 py-0.5 bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[9px] font-bold rounded-md">
                                                <%= stu.classLevel || 'Student' %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="py-12 px-4 text-center">
                                <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600 mb-1 leading-none flex items-center justify-center select-none">person_search</span>
                                <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No student conversations yet</p>
                                <p class="text-[10px] text-slate-400 mt-0.5">When enrolled students send questions, they will appear here.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Right: Active Chat Area & Details Panel -->
                <div class="flex-1 flex flex-row overflow-hidden h-full relative">
                    <!-- Active Chat Container -->
                    <div class="flex-1 flex flex-col bg-white dark:bg-[#0f172a] relative h-full min-w-0">
                        <div id="active-chat-content" class="flex-1 flex flex-col h-full <%= locals.activeStudent ? '' : 'hidden' %>">
                            <!-- Chat Header Bar -->
                            <div id="teacher-chat-header-bar" class="px-4 py-2.5 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between shrink-0 bg-slate-50/30 dark:bg-slate-900/20 h-16">
                                <!-- Left: Toggle Back Button & Student Info -->
                                <div class="flex items-center gap-3 min-w-0">
                                    <button type="button" 
                                        onclick="const s=document.getElementById('teacher-messages-sidebar'), b=document.getElementById('chat-teacher-sidebar-toggle-btn'), e=document.getElementById('empty-teacher-sidebar-toggle-btn'); if(s) s.style.removeProperty('display'); if(b) b.style.setProperty('display','none','important'); if(e) e.style.setProperty('display','none','important');" 
                                        id="chat-teacher-sidebar-toggle-btn" title="Show Students" style="display: none;" 
                                        class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200/80 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 items-center justify-center shrink-0 transition-all cursor-pointer select-none shadow-2xs active:scale-95">
                                        <span class="material-symbols-rounded text-xl leading-none pointer-events-none">view_sidebar</span>
                                    </button>

                                    <div id="active-student-avatar" class="size-10 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                        <% if (locals.activeStudent && (activeStudent.profilePicture || activeStudent.profileImage)) { %>
                                            <img src="<%= activeStudent.profilePicture || activeStudent.profileImage %>" alt="<%= activeStudent.name %>" class="w-full h-full object-cover">
                                        <% } else if (locals.activeStudent) { %>
                                            <span><%= activeStudent.name[0].toUpperCase() %></span>
                                        <% } %>
                                    </div>
                                    <div class="min-w-0">
                                        <h3 id="active-student-name" class="text-[14.5px] sm:text-[15.5px] font-semibold text-slate-800 dark:text-slate-100 tracking-tight antialiased leading-snug truncate"><%= locals.activeStudent ? activeStudent.name : '' %></h3>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span id="active-student-class" class="text-[11.5px] font-semibold text-primary dark:text-primary tracking-tight antialiased"><%= locals.activeStudent ? (activeStudent.classLevel || 'Student') : 'Student' %></span>
                                            <span class="text-slate-300 dark:text-slate-600 text-[10px]">•</span>
                                            <span class="text-[11.5px] font-medium text-emerald-600 dark:text-emerald-400 tracking-tight antialiased flex items-center gap-1.5">
                                                <span class="size-1.5 rounded-full bg-emerald-500 shrink-0"></span> Enrolled Student
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: Info Button -->
                                <div class="flex items-center gap-2 shrink-0">
                                    <button type="button" onclick="toggleTeacherDetailsPanel()" id="chat-teacher-details-toggle-btn" title="Details & Options" class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200/80 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 transition-all cursor-pointer select-none shadow-2xs active:scale-95">
                                        <span class="material-symbols-rounded text-xl leading-none pointer-events-none">info</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Messages Stream Container -->
                            <div id="teacher-messages-stream" class="flex-1 overflow-y-auto p-4 space-y-3 no-scrollbar bg-[#fafafa] dark:bg-[#070d18]">
                                <div id="messages-loading" class="py-10 text-center text-xs font-semibold text-slate-400">
                                    Loading conversation...
                                </div>
                            </div>

                            <!-- Bottom Input Area Wrapper (hidden when media view is open) -->
                            <div id="teacher-bottom-bar" class="shrink-0">

                            <!-- Blocked Notice Banner -->
                            <div id="teacher-blocked-notice-banner" class="hidden px-4 py-2.5 border-t border-rose-200 dark:border-rose-900/50 bg-rose-50/80 dark:bg-rose-950/40 flex items-center justify-between gap-3 shrink-0">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="material-symbols-rounded text-base text-rose-500 leading-none shrink-0 flex items-center justify-center select-none">block</span>
                                    <span id="teacher-blocked-notice-text" class="text-xs font-semibold text-rose-700 dark:text-rose-300 truncate">You have blocked this student.</span>
                                </div>
                                <button type="button" id="teacher-banner-unblock-btn" onclick="openTeacherBlockModal()" class="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs transition-all cursor-pointer shadow-2xs active:scale-95 flex items-center gap-1.5 shrink-0 select-none">
                                    <span class="material-symbols-rounded text-sm leading-none pointer-events-none">lock_open</span>
                                    <span class="pointer-events-none">Unblock</span>
                                </button>
                            </div>

                                <!-- Staged Attachment Preview Bar -->
                                <div id="teacher-staged-attachment-bar" class="px-4 py-2.5 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div id="teacher-staged-thumb-box" class="size-10 rounded-xl bg-[#0084FF]/10 text-[#0084FF] flex items-center justify-center shrink-0 overflow-hidden border border-[#0084FF]/20">
                                            <span id="teacher-staged-icon" class="material-symbols-rounded text-xl leading-none">attach_file</span>
                                            <img id="teacher-staged-img" class="w-full h-full object-cover hidden" alt="Preview">
                                        </div>
                                        <div class="min-w-0">
                                            <div id="teacher-staged-name" class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">attachment.jpg</div>
                                            <div id="teacher-staged-size" class="text-[10px] font-medium text-slate-400">0 KB</div>
                                        </div>
                                    </div>
                                    <button type="button" onclick="clearTeacherStagedAttachment()" title="Remove Attachment" class="size-7 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95">
                                        <span class="material-symbols-rounded text-base leading-none">close</span>
                                    </button>
                                </div>

                                <!-- Live Voice Recording Bar -->
                                <div id="teacher-voice-recording-bar" class="px-3.5 py-2 bg-rose-50/80 dark:bg-rose-950/40 border-t border-rose-200/70 dark:border-rose-900/50 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2">
                                        <div class="size-2.5 rounded-full bg-rose-500 animate-pulse"></div>
                                        <span class="text-xs font-semibold text-rose-600 dark:text-rose-400">Recording voice...</span>
                                        <span id="teacher-voice-timer" class="text-xs font-mono font-bold text-slate-700 dark:text-slate-200 ml-0.5">0:00</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <button type="button" onclick="cancelTeacherVoiceRecording()" title="Cancel Recording" class="px-2.5 py-1.5 rounded-xl hover:bg-rose-100 dark:hover:bg-rose-900/40 text-rose-600 dark:text-rose-400 text-xs font-semibold flex items-center gap-1 cursor-pointer transition-all active:scale-95 select-none">
                                            <span class="material-symbols-rounded text-base leading-none">delete</span>
                                            <span>Cancel</span>
                                        </button>
                                        <button type="button" onclick="finishTeacherVoiceRecording(false)" title="Attach Voice Note to Message" class="px-3 py-1.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold flex items-center gap-1 cursor-pointer transition-all shadow-2xs active:scale-95 select-none">
                                            <span class="material-symbols-rounded text-base leading-none">attach_file</span>
                                            <span>Attach</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Staged Reply Preview Bar -->
                                <div id="teacher-reply-preview-bar" class="px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2.5 min-w-0 border-l-2 border-primary pl-2.5">
                                        <span class="material-symbols-rounded text-base text-primary leading-none shrink-0">reply</span>
                                        <div class="min-w-0">
                                            <div class="text-[11px] font-bold text-primary truncate">Replying to <span id="teacher-reply-sender-name">Student</span></div>
                                            <div id="teacher-reply-text-preview" class="text-[11px] text-slate-600 dark:text-slate-300 truncate">Message snippet</div>
                                        </div>
                                    </div>
                                    <button type="button" onclick="cancelTeacherReply()" title="Cancel Reply" class="size-7 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95">
                                        <span class="material-symbols-rounded text-base leading-none pointer-events-none">close</span>
                                    </button>
                                </div>

                                <!-- Chat Input Box -->
                                <div id="teacher-input-container" class="p-2.5 sm:p-3 border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#0f172a] shrink-0">
                                    <form id="teacher-send-form" onsubmit="sendTeacherMessage(event)" class="flex items-center gap-1.5 sm:gap-2">
                                        <!-- Hidden File Input -->
                                        <input type="file" id="teacher-file-input" onchange="handleTeacherFileSelect(event)" class="hidden" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.xlsx,.pptx">

                                        <!-- Attachment Button -->
                                        <button type="button" onclick="document.getElementById('teacher-file-input').click()" title="Attach File"
                                            class="size-10 rounded-xl bg-slate-100 hover:bg-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-all flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none shadow-2xs">
                                            <span class="material-symbols-rounded text-[21px] leading-none pointer-events-none">attach_file</span>
                                        </button>

                                        <!-- Camera Button -->
                                        <button type="button" onclick="openTeacherCameraModal()" title="Capture Camera / Video"
                                            class="size-10 rounded-xl bg-slate-100 hover:bg-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-all flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none shadow-2xs">
                                            <span class="material-symbols-rounded text-[21px] leading-none pointer-events-none">photo_camera</span>
                                        </button>

                                        <!-- Text Input Box (Comfortable balanced size) -->
                                        <input type="text" id="teacher-msg-input" 
                                            placeholder="<%= locals.activeStudent ? ('Type your response to ' + activeStudent.name + '...') : 'Type a response...' %>"
                                            autocomplete="off"
                                            class="flex-1 min-h-[42px] sm:min-h-[44px] px-3.5 sm:px-4 py-2 bg-slate-100/90 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 rounded-xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-slate-400 shadow-2xs">

                                        <!-- Mic Voice Recording Button -->
                                        <button type="button" id="teacher-mic-btn" onclick="startTeacherVoiceRecording()" title="Record Voice Message"
                                            class="size-10 rounded-xl bg-slate-100 hover:bg-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-rose-500 dark:text-slate-400 dark:hover:text-rose-400 transition-all flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none shadow-2xs">
                                            <span class="material-symbols-rounded text-[21px] leading-none pointer-events-none">mic</span>
                                        </button>

                                        <!-- Smart & Sleek Send Button -->
                                        <button type="submit" id="teacher-send-btn" title="Send Message"
                                            class="size-10 rounded-xl bg-gradient-to-tr from-primary to-blue-500 hover:from-primary-dark hover:to-blue-600 text-white transition-all shadow-sm hover:shadow flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none">
                                            <svg class="size-5 -mr-0.5 pointer-events-none fill-current" viewBox="0 0 24 24">
                                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                                </div><!-- /teacher-bottom-bar -->

                                <!-- Full Shared Media & Files View inside Chat Area -->
                                <div id="teacher-media-files-view" class="flex-1 bg-white dark:bg-[#0f172a] hidden overflow-y-auto no-scrollbar">
                                    <div class="p-4 sm:p-6 space-y-5">

                                        <!-- Header row: title + count + close -->
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                <h3 class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-100 tracking-tight">Shared Media & Files</h3>
                                                <span id="teacher-full-media-files-count" class="px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[11px] font-bold">0</span>
                                            </div>
                                            <button type="button" onclick="openTeacherAllMediaFilesView(false)" title="Close" class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200/80 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 transition-all cursor-pointer select-none shadow-2xs active:scale-95">
                                                <span class="material-symbols-rounded text-xl leading-none pointer-events-none">close</span>
                                            </button>
                                        </div>

                                        <!-- Filter Pills -->
                                        <div class="flex items-center gap-2">
                                            <button id="teacher-filter-all-btn" onclick="setTeacherMediaFilter('all')" class="px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all bg-primary text-white shadow-sm cursor-pointer select-none">All</button>
                                            <button id="teacher-filter-media-btn" onclick="setTeacherMediaFilter('media')" class="px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer select-none">Media</button>
                                            <button id="teacher-filter-docs-btn" onclick="setTeacherMediaFilter('docs')" class="px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer select-none">Documents</button>
                                            <button id="teacher-filter-voice-btn" onclick="setTeacherMediaFilter('voice')" class="px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer select-none">Voices</button>
                                        </div>

                                        <!-- Photos & Videos -->
                                        <div id="teacher-full-media-section">
                                            <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-1.5 leading-none">
                                                <span class="material-symbols-rounded text-base leading-none">photo_library</span>
                                                <span class="leading-none">Photos & Videos</span>
                                                <span id="teacher-full-media-subcount" class="text-[10.5px] font-normal text-slate-400"></span>
                                            </h4>
                                            <div id="teacher-full-media-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"></div>
                                            <div id="teacher-full-media-empty" class="py-8 text-center text-xs font-medium text-slate-400 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 hidden">
                                                No photos or videos shared yet
                                            </div>
                                        </div>

                                        <!-- Documents & Files -->
                                        <div id="teacher-full-docs-section">
                                            <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-1.5 leading-none">
                                                <span class="material-symbols-rounded text-base leading-none">description</span>
                                                <span class="leading-none">Documents & Files</span>
                                                <span id="teacher-full-docs-subcount" class="text-[10.5px] font-normal text-slate-400"></span>
                                            </h4>
                                            <div id="teacher-full-docs-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
                                            <div id="teacher-full-docs-empty" class="py-8 text-center text-xs font-medium text-slate-400 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 hidden">
                                                No documents or files shared yet
                                            </div>
                                        </div>

                                        <!-- Voices -->
                                        <div id="teacher-full-voice-section">
                                            <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-1.5 leading-none">
                                                <span class="material-symbols-rounded text-base leading-none">mic</span>
                                                <span class="leading-none">Voices</span>
                                                <span id="teacher-full-voice-subcount" class="text-[10.5px] font-normal text-slate-400"></span>
                                            </h4>
                                            <div id="teacher-full-voice-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
                                            <div id="teacher-full-voice-empty" class="py-8 text-center text-xs font-medium text-slate-400 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 hidden">
                                                No voices shared yet
                                            </div>
                                        </div>

                                        <div class="h-4"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Camera Capture Modal -->
                            <div id="teacher-camera-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-xs p-4 hidden transition-all">
                                <div class="w-full max-w-md rounded-2xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 p-4 sm:p-5 shadow-2xl transition-all">
                                    <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 dark:border-slate-800 mb-3">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-rounded text-xl text-primary leading-none">photo_camera</span>
                                            <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100">Camera Capture</h4>
                                        </div>
                                        <button type="button" onclick="closeTeacherCameraModal()" class="size-7 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center cursor-pointer select-none">
                                            <span class="material-symbols-rounded text-base leading-none">close</span>
                                        </button>
                                    </div>

                                    <div class="relative rounded-2xl overflow-hidden bg-black aspect-4/3 flex items-center justify-center mb-4">
                                        <video id="teacher-camera-video" autoplay playsinline muted class="w-full h-full object-cover"></video>
                                        <img id="teacher-camera-preview-img" class="w-full h-full object-cover hidden" alt="Captured Snapshot">
                                        <canvas id="teacher-camera-canvas" class="hidden"></canvas>
                                    </div>

                                    <div class="flex items-center justify-between gap-2">
                                        <div id="teacher-camera-controls-live" class="w-full flex items-center justify-between">
                                            <button type="button" onclick="switchTeacherCamera()" title="Switch Camera" class="size-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center cursor-pointer transition-all active:scale-95">
                                                <span class="material-symbols-rounded text-lg leading-none">cameraswitch</span>
                                            </button>
                                            <button type="button" onclick="captureTeacherPhoto()" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95 transition-all">
                                                <span class="material-symbols-rounded text-base leading-none">circle</span>
                                                <span>Snap Photo</span>
                                            </button>
                                            <div class="size-9"></div>
                                        </div>

                                        <div id="teacher-camera-controls-preview" class="w-full flex items-center justify-between hidden">
                                            <button type="button" onclick="retakeTeacherPhoto()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition-all active:scale-95">
                                                <span class="material-symbols-rounded text-base leading-none">replay</span>
                                                <span>Retake</span>
                                            </button>
                                            <button type="button" onclick="useCapturedTeacherPhoto()" class="px-4 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95 transition-all">
                                                <span class="material-symbols-rounded text-base leading-none">check</span>
                                                <span>Use Photo</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <!-- Empty State Container -->
                        <div id="empty-chat-placeholder" class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-[#fafafa] dark:bg-[#070d18] relative <%= locals.activeStudent ? 'hidden' : '' %>">
                            <button type="button" 
                                onclick="const s=document.getElementById('teacher-messages-sidebar'), b=document.getElementById('chat-teacher-sidebar-toggle-btn'), e=document.getElementById('empty-teacher-sidebar-toggle-btn'); if(s) s.style.removeProperty('display'); if(b) b.style.setProperty('display','none','important'); if(e) e.style.setProperty('display','none','important');" 
                                id="empty-teacher-sidebar-toggle-btn" title="Show Students" style="display: none;" 
                                class="absolute top-4 left-4 size-9 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 items-center justify-center transition-all cursor-pointer shadow-2xs select-none active:scale-95">
                                <span class="material-symbols-rounded text-xl leading-none pointer-events-none">view_sidebar</span>
                            </button>
                            <div class="size-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-3">
                                <span class="material-symbols-rounded text-3xl leading-none flex items-center justify-center select-none">chat_bubble</span>
                            </div>
                            <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-1">Select a Student Conversation</h3>
