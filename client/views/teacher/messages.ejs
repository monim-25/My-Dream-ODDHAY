                        </div>
                    </div>

                    <!-- Right Info & Media Details Panel -->
                    <div id="teacher-details-panel" class="w-72 sm:w-80 border-l border-slate-200/80 dark:border-slate-800/80 flex flex-col shrink-0 bg-white dark:bg-[#0f172a] h-full hidden overflow-hidden transition-all z-20">
                        
                        <!-- 1. Main Details View -->
                        <div id="teacher-details-main-view" class="flex flex-col h-full overflow-hidden">
                            <!-- Panel Header -->
                            <div class="px-4 border-b border-slate-200/80 dark:border-slate-800/80 h-16 flex items-center justify-between shrink-0 bg-slate-50/50 dark:bg-slate-900/40">
                                <h4 class="text-sm sm:text-[15px] font-bold text-slate-800 dark:text-slate-100">Conversation Details</h4>
                                <button type="button" onclick="toggleTeacherDetailsPanel(false)" title="Close Details" class="size-8 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95">
                                    <span class="material-symbols-rounded text-lg leading-none pointer-events-none">close</span>
                                </button>
                            </div>

                            <!-- Panel Scroll Content -->
                            <div class="flex-1 overflow-y-auto p-4 space-y-5 no-scrollbar">
                                <!-- Profile Card: Only Profile Picture & Name -->
                                <div class="text-center flex flex-col items-center pt-2 pb-1">
                                    <div id="teacher-details-avatar" class="size-16 rounded-2xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-xl flex items-center justify-center overflow-hidden shadow-2xs mb-2 border border-slate-200/60 dark:border-slate-700/60">
                                        <% if (locals.activeStudent && (activeStudent.profilePicture || activeStudent.profileImage)) { %>
                                            <img src="<%= activeStudent.profilePicture || activeStudent.profileImage %>" alt="<%= activeStudent.name %>" class="w-full h-full object-cover">
                                        <% } else if (locals.activeStudent) { %>
                                            <span><%= activeStudent.name[0].toUpperCase() %></span>
                                        <% } %>
                                    </div>
                                    <h3 id="teacher-details-name" class="text-sm font-semibold text-slate-800 dark:text-slate-100 leading-snug tracking-tight"><%= locals.activeStudent ? activeStudent.name : '' %></h3>
                                </div>

                                <!-- Shared Media & Files Section -->
                                <div class="border-t border-slate-100 dark:border-slate-800/80 pt-3.5">
                                    <div class="flex items-center justify-between mb-2.5">
                                        <div class="flex items-center gap-1.5">
                                            <span class="material-symbols-rounded text-base text-slate-500 dark:text-slate-400 leading-none flex items-center justify-center select-none">perm_media</span>
                                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Shared Media & Files</span>
                                        </div>
                                        <span id="teacher-details-media-count" class="text-[11px] font-medium text-slate-400">0 items</span>
                                    </div>
                                    <div id="teacher-details-media-grid" class="grid grid-cols-3 gap-2"></div>
                                    <div id="teacher-details-media-empty" class="py-5 text-center text-xs font-medium text-slate-400 bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-slate-200/50 dark:border-slate-800/50">
                                        No shared media or files yet
                                    </div>
                                    <button type="button" id="teacher-details-media-see-all-btn" onclick="openTeacherAllMediaFilesView(true)" class="w-full mt-2.5 py-1.5 px-3 rounded-lg bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-primary text-[11.5px] font-semibold transition-all flex items-center justify-center gap-1 cursor-pointer select-none hidden">
                                        <span>See all media & files</span>
                                        <span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>
                                    </button>
                                </div>

                                <!-- Pinned Messages Section (Previews up to 5 items) -->
                                <div class="border-t border-slate-100 dark:border-slate-800/80 pt-3.5">
                                    <div class="flex items-center justify-between mb-2.5">
                                        <div class="flex items-center gap-1.5">
                                            <span class="material-symbols-rounded text-base text-amber-500 dark:text-amber-400 leading-none flex items-center justify-center select-none">push_pin</span>
                                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Pinned Messages</span>
                                        </div>
                                        <span id="teacher-details-pinned-count" class="text-[11px] font-medium text-slate-400">0 pinned</span>
                                    </div>
                                    
                                    <div id="teacher-details-pinned-list-container" class="rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 overflow-hidden divide-y divide-slate-200/60 dark:divide-slate-800/80 hidden">
                                        <div id="teacher-details-pinned-list" class="divide-y divide-slate-200/60 dark:divide-slate-800/80"></div>
                                    </div>

                                    <div id="teacher-details-pinned-empty" class="py-5 text-center text-xs font-medium text-slate-400 bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-slate-200/50 dark:border-slate-800/50">
                                        No pinned messages yet
                                    </div>

                                    <button type="button" id="teacher-details-pinned-see-more-btn" onclick="openTeacherAllPinnedView(true)" class="w-full mt-2 py-1.5 px-3 rounded-lg bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-primary dark:text-primary text-[11.5px] font-semibold transition-all flex items-center justify-center gap-1 cursor-pointer select-none hidden">
                                        <span>See more pinned</span>
                                        <span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>
                                    </button>
                                </div>

                                <!-- Privacy & Actions -->
                                <div class="border-t border-slate-100 dark:border-slate-800/80 pt-3.5 space-y-2">
                                    <h5 class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">Privacy & Actions</h5>
                                    
                                    <button type="button" id="teacher-details-block-btn" onclick="openTeacherBlockModal()" class="w-full py-2.5 px-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-900/40 text-xs font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-2xs active:scale-95 select-none">
                                        <span id="teacher-details-block-btn-icon" class="material-symbols-rounded text-base leading-none pointer-events-none">block</span>
                                        <span id="teacher-details-block-btn-text" class="pointer-events-none">Block Student</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Dedicated All Pinned Messages View (Takes full place when opened) -->
                        <div id="teacher-details-pinned-view" class="flex flex-col h-full overflow-hidden hidden">
                            <!-- View Header with Back button -->
                            <div class="px-3 border-b border-slate-200/80 dark:border-slate-800/80 h-16 flex items-center justify-between shrink-0 bg-slate-50/50 dark:bg-slate-900/40">
                                <div class="flex items-center gap-2 min-w-0">
                                    <button type="button" onclick="openTeacherAllPinnedView(false)" title="Back to Details" class="size-8 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95 shrink-0">
                                        <span class="material-symbols-rounded text-lg leading-none pointer-events-none">arrow_back</span>
                                    </button>
                                    <div class="flex items-center gap-1.5 truncate">
                                        <span class="material-symbols-rounded text-base text-amber-500 leading-none shrink-0">push_pin</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-200 truncate">Pinned Messages</h4>
                                    </div>
                                </div>
                                <button type="button" onclick="toggleTeacherDetailsPanel(false)" title="Close Details" class="size-8 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95 shrink-0">
                                    <span class="material-symbols-rounded text-lg leading-none pointer-events-none">close</span>
                                </button>
                            </div>

                            <!-- Full Pinned Messages List divided by thin lines -->
                            <div class="flex-1 overflow-y-auto p-4 space-y-3 no-scrollbar">
                                <div id="teacher-full-pinned-list-container" class="rounded-2xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/30 overflow-hidden divide-y divide-slate-200/60 dark:divide-slate-800/80">
                                    <div id="teacher-full-pinned-list" class="divide-y divide-slate-200/60 dark:divide-slate-800/80"></div>
                                </div>
                                <div id="teacher-full-pinned-empty" class="py-12 text-center text-xs font-medium text-slate-400 hidden">
                                    No pinned messages yet
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
            </div>

            <!-- In-App System Confirmation Modal -->
            <div id="custom-teacher-block-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4 hidden transition-all">
                <div class="w-full max-w-sm rounded-2xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 p-4 sm:p-5 shadow-xl transition-all scale-100">
                    <div class="flex items-center gap-3 mb-2.5">
                        <div id="teacher-modal-block-icon-box" class="size-9 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                            <span id="teacher-modal-block-icon" class="material-symbols-rounded text-xl leading-none">block</span>
                        </div>
                        <div class="min-w-0">
                            <h4 id="teacher-modal-block-title" class="text-sm font-semibold text-slate-800 dark:text-slate-100 leading-snug truncate">Block Contact?</h4>
                        </div>
                    </div>
                    <p id="teacher-modal-block-desc" class="text-[11.5px] text-slate-500 dark:text-slate-400 leading-relaxed mb-4">
                        You won't be able to message each other.
                    </p>
                    <div class="flex items-center justify-end gap-2">
                        <button type="button" onclick="closeTeacherBlockModal()" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all cursor-pointer select-none active:scale-95">
                            Cancel
                        </button>
                        <button type="button" id="teacher-modal-block-confirm-btn" onclick="executeTeacherBlockToggle()" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-all shadow-xs cursor-pointer select-none active:scale-95 flex items-center gap-1.5">
                            <span id="teacher-modal-block-btn-text">Block</span>
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleTeacherSidebar(forceShow) {
            const sidebar = document.getElementById('teacher-messages-sidebar');
            const chatToggleBtn = document.getElementById('chat-teacher-sidebar-toggle-btn');
            const emptyToggleBtn = document.getElementById('empty-teacher-sidebar-toggle-btn');
            if (!sidebar) return;

            let show;
            if (typeof forceShow === 'boolean') {
                show = forceShow;
            } else {
                const isCurrentlyHidden = sidebar.style.display === 'none' || window.getComputedStyle(sidebar).display === 'none';
                show = isCurrentlyHidden;
            }

            if (show) {
                sidebar.style.setProperty('display', 'flex', 'important');
                if (chatToggleBtn) chatToggleBtn.style.setProperty('display', 'none', 'important');
                if (emptyToggleBtn) emptyToggleBtn.style.setProperty('display', 'none', 'important');
            } else {
                sidebar.style.setProperty('display', 'none', 'important');
                if (chatToggleBtn) chatToggleBtn.style.setProperty('display', 'flex', 'important');
                if (emptyToggleBtn) emptyToggleBtn.style.setProperty('display', 'flex', 'important');
            }
        }
        window.toggleTeacherSidebar = toggleTeacherSidebar;

        function toggleTeacherDetailsPanel(forceState) {
            const panel = document.getElementById('teacher-details-panel');
            const infoBtn = document.getElementById('chat-teacher-details-toggle-btn');
            const sidebar = document.getElementById('teacher-messages-sidebar');
            const sidebarToggleBtn = document.getElementById('chat-teacher-sidebar-toggle-btn');
            const emptySidebarToggleBtn = document.getElementById('empty-teacher-sidebar-toggle-btn');
            if (!panel) return;

            let open;
            if (typeof forceState === 'boolean') {
                open = forceState;
            } else {
                open = panel.classList.contains('hidden');
            }

            if (open) {
                panel.classList.remove('hidden');
                if (infoBtn) infoBtn.style.setProperty('display', 'none', 'important');
                // Auto hide students sidebar when details panel is opened
                if (sidebar) sidebar.style.setProperty('display', 'none', 'important');
                if (sidebarToggleBtn) sidebarToggleBtn.style.setProperty('display', 'flex', 'important');
                if (emptySidebarToggleBtn) emptySidebarToggleBtn.style.setProperty('display', 'flex', 'important');
            } else {
                panel.classList.add('hidden');
                openTeacherAllPinnedView(false); // reset view when closed
                if (infoBtn) infoBtn.style.removeProperty('display');
                // Auto restore students sidebar when details panel is closed
                if (sidebar) sidebar.style.removeProperty('display');
                if (sidebarToggleBtn) sidebarToggleBtn.style.setProperty('display', 'none', 'important');
                if (emptySidebarToggleBtn) emptySidebarToggleBtn.style.setProperty('display', 'none', 'important');
            }
        }
        window.toggleTeacherDetailsPanel = toggleTeacherDetailsPanel;

        function openTeacherAllPinnedView(show) {
            const mainView = document.getElementById('teacher-details-main-view');
            const pinnedView = document.getElementById('teacher-details-pinned-view');
            if (show) {
                if (mainView) mainView.classList.add('hidden');
                if (pinnedView) pinnedView.classList.remove('hidden');
            } else {
                if (mainView) mainView.classList.remove('hidden');
                if (pinnedView) pinnedView.classList.add('hidden');
            }
        }
        window.openTeacherAllPinnedView = openTeacherAllPinnedView;

        function openTeacherAllMediaFilesView(show = true) {
            const mediaView    = document.getElementById('teacher-media-files-view');
            const msgStream    = document.getElementById('teacher-messages-stream');
            const chatHeader   = document.getElementById('teacher-chat-header-bar');
            const bottomBar    = document.getElementById('teacher-bottom-bar');
            const sidebar      = document.getElementById('teacher-messages-sidebar');
            const detailsPanel = document.getElementById('teacher-details-panel');

            if (!mediaView) return;

            if (show) {
                mediaView.classList.remove('hidden');
                if (msgStream)    msgStream.classList.add('hidden');
                if (chatHeader)   chatHeader.classList.add('hidden');
                if (bottomBar)    bottomBar.classList.add('hidden');
                if (sidebar)      sidebar.style.setProperty('display', 'none', 'important');
                // Use classList so toggleTeacherDetailsPanel's logic stays intact
                if (detailsPanel) {
                    detailsPanel.classList.add('hidden');
                    detailsPanel.style.removeProperty('display');
                }
                mediaView.scrollTop = 0;
            } else {
                mediaView.classList.add('hidden');
                if (msgStream)  msgStream.classList.remove('hidden');
                if (chatHeader) chatHeader.classList.remove('hidden');
                if (bottomBar)  bottomBar.classList.remove('hidden');
                if (sidebar)    sidebar.style.removeProperty('display');
                // Restore i-button (toggleTeacherDetailsPanel hides it when panel is open)
                const infoBtn = document.getElementById('chat-teacher-details-toggle-btn');
                if (infoBtn) infoBtn.style.removeProperty('display');
            }
        }
        window.openTeacherAllMediaFilesView = openTeacherAllMediaFilesView;

        function setTeacherMediaFilter(filter) {
            const sections = { media: 'teacher-full-media-section', docs: 'teacher-full-docs-section', voice: 'teacher-full-voice-section' };
            const btns = { all: 'teacher-filter-all-btn', media: 'teacher-filter-media-btn', docs: 'teacher-filter-docs-btn', voice: 'teacher-filter-voice-btn' };
            const active = 'bg-primary text-white shadow-sm';
            const inactive = 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700';
            Object.values(btns).forEach(id => {
                const btn = document.getElementById(id);
                if (btn) { btn.className = 'px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all cursor-pointer select-none ' + inactive; }
            });
            const activeBtn = document.getElementById(btns[filter]);
            if (activeBtn) { activeBtn.className = 'px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all cursor-pointer select-none ' + active; }
            Object.entries(sections).forEach(([key, id]) => {
                const sec = document.getElementById(id);
                if (sec) sec.classList.toggle('hidden', filter !== 'all' && filter !== key);
            });
        }
        window.setTeacherMediaFilter = setTeacherMediaFilter;

        let activeStudentId = '<%= locals.activeStudent ? activeStudent._id : "" %>';
        const currentTeacherId = '<%= user._id %>';
        let pollTimer = null;
        let isCurrentStudentBlockedByMe = false;
        let isCurrentStudentBlockedByThem = false;

        const studentsDirectory = {
            <% (locals.conversations || []).forEach(item => { %>
                <% const stu = item.student; %>
                '<%= stu._id %>': {
                    name: <%- JSON.stringify(stu.name) %>,
                    classLevel: <%- JSON.stringify(stu.classLevel || 'Student') %>,
                    profilePicture: <%- JSON.stringify(stu.profilePicture || stu.profileImage || '') %>
                },
            <% }); %>
        };

        function updateTeacherBlockUI(blockedByMe, blockedByThem) {
            isCurrentStudentBlockedByMe = Boolean(blockedByMe);
            isCurrentStudentBlockedByThem = Boolean(blockedByThem);

            const banner = document.getElementById('teacher-blocked-notice-banner');
            const bannerText = document.getElementById('teacher-blocked-notice-text');
            const bannerUnblockBtn = document.getElementById('teacher-banner-unblock-btn');
            const inputContainer = document.getElementById('teacher-input-container');
            const blockBtn = document.getElementById('teacher-details-block-btn');
            const blockBtnText = document.getElementById('teacher-details-block-btn-text');
            const blockBtnIcon = document.getElementById('teacher-details-block-btn-icon');

            if (isCurrentStudentBlockedByMe) {
                if (banner) {
                    banner.classList.remove('hidden');
                    if (bannerText) bannerText.textContent = 'You have blocked this student.';
                    if (bannerUnblockBtn) bannerUnblockBtn.classList.remove('hidden');
                }
                if (inputContainer) inputContainer.classList.add('hidden');
                if (blockBtn) {
                    blockBtn.classList.remove('border-rose-200', 'dark:border-rose-900/50', 'bg-rose-50/50', 'dark:bg-rose-950/20', 'text-rose-600', 'dark:text-rose-400');
                    blockBtn.classList.add('border-slate-200', 'dark:border-slate-700', 'bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
                }
                if (blockBtnIcon) blockBtnIcon.textContent = 'lock_open';
                if (blockBtnText) blockBtnText.textContent = 'Unblock Student';
            } else if (isCurrentStudentBlockedByThem) {
                if (banner) {
                    banner.classList.remove('hidden');
                    if (bannerText) bannerText.textContent = 'You cannot reply to this conversation.';
                    if (bannerUnblockBtn) bannerUnblockBtn.classList.add('hidden');
                }
                if (inputContainer) inputContainer.classList.add('hidden');
                if (blockBtnIcon) blockBtnIcon.textContent = 'block';
                if (blockBtnText) blockBtnText.textContent = 'Block Student';
            } else {
                if (banner) banner.classList.add('hidden');
                if (inputContainer) inputContainer.classList.remove('hidden');
                if (blockBtn) {
                    blockBtn.classList.add('border-rose-200', 'dark:border-rose-900/50', 'bg-rose-50/50', 'dark:bg-rose-950/20', 'text-rose-600', 'dark:text-rose-400');
                    blockBtn.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
                }
                if (blockBtnIcon) blockBtnIcon.textContent = 'block';
                if (blockBtnText) blockBtnText.textContent = 'Block Student';
            }
        }

        function openTeacherBlockModal() {
            if (!activeStudentId) return;
            const stuData = studentsDirectory[activeStudentId];
            const studentName = stuData ? stuData.name : 'this student';
            const isUnblocking = isCurrentStudentBlockedByMe;

            const modal = document.getElementById('custom-teacher-block-modal');
            const title = document.getElementById('teacher-modal-block-title');
            const desc = document.getElementById('teacher-modal-block-desc');
            const iconBox = document.getElementById('teacher-modal-block-icon-box');
            const icon = document.getElementById('teacher-modal-block-icon');
            const confirmBtn = document.getElementById('teacher-modal-block-confirm-btn');
            const confirmText = document.getElementById('teacher-modal-block-btn-text');

            if (isUnblocking) {
                if (title) title.textContent = `Unblock ${studentName}?`;
                if (desc) desc.textContent = 'You will be able to send and receive messages again.';
                if (iconBox) {
                    iconBox.className = 'size-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0';
                }
                if (icon) icon.textContent = 'lock_open';
                if (confirmBtn) {
                    confirmBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition-all shadow-xs cursor-pointer select-none active:scale-95 flex items-center gap-1.5';
                }
                if (confirmText) confirmText.textContent = 'Unblock';
            } else {
                if (title) title.textContent = `Block ${studentName}?`;
                if (desc) desc.textContent = "You won't be able to message each other.";
                if (iconBox) {
                    iconBox.className = 'size-9 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0';
                }
                if (icon) icon.textContent = 'block';
                if (confirmBtn) {
                    confirmBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-all shadow-xs cursor-pointer select-none active:scale-95 flex items-center gap-1.5';
                }
                if (confirmText) confirmText.textContent = 'Block';
            }

            if (modal) modal.classList.remove('hidden');
        }
        window.openTeacherBlockModal = openTeacherBlockModal;

        function closeTeacherBlockModal() {
            const modal = document.getElementById('custom-teacher-block-modal');
            if (modal) modal.classList.add('hidden');
        }
        window.closeTeacherBlockModal = closeTeacherBlockModal;

        async function executeTeacherBlockToggle() {
            if (!activeStudentId) return;
            const confirmBtn = document.getElementById('teacher-modal-block-confirm-btn');
            if (confirmBtn) confirmBtn.disabled = true;

            try {
                const res = await fetch('/api/messages/toggle-block', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ targetUserId: activeStudentId })
                });
                const data = await res.json();
                if (data.success) {
                    updateTeacherBlockUI(data.isBlocked, isCurrentStudentBlockedByThem);
                    closeTeacherBlockModal();
                }
            } catch (err) {
                console.error('Failed to toggle block:', err);
            } finally {
                if (confirmBtn) confirmBtn.disabled = false;
            }
        }
        window.executeTeacherBlockToggle = executeTeacherBlockToggle;

        function selectStudentThread(stuId) {
            if (!stuId) return;
            activeStudentId = stuId;
            isFirstLoad = true;
            prevMessagesSignature = '';

            // Update URL without full page reload
            if (window.location.search !== '?studentId=' + stuId) {
                window.history.pushState({ studentId: stuId }, '', '/teacher/messages?studentId=' + stuId);
            }

            // Update sidebar active highlights
            document.querySelectorAll('.student-thread-item').forEach(item => {
                const itemId = item.getAttribute('data-student-id');
                const nameEl = item.querySelector('.student-item-name');
                if (itemId === stuId) {
                    item.classList.add('bg-slate-200/90', 'dark:bg-slate-800', 'shadow-2xs');
                    item.classList.remove('hover:bg-slate-100/80', 'dark:hover:bg-slate-800/50');
                    if (nameEl) {
                        nameEl.classList.add('text-primary', 'dark:text-primary', 'font-bold');
                        nameEl.classList.remove('text-slate-700', 'dark:text-slate-200');
                    }
                    const badge = item.querySelector('.unread-badge');
                    if (badge) badge.remove();
                } else {
                    item.classList.remove('bg-slate-200/90', 'dark:bg-slate-800', 'shadow-2xs');
                    item.classList.add('hover:bg-slate-100/80', 'dark:hover:bg-slate-800/50');
                    if (nameEl) {
                        nameEl.classList.remove('text-primary', 'dark:text-primary', 'font-bold');
                        nameEl.classList.add('text-slate-700', 'dark:text-slate-200');
                    }
                }
            });

            // Update Active Chat Header
            const stuData = studentsDirectory[stuId];
            if (stuData) {
                const nameEl = document.getElementById('active-student-name');
                if (nameEl) nameEl.textContent = stuData.name;

                const clsEl = document.getElementById('active-student-class');
                if (clsEl) clsEl.textContent = stuData.classLevel || 'Student';

                const avatarEl = document.getElementById('active-student-avatar');
                if (avatarEl) {
                    if (stuData.profilePicture) {
                        avatarEl.innerHTML = `<img src="${escapeHtml(stuData.profilePicture)}" alt="${escapeHtml(stuData.name)}" class="w-full h-full object-cover">`;
                    } else {
                        avatarEl.innerHTML = `<span>${(stuData.name || 'S')[0].toUpperCase()}</span>`;
                    }
                }

                // Update Details Panel
                const detAvatar = document.getElementById('teacher-details-avatar');
                const detName = document.getElementById('teacher-details-name');
                if (detName) detName.textContent = stuData.name;
                if (detAvatar) {
                    if (stuData.profilePicture) {
                        detAvatar.innerHTML = `<img src="${escapeHtml(stuData.profilePicture)}" alt="${escapeHtml(stuData.name)}" class="w-full h-full object-cover">`;
                    } else {
                        detAvatar.innerHTML = `<span>${(stuData.name || 'S')[0].toUpperCase()}</span>`;
                    }
                }

                const inputEl = document.getElementById('teacher-msg-input');
                if (inputEl) inputEl.placeholder = `Type your response to ${stuData.name}... (Press Enter to send)`;
            }

            // On mobile screens, automatically collapse sidebar when opening a thread
            if (window.innerWidth < 768) {
                toggleTeacherSidebar(false);
            }

            // Show active chat container, hide empty placeholder
            const emptyBox = document.getElementById('empty-chat-placeholder');
            const activeBox = document.getElementById('active-chat-content');
            if (emptyBox) emptyBox.classList.add('hidden');
            if (activeBox) activeBox.classList.remove('hidden');

            const streamEl = document.getElementById('teacher-messages-stream');
            if (streamEl) streamEl.innerHTML = `<div class="py-10 text-center text-xs font-semibold text-slate-400">Loading conversation...</div>`;

            // Immediately load thread messages
            loadThreadMessages(true);

            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(() => loadThreadMessages(false), 3000);
        }

        window.addEventListener('popstate', () => {
            const params = new URLSearchParams(window.location.search);
            const stuId = params.get('studentId');
            if (stuId && studentsDirectory[stuId]) {
                selectStudentThread(stuId);
            }
        });

        function filterStudentList(query) {
            const q = (query || '').toLowerCase().trim();
            const items = document.querySelectorAll('.student-thread-item');
            items.forEach(item => {
                const name = item.getAttribute('data-student-name') || '';
                const cls = item.getAttribute('data-student-class') || '';
                if (!q || name.includes(q) || cls.includes(q)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        let isFirstLoad = true;
        let prevMessagesSignature = '';

        // --- Staged Attachment & Rich Media Support ---
        let stagedTeacherAttachment = null;
        let teacherMediaRecorder = null;
        let teacherAudioChunks = [];
        let teacherVoiceTimerInterval = null;
        let teacherVoiceSeconds = 0;
        let teacherCameraStream = null;
        let teacherCameraFacing = 'user';
        let teacherCapturedBlob = null;

        function formatBytes(bytes, decimals = 1) {
            if (!bytes) return '0 B';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        }

        function handleTeacherFileSelect(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;

            const mime = (file.type || '').toLowerCase();
            const name = file.name || 'attachment';
            let fileType = 'other';
            if (mime.startsWith('image/')) fileType = 'image';
            else if (mime.startsWith('video/')) fileType = 'video';
            else if (mime.startsWith('audio/')) fileType = 'audio';
            else if (mime === 'application/pdf' || name.endsWith('.pdf')) fileType = 'pdf';
            else if (mime.includes('word') || mime.includes('document') || name.match(/\.(docx?|txt|xlsx?|pptx?)$/i)) fileType = 'document';

            stageTeacherAttachment(file, name, file.size, fileType);
        }
        window.handleTeacherFileSelect = handleTeacherFileSelect;

        function stageTeacherAttachment(fileOrBlob, name, size, fileType, duration) {
            stagedTeacherAttachment = {
                file: fileOrBlob,
                fileName: name,
                fileSize: size || 0,
                fileType: fileType || 'other',
                duration: duration || undefined
            };

            const bar = document.getElementById('teacher-staged-attachment-bar');
            const nameEl = document.getElementById('teacher-staged-name');
            const sizeEl = document.getElementById('teacher-staged-size');
            const iconEl = document.getElementById('teacher-staged-icon');
            const imgEl = document.getElementById('teacher-staged-img');

            if (bar) bar.classList.remove('hidden');
            if (nameEl) nameEl.textContent = name;
            if (sizeEl) sizeEl.textContent = formatBytes(size);

            if (fileType === 'image') {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    if (imgEl) {
                        imgEl.src = ev.target.result;
                        imgEl.classList.remove('hidden');
                    }
                    if (iconEl) iconEl.classList.add('hidden');
                };
                reader.readAsDataURL(fileOrBlob);
            } else {
                if (imgEl) { imgEl.src = ''; imgEl.classList.add('hidden'); }
                if (iconEl) {
                    iconEl.classList.remove('hidden');
                    if (fileType === 'video') iconEl.textContent = 'movie';
                    else if (fileType === 'audio') iconEl.textContent = 'mic';
                    else if (fileType === 'pdf') iconEl.textContent = 'picture_as_pdf';
                    else if (fileType === 'document') iconEl.textContent = 'description';
                    else iconEl.textContent = 'attach_file';
                }
            }

            const input = document.getElementById('teacher-msg-input');
            if (input) input.focus();
        }

        function clearTeacherStagedAttachment() {
            stagedTeacherAttachment = null;
            const bar = document.getElementById('teacher-staged-attachment-bar');
            const fileInput = document.getElementById('teacher-file-input');
            if (bar) bar.classList.add('hidden');
            if (fileInput) fileInput.value = '';
        }
        window.clearTeacherStagedAttachment = clearTeacherStagedAttachment;

        // --- Voice Recording ---
        async function startTeacherVoiceRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                teacherAudioChunks = [];
                teacherVoiceSeconds = 0;

                teacherMediaRecorder = new MediaRecorder(stream);
                teacherMediaRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) teacherAudioChunks.push(e.data);
                };

                teacherMediaRecorder.onstop = () => {
                    stream.getTracks().forEach(track => track.stop());
                };

                teacherMediaRecorder.start();

                const recBar = document.getElementById('teacher-voice-recording-bar');
                const timerEl = document.getElementById('teacher-voice-timer');
                if (recBar) recBar.classList.remove('hidden');
                if (timerEl) timerEl.textContent = '0:00';

                if (teacherVoiceTimerInterval) clearInterval(teacherVoiceTimerInterval);
                teacherVoiceTimerInterval = setInterval(() => {
                    teacherVoiceSeconds++;
                    const mins = Math.floor(teacherVoiceSeconds / 60);
                    const secs = teacherVoiceSeconds % 60;
                    if (timerEl) timerEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
                }, 1000);
            } catch (err) {
                console.error('Microphone access error:', err);
                alert('Unable to access microphone. Please check browser permissions.');
            }
        }
        window.startTeacherVoiceRecording = startTeacherVoiceRecording;

        function cancelTeacherVoiceRecording() {
            if (teacherVoiceTimerInterval) clearInterval(teacherVoiceTimerInterval);
            if (teacherMediaRecorder && teacherMediaRecorder.state !== 'inactive') {
                teacherMediaRecorder.stop();
            }
            teacherAudioChunks = [];
            const recBar = document.getElementById('teacher-voice-recording-bar');
            if (recBar) recBar.classList.add('hidden');
        }
        window.cancelTeacherVoiceRecording = cancelTeacherVoiceRecording;

        function finishTeacherVoiceRecording(autoSend = false) {
            if (teacherVoiceTimerInterval) clearInterval(teacherVoiceTimerInterval);
            const duration = teacherVoiceSeconds;
            const mins = Math.floor(duration / 60);
            const secs = (duration % 60).toString().padStart(2, '0');

            if (!teacherMediaRecorder || teacherMediaRecorder.state === 'inactive') {
                cancelTeacherVoiceRecording();
                return;
            }

            teacherMediaRecorder.onstop = () => {
                const audioBlob = new Blob(teacherAudioChunks, { type: 'audio/webm' });
                const recBar = document.getElementById('teacher-voice-recording-bar');
                if (recBar) recBar.classList.add('hidden');

                stageTeacherAttachment(audioBlob, `Voice Note (${mins}:${secs})`, audioBlob.size, 'audio', duration);

                if (autoSend) {
                    sendTeacherMessage();
                }
            };

            teacherMediaRecorder.stop();
        }
        window.finishTeacherVoiceRecording = finishTeacherVoiceRecording;

        // --- Camera Capture Modal ---
        async function openTeacherCameraModal() {
            const modal = document.getElementById('teacher-camera-modal');
            const video = document.getElementById('teacher-camera-video');
            const liveControls = document.getElementById('teacher-camera-controls-live');
            const prevControls = document.getElementById('teacher-camera-controls-preview');
            const prevImg = document.getElementById('teacher-camera-preview-img');

            if (modal) modal.classList.remove('hidden');
            if (liveControls) liveControls.classList.remove('hidden');
            if (prevControls) prevControls.classList.add('hidden');
            if (prevImg) prevImg.classList.add('hidden');
            if (video) video.classList.remove('hidden');

            try {
                if (teacherCameraStream) {
                    teacherCameraStream.getTracks().forEach(t => t.stop());
                }
                teacherCameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: teacherCameraFacing },
                    audio: false
                });
                if (video) video.srcObject = teacherCameraStream;
            } catch (err) {
                console.error('Camera access error:', err);
                alert('Unable to access camera. Please check camera permissions.');
                closeTeacherCameraModal();
            }
        }
        window.openTeacherCameraModal = openTeacherCameraModal;

        function closeTeacherCameraModal() {
            if (teacherCameraStream) {
                teacherCameraStream.getTracks().forEach(t => t.stop());
                teacherCameraStream = null;
            }
            const modal = document.getElementById('teacher-camera-modal');
            if (modal) modal.classList.add('hidden');
        }
        window.closeTeacherCameraModal = closeTeacherCameraModal;

        async function switchTeacherCamera() {
            teacherCameraFacing = teacherCameraFacing === 'user' ? 'environment' : 'user';
            await openTeacherCameraModal();
        }
        window.switchTeacherCamera = switchTeacherCamera;

        function captureTeacherPhoto() {
            const video = document.getElementById('teacher-camera-video');
            const canvas = document.getElementById('teacher-camera-canvas');
            const prevImg = document.getElementById('teacher-camera-preview-img');
            const liveControls = document.getElementById('teacher-camera-controls-live');
            const prevControls = document.getElementById('teacher-camera-controls-preview');

            if (!video || !canvas) return;

            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob((blob) => {
                teacherCapturedBlob = blob;
                const url = URL.createObjectURL(blob);
                if (prevImg) {
                    prevImg.src = url;
                    prevImg.classList.remove('hidden');
                }
                if (video) video.classList.add('hidden');
                if (liveControls) liveControls.classList.add('hidden');
                if (prevControls) prevControls.classList.remove('hidden');
            }, 'image/jpeg', 0.92);
        }
        window.captureTeacherPhoto = captureTeacherPhoto;

        function retakeTeacherPhoto() {
            const video = document.getElementById('teacher-camera-video');
            const prevImg = document.getElementById('teacher-camera-preview-img');
            const liveControls = document.getElementById('teacher-camera-controls-live');
            const prevControls = document.getElementById('teacher-camera-controls-preview');

            teacherCapturedBlob = null;
            if (prevImg) prevImg.classList.add('hidden');
            if (video) video.classList.remove('hidden');
            if (liveControls) liveControls.classList.remove('hidden');
            if (prevControls) prevControls.classList.add('hidden');
        }
        window.retakeTeacherPhoto = retakeTeacherPhoto;

        function useCapturedTeacherPhoto() {
            if (teacherCapturedBlob) {
                stageTeacherAttachment(teacherCapturedBlob, `photo-${Date.now()}.jpg`, teacherCapturedBlob.size, 'image');
            }
            closeTeacherCameraModal();
        }
        window.useCapturedTeacherPhoto = useCapturedTeacherPhoto;

        function renderTeacherMessageBubble(msg, isMe) {
            if (msg.deletedForEveryone) {
                return `
                    <div class="px-3.5 py-2.5 rounded-2xl ${isMe ? 'rounded-tr-none bg-[#0084FF]/20 text-white/90' : 'rounded-tl-none bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400'} border border-slate-200/60 dark:border-slate-700/60 italic text-xs font-medium flex items-center gap-1.5 shadow-2xs select-none">
                        <span class="material-symbols-rounded text-sm opacity-75 leading-none pointer-events-none">block</span>
                        <span>This message was deleted</span>
                    </div>
                `;
            }

            const att = msg.attachment;
            const hasText = Boolean(msg.text && msg.text.trim());
            const pinnedRing = msg.isPinned ? (isMe ? 'ring-2 ring-amber-400' : 'ring-2 ring-amber-400 border-amber-400') : '';

            let replyQuoteHtml = '';
            if (msg.replyTo && msg.replyTo.messageId) {
                const rSender = escapeHtml(msg.replyTo.senderName || 'Replied message');
                const rText = escapeHtml(msg.replyTo.text || (msg.replyTo.fileType ? `[${msg.replyTo.fileType}]` : 'Attachment'));
                replyQuoteHtml = `
                    <div onclick="scrollToTeacherMessage('${msg.replyTo.messageId}')" class="cursor-pointer mb-2 px-2.5 py-1.5 rounded-xl border-l-2 ${isMe ? 'border-white/80 bg-white/15 text-white' : 'border-primary bg-slate-200/80 dark:bg-slate-700/80 text-slate-800 dark:text-slate-100'} text-[11px] select-none transition-all hover:opacity-90">
                        <div class="font-bold flex items-center gap-1">
                            <span class="material-symbols-rounded text-[13px] leading-none">reply</span>
                            <span class="truncate">${rSender}</span>
                        </div>
                        <div class="truncate opacity-80 mt-0.5">${rText}</div>
                    </div>
                `;
            }

            // 1. Pure Image (No text caption)
            if (att && att.url && att.fileType === 'image' && !hasText) {
                const fileUrl = escapeHtml(att.url);
                const fileName = escapeHtml(att.fileName || 'Photo');
                return `
                    <div class="overflow-hidden rounded-2xl shadow-xs border border-black/10 dark:border-white/10 max-w-[260px] sm:max-w-[320px] ${pinnedRing}">
                        ${replyQuoteHtml ? `<div class="p-2 pb-0">${replyQuoteHtml}</div>` : ''}
                        <a href="${fileUrl}" target="_blank" class="block hover:opacity-95 transition-opacity">
                            <img src="${fileUrl}" alt="${fileName}" class="w-full max-h-80 object-cover block">
                        </a>
                    </div>
                `;
            }

            // 2. Pure Video (No text caption)
            if (att && att.url && att.fileType === 'video' && !hasText) {
                const fileUrl = escapeHtml(att.url);
                return `
                    <div class="overflow-hidden rounded-2xl shadow-xs border border-black/10 dark:border-white/10 max-w-[280px] sm:max-w-[340px] bg-black ${pinnedRing}">
                        ${replyQuoteHtml ? `<div class="p-2 pb-0">${replyQuoteHtml}</div>` : ''}
                        <video controls playsinline preload="metadata" class="w-full rounded-2xl max-h-80 block">
                            <source src="${fileUrl}">
                            Your browser does not support HTML5 video.
                        </video>
                    </div>
                `;
            }

            // 3. Pure Voice Audio Note
            if (att && att.url && att.fileType === 'audio' && !hasText) {
                const fileUrl = escapeHtml(att.url);
                const durStr = att.duration ? `${Math.floor(att.duration / 60)}:${Math.floor(att.duration % 60).toString().padStart(2, '0')}` : '';
                return `
                    <div class="p-2 sm:p-2.5 rounded-2xl flex flex-col gap-1.5 shadow-2xs min-w-[210px] bg-[#EAE9ED] dark:bg-[#1e293b] text-slate-800 dark:text-slate-100 border border-slate-300/70 dark:border-slate-700/80 ${pinnedRing}">
                        ${replyQuoteHtml}
                        <div class="flex items-center gap-2.5">
                            <div class="size-8.5 rounded-xl bg-white dark:bg-slate-800 text-primary shadow-2xs flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-lg leading-none">mic</span>
                            </div>
                            <audio controls class="h-8 max-w-[150px] sm:max-w-[190px] custom-audio-player">
                                <source src="${fileUrl}">
                            </audio>
                            ${durStr ? `<span class="text-[10px] font-mono font-semibold text-slate-600 dark:text-slate-300 shrink-0">${durStr}</span>` : ''}
                        </div>
                    </div>
                `;
            }

            // 4. Pure File / Document (No text caption)
            if (att && att.url && (att.fileType === 'pdf' || att.fileType === 'document' || att.fileType === 'other') && !hasText) {
                const fileUrl = escapeHtml(att.url);
                const fileName = escapeHtml(att.fileName || 'Attachment');
                const fileSizeStr = att.fileSize ? formatBytes(att.fileSize) : '';
                const isPdf = att.fileType === 'pdf';
                const iconName = isPdf ? 'picture_as_pdf' : 'description';
                return `
                    <div class="p-3 rounded-2xl flex flex-col gap-1.5 shadow-2xs min-w-[210px] max-w-[280px] ${isMe ? 'bg-[#0084FF] text-white' : 'bg-[#f0f2f5] dark:bg-[#1e293b] text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-700/80'} ${pinnedRing}">
                        ${replyQuoteHtml}
                        <a href="${fileUrl}" target="_blank" download="${fileName}" class="flex items-center gap-2.5 group/doc">
                            <div class="size-9 rounded-xl ${isMe ? 'bg-white/20 text-white' : (isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500')} flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-xl leading-none">${iconName}</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="text-xs font-semibold truncate group-hover/doc:underline">${fileName}</div>
                                ${fileSizeStr ? `<div class="text-[10px] opacity-80">${fileSizeStr}</div>` : ''}
                            </div>
                            <span class="material-symbols-rounded text-base opacity-85 shrink-0">download</span>
                        </a>
                    </div>
                `;
            }

            // 5. Combined content or text with attachment
            let innerContent = replyQuoteHtml;
            if (att && att.url) {
                const fileUrl = escapeHtml(att.url);
                const fileName = escapeHtml(att.fileName || 'Attachment');
                const fileSizeStr = att.fileSize ? formatBytes(att.fileSize) : '';

                if (att.fileType === 'image') {
                    innerContent += `
                        <div class="mb-2 -mx-1.5 -mt-1.5 overflow-hidden rounded-xl">
                            <a href="${fileUrl}" target="_blank" class="block hover:opacity-95 transition-opacity">
                                <img src="${fileUrl}" alt="${fileName}" class="w-full max-h-72 object-cover block">
                            </a>
                        </div>
                    `;
                } else if (att.fileType === 'video') {
                    innerContent += `
                        <div class="mb-2 -mx-1.5 -mt-1.5 overflow-hidden rounded-xl bg-black">
                            <video controls playsinline preload="metadata" class="w-full rounded-xl max-h-72 block">
                                <source src="${fileUrl}">
                            </video>
                        </div>
                    `;
                } else if (att.fileType === 'audio') {
                    innerContent += `
                        <div class="mb-2 p-1.5 rounded-xl flex items-center gap-2 ${isMe ? 'bg-white/20' : 'bg-[#EAE9ED] dark:bg-slate-700/60'}">
                            <audio controls class="h-8 w-full custom-audio-player"><source src="${fileUrl}"></audio>
                        </div>
                    `;
                } else {
                    const isPdf = att.fileType === 'pdf';
                    const iconName = isPdf ? 'picture_as_pdf' : 'description';
                    innerContent += `
                        <a href="${fileUrl}" target="_blank" download="${fileName}" class="mb-1.5 p-2.5 rounded-xl flex items-center gap-2.5 ${isMe ? 'bg-[#0084FF] border border-white/25 text-white' : 'bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-700/80'} transition-all shadow-2xs group/doc block">
                            <div class="size-8.5 rounded-lg ${isMe ? 'bg-white/20 text-white' : (isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500')} flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-xl leading-none">${iconName}</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="text-xs font-semibold truncate group-hover/doc:underline">${fileName}</div>
                                ${fileSizeStr ? `<div class="text-[10px] opacity-80">${fileSizeStr}</div>` : ''}
                            </div>
                            <span class="material-symbols-rounded text-base opacity-85 shrink-0">download</span>
                        </a>
                    `;
                }
            }

            if (hasText) {
                innerContent += `<div>${escapeHtml(msg.text)}</div>`;
            }

            if (isMe) {
                return `
                    <div class="px-3.5 py-2.5 rounded-2xl rounded-tr-none bg-[#0084FF] text-white text-xs font-medium leading-relaxed shadow-sm ${pinnedRing}">
                        ${innerContent}
                    </div>
                `;
            } else {
                return `
                    <div class="px-3.5 py-2.5 rounded-2xl rounded-tl-none bg-[#f0f2f5] dark:bg-[#1e293b] border border-slate-200/80 dark:border-slate-700/80 text-slate-800 dark:text-slate-100 text-xs font-medium leading-relaxed shadow-2xs ${pinnedRing}">
                        ${innerContent}
                    </div>
                `;
            }
        }

        async function loadThreadMessages(forceScroll = false) {
            if (!activeStudentId) return;
            const container = document.getElementById('teacher-messages-stream');
            if (!container) return;

            try {
                const res = await fetch('/api/messages/thread/' + activeStudentId);
                const data = await res.json();

                if (data.success && Array.isArray(data.messages)) {
                    updateTeacherBlockUI(data.isBlockedByMe, data.isBlockedByThem);

                    // Extract all media & files from messages
                    const mediaGrid = document.getElementById('teacher-details-media-grid');
                    const mediaEmpty = document.getElementById('teacher-details-media-empty');
                    const mediaCount = document.getElementById('teacher-details-media-count');
                    const seeAllMediaBtn = document.getElementById('teacher-details-media-see-all-btn');

                    const fullMediaGrid = document.getElementById('teacher-full-media-grid');
                    const fullMediaEmpty = document.getElementById('teacher-full-media-empty');
                    const fullMediaSubcount = document.getElementById('teacher-full-media-subcount');

                    const fullDocsList = document.getElementById('teacher-full-docs-list');
                    const fullDocsEmpty = document.getElementById('teacher-full-docs-empty');
                    const fullDocsSubcount = document.getElementById('teacher-full-docs-subcount');

                    const fullVoiceList = document.getElementById('teacher-full-voice-list');
                    const fullVoiceEmpty = document.getElementById('teacher-full-voice-empty');
                    const fullVoiceSubcount = document.getElementById('teacher-full-voice-subcount');

                    const fullCountBadge = document.getElementById('teacher-full-media-files-count');

                    const urlRegex = /(https?:\/\/[^\s]+\.(?:png|jpg|jpeg|gif|webp|svg))/gi;

                    const photosAndVideos = [];
                    const docFiles = [];
                    const voiceNotes = [];
                    const allSharedItems = [];

                    data.messages.forEach(m => {
                        if (m.attachment && m.attachment.url) {
                            const item = {
                                id: m._id,
                                url: m.attachment.url,
                                fileName: m.attachment.fileName || 'Attachment',
                                fileSize: m.attachment.fileSize || 0,
                                fileType: m.attachment.fileType || 'other',
                                duration: m.attachment.duration || 0,
                                createdAt: m.createdAt,
                                senderName: m.senderName || (m.sender && m.sender.name) || 'User'
                            };
                            allSharedItems.push(item);
                            if (item.fileType === 'image' || item.fileType === 'video') {
                                photosAndVideos.push(item);
                            } else if (item.fileType === 'audio') {
                                voiceNotes.push(item);
                            } else {
                                docFiles.push(item);
                            }
                        } else {
                            const matches = (m.text || '').match(urlRegex);
                            if (matches) {
                                matches.forEach(url => {
                                    const item = {
                                        id: m._id,
                                        url: url,
                                        fileName: url.split('/').pop() || 'Image',
                                        fileSize: 0,
                                        fileType: 'image',
                                        duration: 0,
                                        createdAt: m.createdAt,
                                        senderName: m.senderName || (m.sender && m.sender.name) || 'User'
                                    };
                                    allSharedItems.push(item);
                                    photosAndVideos.push(item);
                                });
                            }
                        }
                    });

                    if (mediaCount) mediaCount.textContent = `${allSharedItems.length} item${allSharedItems.length === 1 ? '' : 's'}`;
                    if (fullCountBadge) fullCountBadge.textContent = allSharedItems.length;

                    // Render Sidebar Preview (up to 6 items)
                    if (allSharedItems.length > 0) {
                        if (mediaEmpty) mediaEmpty.classList.add('hidden');
                        if (mediaGrid) {
                            mediaGrid.classList.remove('hidden');
                            const previewItems = allSharedItems.slice(0, 6);
                            mediaGrid.innerHTML = previewItems.map(item => {
                                if (item.fileType === 'image') {
                                    return `
                                        <a href="${escapeHtml(item.url)}" target="_blank" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 block hover:opacity-85 transition-all shadow-2xs group">
                                            <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.fileName)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
                                        </a>
                                    `;
                                } else if (item.fileType === 'video') {
                                    return `
                                        <a href="${escapeHtml(item.url)}" target="_blank" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl overflow-hidden bg-slate-900 border border-slate-700 flex items-center justify-center text-white relative hover:opacity-85 transition-all shadow-2xs group">
                                            <span class="material-symbols-rounded text-2xl leading-none">play_circle</span>
                                        </a>
                                    `;
                                } else if (item.fileType === 'audio') {
                                    return `
                                        <div onclick="openTeacherAllMediaFilesView(true)" title="Voice Note" class="aspect-square rounded-xl bg-primary/10 border border-primary/20 flex flex-col items-center justify-center text-primary cursor-pointer hover:bg-primary/15 transition-all shadow-2xs p-1">
                                            <span class="material-symbols-rounded text-xl leading-none mb-0.5">mic</span>
                                            <span class="text-[9px] font-bold font-mono">Audio</span>
                                        </div>
                                    `;
                                } else {
                                    const isPdf = item.fileType === 'pdf';
                                    return `
                                        <a href="${escapeHtml(item.url)}" target="_blank" download="${escapeHtml(item.fileName)}" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl ${isPdf ? 'bg-rose-500/10 border-rose-500/20 text-rose-500 hover:bg-rose-500/15' : 'bg-blue-500/10 border-blue-500/20 text-blue-500 hover:bg-blue-500/15'} border flex flex-col items-center justify-center transition-all shadow-2xs p-1 text-center">
                                            <span class="material-symbols-rounded text-xl leading-none mb-0.5">${isPdf ? 'picture_as_pdf' : 'description'}</span>
                                            <span class="text-[8.5px] font-semibold truncate w-full px-1">${escapeHtml(item.fileName.slice(0, 7))}</span>
                                        </a>
                                    `;
                                }
                            }).join('');
                        }

                        if (seeAllMediaBtn) {
                            seeAllMediaBtn.classList.remove('hidden');
                            seeAllMediaBtn.innerHTML = `<span>See all (${allSharedItems.length})</span><span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>`;
                        }
                    } else {
                        if (mediaGrid) { mediaGrid.innerHTML = ''; mediaGrid.classList.add('hidden'); }
                        if (mediaEmpty) mediaEmpty.classList.remove('hidden');
                        if (seeAllMediaBtn) seeAllMediaBtn.classList.add('hidden');
                    }

                    // Render Full Dedicated View
                    // 1. Photos & Videos
                    if (teacherFullMediaSubcount = document.getElementById('teacher-full-media-subcount')) teacherFullMediaSubcount.textContent = `(${photosAndVideos.length})`;
                    if (photosAndVideos.length > 0) {
                        if (fullMediaEmpty) fullMediaEmpty.classList.add('hidden');
                        if (fullMediaGrid) {
                            fullMediaGrid.classList.remove('hidden');
                            fullMediaGrid.innerHTML = photosAndVideos.map(item => {
                                if (item.fileType === 'video') {
                                    return `
                                        <div class="rounded-2xl overflow-hidden bg-black border border-slate-200 dark:border-slate-800 shadow-2xs group relative">
                                            <video controls playsinline preload="metadata" class="w-full h-44 object-cover">
                                                <source src="${escapeHtml(item.url)}">
                                            </video>
                                            <div class="p-2 bg-slate-900/90 text-white text-[11px] font-medium truncate flex items-center justify-between">
                                                <span class="truncate">${escapeHtml(item.senderName)}</span>
                                                <a href="${escapeHtml(item.url)}" target="_blank" download="${escapeHtml(item.fileName)}" class="hover:text-primary"><span class="material-symbols-rounded text-sm">download</span></a>
                                            </div>
                                        </div>
                                    `;
                                } else {
                                    return `
                                        <a href="${escapeHtml(item.url)}" target="_blank" class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 shadow-2xs group block relative hover:opacity-95 transition-all">
                                            <img src="${escapeHtml(item.url)}" alt="Photo" class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300">
                                        </a>
                                    `;
                                }
                            }).join('');
                        }
                    } else {
                        if (fullMediaGrid) { fullMediaGrid.innerHTML = ''; fullMediaGrid.classList.add('hidden'); }
                        if (fullMediaEmpty) fullMediaEmpty.classList.remove('hidden');
                    }

                    // 2. Documents & Files
                    if (teacherFullDocsSubcount = document.getElementById('teacher-full-docs-subcount')) teacherFullDocsSubcount.textContent = `(${docFiles.length})`;
                    if (docFiles.length > 0) {
                        if (fullDocsEmpty) fullDocsEmpty.classList.add('hidden');
                        if (fullDocsList) {
                            fullDocsList.classList.remove('hidden');
                            fullDocsList.innerHTML = docFiles.map(item => {
                                const isPdf = item.fileType === 'pdf';
                                const iconName = isPdf ? 'picture_as_pdf' : 'description';
                                const sizeStr = item.fileSize ? formatBytes(item.fileSize) : '';
                                const timeStr = new Date(item.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' });
                                return `
                                    <a href="${escapeHtml(item.url)}" target="_blank" download="${escapeHtml(item.fileName)}" class="p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 transition-all flex items-center justify-between gap-3 shadow-2xs group">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="size-10 rounded-xl ${isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500'} flex items-center justify-center shrink-0">
                                                <span class="material-symbols-rounded text-2xl leading-none">${iconName}</span>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary transition-colors">${escapeHtml(item.senderName)}</div>
                                                <div class="text-[10px] text-slate-400 font-medium flex items-center gap-1.5 mt-0.5">
                                                    <span>${sizeStr || 'File'}</span>
                                                    <span>•</span>
                                                    <span>${timeStr}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="size-8 rounded-xl bg-white dark:bg-slate-700 text-slate-500 dark:text-slate-300 flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-primary group-hover:text-white transition-all">
                                            <span class="material-symbols-rounded text-lg leading-none">download</span>
                                        </div>
                                    </a>
                                `;
                            }).join('');
                        }
                    } else {
                        if (fullDocsList) { fullDocsList.innerHTML = ''; fullDocsList.classList.add('hidden'); }
                        if (fullDocsEmpty) fullDocsEmpty.classList.remove('hidden');
                    }

                    // 3. Voice Notes
                    if (teacherFullVoiceSubcount = document.getElementById('teacher-full-voice-subcount')) teacherFullVoiceSubcount.textContent = `(${voiceNotes.length})`;
                    if (voiceNotes.length > 0) {
                        if (fullVoiceEmpty) fullVoiceEmpty.classList.add('hidden');
                        if (fullVoiceList) {
                            fullVoiceList.classList.remove('hidden');
                            fullVoiceList.innerHTML = voiceNotes.map(item => {
                                const durStr = item.duration ? `${Math.floor(item.duration / 60)}:${Math.floor(item.duration % 60).toString().padStart(2, '0')}` : '';
                                const timeStr = new Date(item.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' });
                                return `
                                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 flex items-center justify-between gap-3 shadow-2xs">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="size-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                                <span class="material-symbols-rounded text-2xl leading-none">mic</span>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">${escapeHtml(item.senderName)}</div>
                                                <div class="text-[10px] text-slate-400 font-medium flex items-center gap-1.5 mt-0.5">
                                                    <span>${durStr || 'Voice'}</span>
                                                    <span>•</span>
                                                    <span>${timeStr}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <audio controls class="h-8 max-w-[140px] sm:max-w-[180px] custom-audio-player">
                                            <source src="${escapeHtml(item.url)}">
                                        </audio>
                                    </div>
                                `;
                            }).join('');
                        }
                    } else {
                        if (fullVoiceList) { fullVoiceList.innerHTML = ''; fullVoiceList.classList.add('hidden'); }
                        if (fullVoiceEmpty) fullVoiceEmpty.classList.remove('hidden');
                    }

                    // Extract pinned messages
                    const pinnedContainer = document.getElementById('teacher-details-pinned-list-container');
                    const pinnedList = document.getElementById('teacher-details-pinned-list');
                    const pinnedEmpty = document.getElementById('teacher-details-pinned-empty');
                    const pinnedCount = document.getElementById('teacher-details-pinned-count');
                    const seeMoreBtn = document.getElementById('teacher-details-pinned-see-more-btn');

                    const fullPinnedContainer = document.getElementById('teacher-full-pinned-list-container');
                    const fullPinnedList = document.getElementById('teacher-full-pinned-list');
                    const fullPinnedEmpty = document.getElementById('teacher-full-pinned-empty');

                    const pinnedMessages = data.messages.filter(m => Boolean(m.isPinned));

                    if (pinnedCount) pinnedCount.textContent = `${pinnedMessages.length} pinned`;

                    const renderTeacherPinnedItem = (m) => {
                        const senderName = m.senderName || (m.sender && m.sender.name) || 'User';
                        const timeStr = new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        return `
                            <div onclick="scrollToTeacherMessage('${m._id}')" class="p-3 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 cursor-pointer transition-all group">
                                <div class="flex items-center justify-between gap-1.5 mb-1">
                                    <span class="text-[11.5px] font-semibold text-slate-800 dark:text-slate-200 truncate">${escapeHtml(senderName)}</span>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <span class="text-[9.5px] text-slate-400 font-medium">${timeStr}</span>
                                        <button type="button" onclick="event.stopPropagation(); toggleTeacherPinMessage('${m._id}')" title="Unpin message" class="size-7 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer active:scale-90 select-none">
                                            <span class="material-symbols-rounded text-base leading-none">keep_off</span>
                                        </button>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed font-normal">${escapeHtml(m.text || (m.attachment ? m.attachment.fileName : 'Media message'))}</p>
                            </div>
                        `;
                    };

                    if (pinnedMessages.length > 0) {
                        if (pinnedEmpty) pinnedEmpty.classList.add('hidden');
                        if (pinnedContainer) pinnedContainer.classList.remove('hidden');
                        if (pinnedList) {
                            const previewItems = pinnedMessages.slice(0, 3);
                            pinnedList.innerHTML = previewItems.map(renderTeacherPinnedItem).join('');
                        }
                        if (seeMoreBtn) {
                            if (pinnedMessages.length > 3) {
                                seeMoreBtn.classList.remove('hidden');
                                seeMoreBtn.innerHTML = `<span>See all ${pinnedMessages.length} pinned</span><span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>`;
                            } else {
                                seeMoreBtn.classList.add('hidden');
                            }
                        }

                        if (fullPinnedEmpty) fullPinnedEmpty.classList.add('hidden');
                        if (fullPinnedContainer) fullPinnedContainer.classList.remove('hidden');
                        if (fullPinnedList) fullPinnedList.innerHTML = pinnedMessages.map(renderTeacherPinnedItem).join('');
                    } else {
                        if (pinnedContainer) pinnedContainer.classList.add('hidden');
                        if (pinnedList) pinnedList.innerHTML = '';
                        if (pinnedEmpty) pinnedEmpty.classList.remove('hidden');
                        if (seeMoreBtn) seeMoreBtn.classList.add('hidden');

                        if (fullPinnedContainer) fullPinnedContainer.classList.add('hidden');
                        if (fullPinnedList) fullPinnedList.innerHTML = '';
                        if (fullPinnedEmpty) fullPinnedEmpty.classList.remove('hidden');
                    }

                    const isNearBottom = (container.scrollHeight - container.scrollTop - container.clientHeight) < 80;
                    const newSig = data.messages.map(m => m._id + (m.isRead ? '1' : '0') + (m.isPinned ? 'p' : '') + (m.attachment ? 'a' : '') + (m.likes ? m.likes.length : 0)).join(',');

                    if (newSig === prevMessagesSignature && !forceScroll && !isFirstLoad) {
                        return;
                    }
                    prevMessagesSignature = newSig;

                    // Store in map for fast copy/reply lookup
                    currentTeacherThreadMessagesMap = {};
                    data.messages.forEach(m => { currentTeacherThreadMessagesMap[m._id] = m; });

                    if (data.messages.length === 0) {
                        container.innerHTML = `
                            <div class="py-14 text-center">
                                <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-1.5 leading-none flex items-center justify-center select-none">waving_hand</span>
                                <h4 class="text-xs font-bold text-slate-700 dark:text-slate-200">Start the conversation</h4>
                                <p class="text-[10px] text-slate-400 mt-0.5">Send a message, voice note, or attachment to guide this student.</p>
                            </div>
                        `;
                    } else {
                        let html = '';
                        data.messages.forEach(msg => {
                            const senderId = (msg.sender && msg.sender._id) ? msg.sender._id.toString() : (msg.sender ? msg.sender.toString() : '');
                            const isMe = senderId === currentTeacherId;
                            const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const avatarUrl = msg.userAvatar || (msg.sender && (msg.sender.profilePicture || msg.sender.profileImage));
                            const senderName = msg.senderName || (msg.sender && msg.sender.name) || (isMe ? 'You' : 'Student');
                            const avatarInitial = senderName ? senderName[0].toUpperCase() : 'S';
                            const msgTextSnippet = (msg.text || (msg.attachment ? msg.attachment.fileName : '')).substring(0, 100);
                            const fileType = msg.attachment ? msg.attachment.fileType : '';
                            const isDeleted = Boolean(msg.deletedForEveryone);
                            const isLikedByMe = Array.isArray(msg.likes) && msg.likes.some(id => id.toString() === currentTeacherId);
                            const likesCount = Array.isArray(msg.likes) ? msg.likes.length : 0;

                            if (isMe) {
                                html += `
                                    <div id="teacher-msg-${msg._id}" class="flex flex-col items-end group transition-all duration-300 rounded-xl p-1 -m-1 relative">
                                        <!-- 1st Line: Pin indicator & Time -->
                                        <div class="flex items-center gap-1 mb-1 mr-1 select-none">
                                            ${msg.isPinned ? '<span class="material-symbols-rounded text-xs text-amber-500 leading-none mr-0.5" title="Pinned message">push_pin</span>' : ''}
                                            <span class="text-[9.5px] font-medium text-slate-400 dark:text-slate-500">${timeStr}</span>
                                        </div>
                                        <!-- 2nd Line: Message Box + Hover Action Capsule -->
                                        <div class="flex items-center gap-1.5 max-w-[85%] sm:max-w-[75%] flex-row-reverse relative">
                                            <div class="relative max-w-full">
                                                ${renderTeacherMessageBubble(msg, true)}
                                                ${likesCount > 0 ? `
                                                    <button type="button" onclick="toggleTeacherLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'Like'}" class="absolute -bottom-2.5 right-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-md rounded-full px-1.5 py-0.5 flex items-center gap-1 text-[11px] font-bold z-10 cursor-pointer active:scale-95 transition-all select-none hover:scale-105">
                                                        <span class="material-symbols-rounded text-sm text-rose-500 leading-none pointer-events-none">favorite</span>
                                                        ${likesCount > 1 ? `<span class="text-[10px] text-slate-700 dark:text-slate-200 font-semibold pointer-events-none">${likesCount}</span>` : ''}
                                                    </button>
                                                ` : ''}
                                            </div>

                                            ${!isDeleted ? `
                                            <!-- Sender Hover Action Capsule -->
                                            <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xs border border-slate-200 dark:border-slate-700 rounded-full px-2 py-1 shadow-md shrink-0 select-none z-10">
                                                <!-- Love / Like Reaction -->
                                                <button type="button" onclick="toggleTeacherLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'React with Love'}" class="size-7.5 sm:size-8 rounded-full ${isLikedByMe ? 'text-rose-500 bg-rose-50 dark:bg-rose-950/40' : 'text-slate-500 dark:text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-700'} flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                    <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">favorite</span>
                                                </button>
                                                <!-- Copy -->
                                                <button type="button" onclick="copyTeacherMessageContent('${msg._id}')" title="Copy text" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                    <span id="teacher-copy-icon-${msg._id}" class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">content_copy</span>
                                                </button>
                                                <!-- Reply -->
                                                <button type="button" onclick="initiateTeacherReply('${msg._id}', '${escapeTeacherJs(senderName)}', '${escapeTeacherJs(msgTextSnippet)}', '${escapeTeacherJs(fileType)}')" title="Reply" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                    <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">reply</span>
                                                </button>
                                                <!-- Three Dots Menu Button -->
                                                <div class="relative inline-block">
                                                    <button type="button" onclick="toggleTeacherMessageMenu('${msg._id}', event)" title="More options" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">more_vert</span>
                                                    </button>
                                                    <!-- Dropdown Menu -->
                                                    <div id="teacher-msg-menu-${msg._id}" class="teacher-msg-action-menu hidden absolute right-0 top-full mt-1.5 w-44 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-xl py-1 z-30 transition-all">
                                                        <button type="button" onclick="toggleTeacherPinMessage('${msg._id}'); closeAllTeacherMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                            <span class="material-symbols-rounded text-base text-amber-500 leading-none">${msg.isPinned ? 'keep_off' : 'push_pin'}</span>
                                                            <span>${msg.isPinned ? 'Unpin message' : 'Pin message'}</span>
                                                        </button>
                                                        <button type="button" onclick="deleteTeacherMessage('${msg._id}', 'for_me'); closeAllTeacherMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                            <span class="material-symbols-rounded text-base text-slate-400 leading-none">delete_outline</span>
                                                            <span>Delete for me</span>
                                                        </button>
                                                        <button type="button" onclick="deleteTeacherMessage('${msg._id}', 'for_everyone'); closeAllTeacherMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2 transition-all cursor-pointer">
                                                            <span class="material-symbols-rounded text-base text-rose-500 leading-none">delete_forever</span>
                                                            <span>Delete for everyone</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                `;
                            } else {
                                const avatarNode = avatarUrl
                                    ? `<div class="size-8 rounded-xl bg-slate-200 dark:bg-slate-800 shrink-0 shadow-2xs overflow-hidden select-none"><img src="${escapeHtml(avatarUrl)}" alt="${escapeHtml(senderName)}" class="w-full h-full object-cover"></div>`
                                    : `<div class="size-8 rounded-xl bg-primary/15 text-primary font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs select-none">${avatarInitial}</div>`;

                                html += `
                                    <div id="teacher-msg-${msg._id}" class="flex flex-col items-start group transition-all duration-300 rounded-xl p-1 -m-1 relative">
                                        <!-- 1st Line: Actions & Time -->
                                        <div class="flex items-center gap-1 mb-1 ml-10 select-none">
                                            <span class="text-[9.5px] font-medium text-slate-400 dark:text-slate-500">${timeStr}</span>
                                            ${msg.isPinned ? '<span class="material-symbols-rounded text-xs text-amber-500 leading-none ml-0.5" title="Pinned message">push_pin</span>' : ''}
                                        </div>
                                        <!-- 2nd Line: Profile Icon & Message Box + Hover Action Capsule -->
                                        <div class="flex items-start gap-2 max-w-[85%] sm:max-w-[75%]">
                                            ${avatarNode}
                                            <div class="flex items-center gap-1.5 max-w-full relative">
                                                <div class="relative max-w-full">
                                                    ${renderTeacherMessageBubble(msg, false)}
                                                    ${likesCount > 0 ? `
                                                        <button type="button" onclick="toggleTeacherLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'Like'}" class="absolute -bottom-2.5 left-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-md rounded-full px-1.5 py-0.5 flex items-center gap-1 text-[11px] font-bold z-10 cursor-pointer active:scale-95 transition-all select-none hover:scale-105">
                                                            <span class="material-symbols-rounded text-sm text-rose-500 leading-none pointer-events-none">favorite</span>
                                                            ${likesCount > 1 ? `<span class="text-[10px] text-slate-700 dark:text-slate-200 font-semibold pointer-events-none">${likesCount}</span>` : ''}
                                                        </button>
                                                    ` : ''}
                                                </div>

                                                ${!isDeleted ? `
                                                <!-- Receiver Hover Action Capsule -->
                                                <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xs border border-slate-200 dark:border-slate-700 rounded-full px-2 py-1 shadow-md shrink-0 select-none z-10">
                                                    <!-- Love / Like Reaction -->
                                                    <button type="button" onclick="toggleTeacherLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'React with Love'}" class="size-7.5 sm:size-8 rounded-full ${isLikedByMe ? 'text-rose-500 bg-rose-50 dark:bg-rose-950/40' : 'text-slate-500 dark:text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-700'} flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">favorite</span>
                                                    </button>
                                                    <!-- Copy -->
                                                    <button type="button" onclick="copyTeacherMessageContent('${msg._id}')" title="Copy text" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span id="teacher-copy-icon-${msg._id}" class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">content_copy</span>
                                                    </button>
                                                    <!-- Reply -->
                                                    <button type="button" onclick="initiateTeacherReply('${msg._id}', '${escapeTeacherJs(senderName)}', '${escapeTeacherJs(msgTextSnippet)}', '${escapeTeacherJs(fileType)}')" title="Reply" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">reply</span>
                                                    </button>
                                                    <!-- Three Dots Menu Button -->
                                                    <div class="relative inline-block">
                                                        <button type="button" onclick="toggleTeacherMessageMenu('${msg._id}', event)" title="More options" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                            <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">more_vert</span>
                                                        </button>
                                                        <!-- Dropdown Menu -->
                                                        <div id="teacher-msg-menu-${msg._id}" class="teacher-msg-action-menu hidden absolute left-0 top-full mt-1.5 w-44 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-xl py-1 z-30 transition-all">
                                                            <button type="button" onclick="toggleTeacherPinMessage('${msg._id}'); closeAllTeacherMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                <span class="material-symbols-rounded text-base text-amber-500 leading-none">${msg.isPinned ? 'keep_off' : 'push_pin'}</span>
                                                                <span>${msg.isPinned ? 'Unpin message' : 'Pin message'}</span>
                                                            </button>
                                                            <button type="button" onclick="deleteTeacherMessage('${msg._id}', 'for_me'); closeAllTeacherMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                <span class="material-symbols-rounded text-base text-slate-400 leading-none">delete_outline</span>
                                                                <span>Delete for me</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                ` : ''}
                                            </div>
                                        </div>
                                    </div>
                                `;
                            }
                        });
                        container.innerHTML = html;

                        if (isFirstLoad || forceScroll || isNearBottom) {
                            container.scrollTop = container.scrollHeight;
                        }
                        isFirstLoad = false;
                    }
                }
            } catch (err) {
                console.error('Failed to load thread messages:', err);
            }
        }

        let currentTeacherThreadMessagesMap = {};
        let currentTeacherReplyTo = null;

        function escapeTeacherJs(str) {
            if (!str) return '';
            return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, ' ').replace(/\r/g, '');
        }

        function toggleTeacherMessageMenu(msgId, e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('teacher-msg-menu-' + msgId);
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            closeAllTeacherMsgMenus();
            if (isHidden) {
                menu.classList.remove('hidden');
            }
        }
        window.toggleTeacherMessageMenu = toggleTeacherMessageMenu;

        function closeAllTeacherMsgMenus() {
            document.querySelectorAll('.teacher-msg-action-menu').forEach(m => m.classList.add('hidden'));
        }
        window.closeAllTeacherMsgMenus = closeAllTeacherMsgMenus;
        document.addEventListener('click', closeAllTeacherMsgMenus);

        async function toggleTeacherLikeMessage(msgId) {
            if (!msgId) return;
            try {
                const res = await fetch('/api/messages/toggle-like', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: msgId })
                });
                const data = await res.json();
                if (data.success) {
                    await loadThreadMessages(false);
                }
            } catch (err) {
                console.error('Failed to toggle like:', err);
            }
        }
        window.toggleTeacherLikeMessage = toggleTeacherLikeMessage;

        function copyTeacherMessageContent(msgId) {
            const msg = currentTeacherThreadMessagesMap[msgId];
            if (!msg) return;
            const textToCopy = msg.text || (msg.attachment ? msg.attachment.url : '');
            if (!textToCopy) return;

            navigator.clipboard.writeText(textToCopy).then(() => {
                const icon = document.getElementById('teacher-copy-icon-' + msgId);
                if (icon) {
                    const orig = icon.textContent;
                    icon.textContent = 'check';
                    icon.classList.add('text-emerald-500');
                    setTimeout(() => {
                        icon.textContent = orig;
                        icon.classList.remove('text-emerald-500');
                    }, 1500);
                }
            }).catch(err => {
                console.error('Copy failed:', err);
            });
        }
        window.copyTeacherMessageContent = copyTeacherMessageContent;

        function initiateTeacherReply(msgId, senderName, text, fileType) {
            currentTeacherReplyTo = { messageId: msgId, senderName, text, fileType };
            const bar = document.getElementById('teacher-reply-preview-bar');
            const nameEl = document.getElementById('teacher-reply-sender-name');
            const textEl = document.getElementById('teacher-reply-text-preview');
            if (nameEl) nameEl.textContent = senderName;
            if (textEl) textEl.textContent = text || (fileType ? `[${fileType}]` : 'Attachment');
            if (bar) bar.classList.remove('hidden');

            const input = document.getElementById('teacher-msg-input');
            if (input) input.focus();
        }
        window.initiateTeacherReply = initiateTeacherReply;

        function cancelTeacherReply() {
            currentTeacherReplyTo = null;
            const bar = document.getElementById('teacher-reply-preview-bar');
            if (bar) bar.classList.add('hidden');
        }
        window.cancelTeacherReply = cancelTeacherReply;

        async function deleteTeacherMessage(msgId, type) {
            if (!msgId) return;
            if (type === 'for_everyone') {
                if (!confirm('Delete this message for everyone in this conversation?')) return;
            }

            try {
                const res = await fetch('/api/messages/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: msgId, type })
                });
                const data = await res.json();
                if (data.success) {
                    await loadThreadMessages(false);
                } else {
                    alert(data.error || 'Failed to delete message');
                }
            } catch (e) {
                console.error('Delete error:', e);
            }
        }
        window.deleteTeacherMessage = deleteTeacherMessage;

        function scrollToTeacherMessage(msgId) {
            const el = document.getElementById('teacher-msg-' + msgId);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('bg-amber-100/60', 'dark:bg-amber-950/40', 'ring-2', 'ring-amber-400');
                setTimeout(() => {
                    el.classList.remove('bg-amber-100/60', 'dark:bg-amber-950/40', 'ring-2', 'ring-amber-400');
                }, 2200);
            }
        }
        window.scrollToTeacherMessage = scrollToTeacherMessage;

        async function toggleTeacherPinMessage(msgId) {
            if (!msgId) return;
            try {
                const res = await fetch('/api/messages/toggle-pin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: msgId })
                });
                const data = await res.json();
                if (data.success) {
                    await loadThreadMessages(false);
                }
            } catch (err) {
                console.error('Failed to toggle pin:', err);
            }
        }
        window.toggleTeacherPinMessage = toggleTeacherPinMessage;

        async function sendTeacherMessage(e) {
            if (e && e.preventDefault) e.preventDefault();
            const input = document.getElementById('teacher-msg-input');
            const btn = document.getElementById('teacher-send-btn');
            const text = input ? input.value.trim() : '';

            if ((!text && !stagedTeacherAttachment) || !activeStudentId) return;

            if (input) input.value = '';
            if (btn) btn.disabled = true;

            const replyPayload = currentTeacherReplyTo;
            cancelTeacherReply();

            try {
                let res;
                if (stagedTeacherAttachment) {
                    const formData = new FormData();
                    formData.append('targetUserId', activeStudentId);
                    if (text) formData.append('text', text);
                    formData.append('file', stagedTeacherAttachment.file, stagedTeacherAttachment.fileName);
                    if (stagedTeacherAttachment.duration) formData.append('duration', stagedTeacherAttachment.duration);
                    if (replyPayload) formData.append('replyTo', JSON.stringify(replyPayload));

                    res = await fetch('/api/messages/send', {
                        method: 'POST',
                        body: formData
                    });
                    clearTeacherStagedAttachment();
                } else {
                    res = await fetch('/api/messages/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            targetUserId: activeStudentId,
                            text,
                            replyTo: replyPayload
                        })
                    });
                }

                const data = await res.json();
                if (data.success) {
                    await loadThreadMessages(true);
                } else {
                    alert(data.error || 'Failed to send message.');
                }
            } catch (err) {
                console.error('Failed to send teacher message:', err);
            } finally {
                if (btn) btn.disabled = false;
                if (input) input.focus();
            }
        }
        window.sendTeacherMessage = sendTeacherMessage;

        function escapeHtml(unsafe) {
            return (unsafe || '')
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        if (activeStudentId) {
            loadThreadMessages(true);
            pollTimer = setInterval(() => loadThreadMessages(false), 3000);
        }
    </script>
</body>
</html>
