<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Written Exam Evaluations | Teacher ODDHAY</title>

    <style>
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'written-evaluations' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Written Exam Evaluations' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-20 sm:pb-24 lg:pb-0">
                
                <!-- ALERTS / NOTICES (ATTACHED WITH BORDER) -->
                <% if (successMsg) { %>
                    <div class="px-4 sm:px-6 py-2.5 bg-emerald-50 dark:bg-emerald-950/30 border-b border-emerald-200 dark:border-emerald-800/60 text-xs font-medium text-emerald-800 dark:text-emerald-300 flex items-center gap-2">
                        <span class="material-symbols-rounded text-base text-emerald-600">check_circle</span>
                        <span><%= successMsg %></span>
                    </div>
                <% } %>
                <% if (errorMsg) { %>
                    <div class="px-4 sm:px-6 py-2.5 bg-rose-50 dark:bg-rose-950/30 border-b border-rose-200 dark:border-rose-800/60 text-xs font-medium text-rose-800 dark:text-rose-300 flex items-center gap-2">
                        <span class="material-symbols-rounded text-base text-rose-600">error</span>
                        <span><%= errorMsg %></span>
                    </div>
                <% } %>

                <!-- SECTION 1: STATS OVERVIEW SECTION (COMPACT 3-CARD ROW ON MOBILE & DESKTOP) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                    <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5">
                        
                        <!-- Pending Evaluation Card -->
                        <a href="/teacher/written-evaluations?status=pending&subject=<%= subjectFilter %>&class=<%= classFilter %>" 
                           class="p-2 sm:p-2.5 rounded-xl bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200/70 dark:border-amber-800/40 hover:border-amber-300 transition-all flex flex-col justify-between cursor-pointer active:scale-95 shadow-2xs">
                            <div class="flex items-center justify-between gap-1">
                                <span class="text-[10px] sm:text-xs font-bold text-amber-700 dark:text-amber-400 truncate">Pending</span>
                                <span class="material-symbols-rounded text-sm sm:text-base text-amber-600 dark:text-amber-400 shrink-0">pending_actions</span>
                            </div>
                            <div class="text-base sm:text-2xl font-black text-slate-900 dark:text-white mt-1">
                                <%= pendingCount %>
                            </div>
                            <span class="text-[9px] sm:text-[10px] text-amber-600/80 dark:text-amber-400/80 font-medium truncate">Needs Review</span>
                        </a>

                        <!-- Evaluations Completed Card -->
                        <a href="/teacher/written-evaluations?status=reviewed&subject=<%= subjectFilter %>&class=<%= classFilter %>" 
                           class="p-2 sm:p-2.5 rounded-xl bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-200/70 dark:border-emerald-800/40 hover:border-emerald-300 transition-all flex flex-col justify-between cursor-pointer active:scale-95 shadow-2xs">
                            <div class="flex items-center justify-between gap-1">
                                <span class="text-[10px] sm:text-xs font-bold text-emerald-700 dark:text-emerald-400 truncate">Reviewed</span>
                                <span class="material-symbols-rounded text-sm sm:text-base text-emerald-600 dark:text-emerald-400 shrink-0">task_alt</span>
                            </div>
                            <div class="text-base sm:text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">
                                <%= reviewedCount %>
                            </div>
                            <span class="text-[9px] sm:text-[10px] text-emerald-600/80 dark:text-emerald-400/80 font-medium truncate">Completed</span>
                        </a>

                        <!-- Total Submissions Card -->
                        <a href="/teacher/written-evaluations?status=all&subject=<%= subjectFilter %>&class=<%= classFilter %>" 
                           class="p-2 sm:p-2.5 rounded-xl bg-cyan-50/60 dark:bg-cyan-950/20 border border-cyan-200/70 dark:border-cyan-800/40 hover:border-cyan-300 transition-all flex flex-col justify-between cursor-pointer active:scale-95 shadow-2xs">
                            <div class="flex items-center justify-between gap-1">
                                <span class="text-[10px] sm:text-xs font-bold text-cyan-700 dark:text-cyan-400 truncate">Total</span>
                                <span class="material-symbols-rounded text-sm sm:text-base text-cyan-600 dark:text-cyan-400 shrink-0">rate_review</span>
                            </div>
                            <div class="text-base sm:text-2xl font-black text-cyan-600 dark:text-cyan-400 mt-1">
                                <%= totalCount %>
                            </div>
                            <span class="text-[9px] sm:text-[10px] text-cyan-600/80 dark:text-cyan-400/80 font-medium truncate">All Exams</span>
                        </a>

                    </div>
                </div>

                <!-- SECTION 2: STICKY FILTERS BAR (RESPONSIVE) -->
                <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-3 sm:px-6 py-2 sm:py-2.5 border-b border-slate-200 dark:border-slate-800 shadow-2xs space-y-2">
                    <form method="GET" action="/teacher/written-evaluations" class="w-full flex flex-col gap-2">
                        
                        <!-- ROW 1: STATUS TABS -->
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <div class="flex items-center gap-1 p-1 bg-slate-100/90 dark:bg-slate-800/90 rounded-xl">
                                <a href="/teacher/written-evaluations?status=pending&subject=<%= subjectFilter %>&class=<%= classFilter %>&q=<%= encodeURIComponent(searchQuery) %>" 
                                   class="px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold transition-all <%= statusFilter === 'pending' ? 'bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                    Pending (<%= pendingCount %>)
                                </a>
                                <a href="/teacher/written-evaluations?status=reviewed&subject=<%= subjectFilter %>&class=<%= classFilter %>&q=<%= encodeURIComponent(searchQuery) %>" 
                                   class="px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold transition-all <%= statusFilter === 'reviewed' ? 'bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                    Reviewed (<%= reviewedCount %>)
                                </a>
                                <a href="/teacher/written-evaluations?status=all&subject=<%= subjectFilter %>&class=<%= classFilter %>&q=<%= encodeURIComponent(searchQuery) %>" 
                                   class="px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold transition-all <%= statusFilter === 'all' ? 'bg-white dark:bg-slate-900 text-primary shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                    All (<%= totalCount %>)
                                </a>
                            </div>

                            <% if (statusFilter !== 'pending' || subjectFilter !== 'all' || classFilter !== 'all' || searchQuery) { %>
                                <a href="/teacher/written-evaluations" class="text-[11px] font-semibold text-rose-500 hover:text-rose-600 flex items-center gap-0.5 ml-auto">
                                    <span class="material-symbols-rounded text-sm">restart_alt</span>
                                    <span>Reset</span>
                                </a>
                            <% } %>
                        </div>

                        <!-- ROW 2: SEARCH & DROPDOWNS IN ONE ROW ON SMALL SCREEN -->
                        <div class="grid grid-cols-2 sm:flex sm:items-center gap-1.5 sm:gap-2">
                            <input type="hidden" name="status" value="<%= statusFilter %>">

                            <!-- Search Input -->
                            <div class="relative col-span-2 sm:flex-1 sm:max-w-xs">
                                <input type="text" name="q" value="<%= searchQuery %>" placeholder="Search exam title or subject..." 
                                       class="w-full pl-8 pr-3 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 focus:outline-hidden focus:border-primary transition-colors">
                                <span class="material-symbols-rounded text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 text-sm leading-none pointer-events-none">search</span>
                            </div>

                            <!-- Subject Filter -->
                            <% const filterSubjects = (!isUnrestricted && assignedSubjects && assignedSubjects.length > 0) ? assignedSubjects : availableSubjects; %>
                            <% if (filterSubjects && filterSubjects.length > 0) { %>
                                <div class="col-span-1 sm:w-36">
                                    <select name="subject" onchange="this.form.submit()" class="w-full px-2.5 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 focus:outline-hidden focus:border-primary cursor-pointer truncate">
                                        <option value="all" <%= subjectFilter === 'all' ? 'selected' : '' %>>All Subjects</option>
                                        <% filterSubjects.forEach(sub => { %>
                                            <option value="<%= sub %>" <%= subjectFilter.toLowerCase() === sub.toLowerCase() ? 'selected' : '' %>><%= sub %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            <% } %>

                            <!-- Class Filter -->
                            <% const filterClasses = (!isUnrestricted && assignedClasses && assignedClasses.length > 0) ? assignedClasses : availableClasses; %>
                            <% if (filterClasses && filterClasses.length > 0) { %>
                                <div class="col-span-1 sm:w-32">
                                    <select name="class" onchange="this.form.submit()" class="w-full px-2.5 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 focus:outline-hidden focus:border-primary cursor-pointer truncate">
                                        <option value="all" <%= classFilter === 'all' ? 'selected' : '' %>>All Classes</option>
                                        <% filterClasses.forEach(cls => { %>
                                            <option value="<%= cls %>" <%= classFilter.toLowerCase() === cls.toLowerCase() ? 'selected' : '' %>><%= cls %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            <% } %>
                        </div>

                    </form>
                </div>
                <!-- SECTION 3: SUBMISSIONS LIST SECTION (ATTACHED WITH BORDERS & DIVIDERS LIKE SUPERADMIN) -->
                <div class="bg-white dark:bg-[#0f172a] flex flex-col flex-1 border-b border-slate-200 dark:border-slate-800">
                    
                    <% 
                       const strictlyAssignedAttempts = attempts;
                    %>

                    <% if (strictlyAssignedAttempts.length === 0) { %>
                        <div class="p-16 text-center space-y-3">
                            <span class="material-symbols-rounded text-5xl text-slate-300 dark:text-slate-700 leading-none mx-auto">rate_review</span>
                            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">
                                <% if (statusFilter === 'pending') { %>
                                    No Pending Written Evaluations
                                <% } else if (statusFilter === 'reviewed') { %>
                                    No Reviewed Evaluations Found
                                <% } else { %>
                                    No Written Exam Submissions Found
                                <% } %>
                            </h3>
                            <p class="text-xs text-slate-400 max-w-md mx-auto">
                                <% if (statusFilter === 'pending') { %>
                                    All student written submissions under your assigned classes and subjects have been evaluated. Great job!
                                <% } else { %>
                                    When students complete exams containing written questions matching your assigned classes and subjects, they will appear here.
                                <% } %>
                            </p>
                        </div>
                    <% } else { %>
                        <!-- MOBILE CARDS VIEW (Clean, touch-friendly on small screens < lg) -->
                        <div class="block lg:hidden divide-y divide-slate-100 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a]">
                            <% strictlyAssignedAttempts.forEach(function(att) { %>
                                <%
                                   const student = att.user || {};
                                   const bank = att.bank || {};
                                   const isReviewed = att.writtenStatus === 'reviewed';
                                   const userAnswers = att.userAnswers || [];
                                   const writtenAnswers = userAnswers.filter(u => u.questionType !== 'MCQ');

                                   let writtenEarned = 0;
                                   let writtenMax = 0;
                                   if (att.teacherReview && typeof att.teacherReview.totalWrittenScore === 'number') {
                                       writtenEarned = att.teacherReview.totalWrittenScore;
                                       writtenMax = att.teacherReview.maxWrittenScore || writtenAnswers.reduce((sum, u) => sum + (u.maxMarks || 5), 0);
                                   } else {
                                       writtenAnswers.forEach(u => {
                                           writtenEarned += (u.marksObtained || 0);
                                           writtenMax += (u.maxMarks || 5);
                                       });
                                   }

                                   const subDate = att.submittedAt ? new Date(att.submittedAt) : new Date();
                                   const formattedSubDate = subDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });

                                   const boardName = bank.board ? (String(bank.board).toLowerCase().includes('board') ? bank.board : bank.board + ' Board') : '';
                                   const displayTitle = (bank.title && bank.title.trim()) 
                                       || [bank.subject, bank.topic, boardName, bank.year].filter(Boolean).map(s => String(s).trim()).filter(Boolean).join(' - ')
                                       || (bank.subject ? bank.subject + ' Written Exam' : 'Written Exam');

                                   let rowSub = bank.displaySubject || bank.subject || 'Subject';
                                   const rsLower = String(rowSub).toLowerCase().trim();
                                   if (rsLower.includes('bangla') || rsLower.includes('bengali')) rowSub = 'Bangla';
                                   else if (rsLower.includes('english')) rowSub = 'English';
                                   else if (rsLower.includes('math')) rowSub = 'Math';

                                   const rowCls = Array.isArray(bank.classLevel) ? bank.classLevel.join(', ') : (bank.classLevel || student.classLevel || 'General');
                                %>
                                <div class="p-3 sm:p-4 space-y-2.5">
                                    <!-- Student Profile & Status Header -->
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="size-9 rounded-xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center font-bold text-xs shrink-0 overflow-hidden shadow-2xs">
                                                <% if (student.profilePicture || student.profileImage) { %>
                                                    <img src="<%= student.profilePicture || student.profileImage %>" alt="Avatar" class="size-full object-cover">
                                                <% } else { %>
                                                    <span><%= (student.name || 'S')[0].toUpperCase() %></span>
                                                <% } %>
                                            </div>
                                            <div class="min-w-0">
                                                <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                                                    <%= student.name || 'Student' %>
                                                </h4>
                                                <div class="flex items-center gap-1.5 mt-0.5 text-[10px] text-slate-400">
                                                    <span class="px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold"><%= rowCls %></span>
                                                    <span>&bull;</span>
                                                    <span class="text-cyan-600 dark:text-cyan-400 font-medium"><%= rowSub %></span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Status Badge -->
                                        <% if (isReviewed) { %>
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60 shrink-0">
                                                Reviewed &bull; <%= writtenEarned %>/<%= writtenMax %>
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/60 shrink-0">
                                                Pending Review
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Exam Info Box -->
                                    <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800/80 space-y-1">
                                        <h5 class="text-xs font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">
                                            <%= displayTitle %>
                                        </h5>
                                        <div class="flex items-center justify-between text-[10px] text-slate-400">
                                            <span><%= writtenAnswers.length %> Written Qs</span>
                                            <span>Submitted: <%= formattedSubDate %></span>
                                        </div>
                                    </div>

                                    <!-- Action Button -->
                                    <div>
                                        <a href="/teacher/written-evaluations/<%= att._id %>" 
                                           class="w-full text-center py-2 px-3 rounded-xl text-xs font-bold transition-all shadow-xs active:scale-95 flex items-center justify-center gap-1.5 <%= isReviewed ? 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 border border-slate-200/80 dark:border-slate-700' : 'bg-primary hover:bg-primary-dark text-white shadow-primary/20' %>">
                                            <span class="material-symbols-rounded text-sm"><%= isReviewed ? 'edit_note' : 'rate_review' %></span>
                                            <span><%= isReviewed ? 'Update Evaluation' : 'Evaluate Submission' %></span>
                                        </a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>

                        <!-- DESKTOP TABLE VIEW (Kept strictly on lg+ screens) -->
                        <div class="hidden lg:block w-full overflow-x-auto">
                            <table class="w-full text-left border-collapse table-fixed min-w-[760px]">
                                <colgroup>
                                    <col class="w-auto">
                                    <col class="w-28 sm:w-32">
                                    <col class="w-28 sm:w-32">
                                    <col class="w-44 sm:w-48">
                                    <col class="w-32 sm:w-36">
                                </colgroup>
                                <thead>
                                    <tr class="bg-slate-50/70 dark:bg-slate-900/70 border-b border-slate-200 dark:border-slate-800 text-[10.5px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                        <th class="px-4 sm:px-6 py-2.5 text-left">Exam Details</th>
                                        <th class="px-3 py-2.5 text-center">Subject</th>
                                        <th class="px-3 py-2.5 text-center">Class</th>
                                        <th class="px-3 py-2.5 text-center">Score & Status</th>
                                        <th class="px-4 sm:px-6 py-2.5 text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 bg-white dark:bg-[#0f172a]">
                                    <% strictlyAssignedAttempts.forEach(function(att) { %>
                                        <%
                                           const student = att.user || {};
                                           const bank = att.bank || {};
                                           const isReviewed = att.writtenStatus === 'reviewed';
                                           const userAnswers = att.userAnswers || [];
                                           const writtenAnswers = userAnswers.filter(u => u.questionType !== 'MCQ');

                                           let writtenEarned = 0;
                                           let writtenMax = 0;
                                           if (att.teacherReview && typeof att.teacherReview.totalWrittenScore === 'number') {
                                               writtenEarned = att.teacherReview.totalWrittenScore;
                                               writtenMax = att.teacherReview.maxWrittenScore || writtenAnswers.reduce((sum, u) => sum + (u.maxMarks || 5), 0);
                                           } else {
                                               writtenAnswers.forEach(u => {
                                                   writtenEarned += (u.marksObtained || 0);
                                                   writtenMax += (u.maxMarks || 5);
                                               });
                                           }

                                           const subDate = att.submittedAt ? new Date(att.submittedAt) : new Date();
                                           const formattedSubDate = subDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + subDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

                                           const boardName = bank.board ? (String(bank.board).toLowerCase().includes('board') ? bank.board : bank.board + ' Board') : '';
                                           const displayTitle = (bank.title && bank.title.trim()) 
                                               || [bank.subject, bank.topic, boardName, bank.year].filter(Boolean).map(s => String(s).trim()).filter(Boolean).join(' - ')
                                               || (bank.subject ? bank.subject + ' Written Exam' : 'Written Exam');

                                           let rowSub = bank.displaySubject || bank.subject || 'Subject';
                                           const rsLower = String(rowSub).toLowerCase().trim();
                                           if (rsLower.includes('bangla') || rsLower.includes('bengali')) rowSub = 'Bangla';
                                           else if (rsLower.includes('english')) rowSub = 'English';
                                           else if (rsLower.includes('math')) rowSub = 'Math';
                                        %>

                                        <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors group">
                                            
                                            <!-- EXAM INFO & USER AVATAR -->
                                            <td class="px-4 sm:px-6 py-3.5 align-middle">
                                                <div class="flex items-center gap-3.5 min-w-0">
                                                    <div class="size-10 rounded-xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center font-bold text-xs shrink-0 overflow-hidden shadow-2xs" title="Student: <%= student.name || 'Student' %>">
                                                        <% if (student.profilePicture || student.profileImage) { %>
                                                            <img src="<%= student.profilePicture || student.profileImage %>" alt="Avatar" class="size-full object-cover">
                                                        <% } else { %>
                                                            <span><%= (student.name || 'S')[0].toUpperCase() %></span>
                                                        <% } %>
                                                    </div>

                                                    <div class="space-y-1 min-w-0 flex-1">
                                                        <h4 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 truncate" title="<%= displayTitle %>">
                                                            <%= displayTitle %>
                                                        </h4>

                                                        <div class="flex items-center gap-2 flex-wrap text-[11px] text-slate-500 dark:text-slate-400 font-normal">
                                                            <span class="font-medium text-slate-800 dark:text-slate-200 inline-flex items-center gap-1">
                                                                <span class="material-symbols-rounded text-xs text-cyan-600 dark:text-cyan-400">person</span>
                                                                <%= student.name || 'Student' %>
                                                            </span>
                                                            <span>•</span>
                                                            <span>Submitted: <%= formattedSubDate %></span>
                                                            <span>•</span>
                                                            <span><%= writtenAnswers.length %> Written <%= writtenAnswers.length === 1 ? 'Question' : 'Questions' %></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- SUBJECT COLUMN -->
                                            <td class="px-3 py-3.5 text-center align-middle">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-300 border border-cyan-200/80 dark:border-cyan-800/60 truncate max-w-[110px]">
                                                    <%= rowSub %>
                                                </span>
                                            </td>

                                            <!-- CLASS COLUMN -->
                                            <td class="px-3 py-3.5 text-center align-middle">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 truncate max-w-[110px]">
                                                    <%= Array.isArray(bank.classLevel) ? bank.classLevel.join(', ') : (bank.classLevel || student.classLevel || 'Class 9') %>
                                                </span>
                                            </td>

                                            <!-- SCORES & STATUS COLUMN -->
                                            <td class="px-3 py-3.5 text-center align-middle">
                                                <div class="flex flex-col items-center justify-center gap-1">
                                                    <% if (isReviewed) { %>
                                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5 shadow-2xs">
                                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                            <span>Reviewed</span>
                                                        </span>
                                                        <span class="text-[11px] text-slate-400 font-normal">
                                                            Score: <strong class="text-emerald-600 dark:text-emerald-400 font-semibold"><%= writtenEarned %></strong> / <%= writtenMax %>
                                                        </span>
                                                    <% } else { %>
                                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center gap-1.5 shadow-2xs">
                                                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                            <span>Pending Review</span>
                                                        </span>
                                                        <span class="text-[11px] text-slate-400 font-normal">
                                                            Max Marks: <%= writtenMax %>
                                                        </span>
                                                    <% } %>
                                                </div>
                                            </td>

                                            <!-- ACTION BUTTON COLUMN -->
                                            <td class="px-4 sm:px-6 py-3.5 text-right align-middle">
                                                <a href="/teacher/written-evaluations/<%= att._id %>" 
                                                   class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all shadow-2xs <%= isReviewed ? 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700' : 'bg-cyan-600 hover:bg-cyan-500 text-white shadow-xs active:scale-95' %>">
                                                    <span class="material-symbols-rounded text-sm leading-none">
                                                        <%= isReviewed ? 'edit_note' : 'rate_review' %>
                                                    </span>
                                                    <span><%= isReviewed ? 'Edit Review' : 'Evaluate' %></span>
                                                </a>
                                            </td>

                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>

                    <!-- SECTION 4: PAGINATION FOOTER (PERFECTLY ATTACHED AT BOTTOM) -->
                    <% if (totalPages > 1) { %>
                        <div class="px-4 sm:px-6 py-3 bg-white dark:bg-[#0f172a] border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs">
                            <div class="text-slate-500 font-normal">
                                Showing page <%= page %> of <%= totalPages %>
                            </div>
                            <div class="flex items-center gap-2">
                                <% if (page > 1) { %>
                                    <a href="/teacher/written-evaluations?page=<%= page - 1 %>&status=<%= statusFilter %>&subject=<%= subjectFilter %>&class=<%= classFilter %>&q=<%= encodeURIComponent(searchQuery) %>" 
                                       class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 transition-all">
                                        Previous
                                    </a>
                                <% } %>
                                <% if (page < totalPages) { %>
                                    <a href="/teacher/written-evaluations?page=<%= page + 1 %>&status=<%= statusFilter %>&subject=<%= subjectFilter %>&class=<%= classFilter %>&q=<%= encodeURIComponent(searchQuery) %>" 
                                       class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 transition-all">
                                        Next
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                </div>

            </div>
            <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>
</body>
</html>
