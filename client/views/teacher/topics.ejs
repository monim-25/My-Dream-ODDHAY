<%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { name: 'Teacher', role: 'teacher', theme: 'light' };
    const safeClasses = (typeof classes !== 'undefined' && Array.isArray(classes)) ? classes : [];
    const safeChapters = (typeof chapters !== 'undefined' && Array.isArray(chapters)) ? chapters : [];
    const safeActiveTopics = (typeof activeTopics !== 'undefined' && Array.isArray(activeTopics)) ? activeTopics : [];
    const safePendingTopics = (typeof myPendingTopics !== 'undefined' && Array.isArray(myPendingTopics)) ? myPendingTopics : [];
    const safeRejectedTopics = (typeof myRejectedTopics !== 'undefined' && Array.isArray(myRejectedTopics)) ? myRejectedTopics : [];
    const safeApprovedTopics = (typeof myApprovedTopics !== 'undefined' && Array.isArray(myApprovedTopics)) ? myApprovedTopics : [];
    const safeSubmissions = (typeof mySubmissions !== 'undefined' && Array.isArray(mySubmissions)) ? mySubmissions : [];
    const safeSubmissionChapters = (typeof mySubmissionChapters !== 'undefined' && Array.isArray(mySubmissionChapters)) ? mySubmissionChapters : [];
    const selClass = (typeof selectedClass !== 'undefined') ? selectedClass : '';
    const selGroup = (typeof selectedGroup !== 'undefined') ? selectedGroup : 'all';
    const selSubject = (typeof selectedSubject !== 'undefined') ? selectedSubject : '';
    const availSubjects = (typeof availableSubjects !== 'undefined' && Array.isArray(availableSubjects)) ? availableSubjects : [];
    const safeCurrentClass = (typeof currentClassObj !== 'undefined' && currentClassObj) ? currentClassObj : (safeClasses.find(c => ((c && c.name) ? c.name : String(c || '')).toLowerCase() === String(selClass || '').toLowerCase()) || null);
    const safeApiBase = (typeof apiBase !== 'undefined') ? apiBase : '/teacher';
%>
<!DOCTYPE html>
<html lang="en" class="<%= (safeUser.theme === 'dark') ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Syllabus & Topics Studio | ODDHAY Teacher Portal</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); }
            .admin-sidebar.active, #adminSidebar.active { transform: translateX(0); }
            .admin-main { margin-left: 0; width: 100%; }
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased overflow-hidden">

    <!-- Mobile Drawer Backdrop -->
    <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

    <div class="flex h-full">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'topics' }) %>
        </aside>

        <!-- Main Content Area -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] flex flex-col min-h-screen relative w-full">
            <%- include('header', { pageTitle: 'Syllabus & Topics Studio' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 flex-1">
                
                <!-- 1. Sticky Action Bar -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 px-3 sm:px-4 py-2.5 flex items-center justify-between gap-2.5 sticky top-0 z-30 shadow-xs">
                    <!-- Tab Switcher -->
                    <div class="flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-md border border-slate-200 dark:border-slate-700/60 overflow-x-auto no-scrollbar">
                        <button type="button" id="tabLiveBtn" onclick="switchTeacherTab('live')"
                                class="px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs shrink-0 whitespace-nowrap">
                            <span class="material-symbols-rounded text-[17px]">account_tree</span>
                            <span class="hidden xs:inline">Live Syllabus</span>
                            <span class="xs:hidden">Live</span>
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-primary/10 text-primary font-bold leading-none"><%= safeActiveTopics.length %></span>
                        </button>
                        <button type="button" id="tabSubmissionsBtn" onclick="switchTeacherTab('submissions')"
                                class="px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white shrink-0 whitespace-nowrap">
                            <span class="material-symbols-rounded text-[17px]">send_and_archive</span>
                            <span class="hidden xs:inline">My Submissions</span>
                            <span class="xs:hidden">Submissions</span>
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] <%= safePendingTopics.length > 0 ? 'bg-amber-500 text-white font-bold' : 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300' %> leading-none"><%= safePendingTopics.length %></span>
                        </button>
                    </div>

                    <!-- Right Action Button: Add Topics -->
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" onclick="openUnifiedModal()"
                                class="h-8 sm:h-9 px-2.5 sm:px-3.5 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-medium flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all">
                            <span class="material-symbols-rounded text-[17px] sm:text-[18px]">add</span>
                            <span class="hidden xs:inline">Add Topics</span>
                            <span class="xs:hidden">Add</span>
                        </button>
                    </div>
                </div>

                <!-- 2. LIVE SYLLABUS DUAL-PANE VIEW -->
                <div id="liveTopicsView" class="p-3 sm:p-4 flex-1">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
                        
                        <!-- Left Rail: Academic Class & Subject Filter Rail -->
                        <div class="lg:col-span-4 xl:col-span-3 space-y-3">
                            <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 p-3.5 shadow-xs space-y-3">
                                <div>
                                    <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block mb-1">
                                        Assigned Class (<%= safeClasses.length %>)
                                    </label>
                                    <% if (safeClasses.length === 0) { %>
                                        <div class="p-2.5 bg-amber-50 dark:bg-amber-950/20 rounded border border-amber-200/80 dark:border-amber-800/60 text-[11px] text-amber-700 dark:text-amber-300">
                                            No classes assigned to your profile.
                                        </div>
                                    <% } else { %>
                                        <select id="classSelector" onchange="onClassChange(this.value)" class="w-full h-9 px-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-white outline-none focus:border-primary">
                                            <% safeClasses.forEach(c => { %>
                                                <option value="<%= c.name %>" <%= c.name.toLowerCase() === selClass.toLowerCase() ? 'selected' : '' %>>
                                                    <%= c.name %> <%= c.hasGroups ? '(Grouped)' : '' %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    <% } %>
                                </div>

                                <!-- Stream / Group Filter if class has groups -->
                                <% if (safeCurrentClass && safeCurrentClass.hasGroups) { %>
                                    <div>
                                        <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block mb-1">
                                            Stream / Group
                                        </label>
                                        <div class="grid grid-cols-2 gap-1.5">
                                            <button type="button" onclick="onGroupChange('all')"
                                                    class="px-2.5 py-1.5 rounded text-[11px] font-medium transition-all border <%= selGroup === 'all' ? 'bg-primary/10 text-primary border-primary/30 font-semibold' : 'bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800' %>">
                                                All Groups
                                            </button>
                                            <button type="button" onclick="onGroupChange('Science')"
                                                    class="px-2.5 py-1.5 rounded text-[11px] font-medium transition-all border <%= selGroup === 'Science' ? 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30 font-semibold' : 'bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800' %>">
                                                Science
                                            </button>
                                            <button type="button" onclick="onGroupChange('Commerce')"
                                                    class="px-2.5 py-1.5 rounded text-[11px] font-medium transition-all border <%= selGroup === 'Commerce' ? 'bg-amber-500/10 text-amber-600 border-amber-500/30 font-semibold' : 'bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800' %>">
                                                Commerce
                                            </button>
                                            <button type="button" onclick="onGroupChange('Humanities')"
                                                    class="px-2.5 py-1.5 rounded text-[11px] font-medium transition-all border <%= selGroup === 'Humanities' ? 'bg-purple-500/10 text-purple-600 border-purple-500/30 font-semibold' : 'bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800' %>">
                                                Humanities
                                            </button>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Subject Rail -->
                                <div>
                                    <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block mb-1">
                                        Assigned Subjects (<%= availSubjects.length %>)
                                    </label>
                                    <div class="space-y-1 max-h-[380px] overflow-y-auto pr-1">
                                        <% if (availSubjects.length === 0) { %>
                                            <p class="text-xs text-slate-400 py-2 italic">No subjects configured for this class.</p>
                                        <% } else { %>
                                            <% availSubjects.forEach(sub => { 
                                                const isCurrent = sub.toLowerCase() === selSubject.toLowerCase();
                                            %>
                                                <button type="button" onclick="onSubjectChange('<%= sub %>')"
                                                        class="w-full text-left px-3 py-2 rounded-md text-xs transition-all flex items-center justify-between border <%= isCurrent ? 'bg-primary text-white border-primary shadow-xs font-semibold' : 'bg-slate-50/50 dark:bg-slate-900/50 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200/80 dark:border-slate-800 font-medium' %>">
                                                    <span class="truncate"><%= sub %></span>
                                                    <span class="material-symbols-rounded text-sm <%= isCurrent ? 'text-white' : 'text-slate-400' %>">chevron_right</span>
                                                </button>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Info Card -->
                            <div class="bg-blue-50/50 dark:bg-blue-950/20 rounded-md border border-blue-200/50 dark:border-blue-900/40 p-3 space-y-1 text-xs text-blue-900 dark:text-blue-300">
                                <div class="font-medium flex items-center gap-1 text-primary">
                                    <span class="material-symbols-rounded text-base">info</span>
                                    <span>Teacher Submission Notice</span>
                                </div>
                                <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                                    আপনার যুক্ত করা নতুন টপিকসমূহ অ্যাডমিনের রিভিউ ও অ্যাপ্রুভালের পর সরাসরি লাইভ সিলেবাসে অন্তর্ভুক্ত হবে।
                                </p>
                            </div>
                        </div>

                        <!-- Right Column: Chapters & Topics Canvas -->
                        <div class="lg:col-span-8 xl:col-span-9 space-y-3">
                            
                            <!-- Context Banner -->
                            <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 px-4 py-3 flex flex-wrap items-center justify-between gap-3 shadow-xs">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded bg-primary/10 text-primary text-[11px] font-semibold"><%= selClass || 'All Classes' %></span>
                                        <% if (selGroup && selGroup !== 'all') { %>
                                            <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 text-[11px] font-medium"><%= selGroup %></span>
                                        <% } %>
                                        <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                                            <%= selSubject || 'Select Subject' %>
                                        </h3>
                                    </div>
                                    <p class="text-[11px] text-slate-500 mt-0.5 font-normal">
                                        মোট <%= safeChapters.length %> টি অধ্যায় এবং <%= safeActiveTopics.length %> টি সক্রিয় টপিক রয়েছে।
                                    </p>
                                </div>

                                <!-- Quick Search Inside Subject -->
                                <div class="relative min-w-[220px]">
                                    <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                                    <input type="text" id="topicSearchInput" onkeyup="filterTopicsClientSide(this.value)" placeholder="Search topics in subject..." class="w-full h-8 pl-8 pr-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                                </div>
                            </div>

                            <!-- Chapters Accordion List -->
                            <div id="chaptersContainer" class="space-y-3">
                                <% if (safeClasses.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-amber-500 mb-1">school</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Classes Assigned</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">Your teacher profile does not have any classes assigned. Please contact the administrator.</p>
                                    </div>
                                <% } else if (availSubjects.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-amber-500 mb-1">menu_book</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Subjects Assigned</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">You do not have any teaching subjects assigned for <strong><%= selClass %></strong>.</p>
                                    </div>
                                <% } else if (safeChapters.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-slate-400 mb-1">menu_book</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Chapters or Topics Found</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">Click "Add Topics" above to contribute to syllabus for <%= selSubject %>.</p>
                                    </div>
                                <% } else { %>
                                    <% safeChapters.forEach((ch, chIdx) => { %>
                                        <div class="chapter-card bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-md shadow-xs overflow-hidden" data-chapter-name="<%= ch.name %>">
                                            <!-- Chapter Header -->
                                            <div class="px-3.5 py-2.5 bg-slate-50/70 dark:bg-slate-900/60 border-b border-slate-100 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-2 cursor-pointer select-none" onclick="toggleChapterAccordion('ch_<%= chIdx %>')">
                                                <div class="flex items-center gap-2.5 flex-1 min-w-[240px]">
                                                    <span class="size-6 rounded bg-primary/10 text-primary font-semibold text-xs flex items-center justify-center shrink-0">
                                                        <%= ch.number %>
                                                    </span>
                                                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                                                        <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100 leading-normal m-0 p-0">
                                                            <%= ch.name %>
                                                        </h4>
                                                        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal leading-normal">
                                                            (<%= ch.topics.length %> Topics Assigned)
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-1.5" onclick="event.stopPropagation()">
                                                    <!-- Accordion Chevron -->
                                                    <button type="button" onclick="toggleChapterAccordion('ch_<%= chIdx %>')" class="size-7 rounded hover:bg-slate-200/50 dark:hover:bg-slate-800 flex items-center justify-center text-slate-400" title="Expand / Collapse Chapter">
                                                        <span id="icon_ch_<%= chIdx %>" class="material-symbols-rounded text-base transition-transform">expand_more</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Chapter Topics List -->
                                            <div id="content_ch_<%= chIdx %>" class="p-3 space-y-2">
                                                <% ch.topics.forEach((t, tIdx) => { %>
                                                    <div class="topic-item p-2.5 rounded-md bg-slate-50/50 dark:bg-slate-900/40 border border-slate-200/70 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-2.5 hover:border-primary/40 transition-all select-none" data-topic-name="<%= t.name %>">
                                                        <div class="flex items-start gap-2.5 flex-1 min-w-[240px]">
                                                            <span class="text-slate-400 font-medium text-xs mt-0.5">#<%= t.order || (tIdx + 1) %></span>
                                                            <div>
                                                                <div class="flex items-center gap-2 flex-wrap">
                                                                    <span class="text-xs font-medium text-slate-800 dark:text-slate-100"><%= t.name %></span>
                                                                    <% if (t.code) { %>
                                                                        <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-normal"><%= t.code %></span>
                                                                    <% } %>
                                                                    <% 
                                                                        let diffClass = 'bg-amber-500/10 text-amber-600 border-amber-500/20';
                                                                        if (t.difficulty === 'Easy') diffClass = 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20';
                                                                        if (t.difficulty === 'Hard') diffClass = 'bg-rose-500/10 text-rose-600 border-rose-500/20';
                                                                    %>
                                                                    <span class="text-[9px] font-medium px-1.5 py-0.2 rounded border <%= diffClass %>"><%= t.difficulty || 'Medium' %></span>
                                                                </div>
                                                                <% if (t.description) { %>
                                                                    <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1 font-normal"><%= t.description %></p>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <span class="text-[10px] text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 px-2 py-0.5 rounded font-medium">Live</span>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- 3. MY SUBMISSIONS VIEW (PENDING & FEEDBACK) -->
                <div id="submissionsTopicsView" class="p-3 sm:p-4 hidden space-y-3">
                    <!-- Filter Toolbar -->
                    <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-lg p-2.5 sm:px-3 sm:py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 shadow-xs">
                        <!-- Status Filter Options (Scrollable on small screens) -->
                        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 sm:pb-0 max-w-full -mx-1 px-1 sm:mx-0 sm:px-0" id="submissionFilterTabs">
                            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-1 flex items-center gap-1 shrink-0">
                                <span class="material-symbols-rounded text-[16px]">filter_list</span>
                                Filter:
                            </span>

                            <!-- All Filter Button -->
                            <button type="button" onclick="filterSubmissions('all')" id="filterSubBtn_all"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1.5 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 shadow-xs">
                                <span>All</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20 dark:bg-slate-900/20 font-bold"><%= safeSubmissions.length %></span>
                            </button>

                            <!-- Pending Filter Button -->
                            <button type="button" onclick="filterSubmissions('pending')" id="filterSubBtn_pending"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-amber-500"></span>
                                <span>Pending Approval</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400"><%= safePendingTopics.length %></span>
                            </button>

                            <!-- Needs Revision Filter Button -->
                            <button type="button" onclick="filterSubmissions('rejected')" id="filterSubBtn_rejected"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-rose-500"></span>
                                <span>Needs Revision</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"><%= safeRejectedTopics.length %></span>
                            </button>

                            <!-- Approved Filter Button -->
                            <button type="button" onclick="filterSubmissions('approved')" id="filterSubBtn_approved"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-emerald-500"></span>
                                <span>Approved & Live</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"><%= safeApprovedTopics.length %></span>
                            </button>
                        </div>

                        <!-- Right Actions -->
                        <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
                            <button type="button" onclick="toggleAllSubmissionChapters()" id="btnToggleAllSubChapters" class="h-7 px-2.5 rounded bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs font-medium flex items-center gap-1 shadow-xs transition-colors">
                                <span class="material-symbols-rounded text-sm" id="iconToggleAllSubChapters">unfold_less</span>
                                <span id="textToggleAllSubChapters">Collapse All</span>
                            </button>
                        </div>
                    </div>

                    <% if (safeSubmissionChapters.length === 0) { %>
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 p-10 text-center shadow-xs">
                            <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-2">send_and_archive</span>
                            <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Submissions Found</h4>
                            <p class="text-[11px] text-slate-500 mt-1 max-w-sm mx-auto font-normal">You haven't submitted any chapters or topics yet. Click the "+ Add Topics" button above to submit topics for Admin approval.</p>
                            <button type="button" onclick="openUnifiedModal()" class="mt-3.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-primary hover:bg-primary/90 text-white text-xs font-medium transition-colors shadow-xs">
                                <span class="material-symbols-rounded text-sm">add</span> Add Topics
                            </button>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% safeSubmissionChapters.forEach((ch, sIdx) => { 
                                const chPending = ch.topics.filter(t => t.status === 'pending');
                                const chRejected = ch.topics.filter(t => t.status === 'rejected');
                                const chApproved = ch.topics.filter(t => t.status === 'approved');
                            %>
                                <div class="submission-chapter-card bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 overflow-hidden shadow-xs">
                                    <!-- Chapter Header with Expand / Collapse Accordion -->
                                    <div class="px-3 sm:px-3.5 py-2.5 bg-slate-50/80 dark:bg-slate-900/60 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-2 cursor-pointer select-none" onclick="toggleChapterAccordion('sub_ch_<%= sIdx %>')">
                                        <div class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1">
                                            <span class="size-6 rounded bg-primary/10 text-primary font-semibold text-xs flex items-center justify-center shrink-0">
                                                <%= ch.number || (sIdx + 1) %>
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100 leading-snug break-words m-0 p-0">
                                                    <%= ch.name %>
                                                </h4>
                                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal block sm:inline sm:ml-1">
                                                    (<%= ch.topics.length %> Topics)
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Chapter Status Breakdown & Expand Button -->
                                        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0" onclick="event.stopPropagation()">
                                            <div class="flex items-center gap-1 text-[10px]">
                                                <% if (chPending.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                        <span><%= chPending.length %></span> <span class="hidden sm:inline">Pending</span>
                                                    </span>
                                                <% } %>
                                                <% if (chRejected.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                        <span><%= chRejected.length %></span> <span class="hidden sm:inline">Revision</span>
                                                    </span>
                                                <% } %>
                                                <% if (chApproved.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                        <span><%= chApproved.length %></span> <span class="hidden sm:inline">Live</span>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <!-- Expand / Collapse Chevron Button -->
                                            <button type="button" onclick="toggleChapterAccordion('sub_ch_<%= sIdx %>')" class="size-7 rounded hover:bg-slate-200/50 dark:hover:bg-slate-800 flex items-center justify-center text-slate-400 shrink-0" title="Expand / Collapse Chapter">
                                                <span id="icon_sub_ch_<%= sIdx %>" class="material-symbols-rounded text-base transition-transform duration-200">expand_more</span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Topics Inside Chapter Content (Collapsible) -->
                                    <div id="content_sub_ch_<%= sIdx %>" class="submission-chapter-content transition-all">
                                        <!-- MOBILE CARD VIEW (VISIBLE ON < md SCREENS) -->
                                        <div class="block md:hidden divide-y divide-slate-100 dark:divide-slate-800/60">
                                            <% ch.topics.forEach((t, tIdx) => { 
                                                const diff = (t.difficulty || 'Medium').toLowerCase();
                                                let diffColor = 'text-slate-600 bg-slate-100 dark:bg-slate-800 dark:text-slate-300';
                                                if (diff === 'easy') diffColor = 'text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40';
                                                else if (diff === 'hard') diffColor = 'text-purple-700 bg-purple-50 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40';
                                                else diffColor = 'text-amber-700 bg-amber-50 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40';
                                            %>
                                                <div class="submission-topic-row p-3 space-y-2.5 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-900/30" data-status="<%= t.status %>">
                                                    <!-- Top Line: #, Topic Name & Difficulty -->
                                                    <div class="flex items-start justify-between gap-2">
                                                        <div class="flex items-start gap-2 min-w-0">
                                                            <span class="size-5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono text-[10px] flex items-center justify-center shrink-0 mt-0.5">
                                                                <%= tIdx + 1 %>
                                                            </span>
                                                            <div class="min-w-0">
                                                                <h5 class="text-xs font-semibold text-slate-800 dark:text-slate-100 break-words leading-snug">
                                                                    <%= t.name %>
                                                                </h5>
                                                                <div class="flex items-center gap-1.5 flex-wrap mt-1 text-[10px] text-slate-500 dark:text-slate-400">
                                                                    <span class="inline-block px-1.5 py-0.2 rounded font-medium bg-primary/10 text-primary">
                                                                        <%= t.classLevel || ch.classLevel %>
                                                                    </span>
                                                                    <span>•</span>
                                                                    <span class="font-medium text-slate-600 dark:text-slate-300">
                                                                        <%= t.subject || ch.subject %>
                                                                    </span>
                                                                    <% if (t.group && t.group !== 'all' && t.group !== 'None') { %>
                                                                        <span>•</span>
                                                                        <span class="text-slate-400"><%= t.group %></span>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium shrink-0 <%= diffColor %>">
                                                            <%= t.difficulty || 'Medium' %>
                                                        </span>
                                                    </div>

                                                    <!-- Status & Date -->
                                                    <div class="flex items-center justify-between gap-2 flex-wrap pt-0.5 text-[11px]">
                                                        <div>
                                                            <% if (t.status === 'pending') { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                                    Pending Approval
                                                                </span>
                                                            <% } else if (t.status === 'rejected') { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                                    <span class="material-symbols-rounded text-xs">error</span>
                                                                    Revision Required
                                                                </span>
                                                            <% } else { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                                    <span class="material-symbols-rounded text-xs">check_circle</span>
                                                                    Approved & Live
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <span class="text-slate-400 text-[10px]">
                                                            <%= new Date(t.createdAt).toLocaleDateString() %>
                                                        </span>
                                                    </div>

                                                    <!-- Admin Feedback Box (when rejected) -->
                                                    <% if (t.status === 'rejected') { %>
                                                        <div class="p-2 rounded-md bg-rose-50 dark:bg-rose-950/30 border border-rose-200/80 dark:border-rose-900/50 text-[11px] text-rose-700 dark:text-rose-300 flex items-start gap-1.5">
                                                            <span class="material-symbols-rounded text-xs shrink-0 mt-0.5">feedback</span>
                                                            <div class="min-w-0 flex-1">
                                                                <span class="font-semibold block text-[10px] uppercase tracking-wide text-rose-800 dark:text-rose-200">Admin Feedback:</span>
                                                                <span><%= t.rejectionReason || 'Please review syllabus alignment and resubmit.' %></span>
                                                            </div>
                                                        </div>
                                                    <% } %>

                                                    <!-- Mobile Card Actions Footer -->
                                                    <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800/60">
                                                        <div class="text-[10px] text-slate-400">
                                                            <% if (t.status === 'approved') { %>
                                                                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-medium">
                                                                    <span class="material-symbols-rounded text-xs">verified</span> Live in syllabus
                                                                </span>
                                                            <% } else if (t.status === 'pending') { %>
                                                                <span class="italic">Awaiting Admin review</span>
                                                            <% } %>
                                                        </div>

                                                        <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                            <div class="inline-flex items-center gap-1.5">
                                                                <button type="button" onclick="openUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify(t.name) %>, <%= JSON.stringify(t.subject || ch.subject) %>, '<%= t._id %>')" 
                                                                        class="h-7 px-3 rounded-md bg-primary/10 hover:bg-primary text-primary hover:text-white text-xs font-medium transition-colors inline-flex items-center gap-1">
                                                                    <span class="material-symbols-rounded text-xs">edit</span>
                                                                    <span><%= t.status === 'rejected' ? 'Resubmit' : 'Edit' %></span>
                                                                </button>
                                                                <button type="button" onclick="cancelPendingTopic('<%= t._id %>', <%= JSON.stringify(t.name) %>)" 
                                                                        class="h-7 px-2.5 rounded-md hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 transition-colors inline-flex items-center gap-1 text-xs">
                                                                    <span class="material-symbols-rounded text-xs">delete</span>
                                                                    <span>Delete</span>
                                                                </button>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>

                                        <!-- DESKTOP TABLE VIEW (VISIBLE ON >= md SCREENS) -->
                                        <div class="hidden md:block overflow-x-auto">
                                            <table class="w-full min-w-[760px] text-left text-xs">
                                                <thead class="bg-slate-50/50 dark:bg-slate-900/30 text-slate-400 text-[10px] uppercase font-semibold border-b border-slate-100 dark:border-slate-800/60">
                                                    <tr>
                                                        <th class="py-2 px-3 w-10 text-center">#</th>
                                                        <th class="py-2 px-3">Topic Name</th>
                                                        <th class="py-2 px-3 w-28">Class</th>
                                                        <th class="py-2 px-3 w-32">Subject</th>
                                                        <th class="py-2 px-3 w-24">Difficulty</th>
                                                        <th class="py-2 px-3 w-36">Status</th>
                                                        <th class="py-2 px-3">Admin Feedback / Reason</th>
                                                        <th class="py-2 px-3 w-28">Submitted</th>
                                                        <th class="py-2 px-3 w-24 text-right">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                                                    <% ch.topics.forEach((t, tIdx) => { 
                                                        const diff = (t.difficulty || 'Medium').toLowerCase();
                                                        let diffColor = 'text-slate-600 bg-slate-100 dark:bg-slate-800 dark:text-slate-300';
                                                        if (diff === 'easy') diffColor = 'text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40';
                                                        else if (diff === 'hard') diffColor = 'text-purple-700 bg-purple-50 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40';
                                                        else diffColor = 'text-amber-700 bg-amber-50 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40';
                                                    %>
                                                        <tr class="submission-topic-row hover:bg-slate-50/60 dark:hover:bg-slate-900/40 transition-colors" data-status="<%= t.status %>">
                                                            <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px]">
                                                                <%= tIdx + 1 %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="font-medium text-slate-800 dark:text-slate-100 text-xs">
                                                                    <%= t.name %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-primary/10 text-primary">
                                                                    <%= t.classLevel || ch.classLevel %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="font-medium text-slate-700 dark:text-slate-300 text-xs">
                                                                    <%= t.subject || ch.subject %>
                                                                </span>
                                                                <% if (t.group && t.group !== 'all' && t.group !== 'None') { %>
                                                                    <span class="text-[10px] text-slate-400 block"><%= t.group %></span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium <%= diffColor %>">
                                                                    <%= t.difficulty || 'Medium' %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <% if (t.status === 'pending') { %>
                                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                                        Pending Approval
                                                                    </span>
                                                                <% } else if (t.status === 'rejected') { %>
                                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                                        <span class="material-symbols-rounded text-xs">error</span>
                                                                        Revision Required
                                                                    </span>
                                                                <% } else { %>
                                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                                        <span class="material-symbols-rounded text-xs">check_circle</span>
                                                                        Approved & Live
                                                                    </span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <% if (t.status === 'rejected') { %>
                                                                    <div class="text-[11px] text-rose-600 dark:text-rose-400 font-medium flex items-center gap-1">
                                                                        <span class="material-symbols-rounded text-xs shrink-0">feedback</span>
                                                                        <span><%= t.rejectionReason || 'Please review syllabus alignment.' %></span>
                                                                    </div>
                                                                <% } else if (t.status === 'pending') { %>
                                                                    <span class="text-slate-400 text-[11px] italic">Awaiting Admin review</span>
                                                                <% } else { %>
                                                                    <span class="text-emerald-600 text-[11px] flex items-center gap-1">
                                                                        <span class="material-symbols-rounded text-xs">verified</span>
                                                                        Live in syllabus
                                                                    </span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-slate-400 text-[11px]">
                                                                <%= new Date(t.createdAt).toLocaleDateString() %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-right">
                                                                <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                                    <div class="inline-flex items-center justify-end gap-1.5">
                                                                        <button type="button" onclick="openUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify(t.name) %>, <%= JSON.stringify(t.subject || ch.subject) %>, '<%= t._id %>')" class="h-6 px-2.5 rounded bg-primary/10 hover:bg-primary text-primary hover:text-white text-[11px] font-medium transition-colors inline-flex items-center gap-1" title="<%= t.status === 'rejected' ? 'Resubmit rejected topic' : 'Edit submission' %>">
                                                                            <span class="material-symbols-rounded text-xs">edit</span>
                                                                            <span><%= t.status === 'rejected' ? 'Resubmit' : 'Edit' %></span>
                                                                        </button>
                                                                        <button type="button" onclick="cancelPendingTopic('<%= t._id %>', <%= JSON.stringify(t.name) %>)" class="size-6 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors" title="Delete submission">
                                                                            <span class="material-symbols-rounded text-xs">delete</span>
                                                                        </button>
                                                                    </div>
                                                                <% } else { %>
                                                                    <span class="text-slate-400 text-[11px] italic">Published</span>
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Filter Empty State -->
                        <div id="submissionsFilterEmptyNotice" class="hidden bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 p-8 text-center shadow-xs">
                            <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600 mb-1.5">filter_list_off</span>
                            <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Matching Topics</h4>
                            <p class="text-[11px] text-slate-500 mt-0.5">There are no topic submissions matching status: <strong id="emptyFilterStatusLabel" class="text-primary font-semibold"></strong>.</p>
                            <button type="button" onclick="filterSubmissions('all')" class="mt-2.5 inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 transition-colors">
                                <span class="material-symbols-rounded text-sm">replay</span> View All Submissions
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <!-- Datalist for Existing Chapters Suggestion -->
    <datalist id="existingChaptersList">
        <% safeChapters.forEach(ch => { %>
            <option value="<%= ch.name %>">
        <% }) %>
    </datalist>

    <!-- UNIFIED MODAL: ADD TOPICS FOR TEACHER -->
    <div id="unifiedTopicModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-[#0f172a] rounded-lg border border-slate-200 dark:border-slate-800 max-w-lg w-full max-h-[92vh] overflow-y-auto p-4 sm:p-5 space-y-4 shadow-xl">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-rounded text-primary text-xl">account_tree</span>
                    <div>
                        <h3 id="unifiedModalTitle" class="text-sm font-semibold text-slate-800 dark:text-slate-100">Add Topics</h3>
                        <p class="text-[10px] text-slate-400">Submissions will be sent to Admin for review & approval.</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('unifiedTopicModal')" class="size-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 flex items-center justify-center">
                    <span class="material-symbols-rounded text-base">close</span>
                </button>
            </div>

            <!-- Mode Switcher (Single vs Bulk) -->
            <div id="unifiedModeTabs" class="flex items-center p-1 rounded-md bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60">
                <button type="button" id="tabModeSingle" onclick="setTopicMode('single')"
                        class="flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs">
                    Single Topic
                </button>
                <button type="button" id="tabModeBulk" onclick="setTopicMode('bulk')"
                        class="flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">
                    Bulk Topics
                </button>
            </div>

            <!-- Unified Form -->
            <form id="unifiedTopicForm" onsubmit="submitTeacherTopicForm(event)" class="space-y-3">
                <input type="hidden" name="group" value="<%= selGroup %>">
                <input type="hidden" name="topicId" id="unifiedTopicId" value="">

                <!-- Academic Scope Indicator (Class & Subject) -->
                <div class="grid grid-cols-2 gap-2.5">
                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Class</label>
                        <input type="text" name="classLevel" value="<%= selClass %>" readonly class="w-full h-9 px-3 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none cursor-default">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Subject *</label>
                        <% if (availSubjects.length > 1) { %>
                            <select name="subject" id="unifiedSubjectSelect" onchange="onModalSubjectChange(this.value)" class="w-full h-9 px-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium outline-none focus:border-primary cursor-pointer">
                                <% availSubjects.forEach(s => { %>
                                    <option value="<%= s %>" <%= (s.toLowerCase() === selSubject.toLowerCase()) ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                        <% } else if (availSubjects.length === 1) { %>
                            <input type="text" name="subject" value="<%= selSubject %>" readonly class="w-full h-9 px-3 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none cursor-default">
                        <% } else { %>
                            <input type="text" name="subject" placeholder="Enter subject name" required class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                        <% } %>
                    </div>
                </div>

                <!-- Chapter Details -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <div class="sm:col-span-2">
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Chapter Name *</label>
                        <input type="text" id="unifiedChapterName" name="chapterName" list="existingChaptersList" required placeholder="Chapter name" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary transition-colors" oninput="checkChapterConflict()">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Ch Number *</label>
                        <input type="number" id="unifiedChapterNumber" name="chapterNumber" value="1" min="1" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary transition-colors" oninput="checkChapterConflict()">
                    </div>
                </div>

                <!-- Live Chapter Conflict / Match Indicator -->
                <div id="chapterConflictNotice" class="hidden rounded-md p-2.5 text-xs flex items-center gap-2 transition-all">
                    <span id="chapterConflictIcon" class="material-symbols-rounded text-base shrink-0"></span>
                    <span id="chapterConflictText" class="text-[11px] font-medium leading-tight"></span>
                </div>

                <!-- SINGLE TOPIC MODE FIELDS -->
                <div id="singleTopicFields" class="space-y-3">
                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Topic Name *</label>
                        <input type="text" id="singleTopicName" name="name" placeholder="Topic name" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <div>
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Difficulty</label>
                            <select id="singleDifficulty" name="difficulty" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                                <option value="Easy">Easy</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="Hard">Hard</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Topic Code (Optional)</label>
                            <input type="text" id="singleTopicCode" name="code" placeholder="Code" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                        </div>
                    </div>

                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Description (Optional)</label>
                        <textarea id="singleDescription" name="description" rows="2" placeholder="Brief topic overview" class="w-full p-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y"></textarea>
                    </div>
                </div>

                <!-- BULK TOPICS MODE FIELDS -->
                <div id="bulkTopicFields" class="space-y-3 hidden">
                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">
                            Topic Names (One topic per line) *
                        </label>
                        <textarea id="bulkTopicList" name="topicList" rows="5" placeholder="Enter topic names here (one per line)..." class="w-full p-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y"></textarea>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" onclick="closeModal('unifiedTopicModal')" class="h-9 px-3 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</button>
                    <button type="submit" id="unifiedSubmitBtn" class="h-9 px-4 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-medium transition-all flex items-center gap-1.5 shadow-xs">
                        <span class="material-symbols-rounded text-sm">send</span>
                        <span id="unifiedSubmitBtnText">Submit for Approval</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const apiBase = '<%= safeApiBase %>';
        const currentClassLevel = '<%= selClass %>';
        const currentSubject = '<%= selSubject %>';
        let currentModalMode = 'single';
        let currentSubjectChapters = <%- JSON.stringify(safeChapters.map(c => ({ name: c.name, number: c.number }))) %>;

        function getSelectedModalSubject() {
            const selectEl = document.getElementById('unifiedSubjectSelect');
            if (selectEl && selectEl.value) return selectEl.value;
            const inputEl = document.querySelector('#unifiedTopicForm input[name="subject"]');
            if (inputEl && inputEl.value) return inputEl.value;
            return currentSubject || '';
        }

        async function onModalSubjectChange(newSub) {
            await loadChaptersForSubject(newSub);
            checkChapterConflict();
        }

        async function loadChaptersForSubject(subj) {
            if (!subj || !currentClassLevel) return;
            try {
                const res = await fetch(`${apiBase}/api/chapters?classLevel=${encodeURIComponent(currentClassLevel)}&subject=${encodeURIComponent(subj)}`);
                const data = await res.json();
                if (data && data.success && Array.isArray(data.chapters)) {
                    currentSubjectChapters = data.chapters;
                    const dl = document.getElementById('existingChaptersList');
                    if (dl) {
                        dl.innerHTML = '';
                        currentSubjectChapters.forEach(c => {
                            const opt = document.createElement('option');
                            opt.value = c.name;
                            opt.label = `Ch ${c.number}: ${c.name}`;
                            dl.appendChild(opt);
                        });
                    }
                }
            } catch (err) {
                console.error('Error loading chapters for subject:', err);
            }
        }

        function checkChapterConflict() {
            const chNameInput = document.getElementById('unifiedChapterName');
            const chNumInput = document.getElementById('unifiedChapterNumber');
            const notice = document.getElementById('chapterConflictNotice');
            const noticeIcon = document.getElementById('chapterConflictIcon');
            const noticeText = document.getElementById('chapterConflictText');
            const submitBtn = document.getElementById('unifiedSubmitBtn');

            if (!chNameInput || !chNumInput || !notice) return false;

            const enteredName = chNameInput.value.trim().toLowerCase();
            const enteredNum = parseInt(chNumInput.value, 10);
            const currentSub = getSelectedModalSubject();

            if (!enteredName || isNaN(enteredNum) || enteredNum < 1) {
                notice.classList.add('hidden');
                chNameInput.classList.remove('border-rose-500', 'border-emerald-500', 'border-blue-500');
                chNumInput.classList.remove('border-rose-500', 'border-emerald-500', 'border-blue-500');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                return false;
            }

            // Only check chapter number conflict
            const existingNumberMatch = currentSubjectChapters.find(ch => parseInt(ch.number, 10) === enteredNum);

            if (existingNumberMatch) {
                const existingChName = (existingNumberMatch.name || '').trim();
                const isExactName = existingChName.toLowerCase() === enteredName;

                if (isExactName) {
                    // Actual chapter name matches - completely valid!
                    notice.className = 'rounded-md p-2 text-xs flex items-center gap-2 bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/40 text-blue-700 dark:text-blue-300';
                    noticeIcon.className = 'material-symbols-rounded text-sm text-blue-600 shrink-0';
                    noticeIcon.textContent = 'folder_open';
                    noticeText.innerHTML = `<strong>Existing Chapter:</strong> Adding to Chapter ${enteredNum}: "<strong>${existingChName}</strong>".`;
                    notice.classList.remove('hidden');

                    chNameInput.classList.remove('border-rose-500');
                    chNumInput.classList.remove('border-rose-500');
                    chNameInput.classList.add('border-blue-500');
                    chNumInput.classList.add('border-blue-500');
                } else {
                    // Chapter number has an existing name in this subject - give helpful info
                    notice.className = 'rounded-md p-2.5 text-xs flex items-center gap-2 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300';
                    noticeIcon.className = 'material-symbols-rounded text-base text-amber-600 shrink-0';
                    noticeIcon.textContent = 'info';
                    noticeText.innerHTML = `Chapter ${enteredNum} is currently named "<strong>${existingChName}</strong>" in ${currentSub}. <button type="button" class="underline font-semibold ml-1 text-primary cursor-pointer" onclick="useExistingChapterName(${enteredNum})">Use "${existingChName}"</button>`;
                    notice.classList.remove('hidden');

                    chNumInput.classList.remove('border-rose-500');
                    chNameInput.classList.remove('border-rose-500');
                }
            } else {
                // New chapter number
                notice.className = 'rounded-md p-2 text-xs flex items-center gap-2 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 text-emerald-700 dark:text-emerald-300';
                noticeIcon.className = 'material-symbols-rounded text-sm text-emerald-600 shrink-0';
                noticeIcon.textContent = 'add_circle';
                noticeText.innerHTML = `<strong>New Chapter:</strong> Chapter ${enteredNum} will be added to <strong>${currentSub}</strong>.`;
                notice.classList.remove('hidden');

                chNameInput.classList.remove('border-rose-500');
                chNumInput.classList.remove('border-rose-500');
                chNameInput.classList.add('border-emerald-500');
                chNumInput.classList.add('border-emerald-500');
            }

            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            return false;
        }

        function useExistingChapterName(num) {
            const match = currentSubjectChapters.find(ch => parseInt(ch.number, 10) === parseInt(num, 10));
            if (match && match.name) {
                document.getElementById('unifiedChapterName').value = match.name;
                checkChapterConflict();
            }
        }

        function switchTeacherTab(tab) {
            const liveView = document.getElementById('liveTopicsView');
            const submissionsView = document.getElementById('submissionsTopicsView');
            const tabLiveBtn = document.getElementById('tabLiveBtn');
            const tabSubmissionsBtn = document.getElementById('tabSubmissionsBtn');

            if (tab === 'live') {
                liveView.classList.remove('hidden');
                submissionsView.classList.add('hidden');
                tabLiveBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                tabSubmissionsBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.delete('tab');
                    window.history.replaceState(null, '', u.toString());
                }
            } else {
                liveView.classList.add('hidden');
                submissionsView.classList.remove('hidden');
                tabSubmissionsBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                tabLiveBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.set('tab', 'submissions');
                    window.history.replaceState(null, '', u.toString());
                }
            }
        }

        function onClassChange(newClass) {
            const u = new URL(window.location.href);
            u.searchParams.set('classLevel', newClass);
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function onGroupChange(newGroup) {
            const u = new URL(window.location.href);
            u.searchParams.set('group', newGroup);
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function onSubjectChange(newSub) {
            const u = new URL(window.location.href);
            u.searchParams.set('subject', newSub);
            window.location.href = u.toString();
        }

        function toggleChapterAccordion(chId) {
            const content = document.getElementById('content_' + chId);
            const icon = document.getElementById('icon_' + chId);
            if (!content) return;
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(-90deg)';
            }
        }

        let allSubmissionsExpanded = true;
        function toggleAllSubmissionChapters() {
            allSubmissionsExpanded = !allSubmissionsExpanded;
            const contents = document.querySelectorAll('.submission-chapter-content');
            const icons = document.querySelectorAll('[id^="icon_sub_ch_"]');
            const btnText = document.getElementById('textToggleAllSubChapters');
            const btnIcon = document.getElementById('iconToggleAllSubChapters');

            contents.forEach(c => {
                if (allSubmissionsExpanded) c.classList.remove('hidden');
                else c.classList.add('hidden');
            });
            icons.forEach(ic => {
                ic.style.transform = allSubmissionsExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
            });
            if (btnText) btnText.textContent = allSubmissionsExpanded ? 'Collapse All' : 'Expand All';
            if (btnIcon) btnIcon.textContent = allSubmissionsExpanded ? 'unfold_less' : 'unfold_more';
        }

        function filterTopicsClientSide(query) {
            query = (query || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.chapter-card');
            cards.forEach(card => {
                const topicItems = card.querySelectorAll('.topic-item');
                let matchInChapter = false;
                topicItems.forEach(item => {
                    const name = (item.getAttribute('data-topic-name') || '').toLowerCase();
                    if (!query || name.includes(query)) {
                        item.classList.remove('hidden');
                        matchInChapter = true;
                    } else {
                        item.classList.add('hidden');
                    }
                });
                if (!query || matchInChapter) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Modal Mode Switcher
        function setTopicMode(mode) {
            currentModalMode = mode;
            const singleBtn = document.getElementById('tabModeSingle');
            const bulkBtn = document.getElementById('tabModeBulk');
            const singleFields = document.getElementById('singleTopicFields');
            const bulkFields = document.getElementById('bulkTopicFields');
            const singleName = document.getElementById('singleTopicName');
            const bulkList = document.getElementById('bulkTopicList');

            if (mode === 'single') {
                singleBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs';
                bulkBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                singleFields.classList.remove('hidden');
                bulkFields.classList.add('hidden');
                if (singleName) singleName.required = true;
                if (bulkList) bulkList.required = false;
            } else {
                bulkBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs';
                singleBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                bulkFields.classList.remove('hidden');
                singleFields.classList.add('hidden');
                if (singleName) singleName.required = false;
                if (bulkList) bulkList.required = true;
            }
        }

        async function openUnifiedModal(chapterName = '', chapterNumber = 1, defaultTopicName = '', subjectName = '', topicId = '') {
            if (!currentClassLevel) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Assigned Class',
                    text: 'You can only add topics when you have an assigned class selected.'
                });
                return;
            }
            document.getElementById('unifiedTopicForm').reset();
            setTopicMode('single');

            const topicIdInput = document.getElementById('unifiedTopicId');
            const modalTitle = document.getElementById('unifiedModalTitle');
            const submitBtnText = document.getElementById('unifiedSubmitBtnText');
            const modeTabs = document.getElementById('unifiedModeTabs');

            if (topicId) {
                if (topicIdInput) topicIdInput.value = topicId;
                if (modalTitle) modalTitle.textContent = 'Edit & Resubmit Topic';
                if (submitBtnText) submitBtnText.textContent = 'Save & Resubmit';
                if (modeTabs) modeTabs.classList.add('hidden');
            } else {
                if (topicIdInput) topicIdInput.value = '';
                if (modalTitle) modalTitle.textContent = 'Add Topics';
                if (submitBtnText) submitBtnText.textContent = 'Submit for Approval';
                if (modeTabs) modeTabs.classList.remove('hidden');
            }

            const subSelect = document.getElementById('unifiedSubjectSelect');
            if (subSelect && subjectName) {
                subSelect.value = subjectName;
            }
            const activeSub = getSelectedModalSubject();
            await loadChaptersForSubject(activeSub);

            if (chapterName) document.getElementById('unifiedChapterName').value = chapterName;
            if (chapterNumber) document.getElementById('unifiedChapterNumber').value = chapterNumber;
            if (defaultTopicName) document.getElementById('singleTopicName').value = defaultTopicName;

            document.getElementById('unifiedTopicModal').classList.remove('hidden');
            setTimeout(checkChapterConflict, 50);
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('hidden');
        }

        // ==========================================
        // SUBMISSION STATUS FILTER SYSTEM
        // ==========================================
        let currentSubmissionFilter = 'all';

        function filterSubmissions(status) {
            currentSubmissionFilter = status;
            const filterBtns = document.querySelectorAll('.sub-filter-btn');
            const activeClass = 'sub-filter-btn px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1.5 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 shadow-xs';
            const inactiveClass = 'sub-filter-btn px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700';

            filterBtns.forEach(btn => {
                btn.className = inactiveClass;
            });

            const activeBtn = document.getElementById(`filterSubBtn_${status}`);
            if (activeBtn) activeBtn.className = activeClass;

            const chapterCards = document.querySelectorAll('.submission-chapter-card');
            let totalVisibleTopics = 0;

            chapterCards.forEach(card => {
                const rows = card.querySelectorAll('.submission-topic-row');
                let visibleRowsInCard = 0;

                rows.forEach(row => {
                    const rowStatus = row.dataset.status;
                    let matches = false;
                    if (status === 'all') {
                        matches = true;
                    } else if (status === rowStatus) {
                        matches = true;
                    }

                    if (matches) {
                        row.classList.remove('hidden');
                        visibleRowsInCard++;
                        totalVisibleTopics++;
                    } else {
                        row.classList.add('hidden');
                    }
                });

                if (visibleRowsInCard > 0) {
                    card.classList.remove('hidden');
                    if (status !== 'all') {
                        const content = card.querySelector('.submission-chapter-content');
                        const icon = card.querySelector('[id^="icon_sub_ch_"]');
                        if (content) content.classList.remove('hidden');
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    }
                } else {
                    card.classList.add('hidden');
                }
            });

            const emptyNotice = document.getElementById('submissionsFilterEmptyNotice');
            if (emptyNotice) {
                if (totalVisibleTopics === 0) {
                    emptyNotice.classList.remove('hidden');
                    const labelSpan = document.getElementById('emptyFilterStatusLabel');
                    if (labelSpan) {
                        const labelMap = { 
                            pending: 'Pending Approval', 
                            rejected: 'Needs Revision', 
                            approved: 'Approved & Live', 
                            all: 'Submitted' 
                        };
                        labelSpan.textContent = labelMap[status] || status;
                    }
                } else {
                    emptyNotice.classList.add('hidden');
                }
            }

            if (window.history.replaceState) {
                const u = new URL(window.location.href);
                u.searchParams.set('tab', 'submissions');
                if (status === 'all') {
                    u.searchParams.delete('subStatus');
                } else {
                    u.searchParams.set('subStatus', status);
                }
                window.history.replaceState(null, '', u.toString());
            }
        }

        async function submitTeacherTopicForm(event) {
            event.preventDefault();

            const form = event.target;
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());

            const isBulk = currentModalMode === 'bulk';
            const endpoint = isBulk ? `${apiBase}/topics/bulk` : `${apiBase}/topics`;

            try {
                Swal.fire({ title: 'Submitting Topics...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const text = await res.text();
                let data = {};
                try { data = JSON.parse(text); } catch(e) { data = { error: text }; }

                if (res.ok && data.success !== false) {
                    await Swal.fire({ 
                        icon: 'success', 
                        title: 'Submitted for Approval!', 
                        text: data.message || 'Your topics have been sent to Admin for review.', 
                        confirmButtonColor: '#137fec' 
                    });
                    closeModal('unifiedTopicModal');
                    window.location.href = window.location.pathname + '?tab=submissions&subStatus=pending';
                } else {
                    Swal.fire('Submission Error', data.error || 'Failed to submit topics', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            }
        }

        async function cancelPendingTopic(id, name) {
            const confirm = await Swal.fire({
                title: 'Remove Submission?',
                html: `Remove topic submission <strong>"${name}"</strong>?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Remove'
            });

            if (confirm.isConfirmed) {
                try {
                    Swal.fire({ title: 'Removing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    const res = await fetch(`${apiBase}/topics/${id}/delete-pending`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' }
                    });
                    const text = await res.text();
                    let data = {};
                    try { data = JSON.parse(text); } catch(e) { data = { error: text }; }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({ icon: 'success', title: 'Removed!', text: data.message, timer: 1200, showConfirmButton: false });
                        const u = new URL(window.location.href);
                        u.searchParams.set('tab', 'submissions');
                        window.location.href = u.toString();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to remove', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', err.message || 'Connection error', 'error');
                }
            }
        }

        // Auto Tab & Submissions Filter from URL
        document.addEventListener('DOMContentLoaded', () => {
            const p = new URLSearchParams(window.location.search);
            if (p.get('tab') === 'submissions' || window.location.hash === '#submissions') {
                switchTeacherTab('submissions');
            } else {
                switchTeacherTab('live');
            }

            const subStatus = p.get('subStatus');
            if (subStatus && ['all', 'pending', 'rejected', 'approved'].includes(subStatus)) {
                filterSubmissions(subStatus);
            }
        });
    </script>
</body>
</html>
