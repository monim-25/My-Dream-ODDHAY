<%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { name: 'Teacher', role: 'teacher', theme: 'light' };
    const safeClasses = (typeof classes !== 'undefined' && Array.isArray(classes)) ? classes : [];
    const safeChapters = (typeof chapters !== 'undefined' && Array.isArray(chapters)) ? chapters : [];
    const safeActiveTopics = (typeof activeTopics !== 'undefined' && Array.isArray(activeTopics)) ? activeTopics : [];
    const safePendingTopics = (typeof myPendingTopics !== 'undefined' && Array.isArray(myPendingTopics)) ? myPendingTopics : [];
    const safeRejectedTopics = (typeof myRejectedTopics !== 'undefined' && Array.isArray(myRejectedTopics)) ? myRejectedTopics : [];
    const safeApprovedTopics = (typeof myApprovedTopics !== 'undefined' && Array.isArray(myApprovedTopics)) ? myApprovedTopics : [];
    const safeDeletionRequests = (typeof myDeletionRequests !== 'undefined' && Array.isArray(myDeletionRequests)) ? myDeletionRequests : [];
    const safeDeletionCount = (typeof deletionRequestCount !== 'undefined') ? deletionRequestCount : safeDeletionRequests.length;
    const safeSubmissions = (typeof mySubmissions !== 'undefined' && Array.isArray(mySubmissions)) ? mySubmissions : [];
    const safeSubmissionChapters = (typeof mySubmissionChapters !== 'undefined' && Array.isArray(mySubmissionChapters)) ? mySubmissionChapters : [];
    const selClass = (typeof selectedClass !== 'undefined') ? selectedClass : '';
    const selClasses = (typeof selectedClasses !== 'undefined' && Array.isArray(selectedClasses) && selectedClasses.length > 0) ? selectedClasses : (selClass ? [selClass] : []);
    const selGroup = (typeof selectedGroup !== 'undefined') ? selectedGroup : 'all';
    const selSubject = (typeof selectedSubject !== 'undefined') ? selectedSubject : '';
    const availSubjects = (typeof availableSubjects !== 'undefined' && Array.isArray(availableSubjects)) ? availableSubjects : [];
    const subHasSegs = (typeof subjectHasSegments !== 'undefined') ? Boolean(subjectHasSegments) : false;
    const subSegs = (typeof subjectSegments !== 'undefined' && Array.isArray(subjectSegments)) ? subjectSegments : [];
    const selSegment = (typeof selectedSegment !== 'undefined') ? selectedSegment : 'all';
    const safeSegmentStats = (typeof segmentStats !== 'undefined' && segmentStats) ? segmentStats : {};
    const safeCurrentClass = (typeof currentClassObj !== 'undefined' && currentClassObj) ? currentClassObj : (safeClasses.find(c => ((c && c.name) ? c.name : String(c || '')).toLowerCase() === String(selClass || '').toLowerCase()) || null);
    const safeApiBase = (typeof apiBase !== 'undefined') ? apiBase : '/teacher';
%>
<!DOCTYPE html>
<html lang="en" class="<%= (safeUser.theme === 'dark') ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Syllabus & Topics Studio | ODDHAY Teacher Portal</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); }
            .admin-sidebar.active, #adminSidebar.active { transform: translateX(0); }
            .admin-main { margin-left: 0; width: 100%; }
        }
        /* Selection System Styles */
        .selection-checkbox-wrap { display: none; }
        body.selection-mode-active .selection-checkbox-wrap { display: inline-flex; align-items: center; }
        body.selection-mode-active .chapter-card { cursor: pointer; }
        body.selection-mode-active .topic-item { cursor: pointer; }
        body.selection-mode-active .topic-item:hover { border-color: rgba(99, 102, 241, 0.4); }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased overflow-hidden">

    <!-- Mobile Drawer Backdrop -->
    <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

    <div class="flex h-full">
        <!-- Sidebar -->
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'topics' }) %>
        </aside>

        <!-- Main Content Area -->
        <main class="admin-main flex-1 bg-[#FFFFFF] dark:bg-[#020617] flex flex-col min-h-screen relative w-full">
            <%- include('header', { pageTitle: 'Syllabus & Topics Studio' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5 flex-1">
                
                <!-- 1. Sticky Action Bar with 2-Line Layout (Tabs & Actions on Line 1, Class & Subject Filters on Line 2) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 px-2.5 sm:px-4 py-2 sm:py-2.5 sticky top-0 z-30 shadow-xs">
                    <!-- Line 1: Tab Switcher (Left) & Actions (Right) -->
                    <div class="flex items-center justify-between gap-2.5 sm:gap-3 flex-wrap">
                        <!-- Left: Tab Switcher -->
                        <div class="flex items-center gap-1 p-0.5 bg-slate-100 dark:bg-slate-800/80 rounded-md border border-slate-200 dark:border-slate-700/60 shrink-0">
                            <button type="button" id="tabLiveBtn" onclick="switchTeacherTab('live')"
                                    class="px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs shrink-0 whitespace-nowrap">
                                <span class="material-symbols-rounded text-[17px]">account_tree</span>
                                <span>Live</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-primary/10 text-primary font-bold leading-none"><%= safeActiveTopics.length %></span>
                            </button>
                            <button type="button" id="tabSubmissionsBtn" onclick="switchTeacherTab('submissions')"
                                    class="px-2.5 sm:px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white shrink-0 whitespace-nowrap">
                                <span class="material-symbols-rounded text-[17px]">send_and_archive</span>
                                <span>Submissions</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= safePendingTopics.length > 0 ? 'bg-amber-500 text-white font-bold' : 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300' %> leading-none"><%= safePendingTopics.length %></span>
                            </button>
                        </div>

                        <!-- Right Actions: Quick Search & Add Topics -->
                        <div class="flex items-center gap-2 shrink-0">
                            <div class="relative hidden sm:block w-36 sm:w-48 xl:w-52">
                                <span class="material-symbols-rounded absolute left-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                                <input type="text" id="topicSearchInput" onkeyup="filterTopicsClientSide(this.value)" placeholder="Search topics..." class="w-full h-8 pl-7 pr-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                            </div>

                            <button type="button" id="unifiedModalOpenBtn" onclick="openUnifiedModal('', 1, '', '', '', [], '<%= (selSegment !== 'all') ? selSegment : '' %>')"
                                    class="h-8 px-3 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-medium flex items-center gap-1 shadow-xs transition-all whitespace-nowrap cursor-pointer">
                                <span class="material-symbols-rounded text-base">add</span>
                                <span>Add Topics</span>
                            </button>
                        </div>
                    </div>

                    <!-- Line 2: Dropdown Filters (Class & Subject) and Tools (Expand All & Select Topics) in the Second Line -->
                    <div id="liveFiltersBar" class="flex items-center justify-between gap-2.5 sm:gap-4 flex-wrap pt-2 mt-2 border-t border-slate-100 dark:border-slate-800/60">
                        <!-- Left: Class & Subject Filters -->
                        <div class="flex items-center gap-2.5 sm:gap-4 flex-wrap">
                            <!-- Class Dropdown (Wider for Class 10 and comfort) -->
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 shrink-0">Class:</span>
                                <select id="classSelector" onchange="onClassChange(this.value)" 
                                        class="h-8 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-primary shadow-2xs min-w-[130px] sm:min-w-[145px] cursor-pointer">
                                    <% safeClasses.forEach(c => { %>
                                        <option value="<%= c.name %>" <%= c.name.toLowerCase() === selClass.toLowerCase() ? 'selected' : '' %>>
                                            <%= c.name %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Subject Dropdown -->
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 shrink-0">Subject:</span>
                                <select id="subjectSelector" onchange="onSubjectChange(this.value)" 
                                        class="h-8 px-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-primary shadow-2xs min-w-[140px] sm:min-w-[160px] cursor-pointer">
                                    <% if (availSubjects.length === 0) { %>
                                        <option value="">No Subjects</option>
                                    <% } else { %>
                                        <% availSubjects.forEach(sub => { %>
                                            <option value="<%= sub %>" <%= sub.toLowerCase() === selSubject.toLowerCase() ? 'selected' : '' %>>
                                                <%= sub %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <!-- Segment Dropdown (Visible if subject has segmentation rules) -->
                            <div id="segmentFilterWrap" class="flex items-center gap-1.5 <%= (subHasSegs && subSegs.length > 0) ? '' : 'hidden' %>">
                                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 shrink-0">Segment:</span>
                                <select id="segmentSelector" onchange="onSegmentChange(this.value)" 
                                        class="h-8 px-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-primary shadow-2xs min-w-[130px] cursor-pointer">
                                    <option value="all" <%= selSegment === 'all' ? 'selected' : '' %>>All Segments (সকল সেগমেন্ট)</option>
                                    <% subSegs.forEach(seg => { 
                                        const stats = safeSegmentStats[seg];
                                        const segLabel = stats ? `${seg} (${stats.chaptersCount} Chapters, ${stats.topicsCount} Topics)` : seg;
                                    %>
                                        <option value="<%= seg %>" <%= selSegment === seg ? 'selected' : '' %>>
                                            <%= segLabel %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>

                        <!-- Right: Expand All & Select Topics (Same Line as Filters) -->
                        <div class="flex items-center gap-2 shrink-0 ml-auto sm:ml-0">
                            <!-- Expand / Collapse All Chapters (Live Tab) -->
                            <button type="button" id="topBarToggleAllLiveChapters" onclick="toggleAllLiveChapters()"
                                    class="h-8 px-2.5 sm:px-3 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 shadow-xs transition-all shrink-0 cursor-pointer"
                                    title="Expand / Collapse all chapters">
                                <span class="material-symbols-rounded text-base text-slate-500" id="topBarIconToggleLive">unfold_less</span>
                                <span id="topBarTextToggleLive" class="hidden sm:inline">Collapse All</span>
                            </button>

                            <!-- Selection System Button for Bulk Actions -->
                            <button type="button" id="btnToggleSelection" onclick="toggleSelectionMode()"
                                    class="h-8 px-2.5 sm:px-3 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all shrink-0 cursor-pointer"
                                    title="Toggle selection mode for bulk actions">
                                <span id="btnSelectionIcon" class="material-symbols-rounded text-[17px] text-slate-500">checklist</span>
                                <span id="btnSelectionLabel" class="hidden md:inline">Select Topics</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Selection System Toolbar (Opens when Select button is clicked) -->
                <div id="selectionToolbar" class="bg-primary/5 dark:bg-primary/10 border-b border-primary/20 px-2.5 sm:px-4 py-2 hidden transition-all sticky top-[84px] sm:top-[88px] z-20 backdrop-blur-xs">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-2.5">
                        <div class="flex flex-wrap items-center gap-2 sm:gap-3 w-full sm:w-auto">
                            <div class="flex items-center gap-1.5 text-xs font-medium text-primary shrink-0">
                                <span class="material-symbols-rounded text-base">checklist_rtl</span>
                                <span>Selection Mode</span>
                                <span id="toolbarSelectedCountBadge" class="px-2 py-0.5 rounded-full text-[10px] bg-primary text-white font-semibold ml-0.5">0 Selected</span>
                            </div>
                            <div class="h-3.5 w-px bg-primary/20 hidden sm:block"></div>
                            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
                                <button type="button" onclick="selectAllLiveTopics()"
                                        class="h-7 px-2 sm:px-2.5 rounded bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-[11px] font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 transition-all shrink-0 whitespace-nowrap cursor-pointer">
                                    <span class="material-symbols-rounded text-sm">select_all</span>
                                    <span>Select All (<%= safeActiveTopics.length %>)</span>
                                </button>
                                <button type="button" onclick="deselectAllLive()"
                                        class="h-7 px-2 rounded bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-[11px] font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 transition-all shrink-0 whitespace-nowrap cursor-pointer">
                                    <span class="material-symbols-rounded text-sm">deselect</span>
                                    <span>Deselect</span>
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                            <button type="button" id="btnToolbarCancelDelete" onclick="bulkCancelDeleteLive()" disabled
                                    class="h-7 px-2.5 sm:px-3 rounded bg-amber-600 hover:bg-amber-700 disabled:opacity-40 disabled:pointer-events-none text-white text-xs font-medium hidden items-center gap-1 transition-all shadow-xs shrink-0 cursor-pointer">
                                <span class="material-symbols-rounded text-sm">hourglass_disabled</span>
                                <span id="btnToolbarCancelDeleteText">অনুরোধ প্রত্যাহার</span>
                            </button>
                            <button type="button" id="btnToolbarRequestDelete" onclick="bulkRequestDeleteLive()" disabled
                                    class="h-7 px-2.5 sm:px-3 rounded bg-rose-600 hover:bg-rose-700 disabled:opacity-40 disabled:pointer-events-none text-white text-xs font-medium flex items-center gap-1 transition-all shadow-xs shrink-0 cursor-pointer">
                                <span class="material-symbols-rounded text-sm">delete_sweep</span>
                                <span id="btnToolbarRequestDeleteText">Request Delete</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. LIVE SYLLABUS LIST VIEW -->
                <div id="liveTopicsView" class="p-3 sm:p-4 flex-1 max-w-7xl mx-auto w-full space-y-3">
                    <% if (safeChapters.length > 0) { %>
                    <!-- Live Chapters Stats -->
                    <div class="flex items-center gap-1.5 px-1 text-xs text-slate-600 dark:text-slate-400 font-medium">
                        <span class="material-symbols-rounded text-base text-primary">folder_open</span>
                        <% if (selSegment && selSegment !== 'all') { %>
                            <span><%= safeChapters.length %> Chapters in <strong class="text-primary"><%= selSegment %></strong></span>
                        <% } else { %>
                            <span><%= safeChapters.length %> Chapters</span>
                        <% } %>
                        <span class="text-slate-300 dark:text-slate-700">•</span>
                        <span><%= safeActiveTopics.length %> Topics</span>
                    </div>
                <% } %>
                <div id="chaptersContainer" class="space-y-3">
                                <% if (safeClasses.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-amber-500 mb-1">school</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Classes Assigned</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">Your teacher profile does not have any classes assigned. Please contact the administrator.</p>
                                    </div>
                                <% } else if (availSubjects.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-amber-500 mb-1">menu_book</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Subjects Assigned</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">You do not have any teaching subjects assigned for <strong><%= selClass %></strong>.</p>
                                    </div>
                                <% } else if (safeChapters.length === 0) { %>
                                    <div class="p-8 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] rounded-md">
                                        <span class="material-symbols-rounded text-3xl text-slate-400 mb-1">menu_book</span>
                                        <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Chapters or Topics Found</h4>
                                        <p class="text-[11px] text-slate-500 mt-1 font-normal">Click "Add Topics" above to contribute to syllabus for <%= selSubject %>.</p>
                                    </div>
                                <% } else { %>
                                    <% safeChapters.forEach((ch, chIdx) => { %>
                                        <div class="chapter-card bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-md shadow-xs overflow-hidden" data-chapter-name="<%= ch.name %>">
                                            <!-- Chapter Header -->
                                            <div class="px-3.5 py-2.5 bg-slate-50/70 dark:bg-slate-900/60 border-b border-slate-100 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-2 cursor-pointer select-none" onclick="onChapterHeaderClick(event, '<%= chIdx %>')">
                                                <div class="flex items-center gap-2.5 flex-1 min-w-[240px]">
                                                    <!-- Multi-select checkbox for whole chapter (Visible in Selection Mode) -->
                                                    <div class="selection-checkbox-wrap shrink-0" onclick="event.stopPropagation()">
                                                        <input type="checkbox" id="chapter_cb_<%= chIdx %>" class="chapter-checkbox size-3.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer" onchange="toggleSelectChapterTopics('<%= chIdx %>', this.checked)">
                                                    </div>
                                                    <span class="size-6 rounded bg-primary/10 text-primary font-semibold text-xs flex items-center justify-center shrink-0">
                                                        <%= ch.number %>
                                                    </span>
                                                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                                                        <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100 leading-normal m-0 p-0">
                                                            <%= ch.name %>
                                                        </h4>
                                                        <% if (subHasSegs && ch.segment && subSegs.some(s => s.toLowerCase() === ch.segment.toLowerCase())) { %>
                                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-900/40 shrink-0">
                                                                <%= ch.segment %>
                                                            </span>
                                                        <% } %>
                                                        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal leading-normal">
                                                            (<%= ch.topics.length %> Topics Assigned)
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-1 shrink-0" onclick="event.stopPropagation()">
                                                    <% 
                                                        const chPendingDelTopics = ch.topics.filter(t => t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending');
                                                        const chPendingDelIds = chPendingDelTopics.map(t => t._id);
                                                        const chUnrequestedTopics = ch.topics.filter(t => !(t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending'));
                                                        const chUnrequestedIds = chUnrequestedTopics.map(t => t._id);
                                                    %>
                                                    <% if (chPendingDelTopics.length > 0) { %>
                                                        <!-- Cancel Deletion Request for Chapter / Pending Topics -->
                                                        <button type="button" 
                                                                onclick="cancelDeletionRequest(<%= JSON.stringify(chPendingDelIds) %>, <%= JSON.stringify(ch.name) %>, 'chapter')" 
                                                                class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center transition-colors shrink-0" 
                                                                title="Deletion Requested for <%= chPendingDelTopics.length %> topic(s) (Click to cancel request / অনুরোধ প্রত্যাহার)">
                                                            <span class="material-symbols-rounded text-base">hourglass_top</span>
                                                        </button>
                                                    <% } %>
                                                    <% if (chUnrequestedTopics.length > 0) { %>
                                                        <!-- Edit Chapter & Manage Topics Button (Opens Full Form) -->
                                                        <button type="button" 
                                                                onclick="openChapterEditUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify((ch.topics || []).map(t => ({ id: t._id, name: t.name, code: t.code || '', difficulty: t.difficulty || 'Medium', description: t.description || '', subTopics: t.subTopics || [] }))) %>, <%= JSON.stringify(ch.segment || '') %>)" 
                                                                class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-slate-400 hover:text-amber-600 dark:hover:text-amber-400 flex items-center justify-center transition-colors shrink-0" 
                                                                title="Edit Chapter Name & Add/Manage Topics">
                                                            <span class="material-symbols-rounded text-base">edit</span>
                                                        </button>

                                                        <!-- Request Delete Chapter Icon -->
                                                        <button type="button" 
                                                                onclick="openRequestDeleteModal(<%= JSON.stringify(ch.name) %>, <%= JSON.stringify(chUnrequestedIds) %>, 'chapter')" 
                                                                class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors shrink-0" 
                                                                title="Request to Delete Chapter<%= chPendingDelTopics.length > 0 ? ' (' + chUnrequestedTopics.length + ' remaining topics)' : '' %>">
                                                            <span class="material-symbols-rounded text-base">delete_sweep</span>
                                                        </button>
                                                    <% } %>
                                                    <!-- Accordion Chevron -->
                                                    <button type="button" onclick="toggleChapterAccordion('ch_<%= chIdx %>')" class="size-7 rounded hover:bg-slate-200/50 dark:hover:bg-slate-800 flex items-center justify-center text-slate-400" title="Expand / Collapse Chapter">
                                                        <span id="icon_ch_<%= chIdx %>" class="material-symbols-rounded text-base transition-transform">expand_more</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Chapter Topics List -->
                                            <div id="content_ch_<%= chIdx %>" class="p-3 space-y-2">
                                                <% if (!ch.topics || ch.topics.length === 0) { %>
                                                    <div class="py-4 text-center text-xs text-slate-400 dark:text-slate-500 bg-slate-50/50 dark:bg-slate-900/30 rounded-md border border-dashed border-slate-200 dark:border-slate-800">
                                                        <p class="font-medium text-slate-600 dark:text-slate-300">এই অধ্যায়ে বর্তমানে কোনো টপিক নেই</p>
                                                        <p class="text-[11px] text-slate-400 mt-0.5">টপিক ডিলিট হলেও অধ্যায়টি সিলেবাসে সংরক্ষিত রয়েছে।</p>
                                                        <button type="button" onclick="openTeacherModal('<%= ch.name %>', <%= ch.number %>, 'single', '<%= ch.segment || '' %>')" class="mt-2 h-7 px-3 rounded bg-primary text-white text-xs font-semibold hover:bg-primary/90 inline-flex items-center gap-1 shadow-xs cursor-pointer">
                                                            <span class="material-symbols-rounded text-sm">add</span> নতুন টপিক যুক্ত করুন
                                                        </button>
                                                    </div>
                                                <% } else { %>
                                                <% ch.topics.forEach((t, tIdx) => { %>
                                                    <div class="topic-item p-2.5 rounded-md bg-slate-50/50 dark:bg-slate-900/40 border border-slate-200/70 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-2.5 hover:border-primary/40 transition-all select-none" data-topic-name="<%= t.name %>" onclick="onTopicItemClick(event, '<%= t._id %>', '<%= chIdx %>')">
                                                        <div class="flex items-start gap-2.5 flex-1 min-w-[240px]">
                                                            <!-- Multi-select checkbox (Visible in Selection Mode) -->
                                                            <div class="selection-checkbox-wrap shrink-0" onclick="event.stopPropagation()">
                                                                <input type="checkbox" class="topic-checkbox ch-topic-<%= chIdx %> size-3.5 mt-0.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer" data-id="<%= t._id %>" data-name="<%= t.name %>" data-pending="<%= (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') ? 'true' : 'false' %>" onchange="updateSelectedTopicsCount()">
                                                            </div>
                                                            <span class="text-slate-400 font-medium text-xs mt-0.5">#<%= t.order || (tIdx + 1) %></span>
                                                            <div>
                                                                <div class="flex items-center gap-2 flex-wrap">
                                                                    <span class="text-xs font-medium text-slate-800 dark:text-slate-100"><%= t.name %></span>
                                                                    <% if (t.code) { %>
                                                                        <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-normal"><%= t.code %></span>
                                                                    <% } %>
                                                                    <% 
                                                                        let diffClass = 'bg-amber-500/10 text-amber-600 border-amber-500/20';
                                                                        if (t.difficulty === 'Easy') diffClass = 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20';
                                                                        if (t.difficulty === 'Hard') diffClass = 'bg-rose-500/10 text-rose-600 border-rose-500/20';
                                                                    %>
                                                                    <span class="text-[9px] font-medium px-1.5 py-0.2 rounded border <%= diffClass %>"><%= t.difficulty || 'Medium' %></span>
                                                                </div>
                                                                <% if (t.description) { %>
                                                                    <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1 font-normal"><%= t.description %></p>
                                                                <% } %>
                                                                <% if (t.subTopics && t.subTopics.length > 0) { %>
                                                                    <div class="mt-2 pl-2.5 border-l-2 border-primary/40 space-y-1">
                                                                        <div class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                                                            <span class="material-symbols-rounded text-xs text-primary">subdirectory_arrow_right</span>
                                                                            <span>Sub-topics (<%= t.subTopics.length %>):</span>
                                                                        </div>
                                                                        <div class="flex flex-wrap gap-1 pt-0.5">
                                                                            <% t.subTopics.forEach(st => { %>
                                                                                <span class="inline-flex items-center text-[10px] px-2 py-0.5 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                                                                    <span class="size-1 rounded-full bg-primary mr-1"></span>
                                                                                    <%= st %>
                                                                                </span>
                                                                            <% }) %>
                                                                        </div>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="flex items-center shrink-0 gap-1">
                                                            <!-- Edit Topic Button -->
                                                            <button type="button" 
                                                                    onclick="openUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify(t.name) %>, <%= JSON.stringify(t.subject || ch.subject) %>, '<%= t._id %>', <%= JSON.stringify(t.subTopics || []) %>, <%= JSON.stringify(t.segment || ch.segment || '') %>, <%= JSON.stringify(t.code || '') %>, <%= JSON.stringify(t.difficulty || 'Medium') %>, <%= JSON.stringify(t.description || '') %>)" 
                                                                    class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-slate-400 hover:text-amber-600 flex items-center justify-center transition-colors" 
                                                                    title="Edit Topic & Submit for Approval">
                                                                <span class="material-symbols-rounded text-base">edit</span>
                                                            </button>

                                                            <% if (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') { %>
                                                                <button type="button" 
                                                                        onclick="cancelDeletionRequest('<%= t._id %>', <%= JSON.stringify(t.name) %>)" 
                                                                        class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center transition-colors" 
                                                                        title="Deletion Requested: <%= t.deletionRequest.reason || '' %> (Click to cancel)">
                                                                    <span class="material-symbols-rounded text-base">hourglass_top</span>
                                                                </button>
                                                            <% } else if (t.deletionRequest && t.deletionRequest.status === 'declined') { %>
                                                                <button type="button" 
                                                                        onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" 
                                                                        class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center transition-colors" 
                                                                        title="Declined: <%= t.deletionRequest?.declinedReason || '' %> (Click to re-request deletion)">
                                                                    <span class="material-symbols-rounded text-base">error_outline</span>
                                                                </button>
                                                            <% } else { %>
                                                                <button type="button" 
                                                                        onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" 
                                                                        class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors" 
                                                                        title="Request to Delete">
                                                                    <span class="material-symbols-rounded text-base">delete</span>
                                                                </button>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                </div>

                <!-- 3. MY SUBMISSIONS VIEW (PENDING & FEEDBACK) -->
                <div id="submissionsTopicsView" class="p-3 sm:p-4 hidden space-y-3">
                    <!-- Filter Toolbar -->
                    <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800/80 rounded-lg p-2.5 sm:px-3 sm:py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 shadow-xs">
                        <!-- Status Filter Options (Scrollable on small screens) -->
                        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 sm:pb-0 max-w-full -mx-1 px-1 sm:mx-0 sm:px-0" id="submissionFilterTabs">
                            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-1 flex items-center gap-1 shrink-0">
                                <span class="material-symbols-rounded text-[16px]">filter_list</span>
                                Filter:
                            </span>

                            <!-- All Filter Button -->
                            <button type="button" onclick="filterSubmissions('all')" id="filterSubBtn_all"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1.5 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 shadow-xs">
                                <span>All</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20 dark:bg-slate-900/20 font-bold"><%= safeSubmissions.length %></span>
                            </button>

                            <!-- Pending Filter Button -->
                            <button type="button" onclick="filterSubmissions('pending')" id="filterSubBtn_pending"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-amber-500"></span>
                                <span>Pending Approval</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400"><%= safePendingTopics.length %></span>
                            </button>

                            <!-- Needs Revision Filter Button -->
                            <button type="button" onclick="filterSubmissions('rejected')" id="filterSubBtn_rejected"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-rose-500"></span>
                                <span>Needs Revision</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"><%= safeRejectedTopics.length %></span>
                            </button>

                            <!-- Approved Filter Button -->
                            <button type="button" onclick="filterSubmissions('approved')" id="filterSubBtn_approved"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-emerald-500"></span>
                                <span>Approved & Live</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"><%= safeApprovedTopics.length %></span>
                            </button>

                            <!-- Deletion Requested Filter Button -->
                            <button type="button" onclick="filterSubmissions('deletion')" id="filterSubBtn_deletion"
                                    class="sub-filter-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                                <span class="size-2 rounded-full bg-rose-500"></span>
                                <span>Deletion Requested</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"><%= safeDeletionCount %></span>
                            </button>
                        </div>

                        <!-- Right Actions -->
                        <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
                            <button type="button" onclick="toggleSelectAllSubmissions()" id="btnToggleSelectAllSub" class="h-7 px-2.5 rounded bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs font-medium flex items-center gap-1 shadow-xs transition-colors">
                                <span class="material-symbols-rounded text-sm">select_all</span>
                                <span id="textToggleSelectAllSub">Select All</span>
                            </button>
                            <button type="button" onclick="toggleAllSubmissionChapters()" id="btnToggleAllSubChapters" class="h-7 px-2.5 rounded bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs font-medium flex items-center gap-1 shadow-xs transition-colors">
                                <span class="material-symbols-rounded text-sm" id="iconToggleAllSubChapters">unfold_less</span>
                                <span id="textToggleAllSubChapters">Collapse All</span>
                            </button>
                        </div>
                    </div>

                    <% if (safeSubmissionChapters.length === 0) { %>
                        <div class="bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 p-10 text-center shadow-xs">
                            <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-2">send_and_archive</span>
                            <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Submissions Found</h4>
                            <p class="text-[11px] text-slate-500 mt-1 max-w-sm mx-auto font-normal">You haven't submitted any chapters or topics yet. Click the "+ Add Topics" button above to submit topics for Admin approval.</p>
                            <button type="button" onclick="openUnifiedModal('', 1, '', '', '', [], '<%= (selSegment !== 'all') ? selSegment : '' %>')" class="mt-3.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-primary hover:bg-primary/90 text-white text-xs font-medium transition-colors shadow-xs">
                                <span class="material-symbols-rounded text-sm">add</span> Add Topics
                            </button>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% safeSubmissionChapters.forEach((ch, sIdx) => { 
                                const chPending = ch.topics.filter(t => t.status === 'pending');
                                const chRejected = ch.topics.filter(t => t.status === 'rejected');
                                const chApproved = ch.topics.filter(t => t.status === 'approved');
                            %>
                                <div class="submission-chapter-card bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 overflow-hidden shadow-xs">
                                    <!-- Chapter Header with Expand / Collapse Accordion -->
                                    <div class="px-3 sm:px-3.5 py-2.5 bg-slate-50/80 dark:bg-slate-900/60 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-2 cursor-pointer select-none" onclick="toggleChapterAccordion('sub_ch_<%= sIdx %>')">
                                        <div class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1">
                                            <% if (chApproved.length === 0 && (chPending.length > 0 || chRejected.length > 0)) { %>
                                                <div class="shrink-0" onclick="event.stopPropagation()">
                                                    <input type="checkbox" id="sub_ch_cb_<%= sIdx %>" class="sub-chapter-cb size-3.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer" title="Select all selectable topics in this chapter" onchange="toggleChapterSubmissions(this, <%= sIdx %>)">
                                                </div>
                                            <% } %>
                                            <span class="size-6 rounded bg-primary/10 text-primary font-semibold text-xs flex items-center justify-center shrink-0">
                                                <%= ch.number || (sIdx + 1) %>
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100 leading-snug break-words m-0 p-0">
                                                    <%= ch.name %>
                                                </h4>
                                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal block sm:inline sm:ml-1">
                                                    (<%= ch.topics.length %> Topics)
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Chapter Status Breakdown & Expand Button -->
                                        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0" onclick="event.stopPropagation()">
                                            <div class="flex items-center gap-1 text-[10px]">
                                                <% if (chPending.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                        <span><%= chPending.length %></span> <span class="hidden sm:inline">Pending</span>
                                                    </span>
                                                <% } %>
                                                <% if (chRejected.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                        <span><%= chRejected.length %></span> <span class="hidden sm:inline">Revision</span>
                                                    </span>
                                                <% } %>
                                                <% if (chApproved.length > 0) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded font-medium bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                        <span><%= chApproved.length %></span> <span class="hidden sm:inline">Live</span>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <% const chSelectable = ch.topics.filter(t => t.status === 'pending' || t.status === 'rejected'); %>
                                            <% const chApprovedTopicIds = chApproved.map(t => t._id); %>
                                            <% const chPendingDeletion = chApproved.filter(t => t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending'); %>
                                            <% if (chApproved.length > 0) { %>
                                                <% if (chPendingDeletion.length > 0) { %>
                                                    <button type="button" 
                                                            onclick="cancelDeletionRequest(<%= JSON.stringify(chPendingDeletion.map(t => t._id)) %>, <%= JSON.stringify(ch.name) %>, 'chapter')" 
                                                            class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center transition-colors shrink-0" 
                                                            title="Deletion requested for <%= chPendingDeletion.length %> topic(s) (Click to cancel request / অনুরোধ প্রত্যাহার)">
                                                        <span class="material-symbols-rounded text-base">hourglass_top</span>
                                                    </button>
                                                <% } %>
                                                <% const chRemainingApprovedIds = chApproved.filter(t => !(t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending')).map(t => t._id); %>
                                                <% if (chRemainingApprovedIds.length > 0) { %>
                                                    <button type="button" 
                                                            onclick="openRequestDeleteModal(<%= JSON.stringify(ch.name) %>, <%= JSON.stringify(chRemainingApprovedIds) %>, 'chapter')" 
                                                            class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors shrink-0" 
                                                            title="Request to Delete Chapter<%= chPendingDeletion.length > 0 ? ' (' + chRemainingApprovedIds.length + ' remaining)' : '' %>">
                                                        <span class="material-symbols-rounded text-base">delete_sweep</span>
                                                    </button>
                                                <% } %>
                                            <% } else if (chSelectable.length > 0) { %>
                                                <!-- Delete Chapter Submissions Button (only if NO approved topics exist in this chapter) -->
                                                <button type="button" 
                                                        onclick="deleteChapterSubmissions(<%= JSON.stringify(ch.name) %>, <%= chSelectable.length %>, <%= JSON.stringify(chSelectable.map(t => t._id)) %>)" 
                                                        class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors shrink-0" 
                                                        title="Delete all <%= chSelectable.length %> unapproved submission(s) in chapter <%= ch.name %>">
                                                    <span class="material-symbols-rounded text-base">delete</span>
                                                </button>
                                            <% } %>

                                            <!-- Edit Chapter & Manage Topics Button (Opens Full Form) -->
                                            <button type="button" 
                                                    onclick="openChapterEditUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || (sIdx + 1) %>, <%= JSON.stringify((ch.topics || []).map(t => ({ id: t._id, name: t.name, code: t.code || '', difficulty: t.difficulty || 'Medium', description: t.description || '', subTopics: t.subTopics || [] }))) %>, <%= JSON.stringify(ch.segment || '') %>)" 
                                                    class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-slate-400 hover:text-amber-600 dark:hover:text-amber-400 flex items-center justify-center transition-colors shrink-0" 
                                                    title="Edit Chapter Name & Add/Manage Topics">
                                                <span class="material-symbols-rounded text-base">edit</span>
                                            </button>

                                            <!-- Expand / Collapse Chevron Button -->
                                            <button type="button" onclick="toggleChapterAccordion('sub_ch_<%= sIdx %>')" class="size-7 rounded hover:bg-slate-200/50 dark:hover:bg-slate-800 flex items-center justify-center text-slate-400 shrink-0" title="Expand / Collapse Chapter">
                                                <span id="icon_sub_ch_<%= sIdx %>" class="material-symbols-rounded text-base transition-transform duration-200">expand_more</span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Topics Inside Chapter Content (Collapsible) -->
                                    <div id="content_sub_ch_<%= sIdx %>" class="submission-chapter-content transition-all">
                                        <!-- MOBILE CARD VIEW (VISIBLE ON < md SCREENS) -->
                                        <div class="block md:hidden divide-y divide-slate-100 dark:divide-slate-800/60">
                                            <% ch.topics.forEach((t, tIdx) => { 
                                                const diff = (t.difficulty || 'Medium').toLowerCase();
                                                let diffColor = 'text-slate-600 bg-slate-100 dark:bg-slate-800 dark:text-slate-300';
                                                if (diff === 'easy') diffColor = 'text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40';
                                                else if (diff === 'hard') diffColor = 'text-purple-700 bg-purple-50 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40';
                                                else diffColor = 'text-amber-700 bg-amber-50 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40';
                                            %>
                                                <div class="submission-topic-row p-3 space-y-2.5 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-900/30" data-status="<%= t.status %>" data-deletion-status="<%= (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') ? 'pending' : (t.deletionRequest?.status || 'none') %>" data-id="<%= t._id %>">
                                                    <!-- Top Line: #, Topic Name & Difficulty -->
                                                    <div class="flex items-start justify-between gap-2">
                                                        <div class="flex items-start gap-2 min-w-0">
                                                            <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                                <input type="checkbox" class="sub-topic-checkbox sub-ch-<%= sIdx %> size-3.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer mt-0.5 shrink-0" data-id="<%= t._id %>" data-status="<%= t.status %>" data-name="<%= t.name %>" data-ch-idx="<%= sIdx %>" onchange="onSubCheckboxChange(this)">
                                                            <% } %>
                                                            <span class="size-5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono text-[10px] flex items-center justify-center shrink-0 mt-0.5">
                                                                <%= tIdx + 1 %>
                                                            </span>
                                                            <div class="min-w-0">
                                                                <h5 class="text-xs font-semibold text-slate-800 dark:text-slate-100 break-words leading-snug">
                                                                    <%= t.name %>
                                                                </h5>
                                                                <div class="flex items-center gap-1.5 flex-wrap mt-1 text-[10px] text-slate-500 dark:text-slate-400">
                                                                    <span class="inline-block px-1.5 py-0.2 rounded font-medium bg-primary/10 text-primary">
                                                                        <%= t.classLevel || ch.classLevel %>
                                                                    </span>
                                                                    <span>•</span>
                                                                    <span class="font-medium text-slate-600 dark:text-slate-300">
                                                                        <%= t.subject || ch.subject %>
                                                                    </span>
                                                                    <% if (t.group && t.group !== 'all' && t.group !== 'None') { %>
                                                                        <span>•</span>
                                                                        <span class="text-slate-400"><%= t.group %></span>
                                                                    <% } %>
                                                                </div>
                                                                <% if (t.subTopics && t.subTopics.length > 0) { %>
                                                                    <div class="mt-2 pl-2.5 border-l-2 border-primary/40 space-y-1">
                                                                        <div class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                                                            <span class="material-symbols-rounded text-xs text-primary">subdirectory_arrow_right</span>
                                                                            <span>Sub-topics (<%= t.subTopics.length %>):</span>
                                                                        </div>
                                                                        <div class="flex flex-wrap gap-1 pt-0.5">
                                                                            <% t.subTopics.forEach(st => { %>
                                                                                <span class="inline-flex items-center text-[10px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                                                                                    <span class="size-1 rounded-full bg-primary mr-1"></span>
                                                                                    <%= st %>
                                                                                </span>
                                                                            <% }) %>
                                                                        </div>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium shrink-0 <%= diffColor %>">
                                                            <%= t.difficulty || 'Medium' %>
                                                        </span>
                                                    </div>

                                                    <!-- Status & Date -->
                                                    <div class="flex items-center justify-between gap-2 flex-wrap pt-0.5 text-[11px]">
                                                        <div>
                                                            <% if (t.status === 'pending') { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                                    Pending Approval
                                                                </span>
                                                            <% } else if (t.status === 'rejected') { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                                    <span class="material-symbols-rounded text-xs">error</span>
                                                                    Revision Required
                                                                </span>
                                                            <% } else { %>
                                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                                    <span class="material-symbols-rounded text-xs">check_circle</span>
                                                                    Approved & Live
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <span class="text-slate-400 text-[10px]">
                                                            <%= new Date(t.createdAt).toLocaleDateString() %>
                                                        </span>
                                                    </div>

                                                    <!-- Admin Feedback Box (when rejected) -->
                                                    <% if (t.status === 'rejected') { %>
                                                        <div class="p-2 rounded-md bg-rose-50 dark:bg-rose-950/30 border border-rose-200/80 dark:border-rose-900/50 text-[11px] text-rose-700 dark:text-rose-300 flex items-start gap-1.5">
                                                            <span class="material-symbols-rounded text-xs shrink-0 mt-0.5">feedback</span>
                                                            <div class="min-w-0 flex-1">
                                                                <span class="font-semibold block text-[10px] uppercase tracking-wide text-rose-800 dark:text-rose-200">Admin Feedback:</span>
                                                                <span><%= t.rejectionReason || 'Please review syllabus alignment and resubmit.' %></span>
                                                            </div>
                                                        </div>
                                                    <% } %>

                                                    <!-- Mobile Card Actions Footer -->
                                                    <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800/60">
                                                        <div class="text-[10px] text-slate-400">
                                                            <% if (t.status === 'approved') { %>
                                                                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-medium">
                                                                    <span class="material-symbols-rounded text-xs">verified</span> Live in syllabus
                                                                </span>
                                                            <% } else if (t.status === 'pending') { %>
                                                                <span class="italic">Awaiting Admin review</span>
                                                            <% } %>
                                                        </div>

                                                        <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                            <div class="inline-flex items-center gap-1.5">
                                                                <button type="button" onclick="openUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify(t.name) %>, <%= JSON.stringify(t.subject || ch.subject) %>, '<%= t._id %>', <%= JSON.stringify(t.subTopics || []) %>, <%= JSON.stringify(t.segment || ch.segment || '') %>, <%= JSON.stringify(t.code || '') %>, <%= JSON.stringify(t.difficulty || 'Medium') %>, <%= JSON.stringify(t.description || '') %>)" 
                                                                        class="h-7 px-3 rounded-md bg-primary/10 hover:bg-primary text-primary hover:text-white text-xs font-medium transition-colors inline-flex items-center gap-1">
                                                                    <span class="material-symbols-rounded text-xs">edit</span>
                                                                    <span><%= t.status === 'rejected' ? 'Resubmit' : 'Edit' %></span>
                                                                </button>
                                                                <button type="button" onclick="cancelPendingTopic('<%= t._id %>', <%= JSON.stringify(t.name) %>)" 
                                                                        class="h-7 px-2.5 rounded-md hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 transition-colors inline-flex items-center gap-1 text-xs">
                                                                    <span class="material-symbols-rounded text-xs">delete</span>
                                                                    <span>Delete</span>
                                                                </button>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="inline-flex items-center shrink-0">
                                                                <% if (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') { %>
                                                                    <button type="button" onclick="cancelDeletionRequest('<%= t._id %>', <%= JSON.stringify(t.name) %>)" class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center transition-colors" title="Deletion Requested (Click to cancel)">
                                                                        <span class="material-symbols-rounded text-base">hourglass_top</span>
                                                                    </button>
                                                                <% } else if (t.deletionRequest && t.deletionRequest.status === 'declined') { %>
                                                                    <button type="button" onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center transition-colors" title="Declined: <%= t.deletionRequest?.declinedReason || '' %> (Click to re-request)">
                                                                        <span class="material-symbols-rounded text-base">error_outline</span>
                                                                    </button>
                                                                <% } else { %>
                                                                    <button type="button" onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors" title="Request to Delete">
                                                                        <span class="material-symbols-rounded text-base">delete</span>
                                                                    </button>
                                                                <% } %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>

                                        <!-- DESKTOP TABLE VIEW (VISIBLE ON >= md SCREENS) -->
                                        <div class="hidden md:block overflow-x-auto">
                                            <table class="w-full min-w-[760px] text-left text-xs">
                                                <thead class="bg-slate-50/50 dark:bg-slate-900/30 text-slate-400 text-[10px] uppercase font-semibold border-b border-slate-100 dark:border-slate-800/60">
                                                    <tr>
                                                        <th class="py-2 px-3 w-10 text-center">
                                                            <% if (chApproved.length === 0 && (chPending.length > 0 || chRejected.length > 0)) { %>
                                                                <input type="checkbox" id="sub_ch_table_cb_<%= sIdx %>" class="sub-ch-table-header-cb size-3.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer" title="Select all selectable in this chapter" onchange="toggleChapterSubmissions(this, <%= sIdx %>)">
                                                            <% } else { %>
                                                                #
                                                            <% } %>
                                                        </th>
                                                        <th class="py-2 px-3">Topic Name</th>
                                                        <th class="py-2 px-3 w-28">Class</th>
                                                        <th class="py-2 px-3 w-32">Subject</th>
                                                        <th class="py-2 px-3 w-24">Difficulty</th>
                                                        <th class="py-2 px-3 w-36">Status</th>
                                                        <th class="py-2 px-3">Admin Feedback / Reason</th>
                                                        <th class="py-2 px-3 w-28">Submitted</th>
                                                        <th class="py-2 px-3 w-24 text-right">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                                                    <% ch.topics.forEach((t, tIdx) => { 
                                                        const diff = (t.difficulty || 'Medium').toLowerCase();
                                                        let diffColor = 'text-slate-600 bg-slate-100 dark:bg-slate-800 dark:text-slate-300';
                                                        if (diff === 'easy') diffColor = 'text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40';
                                                        else if (diff === 'hard') diffColor = 'text-purple-700 bg-purple-50 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40';
                                                        else diffColor = 'text-amber-700 bg-amber-50 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40';
                                                    %>
                                                        <tr class="submission-topic-row hover:bg-slate-50/60 dark:hover:bg-slate-900/40 transition-colors" data-status="<%= t.status %>" data-deletion-status="<%= (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') ? 'pending' : (t.deletionRequest?.status || 'none') %>" data-id="<%= t._id %>">
                                                            <td class="py-2.5 px-3 text-center">
                                                                <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                                    <input type="checkbox" class="sub-topic-checkbox sub-ch-<%= sIdx %> size-3.5 rounded border-slate-300 dark:border-slate-700 text-primary focus:ring-0 cursor-pointer" data-id="<%= t._id %>" data-status="<%= t.status %>" data-name="<%= t.name %>" data-ch-idx="<%= sIdx %>" onchange="onSubCheckboxChange(this)">
                                                                <% } else { %>
                                                                    <span class="text-slate-400 font-mono text-[11px]"><%= tIdx + 1 %></span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="font-medium text-slate-800 dark:text-slate-100 text-xs">
                                                                    <%= t.name %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-primary/10 text-primary">
                                                                    <%= t.classLevel || ch.classLevel %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="font-medium text-slate-700 dark:text-slate-300 text-xs">
                                                                    <%= t.subject || ch.subject %>
                                                                </span>
                                                                <% if (t.group && t.group !== 'all' && t.group !== 'None') { %>
                                                                    <span class="text-[10px] text-slate-400 block"><%= t.group %></span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium <%= diffColor %>">
                                                                    <%= t.difficulty || 'Medium' %>
                                                                </span>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <% if (t.status === 'pending') { %>
                                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20">
                                                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                                                        Pending Approval
                                                                    </span>
                                                                <% } else if (t.status === 'rejected') { %>
                                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-600 border border-rose-500/20">
                                                                        <span class="material-symbols-rounded text-xs">error</span>
                                                                        Revision Required
                                                                    </span>
                                                                <% } else { %>
                                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                                        <span class="material-symbols-rounded text-xs">check_circle</span>
                                                                        Approved & Live
                                                                    </span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3">
                                                                <% if (t.status === 'rejected') { %>
                                                                    <div class="text-[11px] text-rose-600 dark:text-rose-400 font-medium flex items-center gap-1">
                                                                        <span class="material-symbols-rounded text-xs shrink-0">feedback</span>
                                                                        <span><%= t.rejectionReason || 'Please review syllabus alignment.' %></span>
                                                                    </div>
                                                                <% } else if (t.status === 'pending') { %>
                                                                    <span class="text-slate-400 text-[11px] italic">Awaiting Admin review</span>
                                                                <% } else { %>
                                                                    <span class="text-emerald-600 text-[11px] flex items-center gap-1">
                                                                        <span class="material-symbols-rounded text-xs">verified</span>
                                                                        Live in syllabus
                                                                    </span>
                                                                <% } %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-slate-400 text-[11px]">
                                                                <%= new Date(t.createdAt).toLocaleDateString() %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-right">
                                                                <% if (t.status === 'pending' || t.status === 'rejected') { %>
                                                                    <div class="inline-flex items-center justify-end gap-1.5">
                                                                        <button type="button" onclick="openUnifiedModal(<%= JSON.stringify(ch.name) %>, <%= ch.number || 1 %>, <%= JSON.stringify(t.name) %>, <%= JSON.stringify(t.subject || ch.subject) %>, '<%= t._id %>', <%= JSON.stringify(t.subTopics || []) %>, <%= JSON.stringify(t.segment || ch.segment || '') %>, <%= JSON.stringify(t.code || '') %>, <%= JSON.stringify(t.difficulty || 'Medium') %>, <%= JSON.stringify(t.description || '') %>)" class="h-6 px-2.5 rounded bg-primary/10 hover:bg-primary text-primary hover:text-white text-[11px] font-medium transition-colors inline-flex items-center gap-1" title="<%= t.status === 'rejected' ? 'Resubmit rejected topic' : 'Edit submission' %>">
                                                                            <span class="material-symbols-rounded text-xs">edit</span>
                                                                            <span><%= t.status === 'rejected' ? 'Resubmit' : 'Edit' %></span>
                                                                        </button>
                                                                        <button type="button" onclick="cancelPendingTopic('<%= t._id %>', <%= JSON.stringify(t.name) %>)" class="size-6 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors" title="Delete submission">
                                                                            <span class="material-symbols-rounded text-xs">delete</span>
                                                                        </button>
                                                                    </div>
                                                                <% } else { %>
                                                                    <div class="inline-flex items-center justify-end shrink-0">
                                                                        <% if (t.deletionRequest && t.deletionRequest.isRequested && t.deletionRequest.status === 'pending') { %>
                                                                            <button type="button" onclick="cancelDeletionRequest('<%= t._id %>', <%= JSON.stringify(t.name) %>)" class="size-7 rounded hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center transition-colors" title="Deletion Requested (Click to cancel)">
                                                                                <span class="material-symbols-rounded text-base">hourglass_top</span>
                                                                            </button>
                                                                        <% } else if (t.deletionRequest && t.deletionRequest.status === 'declined') { %>
                                                                            <button type="button" onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center transition-colors" title="Declined: <%= t.deletionRequest?.declinedReason || '' %> (Click to re-request)">
                                                                                <span class="material-symbols-rounded text-base">error_outline</span>
                                                                            </button>
                                                                        <% } else { %>
                                                                            <button type="button" onclick="openRequestDeleteModal(<%= JSON.stringify(t.name) %>, ['<%= t._id %>'], 'topic')" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition-colors" title="Request to Delete">
                                                                                <span class="material-symbols-rounded text-base">delete</span>
                                                                            </button>
                                                                        <% } %>
                                                                    </div>
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Filter Empty State -->
                        <div id="submissionsFilterEmptyNotice" class="hidden bg-white dark:bg-[#0f172a] rounded-md border border-slate-200 dark:border-slate-800/80 p-8 text-center shadow-xs">
                            <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600 mb-1.5">filter_list_off</span>
                            <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">No Matching Topics</h4>
                            <p class="text-[11px] text-slate-500 mt-0.5">There are no topic submissions matching status: <strong id="emptyFilterStatusLabel" class="text-primary font-semibold"></strong>.</p>
                            <button type="button" onclick="filterSubmissions('all')" class="mt-2.5 inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 transition-colors">
                                <span class="material-symbols-rounded text-sm">replay</span> View All Submissions
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <!-- FLOATING BULK ACTION BAR (TEACHER SUBMISSIONS MULTI-SELECT) -->
    <div id="submissionsBulkBar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-slate-900/95 dark:bg-slate-800/95 text-white px-4 py-2.5 rounded-lg shadow-2xl border border-slate-700/80 flex items-center gap-3 backdrop-blur-md transition-all duration-200 hidden">
        <div class="flex items-center gap-2">
            <span class="size-5 rounded-full bg-primary flex items-center justify-center text-[10px] font-bold text-white shadow-xs" id="subSelectedCount">0</span>
            <span class="text-xs font-medium text-slate-200">Selected</span>
        </div>
        <div class="h-4 w-px bg-slate-700"></div>

        <!-- Bulk Resubmit (shown when rejected topics are selected) -->
        <button type="button" id="btnBulkResubmit" onclick="bulkActionSubmissions('resubmit')" class="h-7 px-3 rounded bg-amber-600 hover:bg-amber-500 text-white text-xs font-medium flex items-center gap-1.5 transition-colors shadow-xs hidden">
            <span class="material-symbols-rounded text-sm">replay</span>
            <span id="btnBulkResubmitText">Resubmit for Review</span>
        </button>

        <!-- Bulk Delete / Withdraw (for pending and rejected) -->
        <button type="button" id="btnBulkDelete" onclick="bulkActionSubmissions('delete')" class="h-7 px-3 rounded bg-rose-600 hover:bg-rose-500 text-white text-xs font-medium flex items-center gap-1.5 transition-colors shadow-xs">
            <span class="material-symbols-rounded text-sm">delete</span>
            <span id="btnBulkDeleteText">Delete Selected</span>
        </button>

        <div class="h-4 w-px bg-slate-700"></div>
        <button type="button" onclick="clearSelectedSubmissions()" class="text-xs text-slate-400 hover:text-white transition-colors cursor-pointer">
            Clear
        </button>
    </div>

    <!-- Datalist for Existing Chapters Suggestion -->
    <datalist id="existingChaptersList">
        <% safeChapters.forEach(ch => { %>
            <option value="<%= ch.name %>">
        <% }) %>
    </datalist>

    <!-- UNIFIED MODAL: ADD TOPICS FOR TEACHER -->
    <div id="unifiedTopicModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-[#0f172a] rounded-lg border border-slate-200 dark:border-slate-800 max-w-xl w-full max-h-[92vh] overflow-y-auto p-4 sm:p-5 space-y-4 shadow-xl">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-rounded text-primary text-xl">account_tree</span>
                    <div>
                        <h3 id="unifiedModalTitle" class="text-sm font-semibold text-slate-800 dark:text-slate-100">Add Topics</h3>
                        <p id="unifiedModalSubtitle" class="text-[10px] text-slate-400">Step 1: Enter chapter details and topics.</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('unifiedTopicModal')" class="size-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 flex items-center justify-center">
                    <span class="material-symbols-rounded text-base">close</span>
                </button>
            </div>

            <!-- Two-Step Progress Indicator -->
            <div class="flex items-center justify-between px-1 text-xs">
                <div class="flex items-center gap-1.5 font-semibold text-primary transition-all" id="step1Indicator">
                    <span class="size-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold" id="step1Badge">1</span>
                    <span id="step1Label">Chapter & Topics</span>
                </div>
                <div class="h-0.5 flex-1 mx-3 bg-slate-200 dark:bg-slate-700 transition-colors" id="stepProgressLine"></div>
                <div class="flex items-center gap-1.5 font-medium text-slate-400 transition-all" id="step2Indicator">
                    <span class="size-5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-500 flex items-center justify-center text-[10px] font-bold" id="step2Badge">2</span>
                    <span id="step2Label">Sub-topics & Approval</span>
                </div>
            </div>

            <!-- Unified Form -->
            <form id="unifiedTopicForm" onsubmit="submitTeacherTopicForm(event)" class="space-y-3">
                <input type="hidden" name="group" value="<%= selGroup %>">
                <input type="hidden" name="topicId" id="unifiedTopicId" value="">
                <input type="hidden" name="oldChapterName" id="unifiedOldChapterName" value="">
                <input type="hidden" name="oldChapterNumber" id="unifiedOldChapterNumber" value="">
                <input type="hidden" name="isChapterEdit" id="unifiedIsChapterEdit" value="false">

                <!-- STEP 1 CONTAINER: TOPICS ENTRY -->
                <div id="unifiedStep1Container" class="space-y-3">
                    <!-- Mode Switcher (Single vs Bulk) -->
                    <div id="unifiedModeTabs" class="flex items-center p-1 rounded-md bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60">
                        <button type="button" id="tabModeSingle" onclick="setTopicMode('single')"
                                class="flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs">
                            Single Topic
                        </button>
                        <button type="button" id="tabModeBulk" onclick="setTopicMode('bulk')"
                                class="flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">
                            Bulk Topics
                        </button>
                    </div>

                    <!-- Academic Scope Indicator (Multi-Class & Subject) -->
                    <div class="space-y-1.5 p-2.5 rounded-md bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
                        <div class="flex items-center justify-between flex-wrap gap-1">
                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-200 flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm text-primary">school</span>
                                <span>Target Classes *</span>
                                <span class="text-[10px] text-slate-400 font-normal">(Select one or more classes)</span>
                            </label>
                            <% if (safeClasses.length > 1) { %>
                            <div class="flex items-center gap-1 text-[10px]">
                                <button type="button" onclick="selectTeacherModalClasses('all')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-primary hover:text-white transition-all font-medium">All</button>
                                <button type="button" onclick="selectTeacherModalClasses('clear')" class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 hover:bg-rose-500 hover:text-white transition-all font-medium">Clear</button>
                            </div>
                            <% } %>
                        </div>
                        <div id="teacherModalClassGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 pt-1">
                            <% safeClasses.forEach(c => { 
                                const cName = (c && c.name) ? c.name : String(c || '');
                                const isChecked = selClass ? cName.toLowerCase() === selClass.toLowerCase() : true;
                            %>
                                <label class="flex items-center gap-1.5 p-1.5 rounded border border-slate-200 dark:border-slate-700 hover:border-primary/50 cursor-pointer bg-white dark:bg-slate-900 text-xs transition-colors select-none">
                                    <input type="checkbox" name="targetClass" value="<%= cName %>" <%= isChecked ? 'checked' : '' %> class="size-3.5 accent-primary rounded cursor-pointer">
                                    <span class="font-medium text-slate-800 dark:text-slate-200 truncate"><%= cName %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div>
                        <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Subject *</label>
                        <% if (availSubjects.length > 1) { %>
                            <select name="subject" id="unifiedSubjectSelect" onchange="onModalSubjectChange(this.value)" class="w-full h-9 px-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium outline-none focus:border-primary cursor-pointer">
                                <% availSubjects.forEach(s => { %>
                                    <option value="<%= s %>" <%= (s.toLowerCase() === selSubject.toLowerCase()) ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                        <% } else if (availSubjects.length === 1) { %>
                            <input type="text" name="subject" id="unifiedSubjectSelect" value="<%= selSubject %>" readonly class="w-full h-9 px-3 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none cursor-default">
                        <% } else { %>
                            <input type="text" name="subject" id="unifiedSubjectSelect" placeholder="Enter subject name" required class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                        <% } %>
                    </div>

                    <!-- Segment Selection (Shows when Subject has segmentation rules) -->
                    <div id="unifiedModalSegmentWrap" class="space-y-1 hidden">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-200 flex items-center justify-between">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm text-indigo-500">segment</span>
                                <span>Subject Segment / বিভাগ <span class="text-rose-500">*</span></span>
                            </span>
                            <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-semibold">Ruled Subject</span>
                        </label>
                        <select id="unifiedSegmentSelect" name="segment" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium outline-none focus:border-indigo-500 cursor-pointer">
                            <option value="">Select Segment...</option>
                        </select>
                    </div>

                    <!-- Chapter Details -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <div class="sm:col-span-2">
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Chapter Name *</label>
                            <input type="text" id="unifiedChapterName" name="chapterName" list="existingChaptersList" required placeholder="Chapter name" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary transition-colors" oninput="checkChapterConflict()">
                        </div>
                        <div>
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Ch Number *</label>
                            <input type="number" id="unifiedChapterNumber" name="chapterNumber" value="1" min="1" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary transition-colors" oninput="checkChapterConflict()">
                        </div>
                    </div>

                    <!-- Live Chapter Conflict / Match Indicator -->
                    <div id="chapterConflictNotice" class="hidden rounded-md p-2.5 text-xs flex items-center gap-2 transition-all">
                        <span id="chapterConflictIcon" class="material-symbols-rounded text-base shrink-0"></span>
                        <span id="chapterConflictText" class="text-[11px] font-medium leading-tight"></span>
                    </div>

                    <!-- SINGLE TOPIC MODE FIELDS -->
                    <div id="singleTopicFields" class="space-y-3">
                        <div>
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Topic Name *</label>
                            <input type="text" id="singleTopicName" name="name" placeholder="Topic name" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div>
                                <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Difficulty</label>
                                <select id="singleDifficulty" name="difficulty" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                                    <option value="Easy">Easy</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="Hard">Hard</option>
                                </select>
                            </div>
                            <div>
                                <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Topic Code (Optional)</label>
                                <input type="text" id="singleTopicCode" name="code" placeholder="Code" class="w-full h-9 px-3 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                            </div>
                        </div>

                        <div>
                            <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400 block mb-1">Description (Optional)</label>
                            <textarea id="singleDescription" name="description" rows="2" placeholder="Brief topic overview" class="w-full p-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y"></textarea>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400">Sub-topics (Optional - One per line)</label>
                                <span class="text-[10px] text-slate-400">Per sub-topic one line</span>
                            </div>
                            <textarea id="singleSubTopics" name="singleSubTopics" rows="2.5" placeholder="Enter sub-topics (one per line)&#10;e.g.&#10;গতি ও স্থিতি&#10;ত্বরণ ও মন্দন&#10;গতির সমীকরণ" class="w-full p-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y font-sans leading-relaxed"></textarea>
                        </div>
                    </div>

                    <!-- BULK TOPICS MODE FIELDS -->
                    <div id="bulkTopicFields" class="space-y-3 hidden">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="text-[11px] font-medium text-slate-600 dark:text-slate-400">
                                    Topic Names (One topic per line) *
                                </label>
                                <button type="button" id="btnLoadChapterTopics" onclick="loadExistingChapterTopics()" class="text-[10px] text-primary hover:underline font-medium flex items-center gap-0.5 hidden">
                                    <span class="material-symbols-rounded text-xs">playlist_add_check</span>
                                    <span>Load Existing Topics (<span id="existingChapterTopicsCount">0</span>)</span>
                                </button>
                            </div>
                            <textarea id="bulkTopicList" name="topicList" rows="5" placeholder="Enter topic names here (one per line)..." class="w-full p-2.5 rounded-md bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y font-sans leading-relaxed"></textarea>
                        </div>
                    </div>

                    <!-- Step 1 Footer: Cancel, Submit Directly, and Next Buttons -->
                    <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <button type="button" onclick="closeModal('unifiedTopicModal')" class="h-9 px-3 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</button>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="submitDirectlyFromStep1()" class="h-9 px-3.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs" title="Submit topics directly without adding sub-topics">
                                <span class="material-symbols-rounded text-sm">send</span>
                                <span>Submit</span>
                            </button>
                            <button type="button" id="unifiedNextBtn" onclick="goToTopicStep(2)" class="h-9 px-3.5 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs" title="Review topics and add sub-topics">
                                <span>Next</span>
                                <span class="material-symbols-rounded text-sm">arrow_forward</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- STEP 2 CONTAINER: TOPICS REVIEW & EXPAND FOR SUB-TOPICS -->
                <div id="unifiedStep2Container" class="space-y-3 hidden">
                    <!-- Scope Context Summary -->
                    <div class="p-3 rounded-md bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between flex-wrap gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 flex-wrap text-xs">
                                <span id="stagedSubjectBadge" class="font-bold text-primary"></span>
                                <span class="text-slate-400">•</span>
                                <span id="stagedChapterBadge" class="font-semibold text-slate-700 dark:text-slate-200"></span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5 font-normal">Click <strong class="font-semibold text-primary">Expand</strong> on any topic to add sub-topics.</p>
                        </div>
                        <span id="stagedTotalBadge" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-primary/10 text-primary border border-primary/20">0 Topics</span>
                    </div>

                    <!-- Dynamic List of Topics with Expandable Sub-topics -->
                    <div id="stagedTopicsList" class="space-y-2.5 max-h-[46vh] overflow-y-auto pr-1"></div>

                    <!-- Add Another Topic Button -->
                    <button type="button" onclick="addAnotherStagedTopicPrompt()" class="w-full py-2 border-2 border-dashed border-slate-200 dark:border-slate-800 hover:border-primary/50 text-slate-600 dark:text-slate-400 hover:text-primary rounded-md text-xs font-medium flex items-center justify-center gap-1.5 transition-all">
                        <span class="material-symbols-rounded text-base">add_circle</span>
                        <span>Add Another Topic</span>
                    </button>

                    <!-- Step 2 Footer: Back and Submit -->
                    <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <button type="button" onclick="goToTopicStep(1)" class="h-9 px-3 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm">arrow_back</span>
                            <span>Back</span>
                        </button>
                        <button type="button" onclick="submitStagedTopics()" id="unifiedFinalSubmitBtn" class="h-9 px-4 rounded-md bg-primary hover:bg-primary-dark text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs">
                            <span class="material-symbols-rounded text-sm">send</span>
                            <span id="unifiedSubmitBtnText">Submit</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const apiBase = '<%= safeApiBase %>';
        const currentClassLevel = '<%= selClass %>';
        const currentSubject = '<%= selSubject %>';
        let currentModalMode = 'single';
        let currentSubjectChapters = <%- JSON.stringify(safeChapters.map(c => ({ name: c.name, number: c.number, segment: c.segment || '' }))) %>;

        function getSelectedModalSubject() {
            const selectEl = document.getElementById('unifiedSubjectSelect');
            if (selectEl && selectEl.value) return selectEl.value;
            const inputEl = document.querySelector('#unifiedTopicForm input[name="subject"]');
            if (inputEl && inputEl.value) return inputEl.value;
            return currentSubject || '';
        }

        async function onModalSubjectChange(newSub) {
            await loadChaptersForSubject(newSub);
            await checkTeacherModalSegments();
            checkChapterConflict();
        }

        async function loadChaptersForSubject(subj) {
            if (!subj || !currentClassLevel) return;
            try {
                const res = await fetch(`${apiBase}/api/chapters?classLevel=${encodeURIComponent(currentClassLevel)}&subject=${encodeURIComponent(subj)}`);
                const data = await res.json();
                if (data && data.success && Array.isArray(data.chapters)) {
                    currentSubjectChapters = data.chapters;
                    const dl = document.getElementById('existingChaptersList');
                    if (dl) {
                        dl.innerHTML = '';
                        currentSubjectChapters.forEach(c => {
                            const opt = document.createElement('option');
                            opt.value = c.name;
                            opt.label = `Ch ${c.number}: ${c.name}`;
                            dl.appendChild(opt);
                        });
                    }
                }
            } catch (err) {
                console.error('Error loading chapters for subject:', err);
            }
        }

        function checkChapterConflict() {
            const chNameInput = document.getElementById('unifiedChapterName');
            const chNumInput = document.getElementById('unifiedChapterNumber');
            const notice = document.getElementById('chapterConflictNotice');
            const noticeIcon = document.getElementById('chapterConflictIcon');
            const noticeText = document.getElementById('chapterConflictText');
            const submitBtn = document.getElementById('unifiedSubmitBtn');

            if (!chNameInput || !chNumInput || !notice) return false;

            const enteredName = chNameInput.value.trim().toLowerCase();
            const enteredNum = parseInt(chNumInput.value, 10);
            const currentSub = getSelectedModalSubject();

            if (!enteredName || isNaN(enteredNum) || enteredNum < 1) {
                notice.classList.add('hidden');
                chNameInput.classList.remove('border-rose-500', 'border-emerald-500', 'border-blue-500');
                chNumInput.classList.remove('border-rose-500', 'border-emerald-500', 'border-blue-500');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                return false;
            }

            // Check chapter number conflict within the same segment (or overall if no segment)
            const curSegment = document.getElementById('unifiedSegmentSelect')?.value.trim();
            const relevantChapters = curSegment 
                ? currentSubjectChapters.filter(ch => (ch.segment || '').toLowerCase() === curSegment.toLowerCase())
                : currentSubjectChapters;
            const existingNumberMatch = relevantChapters.find(ch => parseInt(ch.number, 10) === enteredNum);

            if (existingNumberMatch) {
                const existingChName = (existingNumberMatch.name || '').trim();
                const isExactName = existingChName.toLowerCase() === enteredName;

                if (isExactName) {
                    // Actual chapter name matches - completely valid!
                    notice.className = 'rounded-md p-2 text-xs flex items-center gap-2 bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/40 text-blue-700 dark:text-blue-300';
                    noticeIcon.className = 'material-symbols-rounded text-sm text-blue-600 shrink-0';
                    noticeIcon.textContent = 'folder_open';
                    noticeText.innerHTML = `<strong>Existing Chapter:</strong> Adding to Chapter ${enteredNum}: "<strong>${existingChName}</strong>".`;
                    notice.classList.remove('hidden');

                    chNameInput.classList.remove('border-rose-500');
                    chNumInput.classList.remove('border-rose-500');
                    chNameInput.classList.add('border-blue-500');
                    chNumInput.classList.add('border-blue-500');
                } else {
                    // Chapter number has an existing name in this subject - give helpful info
                    notice.className = 'rounded-md p-2.5 text-xs flex items-center gap-2 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300';
                    noticeIcon.className = 'material-symbols-rounded text-base text-amber-600 shrink-0';
                    noticeIcon.textContent = 'info';
                    noticeText.innerHTML = `Chapter ${enteredNum} is currently named "<strong>${existingChName}</strong>" in ${currentSub}. <button type="button" class="underline font-semibold ml-1 text-primary cursor-pointer" onclick="useExistingChapterName(${enteredNum})">Use "${existingChName}"</button>`;
                    notice.classList.remove('hidden');

                    chNumInput.classList.remove('border-rose-500');
                    chNameInput.classList.remove('border-rose-500');
                }
            } else {
                // New chapter number
                notice.className = 'rounded-md p-2 text-xs flex items-center gap-2 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 text-emerald-700 dark:text-emerald-300';
                noticeIcon.className = 'material-symbols-rounded text-sm text-emerald-600 shrink-0';
                noticeIcon.textContent = 'add_circle';
                noticeText.innerHTML = `<strong>New Chapter:</strong> Chapter ${enteredNum} will be added to <strong>${currentSub}</strong>.`;
                notice.classList.remove('hidden');

                chNameInput.classList.remove('border-rose-500');
                chNumInput.classList.remove('border-rose-500');
                chNameInput.classList.add('border-emerald-500');
                chNumInput.classList.add('border-emerald-500');
            }

            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            return false;
        }

        function useExistingChapterName(num) {
            const match = currentSubjectChapters.find(ch => parseInt(ch.number, 10) === parseInt(num, 10));
            if (match && match.name) {
                document.getElementById('unifiedChapterName').value = match.name;
                checkChapterConflict();
            }
        }

        function switchTeacherTab(tab) {
            const liveView = document.getElementById('liveTopicsView');
            const submissionsView = document.getElementById('submissionsTopicsView');
            const tabLiveBtn = document.getElementById('tabLiveBtn');
            const tabSubmissionsBtn = document.getElementById('tabSubmissionsBtn');
            const liveFiltersBar = document.getElementById('liveFiltersBar');
            if (typeof clearSelectedSubmissions === 'function') clearSelectedSubmissions();

            if (tab === 'live') {
                liveView.classList.remove('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.remove('hidden');
                if (document.getElementById('topBarToggleAllLiveChapters')) document.getElementById('topBarToggleAllLiveChapters').classList.remove('hidden');
                if (document.getElementById('btnToggleSelection')) document.getElementById('btnToggleSelection').classList.remove('hidden');
                submissionsView.classList.add('hidden');
                tabLiveBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                tabSubmissionsBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.delete('tab');
                    window.history.replaceState(null, '', u.toString());
                }
            } else {
                exitSelectionMode();
                liveView.classList.add('hidden');
                if (liveFiltersBar) liveFiltersBar.classList.add('hidden');
                if (document.getElementById('topBarToggleAllLiveChapters')) document.getElementById('topBarToggleAllLiveChapters').classList.add('hidden');
                if (document.getElementById('btnToggleSelection')) document.getElementById('btnToggleSelection').classList.add('hidden');
                submissionsView.classList.remove('hidden');
                tabSubmissionsBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 bg-white dark:bg-slate-900 text-primary shadow-xs';
                tabLiveBtn.className = 'px-3 py-1.5 rounded-md font-medium text-xs transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white';
                if (window.history.replaceState) {
                    const u = new URL(window.location.href);
                    u.searchParams.set('tab', 'submissions');
                    window.history.replaceState(null, '', u.toString());
                }
            }
        }

        function onClassChange(newClass) {
            const u = new URL(window.location.href);
            u.searchParams.set('classLevel', newClass);
            u.searchParams.delete('subject');
            u.searchParams.delete('group');
            window.location.href = u.toString();
        }

        function onGroupChange(newGroup) {
            const u = new URL(window.location.href);
            u.searchParams.set('group', newGroup);
            u.searchParams.delete('subject');
            window.location.href = u.toString();
        }

        function onSubjectChange(newSub) {
            const u = new URL(window.location.href);
            u.searchParams.set('subject', newSub);
            u.searchParams.delete('group');
            u.searchParams.delete('segment');
            window.location.href = u.toString();
        }

        function onSegmentChange(newSeg) {
            const u = new URL(window.location.href);
            if (newSeg && newSeg !== 'all') {
                u.searchParams.set('segment', newSeg);
            } else {
                u.searchParams.delete('segment');
            }
            window.location.href = u.toString();
        }

        async function openEditChapterModal(chapterName, chapterNumber, topicCount) {
            const targetNorm = (currentClassLevel || '').trim().toLowerCase();
            const linked = (targetNorm === 'class 9' || targetNorm === 'class 10')
                ? ['Class 9', 'Class 10']
                : (targetNorm === 'class 11' || targetNorm === 'class 12')
                    ? ['Class 11', 'Class 12']
                    : [currentClassLevel];

            const { value: formValues } = await Swal.fire({
                title: 'Edit Chapter Name',
                html: `
                    <div class="text-left space-y-3 pt-1">
                        <div>
                            <label class="text-xs font-semibold text-slate-700 dark:text-slate-200 block mb-1">Chapter Name *</label>
                            <input id="swalEditChapterName" class="w-full h-9 px-3 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 outline-none focus:border-primary" value="${escapeHtml(chapterName)}" placeholder="Enter chapter name">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-700 dark:text-slate-200 block mb-1">Chapter Number *</label>
                            <input id="swalEditChapterNumber" type="number" min="1" class="w-full h-9 px-3 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 outline-none focus:border-primary" value="${chapterNumber || 1}">
                        </div>
                        <div class="p-2.5 rounded bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60">
                            <span class="text-[11px] text-slate-500 dark:text-slate-400 block font-normal">
                                এই অধ্যায়ের অধীনে থাকা <strong>${topicCount}টি টপিক</strong> এবং সংশ্লিষ্ট ক্লাসের (${linked.join(', ')}) চ্যাপ্টার নাম একসাথে আপডেট হবে।
                            </span>
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#137fec',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Save & Submit for Approval',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                preConfirm: () => {
                    const newName = document.getElementById('swalEditChapterName').value.trim();
                    const newNum = parseInt(document.getElementById('swalEditChapterNumber').value, 10);
                    if (!newName) {
                        Swal.showValidationMessage('Chapter name is required');
                        return false;
                    }
                    if (isNaN(newNum) || newNum < 1) {
                        Swal.showValidationMessage('Valid chapter number (1 or greater) is required');
                        return false;
                    }
                    return { newChapterName: newName, newChapterNumber: newNum };
                }
            });

            if (!formValues) return;

            try {
                Swal.fire({ title: 'Updating Chapter...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/chapter/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        classLevel: currentClassLevel,
                        classLevels: linked,
                        subject: currentSubject,
                        oldChapterName: chapterName,
                        newChapterName: formValues.newChapterName,
                        newChapterNumber: formValues.newChapterNumber
                    })
                });

                const data = await res.json();
                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Chapter Updated!',
                        text: data.message || 'Chapter name updated successfully.',
                        confirmButtonColor: '#137fec'
                    });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to update chapter name', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            }
        }

        function toggleChapterAccordion(chId) {
            const content = document.getElementById('content_' + chId);
            const icon = document.getElementById('icon_' + chId);
            if (!content) return;
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(-90deg)';
            }
        }

        let allLiveChaptersExpanded = true;
        function toggleAllLiveChapters() {
            allLiveChaptersExpanded = !allLiveChaptersExpanded;
            const contents = document.querySelectorAll('#chaptersContainer [id^="content_ch_"]');
            const icons = document.querySelectorAll('#chaptersContainer [id^="icon_ch_"]');

            contents.forEach(el => {
                if (allLiveChaptersExpanded) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
            icons.forEach(ic => {
                ic.style.transform = allLiveChaptersExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
            });

            const topText = document.getElementById('topBarTextToggleLive');
            const topIcon = document.getElementById('topBarIconToggleLive');
            if (topText) topText.textContent = allLiveChaptersExpanded ? 'Collapse All' : 'Expand All';
            if (topIcon) topIcon.textContent = allLiveChaptersExpanded ? 'unfold_less' : 'unfold_more';

            const inText = document.getElementById('textToggleAllLiveChapters');
            const inIcon = document.getElementById('iconToggleAllLiveChapters');
            if (inText) inText.textContent = allLiveChaptersExpanded ? 'Collapse All' : 'Expand All';
            if (inIcon) inIcon.textContent = allLiveChaptersExpanded ? 'unfold_less' : 'unfold_more';
        }

        // ==========================================
        // SELECTION MODE & BULK ACTIONS FOR LIVE TOPICS
        // ==========================================
        let isSelectionMode = false;

        function toggleSelectionMode() {
            if (isSelectionMode) {
                exitSelectionMode();
            } else {
                enterSelectionMode();
            }
        }

        function enterSelectionMode() {
            isSelectionMode = true;
            document.body.classList.add('selection-mode-active');
            const toolbar = document.getElementById('selectionToolbar');
            if (toolbar) toolbar.classList.remove('hidden');

            const btn = document.getElementById('btnToggleSelection');
            const icon = document.getElementById('btnSelectionIcon');
            const label = document.getElementById('btnSelectionLabel');
            if (btn) btn.className = 'h-8 px-2.5 sm:px-3 rounded-md bg-primary/10 text-primary border border-primary/40 font-semibold text-xs flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all shrink-0 cursor-pointer';
            if (icon) {
                icon.innerText = 'close';
                icon.className = 'material-symbols-rounded text-[17px] text-primary';
            }
            if (label) label.innerText = 'Exit Selection';

            updateSelectedTopicsCount();
        }

        function exitSelectionMode() {
            isSelectionMode = false;
            document.body.classList.remove('selection-mode-active');
            const toolbar = document.getElementById('selectionToolbar');
            if (toolbar) toolbar.classList.add('hidden');

            const btn = document.getElementById('btnToggleSelection');
            const icon = document.getElementById('btnSelectionIcon');
            const label = document.getElementById('btnSelectionLabel');
            if (btn) btn.className = 'h-8 px-2.5 sm:px-3 rounded-md bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700 flex items-center gap-1 sm:gap-1.5 shadow-xs transition-all shrink-0 cursor-pointer';
            if (icon) {
                icon.innerText = 'checklist';
                icon.className = 'material-symbols-rounded text-[17px] text-slate-500';
            }
            if (label) label.innerText = 'Select Topics';

            deselectAllLive();
        }

        function selectAllLiveTopics() {
            document.querySelectorAll('.topic-checkbox').forEach(cb => cb.checked = true);
            document.querySelectorAll('.chapter-checkbox').forEach(cb => {
                cb.checked = true;
                cb.indeterminate = false;
            });
            updateSelectedTopicsCount();
        }

        function deselectAllLive() {
            document.querySelectorAll('.topic-checkbox').forEach(cb => cb.checked = false);
            document.querySelectorAll('.chapter-checkbox').forEach(cb => {
                cb.checked = false;
                cb.indeterminate = false;
            });
            updateSelectedTopicsCount();
        }

        function toggleSelectChapterTopics(chIdx, checked) {
            document.querySelectorAll(`.ch-topic-${chIdx}`).forEach(cb => cb.checked = checked);
            updateSelectedTopicsCount();
        }

        function onChapterHeaderClick(event, chIdx) {
            if (isSelectionMode) {
                if (event.target.closest('button') || event.target.closest('input[type="checkbox"]')) {
                    return;
                }
                const chCb = document.getElementById(`chapter_cb_${chIdx}`);
                if (chCb) {
                    const newChecked = !chCb.checked;
                    chCb.checked = newChecked;
                    toggleSelectChapterTopics(chIdx, newChecked);
                }
                return;
            }
            toggleChapterAccordion('ch_' + chIdx);
        }

        function onTopicItemClick(event, topicId, chIdx) {
            if (!isSelectionMode) return;
            if (event.target.closest('button') || event.target.closest('input[type="checkbox"]')) {
                return;
            }
            const cb = document.querySelector(`.topic-checkbox[data-id="${topicId}"]`);
            if (cb) {
                cb.checked = !cb.checked;
                updateSelectedTopicsCount();
            }
        }

        function updateSelectedTopicsCount() {
            const checked = document.querySelectorAll('.topic-checkbox:checked');
            const count = checked.length;

            const badge = document.getElementById('toolbarSelectedCountBadge');
            if (badge) badge.innerText = `${count} Selected`;

            const pendingTopics = Array.from(checked).filter(cb => cb.dataset.pending === 'true');
            const unrequestedTopics = Array.from(checked).filter(cb => cb.dataset.pending !== 'true');

            const btnCancelDelete = document.getElementById('btnToolbarCancelDelete');
            const textCancelDelete = document.getElementById('btnToolbarCancelDeleteText');
            if (btnCancelDelete) {
                if (pendingTopics.length > 0) {
                    btnCancelDelete.classList.remove('hidden');
                    btnCancelDelete.disabled = false;
                    if (textCancelDelete) textCancelDelete.innerText = `অনুরোধ প্রত্যাহার (${pendingTopics.length})`;
                } else {
                    btnCancelDelete.classList.add('hidden');
                    btnCancelDelete.disabled = true;
                }
            }

            const btnRequestDelete = document.getElementById('btnToolbarRequestDelete');
            const textRequestDelete = document.getElementById('btnToolbarRequestDeleteText');
            if (btnRequestDelete) {
                btnRequestDelete.disabled = (unrequestedTopics.length === 0);
                if (textRequestDelete) {
                    textRequestDelete.innerText = unrequestedTopics.length > 0 ? `Request Delete (${unrequestedTopics.length})` : 'Request Delete';
                }
            }

            // Sync chapter checkboxes
            document.querySelectorAll('.chapter-card').forEach((card, idx) => {
                const chCb = document.getElementById(`chapter_cb_${idx}`);
                if (chCb) {
                    const topicCbs = card.querySelectorAll('.topic-checkbox');
                    if (topicCbs.length === 0) {
                        chCb.checked = false;
                        chCb.indeterminate = false;
                    } else {
                        const checkedCount = card.querySelectorAll('.topic-checkbox:checked').length;
                        if (checkedCount === 0) {
                            chCb.checked = false;
                            chCb.indeterminate = false;
                        } else if (checkedCount === topicCbs.length) {
                            chCb.checked = true;
                            chCb.indeterminate = false;
                        } else {
                            chCb.checked = false;
                            chCb.indeterminate = true;
                        }
                    }
                }
            });
        }

        async function bulkCancelDeleteLive() {
            const checked = Array.from(document.querySelectorAll('.topic-checkbox:checked'));
            const pending = checked.filter(cb => cb.dataset.pending === 'true');
            if (pending.length === 0) return;
            const ids = pending.map(cb => cb.dataset.id);
            cancelDeletionRequest(ids, `${pending.length}টি নির্বাচিত টপিক`, 'chapter');
        }

        async function bulkRequestDeleteLive() {
            const checked = Array.from(document.querySelectorAll('.topic-checkbox:checked'));
            if (checked.length === 0) return;

            const pendingCount = checked.filter(cb => cb.dataset.pending === 'true').length;
            const targetTopics = checked.filter(cb => cb.dataset.pending !== 'true');

            if (targetTopics.length === 0) {
                Swal.fire('তথ্য', 'নির্বাচিত সব টপিকের জন্য ইতিমধ্যে মুছে ফেলার অনুরোধ পেন্ডিং রয়েছে।', 'info');
                return;
            }

            if (pendingCount > 0) {
                const proceed = await Swal.fire({
                    title: 'সতর্কতা',
                    text: `নির্বাচিত ${checked.length}টির মধ্যে ${pendingCount}টি টপিকে ইতিমধ্যে ডিলিট রিকোয়েস্ট পেন্ডিং আছে। বাকি ${targetTopics.length}টি টপিকের জন্য রিকোয়েস্ট পাঠাতে চান?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'হ্যাঁ, এগিয়ে যান',
                    cancelButtonText: 'বাতিল'
                });
                if (!proceed.isConfirmed) return;
            }

            const ids = targetTopics.map(cb => cb.dataset.id);
            const targetName = `${targetTopics.length}টি নির্বাচিত টপিক`;
            openRequestDeleteModal(targetName, ids, 'topic');
        }

        let allSubmissionsExpanded = true;
        function toggleAllSubmissionChapters() {
            allSubmissionsExpanded = !allSubmissionsExpanded;
            const contents = document.querySelectorAll('.submission-chapter-content');
            const icons = document.querySelectorAll('[id^="icon_sub_ch_"]');
            const btnText = document.getElementById('textToggleAllSubChapters');
            const btnIcon = document.getElementById('iconToggleAllSubChapters');

            contents.forEach(c => {
                if (allSubmissionsExpanded) c.classList.remove('hidden');
                else c.classList.add('hidden');
            });
            icons.forEach(ic => {
                ic.style.transform = allSubmissionsExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
            });
            if (btnText) btnText.textContent = allSubmissionsExpanded ? 'Collapse All' : 'Expand All';
            if (btnIcon) btnIcon.textContent = allSubmissionsExpanded ? 'unfold_less' : 'unfold_more';
        }

        function filterTopicsClientSide(query) {
            query = (query || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.chapter-card');
            cards.forEach(card => {
                const topicItems = card.querySelectorAll('.topic-item');
                let matchInChapter = false;
                topicItems.forEach(item => {
                    const name = (item.getAttribute('data-topic-name') || '').toLowerCase();
                    if (!query || name.includes(query)) {
                        item.classList.remove('hidden');
                        matchInChapter = true;
                    } else {
                        item.classList.add('hidden');
                    }
                });
                if (!query || matchInChapter) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Modal Mode Switcher
        function setTopicMode(mode) {
            currentModalMode = mode;
            const singleBtn = document.getElementById('tabModeSingle');
            const bulkBtn = document.getElementById('tabModeBulk');
            const singleFields = document.getElementById('singleTopicFields');
            const bulkFields = document.getElementById('bulkTopicFields');
            const singleName = document.getElementById('singleTopicName');
            const bulkList = document.getElementById('bulkTopicList');

            if (mode === 'single') {
                singleBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs';
                bulkBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                singleFields.classList.remove('hidden');
                bulkFields.classList.add('hidden');
                if (singleName) singleName.required = true;
                if (bulkList) bulkList.required = false;
            } else {
                bulkBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center bg-white dark:bg-slate-900 text-primary shadow-xs';
                singleBtn.className = 'flex-1 py-1 px-3 rounded text-xs font-medium transition-all text-center text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                bulkFields.classList.remove('hidden');
                singleFields.classList.add('hidden');
                if (singleName) singleName.required = false;
                if (bulkList) bulkList.required = true;
            }
        }

        let currentTopicStep = 1;
        let stagedTopics = [];
        let editingSubTopics = [];

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function collectStep1Topics() {
            const targetClasses = Array.from(document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            if (targetClasses.length === 0) {
                Swal.fire('Select Class', 'Please select at least one class for these topics.', 'warning');
                return false;
            }
            const subj = getSelectedModalSubject();
            if (!subj || !subj.trim()) {
                Swal.fire('Subject Required', 'Please enter or select a Subject.', 'warning');
                return false;
            }

            const segmentWrap = document.getElementById('unifiedModalSegmentWrap');
            const segmentSelect = document.getElementById('unifiedSegmentSelect');
            if (segmentWrap && !segmentWrap.classList.contains('hidden')) {
                if (!segmentSelect || !segmentSelect.value) {
                    Swal.fire('Segment Required', 'Please select a Segment / বিভাগ for this subject.', 'warning');
                    return false;
                }
            }
            const chName = document.getElementById('unifiedChapterName').value.trim();
            if (!chName) {
                Swal.fire('Chapter Required', 'Please enter a Chapter Name.', 'warning');
                return false;
            }
            const chNum = parseInt(document.getElementById('unifiedChapterNumber').value, 10);
            if (isNaN(chNum) || chNum < 1) {
                Swal.fire('Invalid Chapter #', 'Please enter a valid Chapter Number (1 or greater).', 'warning');
                return false;
            }

            const isChapterEdit = document.getElementById('unifiedIsChapterEdit')?.value === 'true';
            const oldChName = document.getElementById('unifiedOldChapterName')?.value.trim();
            const oldChNum = parseInt(document.getElementById('unifiedOldChapterNumber')?.value, 10);
            const chapterChanged = oldChName && (oldChName.toLowerCase() !== chName.toLowerCase() || oldChNum !== chNum);

            if (currentModalMode === 'single') {
                const singleName = document.getElementById('singleTopicName').value.trim();
                if (!singleName && stagedTopics.length === 0) {
                    if (isChapterEdit && chapterChanged) {
                        saveChapterEditDirectly(targetClasses, subj, oldChName, chName, chNum);
                        return false;
                    }
                    Swal.fire('Topic Name Required', 'Please enter a Topic Name or modify chapter details.', 'warning');
                    return false;
                }
                if (singleName) {
                    const existingSubs = (stagedTopics[0] && stagedTopics[0].subTopics) ? stagedTopics[0].subTopics : (editingSubTopics || []);
                    const singleSubsText = document.getElementById('singleSubTopics')?.value.trim();
                    let subsToUse = existingSubs;
                    if (singleSubsText) {
                        subsToUse = singleSubsText.split(/[\n]+/).map(s => s.trim()).filter(Boolean);
                    }
                    stagedTopics = [{
                        name: singleName,
                        code: document.getElementById('singleTopicCode')?.value.trim() || '',
                        difficulty: document.getElementById('singleDifficulty')?.value || 'Medium',
                        description: document.getElementById('singleDescription')?.value.trim() || '',
                        subTopics: subsToUse
                    }];
                }
            } else {
                const bulkText = document.getElementById('bulkTopicList').value.trim();
                if (!bulkText && stagedTopics.length === 0) {
                    if (isChapterEdit && chapterChanged) {
                        saveChapterEditDirectly(targetClasses, subj, oldChName, chName, chNum);
                        return false;
                    }
                    Swal.fire('Topics Required', 'Please enter topic names (one per line).', 'warning');
                    return false;
                }
                if (bulkText) {
                    const lines = bulkText.split('\n').map(l => l.trim()).filter(Boolean);
                    const subTopicsMap = new Map();
                    stagedTopics.forEach(t => {
                        if (t && t.name) subTopicsMap.set(t.name.toLowerCase(), t.subTopics || []);
                    });
                    stagedTopics = lines.map(lineName => ({
                        name: lineName,
                        code: '',
                        difficulty: 'Medium',
                        description: '',
                        subTopics: subTopicsMap.get(lineName.toLowerCase()) || []
                    }));
                }
            }

            if (stagedTopics.length === 0) {
                Swal.fire('No Topics', 'Please enter at least one topic name.', 'warning');
                return false;
            }
            return true;
        }

        function submitDirectlyFromStep1() {
            if (!collectStep1Topics()) return;
            submitStagedTopics();
        }

        function goToTopicStep(step) {
            if (step === 2) {
                if (!collectStep1Topics()) return;

                const subj = getSelectedModalSubject();
                const chName = document.getElementById('unifiedChapterName').value.trim();
                const chNum = parseInt(document.getElementById('unifiedChapterNumber').value, 10) || 1;

                // Render Step 2
                currentTopicStep = 2;
                document.getElementById('unifiedStep1Container').classList.add('hidden');
                document.getElementById('unifiedStep2Container').classList.remove('hidden');

                // Update Header & Indicator
                document.getElementById('unifiedModalSubtitle').textContent = 'Step 2: Review topics and click Expand to add sub-topics.';
                const s1Pill = document.getElementById('step1Indicator');
                const s2Pill = document.getElementById('step2Indicator');
                const s1Badge = document.getElementById('step1Badge');
                const s2Badge = document.getElementById('step2Badge');
                const progressLine = document.getElementById('stepProgressLine');

                if (s1Pill) {
                    s1Pill.className = 'flex items-center gap-1.5 font-medium text-slate-400 transition-all';
                    s1Badge.className = 'size-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold';
                    s1Badge.innerHTML = '&#10003;';
                }
                if (s2Pill) {
                    s2Pill.className = 'flex items-center gap-1.5 font-semibold text-primary transition-all';
                    s2Badge.className = 'size-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold';
                    s2Badge.textContent = '2';
                }
                if (progressLine) progressLine.className = 'h-0.5 flex-1 mx-3 bg-primary transition-colors';

                document.getElementById('stagedSubjectBadge').textContent = subj;
                document.getElementById('stagedChapterBadge').textContent = `Ch ${chNum}: ${chName}`;
                document.getElementById('stagedTotalBadge').textContent = `${stagedTopics.length} Topic${stagedTopics.length === 1 ? '' : 's'}`;

                renderStagedTopics();
            } else {
                // Step 1
                currentTopicStep = 1;
                document.getElementById('unifiedStep2Container').classList.add('hidden');
                document.getElementById('unifiedStep1Container').classList.remove('hidden');

                document.getElementById('unifiedModalSubtitle').textContent = 'Step 1: Enter chapter details and topics.';
                const s1Pill = document.getElementById('step1Indicator');
                const s2Pill = document.getElementById('step2Indicator');
                const s1Badge = document.getElementById('step1Badge');
                const s2Badge = document.getElementById('step2Badge');
                const progressLine = document.getElementById('stepProgressLine');

                if (s1Pill) {
                    s1Pill.className = 'flex items-center gap-1.5 font-semibold text-primary transition-all';
                    s1Badge.className = 'size-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold';
                    s1Badge.textContent = '1';
                }
                if (s2Pill) {
                    s2Pill.className = 'flex items-center gap-1.5 font-medium text-slate-400 transition-all';
                    s2Badge.className = 'size-5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-500 flex items-center justify-center text-[10px] font-bold';
                    s2Badge.textContent = '2';
                }
                if (progressLine) progressLine.className = 'h-0.5 flex-1 mx-3 bg-slate-200 dark:bg-slate-700 transition-colors';
            }
        }

        function renderStagedTopics() {
            const container = document.getElementById('stagedTopicsList');
            if (!container) return;

            document.getElementById('stagedTotalBadge').textContent = `${stagedTopics.length} Topic${stagedTopics.length === 1 ? '' : 's'}`;

            container.innerHTML = stagedTopics.map((t, idx) => {
                const subCount = Array.isArray(t.subTopics) ? t.subTopics.length : 0;
                return `
                <div class="staged-topic-card rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-2xs transition-all">
                    <!-- Topic Card Header -->
                    <div class="p-2.5 sm:px-3 bg-slate-50/70 dark:bg-slate-800/40 flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2 min-w-0 flex-1">
                            <span class="size-5 rounded bg-primary/10 text-primary font-mono text-[10px] flex items-center justify-center shrink-0 font-bold">
                                ${idx + 1}
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="text-xs font-semibold text-slate-800 dark:text-slate-100 break-words block leading-snug">${escapeHtml(t.name)}</span>
                            </div>
                            ${t.difficulty ? `<span class="text-[9px] font-medium px-1.5 py-0.2 rounded border bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 shrink-0">${t.difficulty}</span>` : ''}
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span id="stagedTopicCount_${idx}" class="text-[10px] font-medium px-2 py-0.5 rounded ${subCount > 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'}">
                                ${subCount} sub-topic${subCount === 1 ? '' : 's'}
                            </span>
                            <!-- Expand Button -->
                            <button type="button" onclick="toggleExpandTopic(${idx})" class="h-7 px-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 text-primary text-xs font-semibold flex items-center gap-1 transition-all" title="Click to add sub-topics">
                                <span id="expandIcon_${idx}" class="material-symbols-rounded text-base transition-transform">expand_more</span>
                                <span id="expandText_${idx}">Expand</span>
                            </button>
                            <button type="button" onclick="removeStagedTopic(${idx})" class="size-7 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors" title="Delete topic">
                                <span class="material-symbols-rounded text-sm">delete</span>
                            </button>
                        </div>
                    </div>

                    <!-- Expandable Sub-topics Section -->
                    <div id="subtopicsPanel_${idx}" class="hidden p-3 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/50 space-y-2">
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm text-primary">subdirectory_arrow_right</span>
                                <span>Sub-topics under "${escapeHtml(t.name)}"</span>
                            </label>
                            <!-- Single vs Bulk Input Mode Switcher -->
                            <div class="inline-flex items-center p-0.5 rounded bg-slate-200/80 dark:bg-slate-800 text-[10px]">
                                <button type="button" onclick="setSubTopicInputMode(${idx}, 'single')" id="subModeBtn_single_${idx}" class="px-2 py-0.5 rounded font-medium transition-all bg-white dark:bg-slate-900 text-primary shadow-2xs">Single</button>
                                <button type="button" onclick="setSubTopicInputMode(${idx}, 'bulk')" id="subModeBtn_bulk_${idx}" class="px-2 py-0.5 rounded font-medium transition-all text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">Bulk (One per line)</button>
                            </div>
                        </div>
                        
                        <!-- Single Mode Input -->
                        <div id="subSingleBox_${idx}" class="flex items-center gap-1.5">
                            <input type="text" id="newSubTopicInput_${idx}" placeholder="e.g. গতি ও স্থিতি, ত্বরণ..." onkeydown="if(event.key==='Enter'){event.preventDefault(); addSubTopicToStaged(${idx});}" class="flex-1 h-8 px-2.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary">
                            <button type="button" onclick="addSubTopicToStaged(${idx})" class="h-8 px-3 rounded bg-primary hover:bg-primary-dark text-white text-xs font-medium flex items-center gap-1 transition-colors shrink-0">
                                <span class="material-symbols-rounded text-sm">add</span>
                                <span>Add</span>
                            </button>
                        </div>

                        <!-- Bulk Mode Input (One per line) -->
                        <div id="subBulkBox_${idx}" class="space-y-1.5 hidden">
                            <textarea id="bulkSubTopicInput_${idx}" rows="3" placeholder="Enter sub-topics (one per line)...&#10;e.g.&#10;গতি ও স্থিতি&#10;ত্বরণ ও মন্দন&#10;গতির সমীকরণ" class="w-full p-2.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-normal outline-none focus:border-primary resize-y font-sans leading-relaxed"></textarea>
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] text-slate-400">One sub-topic per line (Paste multiple lines)</span>
                                <button type="button" onclick="addBulkSubTopicsToStaged(${idx})" class="h-7 px-3 rounded bg-primary hover:bg-primary-dark text-white text-xs font-medium flex items-center gap-1.5 transition-colors shadow-2xs">
                                    <span class="material-symbols-rounded text-sm">playlist_add</span>
                                    <span>Add All Sub-topics</span>
                                </button>
                            </div>
                        </div>

                        <!-- Sub-topics List -->
                        <div id="subtopicsList_${idx}" class="space-y-1.5 pt-1">
                            ${renderSubTopicsList(t.subTopics, idx)}
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        function renderSubTopicsList(subTopics, topicIdx) {
            if (!Array.isArray(subTopics) || subTopics.length === 0) {
                return '<p class="text-[11px] text-slate-400 italic py-1">No sub-topics added yet. Type a sub-topic above or use Bulk mode to add multiple.</p>';
            }
            return subTopics.map((st, sIdx) => `
                <div class="flex items-center justify-between p-1.5 px-2.5 rounded bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs shadow-2xs">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                        <span class="size-1.5 rounded-full bg-primary shrink-0"></span>
                        <span class="text-slate-700 dark:text-slate-200 break-words font-medium text-[11px]">${escapeHtml(st)}</span>
                    </div>
                    <button type="button" onclick="removeSubTopicFromStaged(${topicIdx}, ${sIdx})" class="size-5 rounded hover:bg-rose-100 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors shrink-0" title="Remove sub-topic">
                        <span class="material-symbols-rounded text-xs">close</span>
                    </button>
                </div>
            `).join('');
        }

        function setSubTopicInputMode(idx, mode) {
            const singleBox = document.getElementById(`subSingleBox_${idx}`);
            const bulkBox = document.getElementById(`subBulkBox_${idx}`);
            const singleBtn = document.getElementById(`subModeBtn_single_${idx}`);
            const bulkBtn = document.getElementById(`subModeBtn_bulk_${idx}`);

            if (mode === 'single') {
                if (singleBox) singleBox.classList.remove('hidden');
                if (bulkBox) bulkBox.classList.add('hidden');
                if (singleBtn) singleBtn.className = 'px-2 py-0.5 rounded font-medium transition-all bg-white dark:bg-slate-900 text-primary shadow-2xs';
                if (bulkBtn) bulkBtn.className = 'px-2 py-0.5 rounded font-medium transition-all text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                const input = document.getElementById(`newSubTopicInput_${idx}`);
                if (input) setTimeout(() => input.focus(), 50);
            } else {
                if (bulkBox) bulkBox.classList.remove('hidden');
                if (singleBox) singleBox.classList.add('hidden');
                if (bulkBtn) bulkBtn.className = 'px-2 py-0.5 rounded font-medium transition-all bg-white dark:bg-slate-900 text-primary shadow-2xs';
                if (singleBtn) singleBtn.className = 'px-2 py-0.5 rounded font-medium transition-all text-slate-500 hover:text-slate-800 dark:hover:text-slate-200';
                const textarea = document.getElementById(`bulkSubTopicInput_${idx}`);
                if (textarea) setTimeout(() => textarea.focus(), 50);
            }
        }

        function toggleExpandTopic(idx) {
            const panel = document.getElementById(`subtopicsPanel_${idx}`);
            const icon = document.getElementById(`expandIcon_${idx}`);
            const text = document.getElementById(`expandText_${idx}`);
            if (!panel) return;
            const isHidden = panel.classList.contains('hidden');
            if (isHidden) {
                panel.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
                if (text) text.textContent = 'Collapse';
                const input = document.getElementById(`newSubTopicInput_${idx}`);
                if (input) setTimeout(() => input.focus(), 50);
            } else {
                panel.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
                if (text) text.textContent = 'Expand';
            }
        }

        function syncStagedSubTopicsUI(idx) {
            const listEl = document.getElementById(`subtopicsList_${idx}`);
            if (listEl) {
                listEl.innerHTML = renderSubTopicsList(stagedTopics[idx].subTopics, idx);
            }
            const countEl = document.getElementById(`stagedTopicCount_${idx}`);
            if (countEl) {
                const c = stagedTopics[idx].subTopics.length;
                countEl.textContent = `${c} sub-topic${c === 1 ? '' : 's'}`;
                countEl.className = `text-[10px] font-medium px-2 py-0.5 rounded ${c > 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'}`;
            }
            if (idx === 0) {
                const singleSubEl = document.getElementById('singleSubTopics');
                if (singleSubEl) {
                    singleSubEl.value = (stagedTopics[0].subTopics || []).join('\n');
                }
            }
        }

        function addSubTopicToStaged(idx) {
            const input = document.getElementById(`newSubTopicInput_${idx}`);
            if (!input) return;
            const rawVal = input.value.trim();
            if (!rawVal) return;

            if (!Array.isArray(stagedTopics[idx].subTopics)) {
                stagedTopics[idx].subTopics = [];
            }
            // Auto split if pasted with commas or newlines
            const items = rawVal.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
            items.forEach(val => {
                if (!stagedTopics[idx].subTopics.includes(val)) {
                    stagedTopics[idx].subTopics.push(val);
                }
            });
            input.value = '';

            syncStagedSubTopicsUI(idx);
            input.focus();
        }

        function addBulkSubTopicsToStaged(idx) {
            const textarea = document.getElementById(`bulkSubTopicInput_${idx}`);
            if (!textarea) return;
            const rawText = textarea.value.trim();
            if (!rawText) return;

            if (!Array.isArray(stagedTopics[idx].subTopics)) {
                stagedTopics[idx].subTopics = [];
            }
            const lines = rawText.split('\n').map(s => s.trim()).filter(Boolean);
            lines.forEach(line => {
                if (!stagedTopics[idx].subTopics.includes(line)) {
                    stagedTopics[idx].subTopics.push(line);
                }
            });
            textarea.value = '';

            syncStagedSubTopicsUI(idx);
            textarea.focus();
        }

        function removeSubTopicFromStaged(topicIdx, subIdx) {
            if (stagedTopics[topicIdx] && Array.isArray(stagedTopics[topicIdx].subTopics)) {
                stagedTopics[topicIdx].subTopics.splice(subIdx, 1);
                syncStagedSubTopicsUI(topicIdx);
            }
        }

        function removeStagedTopic(idx) {
            if (stagedTopics.length <= 1) {
                Swal.fire('Notice', 'At least one topic is required.', 'info');
                return;
            }
            stagedTopics.splice(idx, 1);
            renderStagedTopics();
            const bulkList = document.getElementById('bulkTopicList');
            if (bulkList) bulkList.value = stagedTopics.map(t => t.name).join('\n');
            if (stagedTopics.length > 0) {
                const singleName = document.getElementById('singleTopicName');
                const singleSub = document.getElementById('singleSubTopics');
                if (singleName && singleName.value) {
                    singleName.value = stagedTopics[0].name;
                    if (singleSub) singleSub.value = (stagedTopics[0].subTopics || []).join('\n');
                }
            }
        }

        async function addAnotherStagedTopicPrompt() {
            const { value: topicName } = await Swal.fire({
                title: 'Add Another Topic',
                input: 'text',
                inputLabel: 'Topic Name',
                inputPlaceholder: 'Enter topic name...',
                showCancelButton: true,
                confirmButtonText: 'Add Topic',
                confirmButtonColor: '#137fec',
                inputValidator: (value) => {
                    if (!value || !value.trim()) return 'Topic name cannot be empty';
                }
            });
            if (topicName && topicName.trim()) {
                stagedTopics.push({
                    name: topicName.trim(),
                    code: '',
                    difficulty: 'Medium',
                    description: '',
                    subTopics: []
                });
                renderStagedTopics();
                setTimeout(() => toggleExpandTopic(stagedTopics.length - 1), 50);
            }
        }

        async function submitStagedTopics() {
            if (stagedTopics.length === 0) {
                return Swal.fire('No Topics', 'Please add at least one topic.', 'warning');
            }

            const targetClasses = Array.from(document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            if (targetClasses.length === 0) {
                return Swal.fire('Select Class', 'Please select at least one class for these topics.', 'warning');
            }

            const subject = getSelectedModalSubject();
            const segment = document.getElementById('unifiedSegmentSelect')?.value.trim() || '';
            const chapterName = document.getElementById('unifiedChapterName').value.trim();
            const chapterNumber = parseInt(document.getElementById('unifiedChapterNumber').value, 10) || 1;
            const group = document.querySelector('#unifiedTopicForm input[name="group"]')?.value || 'None';
            const topicId = document.getElementById('unifiedTopicId')?.value || '';

            const isEditing = Boolean(topicId);
            const endpoint = isEditing ? `${apiBase}/topics` : `${apiBase}/topics/bulk`;

            const isChapterEdit = document.getElementById('unifiedIsChapterEdit')?.value === 'true';
            const oldChName = document.getElementById('unifiedOldChapterName')?.value.trim();
            const oldChNum = parseInt(document.getElementById('unifiedOldChapterNumber')?.value, 10);
            const chapterChanged = oldChName && (oldChName.toLowerCase() !== chapterName.toLowerCase() || oldChNum !== chapterNumber);

            const payload = {
                classLevels: targetClasses,
                classLevel: targetClasses[0],
                subject,
                segment,
                chapterName,
                chapterNumber,
                group,
                isChapterEdit,
                oldChapterName: oldChName || chapterName,
                oldChapterNumber: oldChNum || chapterNumber
            };

            if (isEditing) {
                payload.topicId = topicId;
                payload.name = stagedTopics[0].name;
                payload.code = stagedTopics[0].code || '';
                payload.difficulty = stagedTopics[0].difficulty || 'Medium';
                payload.description = stagedTopics[0].description || '';
                payload.subTopics = stagedTopics[0].subTopics || [];
            } else {
                payload.topics = stagedTopics;
            }

            if (isChapterEdit && chapterChanged) {
                try {
                    await fetch(`${apiBase}/topics/chapter/edit`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                            classLevel: currentClassLevel,
                            classLevels: targetClasses,
                            subject,
                            oldChapterName: oldChName,
                            newChapterName: chapterName,
                            newChapterNumber: chapterNumber
                        })
                    });
                } catch (e) {
                    console.error('Failed to update chapter name before adding topics:', e);
                }
            }

            try {
                Swal.fire({ title: 'Submitting Topics...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const text = await res.text();
                let data = {};
                try { data = JSON.parse(text); } catch(e) { data = { error: text }; }

                if (res.ok && data.success !== false) {
                    await Swal.fire({ 
                        icon: 'success', 
                        title: 'Submitted for Approval!', 
                        text: data.message || 'Your topics and sub-topics have been sent to Admin for review.', 
                        confirmButtonColor: '#137fec' 
                    });
                    closeModal('unifiedTopicModal');
                    window.location.href = window.location.pathname + '?tab=submissions&subStatus=pending';
                } else {
                    Swal.fire('Submission Error', data.error || 'Failed to submit topics', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            }
        }

        async function submitTeacherTopicForm(event) {
            event.preventDefault();
            if (currentTopicStep === 1) {
                goToTopicStep(2);
            } else {
                submitStagedTopics();
            }
        }

        async function openUnifiedModal(chapterName = '', chapterNumber = 1, defaultTopicName = '', subjectName = '', topicId = '', existingSubTopics = [], prefillSegment = '', topicCode = '', topicDifficulty = 'Medium', topicDesc = '') {
            if (!currentClassLevel) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Assigned Class',
                    text: 'You can only add topics when you have an assigned class selected.'
                });
                return;
            }
            document.getElementById('unifiedTopicForm').reset();
            setTopicMode('single');

            stagedTopics = [];
            editingSubTopics = Array.isArray(existingSubTopics) ? existingSubTopics : [];
            goToTopicStep(1);

            const topicIdInput = document.getElementById('unifiedTopicId');
            const modalTitle = document.getElementById('unifiedModalTitle');
            const submitBtnText = document.getElementById('unifiedSubmitBtnText');
            const modeTabs = document.getElementById('unifiedModeTabs');

            if (topicId) {
                if (topicIdInput) topicIdInput.value = topicId;
                if (modalTitle) modalTitle.textContent = defaultTopicName ? `Edit Topic: ${defaultTopicName}` : 'Edit Topic & Submit for Approval';
                if (submitBtnText) submitBtnText.textContent = 'Submit for Approval';
                if (modeTabs) modeTabs.classList.remove('hidden');
                if (document.getElementById('singleSubTopics')) {
                    document.getElementById('singleSubTopics').value = editingSubTopics.join('\n');
                }
                if (defaultTopicName) {
                    stagedTopics = [{
                        name: defaultTopicName,
                        code: topicCode || '',
                        difficulty: topicDifficulty || 'Medium',
                        description: topicDesc || '',
                        subTopics: [...editingSubTopics]
                    }];
                }
            } else {
                if (topicIdInput) topicIdInput.value = '';
                if (modalTitle) modalTitle.textContent = 'Add Topics';
                if (submitBtnText) submitBtnText.textContent = 'Submit for Approval';
                if (modeTabs) modeTabs.classList.remove('hidden');
                if (document.getElementById('singleSubTopics')) {
                    document.getElementById('singleSubTopics').value = '';
                }
            }

            if (document.getElementById('unifiedIsChapterEdit')) document.getElementById('unifiedIsChapterEdit').value = 'false';
            if (document.getElementById('unifiedOldChapterName')) document.getElementById('unifiedOldChapterName').value = '';
            if (document.getElementById('unifiedOldChapterNumber')) document.getElementById('unifiedOldChapterNumber').value = '';
            const btnLoad = document.getElementById('btnLoadChapterTopics');
            if (btnLoad) btnLoad.classList.add('hidden');

            // Auto-check target classes based on linked curriculum (Class 9 & 10, Class 11 & 12)
            const targetNorm = (currentClassLevel || '').trim().toLowerCase();
            const linkedClasses = (targetNorm === 'class 9' || targetNorm === 'class 10')
                ? ['Class 9', 'Class 10']
                : (targetNorm === 'class 11' || targetNorm === 'class 12')
                    ? ['Class 11', 'Class 12']
                    : [currentClassLevel];

            document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]').forEach(cb => {
                cb.checked = linkedClasses.some(l => l.toLowerCase() === cb.value.trim().toLowerCase());
            });

            const subSelect = document.getElementById('unifiedSubjectSelect');
            if (subSelect && subjectName) {
                subSelect.value = subjectName;
            }
            const activeSub = getSelectedModalSubject();
            await loadChaptersForSubject(activeSub);

            if (chapterName) document.getElementById('unifiedChapterName').value = chapterName;
            if (chapterNumber) document.getElementById('unifiedChapterNumber').value = chapterNumber;
            if (defaultTopicName) document.getElementById('singleTopicName').value = defaultTopicName;
            if (topicCode && document.getElementById('singleTopicCode')) document.getElementById('singleTopicCode').value = topicCode;
            if (topicDifficulty && document.getElementById('singleDifficulty')) document.getElementById('singleDifficulty').value = topicDifficulty;
            if (topicDesc && document.getElementById('singleDescription')) document.getElementById('singleDescription').value = topicDesc;

            document.getElementById('unifiedTopicModal').classList.remove('hidden');

            const targetSeg = prefillSegment || ('<%= (selSegment !== "all") ? selSegment : "" %>');
            await checkTeacherModalSegments(targetSeg);

            setTimeout(checkChapterConflict, 50);
        }

        let currentChapterExistingTopics = [];

        function openChapterEditUnifiedModal(chName, chNumber, existingTopics = [], segment = '') {
            const rawTopics = Array.isArray(existingTopics) ? existingTopics : [];
            currentChapterExistingTopics = rawTopics.map(t => {
                if (typeof t === 'string') {
                    return { id: '', name: t.trim(), code: '', difficulty: 'Medium', description: '', subTopics: [] };
                }
                return {
                    id: t.id || t._id || '',
                    name: String(t.name || '').trim(),
                    code: String(t.code || '').trim(),
                    difficulty: t.difficulty || 'Medium',
                    description: String(t.description || '').trim(),
                    subTopics: Array.isArray(t.subTopics) ? t.subTopics.map(s => String(s || '').trim()).filter(Boolean) : []
                };
            }).filter(t => t.name);

            // Open the full unified modal
            openUnifiedModal(chName, chNumber, '', currentSubject, '', [], segment);

            // Populate stagedTopics with ALL existing topics and their sub-topics
            stagedTopics = JSON.parse(JSON.stringify(currentChapterExistingTopics));

            // Mark as chapter edit mode
            const isChEditInput = document.getElementById('unifiedIsChapterEdit');
            if (isChEditInput) isChEditInput.value = 'true';
            const oldNameInput = document.getElementById('unifiedOldChapterName');
            if (oldNameInput) oldNameInput.value = chName;
            const oldNumInput = document.getElementById('unifiedOldChapterNumber');
            if (oldNumInput) oldNumInput.value = chNumber;

            // Pre-fill bulkTopicList with existing topic names
            const bulkList = document.getElementById('bulkTopicList');
            if (bulkList) bulkList.value = stagedTopics.map(t => t.name).join('\n');

            // Pre-fill single topic fields with first topic if available
            if (stagedTopics.length > 0) {
                const singleNameEl = document.getElementById('singleTopicName');
                const singleSubEl = document.getElementById('singleSubTopics');
                const singleCodeEl = document.getElementById('singleTopicCode');
                const singleDiffEl = document.getElementById('singleDifficulty');
                const singleDescEl = document.getElementById('singleDescription');
                if (singleNameEl) singleNameEl.value = stagedTopics[0].name;
                if (singleSubEl) singleSubEl.value = (stagedTopics[0].subTopics || []).join('\n');
                if (singleCodeEl) singleCodeEl.value = stagedTopics[0].code || '';
                if (singleDiffEl) singleDiffEl.value = stagedTopics[0].difficulty || 'Medium';
                if (singleDescEl) singleDescEl.value = stagedTopics[0].description || '';
            }

            // Update title & subtitle
            const modalTitle = document.getElementById('unifiedModalTitle');
            if (modalTitle) modalTitle.textContent = `Edit Chapter: ${chName}`;
            const modalSub = document.getElementById('unifiedModalSubtitle');
            if (modalSub) modalSub.textContent = `Loaded ${stagedTopics.length} existing topic(s) & sub-topics. Edit topics here or click Next to view/manage sub-topics.`;

            // Default to bulk mode tab for easy viewing/editing
            setTopicMode('bulk');

            // Ensure Single vs Bulk tabs are visible
            const modeTabs = document.getElementById('unifiedModeTabs');
            if (modeTabs) modeTabs.classList.remove('hidden');

            // Show Load Existing Topics button in Bulk mode if topics exist
            const btnLoad = document.getElementById('btnLoadChapterTopics');
            const countEl = document.getElementById('existingChapterTopicsCount');
            if (btnLoad && countEl) {
                if (currentChapterExistingTopics.length > 0) {
                    btnLoad.classList.remove('hidden');
                    countEl.textContent = currentChapterExistingTopics.length;
                } else {
                    btnLoad.classList.add('hidden');
                }
            }
        }

        function loadExistingChapterTopics() {
            if (!currentChapterExistingTopics || currentChapterExistingTopics.length === 0) {
                Swal.fire('Info', 'No existing topics found for this chapter.', 'info');
                return;
            }
            stagedTopics = JSON.parse(JSON.stringify(currentChapterExistingTopics));
            const bulkList = document.getElementById('bulkTopicList');
            if (bulkList) {
                bulkList.value = stagedTopics.map(t => t.name).join('\n');
                bulkList.focus();
            }
        }

        async function saveChapterEditDirectly(targetClasses, subject, oldChName, newChName, newChNum) {
            try {
                Swal.fire({ title: 'Updating Chapter...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/chapter/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        classLevel: currentClassLevel,
                        classLevels: targetClasses,
                        subject,
                        oldChapterName: oldChName,
                        newChapterName: newChName,
                        newChapterNumber: newChNum
                    })
                });
                const data = await res.json();
                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Chapter Updated!',
                        text: data.message || 'Chapter name updated successfully.',
                        confirmButtonColor: '#137fec'
                    });
                    closeModal('unifiedTopicModal');
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to update chapter name', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            }
        }

        async function checkTeacherModalSegments(prefillVal = '') {
            const wrap = document.getElementById('unifiedModalSegmentWrap');
            const select = document.getElementById('unifiedSegmentSelect');
            if (!wrap || !select) return;

            const subject = getSelectedModalSubject();
            const checkedClasses = Array.from(document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]:checked')).map(cb => cb.value);
            const classLevel = checkedClasses[0] || currentClassLevel || '';

            if (!subject && !prefillVal) {
                wrap.classList.add('hidden');
                select.required = false;
                select.innerHTML = '<option value="">Select Segment...</option>';
                return;
            }

            try {
                let segments = [];
                try {
                    const res = await fetch(`/api/subjects/segments?subject=${encodeURIComponent(subject)}&classLevel=${encodeURIComponent(classLevel)}`);
                    const data = await res.json();
                    if (data && data.hasSegments && Array.isArray(data.segments)) {
                        segments = [...data.segments];
                    }
                } catch (e) {}

                if (prefillVal && !segments.includes(prefillVal)) {
                    segments.unshift(prefillVal);
                }

                if (segments.length > 0) {
                    wrap.classList.remove('hidden');
                    let opts = '<option value="">Select Segment / Topic Type...</option>';
                    segments.forEach(seg => {
                        const isSel = (prefillVal && prefillVal === seg) ? 'selected' : '';
                        opts += `<option value="${escapeHtml(seg)}" ${isSel}>${escapeHtml(seg)}</option>`;
                    });
                    select.innerHTML = opts;
                    if (prefillVal) {
                        select.value = prefillVal;
                    }
                    select.onchange = () => {
                        const chosenSeg = select.value.trim();
                        const isChEdit = document.getElementById('unifiedIsChapterEdit')?.value === 'true';
                        if (chosenSeg && !isChEdit) {
                            const segChaps = currentSubjectChapters.filter(ch => (ch.segment || '').toLowerCase() === chosenSeg.toLowerCase());
                            const nextNum = segChaps.length + 1;
                            const numInput = document.getElementById('unifiedChapterNumber');
                            if (numInput && (!numInput.value || numInput.value === '1')) {
                                numInput.value = nextNum;
                            }
                        }
                        checkChapterConflict();
                    };
                } else {
                    wrap.classList.add('hidden');
                    select.required = false;
                    select.innerHTML = '<option value="">Select Segment...</option>';
                    select.value = '';
                }
            } catch (err) {
                console.error('Error fetching teacher segments:', err);
            }
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('hidden');
        }

        // ==========================================
        // SUBMISSION STATUS FILTER SYSTEM
        // ==========================================
        let currentSubmissionFilter = 'all';

        function filterSubmissions(status) {
            currentSubmissionFilter = status;
            if (typeof clearSelectedSubmissions === 'function') clearSelectedSubmissions();
            const filterBtns = document.querySelectorAll('.sub-filter-btn');
            const activeClass = 'sub-filter-btn px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1.5 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 shadow-xs';
            const inactiveClass = 'sub-filter-btn px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700';

            filterBtns.forEach(btn => {
                btn.className = inactiveClass;
            });

            const activeBtn = document.getElementById(`filterSubBtn_${status}`);
            if (activeBtn) activeBtn.className = activeClass;

            const chapterCards = document.querySelectorAll('.submission-chapter-card');
            let totalVisibleTopics = 0;

            chapterCards.forEach(card => {
                const rows = card.querySelectorAll('.submission-topic-row');
                let visibleRowsInCard = 0;

                rows.forEach(row => {
                    const rowStatus = row.dataset.status;
                    let matches = false;
                    if (status === 'all') {
                        matches = true;
                    } else if (status === 'deletion') {
                        matches = (row.dataset.deletionStatus === 'pending');
                    } else if (status === rowStatus) {
                        matches = true;
                    }

                    if (matches) {
                        row.classList.remove('hidden');
                        visibleRowsInCard++;
                        totalVisibleTopics++;
                    } else {
                        row.classList.add('hidden');
                    }
                });

                if (visibleRowsInCard > 0) {
                    card.classList.remove('hidden');
                    if (status !== 'all') {
                        const content = card.querySelector('.submission-chapter-content');
                        const icon = card.querySelector('[id^="icon_sub_ch_"]');
                        if (content) content.classList.remove('hidden');
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    }
                } else {
                    card.classList.add('hidden');
                }
            });

            const emptyNotice = document.getElementById('submissionsFilterEmptyNotice');
            if (emptyNotice) {
                if (totalVisibleTopics === 0) {
                    emptyNotice.classList.remove('hidden');
                    const labelSpan = document.getElementById('emptyFilterStatusLabel');
                    if (labelSpan) {
                        const labelMap = { 
                            pending: 'Pending Approval', 
                            rejected: 'Needs Revision', 
                            approved: 'Approved & Live', 
                            deletion: 'Deletion Requested',
                            all: 'Submitted' 
                        };
                        labelSpan.textContent = labelMap[status] || status;
                    }
                } else {
                    emptyNotice.classList.add('hidden');
                }
            }

            if (window.history.replaceState) {
                const u = new URL(window.location.href);
                u.searchParams.set('tab', 'submissions');
                if (status === 'all') {
                    u.searchParams.delete('subStatus');
                } else {
                    u.searchParams.set('subStatus', status);
                }
                window.history.replaceState(null, '', u.toString());
            }
        }


        async function cancelPendingTopic(id, name) {
            const confirm = await Swal.fire({
                title: 'Remove Submission?',
                html: `Remove topic submission <strong>"${name}"</strong>?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Remove'
            });

            if (confirm.isConfirmed) {
                try {
                    Swal.fire({ title: 'Removing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    const res = await fetch(`${apiBase}/topics/${id}/delete-pending`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' }
                    });
                    const text = await res.text();
                    let data = {};
                    try { data = JSON.parse(text); } catch(e) { data = { error: text }; }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({ icon: 'success', title: 'Removed!', text: data.message, timer: 1200, showConfirmButton: false });
                        const u = new URL(window.location.href);
                        u.searchParams.set('tab', 'submissions');
                        window.location.href = u.toString();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to remove', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', err.message || 'Connection error', 'error');
                }
            }
        }

        async function deleteChapterSubmissions(chapterName, count, topicIds) {
            if (!topicIds || topicIds.length === 0) return;

            const confirm = await Swal.fire({
                title: 'Delete Chapter Submissions?',
                html: `Remove all <strong>${count}</strong> unapproved topic submission(s) in chapter <strong>"${chapterName}"</strong>? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete Submissions'
            });

            if (confirm.isConfirmed) {
                try {
                    Swal.fire({
                        title: 'Removing...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const res = await fetch(`${apiBase}/topics/submissions/bulk-action`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            topicIds: topicIds,
                            action: 'delete'
                        })
                    });

                    const text = await res.text();
                    let data = {};
                    try { data = JSON.parse(text); } catch (e) { data = { error: text }; }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Removed!',
                            text: data.message || `${count} submission(s) removed successfully`,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        const u = new URL(window.location.href);
                        u.searchParams.set('tab', 'submissions');
                        window.location.href = u.toString();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to remove chapter submissions', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', err.message || 'Connection error', 'error');
                }
            }
        }

        // ==========================================
        // DELETION REQUEST FOR APPROVED CONTENT
        // ==========================================
        async function openRequestDeleteModal(targetName, topicIds, targetType = 'topic') {
            if (!topicIds || (Array.isArray(topicIds) && topicIds.length === 0)) {
                Swal.fire('Notice', 'No topics found to delete.', 'info');
                return;
            }
            const ids = Array.isArray(topicIds) ? topicIds : [topicIds];

            const { value: reason } = await Swal.fire({
                title: 'মুছে ফেলার অনুরোধ',
                text: `"${targetName}" মুছে ফেলার কারণ লিখুন:`,
                input: 'textarea',
                inputPlaceholder: 'কারণ লিখুন...',
                showCancelButton: true,
                confirmButtonText: 'অনুরোধ পাঠান',
                cancelButtonText: 'বাতিল',
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'অনুগ্রহ করে কারণ লিখুন!';
                    }
                }
            });

            if (!reason || !reason.trim()) return;

            try {
                Swal.fire({ title: 'অনুরোধ পাঠানো হচ্ছে...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/request-delete`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ topicIds: ids, reason: reason.trim() })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'অনুরোধ পাঠানো হয়েছে!',
                        text: data.message || 'এডমিনের অনুমোদনের জন্য অপেক্ষা করুন।',
                        timer: 1800,
                        showConfirmButton: false
                    });
                    window.location.reload();
                } else {
                    Swal.fire('ত্রুটি (Error)', data.error || 'অনুরোধ পাঠানো সম্ভব হয়নি।', 'error');
                }
            } catch (err) {
                Swal.fire('নেটওয়ার্ক ত্রুটি', err.message || 'সার্ভারে সংযোগ দেওয়া যাচ্ছে না।', 'error');
            }
        }

        async function cancelDeletionRequest(topicIds, targetName, targetType = 'topic') {
            const ids = Array.isArray(topicIds) ? topicIds : [topicIds];
            if (!ids || ids.length === 0) return;

            const label = targetType === 'chapter' ? `চ্যাপ্টার "${targetName}"-এর ${ids.length > 1 ? ids.length + 'টি ' : ''}` : `"${targetName}" `;
            const confirm = await Swal.fire({
                title: 'অনুরোধ প্রত্যাহার করবেন?',
                text: `${label}টপিক মুছে ফেলার অনুরোধটি বাতিল করতে চান?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'হ্যাঁ, বাতিল করুন',
                cancelButtonText: 'না'
            });

            if (!confirm.isConfirmed) return;

            try {
                Swal.fire({ title: 'প্রক্রিয়াধীন...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const res = await fetch(`${apiBase}/topics/cancel-delete-request`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ topicIds: ids })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'বাতিল হয়েছে!',
                        text: data.message || 'মুছে ফেলার অনুরোধ বাতিল করা হয়েছে।',
                        timer: 1200,
                        showConfirmButton: false
                    });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.error || 'Failed to cancel deletion request', 'error');
                }
            } catch (err) {
                Swal.fire('Error', err.message || 'Connection error', 'error');
            }
        }

        // ==========================================
        // BULK ACTIONS FOR TEACHER SUBMISSIONS
        // ==========================================
        function getSelectedSubmissions() {
            const checkedBoxes = Array.from(document.querySelectorAll('.sub-topic-checkbox:checked'));
            const uniqueMap = new Map();
            checkedBoxes.forEach(cb => {
                const id = cb.dataset.id;
                if (id && !uniqueMap.has(id)) {
                    uniqueMap.set(id, {
                        id: id,
                        status: cb.dataset.status,
                        name: cb.dataset.name
                    });
                }
            });
            return Array.from(uniqueMap.values());
        }

        function onSubCheckboxChange(cb) {
            const id = cb.dataset.id;
            if (id) {
                document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                    if (other !== cb) other.checked = cb.checked;
                });
            }
            if (cb.dataset.chIdx !== undefined) {
                updateChapterCheckboxState(cb.dataset.chIdx);
            }
            updateSelectedSubmissionsCount();
        }

        function updateChapterCheckboxState(chIdx) {
            if (chIdx === undefined || chIdx === null) return;
            const chBoxes = Array.from(document.querySelectorAll(`.sub-topic-checkbox.sub-ch-${chIdx}`));
            const visibleChBoxes = chBoxes.filter(cb => !cb.closest('.submission-topic-row')?.classList.contains('hidden'));
            const headerCb = document.getElementById(`sub_ch_table_cb_${chIdx}`);
            const cardCb = document.getElementById(`sub_ch_cb_${chIdx}`);
            
            if (visibleChBoxes.length === 0) {
                if (headerCb) { headerCb.checked = false; headerCb.indeterminate = false; }
                if (cardCb) { cardCb.checked = false; cardCb.indeterminate = false; }
                return;
            }
            
            const checkedCount = visibleChBoxes.filter(cb => cb.checked).length;
            const allChecked = checkedCount === visibleChBoxes.length;
            const someChecked = checkedCount > 0 && !allChecked;
            
            if (headerCb) {
                headerCb.checked = allChecked;
                headerCb.indeterminate = someChecked;
            }
            if (cardCb) {
                cardCb.checked = allChecked;
                cardCb.indeterminate = someChecked;
            }
        }

        function toggleChapterSubmissions(sourceCb, sIdx) {
            const isChecked = sourceCb.checked;
            const chBoxes = document.querySelectorAll(`.sub-topic-checkbox.sub-ch-${sIdx}`);
            chBoxes.forEach(cb => {
                const row = cb.closest('.submission-topic-row');
                if (!row || !row.classList.contains('hidden')) {
                    cb.checked = isChecked;
                    const id = cb.dataset.id;
                    if (id) {
                        document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                            other.checked = isChecked;
                        });
                    }
                }
            });
            const headerCb = document.getElementById(`sub_ch_table_cb_${sIdx}`);
            const cardCb = document.getElementById(`sub_ch_cb_${sIdx}`);
            if (headerCb) { headerCb.checked = isChecked; headerCb.indeterminate = false; }
            if (cardCb) { cardCb.checked = isChecked; cardCb.indeterminate = false; }
            updateSelectedSubmissionsCount();
        }

        function toggleSelectAllSubmissions() {
            const allVisibleSelectable = Array.from(document.querySelectorAll('.sub-topic-checkbox')).filter(cb => {
                const row = cb.closest('.submission-topic-row');
                return !row || !row.classList.contains('hidden');
            });
            if (allVisibleSelectable.length === 0) return;
            
            const allChecked = allVisibleSelectable.every(cb => cb.checked);
            const targetState = !allChecked;
            
            allVisibleSelectable.forEach(cb => {
                cb.checked = targetState;
                const id = cb.dataset.id;
                if (id) {
                    document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                        other.checked = targetState;
                    });
                }
            });
            
            // Update all chapter header checkboxes
            document.querySelectorAll('[id^="sub_ch_table_cb_"], [id^="sub_ch_cb_"]').forEach(chCb => {
                chCb.checked = targetState;
                chCb.indeterminate = false;
            });
            
            updateSelectedSubmissionsCount();
        }

        function clearSelectedSubmissions() {
            document.querySelectorAll('.sub-topic-checkbox').forEach(cb => cb.checked = false);
            document.querySelectorAll('[id^="sub_ch_table_cb_"], [id^="sub_ch_cb_"]').forEach(chCb => {
                chCb.checked = false;
                chCb.indeterminate = false;
            });
            updateSelectedSubmissionsCount();
        }

        function updateSelectedSubmissionsCount() {
            const selected = getSelectedSubmissions();
            const bar = document.getElementById('submissionsBulkBar');
            const badge = document.getElementById('subSelectedCount');
            const btnResubmit = document.getElementById('btnBulkResubmit');
            const btnResubmitText = document.getElementById('btnBulkResubmitText');
            const btnDeleteText = document.getElementById('btnBulkDeleteText');
            const btnToggleAllText = document.getElementById('textToggleSelectAllSub');

            if (!bar) return;

            if (selected.length > 0) {
                bar.classList.remove('hidden');
                if (badge) badge.innerText = selected.length;
                
                const rejectedCount = selected.filter(s => s.status === 'rejected').length;
                if (btnResubmit) {
                    if (rejectedCount > 0) {
                        btnResubmit.classList.remove('hidden');
                        if (btnResubmitText) btnResubmitText.innerText = `Resubmit (${rejectedCount})`;
                    } else {
                        btnResubmit.classList.add('hidden');
                    }
                }
                if (btnDeleteText) {
                    btnDeleteText.innerText = `Delete (${selected.length})`;
                }
            } else {
                bar.classList.add('hidden');
            }

            if (btnToggleAllText) {
                const allVisibleSelectable = Array.from(document.querySelectorAll('.sub-topic-checkbox')).filter(cb => {
                    const row = cb.closest('.submission-topic-row');
                    return !row || !row.classList.contains('hidden');
                });
                const allChecked = allVisibleSelectable.length > 0 && allVisibleSelectable.every(cb => cb.checked);
                btnToggleAllText.innerText = allChecked ? 'Deselect All' : 'Select All';
            }
        }

        async function bulkActionSubmissions(action) {
            const selected = getSelectedSubmissions();
            if (selected.length === 0) return;

            let targetIds = [];
            let title = '';
            let htmlMsg = '';
            let confirmBtnText = '';
            let confirmBtnColor = '#2563eb';

            if (action === 'resubmit') {
                const rejectedList = selected.filter(s => s.status === 'rejected');
                if (rejectedList.length === 0) {
                    Swal.fire('No Rejected Topics', 'None of the selected topics are in "Revision Required" status.', 'info');
                    return;
                }
                targetIds = rejectedList.map(s => s.id);
                title = `Resubmit ${targetIds.length} Topic(s)?`;
                htmlMsg = `Resubmit <strong>${targetIds.length}</strong> rejected topic(s) to Admin review for approval?`;
                confirmBtnText = 'Yes, Resubmit';
                confirmBtnColor = '#d97706';
            } else if (action === 'delete') {
                targetIds = selected.map(s => s.id);
                title = `Delete ${targetIds.length} Submission(s)?`;
                htmlMsg = `Permanently remove <strong>${targetIds.length}</strong> selected topic submission(s)? This action cannot be undone.`;
                confirmBtnText = 'Yes, Delete All';
                confirmBtnColor = '#e11d48';
            } else {
                return;
            }

            const confirm = await Swal.fire({
                title: title,
                html: htmlMsg,
                icon: action === 'delete' ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: confirmBtnColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: confirmBtnText
            });

            if (confirm.isConfirmed) {
                try {
                    Swal.fire({
                        title: action === 'delete' ? 'Removing...' : 'Resubmitting...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const res = await fetch(`${apiBase}/topics/submissions/bulk-action`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            topicIds: targetIds,
                            action: action
                        })
                    });

                    const text = await res.text();
                    let data = {};
                    try { data = JSON.parse(text); } catch (e) { data = { error: text }; }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        const u = new URL(window.location.href);
                        u.searchParams.set('tab', 'submissions');
                        window.location.href = u.toString();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to perform bulk action', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', err.message || 'Connection error', 'error');
                }
            }
        }

        // Auto Tab & Submissions Filter from URL
        document.addEventListener('DOMContentLoaded', () => {
            const p = new URLSearchParams(window.location.search);
            if (p.get('tab') === 'submissions' || window.location.hash === '#submissions') {
                switchTeacherTab('submissions');
            } else {
                switchTeacherTab('live');
            }

            const subStatus = p.get('subStatus');
            if (subStatus && ['all', 'pending', 'rejected', 'approved'].includes(subStatus)) {
                filterSubmissions(subStatus);
            }

            const teacherModalGrid = document.getElementById('teacherModalClassGrid');
            if (teacherModalGrid) {
                teacherModalGrid.addEventListener('change', () => checkTeacherModalSegments());
            }
        });
        function selectTeacherModalClasses(mode) {
            const cbs = document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]');
            if (mode === 'all') cbs.forEach(cb => cb.checked = true);
            else if (mode === 'clear') cbs.forEach(cb => cb.checked = false);
            checkTeacherModalSegments();
        }
    </script>
