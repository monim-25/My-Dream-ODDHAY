        // ==========================================
        // BULK ACTIONS FOR TEACHER SUBMISSIONS
        // ==========================================
        function getSelectedSubmissions() {
            const checkedBoxes = Array.from(document.querySelectorAll('.sub-topic-checkbox:checked'));
            const uniqueMap = new Map();
            checkedBoxes.forEach(cb => {
                const id = cb.dataset.id;
                if (id && !uniqueMap.has(id)) {
                    uniqueMap.set(id, {
                        id: id,
                        status: cb.dataset.status,
                        name: cb.dataset.name
                    });
                }
            });
            return Array.from(uniqueMap.values());
        }

        function onSubCheckboxChange(cb) {
            const id = cb.dataset.id;
            if (id) {
                document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                    if (other !== cb) other.checked = cb.checked;
                });
            }
            if (cb.dataset.chIdx !== undefined) {
                updateChapterCheckboxState(cb.dataset.chIdx);
            }
            updateSelectedSubmissionsCount();
        }

        function updateChapterCheckboxState(chIdx) {
            if (chIdx === undefined || chIdx === null) return;
            const chBoxes = Array.from(document.querySelectorAll(`.sub-topic-checkbox.sub-ch-${chIdx}`));
            const visibleChBoxes = chBoxes.filter(cb => !cb.closest('.submission-topic-row')?.classList.contains('hidden'));
            const headerCb = document.getElementById(`sub_ch_table_cb_${chIdx}`);
            const cardCb = document.getElementById(`sub_ch_cb_${chIdx}`);
            
            if (visibleChBoxes.length === 0) {
                if (headerCb) { headerCb.checked = false; headerCb.indeterminate = false; }
                if (cardCb) { cardCb.checked = false; cardCb.indeterminate = false; }
                return;
            }
            
            const checkedCount = visibleChBoxes.filter(cb => cb.checked).length;
            const allChecked = checkedCount === visibleChBoxes.length;
            const someChecked = checkedCount > 0 && !allChecked;
            
            if (headerCb) {
                headerCb.checked = allChecked;
                headerCb.indeterminate = someChecked;
            }
            if (cardCb) {
                cardCb.checked = allChecked;
                cardCb.indeterminate = someChecked;
            }
        }

        function toggleChapterSubmissions(sourceCb, sIdx) {
            const isChecked = sourceCb.checked;
            const chBoxes = document.querySelectorAll(`.sub-topic-checkbox.sub-ch-${sIdx}`);
            chBoxes.forEach(cb => {
                const row = cb.closest('.submission-topic-row');
                if (!row || !row.classList.contains('hidden')) {
                    cb.checked = isChecked;
                    const id = cb.dataset.id;
                    if (id) {
                        document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                            other.checked = isChecked;
                        });
                    }
                }
            });
            const headerCb = document.getElementById(`sub_ch_table_cb_${sIdx}`);
            const cardCb = document.getElementById(`sub_ch_cb_${sIdx}`);
            if (headerCb) { headerCb.checked = isChecked; headerCb.indeterminate = false; }
            if (cardCb) { cardCb.checked = isChecked; cardCb.indeterminate = false; }
            updateSelectedSubmissionsCount();
        }

        function toggleSelectAllSubmissions() {
            const allVisibleSelectable = Array.from(document.querySelectorAll('.sub-topic-checkbox')).filter(cb => {
                const row = cb.closest('.submission-topic-row');
                return !row || !row.classList.contains('hidden');
            });
            if (allVisibleSelectable.length === 0) return;
            
            const allChecked = allVisibleSelectable.every(cb => cb.checked);
            const targetState = !allChecked;
            
            allVisibleSelectable.forEach(cb => {
                cb.checked = targetState;
                const id = cb.dataset.id;
                if (id) {
                    document.querySelectorAll(`.sub-topic-checkbox[data-id="${id}"]`).forEach(other => {
                        other.checked = targetState;
                    });
                }
            });
            
            // Update all chapter header checkboxes
            document.querySelectorAll('[id^="sub_ch_table_cb_"], [id^="sub_ch_cb_"]').forEach(chCb => {
                chCb.checked = targetState;
                chCb.indeterminate = false;
            });
            
            updateSelectedSubmissionsCount();
        }

        function clearSelectedSubmissions() {
            document.querySelectorAll('.sub-topic-checkbox').forEach(cb => cb.checked = false);
            document.querySelectorAll('[id^="sub_ch_table_cb_"], [id^="sub_ch_cb_"]').forEach(chCb => {
                chCb.checked = false;
                chCb.indeterminate = false;
            });
            updateSelectedSubmissionsCount();
        }

        function updateSelectedSubmissionsCount() {
            const selected = getSelectedSubmissions();
            const bar = document.getElementById('submissionsBulkBar');
            const badge = document.getElementById('subSelectedCount');
            const btnResubmit = document.getElementById('btnBulkResubmit');
            const btnResubmitText = document.getElementById('btnBulkResubmitText');
            const btnDeleteText = document.getElementById('btnBulkDeleteText');
            const btnToggleAllText = document.getElementById('textToggleSelectAllSub');

            if (!bar) return;

            if (selected.length > 0) {
                bar.classList.remove('hidden');
                if (badge) badge.innerText = selected.length;
                
                const rejectedCount = selected.filter(s => s.status === 'rejected').length;
                if (btnResubmit) {
                    if (rejectedCount > 0) {
                        btnResubmit.classList.remove('hidden');
                        if (btnResubmitText) btnResubmitText.innerText = `Resubmit (${rejectedCount})`;
                    } else {
                        btnResubmit.classList.add('hidden');
                    }
                }
                if (btnDeleteText) {
                    btnDeleteText.innerText = `Delete (${selected.length})`;
                }
            } else {
                bar.classList.add('hidden');
            }

            if (btnToggleAllText) {
                const allVisibleSelectable = Array.from(document.querySelectorAll('.sub-topic-checkbox')).filter(cb => {
                    const row = cb.closest('.submission-topic-row');
                    return !row || !row.classList.contains('hidden');
                });
                const allChecked = allVisibleSelectable.length > 0 && allVisibleSelectable.every(cb => cb.checked);
                btnToggleAllText.innerText = allChecked ? 'Deselect All' : 'Select All';
            }
        }

        async function bulkActionSubmissions(action) {
            const selected = getSelectedSubmissions();
            if (selected.length === 0) return;

            let targetIds = [];
            let title = '';
            let htmlMsg = '';
            let confirmBtnText = '';
            let confirmBtnColor = '#2563eb';

            if (action === 'resubmit') {
                const rejectedList = selected.filter(s => s.status === 'rejected');
                if (rejectedList.length === 0) {
                    Swal.fire('No Rejected Topics', 'None of the selected topics are in "Revision Required" status.', 'info');
                    return;
                }
                targetIds = rejectedList.map(s => s.id);
                title = `Resubmit ${targetIds.length} Topic(s)?`;
                htmlMsg = `Resubmit <strong>${targetIds.length}</strong> rejected topic(s) to Admin review for approval?`;
                confirmBtnText = 'Yes, Resubmit';
                confirmBtnColor = '#d97706';
            } else if (action === 'delete') {
                targetIds = selected.map(s => s.id);
                title = `Delete ${targetIds.length} Submission(s)?`;
                htmlMsg = `Permanently remove <strong>${targetIds.length}</strong> selected topic submission(s)? This action cannot be undone.`;
                confirmBtnText = 'Yes, Delete All';
                confirmBtnColor = '#e11d48';
            } else {
                return;
            }

            const confirm = await Swal.fire({
                title: title,
                html: htmlMsg,
                icon: action === 'delete' ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: confirmBtnColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: confirmBtnText
            });

            if (confirm.isConfirmed) {
                try {
                    Swal.fire({
                        title: action === 'delete' ? 'Removing...' : 'Resubmitting...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const res = await fetch(`${apiBase}/topics/submissions/bulk-action`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            topicIds: targetIds,
                            action: action
                        })
                    });

                    const text = await res.text();
                    let data = {};
                    try { data = JSON.parse(text); } catch (e) { data = { error: text }; }

                    if (res.ok && data.success !== false) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        const u = new URL(window.location.href);
                        u.searchParams.set('tab', 'submissions');
                        window.location.href = u.toString();
                    } else {
                        Swal.fire('Error', data.error || 'Failed to perform bulk action', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', err.message || 'Connection error', 'error');
                }
            }
        }

        // Auto Tab & Submissions Filter from URL
        document.addEventListener('DOMContentLoaded', () => {
            const p = new URLSearchParams(window.location.search);
            if (p.get('tab') === 'submissions' || window.location.hash === '#submissions') {
                switchTeacherTab('submissions');
            } else {
                switchTeacherTab('live');
            }

            const subStatus = p.get('subStatus');
            if (subStatus && ['all', 'pending', 'rejected', 'approved'].includes(subStatus)) {
                filterSubmissions(subStatus);
            }
        });
        function selectTeacherModalClasses(mode) {
            const cbs = document.querySelectorAll('#teacherModalClassGrid input[name="targetClass"]');
            if (mode === 'all') cbs.forEach(cb => cb.checked = true);
            else if (mode === 'clear') cbs.forEach(cb => cb.checked = false);
        }
    </script>
</body>
</html>
