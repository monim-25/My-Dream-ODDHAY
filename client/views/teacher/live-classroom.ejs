                                <div class="flex gap-1 shrink-0">
                                    <button type="button" onclick="toggleEditReplyForm('${c._id}','${r._id}',true)" class="px-2 py-1 text-[9px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 text-slate-500 rounded-none">Cancel</button>
                                    <button type="submit" class="px-2.5 py-1 bg-primary hover:bg-primary/95 text-white text-[9px] font-bold uppercase tracking-wider rounded-none">Save</button>
