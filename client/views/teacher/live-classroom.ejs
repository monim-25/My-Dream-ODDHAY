    let isRecordingLive = false;
    let recordingStartTime = null;
    let recordingInterval = null;
    
    // MediaRecorder variables
    let mediaRecorder = null;
    let recordedChunks = [];
    let recordingStream = null;

    // Load from localStorage to survive refresh
    const storedRecordingStatus = localStorage.getItem('isRecordingLive_' + CHANNEL);
    const storedRecordingStartTime = localStorage.getItem('recordingStartTime_' + CHANNEL);
    let recordingElapsedSeconds = parseInt(localStorage.getItem('recordingElapsedSeconds_' + CHANNEL) || '0', 10);
    
    if (storedRecordingStatus === 'true') {
        isRecordingLive = true;
        recordingStartTime = parseInt(storedRecordingStartTime, 10);
        startRecordingTimer();
    }

    function startRecordingTimer() {
        clearInterval(recordingInterval);
        recordingInterval = setInterval(() => {
            if (!isRecordingLive) return;
            recordingElapsedSeconds++;
            localStorage.setItem('recordingElapsedSeconds_' + CHANNEL, recordingElapsedSeconds);
            const m = Math.floor(recordingElapsedSeconds / 60).toString().padStart(2, '0');
            const s = (recordingElapsedSeconds % 60).toString().padStart(2, '0');
            const timeStr = m + ':' + s;
            const timeEl = document.getElementById('recording-time');
            if (timeEl) timeEl.innerText = timeStr;
        }, 1000);
    }

    <% if (isModerator) { %>
    let _recCanvas = null;
    let _recAudioCtx = null;
    let _recAnimFrame = null;

    async function toggleRecordingStatus() {
        if (!mediaRecorder) {
            // ── START recording (first time) ──
            const mainPlayer = document.getElementById('main-player');
            const containerEl = document.getElementById('agora-video-container');
            const videoEl = mainPlayer ? mainPlayer.querySelector('video') : null;

            if (!videoEl) {
                alert('ক্লাসে যোগ দিন প্রথমে! (No active video — please join the class first.)');
                return;
            }

            try {
                // 1. Canvas at minimum 1280×720 for quality recording
                _recCanvas = document.createElement('canvas');
                _recCanvas.width  = Math.max(containerEl ? containerEl.clientWidth  : 1280, 1280);
                _recCanvas.height = Math.max(containerEl ? containerEl.clientHeight : 720,  720);
                const ctx = _recCanvas.getContext('2d');

                // Draw loop — runs on every animation frame
                function drawLiveFrame() {
                    _recAnimFrame = requestAnimationFrame(drawLiveFrame);
                    if (!_recCanvas) return;
                    ctx.fillStyle = '#000';
                    ctx.fillRect(0, 0, _recCanvas.width, _recCanvas.height);

                    // 1. Query the main video element dynamically on every frame to support screen share toggles
                    const currentMainPlayer = document.getElementById('main-player');
                    const currentVideoEl = currentMainPlayer ? currentMainPlayer.querySelector('video') : null;
                    if (currentVideoEl && currentVideoEl.readyState >= 2) {
                        try { ctx.drawImage(currentVideoEl, 0, 0, _recCanvas.width, _recCanvas.height); } catch(e) {}
                    }

                    // Setup positions for small tiles (top-right side column)
                    let rx = _recCanvas.width - 170, ry = 10;

                    // 2. Draw local host camera overlay (if screen sharing and overlay is active)
                    const localCamOverlay = document.getElementById('local-cam-overlay');
                    if (localCamOverlay && !localCamOverlay.classList.contains('hidden')) {
                        const localCamVid = localCamOverlay.querySelector('video');
                        if (localCamVid && localCamVid.readyState >= 2) {
                            try {
                                ctx.drawImage(localCamVid, rx, ry, 160, 120);
                                // Amber border for the host
                                ctx.strokeStyle = 'rgba(245,158,11,0.5)';
                                ctx.lineWidth = 2;
                                ctx.strokeRect(rx, ry, 160, 120);
                                
                                // Small "You (Host)" label
                                ctx.fillStyle = 'rgba(0,0,0,0.6)';
                                ctx.fillRect(rx + 2, ry + 120 - 20, 60, 18);
                                ctx.fillStyle = '#fff';
                                ctx.font = 'bold 9px sans-serif';
                                ctx.fillText('You (Host)', rx + 6, ry + 120 - 7);
                                
                                ry += 130;
                            } catch(e) {}
                        }
                    }

                    // 3. Draw remote small tiles top-right (excluding host if they are screen sharing, already handled)
                    const remoteVids = document.querySelectorAll('#remote-playerlist video');
                    remoteVids.forEach(rv => {
                        if (rv.readyState >= 2) {
                            try {
                                ctx.drawImage(rv, rx, ry, 160, 120);
                                // subtle border
                                ctx.strokeStyle = 'rgba(255,255,255,0.2)';
                                ctx.lineWidth = 2;
                                ctx.strokeRect(rx, ry, 160, 120);
                                ry += 130;
                            } catch(e) {}
                        }
                    });
                }
                drawLiveFrame();

                // 2. Audio context — mix local + all remote audio
                _recAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const audioDest = _recAudioCtx.createMediaStreamDestination();

                const mixTrack = (mediaStreamTrack) => {
                    if (!mediaStreamTrack) return;
                    try {
                        const src = _recAudioCtx.createMediaStreamSource(new MediaStream([mediaStreamTrack]));
                        src.connect(audioDest);
                    } catch(e) { console.warn('Audio mix error:', e); }
                };

                // Local mic
                if (localAudioTrack) {
                    const aTrack = typeof localAudioTrack.getMediaStreamTrack === 'function'
                        ? localAudioTrack.getMediaStreamTrack()
                        : localAudioTrack._mediaStreamTrack;
                    mixTrack(aTrack);
                }

                // Remote participants
                if (client && client.remoteUsers) {
                    client.remoteUsers.forEach(ru => {
                        if (ru.audioTrack) {
                            const rATrack = typeof ru.audioTrack.getMediaStreamTrack === 'function'
                                ? ru.audioTrack.getMediaStreamTrack()
                                : ru.audioTrack._mediaStreamTrack;
                            mixTrack(rATrack);
                        }
                    });
                }

                // 3. Combine canvas video + mixed audio into one stream
                const canvasStream = _recCanvas.captureStream(30);
                const finalStream = new MediaStream([
                    ...canvasStream.getVideoTracks(),
                    ...audioDest.stream.getAudioTracks()
                ]);

                // Pick best codec — target ≥720p quality (4.5 Mbps video)
                const TARGET_BITRATE = 4500000; // 4.5 Mbps
                let options = {};
                if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')) {
                    options = { mimeType: 'video/webm;codecs=vp9,opus', videoBitsPerSecond: TARGET_BITRATE, audioBitsPerSecond: 128000 };
                } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')) {
                    options = { mimeType: 'video/webm;codecs=vp8,opus', videoBitsPerSecond: TARGET_BITRATE, audioBitsPerSecond: 128000 };
                } else if (MediaRecorder.isTypeSupported('video/mp4')) {
                    options = { mimeType: 'video/mp4', videoBitsPerSecond: TARGET_BITRATE, audioBitsPerSecond: 128000 };
                } else if (MediaRecorder.isTypeSupported('video/webm')) {
                    options = { mimeType: 'video/webm', videoBitsPerSecond: TARGET_BITRATE };
                }

                mediaRecorder = new MediaRecorder(finalStream, options);
                recordedChunks = [];
                recordingStream = finalStream;
                recordingElapsedSeconds = 0;
                localStorage.setItem('recordingElapsedSeconds_' + CHANNEL, '0');

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) {
                        recordedChunks.push(e.data);
                    }
                };

                mediaRecorder.onerror = (e) => {
                    console.error('MediaRecorder error:', e);
                };

                mediaRecorder.start(1000); // 1-second slices so data flows continuously
                isRecordingLive = true;

            } catch (err) {
                console.error('Recording start failed:', err);
                // Cancel the animation frame if we failed
                if (_recAnimFrame) { cancelAnimationFrame(_recAnimFrame); _recAnimFrame = null; }
                _recCanvas = null;
                if (_recAudioCtx) { _recAudioCtx.close(); _recAudioCtx = null; }
                mediaRecorder = null;
                alert('রেকর্ডিং শুরু করতে সমস্যা হয়েছে।\nError: ' + err.message);
                return;
            }

        } else {
            // ── TOGGLE pause / resume ──
            if (mediaRecorder.state === 'recording') {
                mediaRecorder.pause();
                isRecordingLive = false; // visually "paused"
            } else if (mediaRecorder.state === 'paused') {
                mediaRecorder.resume();
                isRecordingLive = true;
            }
        }

        // ── Update button UI ──
        const btn = document.getElementById('btn-record');
        const indicator = document.getElementById('recording-indicator');

        if (btn) {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                btn.classList.add('!bg-rose-500', '!border-rose-500', 'shadow-lg', 'shadow-rose-500/40');
                btn.classList.remove('!bg-amber-500', '!border-amber-500', 'shadow-amber-500/40');
                btn.innerHTML = '<span class="material-symbols-rounded text-xl animate-pulse text-white">pause_circle</span>';
                btn.title = 'Pause Recording';
            } else if (mediaRecorder && mediaRecorder.state === 'paused') {
                btn.classList.remove('!bg-rose-500', '!border-rose-500', 'shadow-rose-500/40');
                btn.classList.add('!bg-amber-500', '!border-amber-500', 'shadow-lg', 'shadow-amber-500/40');
                btn.innerHTML = '<span class="material-symbols-rounded text-xl text-white">play_circle</span>';
                btn.title = 'Resume Recording';
            } else {
                btn.classList.remove('!bg-rose-500', '!border-rose-500', 'shadow-lg', 'shadow-rose-500/40', '!bg-amber-500', '!border-amber-500', 'shadow-amber-500/40');
                btn.innerHTML = '<span class="material-symbols-rounded text-xl text-rose-500">radio_button_checked</span>';
                btn.title = 'Start Recording';
            }
        }

        // Show indicator whenever mediaRecorder exists (recording or paused)
        if (indicator && mediaRecorder) {
            indicator.classList.remove('hidden');
            indicator.classList.add('flex');
            // Show paused state
            const recLabel = indicator.querySelector('span:nth-child(2)');
            const dot = indicator.querySelector('span:nth-child(1)');
            if (recLabel) recLabel.textContent = isRecordingLive ? 'REC' : 'PAUSED';
            if (dot) {
                if (isRecordingLive) {
                    dot.classList.add('animate-pulse');
                    dot.classList.replace('bg-amber-500', 'bg-rose-500');
                    indicator.classList.replace('bg-amber-500/20', 'bg-rose-500/20');
                    indicator.classList.replace('border-amber-500/30', 'border-rose-500/30');
                } else {
                    dot.classList.remove('animate-pulse');
                    dot.classList.replace('bg-rose-500', 'bg-amber-500');
                    indicator.classList.replace('bg-rose-500/20', 'bg-amber-500/20');
                    indicator.classList.replace('border-rose-500/30', 'border-amber-500/30');
                }
            }
        }

        // ── Persist state & manage timer ──
        if (isRecordingLive) {
            if (!recordingStartTime) recordingStartTime = Date.now();
            localStorage.setItem('isRecordingLive_' + CHANNEL, 'true');
            localStorage.setItem('recordingStartTime_' + CHANNEL, recordingStartTime);
            localStorage.setItem('hasRecordedSomething_' + CHANNEL, 'true');
            startRecordingTimer();
        } else {
            localStorage.setItem('isRecordingLive_' + CHANNEL, 'false');
            clearInterval(recordingInterval);
        }

        socket.emit('host:toggle_recording', { 
            room: '<%= roomId %>', 
            isRecording: isRecordingLive, 
            isPaused: (!isRecordingLive && localStorage.getItem('hasRecordedSomething_' + CHANNEL) === 'true'),
            startTime: recordingStartTime 
        });
    }
    <% } %>

    socket.on('room:recording_status', function(data) {
        if (data.room === '<%= roomId %>') {
            const indicator = document.getElementById('recording-indicator');
            if (indicator) {
                const recLabel = indicator.querySelector('span:nth-child(2)');
                const dot = indicator.querySelector('span:nth-child(1)');
                
                if (data.isRecording) {
                    indicator.classList.remove('hidden');
                    indicator.classList.add('flex');
                    if (recLabel) recLabel.textContent = 'REC';
                    if (dot) {
                        dot.classList.add('animate-pulse');
                        dot.classList.replace('bg-amber-500', 'bg-rose-500');
                        indicator.classList.replace('bg-amber-500/20', 'bg-rose-500/20');
                        indicator.classList.replace('border-amber-500/30', 'border-rose-500/30');
                    }
                    if (data.startTime) {
                        recordingStartTime = data.startTime;
                        startRecordingTimer();
                    }
                } else if (data.isPaused) {
                    indicator.classList.remove('hidden');
                    indicator.classList.add('flex');
                    if (recLabel) recLabel.textContent = 'PAUSED';
                    if (dot) {
                        dot.classList.remove('animate-pulse');
                        dot.classList.replace('bg-rose-500', 'bg-amber-500');
                        indicator.classList.replace('bg-rose-500/20', 'bg-amber-500/20');
                        indicator.classList.replace('border-rose-500/30', 'border-amber-500/30');
                    }
                    clearInterval(recordingInterval);
                } else {
                    indicator.classList.add('hidden');
                    indicator.classList.remove('flex');
                    clearInterval(recordingInterval);
                }
            }
        }
    });

    function toggleReactionBar() {
        const bar = document.getElementById('reaction-bar');
        if (bar) bar.classList.toggle('hidden');
    }

    function sendReaction(emoji) {
        socket.emit('reaction:send', { room: '<%= roomId %>', emoji: emoji });
    }

    socket.on('reaction:new', function(data) {
        if (!data.emoji) return;
        
        const container = document.getElementById('agora-video-container');
        if (!container) return;
        
        const el = document.createElement('div');
        el.innerText = data.emoji;
        el.className = 'absolute text-3xl pointer-events-none z-30 drop-shadow-md';
        
        const startX = Math.random() * 80 + 10;
        el.style.left = startX + '%';
        el.style.bottom = '10%';
        
        el.animate([
            { transform: 'translateY(0) scale(0.5)', opacity: 0 },
            { transform: 'translateY(-20px) scale(1.2)', opacity: 1, offset: 0.2 },
            { transform: 'translateY(-100px) scale(1)', opacity: 1, offset: 0.8 },
            { transform: 'translateY(-150px) scale(0.5)', opacity: 0 }
        ], {
            duration: 2000 + Math.random() * 1000,
            easing: 'ease-out',
            fill: 'forwards'
        });
        
        container.appendChild(el);
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 3000);
    });

    function postComment() {
        const input = document.getElementById('commentInput');
        const text = input.value.trim();
        if (!text) return;
        socket.emit('message:send', { room: '<%= roomId %>', text });
        input.value = '';
        input.style.height = 'auto';
    }

    <% if (isModerator && locals.liveNodeId) { %>
    async function submitEditDetails(e) {
        e.preventDefault();
        const btn = document.getElementById('saveDetailsBtn');
        const title = document.getElementById('editTitleInput').value.trim();
        const desc = document.getElementById('editDescInput').value.trim();
        
        const orig = btn.innerText; btn.disabled = true; btn.innerText = 'Saving...';
        try {
            const res = await fetch(`/teacher/course/<%= courseId %>/curriculum/node/<%= liveNodeId %>`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: title, description: desc })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('playerVideoTitle').innerText = title;
                document.getElementById('liveDescriptionText').innerText = desc || 'লাইভ ক্লাসে আপনাকে স্বাগতম!';
                document.getElementById('editDetailsModal').classList.add('hidden');
            } else {
                alert('Failed to save: ' + (data.error || 'Server error'));
            }
        } catch (err) {
            alert('Failed to save details');
        } finally {
            btn.disabled = false; btn.innerText = orig;
        }
    }
    <% } %>
    // ── Auto-join Agora channel if already joined previously (survives refresh) ──
    if (sessionStorage.getItem("agora_joined_" + CHANNEL) === "true") {
        isAutoJoining = true;
        joinAgoraChannel().catch(err => {
            console.warn("Auto-join failed:", err);
        }).finally(() => {
            isAutoJoining = false;
        });
    }

    // Close end-live modal on backdrop click
    document.getElementById('endLiveModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
</script>

<% if (isModerator && locals.liveNodeId) { %>
<!-- Edit Details Modal -->
<div id="editDetailsModal" class="hidden fixed inset-0 z-[200] bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#0f172a] rounded-xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-100 dark:border-slate-800">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 dark:border-white/5">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">Edit Live Details</h3>
            <button onclick="document.getElementById('editDetailsModal').classList.add('hidden')" class="p-1.5 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 hover:text-slate-600 dark:hover:text-white rounded-full transition-colors">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <form onsubmit="submitEditDetails(event)" class="p-6">
            <div class="mb-4">
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5 uppercase tracking-wider">Title</label>
                <input type="text" id="editTitleInput" value="<%= locals.liveTitle || '' %>" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-lg text-sm text-slate-800 dark:text-white focus:outline-none focus:border-primary transition-all">
            </div>
            <div class="mb-6">
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5 uppercase tracking-wider">Description</label>
                <textarea id="editDescInput" rows="4" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-lg text-sm text-slate-800 dark:text-white focus:outline-none focus:border-primary transition-all resize-y"><%= locals.liveDescription || '' %></textarea>
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('editDetailsModal').classList.add('hidden')" class="px-5 py-2.5 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 rounded-lg transition-colors">Cancel</button>
                <button type="submit" id="saveDetailsBtn" class="px-5 py-2.5 text-sm font-bold text-white bg-primary hover:bg-primary/90 rounded-lg shadow-md transition-all">Save Changes</button>
            </div>
        </form>
    </div>
</div>
<% } %>

<!-- ── END LIVE CUSTOM CONFIRMATION MODAL ── -->
<div id="endLiveModal" class="fixed inset-0 z-[300] hidden flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="modal-inner w-full max-w-sm bg-[#0f172a] border border-rose-500/30 shadow-2xl shadow-rose-900/40 rounded-2xl overflow-hidden">
        <!-- Red stripe header -->
        <div class="bg-gradient-to-r from-rose-700 to-rose-500 px-6 py-4 flex items-center gap-3">
            <span class="material-symbols-rounded text-white text-3xl">stop_circle</span>
            <div>
                <h3 class="text-white font-black text-base">End Live Class?</h3>
                <p class="text-rose-200 text-[11px] font-medium">This will disconnect all participants.</p>
            </div>
        </div>
        <!-- Body -->
        <div class="px-6 py-5">
            <p id="endLiveSubMsg" class="text-slate-300 text-sm leading-relaxed mb-6">Recording will be saved automatically as a recorded lesson.</p>
            <div class="flex gap-3">
                <button type="button" onclick="document.getElementById('endLiveModal').classList.add('hidden')" class="flex-1 py-2.5 rounded-xl text-sm font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-all">Cancel</button>
                <button type="button" onclick="_doEndLiveClass()" class="flex-1 py-2.5 rounded-xl text-sm font-black text-white bg-rose-600 hover:bg-rose-500 shadow-lg shadow-rose-700/40 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-rounded text-[18px]">stop_circle</span> End Class
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const headerTitleEl = document.getElementById('headerPageTitle');
        if (headerTitleEl) {
            const fullTitle = <%- JSON.stringify(locals.liveTitle || (course ? course.title : 'Live Class')) %>;
            const words = (fullTitle || '').trim().split(/\s+/);
            headerTitleEl.innerText = words.length > 5 ? words.slice(0, 5).join(' ') + '...' : fullTitle;
            headerTitleEl.title = fullTitle;
        }
        const navBackBtn = document.getElementById('navBackBtn');
        if (navBackBtn) {
            navBackBtn.classList.remove('hidden');
            navBackBtn.classList.add('flex');
            navBackBtn.onclick = function(e) {
                if (e) e.preventDefault();
                <% if (course && course._id) { %>
                window.location.href = '/course-details/<%= course._id %>';
                <% } else { %>
                if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/courses'; }
                <% } %>
            };
        }
    });
</script>
</body>
</html>
