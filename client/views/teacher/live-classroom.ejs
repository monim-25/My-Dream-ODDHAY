                    <span class="material-symbols-rounded text-sm">${isRepliesOpen ? 'unfold_less' : 'unfold_more'}</span> ${isRepliesOpen ? 'Hide replies' : `View ${c.replies.length} ${c.replies.length === 1 ? 'reply' : 'replies'}`}
