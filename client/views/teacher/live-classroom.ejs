<script src="/socket.io/socket.io.js"></script>
<script>
    function filterLivePlaylist() {
        var val = (document.getElementById('livePlaylistSearch').value || '').toLowerCase();
            document.querySelectorAll('#livePlaylistContainer [data-name]').forEach(function(el) {
        var name = el.getAttribute('data-name') || '';
        if (name.toLowerCase().includes(val)) {
            el.parentElement.style.display = '';
        } else {
            el.parentElement.style.display = 'none';
        }
    });
}    function endLiveClass() {
        const isRec = (typeof isRecordingLive !== 'undefined' && isRecordingLive) || (typeof CHANNEL !== 'undefined' && localStorage.getItem('hasRecordedSomething_' + CHANNEL) === 'true');
        const subMsg = document.getElementById('endLiveSubMsg');
        if (subMsg) {
            subMsg.textContent = isRec
                ? 'Recording will be saved automatically as a recorded lesson.'
                : 'No recording was started — no video will be saved.';
        }
        const modal = document.getElementById('endLiveModal');
        if (modal) {
            modal.classList.remove('hidden');
        } else {
            _doEndLiveClass();
        }
    }

    async function _doEndLiveClass() {
        const modal = document.getElementById('endLiveModal');
        if (modal) modal.classList.add('hidden');

        const hasRecorded = (typeof isRecordingLive !== 'undefined' && isRecordingLive) || (typeof CHANNEL !== 'undefined' && localStorage.getItem('hasRecordedSomething_' + CHANNEL) === 'true');

        var st = (typeof startTime !== 'undefined' && startTime) ? startTime : Date.now();
        var elapsed = Math.max(0, Math.floor((Date.now() - st) / 1000));
        var h = Math.floor(elapsed / 3600).toString().padStart(2, '0');
        var m = Math.floor((elapsed % 3600) / 60).toString().padStart(2, '0');
        var s = (elapsed % 60).toString().padStart(2, '0');
        var durationStr = h + ':' + m + ':' + s;

        let recDurationStr = durationStr;
        if (typeof recordingElapsedSeconds !== 'undefined' && recordingElapsedSeconds) {
            const recElapsed = recordingElapsedSeconds;
            const rh = Math.floor(recElapsed / 3600).toString().padStart(2, '0');
            const rm = Math.floor((recElapsed % 3600) / 60).toString().padStart(2, '0');
            const rs = (recElapsed % 60).toString().padStart(2, '0');
            recDurationStr = rh + ':' + rm + ':' + rs;
        }

        let finalVideoPath = '';
        
        // Upload recorded chunks if they exist
        if (hasRecorded && typeof mediaRecorder !== 'undefined' && mediaRecorder) {
            const uploadBtn = document.getElementById('btn-record');
            if (uploadBtn) uploadBtn.innerHTML = '<span class="material-symbols-rounded text-xl animate-spin">sync</span>';
            
            // Stop canvas capture loop and audio context
            if (typeof _recAnimFrame !== 'undefined' && _recAnimFrame) {
                cancelAnimationFrame(_recAnimFrame); _recAnimFrame = null;
            }
            if (typeof _recAudioCtx !== 'undefined' && _recAudioCtx && _recAudioCtx.state !== 'closed') {
                try { _recAudioCtx.close(); } catch(e) {}
            }

            const performUpload = async () => {
                if (typeof recordedChunks === 'undefined' || !recordedChunks || recordedChunks.length === 0) {
                    console.warn('performUpload: recordedChunks is empty');
                    return '';
                }
                const mimeType = (mediaRecorder && mediaRecorder.mimeType) ? mediaRecorder.mimeType : 'video/webm';
                const ext = mimeType.includes('mp4') ? 'mp4' : 'webm';
                const blob = new Blob(recordedChunks, { type: mimeType });
                if (blob.size === 0) {
                    console.warn('performUpload: blob size is 0');
                    return '';
                }
                console.log('performUpload: uploading blob of size', blob.size, 'bytes');
                const formData = new FormData();
                formData.append('video', blob, 'live_recording.' + ext);
                try {
                    const upRes = await fetch('/api/live/upload-recording', { 
                        method: 'POST', 
                        body: formData,
                        credentials: 'same-origin'
                    });
                    const upData = await upRes.json();
                    console.log('performUpload response:', upData);
                    return upData.videoPath || '';
                } catch(err) { 
                    console.error('Upload fetch failed:', err);
                    return ''; 
                }
            };

            try {
                if (mediaRecorder.state !== 'inactive') {
                    finalVideoPath = await new Promise((resolve) => {
                        const timeout = setTimeout(async () => {
                            console.warn('Recorder stop timeout reached, uploading...');
                            resolve(await performUpload());
                        }, 6000);
                        mediaRecorder.onstop = async () => {
                            clearTimeout(timeout);
                            console.log('Recorder onstop triggered, uploading...');
                            resolve(await performUpload());
                        };
                        try {
                            if (typeof mediaRecorder.requestData === 'function' && mediaRecorder.state !== 'inactive') {
                                mediaRecorder.requestData();
                            }
                            mediaRecorder.stop();
                        } catch(e) { 
                            console.warn('Recorder stop exception:', e);
                            resolve(performUpload()); 
                        }
                    });
                } else {
                    finalVideoPath = await performUpload();
                }
            } catch(e) {
                console.warn('Recorder stop error:', e);
            }
        }

        // Clean up storage
        try {
            if (typeof CHANNEL !== 'undefined') {
                localStorage.removeItem('isRecordingLive_' + CHANNEL);
                localStorage.removeItem('recordingStartTime_' + CHANNEL);
                localStorage.removeItem('recordingElapsedSeconds_' + CHANNEL);
                localStorage.removeItem('hasRecordedSomething_' + CHANNEL);
            }
        } catch(e) {}

        let hasExplicitlyEndedClass = false;

        // Make API request to end the class and save
        try {
            hasExplicitlyEndedClass = true;
            const res = await fetch('/api/live/end', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    roomId: (typeof CHANNEL !== 'undefined' ? CHANNEL : '<%= roomId %>'),
                    duration: recDurationStr,
                    isRecorded: Boolean(hasRecorded && finalVideoPath),
                    videoPath: finalVideoPath
                })
            });
            const data = await res.json();
            if (data && data.success) {
                leaveAgoraChannel(data.courseId || '<%= courseId %>', data.folderId, true);
            } else {
                leaveAgoraChannel('<%= courseId %>', null, true);
            }
        } catch (err) {
            console.error('Live end error:', err);
            leaveAgoraChannel('<%= courseId %>', null, true);
        }
    }

    // ── Fullscreen API ──
    function toggleVideoFullscreen() {
        const container = document.getElementById('agora-video-container');
        if (!container) return;
        if (!document.fullscreenElement) {
            container.requestFullscreen && container.requestFullscreen();
        } else {
            document.exitFullscreen && document.exitFullscreen();
        }
    }
    document.addEventListener('fullscreenchange', function() {
        const icon       = document.getElementById('fullscreen-icon');
        const isFs       = !!document.fullscreenElement;
        const controls   = document.getElementById('agora-controls');
        const btnFs      = document.getElementById('btn-fullscreen');
        const container  = document.getElementById('agora-video-container');
        const fsBar      = document.getElementById('fs-viewer-bar');

        // Update icon
        if (icon) icon.textContent = isFs ? 'fullscreen_exit' : 'fullscreen';

        // Body class for CSS hooks
        document.body.classList.toggle('fullscreen-mode', isFs);

        // Show controls & fullscreen button
        if (controls) controls.classList.remove('hidden');
        if (btnFs)    btnFs.classList.remove('hidden');

        // Fullscreen info bar (viewer stats) visibility
        if (fsBar) fsBar.style.display = isFs ? 'flex' : 'none';

        // Sync fs-viewer-bar counts with main counts
        if (isFs) {
            const mainCount    = document.getElementById('liveParticipantsCount');
            const fsCount      = document.getElementById('fs-participants-count');
            const mainComments = document.getElementById('liveCommentsCount');
            const fsComments   = document.getElementById('fs-comments-count');
            if (fsCount    && mainCount)    fsCount.textContent    = mainCount.textContent;
            if (fsComments && mainComments) fsComments.textContent = mainComments.textContent;
        }

        // Auto-hide cursor & overlays after 3 s idle in fullscreen
        let fsIdleTimer;
        if (isFs && container) {
            const showOverlays = () => {
                container.classList.remove('fs-idle-cursor');
                clearTimeout(fsIdleTimer);
                fsIdleTimer = setTimeout(() => container.classList.add('fs-idle-cursor'), 3000);
            };
            container.addEventListener('mousemove', showOverlays);
            container.addEventListener('click', showOverlays);
            showOverlays();
        } else if (container) {
            container.classList.remove('fs-idle-cursor');
        }
    });

    // courseId from server so we can redirect after ending the live class
    var COURSE_ID = '<%= courseId %>';
    const IS_MODERATOR = <%= Boolean(isModerator) %>;

    // Live duration variables
    var startTime = null;
    var liveInterval = null;

    // ==========================================
    // AGORA RTC LOGIC
    // ==========================================
    const APP_ID = '<%= agoraAppId %>';
    const CHANNEL = '<%= roomId %>';
    const client = AgoraRTC.createClient({ mode: 'rtc', codec: 'vp8' });
    
    let localAudioTrack = null;
    let localVideoTrack = null;
    let localScreenTrack = null;
    let isAudioMuted = false;
    let isVideoMuted = false;
    let isScreenSharing = false;
    let isAutoJoining = false;

    let hostAgoraUid = null;
    let remoteVideoTracks = {};
    let agoraUidToName = {};
    let agoraUidToSocketId = {};
    let audioOnlySpeakingContainers = {};

    // Initialize listeners immediately so no remote events are missed
    setupAgoraListeners();

    function updateVideoLayout() {
        const isModerator = <%= isModerator %>;
        
        if (isModerator) {
            // For teacher:
            // 1. If screen sharing, play own camera in the local cam overlay
            if (isScreenSharing && localVideoTrack) {
                const overlay = document.getElementById('local-cam-overlay');
                const miniPlayer = document.getElementById('local-cam-mini-player');
                if (overlay && miniPlayer) {
                    overlay.classList.remove('hidden');
                    
                    const remoteList = document.getElementById('remote-playerlist');
                    const hasRemotes = remoteList && remoteList.children.length > 0;
                    overlay.style.bottom = hasRemotes ? '220px' : '112px';
                    
                    if (!miniPlayer.querySelector('video')) {
                        localVideoTrack.play('local-cam-mini-player');
                    }
                }
            }
        } else {
            // For student:
            // 1. Play own local camera in small overlay on the side (like host does when screen sharing)
            if (localVideoTrack) {
                const overlay = document.getElementById('local-cam-overlay');
                const miniPlayer = document.getElementById('local-cam-mini-player');
                if (overlay && miniPlayer) {
                    overlay.classList.remove('hidden');
                    
                    // Adjust position based on whether remote list has items
                    const remoteList = document.getElementById('remote-playerlist');
                    const hasRemotes = remoteList && remoteList.children.length > 0;
                    overlay.style.bottom = hasRemotes ? '200px' : '96px';
                    
                    if (!miniPlayer.querySelector('video')) {
                        localVideoTrack.play('local-cam-mini-player');
                    }
                }
            }

            // 2. Play host/teacher track in the main-player (large), other tracks in remote-playerlist
            let activeMainUid = null;
            if (hostAgoraUid && remoteVideoTracks[hostAgoraUid]) {
                activeMainUid = hostAgoraUid;
            } else {
                const uids = Object.keys(remoteVideoTracks).map(Number);
                if (uids.length > 0) {
                    activeMainUid = uids[0]; // Auto-promote instructor / first remote streamer to main screen
                }
            }

            const mainPlayer = document.getElementById('main-player');
            if (activeMainUid && remoteVideoTracks[activeMainUid]) {
                if (mainPlayer) {
                    if (mainPlayer.dataset.currentUid !== String(activeMainUid)) {
                        mainPlayer.innerHTML = ''; // clear waiting poster
                        mainPlayer.dataset.currentUid = String(activeMainUid);
                        remoteVideoTracks[activeMainUid].play('main-player');
                    }
                }
                
                // Remove host from small remote list if it was there
                const hostRemoteEl = document.getElementById(`remote-player-${activeMainUid}`);
                if (hostRemoteEl) hostRemoteEl.remove();
            } else {
                // Host is not online or hasn't started video yet. Show animated placeholder
                if (mainPlayer && !mainPlayer.querySelector('.waiting-placeholder')) {
                    mainPlayer.dataset.currentUid = '';
                    mainPlayer.innerHTML = `
                        <div class="waiting-placeholder absolute inset-0 flex flex-col items-center justify-center bg-slate-950 text-slate-400">
                            <span class="material-symbols-rounded text-5xl text-slate-600 animate-pulse mb-4">wifi_tethering</span>
                            <p class="text-base font-semibold text-slate-300 flex items-center gap-1">
                                Wait
                                <span class="wait-dot text-rose-400 text-xl font-black">.</span>
                                <span class="wait-dot text-rose-400 text-xl font-black">.</span>
                                <span class="wait-dot text-rose-400 text-xl font-black">.</span>
                                <span class="wait-dot text-rose-400 text-xl font-black">.</span>
                            </p>
                            <p class="text-[11px] text-slate-500 mt-2 tracking-wider">Waiting for the teacher...</p>
                        </div>
                    `;
                }
            }
        }

        // 3. Play other remote participants in the small tiles grid
        const primaryMainUid = (!isModerator && (hostAgoraUid || Object.keys(remoteVideoTracks).map(Number)[0])) || null;
        Object.keys(remoteVideoTracks).forEach(uidStr => {
            const uid = parseInt(uidStr, 10);
            if (!isModerator && uid === primaryMainUid) return; // skip main screen host if student

            let playerContainer = document.getElementById(`remote-player-${uid}`);
            if (!playerContainer) {
                playerContainer = document.createElement("div");
                playerContainer.id = `remote-player-${uid}`;
                playerContainer.className = "remote-player relative transition-all duration-300";
                document.getElementById("remote-playerlist").appendChild(playerContainer);
                
                // Add user ID label
                const label = document.createElement("div");
                label.className = "absolute bottom-1.5 left-1.5 flex items-center gap-1 bg-black/60 backdrop-blur-sm text-white text-[9px] px-2 py-0.5 rounded-full font-bold z-10 remote-name-label";
                
                // Add a small mic status indicator inside the label
                const speakMic = document.createElement("span");
                speakMic.className = "speaking-indicator-dot size-1.5 rounded-full bg-emerald-400 hidden animate-pulse";
                label.appendChild(speakMic);
                
                // Add text node for displayName
                const displayName = agoraUidToName[uid] || `User ${uid.toString().substring(0,4)}`;
                const textSpan = document.createElement("span");
                textSpan.className = "name-text";
                textSpan.innerText = displayName;
                label.appendChild(textSpan);
                
                playerContainer.appendChild(label);
                
                remoteVideoTracks[uid].play(`remote-player-${uid}`);
            } else {
                // Update name text
                const textSpan = playerContainer.querySelector('.name-text');
                if (textSpan) {
                    const displayName = agoraUidToName[uid] || `User ${uid.toString().substring(0,4)}`;
                    textSpan.innerText = displayName;
                }
            }
        });
    }

    // Join Channel
    async function joinAgoraChannel() {
        if (!APP_ID) {
            alert("Agora App ID is missing! Please configure AGORA_APP_ID in your .env file.");
            return;
        }

        const joinBtn = document.getElementById('join-btn');
        joinBtn.innerHTML = '<span class="material-symbols-rounded animate-spin">autorenew</span> Joining...';
        joinBtn.disabled = true;

        try {
            // 1. Fetch Token from our server
            const response = await fetch(`/api/agora/token?channelName=${CHANNEL}`);
            const data = await response.json();
            const token = data.token || null; // If token is null, assumes testing mode without certificate

            // 2. Join the channel
            const uid = await client.join(APP_ID, CHANNEL, token, null);
            console.log("Joined channel with uid:", uid);
            sessionStorage.setItem("agora_joined_" + CHANNEL, "true");
            client.enableAudioVolumeIndicator();

            // Broadcast Agora UID via Socket.io
            if (typeof socket !== 'undefined') {
                socket.emit('user:set_agora_uid', { room: '<%= roomId %>', agoraUid: uid });
            }

            const isModerator = <%= isModerator %>;

            // 3. Setup tracks based on role
            if (isModerator) {
                try {
                    localAudioTrack = await AgoraRTC.createMicrophoneAudioTrack();
                } catch (audioErr) {
                    console.warn("Could not create microphone track:", audioErr);
                }

                try {
                    localVideoTrack = await AgoraRTC.createCameraVideoTrack({
                        encoderConfig: { width: 1280, height: 720, frameRate: 30 }
                    });
                } catch (videoErr) {
                    console.warn("Could not create camera track:", videoErr);
                }

                const tracksToPublish = [];
                if (localAudioTrack) tracksToPublish.push(localAudioTrack);
                if (localVideoTrack) tracksToPublish.push(localVideoTrack);
                if (tracksToPublish.length > 0) {
                    await client.publish(tracksToPublish);
                }

                if (localVideoTrack) {
                    localVideoTrack.play('main-player');
                }
            } else {
                // Students join as viewers immediately without mandatory camera/mic activation
                updateVideoLayout();
            }

            // 6. Setup UI
            document.getElementById('prejoin-screen').classList.add('hidden');
            document.getElementById('agora-controls').classList.remove('hidden');
            document.getElementById('btn-reaction-toggle').classList.remove('hidden');
            const btnFs = document.getElementById('btn-fullscreen');
            if (btnFs) btnFs.classList.remove('hidden');

            const btnAudio = document.getElementById('btn-audio');
            const btnVideo = document.getElementById('btn-video');
            if (!isModerator) {
                isAudioMuted = true;
                isVideoMuted = true;
                if (btnAudio) {
                    btnAudio.classList.add('active');
                    btnAudio.innerHTML = '<span class="material-symbols-rounded text-xl">mic_off</span>';
                }
                if (btnVideo) {
                    btnVideo.classList.add('active');
                    btnVideo.innerHTML = '<span class="material-symbols-rounded text-xl">videocam_off</span>';
                }
            } else {
                isAudioMuted = false;
                isVideoMuted = false;
                if (btnAudio) {
                    btnAudio.classList.remove('active');
                    btnAudio.innerHTML = '<span class="material-symbols-rounded text-xl">mic</span>';
                }
                if (btnVideo) {
                    btnVideo.classList.remove('active');
                    btnVideo.innerHTML = '<span class="material-symbols-rounded text-xl">videocam</span>';
                }
            }

            // 6b. Post pre-join textarea as a highlighted comment (moderator only)
            var descInput = document.getElementById('liveDescriptionInput');
            if (descInput && !isAutoJoining) {
                var commentText = descInput.value.trim();
                if (commentText && typeof socket !== 'undefined') {
                    socket.emit('message:send', { room: '<%= roomId %>', text: commentText, highlighted: true });
                }
            }

            // 7. Start Live Duration Timer
            if (!startTime) {
                var storedStart = localStorage.getItem("live_start_time_" + CHANNEL);
                if (storedStart) {
                    startTime = parseInt(storedStart, 10);
                } else {
                    startTime = Date.now();
                    localStorage.setItem("live_start_time_" + CHANNEL, startTime);
                }
                liveInterval = setInterval(function() {
                    var elapsed = Math.floor((Date.now() - startTime) / 1000);
                    var h = Math.floor(elapsed / 3600).toString().padStart(2, '0');
                    var m = Math.floor((elapsed % 3600) / 60).toString().padStart(2, '0');
                    var s = (elapsed % 60).toString().padStart(2, '0');
                    var timeStr = h + ':' + m + ':' + s;
                    var el = document.getElementById('liveDuration');
                    if (el) el.textContent = timeStr;
                    var el2 = document.getElementById('liveDurationOverlay');
                    if (el2) el2.textContent = timeStr;
                }, 1000);
            }

            // 8. Subscribe to any remote users already active in channel
            if (client.remoteUsers && client.remoteUsers.length > 0) {
                for (const rUser of client.remoteUsers) {
                    try {
                        if (rUser.hasVideo) {
                            await client.subscribe(rUser, "video");
                            remoteVideoTracks[rUser.uid] = rUser.videoTrack;
                        }
                        if (rUser.hasAudio) {
                            await client.subscribe(rUser, "audio");
                            rUser.audioTrack.play();
                        }
                    } catch (e) {
                        console.warn("Initial subscribe error:", e);
                    }
                }
                updateVideoLayout();
            }

        } catch (error) {
            console.error("Agora join failed:", error);
            alert("Failed to join class. " + (error.message || "Please check your network connection and try again."));
            if (joinBtn) {
                joinBtn.innerHTML = 'Try Again';
                joinBtn.disabled = false;
            }
        }
    }

    // Handle Remote Users
    function setupAgoraListeners() {
        client.on("user-published", async (user, mediaType) => {
            try {
                await client.subscribe(user, mediaType);
                console.log("Subscribed to remote user:", user.uid, mediaType);

                if (mediaType === "video") {
                    remoteVideoTracks[user.uid] = user.videoTrack;
                    updateVideoLayout();
                }

                if (mediaType === "audio") {
                    user.audioTrack.play();
                }
            } catch (err) {
                console.warn("Failed to subscribe to remote user:", err);
            }
        });

        client.on("user-unpublished", (user, mediaType) => {
            if (mediaType === "video") {
                delete remoteVideoTracks[user.uid];
                
                const playerContainer = document.getElementById(`remote-player-${user.uid}`);
                if (playerContainer) playerContainer.remove();
                
                const mainPlayer = document.getElementById('main-player');
                if (mainPlayer && mainPlayer.dataset.currentUid === String(user.uid)) {
                    mainPlayer.dataset.currentUid = '';
                    mainPlayer.innerHTML = '';
                }

                updateVideoLayout();
            }
        });

        client.on("user-left", (user) => {
            delete remoteVideoTracks[user.uid];
            
            const playerContainer = document.getElementById(`remote-player-${user.uid}`);
            if (playerContainer) playerContainer.remove();
            
            const mainPlayer = document.getElementById('main-player');
            if (mainPlayer && mainPlayer.dataset.currentUid === String(user.uid)) {
                mainPlayer.dataset.currentUid = '';
                mainPlayer.innerHTML = '';
            }

            // Remove temporary audio indicator if they leave
            const audioCard = document.getElementById(`audio-speaker-${user.uid}`);
            if (audioCard) {
                if (audioCard.silenceTimeout) clearTimeout(audioCard.silenceTimeout);
                if (audioCard.parentNode) audioCard.parentNode.removeChild(audioCard);
                delete audioOnlySpeakingContainers[user.uid];
            }

            updateVideoLayout();
        });

        // 9. Volume Detector for active speaker indicators
        client.on("volume-indicator", volumes => {
            const speakersThisTick = new Set();
            volumes.forEach(volume => {
                const uid = volume.uid;
                const level = volume.level;
                // Threshold: level > 5 means they are speaking
                if (level > 5) {
                    speakersThisTick.add(uid);
                }
            });

            // Find all known UIDs in our mapped participants list
            const allKnownUids = Object.keys(agoraUidToName).map(Number);
            allKnownUids.forEach(uid => {
                const isSelf = uid === client.uid;
                if (isSelf) return;

                const isSpeaking = speakersThisTick.has(uid);
                
                // 1. Video user: Highlight their video tile (if it exists)
                const videoTile = document.getElementById(`remote-player-${uid}`);
                if (videoTile) {
                    const indicatorDot = videoTile.querySelector('.speaking-indicator-dot');
                    if (isSpeaking) {
                        videoTile.classList.add('ring-2', 'ring-emerald-400', 'shadow-[0_0_12px_rgba(52,211,153,0.5)]');
                        if (indicatorDot) indicatorDot.classList.remove('hidden');
                    } else {
                        videoTile.classList.remove('ring-2', 'ring-emerald-400', 'shadow-[0_0_12px_rgba(52,211,153,0.5)]');
                        if (indicatorDot) indicatorDot.classList.add('hidden');
                    }
                } else {
                    // 2. Audio-only user: Display/remove dynamic speaker card in grid
                    if (isSpeaking) {
                        let audioCard = document.getElementById(`audio-speaker-${uid}`);
                        if (!audioCard) {
                            audioCard = document.createElement("div");
                            audioCard.id = `audio-speaker-${uid}`;
                            audioCard.className = "remote-player flex flex-col items-center justify-center bg-slate-900 border-2 border-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.5)] text-white gap-2 transition-all duration-300 relative";
                            
                            // Inner layout: Pulsing avatar and speaking text
                            audioCard.innerHTML = `
                                <div class="size-10 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 border border-emerald-400/30 animate-pulse">
                                    <span class="material-symbols-rounded text-xl">mic</span>
                                </div>
                                <span class="text-[10px] font-bold text-emerald-300 animate-pulse">Speaking...</span>
                                <div class="absolute bottom-1.5 left-1.5 flex items-center gap-1 bg-black/60 backdrop-blur-sm text-white text-[9px] px-2 py-0.5 rounded-full font-bold">
                                    <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                    <span>${agoraUidToName[uid] || `User ${uid.toString().substring(0,4)}`}</span>
                                </div>
                            `;
                            
                            const listEl = document.getElementById("remote-playerlist");
                            if (listEl) listEl.appendChild(audioCard);
                            audioOnlySpeakingContainers[uid] = audioCard;
                        }
                        
                        // Reset silence timeout
                        if (audioCard.silenceTimeout) {
                            clearTimeout(audioCard.silenceTimeout);
                            audioCard.silenceTimeout = null;
                        }
                        audioCard.classList.remove('opacity-0', 'scale-90');
                    } else {
                        const audioCard = document.getElementById(`audio-speaker-${uid}`);
                        if (audioCard && !audioCard.silenceTimeout) {
                            audioCard.silenceTimeout = setTimeout(() => {
                                audioCard.classList.add('opacity-0', 'scale-90');
                                setTimeout(() => {
                                    if (audioCard.parentNode) audioCard.parentNode.removeChild(audioCard);
                                    delete audioOnlySpeakingContainers[uid];
                                }, 300);
                            }, 2000); // 2s threshold of silence
                        }
                    }
                }

                // 3. Highlight in participants list
                const socketId = agoraUidToSocketId[uid];
                if (socketId) {
                    const participantRow = document.querySelector(`.participant-row[data-socket-id="${socketId}"]`);
                    if (participantRow) {
                        const micIcon = participantRow.querySelector('.speaking-mic-icon');
                        if (micIcon) {
                            if (isSpeaking) {
                                micIcon.classList.remove('hidden');
                            } else {
                                micIcon.classList.add('hidden');
                            }
                        }
                    }
                }
            });
        });
    }

    // Controls
    async function toggleAudio() {
        const btn = document.getElementById('btn-audio');
        
        try {
            if (!localAudioTrack) {
                // Create local audio track on-demand
                if (btn) btn.innerHTML = '<span class="material-symbols-rounded text-xl animate-spin">sync</span>';
                localAudioTrack = await AgoraRTC.createMicrophoneAudioTrack();
                await client.publish([localAudioTrack]);
                isAudioMuted = false;
            } else {
                isAudioMuted = !isAudioMuted;
                await localAudioTrack.setMuted(isAudioMuted);
            }

            if (btn) {
                btn.classList.toggle('active', isAudioMuted);
                btn.innerHTML = `<span class="material-symbols-rounded text-xl">${isAudioMuted ? 'mic_off' : 'mic'}</span>`;
            }
            
            if (typeof socket !== 'undefined') {
                socket.emit('student:mic_status', { room: '<%= roomId %>', isMuted: isAudioMuted });
            }
        } catch (err) {
            console.error("Error toggling audio track:", err);
            alert("Could not access microphone: " + (err.message || "Permission denied"));
            isAudioMuted = true;
            if (btn) {
                btn.classList.add('active');
                btn.innerHTML = '<span class="material-symbols-rounded text-xl">mic_off</span>';
            }
        }
    }

    async function toggleVideo() {
        const btn = document.getElementById('btn-video');
        const isModerator = <%= isModerator %>;
        
        try {
            if (!localVideoTrack) {
                // Create local video track on-demand
                if (btn) btn.innerHTML = '<span class="material-symbols-rounded text-xl animate-spin">sync</span>';
                localVideoTrack = await AgoraRTC.createCameraVideoTrack({
                    encoderConfig: { width: 640, height: 480, frameRate: 24 }
                });
                await client.publish([localVideoTrack]);
                isVideoMuted = false;
            } else {
                isVideoMuted = !isVideoMuted;
                await localVideoTrack.setMuted(isVideoMuted);
            }

            if (btn) {
                btn.classList.toggle('active', isVideoMuted);
                btn.innerHTML = `<span class="material-symbols-rounded text-xl">${isVideoMuted ? 'videocam_off' : 'videocam'}</span>`;
            }

            // Dynamically hide/show local camera overlay
            const overlay = document.getElementById('local-cam-overlay');
            if (overlay) {
                if (isVideoMuted) {
                    overlay.classList.add('hidden');
                } else {
                    if (!isModerator || isScreenSharing) {
                        overlay.classList.remove('hidden');
                        if (typeof updateVideoLayout === 'function') updateVideoLayout();
                    }
                }
            } else if (isModerator && !isScreenSharing && localVideoTrack) {
                localVideoTrack.play('main-player');
            }
        } catch (err) {
            console.error("Error toggling video track:", err);
            alert("Could not access camera: " + (err.message || "Permission denied"));
            isVideoMuted = true;
            if (btn) {
                btn.classList.add('active');
                btn.innerHTML = '<span class="material-symbols-rounded text-xl">videocam_off</span>';
            }
        }
    }

    async function toggleScreenShare() {
        if (isScreenSharing) {
            // ── STOP screen sharing ──
            try {
                await client.unpublish(localScreenTrack);
                localScreenTrack.close();
                localScreenTrack = null;

                // Republish camera to Agora so remote users see host again
                await client.publish(localVideoTrack);
                // Move camera back to main player
                localVideoTrack.play('main-player');
            } catch(e) { console.warn('Screen share stop error:', e); }

            // Hide the camera overlay
            const overlay = document.getElementById('local-cam-overlay');
            const miniPlayer = document.getElementById('local-cam-mini-player');
            if (overlay) overlay.classList.add('hidden');
            if (miniPlayer) miniPlayer.innerHTML = '';

            isScreenSharing = false;
            const btn = document.getElementById('btn-screen');
            if (btn) {
                btn.classList.remove('active');
                btn.title = 'Share Screen';
            }
        } else {
            // ── START screen sharing ──
            try {
                // Create screen track (high quality)
                localScreenTrack = await AgoraRTC.createScreenVideoTrack({
                    encoderConfig: { width: 1920, height: 1080, frameRate: 15, bitrateMax: 2000 }
                }, 'disable');

                // Unpublish camera from Agora, publish screen instead
                await client.unpublish(localVideoTrack);
                await client.publish(localScreenTrack);

                // Screen → main player (large)
                localScreenTrack.play('main-player');

                // Camera → small overlay (still plays locally)
                const overlay = document.getElementById('local-cam-overlay');
                const miniPlayer = document.getElementById('local-cam-mini-player');
                if (overlay) overlay.classList.remove('hidden');
                if (localVideoTrack && miniPlayer) {
                    // Adjust overlay position: if remote-playerlist has items, move cam overlay higher
                    const remoteList = document.getElementById('remote-playerlist');
                    const hasRemotes = remoteList && remoteList.children.length > 0;
                    overlay.style.bottom = hasRemotes ? '220px' : '112px';
                    localVideoTrack.play('local-cam-mini-player');
                }

                isScreenSharing = true;
                const btn = document.getElementById('btn-screen');
                if (btn) {
                    btn.classList.add('active');
                    btn.title = 'Stop Sharing';
                }

                // If the user stops sharing via browser UI (X button), revert
                localScreenTrack.on('track-ended', () => {
                    toggleScreenShare();
                });

            } catch (err) {
                console.error('Screen sharing failed:', err);
                if (err.message && !err.message.includes('cancel')) {
                    alert('Screen sharing failed: ' + err.message);
                }
            }
        }
    }

    async function leaveAgoraChannel(redirectCourseId, folderId, isAlreadyEnded = false) {
        const isMod = typeof IS_MODERATOR !== 'undefined' ? Boolean(IS_MODERATOR) : <%= Boolean(isModerator) %>;
        if (isMod && !isAlreadyEnded) {
            try {
                fetch('/api/live/end', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId: CHANNEL }),
                    keepalive: true
                }).catch(e => {});
            } catch(e) {}
        }
        try {
            sessionStorage.removeItem("agora_joined_" + CHANNEL);
            localStorage.removeItem("live_start_time_" + CHANNEL);
            if (localAudioTrack) { localAudioTrack.close(); localAudioTrack = null; }
            if (localVideoTrack) { localVideoTrack.close(); localVideoTrack = null; }
            if (localScreenTrack) { localScreenTrack.close(); localScreenTrack = null; }
            if (typeof client !== 'undefined' && client && client.connectionState !== 'DISCONNECTED') {
                await client.leave();
            }
        } catch(e) {
            console.warn('Agora leave error (non-fatal):', e);
        }
        if (typeof liveInterval !== 'undefined' && liveInterval) {
            clearInterval(liveInterval);
        }

        // Redirect back appropriately based on role
        var cid = redirectCourseId || (typeof COURSE_ID !== 'undefined' ? COURSE_ID : '');
        var referrer = document.referrer;
        var hash = folderId ? '#folder-' + folderId : '';

        if (isMod) {
            if (referrer && referrer.includes(window.location.host) && !referrer.includes('/live/')) {
                var url = new URL(referrer);
                url.hash = hash;
                window.location.href = url.toString();
            } else if (cid) {
                window.location.href = '/teacher/course/' + cid + hash;
            } else {
                window.location.href = '/dashboard';
            }
        } else {
            // Student leaving live class
            if (referrer && referrer.includes(window.location.host) && !referrer.includes('/live/')) {
                window.location.href = referrer;
            } else if (cid) {
                window.location.href = '/courses/' + cid;
            } else {
                window.location.href = '/dashboard';
            }
        }
    }

    window.addEventListener('beforeunload', function() {
        const isMod = typeof IS_MODERATOR !== 'undefined' ? Boolean(IS_MODERATOR) : <%= Boolean(isModerator) %>;
        if (isMod) {
            try {
                navigator.sendBeacon('/api/live/end', new Blob([JSON.stringify({ roomId: CHANNEL })], { type: 'application/json' }));
            } catch(e) {}
        }
    });


    // ==========================================
    // COMMENT SYSTEM (same as video player)
    // ==========================================
    const currentUserId = '<%= user._id %>';
    const currentUserRole = '<%= user.role %>';
    const openCommentReplies = new Set();
    let liveComments = []; // local store of all received comments

    function escapeHTML(str) {
        if (!str) return '';
        return String(str).replace(/[&<>'"]/g,
            tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
        );
    }

    function timeAgo(date) {
        const seconds = Math.floor((new Date() - new Date(date)) / 1000);
        let interval = Math.floor(seconds / 31536000);
        if (interval >= 1) return interval === 1 ? '1 year ago' : interval + ' years ago';
        interval = Math.floor(seconds / 2592000);
        if (interval >= 1) return interval === 1 ? '1 month ago' : interval + ' months ago';
        interval = Math.floor(seconds / 86400);
        if (interval >= 1) return interval === 1 ? '1 day ago' : interval + ' days ago';
        interval = Math.floor(seconds / 3600);
        if (interval >= 1) return interval === 1 ? '1 hour ago' : interval + ' hours ago';
        interval = Math.floor(seconds / 60);
        if (interval >= 1) return interval === 1 ? '1 minute ago' : interval + ' minutes ago';
        return seconds < 10 ? 'just now' : seconds + ' seconds ago';
    }

    function renderExpandableText(text, id) {
        const escaped = escapeHTML(text);
        if (text.length <= 220) {
            return `<p class="text-sm text-slate-600 dark:text-slate-400 mt-1 leading-relaxed whitespace-pre-wrap">${escaped}</p>`;
        }
        const shortText = escapeHTML(text.substring(0, 220));
        return `
            <div id="text-container-${id}" class="mt-1">
                <p id="text-short-${id}" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${shortText}... <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read more</button></p>
                <p id="text-full-${id}" class="hidden text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${escaped} <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read less</button></p>
            </div>
        `;
    }

    function toggleCommentTextExpand(id) {
        const shortEl = document.getElementById(`text-short-${id}`);
        const fullEl = document.getElementById(`text-full-${id}`);
        if (shortEl && fullEl) {
            if (shortEl.classList.contains('hidden')) {
                shortEl.classList.remove('hidden'); fullEl.classList.add('hidden');
            } else {
                shortEl.classList.add('hidden'); fullEl.classList.remove('hidden');
            }
        }
    }

    function renderCommentCard(c) {
