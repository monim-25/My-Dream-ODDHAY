                            <span class="text-sm font-bold text-slate-800 dark:text-slate-200 truncate">${userName}</span>
                            ${badgeText ? `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-none shrink-0 ${badgeClass}">${badgeText}</span>` : ''}
                            ${c.highlighted ? `<span class="text-[9px] font-bold bg-yellow-400 dark:bg-yellow-500 text-slate-900 px-1.5 py-0.5 rounded-none shrink-0 flex items-center gap-0.5"><span class="material-symbols-rounded text-[11px] font-bold">push_pin</span>Highlighted</span>` : ''}
                            <span class="text-[11px] text-slate-400 shrink-0">${dateDisplay}</span>
                        </div>
                        <div class="relative shrink-0">
                            <button type="button" onclick="toggleCommentDropdown(event,'${c._id}')" class="p-1 hover:bg-slate-100 dark:hover:bg-white/5 text-black dark:text-white rounded-none transition-all flex items-center justify-center" title="Options">
                                <span class="material-symbols-rounded text-sm leading-none" style="font-weight:800">more_vert</span>
                            </button>
                            <div id="dropdown-${c._id}" class="hidden absolute right-0 mt-1 w-32 bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-lg rounded-none py-0.5 z-30">
                                <button type="button" onclick="toggleCommentHighlight('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 flex items-center gap-1.5"><span class="material-symbols-rounded text-[14px]">${c.highlighted ? 'explore_off' : 'push_pin'}</span> ${c.highlighted ? 'Unhighlight' : 'Highlight'}</button>
                                ${isAuthor ? `
                                    <button type="button" onclick="triggerEditComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 flex items-center gap-1.5"><span class="material-symbols-rounded text-[14px]">edit</span> Edit</button>
                                    <button type="button" onclick="triggerDeleteComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/20 flex items-center gap-1.5"><span class="material-symbols-rounded text-[14px]">delete</span> Delete</button>
                                ` : `
                                    <button type="button" onclick="triggerReportComment('${c._id}')" class="w-full text-left px-2.5 py-1.5 text-[11px] font-bold text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/20 flex items-center gap-1.5"><span class="material-symbols-rounded text-[14px]">flag</span> Report</button>
                                `}
                            </div>
                        </div>
                    </div>
                    ${renderExpandableText(c.text, c._id)}
                    <div class="flex items-center gap-3 mt-1">
                        <button type="button" onclick="toggleReplyForm('${c._id}','${userName}')" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-1"><span class="material-symbols-rounded text-[13px]">reply</span> Reply</button>
                    </div>
                    <div id="reply-form-${c._id}" class="hidden mt-2 pl-4 w-full max-w-[350px]">
                        <form onsubmit="submitReply(event,'${c._id}','${c._id}')" class="flex gap-2 items-start w-full">
                            <textarea required rows="1" oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px';" placeholder="Write a reply..." class="flex-1 text-xs p-2 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed w-full min-h-[36px]"></textarea>
                            <div class="flex gap-1 shrink-0">
                                <button type="button" onclick="toggleReplyForm('${c._id}','',true)" class="px-2 py-1 text-[9px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 text-slate-500 rounded-none">Cancel</button>
                                <button type="submit" class="px-2.5 py-1 bg-primary hover:bg-primary/95 text-white text-[9px] font-bold uppercase tracking-wider rounded-none">Reply</button>
                            </div>
                        </form>
                    </div>
                    <div id="edit-comment-form-${c._id}" class="hidden mt-2 w-full max-w-[350px]">
                        <form onsubmit="submitEditComment(event,'${c._id}')" class="flex gap-2 items-start w-full">
                            <textarea required rows="1" oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px';" class="flex-1 text-xs p-2 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed w-full min-h-[36px]">${escapeHTML(c.text)}</textarea>
                            <div class="flex gap-1 shrink-0">
                                <button type="button" onclick="toggleEditCommentForm('${c._id}',true)" class="px-2 py-1 text-[9px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 text-slate-500 rounded-none">Cancel</button>
                                <button type="submit" class="px-2.5 py-1 bg-primary hover:bg-primary/95 text-white text-[9px] font-bold uppercase tracking-wider rounded-none">Save</button>
                            </div>
                        </form>
                    </div>
                    ${repliesBlock}
                </div>
            </div>
        `;
    }

    function renderCommentsList(comments) {
        const list = document.getElementById('commentsList');
        if (!list) return;
        if (comments.length === 0) {
            list.innerHTML = `
                <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                    <p class="text-xs font-medium text-slate-500">No comments yet</p>
                    <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                </div>`;
            return;
        }
        // Sort: highlighted comments always at the top (newest highlighted first),
        // then all regular comments newest-first
        const highlighted = comments
            .filter(c => c.highlighted)
            .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        const regular = comments
            .filter(c => !c.highlighted)
            .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        // Performance cap: render at most 150 regular comments in DOM
        const cappedRegular = regular.slice(0, 150);
        const sorted = [...highlighted, ...cappedRegular];
        // Preserve scroll position if user has scrolled down
        const prevScrollTop = list.scrollTop;
        const wasAtTop = prevScrollTop < 40;
        list.innerHTML = sorted.map(c => renderCommentCard(c)).join('');
        // If was at top (new comment arrived), keep at top; otherwise restore position
        if (wasAtTop) list.scrollTop = 0;
        else list.scrollTop = prevScrollTop;
        const badge = document.getElementById('commentsCountBadge');
        if (badge) badge.innerText = comments.length;
        const countEl = document.getElementById('liveCommentsCount');
        if (countEl) countEl.innerText = comments.length;
        // Sync fullscreen bar
        const fsComments = document.getElementById('fs-comments-count');
        if (fsComments) fsComments.textContent = comments.length;
    }

    function toggleRepliesList(commentId) {
        const block = document.getElementById(`replies-block-${commentId}`);
        const btn = document.getElementById(`toggle-replies-btn-${commentId}`);
        if (block && btn) {
            if (block.classList.contains('hidden')) {
                block.classList.remove('hidden');
                openCommentReplies.add(commentId);
                btn.innerHTML = `<span class="material-symbols-rounded text-sm">unfold_less</span> Hide replies`;
            } else {
                block.classList.add('hidden');
                openCommentReplies.delete(commentId);
                const count = block.children.length;
                btn.innerHTML = `<span class="material-symbols-rounded text-sm">unfold_more</span> View ${count} ${count === 1 ? 'reply' : 'replies'}`;
            }
        }
    }

    function toggleReplyForm(formId, replyToUser = '', forceHide = false) {
        const formDiv = document.getElementById(`reply-form-${formId}`);
        if (!formDiv) return;
        if (forceHide) {
            formDiv.classList.add('hidden');
            const ta = formDiv.querySelector('textarea');
            if (ta) ta.value = '';
        } else {
            const isHidden = formDiv.classList.contains('hidden');
            if (isHidden) {
                document.querySelectorAll('[id^="reply-form-"]').forEach(el => {
                    if (el.id !== `reply-form-${formId}`) { el.classList.add('hidden'); const ta = el.querySelector('textarea'); if (ta) ta.value = ''; }
                });
                formDiv.classList.remove('hidden');
                const ta = formDiv.querySelector('textarea');
                if (ta) { ta.value = replyToUser ? `@${replyToUser} ` : ''; ta.focus(); }
            } else {
                formDiv.classList.add('hidden');
                const ta = formDiv.querySelector('textarea');
                if (ta) ta.value = '';
            }
        }
    }

    async function submitReply(e, commentId, formId) {
        e.preventDefault();
        const formDiv = document.getElementById(`reply-form-${formId}`);
        const textarea = formDiv ? formDiv.querySelector('textarea') : null;
        if (!textarea) return;
        const text = textarea.value.trim();
        if (!text) return;
        const btn = e.target.querySelector('button[type="submit"]');
        const orig = btn.innerText; btn.disabled = true; btn.innerText = '...';
        try {
            const res = await fetch(`/api/live-comment/${commentId}/reply`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            const data = await res.json();
            if (data.success) {
                textarea.value = '';
                openCommentReplies.add(commentId);
                toggleReplyForm(formId, '', true);
                // refresh comment from local store
                const idx = liveComments.findIndex(c => c._id == commentId);
                if (idx > -1 && data.comment) { liveComments[idx] = data.comment; renderCommentsList(liveComments); }
            } else alert('Error: ' + (data.error || 'Server error'));
        } catch (err) { alert('Failed to post reply'); }
        finally { btn.disabled = false; btn.innerText = orig; }
    }

    function toggleEditCommentForm(commentId, forceHide = false) {
        const formDiv = document.getElementById(`edit-comment-form-${commentId}`);
        if (!formDiv) return;
        if (forceHide) { formDiv.classList.add('hidden'); }
        else {
            const isHidden = formDiv.classList.contains('hidden');
            if (isHidden) { formDiv.classList.remove('hidden'); const ta = formDiv.querySelector('textarea'); if (ta) ta.focus(); }
            else { formDiv.classList.add('hidden'); }
        }
    }

    function toggleEditReplyForm(commentId, replyId, forceHide = false) {
        const formDiv = document.getElementById(`edit-reply-form-${replyId}`);
        if (!formDiv) return;
        if (forceHide) { formDiv.classList.add('hidden'); }
        else {
            const isHidden = formDiv.classList.contains('hidden');
            if (isHidden) { formDiv.classList.remove('hidden'); const ta = formDiv.querySelector('textarea'); if (ta) ta.focus(); }
            else { formDiv.classList.add('hidden'); }
        }
    }

    async function submitEditComment(e, commentId) {
        e.preventDefault();
        const ta = e.target.querySelector('textarea');
        const text = ta.value.trim(); if (!text) return;
        const btn = e.target.querySelector('button[type="submit"]');
        const orig = btn.innerText; btn.disabled = true; btn.innerText = '...';
        try {
            const res = await fetch(`/api/live-comment/${commentId}`, {
                method: 'PUT', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            const data = await res.json();
            if (data.success) {
                toggleEditCommentForm(commentId, true);
                const idx = liveComments.findIndex(c => c._id == commentId);
                if (idx > -1) { liveComments[idx].text = text; renderCommentsList(liveComments); }
            } else alert('Error: ' + (data.error || 'Server error'));
        } catch (err) { alert('Failed to edit comment'); }
        finally { btn.disabled = false; btn.innerText = orig; }
    }

    async function submitEditReply(e, commentId, replyId) {
        e.preventDefault();
        const ta = e.target.querySelector('textarea');
        const text = ta.value.trim(); if (!text) return;
        const btn = e.target.querySelector('button[type="submit"]');
        const orig = btn.innerText; btn.disabled = true; btn.innerText = '...';
        try {
            const res = await fetch(`/api/live-comment/${commentId}/reply/${replyId}`, {
                method: 'PUT', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            const data = await res.json();
            if (data.success) {
                toggleEditReplyForm(commentId, replyId, true);
                if (data.comment) {
                    const idx = liveComments.findIndex(c => c._id == commentId);
                    if (idx > -1) { liveComments[idx] = data.comment; renderCommentsList(liveComments); }
                }
            } else alert('Error: ' + (data.error || 'Server error'));
        } catch (err) { alert('Failed to edit reply'); }
        finally { btn.disabled = false; btn.innerText = orig; }
    }

    async function toggleCommentHighlight(commentId) {
        try {
            const res = await fetch(`/api/live-comment/${commentId}/toggle-highlight`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                const idx = liveComments.findIndex(c => c._id == commentId);
                if (idx > -1) { liveComments[idx].highlighted = !liveComments[idx].highlighted; renderCommentsList(liveComments); }
            } else alert(data.error || 'Failed to update');
        } catch (err) { alert('Failed to update highlight'); }
    }

    function toggleCommentDropdown(e, id) {
        e.stopPropagation();
        const dropdown = document.getElementById(`dropdown-${id}`);
        if (dropdown) {
            const isHidden = dropdown.classList.contains('hidden');
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
            if (isHidden) dropdown.classList.remove('hidden');
        }
    }

    document.addEventListener('click', () => {
        document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
    });

    function triggerEditComment(id) { toggleEditCommentForm(id); }
    function triggerEditReply(commentId, replyId) { toggleEditReplyForm(commentId, replyId); }
    function triggerReportComment(id) { alert('Comment has been reported to the site administrator. Thank you.'); }

    function triggerDeleteComment(commentId) {
        const modalText = document.getElementById('deleteModalText');
        if (modalText) modalText.innerText = 'Are you sure you want to delete this comment? This action is permanent and cannot be undone.';
        const confirmBtn = document.getElementById('confirmDeleteBtn');
        if (confirmBtn) {
            confirmBtn.onclick = async () => {
                const orig = confirmBtn.innerText; confirmBtn.disabled = true; confirmBtn.innerText = 'Deleting...';
                try {
                    const res = await fetch(`/api/live-comment/${commentId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        closeDeleteModal();
                        liveComments = liveComments.filter(c => c._id != commentId);
                        renderCommentsList(liveComments);
                    } else alert('Error: ' + (data.error || 'Server error'));
                } catch (err) { alert('Failed to delete comment'); }
                finally { confirmBtn.disabled = false; confirmBtn.innerText = orig; }
            };
        }
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function triggerDeleteReply(commentId, replyId) {
        const modalText = document.getElementById('deleteModalText');
        if (modalText) modalText.innerText = 'Are you sure you want to delete this reply? This action is permanent and cannot be undone.';
        const confirmBtn = document.getElementById('confirmDeleteBtn');
        if (confirmBtn) {
            confirmBtn.onclick = async () => {
                const orig = confirmBtn.innerText; confirmBtn.disabled = true; confirmBtn.innerText = 'Deleting...';
                try {
                    const res = await fetch(`/api/live-comment/${commentId}/reply/${replyId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        closeDeleteModal();
                        if (data.comment) {
                            const idx = liveComments.findIndex(c => c._id == commentId);
                            if (idx > -1) { liveComments[idx] = data.comment; renderCommentsList(liveComments); }
                        }
                    } else alert('Error: ' + (data.error || 'Server error'));
                } catch (err) { alert('Failed to delete reply'); }
                finally { confirmBtn.disabled = false; confirmBtn.innerText = orig; }
            };
        }
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
    }

