    // ── Load existing comments from server on page load (survives refresh) ──
    (async function loadInitialComments() {
        try {
            const res = await fetch('/api/live-comment?room=<%= roomId %>');
            const data = await res.json();
            if (data.success && data.messages && data.messages.length > 0) {
                liveComments = data.messages.map(function(m) {
                    return {
                        _id: m._id,
                        sender: m.sender,
                        senderName: m.senderName,
                        senderRole: m.senderRole,
                        userName: m.senderName,
                        userAvatar: m.userAvatar || null,
                        text: m.text,
                        createdAt: m.createdAt || new Date().toISOString(),
                        highlighted: !!m.highlighted,
                        replies: m.replies || []
                    };
                });
                renderCommentsList(liveComments);
            }
        } catch (err) {
            console.warn('Could not load existing comments:', err);
        }
    })();

    socket.on('message:new', function(msg) {
        // Normalize msg into comment-card shape
        const comment = {
            _id: msg._id,
            sender: msg.sender,
            senderName: msg.senderName,
            senderRole: msg.senderRole,
            userName: msg.senderName,
            userAvatar: msg.userAvatar || null,
            text: msg.text,
            createdAt: msg.createdAt || new Date().toISOString(),
            highlighted: !!msg.highlighted,
            replies: []
        };
        liveComments.unshift(comment);
        // Memory cap: prevent unbounded growth; keep 500 most recent
        if (liveComments.length > 500) {
            liveComments = liveComments.slice(0, 500);
        }
        renderCommentsList(liveComments);
        // Scroll to top so the newest/highlighted comment is visible
        const list = document.getElementById('commentsList');
        if (list) list.scrollTop = 0;
    });

