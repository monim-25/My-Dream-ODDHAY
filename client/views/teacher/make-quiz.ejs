                            class="p-3.5 sm:p-5 bg-white dark:bg-[#0f172a] border-t border-slate-200/90 dark:border-slate-800/90 lg:sticky lg:bottom-0 lg:bg-white/95 lg:dark:bg-[#0f172a]/95 lg:backdrop-blur-md z-20">
