        window.onQuizSubTopicChipChange = function (cb) {
            const chip = cb ? cb.closest('.subtopic-select-chip') : null;
            if (chip) {
                if (cb.checked) chip.classList.add('bg-indigo-50', 'dark:bg-indigo-950/40', 'border-indigo-500', 'dark:border-indigo-400');
                else chip.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/40', 'border-indigo-500', 'dark:border-indigo-400');
            }
            syncQuizSubTopicSelection();
        };

        window.syncQuizSubTopicSelection = function () {
            const primarySub = document.getElementById('quizPrimarySubTopicInput');
            const badge = document.getElementById('quizSubTopicCountBadge');
            const checked = Array.from(document.querySelectorAll('#quizSubTopicsList input[name="subTopics[]"]:checked'));
            if (badge) {
                if (checked.length > 0) {
                    badge.textContent = checked.length + ' selected';
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
