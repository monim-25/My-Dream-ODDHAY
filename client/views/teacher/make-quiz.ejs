        function renderQuizSubTopicsForSelectedTopics() {
            const section = document.getElementById('quizSubTopicsSection');
            const list = document.getElementById('quizSubTopicsList');
            if (!section || !list) return;

            const checkedTopicBoxes = Array.from(document.querySelectorAll('#quizTopicsList input[name="topics[]"]:checked'));
            if (checkedTopicBoxes.length === 0) {
                section.classList.add('hidden');
                list.innerHTML = '';
                syncQuizSubTopicSelection();
                return;
            }

            const selectedTopicNames = checkedTopicBoxes.map(b => b.value.trim().toLowerCase());
            const allSubTopics = [];
            const seenSubs = new Set();

            (window._quizCachedTopics || []).forEach(t => {
                const tName = (t.name || '').trim().toLowerCase();
                if (selectedTopicNames.includes(tName) && Array.isArray(t.subTopics)) {
                    t.subTopics.forEach(sub => {
                        const subStr = String(sub || '').trim();
                        if (subStr && !seenSubs.has(subStr.toLowerCase())) {
                            seenSubs.add(subStr.toLowerCase());
                            allSubTopics.push({ name: subStr, topic: t.name });
                        }
                    });
                }
            });

            if (allSubTopics.length === 0) {
                section.classList.add('hidden');
                list.innerHTML = '';
                syncQuizSubTopicSelection();
                return;
            }

            const currentlyChecked = new Set(
                Array.from(list.querySelectorAll('input[name="subTopics[]"]:checked')).map(cb => cb.value.trim().toLowerCase())
            );

            list.innerHTML = '';
            allSubTopics.forEach(item => {
                const isChecked = currentlyChecked.has(item.name.toLowerCase());
                const chip = document.createElement('label');
                chip.className = 'subtopic-select-chip flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-xs select-none transition-all cursor-pointer ' +
                    (isChecked ? 'bg-indigo-50 dark:bg-indigo-950/40 border-indigo-500 dark:border-indigo-400' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-indigo-400');
                chip.innerHTML = '<input type="checkbox" name="subTopics[]" value="' + escapeHtml(item.name) + '" class="accent-indigo-600 rounded size-3.5 cursor-pointer"' + (isChecked ? ' checked' : '') + ' onchange="onQuizSubTopicChipChange(this)">' +
                    '<span class="font-medium text-slate-700 dark:text-slate-200 text-xs leading-tight">' + escapeHtml(item.name) + '</span>';
                list.appendChild(chip);
            });

            section.classList.remove('hidden');
            syncQuizSubTopicSelection();
        }

        // ─── Cross-class sync check ───────────────────────────────────────────────
        async function checkAndRenderCrossClassSync(subject, topicNames, chapterName, checkedClasses) {
            const portal = document.getElementById('crossClassSyncPortal');
            const container = document.getElementById('crossClassListContainer');
            if (!portal || !container) return;
            const topicsParam = Array.isArray(topicNames) ? topicNames.join(',') : String(topicNames || '');
            if (!subject || !topicsParam) { portal.classList.add('hidden'); container.innerHTML = ''; return; }
            try {
                const q = new URLSearchParams({ subject, topic: topicsParam, chapter: chapterName || '', currentClasses: checkedClasses.join(',') }).toString();
                let res = await fetch('/api/topics/cross-class-check?' + q, { headers: { 'Accept': 'application/json' } }).catch(() => null);
                if (!res || !res.ok) res = await fetch('/teacher/api/topics/cross-class-check?' + q, { headers: { 'Accept': 'application/json' } }).catch(() => null);
                if (!res || !res.ok) { portal.classList.add('hidden'); return; }
                const data = await res.json();
                if (data && data.success && data.hasCrossClass && Array.isArray(data.details) && data.details.length > 0) {
                    container.innerHTML = '';
                    data.details.forEach(item => {
                        const label = document.createElement('label');
                        label.className = 'flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-emerald-300 dark:border-emerald-700 text-xs font-semibold text-slate-800 dark:text-slate-100 cursor-pointer shadow-xs hover:border-emerald-500 transition-colors select-none';
                        label.innerHTML = '<input type="checkbox" name="syncClasses[]" value="' + escapeHtml(item.classLevel) + '" checked class="accent-emerald-600 rounded size-3.5 cursor-pointer">' +
                            '<span class="font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1"><span class="material-symbols-rounded text-sm">school</span>' + escapeHtml(item.classLevel) + '</span>' +
                            '<span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal truncate max-w-[140px]">(' + escapeHtml(item.chapterName || '') + ')</span>';
                        container.appendChild(label);
                    });
                    portal.classList.remove('hidden');
                } else {
                    portal.classList.add('hidden');
                    container.innerHTML = '';
                }
            } catch (e) {
                console.warn('Cross-class check failed:', e);
                portal.classList.add('hidden');
            }
        }

        // ─── Bank metadata ────────────────────────────────────────────────────────
        async function syncBankMetadata() {
            const classLevel = document.getElementById('classLevel').value;
            const categorySelect = document.getElementById('examCategory');
            const category = categorySelect ? categorySelect.value : (document.getElementById('isModelTest')?.value === 'true' ? 'model' : 'course');
            const isCourseLinked = (category === 'course');
            let subject = '';
            if (!isCourseLinked) {
                const qs = document.getElementById('quizSubject');
                subject = qs ? qs.value : '';
            } else {
                const cs = document.getElementById('courseId');
                const so = cs && cs.selectedIndex >= 0 ? cs.options[cs.selectedIndex] : null;
                subject = so ? (so.getAttribute('data-subject') || '') : '';
            }
            const board = document.getElementById('bankBoard') ? document.getElementById('bankBoard').value : '';
            const year = document.getElementById('bankYear') ? document.getElementById('bankYear').value : '';
            const fallbackBoards = <%- JSON.stringify(typeof boards !== 'undefined' && boards ? boards.map(b => typeof b === 'object' ? b.name : b) : []) %>;
            const fallbackYears = <%- JSON.stringify(typeof years !== 'undefined' && years ? years.map(y => typeof y === 'object' ? y.year : y) : []) %>;

            if (!classLevel || !subject) {
                updateDropdown('bankBoard', fallbackBoards, board, 'Any Board');
                updateDropdown('bankYear', fallbackYears, year, 'Any Year');
                return;
            }
            try {
                const chaps = Array.from(selectedTeacherChapters).join(',');
                const url = `/teacher/api/bank-metadata?classLevel=${encodeURIComponent(classLevel)}&subject=${encodeURIComponent(subject)}&chapters=${encodeURIComponent(chaps)}&board=${encodeURIComponent(board)}&year=${encodeURIComponent(year)}`;
                const data = await (await fetch(url)).json();
                if (data.success) {
                    const bList = (data.boards && data.boards.length > 0) ? data.boards : fallbackBoards;
                    const yList = (data.years && data.years.length > 0) ? data.years : fallbackYears;
                    updateDropdown('bankBoard', bList, board, 'Any Board');
                    updateDropdown('bankYear', yList, year, 'Any Year');
                }
            } catch (err) { console.error('Failed to sync metadata', err); }
            analyzeBankQuestions();
        }

        function updateDropdown(id, items, currentVal, placeholder) {
            const select = document.getElementById(id);
            if (!select) return;
            const list = Array.isArray(items) && items.length > 0 ? items : (id === 'bankBoard' ? fallbackBoards : fallbackYears);
            let html = `<option value="">${placeholder}</option>`;
            list.forEach(item => { const val = typeof item === 'object' ? (item.name || item.year) : item; html += `<option value="${val}" ${val === currentVal ? 'selected' : ''}>${val}</option>`; });
            select.innerHTML = html;
        }

        // ─── Main view toggle ─────────────────────────────────────────────────────
        function updateView(preserveCourse = false) {
            const categorySelect = document.getElementById('examCategory');
            const category = categorySelect ? categorySelect.value : (document.getElementById('isModelTest')?.value === 'true' ? 'model' : 'course');
            const isModelOrMock = (category === 'model' || category === 'mock');
            const isMock = (category === 'mock');

            const isModelTestInput = document.getElementById('isModelTest');
            const isMockTestInput = document.getElementById('isMockTest');
            if (isModelTestInput) isModelTestInput.value = isModelOrMock ? 'true' : 'false';
            if (isMockTestInput) isMockTestInput.value = isMock ? 'true' : 'false';

            const selectedClass = document.getElementById('classLevel').value;
            const courseContainer = document.getElementById('courseContainer');
            const subjectContainer = document.getElementById('subjectContainer');
            const subjectLabel = document.getElementById('subjectLabel');
            const courseSelect = document.getElementById('courseId');
            const subjSelect = document.getElementById('quizSubject');

            if (isModelOrMock) {
                // Standalone Model Test or Mock Test Mode:
                if (courseSelect) {
                    courseSelect.disabled = true;
                    courseSelect.value = '';
                }
                courseContainer.classList.add('hidden');
                subjectContainer.classList.remove('hidden');
                subjectContainer.className = 'col-span-2 md:col-span-2';
                if (subjectLabel) subjectLabel.textContent = isMock ? 'Mock Test Subject' : 'Subject';

                // Filter subjects for selected class
                if (selectedClass) {
                    filterSubjectsByClass(selectedClass);
                } else {
                    subjSelect.innerHTML = '<option value="">-- Select Class First --</option>';
                    onQuizSubjectOrClassChange();
                }
            } else {
                // Course-Linked Mode:
                if (courseSelect) {
                    courseSelect.disabled = false;
                }
                courseContainer.classList.remove('hidden');
                courseContainer.className = 'col-span-1';
                subjectContainer.classList.remove('hidden');
                subjectContainer.className = 'col-span-1';
                if (subjectLabel) subjectLabel.textContent = 'Course Subject';

                const currentCourseId = preserveCourse ? preSelectedCourseId : courseSelect.value;
                courseSelect.innerHTML = '<option value="">-- Select Course --</option>';
                const filtered = selectedClass
                    ? allCourses.filter(opt => {
                        const cc = opt.getAttribute('data-class') || '';
                        return cc.includes(selectedClass) || cc.includes('Class ' + selectedClass);
                    })
                    : allCourses;
                filtered.forEach(opt => courseSelect.appendChild(opt.cloneNode(true)));
                if (currentCourseId) {
                    const targetOpt = courseSelect.querySelector(`option[value="${currentCourseId}"]`);
                    if (targetOpt) targetOpt.selected = true;
                }

                // Sync the course's subjects into the subject dropdown
                onCourseSelectChange();
            }

            syncBankMetadata();
        }

        let _bankCounts = null;
        let _bankAnalysisTimer = null;
        let _slotCapNoticeTimer = null;

        function isSmartGeneration() {
            const rad = document.querySelector('input[name="strategy"]:checked');
            return rad ? rad.value === 'automated' : false;
        }

        function showSlotCapAlert(type, max) {
            const alertBox = document.getElementById('slotCapAlert');
            const alertText = document.getElementById('slotCapAlertText');
            if (!alertBox || !alertText) return;
            alertText.textContent = max === 0
                ? `No ${type} questions exist in Question Bank for the selected items.`
                : `Maximum ${max} ${type} question(s) available in Question Bank for this selection.`;
            alertBox.classList.remove('hidden');
            if (_slotCapNoticeTimer) clearTimeout(_slotCapNoticeTimer);
            _slotCapNoticeTimer = setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 4000);
        }

        function onSlotInputChange(input, type) {
            if (isSmartGeneration() && _bankCounts) {
                const max = _bankCounts[type] !== undefined ? _bankCounts[type] : 0;
                let val = parseInt(input.value);
                if (isNaN(val)) {
                    // allow clear
                } else if (val > max) {
                    input.value = max > 0 ? max : '';
                    showSlotCapAlert(type, max);
                } else if (val < 0) {
                    input.value = 0;
                }
            }
            updateTotalQuizSlots();
            validateQuestionConfig();
        }

        function analyzeBankQuestions() {
            if (_bankAnalysisTimer) clearTimeout(_bankAnalysisTimer);
            _bankAnalysisTimer = setTimeout(runBankAnalysis, 250);
        }

        async function runBankAnalysis() {
            if (!isSmartGeneration()) {
                document.getElementById('bankAnalysisNotice')?.classList.add('hidden');
                ['mcq', 'short', 'medium', 'comp'].forEach(k => {
                    document.getElementById(k + 'BankAvail')?.classList.add('hidden');
                });
                ['mcqCount', 'shortCount', 'mediumCount', 'comprehensionCount'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.removeAttribute('max');
                });
                return;
            }

            const notice = document.getElementById('bankAnalysisNotice');
            const spin = document.getElementById('bankAnalysisSpin');
            const icon = document.getElementById('bankAnalysisIcon');
            const text = document.getElementById('bankAnalysisText');
            const badge = document.getElementById('bankTotalAvailBadge');

            if (notice) notice.classList.remove('hidden');
            if (spin) spin.classList.remove('hidden');
            if (icon) icon.classList.add('hidden');
            if (text) text.textContent = 'Analyzing question bank for selected syllabus items...';

            const classLevel = document.getElementById('classLevel')?.value || '';
            const categorySelect = document.getElementById('examCategory');
            const category = categorySelect ? categorySelect.value : (document.getElementById('isModelTest')?.value === 'true' ? 'model' : 'course');
            const isCourseLinked = (category === 'course');
            let subject = '';
            let courseId = '';
            if (!isCourseLinked) {
                subject = document.getElementById('quizSubject')?.value || '';
            } else {
                const cs = document.getElementById('courseId');
                courseId = cs ? cs.value : '';
                const so = cs && cs.selectedIndex >= 0 ? cs.options[cs.selectedIndex] : null;
                subject = so ? (so.getAttribute('data-subject') || '') : '';
            }

            const chaps = Array.from(selectedTeacherChapters);
            const topicCheckboxes = Array.from(document.querySelectorAll('#quizTopicsList input[name="topics[]"]:checked'));
            const topics = topicCheckboxes.map(cb => cb.value.trim()).filter(Boolean);
            const subTopicCheckboxes = Array.from(document.querySelectorAll('#quizSubTopicsList input[name="subTopics[]"]:checked'));
            const subTopics = subTopicCheckboxes.map(cb => cb.value.trim()).filter(Boolean);
            const board = document.getElementById('bankBoard')?.value || '';
            const year = document.getElementById('bankYear')?.value || '';

            try {
                const res = await fetch('/teacher/api/bank-question-counts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        classLevel,
                        subject,
                        courseId,
                        chapters: chaps,
                        topics,
                        subTopics,
                        board,
                        year
                    })
                });
                const data = await res.json();
                if (data.success && data.counts) {
                    _bankCounts = data.counts;

                    const mapping = [
                        { key: 'MCQ', countId: 'mcqCount', availId: 'mcqBankAvail', spanId: 'mcqAvailCount' },
                        { key: 'Short', countId: 'shortCount', availId: 'shortBankAvail', spanId: 'shortAvailCount' },
                        { key: 'Medium', countId: 'mediumCount', availId: 'mediumBankAvail', spanId: 'mediumAvailCount' },
                        { key: 'Comprehension', countId: 'comprehensionCount', availId: 'compBankAvail', spanId: 'compAvailCount' }
                    ];

                    mapping.forEach(m => {
                        const avail = data.counts[m.key] || 0;
                        const input = document.getElementById(m.countId);
                        const availBox = document.getElementById(m.availId);
                        const countSpan = document.getElementById(m.spanId);

                        if (input) {
                            input.max = avail;
                            if (parseInt(input.value) > avail) {
                                input.value = avail > 0 ? avail : '';
                            }
                        }
                        if (countSpan) countSpan.textContent = avail;
                        if (availBox) {
                            availBox.classList.remove('hidden');
                            if (avail === 0) {
                                availBox.innerHTML = '<span class="text-rose-500 font-semibold">0 available</span>';
                            } else {
                                availBox.innerHTML = `Available: <strong class="font-bold text-emerald-600 dark:text-emerald-400">${avail}</strong>`;
                            }
                        }
                    });

                    if (badge) badge.textContent = `Total: ${data.counts.total} available`;
                    if (data.counts.total === 0) {
                        if (text) text.textContent = 'No questions found in Question Bank for this selection. Try selecting other chapters/topics.';
                        if (notice) notice.className = 'mb-3.5 p-3 rounded-xl border border-rose-200 dark:border-rose-900/40 bg-rose-50 dark:bg-rose-950/20 text-xs flex items-center justify-between gap-2.5 transition-all text-rose-700 dark:text-rose-300';
                    } else {
                        if (text) text.textContent = `Question Bank analyzed: ${data.counts.total} question(s) found matching selected items.`;
                        if (notice) notice.className = 'mb-3.5 p-3 rounded-xl border border-emerald-200 dark:border-emerald-800/40 bg-emerald-50 dark:bg-emerald-950/20 text-xs flex items-center justify-between gap-2.5 transition-all text-emerald-800 dark:text-emerald-200';
                    }
                    updateTotalQuizSlots();
                    validateQuestionConfig();
                }
            } catch (err) {
                console.warn('Bank analysis error:', err);
                if (text) text.textContent = 'Unable to check bank question availability.';
            } finally {
                if (spin) spin.classList.add('hidden');
                if (icon) icon.classList.remove('hidden');
            }
        }

        function switchAssessmentStudioMode(mode) {
            const isBulk = mode === 'bulk';
            const modeInput = document.getElementById('quizModeInput');
            if (modeInput) modeInput.value = isBulk ? 'bulk' : 'standard';

            const stdBtn = document.getElementById('mode-standard-btn');
            const bulkBtn = document.getElementById('mode-bulk-btn');
            const strategySec = document.getElementById('strategySection');
            const distSec = document.getElementById('distributionSection');
            const badge = document.getElementById('bulkModeBadge');
            const submitText = document.getElementById('quizSubmitText');
            const submitIcon = document.getElementById('quizSubmitIcon');

            if (isBulk) {
                if (stdBtn) stdBtn.className = 'h-8 px-3.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer';
                if (bulkBtn) bulkBtn.className = 'h-8 px-3.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-700 text-amber-600 dark:text-amber-400 shadow-2xs transition-all cursor-pointer';
                if (strategySec) strategySec.classList.add('hidden');
                if (distSec) distSec.classList.add('hidden');
                if (badge) badge.classList.remove('hidden');
                if (submitText) submitText.textContent = 'Next';
                if (submitIcon) submitIcon.textContent = 'arrow_forward';
                validateQuestionConfig();
            } else {
                if (stdBtn) stdBtn.className = 'h-8 px-3.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-700 text-primary shadow-2xs transition-all cursor-pointer';
                if (bulkBtn) bulkBtn.className = 'h-8 px-3.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer';
                if (strategySec) strategySec.classList.remove('hidden');
                if (distSec) distSec.classList.remove('hidden');
                if (badge) badge.classList.add('hidden');
                if (submitText) submitText.textContent = 'Add Questions';
                if (submitIcon) submitIcon.textContent = 'add_task';
                toggleStrategy('manual');
                validateQuestionConfig();
            }
        }
        window.switchAssessmentStudioMode = switchAssessmentStudioMode;

        let _quizBulkQuestions = [];
        let _quizBulkTimer = null;

        function parseBulkQuestionsText(rawText) {
            if (!rawText || !rawText.trim()) return [];

            const lines = rawText.split(/\r?\n/);

            const qStartRegex = /^\s*(?:[\d০-৯]+[\.\)]|\([\d০-৯]+\)|Q(?:uestion)?\s*[\d০-৯]+[:\.\)]|প্রশ্ন\s*[\d০-৯]+[:\.\)])/i;
            const stimulusHeaderRegex = /^\s*(?:\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]|(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–]|(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে)/i;

            const bnToEn = s => String(s).replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d));

            function extractRangeFromInstruction(text) {
                const m = text.match(/([\d০-৯]+)\s*(?:[ও\-,–]|এবং|হতে|থেকে|to)\s*([\d০-৯]+)\s*নং/i);
                if (m) {
                    const start = parseInt(bnToEn(m[1]));
                    const end = parseInt(bnToEn(m[2]));
                    return { start, end };
                }
                return null;
            }

            // Step 1: Chunk into question blocks with associated preambles (stimuli)
            const blocks = [];
            let currentBlock = [];
            let pendingPreambleLines = [];
            let inPreamble = false;

            lines.forEach(line => {
                const trimmed = line.trim();
                if (!trimmed) return;

                if (stimulusHeaderRegex.test(trimmed)) {
                    if (currentBlock.length > 0) {
                        blocks.push({
                            text: currentBlock.join('\n'),
                            preamble: pendingPreambleLines.join('\n')
                        });
                        currentBlock = [];
                        pendingPreambleLines = [];
                    }
                    inPreamble = true;
                    pendingPreambleLines.push(line);
                    return;
                }

                if (inPreamble) {
                    if (qStartRegex.test(trimmed)) {
                        inPreamble = false;
                        currentBlock.push(line);
                    } else {
                        pendingPreambleLines.push(line);
                    }
                    return;
                }

                if (qStartRegex.test(trimmed)) {
                    if (currentBlock.length > 0) {
                        blocks.push({
                            text: currentBlock.join('\n'),
                            preamble: pendingPreambleLines.join('\n')
                        });
                        currentBlock = [];
                        pendingPreambleLines = [];
                    }
                    currentBlock.push(line);
                    return;
                }

                if (currentBlock.length > 0) {
                    currentBlock.push(line);
                } else {
                    pendingPreambleLines.push(line);
                }
            });

            if (currentBlock.length > 0) {
                blocks.push({
                    text: currentBlock.join('\n'),
                    preamble: pendingPreambleLines.join('\n')
                });
            }

            if (blocks.length === 0 && pendingPreambleLines.length > 0) {
                blocks.push({ text: pendingPreambleLines.join('\n'), preamble: '' });
            }

            // Step 2: Parse each block into a structured question object
            const parsed = [];
            let activeSharedContext = null;

            blocks.forEach((blockObj, idx) => {
                const block = blockObj.text;
                const preamble = blockObj.preamble || '';
                const bLines = block.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
                if (bLines.length === 0) return;

                if (preamble && (stimulusHeaderRegex.test(preamble) || /উদ্দীপক|অনুচ্ছেদ|Stem|Context/i.test(preamble))) {
                    let pInst = 'উদ্দীপকটি পড়ে নিচের প্রশ্নগুলোর উত্তর দিন';
                    const instMatch = preamble.match(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/im);
                    if (instMatch) {
                        pInst = instMatch[0].replace(/[\:\-\–]+$/, '').trim();
                    }
                    let cleanCtx = preamble
                        .replace(/\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]/gi, '')
                        .replace(/^(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–]/gim, '')
                        .replace(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/gim, '')
                        .trim();

                    const range = extractRangeFromInstruction(pInst);
                    activeSharedContext = {
                        contextId: 'ctx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                        context: cleanCtx || preamble.trim(),
                        contextInstruction: pInst,
                        range: range,
                        remainingCount: range ? (range.end - range.start + 1) : 2
                    };
                }

                let qText = '';
                let options = [];
                let correctIndex = -1;
                let explanation = '';
                let isBangla = /[\u0980-\u09FF]/.test(block + ' ' + preamble);

                let qNum = null;
                const qNumMatch = bLines[0].match(/^\s*(?:([\d০-৯]+)[\.\)]|\(([\d০-৯]+)\)|Q(?:uestion)?\s*([\d০-৯]+)|প্রশ্ন\s*([\d০-৯]+))/i);
                if (qNumMatch) {
                    const rawNum = qNumMatch[1] || qNumMatch[2] || qNumMatch[3] || qNumMatch[4];
                    qNum = parseInt(bnToEn(rawNum));
                }

                let firstLine = bLines[0]
                    .replace(/^\s*(?:[\d০-৯]+[\.\)]|\([\d০-৯]+\)|Q(?:uestion)?\s*[\d০-৯]*[:\.\)\-]?|প্রশ্ন\s*[\d০-৯]*[:\.\)\-]?)\s*/i, '')
                    .trim();
                qText = firstLine;

                let inOptions = false;
                let inExplanation = false;

                for (let i = 1; i < bLines.length; i++) {
                    const line = bLines[i];

                    // Answer Detection
                    const ansMatch = line.match(/^(?:উত্তরঃ|উত্তর|উঃ|উ:|Ans(?:wer)?|Correct(?:\s*Answer)?|Key|সঠিক(?:\s*উত্তর)?)\s*[:\-\–\.\ঃ]?\s*(.+)$/i);
                    if (ansMatch) {
                        const ansRaw = ansMatch[1].trim();
                        const cleanAns = ansRaw.replace(/[\(\)\[\]\.\,\:\ঃ]/g, '').trim().toLowerCase();
                        if (['ক', 'a', '১', '1', 'i'].includes(cleanAns)) correctIndex = 0;
                        else if (['খ', 'b', '২', '2', 'ii'].includes(cleanAns)) correctIndex = 1;
                        else if (['গ', 'c', '৩', '3', 'iii'].includes(cleanAns)) correctIndex = 2;
                        else if (['ঘ', 'd', '৪', '4', 'iv'].includes(cleanAns)) correctIndex = 3;
                        else {
                            const optIdx = options.findIndex(opt => opt && opt.toLowerCase() === ansRaw.toLowerCase());
                            if (optIdx !== -1) correctIndex = optIdx;
                        }
                        continue;
                    }

                    // Explanation Detection
                    const expMatch = line.match(/^(?:ব্যাখ্যা|ব্যাখ্যাঃ|Explanation|Exp|Note)\s*[:\-\–\.]?\s*(.*)$/i);
                    if (expMatch) {
                        explanation = expMatch[1].trim();
                        inExplanation = true;
                        continue;
                    }

                    if (inExplanation) {
                        explanation += ' ' + line;
                        continue;
                    }

                    // Multi options on single line
                    const multiParts = line.split(/(?=(?:^|[\s\t]+)(?:\(?([ক-ঘa-dA-D1-4])[\)\.\:]\s*))/).filter(Boolean);
                    let hasMulti = false;
                    let tempOpts = [];
                    for (let part of multiParts) {
                        const pMatch = part.trim().match(/^[\(\[]?([ক-ঘa-dA-D1-4])[\)\.\:\]]\s*(.+)$/);
                        if (pMatch) {
                            tempOpts.push(pMatch[2].trim());
                            hasMulti = true;
                        }
                    }
                    if (hasMulti && tempOpts.length >= 2) {
                        options.push(...tempOpts);
                        inOptions = true;
                        continue;
                    }

                    // Single option on line
                    const singleOptMatch = line.match(/^[\(\[]?([ক-ঘa-dA-D1-4])[\)\.\:\]]\s*(.+)$/);
                    if (singleOptMatch) {
                        options.push(singleOptMatch[2].trim());
                        inOptions = true;
                        continue;
                    }

                    if (!inOptions && !inExplanation) {
                        qText += '\n' + line;
                    }
                }

                while (options.length < 4) {
                    options.push('');
                }

                let mcqSubtype = 'standard';
                let statements = [];
                let context = '';
                let contextInstruction = 'উদ্দীপকটি পড়ে নিচের প্রশ্নগুলোর উত্তর দিন';
                let contextId = '';

                // 1. Detect Roman numeral statements
                const stmtMatches = [];
                const nonStmtLines = [];
                const romanSplitRegex = /(?=(?:^|[\s\t]+)(?:(?:i{1,3}|I{1,3}|[ⅰ-ⅲ])[\.\)]|\((?:i{1,3}|I{1,3}|[ⅰ-ⅲ])\))\s*)/i;
                qText.split('\n').forEach(ql => {
                    const parts = ql.split(romanSplitRegex).map(p => p.trim()).filter(Boolean);
                    let lineHadStmt = false;
                    parts.forEach(p => {
                        const m = p.match(/^(?:(?:i{1,3}|I{1,3}|[ⅰ-ⅲ])[\.\)]|\((?:i{1,3}|I{1,3}|[ⅰ-ⅲ])\))\s*(.+)$/i);
                        if (m) {
                            stmtMatches.push(m[1].trim());
                            lineHadStmt = true;
                        }
                    });
                    if (!lineHadStmt) {
                        nonStmtLines.push(ql);
                    }
                });

                if (stmtMatches.length >= 2) {
                    mcqSubtype = 'multiple_completion';
                    statements = stmtMatches;
                    const cleanedNonStmtLines = nonStmtLines.filter(l => !/^(?:(?:উপরের\s+তথ্য(?:সমূহের|র)?\s+আলোকে\s+)?নিচের\s+কোনটি\s+সঠিক(?:\?|ঃ|:)?|কোনটি\s+সঠিক(?:\?|ঃ|:)?|Which\s+(?:of\s+the\s+following\s+is\s+)?correct\??)$/i.test(l.trim()));
                    qText = cleanedNonStmtLines.join('\n').trim();
                    if (!qText) {
                        qText = nonStmtLines.join('\n').trim();
                    }
                }

                // 2. Stimulus/Context Detection
                const ctxMatch = block.match(/(?:\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]|^(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–])\s*([\s\S]*?)(?=(?:[\d০-৯]+[\.\)]|Q\d|প্রশ্ন|\(?ক[\)\.]))/im);
                if (ctxMatch) {
                    context = ctxMatch[1].trim();
                    mcqSubtype = 'contextual';
                    const instMatch = block.match(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/im);
                    if (instMatch) {
                        contextInstruction = instMatch[0].replace(/[\:\-\–]+$/, '').trim();
                    }
                    contextId = 'ctx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                } else if (activeSharedContext) {
                    let applies = false;
                    if (activeSharedContext.range && qNum !== null) {
                        applies = (qNum >= activeSharedContext.range.start && qNum <= activeSharedContext.range.end);
                    } else if (activeSharedContext.remainingCount > 0) {
                        applies = true;
                        activeSharedContext.remainingCount--;
                    }

                    if (applies) {
                        mcqSubtype = 'contextual';
                        context = activeSharedContext.context;
                        contextInstruction = activeSharedContext.contextInstruction;
                        contextId = activeSharedContext.contextId;
                    } else {
                        activeSharedContext = null;
                    }
                }

                const isValid = (qText.trim().length > 0 && options.filter(o => o.trim().length > 0).length >= 3 && correctIndex >= 0);

                parsed.push({
                    qText: qText.trim(),
                    mcqSubtype,
                    statements,
                    context,
                    contextInstruction,
                    contextId,
                    options: options.slice(0, 4),
                    correctIndex,
                    explanation: explanation.trim(),
                    isBangla,
                    isValid
                });
            });

            return parsed;
        }

        function onQuizBulkInputChanged() {
            clearTimeout(_quizBulkTimer);
            _quizBulkTimer = setTimeout(() => {
                const rawInput = document.getElementById('quizBulkRawInput');
                const rawText = rawInput ? rawInput.value : '';
                _quizBulkQuestions = parseBulkQuestionsText(rawText);
                renderQuizBulkPreviewCards();
                updateQuizBulkStats();
            }, 250);
        }
        window.onQuizBulkInputChanged = onQuizBulkInputChanged;

        function updateQuizBulkStats() {
            const total = _quizBulkQuestions.length;
            const valid = _quizBulkQuestions.filter(q => q.isValid).length;

            const totalEl = document.getElementById('quizBulkTotalText');
            const validEl = document.getElementById('quizBulkValidText');
            const subtextEl = document.getElementById('quizBulkPreviewSubtext');

            if (totalEl) totalEl.innerText = `${total} টি প্রশ্ন শনাক্ত`;
            if (validEl) validEl.innerText = `${valid} টি প্রস্তুত`;
            if (subtextEl) subtextEl.innerText = total > 0 ? `${total}টি প্রশ্নের লাইভ ভিউ` : '০টি প্রশ্ন';

            const payloadInput = document.getElementById('bulkQuestionsPayload');
            if (payloadInput) payloadInput.value = JSON.stringify(_quizBulkQuestions);
        }

        function renderQuizBulkPreviewCards() {
            const container = document.getElementById('quizBulkPreviewContainer');
            if (!container) return;

            if (_quizBulkQuestions.length === 0) {
                container.innerHTML = `
                    <div class="h-full min-h-[300px] flex flex-col items-center justify-center p-6 text-center">
                        <div class="size-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 mb-2">
                            <span class="material-symbols-rounded text-2xl">bolt</span>
                        </div>
                        <h4 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">কোনো প্রশ্ন পেস্ট করা হয়নি</h4>
                        <p class="text-[11px] text-slate-400 max-w-xs mt-1 leading-relaxed">
                            ওয়ার্ড বা নোটপ্যাড থেকে প্রশ্নপত্র কপি করে বামপাশের বক্সে পেস্ট করুন, অথবা ডেমো বাটন চাপুন।
                        </p>
                    </div>
                `;
                return;
            }

            const bnLetters = ['ক', 'খ', 'গ', 'ঘ'];
            const enLetters = ['A', 'B', 'C', 'D'];

            let html = '';
            _quizBulkQuestions.forEach((q, qIdx) => {
                const optLetters = q.isBangla ? bnLetters : enLetters;
                const cardBorder = q.isValid ? 'border-slate-200/90 dark:border-slate-800' : 'border-amber-400/80 dark:border-amber-500/50 bg-amber-50/10';

                html += `
                    <div class="bg-white dark:bg-[#0f172a] rounded-xl p-3 border ${cardBorder} shadow-2xs space-y-2.5 transition-all">
                        <div class="flex items-center justify-between gap-2 pb-1.5 border-b border-slate-100 dark:border-slate-800/80">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200">
                                    #${qIdx + 1}
                                </span>
                                <span class="text-[11px] font-medium text-slate-400">MCQ</span>
                                ${q.mcqSubtype === 'multiple_completion' ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary/10 text-primary border border-primary/20">
                                        <span class="material-symbols-rounded text-[11px]">format_list_numbered</span>
                                        <span>বহুপদী</span>
                                    </span>
                                ` : (q.mcqSubtype === 'contextual' ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                                        <span class="material-symbols-rounded text-[11px]">auto_stories</span>
                                        <span>উদ্দীপকভিত্তিক</span>
                                    </span>
                                ` : '')}
                                ${q.isValid ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30">
                                        <span class="material-symbols-rounded text-[12px]">check_circle</span>
                                        <span>রেডি</span>
                                    </span>
                                ` : `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/30">
                                        <span class="material-symbols-rounded text-[12px]">priority_high</span>
                                        <span>${q.correctIndex < 0 ? 'উত্তর নির্বাচন করুন' : 'অপশন অসম্পূর্ণ'}</span>
                                    </span>
                                `}
                            </div>
                            <button type="button" onclick="deleteQuizBulkQuestion(${qIdx})" title="মুছে ফেলুন" class="size-6 rounded-md text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 flex items-center justify-center transition-all cursor-pointer">
                                <span class="material-symbols-rounded text-[16px]">delete</span>
                            </button>
                        </div>

                        ${q.context ? `
                            <div class="p-2 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-900 dark:text-amber-200 space-y-1">
                                <div class="flex items-center justify-between text-[10.5px] font-semibold text-amber-700 dark:text-amber-400">
                                    <span class="flex items-center gap-1"><span class="material-symbols-rounded text-xs">auto_stories</span> উদ্দীপক</span>
                                    <span class="truncate max-w-[180px]">${q.contextInstruction || ''}</span>
                                </div>
                                <p class="text-xs leading-relaxed whitespace-pre-wrap">${q.context}</p>
                            </div>
                        ` : ''}

                        <div>
                            <textarea rows="2" placeholder="প্রশ্ন..." oninput="updateQuizBulkQText(${qIdx}, this.value)"
                                class="w-full p-2 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all leading-relaxed resize-none">${q.qText || ''}</textarea>
                        </div>

                        ${q.statements && q.statements.length > 0 ? `
                            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 space-y-1 text-xs">
                                ${q.statements.map((st, sI) => `
                                    <div class="flex items-center gap-1.5 text-slate-700 dark:text-slate-300">
                                        <span class="px-1.5 py-0.2 rounded bg-primary/10 text-primary font-bold text-[10px]">${['i.', 'ii.', 'iii.', 'iv.'][sI] || (sI + 1) + '.'}</span>
                                        <span class="truncate">${st}</span>
                                    </div>
                                `).join('')}
                                <p class="text-[10px] font-semibold text-slate-400 pt-0.5">নিচের কোনটি সঠিক?</p>
                            </div>
                        ` : ''}

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                            ${[0, 1, 2, 3].map(optIdx => {
                    const isCorrect = q.correctIndex === optIdx;
                    const pillActive = isCorrect ? 'border-emerald-500 bg-emerald-50/50 dark:bg-emerald-500/10 ring-1 ring-emerald-500/40' : 'border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60';
                    const letterBadge = isCorrect ? 'bg-emerald-500 text-white font-bold' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold';

                    return `
                                    <div class="flex items-center gap-1.5 p-1 rounded-lg border ${pillActive} transition-all">
                                        <button type="button" onclick="setQuizBulkCorrectAnswer(${qIdx}, ${optIdx})" title="সঠিক উত্তর হিসেবে চিহ্নিত করতে ক্লিক করুন"
                                            class="size-6 rounded-md ${letterBadge} flex items-center justify-center text-xs shrink-0 cursor-pointer shadow-2xs transition-transform active:scale-90">
                                            ${optLetters[optIdx]}
                                        </button>
                                        <input type="text" value="${(q.options && q.options[optIdx]) || ''}" placeholder="অপশন ${optLetters[optIdx]}"
                                            oninput="updateQuizBulkOption(${qIdx}, ${optIdx}, this.value)"
                                            class="flex-1 min-w-0 bg-transparent text-xs font-normal text-slate-800 dark:text-slate-200 outline-none px-1">
                                        ${isCorrect ? `<span class="material-symbols-rounded text-emerald-500 text-[15px] mr-0.5 shrink-0">check</span>` : ''}
                                    </div>
                                `;
                }).join('')}
                        </div>

                        <!-- Explanation Input (Expandable) -->
                        <div class="flex items-start gap-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
                            <span class="material-symbols-rounded text-slate-400 text-[14px] shrink-0 mt-1">lightbulb</span>
                            <textarea placeholder="ব্যাখ্যা (ঐচ্ছিক)..."
                                oninput="updateQuizBulkExplanation(${qIdx}, this.value); autoResizeQuizBulkTextarea(this);"
                                class="flex-1 bg-transparent text-xs font-normal text-slate-600 dark:text-slate-400 outline-none placeholder:text-slate-400 resize-y min-h-[30px] leading-relaxed py-0.5 px-1 rounded-md"
                                rows="1">${q.explanation || ''}</textarea>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function updateQuizBulkQText(qIdx, val) {
            if (_quizBulkQuestions[qIdx]) {
                _quizBulkQuestions[qIdx].qText = val;
                _quizBulkQuestions[qIdx].isValid = (_quizBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _quizBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _quizBulkQuestions[qIdx].correctIndex >= 0);
                updateQuizBulkStats();
            }
        }
        window.updateQuizBulkQText = updateQuizBulkQText;

        function updateQuizBulkOption(qIdx, optIdx, val) {
            if (_quizBulkQuestions[qIdx]) {
                _quizBulkQuestions[qIdx].options[optIdx] = val;
                _quizBulkQuestions[qIdx].isValid = (_quizBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _quizBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _quizBulkQuestions[qIdx].correctIndex >= 0);
                updateQuizBulkStats();
            }
        }
        window.updateQuizBulkOption = updateQuizBulkOption;

        function setQuizBulkCorrectAnswer(qIdx, optIdx) {
            if (_quizBulkQuestions[qIdx]) {
                _quizBulkQuestions[qIdx].correctIndex = optIdx;
                _quizBulkQuestions[qIdx].isValid = (_quizBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _quizBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _quizBulkQuestions[qIdx].correctIndex >= 0);
                renderQuizBulkPreviewCards();
                updateQuizBulkStats();
            }
        }
        window.setQuizBulkCorrectAnswer = setQuizBulkCorrectAnswer;

        function updateQuizBulkExplanation(qIdx, val) {
            if (_quizBulkQuestions && _quizBulkQuestions[qIdx]) {
                _quizBulkQuestions[qIdx].explanation = val;
            }
        }
        window.updateQuizBulkExplanation = updateQuizBulkExplanation;

        function autoResizeQuizBulkTextarea(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.max(30, el.scrollHeight) + 'px';
        }
        window.autoResizeQuizBulkTextarea = autoResizeQuizBulkTextarea;

        function deleteQuizBulkQuestion(qIdx) {
            if (_quizBulkQuestions[qIdx]) {
                _quizBulkQuestions.splice(qIdx, 1);
                renderQuizBulkPreviewCards();
                updateQuizBulkStats();
            }
        }
        window.deleteQuizBulkQuestion = deleteQuizBulkQuestion;

        function clearQuizBulkText() {
            const rawInput = document.getElementById('quizBulkRawInput');
            if (rawInput) rawInput.value = '';
            _quizBulkQuestions = [];
            renderQuizBulkPreviewCards();
            updateQuizBulkStats();
        }
        window.clearQuizBulkText = clearQuizBulkText;

        function loadQuizBulkDemo(lang) {
            const rawInput = document.getElementById('quizBulkRawInput');
            if (!rawInput) return;

            if (lang === 'bn') {
                rawInput.value = `১. [এখানে ১ম প্রশ্নের বিবরণ লিখুন]
ক) [প্রথম বিকল্প]
খ) [দ্বিতীয় বিকল্প]
গ) [তৃতীয় বিকল্প]
ঘ) [চতুর্থ বিকল্প]
উত্তর: খ
ব্যাখ্যা: [উত্তরের সংক্ষিপ্ত ব্যাখ্যা লিখুন (ঐচ্ছিক)]

২. [এখানে ২য় প্রশ্নের বিবরণ লিখুন]
(ক) [অপশন ১]  (খ) [অপশন ২]  (গ) [অপশন ৩]  (ঘ) [অপশন ৪]
উত্তরঃ ক

৩. [এখানে ৩য় প্রশ্নের বিবরণ লিখুন]
ক. [অপশন ১]
খ. [অপশন ২]
গ. [অপশন ৩]
ঘ. [অপশন ৪]
সঠিক উত্তর: গ`;
            } else {
                rawInput.value = `1. [Write your 1st question text here]
A) [First option]
B) [Second option]
C) [Third option]
D) [Fourth option]
Ans: C
Exp: [Brief explanation of the answer (optional)]

2. [Write your 2nd question text here]
A) [Option 1]  B) [Option 2]  C) [Option 3]  D) [Option 4]
Ans: C

3. [Write your 3rd question text here]
A. [Option A]
B. [Option B]
C. [Option C]
D. [Option D]
Correct Answer: B`;
            }

            onQuizBulkInputChanged();
        }
        window.loadQuizBulkDemo = loadQuizBulkDemo;

        function toggleStrategy(strategy) {
            const bankFilters = document.getElementById('bankFilters');
            const strategyDesc = document.getElementById('strategyDesc');
            const manualCard = document.getElementById('strategy-manual-label');
            const autoCard = document.getElementById('strategy-automated-label');

            const inactiveClass = "p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 hover:border-slate-300 dark:hover:border-slate-700 flex items-start gap-3 cursor-pointer transition-all active:scale-95 group";

            if (manualCard) manualCard.className = inactiveClass;
            if (autoCard) autoCard.className = inactiveClass;

            const radio = document.querySelector(`input[name="strategy"][value="${strategy}"]`);
            if (radio) radio.checked = true;

            if (strategy === 'automated') {
                if (autoCard) autoCard.className = "p-3.5 rounded-xl border border-blue-500/50 bg-blue-50/20 dark:bg-blue-500/10 flex items-start gap-3 cursor-pointer transition-all active:scale-95 group";
                if (bankFilters) bankFilters.classList.remove('hidden');
                if (strategyDesc) strategyDesc.innerText = '* Questions will be analyzed & auto-populated from Question Bank matching selected chapters/topics.';
                syncBankMetadata();
                analyzeBankQuestions();
            } else {
                if (manualCard) manualCard.className = "p-3.5 rounded-xl border border-blue-500/50 bg-blue-50/20 dark:bg-blue-500/10 flex items-start gap-3 cursor-pointer transition-all active:scale-95 group";
                if (bankFilters) bankFilters.classList.add('hidden');
                if (strategyDesc) strategyDesc.innerText = '* System will create empty slots for you to fill manually.';
                analyzeBankQuestions();
            }
        }

        function setQuizLanguage(lang) {
            const isBn = lang === 'bn';
            const langInput = document.getElementById('quizLanguageInput');
            const isBanglaInput = document.getElementById('quizIsBanglaInput');
            if (langInput) langInput.value = isBn ? 'bn' : 'en';
            if (isBanglaInput) isBanglaInput.value = isBn ? 'true' : 'false';

            const bnBtn = document.getElementById('quizLangBnBtn');
            const enBtn = document.getElementById('quizLangEnBtn');
            if (bnBtn && enBtn) {
                if (isBn) {
                    bnBtn.className = 'h-9 rounded-xl border border-emerald-400 dark:border-emerald-600 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer';
                    enBtn.className = 'h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer';
                } else {
                    enBtn.className = 'h-9 rounded-xl border border-primary bg-primary/10 text-primary text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer';
                    bnBtn.className = 'h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer';
                }
            }
        }

        function updateTotalQuizSlots() {
            const mcq = parseInt(document.getElementById('mcqCount')?.value || 0) || 0;
            const short = parseInt(document.getElementById('shortCount')?.value || 0) || 0;
            const medium = parseInt(document.getElementById('mediumCount')?.value || 0) || 0;
            const comp = parseInt(document.getElementById('comprehensionCount')?.value || 0) || 0;
            const total = mcq + short + medium + comp;
            const badge = document.getElementById('quizTotalSlotsBadge');
            if (badge) badge.innerText = `Total: ${total} ${total === 1 ? 'slot' : 'slots'}`;
        }

        function validateQuestionConfig() {
            const isBulk = document.getElementById('quizModeInput')?.value === 'bulk';
            const fields = ['mcqCount', 'shortCount', 'mediumCount', 'comprehensionCount'].map(id => document.getElementById(id));
            if (isBulk) {
                fields.forEach(f => { if (f) { f.removeAttribute('required'); f.disabled = true; } });
                const alertBox = document.getElementById('qConfigAlert');
                if (alertBox) alertBox.classList.add('hidden');
                return true;
            }
            fields.forEach(f => { if (f) f.disabled = false; });
            const hasAnyFilled = fields.some(f => f && parseInt(f.value) > 0);
            const badges = document.querySelectorAll('.q-config-badge');
            const alertBox = document.getElementById('qConfigAlert');
            if (hasAnyFilled) {
                badges.forEach(b => { b.innerHTML = '<span class="text-slate-400 font-normal text-[10px]">(Optional)</span>'; });
                fields.forEach(f => { if (f) f.removeAttribute('required'); });
                if (alertBox) alertBox.classList.add('hidden');
            } else {
                badges.forEach(b => { b.innerHTML = '<span class="text-rose-500 font-bold text-xs">*</span>'; });
                fields.forEach(f => { if (f) f.setAttribute('required', 'required'); });
            }
            return hasAnyFilled;
        }

        function handleQuizFormSubmit(event) {
            // Validate required exam metadata first
            const titleInput = document.getElementById('title') || document.querySelector('input[name="title"]');
            const titleVal = (titleInput?.value || '').trim();
            if (!titleVal) {
                if (event) event.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Title Required', text: 'Please enter an exam title before proceeding.', confirmButtonColor: '#2563eb' });
                } else {
                    alert('Please enter an exam title before proceeding.');
                }
                titleInput?.focus();
                titleInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            const subjectInput = document.getElementById('quizSubject') || document.getElementById('subject') || document.querySelector('select[name="subject"]');
            const subjectVal = (subjectInput?.value || '').trim();
            if (!subjectVal) {
                if (event) event.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Subject Required', text: 'Please select a subject before proceeding.', confirmButtonColor: '#2563eb' });
                } else {
                    alert('Please select a subject before proceeding.');
                }
                subjectInput?.focus();
                subjectInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            const classInput = document.getElementById('classLevel') || document.querySelector('select[name="classLevel"]');
            const classVal = (classInput?.value || '').trim();
            if (!classVal) {
                if (event) event.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Class Required', text: 'Please select a class level before proceeding.', confirmButtonColor: '#2563eb' });
                } else {
                    alert('Please select a class level before proceeding.');
                }
                classInput?.focus();
                classInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            const examCategory = document.getElementById('examCategory')?.value || 'model';
            const courseSelect = document.getElementById('courseId');
            if (examCategory === 'course' && courseSelect && !courseSelect.value) {
                if (event) event.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Course Required', text: 'Please select a linked course for course-linked exam.', confirmButtonColor: '#2563eb' });
                } else {
                    alert('Please select a linked course for course-linked exam.');
                }
                courseSelect.focus();
                courseSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            const durationInput = document.getElementById('duration') || document.querySelector('input[name="duration"]');
            const durationVal = parseInt(durationInput?.value || 0);
            if (durationVal <= 0) {
                if (event) event.preventDefault();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Duration Required', text: 'Please enter a valid exam duration in minutes.', confirmButtonColor: '#2563eb' });
                } else {
                    alert('Please enter a valid exam duration in minutes.');
                }
                durationInput?.focus();
                return false;
            }

            const isBulkMode = document.getElementById('quizModeInput')?.value === 'bulk';
            if (isBulkMode) {
                // In bulk mode, exam metadata is validated; user proceeds to bulk studio
                return true;
            }

            const hasAnyFilled = validateQuestionConfig();
            if (!hasAnyFilled) {
                if (event) event.preventDefault();
                const alertBox = document.getElementById('qConfigAlert');
                if (alertBox) alertBox.classList.remove('hidden');
                const firstField = document.getElementById('mcqCount');
                firstField?.focus();
                firstField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            if (isSmartGeneration()) {
                if (_bankCounts) {
                    const mcq = parseInt(document.getElementById('mcqCount')?.value || 0) || 0;
                    const short = parseInt(document.getElementById('shortCount')?.value || 0) || 0;
                    const medium = parseInt(document.getElementById('mediumCount')?.value || 0) || 0;
                    const comp = parseInt(document.getElementById('comprehensionCount')?.value || 0) || 0;

                    const maxMcq = _bankCounts.MCQ || 0;
                    const maxShort = _bankCounts.Short || 0;
                    const maxMedium = _bankCounts.Medium || 0;
                    const maxComp = _bankCounts.Comprehension || 0;

                    if (mcq > maxMcq || short > maxShort || medium > maxMedium || comp > maxComp) {
                        if (event) event.preventDefault();
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Question Limit Exceeded',
                                text: 'Cannot request more questions than available in Question Bank for the selected items.',
                                confirmButtonColor: '#2563eb'
                            });
                        } else {
                            alert('Cannot request more questions than available in Question Bank for the selected items.');
                        }
                        return false;
                    }

                    if ((mcq + short + medium + comp) === 0) {
                        if (event) event.preventDefault();
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'info',
                                title: 'No Questions Selected',
                                text: 'Please specify at least 1 question slot to generate.',
                                confirmButtonColor: '#2563eb'
                            });
                        } else {
                            alert('Please specify at least 1 question slot to generate.');
                        }
                        return false;
                    }
                }
            }

            return true;
        }

        document.getElementById('courseId').addEventListener('change', onCourseSelectChange);

        window.addEventListener('DOMContentLoaded', () => {
            updateView(true);
            const urlParams = new URLSearchParams(window.location.search);
            const initialMode = urlParams.get('mode') === 'bulk' ? 'bulk' : 'standard';
            switchAssessmentStudioMode(initialMode);
            updateTotalQuizSlots();
        });
    </script>
</body>

</html>