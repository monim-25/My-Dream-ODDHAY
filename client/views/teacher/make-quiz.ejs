                                        <a href="/teacher/quizzes"
                                            class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">Cancel</a>
