                                            class="hidden mt-3 p-2.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-amber-700 dark:text-amber-300 text-xs font-semibold flex items-center gap-1.5 animate-in fade-in">
                                            <span class="material-symbols-rounded text-base">info</span>
