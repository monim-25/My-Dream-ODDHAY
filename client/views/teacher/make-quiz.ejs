                <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>

    <script>
        const allCourses = Array.from(document.querySelectorAll('#courseId option')).slice(1);
        const preSelectedCourseId = '<%= selectedCourseId %>';
        // Class -> subjects map from server
        const CLASS_SUBJECT_MAP = <%- JSON.stringify(typeof classSubjectMap !== 'undefined' ? classSubjectMap : {}) %>;

        // ─── Utility ─────────────────────────────────────────────────────────────
        function escapeHtml(str) {
            return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ─── Client Cache for Syllabus ───────────────────────────────────────────
        const _quizTopicsCache = new Map();

        // ─── Syllabus fetch (fast client-cached lookup) ───────────────────────────
        async function fetchTopicsSafely(subject, classList, segment = '') {
            const cacheKey = `${subject}__${(classList || []).join(',')}__${segment}`.toLowerCase();
            if (_quizTopicsCache.has(cacheKey)) {
                return _quizTopicsCache.get(cacheKey);
            }
            const endpoints = ['/api/topics', '/teacher/api/topics'];
            const params = { subject, classLevels: classList.join(',') };
            if (segment && segment !== 'all') params.segment = segment;
            const query = new URLSearchParams(params).toString();
            for (const ep of endpoints) {
                try {
                    const res = await fetch(ep + '?' + query, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) continue;
                    const ct = res.headers.get('content-type') || '';
                    if (!ct.includes('application/json')) continue;
                    const json = await res.json();
                    if (json && (json.success || Array.isArray(json.topics))) {
                        _quizTopicsCache.set(cacheKey, json);
                        return json;
                    }
                } catch (e) { console.warn('Topic endpoint error:', ep, e); }
            }
            return { success: true, count: 0, topics: [], chapters: [] };
        }

        async function checkQuizSubjectSegments() {
            const classLevel = document.getElementById('classLevel')?.value || '';
            const subjSelect = document.getElementById('quizSubject');
            const subject = subjSelect ? subjSelect.value : '';
            const segmentContainer = document.getElementById('segmentContainer');
            const segmentSelect = document.getElementById('quizSegmentSelect');
            if (!segmentContainer || !segmentSelect) return;

            if (!subject) {
                segmentContainer.classList.add('hidden');
                segmentSelect.innerHTML = '<option value="all">All Segments (সকল বিভাগ)</option>';
                return;
            }

            try {
                const res = await fetch(`/api/subjects/segments?subject=${encodeURIComponent(subject)}&classLevel=${encodeURIComponent(classLevel)}`);
                const data = await res.json();
                if (data && data.hasSegments && Array.isArray(data.segments) && data.segments.length > 0) {
                    segmentContainer.classList.remove('hidden');
                    let opts = '<option value="all">All Segments (সকল বিভাগ)</option>';
                    data.segments.forEach(seg => {
                        opts += `<option value="${seg}">${seg}</option>`;
                    });
                    segmentSelect.innerHTML = opts;
                } else {
                    segmentContainer.classList.add('hidden');
                    segmentSelect.innerHTML = '<option value="all">All Segments (সকল বিভাগ)</option>';
                }
            } catch (e) {
                console.warn('Error checking quiz subject segments:', e);
            }
        }

        function onQuizSegmentChanged() {
            onQuizSubjectOrClassChange(false);
        }

        // ─── Filter subject dropdown by selected class (Model Test mode) ─────────
        function filterSubjectsByClass(cls) {
            const subjSelect = document.getElementById('quizSubject');
            if (!subjSelect) return;
            const clean = String(cls || '').replace(/^Class\s+/i, '').trim();
            const available = CLASS_SUBJECT_MAP[cls] || CLASS_SUBJECT_MAP['Class ' + clean] || CLASS_SUBJECT_MAP[clean] || [];
            const allSubjects = <%- JSON.stringify(typeof subjects !== 'undefined' ? subjects : []) %>;
            const list = available.length > 0 ? available : allSubjects;
            const current = subjSelect.value;
            subjSelect.innerHTML = '<option value="">-- Select Subject --</option>';
            list.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub;
                if (sub === current) opt.selected = true;
                subjSelect.appendChild(opt);
            });
            onQuizSubjectOrClassChange();
        }

        // ─── Course Select Change (Course-Linked mode) ───────────────────────────
        window.onCourseSelectChange = function () {
            const categorySelect = document.getElementById('examCategory');
            const category = categorySelect ? categorySelect.value : (document.getElementById('isModelTest')?.value === 'true' ? 'model' : 'course');
            if (category !== 'course') return;

            const courseSelect = document.getElementById('courseId');
            const subjSelect = document.getElementById('quizSubject');
            const classLevelEl = document.getElementById('classLevel');
            const syllabusWrapper = document.getElementById('quizSyllabusWrapper');
            const selectedOpt = courseSelect && courseSelect.selectedIndex >= 0 ? courseSelect.options[courseSelect.selectedIndex] : null;

            if (!selectedOpt || !selectedOpt.value) {
                // No course selected:
                if (subjSelect) {
                    subjSelect.innerHTML = '<option value="">-- Select Course First --</option>';
                    subjSelect.value = '';
                }
                if (syllabusWrapper) syllabusWrapper.classList.add('hidden');
                syncBankMetadata();
                return;
            }

            // Extract course's assigned subject(s) & class from course attributes
            const rawSubj = (selectedOpt.getAttribute('data-subject') || '').trim();
            const courseSubjects = rawSubj.split(',').map(s => s.trim()).filter(Boolean);

            const rawClass = (selectedOpt.getAttribute('data-class') || '').trim();
            const courseClasses = rawClass.split(',').map(c => c.trim()).filter(Boolean);

            // Auto-sync classLevel dropdown to course's class if not matching
            if (courseClasses.length > 0 && (!classLevelEl.value || !courseClasses.includes(classLevelEl.value))) {
                classLevelEl.value = courseClasses[0];
            }

            // Populate subject dropdown with ONLY the subject(s) assigned to this course
            if (subjSelect) {
                const prevSubj = subjSelect.value;
                subjSelect.innerHTML = courseSubjects.length > 1 ? '<option value="">-- Select Course Subject --</option>' : '';
                courseSubjects.forEach(sub => {
                    const opt = document.createElement('option');
                    opt.value = sub;
                    opt.textContent = sub;
                    if (sub === prevSubj) opt.selected = true;
                    subjSelect.appendChild(opt);
                });
                if (courseSubjects.length === 1) {
                    subjSelect.value = courseSubjects[0];
                }
            }

            syncBankMetadata();
            onQuizSubjectOrClassChange();
        };

        // ─── Subject / Class change → load chapters ───────────────────────────────
        window.onQuizSubjectOrClassChange = async function (checkSegments = true) {
            const categorySelect = document.getElementById('examCategory');
            const category = categorySelect ? categorySelect.value : (document.getElementById('isModelTest')?.value === 'true' ? 'model' : 'course');
            const isCourseLinked = (category === 'course');
            const classLevelEl = document.getElementById('classLevel');
            const courseSelect = document.getElementById('courseId');
            const qs = document.getElementById('quizSubject');

            const syllabusWrapper = document.getElementById('quizSyllabusWrapper');
            const chapterSelect = document.getElementById('quizChapter');
            const emptyState = document.getElementById('quizTopicsEmptyState');
            const loadingState = document.getElementById('quizTopicsLoading');
            const topicsList = document.getElementById('quizTopicsList');
            const syncPortal = document.getElementById('crossClassSyncPortal');
            const badge = document.getElementById('quizChapterBadge');

            if (syncPortal) syncPortal.classList.add('hidden');

            // If Course-Linked mode and NO course is selected, DO NOT LOAD SYLLABUS
            if (isCourseLinked && (!courseSelect || !courseSelect.value)) {
                if (syllabusWrapper) syllabusWrapper.classList.add('hidden');
                return;
            }

            const subject = qs ? qs.value.trim() : '';
            let classLevel = classLevelEl ? classLevelEl.value.trim() : '';

            // If classLevel is empty in course-linked mode, try getting it from course
            if (isCourseLinked && !classLevel && courseSelect && courseSelect.selectedIndex >= 0) {
                const selOpt = courseSelect.options[courseSelect.selectedIndex];
                if (selOpt) {
                    const cCls = (selOpt.getAttribute('data-class') || '').trim();
                    if (cCls) {
                        classLevel = cCls.split(',')[0].trim();
                        if (classLevelEl) classLevelEl.value = classLevel;
                    }
                }
            }

            // If subject or classLevel is missing, DO NOT LOAD SYLLABUS
            if (!subject || !classLevel) {
                if (syllabusWrapper) syllabusWrapper.classList.add('hidden');
                selectedTeacherChapters.clear();
                const container = document.getElementById('chaptersContainer');
                if (container) container.innerHTML = '<span id="chapterPlaceholder" class="text-[11px] text-slate-400 italic">Select Class Level and Subject to load syllabus chapters...</span>';
                document.getElementById('selectAllTeacherChaptersBtn')?.classList.add('hidden');
                updateTeacherChapterSummary();
                return;
            }

            selectedTeacherChapters.clear();
            updateTeacherChapterSummary();
            if (syllabusWrapper) syllabusWrapper.classList.add('hidden');
            if (emptyState) {
                emptyState.classList.add('hidden');
            }
            if (loadingState) loadingState.classList.remove('hidden');
            if (topicsList) { topicsList.classList.add('hidden'); topicsList.innerHTML = ''; }
            if (badge) { badge.textContent = ''; badge.classList.add('hidden'); }

            try {
                const activeSegment = document.getElementById('quizSegmentSelect')?.value || 'all';
                const segPromise = checkSegments ? checkQuizSubjectSegments() : Promise.resolve();
                const topicsPromise = fetchTopicsSafely(subject, [classLevel], activeSegment);
                const [_, data] = await Promise.all([segPromise, topicsPromise]);
                window._quizCachedTopics = Array.isArray(data.topics) ? data.topics : [];

                // Populate chapters
                if (chapterSelect) {
                    const chapMap = new Map();
                    window._quizCachedTopics.forEach(t => {
                        const cName = (typeof t.chapter === 'string') ? t.chapter : (t.chapter?.name || '');
                        const cNum = (typeof t.chapter === 'object' && t.chapter) ? (parseInt(t.chapter.number, 10) || 999) : 999;
                        if (cName.trim() && !chapMap.has(cName.trim().toLowerCase()))
                            chapMap.set(cName.trim().toLowerCase(), { name: cName.trim(), number: cNum });
                    });
                    (data.chapters || []).forEach(c => {
                        if (c && !chapMap.has(c.trim().toLowerCase()))
                            chapMap.set(c.trim().toLowerCase(), { name: c.trim(), number: 999 });
                    });
                    const sorted = Array.from(chapMap.values()).sort((a, b) => a.number - b.number);
                    chapterSelect.innerHTML = '<option value="">Select Chapter</option>';
                    sorted.forEach(ch => {
                        const opt = document.createElement('option');
                        opt.value = ch.name;
                        opt.textContent = ch.name;
                        chapterSelect.appendChild(opt);
                    });
                    renderTeacherChapterPills(sorted);
                }
            } catch (err) {
                console.error('Failed to load chapters:', err);
            } finally {
                if (loadingState) loadingState.classList.add('hidden');
            }
            renderQuizTopicsForSelectedChapters();
        };

        // ─── Multi Chapter Pills Management ─────────────────────────────────────
        let selectedTeacherChapters = new Set();

        function renderTeacherChapterPills(chapters) {
            const container = document.getElementById('chaptersContainer');
            const selectAllBtn = document.getElementById('selectAllTeacherChaptersBtn');
            if (!container) return;
            container.innerHTML = '';
            if (chapters && chapters.length > 0) {
                chapters.forEach((ch, idx) => {
                    const chName = typeof ch === 'string' ? ch : (ch.name || `Chapter ${ch.number || (idx + 1)}`);
                    container.appendChild(createTeacherChapterPill(chName));
                });
                if (selectAllBtn) selectAllBtn.classList.remove('hidden');
            } else {
                container.innerHTML = '<span class="text-[11px] text-slate-400 italic">No predefined chapters found for this subject.</span>';
                if (selectAllBtn) selectAllBtn.classList.add('hidden');
            }

            updateTeacherChapterSummary();
        }

        function createTeacherChapterPill(chapterName) {
            const label = document.createElement('label');
            label.className = 'chapter-pill cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold border transition-all select-none bg-white dark:bg-slate-800/80 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-primary/50';

            const isChecked = selectedTeacherChapters.has(chapterName);
            if (isChecked) {
                label.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
            }

            label.innerHTML = `
                <input type="checkbox" name="chapters[]" value="${escapeHtml(chapterName)}" ${isChecked ? 'checked' : ''} class="w-3.5 h-3.5 rounded text-primary border-slate-300 focus:ring-primary accent-primary">
                <span>${escapeHtml(chapterName)}</span>
            `;

            const input = label.querySelector('input');
            input.onchange = function () {
                if (this.checked) {
                    selectedTeacherChapters.add(chapterName);
                    label.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                } else {
                    selectedTeacherChapters.delete(chapterName);
                    label.classList.remove('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                }
                updateTeacherChapterSummary();
                renderQuizTopicsForSelectedChapters();
                syncBankMetadata();
                analyzeBankQuestions();
            };

            return label;
        }

        function toggleSelectAllTeacherChapters() {
            const container = document.getElementById('chaptersContainer');
            const checkboxes = container.querySelectorAll('input[type="checkbox"][name="chapters[]"]');
            if (checkboxes.length === 0) return;

            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            const btn = document.getElementById('selectAllTeacherChaptersBtn');

            checkboxes.forEach(cb => {
                cb.checked = !allChecked;
                const pill = cb.closest('.chapter-pill');
                const chapterVal = cb.value;
                if (!allChecked) {
                    selectedTeacherChapters.add(chapterVal);
                    if (pill) pill.classList.add('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                } else {
                    selectedTeacherChapters.delete(chapterVal);
                    if (pill) pill.classList.remove('bg-primary/10', 'border-primary', 'text-primary', 'dark:text-primary');
                }
            });

            if (btn) btn.innerText = allChecked ? 'Select All' : 'Deselect All';
            updateTeacherChapterSummary();
            renderQuizTopicsForSelectedChapters();
            syncBankMetadata();
            analyzeBankQuestions();
            renderQuizTopicsForSelectedChapters();
            syncBankMetadata();
        }

        function updateTeacherChapterSummary() {
            const count = selectedTeacherChapters.size;
            const badge = document.getElementById('chapterCountBadge');
            const summaryInput = document.getElementById('chapterSummaryInput');
            const btn = document.getElementById('selectAllTeacherChaptersBtn');
            const checkboxes = document.querySelectorAll('#chaptersContainer input[type="checkbox"][name="chapters[]"]');

            if (badge) badge.innerText = `${count} selected`;
            if (summaryInput) summaryInput.value = Array.from(selectedTeacherChapters).join(', ');
            if (btn && checkboxes.length > 0) {
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                btn.innerText = allChecked ? 'Deselect All' : 'Select All';
            }
        }

        // ─── Render Topics matching selected chapters (Supports Multiple Chapters) ───
        window.renderQuizTopicsForSelectedChapters = function () {
            const syllabusWrapper = document.getElementById('quizSyllabusWrapper');
            const allTopics = window._quizCachedTopics || [];
            const emptyState = document.getElementById('quizTopicsEmptyState');
            const topicsList = document.getElementById('quizTopicsList');
            const syncPortal = document.getElementById('crossClassSyncPortal');
            const badge = document.getElementById('quizChapterBadge');
            const countBadge = document.getElementById('quizTopicCountBadge');

            if (syncPortal) syncPortal.classList.add('hidden');

            const selectedList = Array.from(selectedTeacherChapters);
            const lowerSelected = selectedList.map(c => c.trim().toLowerCase());

            // ONLY show topics when chapter(s) are selected
            if (lowerSelected.length === 0) {
                if (syllabusWrapper) syllabusWrapper.classList.add('hidden');
                if (topicsList) { topicsList.classList.add('hidden'); topicsList.innerHTML = ''; }
                if (countBadge) countBadge.classList.add('hidden');
                if (badge) badge.classList.add('hidden');
                const subTopicsSection = document.getElementById('quizSubTopicsSection');
                if (subTopicsSection) subTopicsSection.classList.add('hidden');
                syncQuizTopicSelection();
                return;
            }

            // At least one chapter is selected
            if (syllabusWrapper) syllabusWrapper.classList.remove('hidden');

            if (badge) {
                if (selectedList.length === 1) {
                    badge.textContent = selectedList[0];
                    badge.classList.remove('hidden');
                } else {
                    badge.textContent = `${selectedList.length} Chapters`;
                    badge.classList.remove('hidden');
                }
            }

            const matchingTopics = allTopics.filter(t => {
                const cName = (typeof t.chapter === 'string') ? t.chapter : (t.chapter?.name || '');
                return lowerSelected.includes(cName.trim().toLowerCase());
            });

            if (matchingTopics.length > 0) {
                renderQuizTopics(matchingTopics);
                if (countBadge) {
                    countBadge.textContent = `${matchingTopics.length} available`;
                    countBadge.classList.remove('hidden');
                }
            } else {
                if (topicsList) { topicsList.classList.add('hidden'); topicsList.innerHTML = ''; }
                if (countBadge) countBadge.classList.add('hidden');
                if (emptyState) {
                    emptyState.classList.remove('hidden');
                    emptyState.innerHTML = '<div class="flex flex-col items-center gap-1.5 py-2 text-center">' +
                        '<span class="material-symbols-rounded text-amber-500 text-xl">playlist_remove</span>' +
                        '<span class="text-xs font-semibold text-slate-700 dark:text-slate-200">No approved topics found for the selected chapter(s)</span>' +
                        '<a href="/teacher/topics" target="_blank" class="inline-flex items-center gap-1 mt-1 px-2.5 py-1 rounded-lg bg-primary text-white text-[11px] font-bold hover:bg-primary/90 transition-all"><span class="material-symbols-rounded text-xs">add</span>Add Syllabus Topics</a>' +
                        '</div>';
                }
                syncQuizTopicSelection();
            }
        };

        window.onQuizChapterChange = function (val) {
            renderQuizTopicsForSelectedChapters();
        };

        function renderQuizTopics(topics) {
            const topicsList = document.getElementById('quizTopicsList');
            const emptyState = document.getElementById('quizTopicsEmptyState');
            if (!topicsList) return;
            topicsList.innerHTML = '';
            const seen = new Set();
            topics.forEach(t => {
                const key = (t.name || '').trim().toLowerCase();
                if (!key || seen.has(key)) return;
                seen.add(key);
                const tName = (t.name || '').trim();
                const cName = (typeof t.chapter === 'string') ? t.chapter : (t.chapter?.name || '');
                const chip = document.createElement('label');
                chip.className = 'topic-select-chip flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/60 dark:hover:border-primary/60 bg-white dark:bg-slate-900 cursor-pointer text-xs select-none transition-all';
                chip.innerHTML = '<input type="checkbox" name="topics[]" value="' + escapeHtml(tName) + '" class="quiz-topic-checkbox accent-primary rounded size-4 cursor-pointer" onchange="onQuizTopicChipChange(this)">' +
                    '<div class="flex flex-col min-w-0 leading-tight">' +
                    '<span class="font-medium text-slate-700 dark:text-slate-200 text-xs leading-tight">' + escapeHtml(tName) + '</span>' +
                    (cName ? '<span class="text-[9.5px] text-slate-400 font-normal truncate mt-0.5">' + escapeHtml(cName) + '</span>' : '') +
                    '</div>';
                topicsList.appendChild(chip);
            });
            if (emptyState) emptyState.classList.add('hidden');
            topicsList.classList.remove('hidden');
            syncQuizTopicSelection();
        }

        window.onQuizTopicChipChange = function (cb) {
            const chip = cb ? cb.closest('.topic-select-chip') : null;
            if (chip && cb) {
                if (cb.checked) chip.classList.add('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
                else chip.classList.remove('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
            }
            syncQuizTopicSelection();
