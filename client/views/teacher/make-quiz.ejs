<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Compose Assessment | ODDHAY Teacher Panel</title>
        <style>
            :root {
                --admin-sidebar-width: 260px;
            }

            html,
            body {
                height: 100%;
                height: 100dvh;
                overflow: hidden;
                margin: 0;
                padding: 0;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100%;
                height: 100dvh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                width: calc(100% - var(--admin-sidebar-width));
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                -webkit-overflow-scrolling: touch;
                overscroll-behavior-y: contain;
                padding: 0;
                position: relative;
            }

            @media (max-width: 1024px) {

                .admin-sidebar,
                #adminSidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0 !important;
                    width: 100% !important;
                }

                .content-scroll {
                    -webkit-overflow-scrolling: touch;
                    overscroll-behavior-y: contain;
                }
            }

            .admin-sidebar.active,
            #adminSidebar.active,
            .admin-sidebar.translate-x-0,
            #adminSidebar.translate-x-0 {
                transform: translateX(0) !important;
            }

            .form-label {
                display: block;
                font-size: 11px;
                font-weight: 500;
                color: #64748b;
                margin-bottom: 5px;
            }

            .dark .form-label {
                color: #94a3b8;
            }

            .form-input {
                width: 100%;
                height: 40px;
                padding: 0 12px;
                font-size: 12.5px;
                font-weight: 500;
                color: #0f172a;
                background: #ffffff;
                border: 1px solid #cbd5e1;
                border-radius: 0.625rem;
                outline: none;
                transition: all 0.2s ease;
            }

            .dark .form-input {
                background: #0b1120;
                border-color: #334155;
                color: #f1f5f9;
            }

            .form-input:focus {
                border-color: #137fec;
                box-shadow: 0 0 0 3px rgba(19, 127, 236, 0.1);
            }

            .dark .form-input:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            }
        </style>
</head>

<body class="bg-[#F8F8FF] dark:bg-[#0b1120] text-slate-700 dark:text-slate-300 font-sans min-h-screen antialiased">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: locals.active || 'quizzes' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)"
            class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300">
        </div>

        <main class="admin-main flex-1 flex flex-col w-full h-full h-[100dvh] overflow-hidden">
            <%- include('header', { pageTitle: 'Compose Assessment' , user: user }) %>

                <section
                    class="content-scroll flex-1 flex flex-col bg-[#F8F8FF] dark:bg-[#0b1120] border-l-0 lg:border-l border-slate-900/10 dark:border-white/5 overflow-y-auto">
                    <form action="/teacher/add-quiz" method="POST" class="w-full"
                        onsubmit="return handleQuizFormSubmit(event);">
                        <input type="hidden" name="activeFlow" value="<%= active %>">
                        <div class="divide-y divide-slate-100 dark:divide-white/5 bg-white dark:bg-[#0f172a]">
                            <!-- Messages -->
                            <% if (locals.success || locals.error) { %>
                                <div class="p-6 pb-0">
                                    <% if (locals.success) { %>
                                        <div
                                            class="bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-3 py-2.5 rounded-lg flex items-center gap-2 text-[12px] font-bold">
                                            <span class="material-symbols-rounded text-[16px]">check_circle</span>
                                            <%= success %>
                                        </div>
                                        <% } %>
                                            <% if (locals.error) { %>
                                                <div
                                                    class="bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-2.5 rounded-lg flex items-center gap-2 text-[12px] font-bold">
                                                    <span class="material-symbols-rounded text-[16px]">error</span>
                                                    <%= error %>
                                                </div>
                                                <% } %>
                                </div>
                                <% } %>

                                    <!-- Studio Mode Switcher: Standard Studio vs Bulk Studio -->
                                    <div
                                        class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-8 py-3 bg-slate-50 dark:bg-slate-900/40 border-b border-slate-100 dark:border-white/5">
                                        <div
                                            class="flex items-center gap-1.5 p-1 bg-slate-200/70 dark:bg-slate-800 rounded-xl">
                                            <button type="button" onclick="switchAssessmentStudioMode('standard')"
                                                id="mode-standard-btn"
                                                class="h-8 px-3.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer">
                                                <span class="material-symbols-rounded text-sm">tune</span>
                                                <span>Standard Studio</span>
                                            </button>
                                            <button type="button" onclick="switchAssessmentStudioMode('bulk')"
                                                id="mode-bulk-btn"
                                                class="h-8 px-3.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer">
                                                <span class="material-symbols-rounded text-sm">bolt</span>
                                                <span>Bulk Studio</span>
                                            </button>
                                        </div>
                                        <input type="hidden" name="mode" id="quizModeInput" value="standard">
                                        <div id="bulkModeBadge"
                                            class="hidden text-xs text-amber-600 dark:text-amber-400 font-semibold flex items-center gap-1">
                                            <span class="material-symbols-rounded text-sm">info</span>
                                            <span>পরীক্ষার প্রয়োজনীয় তথ্য পূরণ করে 'Next' চাপলে সরাসরি প্রশ্ন পেস্ট করতে
                                                পারবেন</span>
                                        </div>
                                    </div>

                                    <!-- Basic Information -->
                                    <div class="p-4 sm:p-8">
                                        <h3
                                            class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-4 sm:mb-6 flex items-center gap-2">
                                            <span class="material-symbols-rounded text-[20px] text-blue-500">quiz</span>
                                            Exam Identification
                                        </h3>
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6">
                                            <div class="sm:col-span-2">
                                                <label class="form-label">Exam Title</label>
                                                <input type="text" id="title" name="title" required
                                                    placeholder="e.g Physics Mock Test 01" class="form-input"
                                                    value="<%= prefilledTitle %>">
                                            </div>
                                            <div class="sm:col-span-1">
                                                <label class="form-label">Duration (Minutes)</label>
                                                <input type="number" id="duration" name="duration" required value="10" min="1"
                                                    class="form-input">
                                            </div>
                                            <div class="sm:col-span-3 pt-1">
                                                <label class="form-label flex items-center justify-between">
                                                    <span>Question Language / অপশন ও প্রশ্নের ভাষা</span>
                                                    <span
                                                        class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded-full">ডিফল্ট:
                                                        বাংলা</span>
                                                </label>
                                                <div class="grid grid-cols-2 gap-2.5 max-w-md">
                                                    <button type="button" onclick="setQuizLanguage('bn')"
                                                        id="quizLangBnBtn"
                                                        class="h-9 rounded-xl border border-emerald-400 dark:border-emerald-600 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-2xs cursor-pointer">
                                                        <span class="material-symbols-rounded text-sm">language</span>
                                                        <span>বাংলা (ক, খ, গ, ঘ)</span>
                                                    </button>
                                                    <button type="button" onclick="setQuizLanguage('en')"
                                                        id="quizLangEnBtn"
                                                        class="h-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-medium flex items-center justify-center gap-1.5 transition-all hover:border-primary/40 cursor-pointer">
                                                        <span class="material-symbols-rounded text-sm">translate</span>
                                                        <span>English (A, B, C, D)</span>
                                                    </button>
                                                </div>
                                                <input type="hidden" name="language" id="quizLanguageInput" value="bn">
                                                <input type="hidden" name="isBangla" id="quizIsBanglaInput"
                                                    value="true">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Categorization -->
                                    <div class="p-4 sm:p-8">
                                        <h3
                                            class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-4 sm:mb-6 flex items-center gap-2">
                                            <span
                                                class="material-symbols-rounded text-[20px] text-emerald-500">account_tree</span>
                                            Logic & Routing
                                        </h3>
                                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6">
                                            <!-- Exam Type -->
                                            <div class="col-span-1">
                                                <label class="form-label">Exam Type</label>
                                                <div class="relative">
                                                    <select name="examCategory" id="examCategory"
                                                        onchange="updateView()"
                                                        class="form-input cursor-pointer pr-8 appearance-none font-bold">
                                                        <option value="model" <%=!selectedCourseId ? 'selected' : '' %>
                                                            >Model Test</option>
                                                        <option value="course" <%=selectedCourseId ? 'selected' : '' %>
                                                            >Course-Linked</option>
                                                        <option value="mock">Mock Test</option>
                                                    </select>
                                                    <span
                                                        class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                    <input type="hidden" name="isModelTest" id="isModelTest"
                                                        value="<%= selectedCourseId ? 'false' : 'true' %>">
                                                    <input type="hidden" name="isMockTest" id="isMockTest"
                                                        value="false">
                                                </div>
                                            </div>
                                            <!-- Class Level -->
                                            <div class="col-span-1">
                                                <label class="form-label">Class Level</label>
                                                <div class="relative">
                                                    <select name="classLevel" id="classLevel" onchange="updateView()"
                                                        class="form-input cursor-pointer pr-8 appearance-none" required>
                                                        <option value="">-- Class --</option>
                                                        <% (classes || []).forEach(lvl=> {
                                                            const cleanLvl = String(lvl).replace(/^Class\s+/i,
                                                            '').trim();
                                                            %>
                                                            <option value="<%= lvl %>" <%=lvl===selectedClassLevel
                                                                ? 'selected' : '' %>><%= ['HSC', 'Admission'
                                                                    ].includes(cleanLvl) ? cleanLvl : 'Class ' +
                                                                    cleanLvl %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                    <span
                                                        class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                </div>
                                            </div>
                                            <!-- Course Link (Course-Linked mode) -->
                                            <div id="courseContainer"
                                                class="col-span-1 <%= !selectedCourseId ? 'hidden' : '' %>">
                                                <label class="form-label">Link to Course</label>
                                                <div class="relative">
                                                    <select name="courseId" id="courseId"
                                                        onchange="onCourseSelectChange()"
                                                        class="form-input cursor-pointer pr-8 appearance-none"
                                                        <%=!selectedCourseId ? 'disabled' : '' %>>
                                                        <option value="">-- Select Course --</option>
                                                        <% courses.forEach(course=> {
                                                            const cSubjList = Array.isArray(course.subject) ?
                                                            course.subject.filter(Boolean) : (course.subject ?
                                                            [course.subject] : []);
                                                            const cClassList = Array.isArray(course.classLevel) ?
                                                            course.classLevel.filter(Boolean) : (course.classLevel ?
                                                            [course.classLevel] : []);
                                                            %>
                                                            <option value="<%= course._id %>"
                                                                data-class="<%= cClassList.join(',') %>"
                                                                data-subject="<%= cSubjList.join(',') %>"
                                                                data-access="<%= course.accessType || 'Free' %>"
                                                                <%=course._id.toString()===selectedCourseId ? 'selected'
                                                                : '' %>>
                                                                <%= course.title %>
                                                            </option>
                                                            <% }); %>
                                                    </select>
                                                    <span
                                                        class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                </div>
                                            </div>
                                            <!-- Subject (Both Model Test and Course-Linked) -->
                                            <div id="subjectContainer"
                                                class="<%= !selectedCourseId ? 'col-span-2 md:col-span-2' : 'col-span-1' %>">
                                                <label id="subjectLabel" class="form-label">
                                                    <%= !selectedCourseId ? 'Subject' : 'Course Subject' %>
                                                </label>
                                                <div class="relative">
                                                    <select name="subject" id="quizSubject"
                                                        onchange="onQuizSubjectOrClassChange()"
                                                        class="form-input cursor-pointer pr-8 appearance-none" required>
                                                        <option value="">-- Select Subject --</option>
                                                        <% (subjects || []).forEach(sub=> { %>
                                                            <option value="<%= sub %>" <%=sub===selectedSubject
                                                                ? 'selected' : '' %>><%= sub %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                    <span
                                                        class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                </div>
                                            </div>
                                            <!-- Segment (Visible when Subject has segmentation rules) -->
                                            <div id="segmentContainer" class="col-span-1 hidden">
                                                <label class="form-label flex items-center justify-between">
                                                    <span class="flex items-center gap-1.5">
                                                        <span
                                                            class="material-symbols-rounded text-sm text-indigo-500">segment</span>
                                                        <span>Subject Segment</span>
                                                    </span>
                                                    <span
                                                        class="text-[10px] text-indigo-600 dark:text-indigo-400 font-semibold bg-indigo-50 dark:bg-indigo-950/50 px-2 py-0.5 rounded-full">Ruled
                                                        Subject</span>
                                                </label>
                                                <div class="relative">
                                                    <select name="segment" id="quizSegmentSelect"
                                                        onchange="onQuizSegmentChanged()"
                                                        class="form-input cursor-pointer pr-8 appearance-none">
                                                        <option value="all">All Segments (সকল বিভাগ)</option>
                                                    </select>
                                                    <span
                                                        class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Chapter Selection (Optional - Multi Select) -->
                                        <div id="chapterSection"
                                            class="mt-4 sm:mt-6 pt-4 border-t border-slate-100 dark:border-white/5">
                                            <div class="flex items-center justify-between mb-2">
                                                <label class="form-label mb-0 flex items-center gap-2">
                                                    <span>Select Chapters</span>
                                                    <span
                                                        class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">(Optional)</span>
                                                </label>
                                                <div class="flex items-center gap-2.5">
                                                    <button type="button" id="selectAllTeacherChaptersBtn"
                                                        onclick="toggleSelectAllTeacherChapters()"
                                                        class="hidden text-[11px] font-bold text-primary hover:underline cursor-pointer transition-all active:scale-95">Select
                                                        All</button>
                                                    <span id="chapterCountBadge"
                                                        class="text-[11px] font-medium text-slate-400">0 selected</span>
                                                </div>
                                            </div>
                                            <p class="text-[11px] text-slate-400 dark:text-slate-500 mb-2.5">You can
                                                select one or more chapters to scope this assessment, or leave
                                                unselected for full syllabus coverage.</p>

                                            <!-- Chapter Pills Container -->
                                            <div id="chaptersContainer"
                                                class="min-h-[44px] p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 flex flex-wrap gap-2 items-center">
                                                <span id="chapterPlaceholder"
                                                    class="text-[11px] text-slate-400 italic">Select Class Level and
                                                    Subject to load syllabus chapters...</span>
                                            </div>
                                            <input type="hidden" name="chapter" id="chapterSummaryInput" value="">
                                        </div>

                                        <!-- Chapter & Topics (always visible once class+subject resolved) -->
                                        <div id="quizSyllabusWrapper" class="mt-4 sm:mt-6 hidden">
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-6 mb-4">
                                                <!-- Legacy Chapter dropdown (kept for sync compatibility) -->
                                                <div class="hidden">
                                                    <label class="form-label flex items-center gap-1.5">Chapter
                                                        <span id="quizChapterBadge"
                                                            class="hidden text-[10px] font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 px-2 py-0.5 rounded-full"></span>
                                                    </label>
                                                    <div class="relative">
                                                        <select id="quizChapter"
                                                            onchange="onQuizChapterChange(this.value)"
                                                            class="form-input cursor-pointer pr-8 appearance-none">
                                                            <option value="">Select Chapter</option>
                                                        </select>
                                                        <span
                                                            class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-sm">expand_more</span>
                                                    </div>
                                                </div>
                                                <!-- Topic count badge -->
                                                <div class="flex flex-col justify-end">
                                                    <label class="form-label flex items-center gap-1.5">Topics
                                                        <span id="quizTopicCountBadge"
                                                            class="hidden text-[10px] font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 px-2 py-0.5 rounded-full"></span>
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Topics list -->
                                            <div id="quizTopicsWrapper" class="mt-1">
                                                <div id="quizTopicsEmptyState"
                                                    class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500 py-2">
                                                    <span
                                                        class="material-symbols-rounded text-base text-slate-300 dark:text-slate-600">info</span>
                                                    <span>Select a Class and Subject to load syllabus chapters</span>
                                                </div>
                                                <div id="quizTopicsLoading"
                                                    class="hidden flex items-center gap-2 text-xs text-slate-400 py-2">
                                                    <span
                                                        class="material-symbols-rounded animate-spin text-base text-primary">progress_activity</span>
                                                    <span>Loading topics…</span>
                                                </div>
                                                <div id="quizTopicsList" class="hidden flex flex-wrap gap-2 mt-2"></div>
                                                <!-- Hidden primary topic input -->
                                                <input type="hidden" name="topic" id="quizPrimaryTopicInput">
                                            </div>

                                            <!-- Sub-topics list -->
                                            <div id="quizSubTopicsSection"
                                                class="hidden mt-3 pt-3 border-t border-slate-200 dark:border-slate-800">
                                                <div class="flex items-center justify-between mb-1">
                                                    <label
                                                        class="text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                                                        <span
                                                            class="material-symbols-rounded text-sm text-indigo-500">subdirectory_arrow_right</span>
                                                        <span>Sub-topic(s) <span
                                                                class="text-slate-400 font-normal">(Optional)</span></span>
                                                    </label>
                                                    <span id="quizSubTopicCountBadge"
                                                        class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 hidden">0
                                                        selected</span>
                                                </div>
                                                <input type="hidden" name="subTopic" id="quizPrimarySubTopicInput">
                                                <div id="quizSubTopicsList" class="flex flex-wrap gap-2 mt-2"></div>
                                            </div>
                                        </div>

                                        <!-- Cross-class auto-sync portal -->
                                        <div id="crossClassSyncPortal"
                                            class="hidden mt-4 p-4 rounded-xl border border-emerald-300/70 dark:border-emerald-700/60 bg-emerald-50/60 dark:bg-emerald-900/15">
                                            <div class="flex items-start gap-2 mb-2">
                                                <span
                                                    class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-lg shrink-0 mt-0.5">sync_alt</span>
                                                <div>
                                                    <p class="text-xs font-bold text-emerald-800 dark:text-emerald-300">
                                                        Auto-Sync Suggested</p>
                                                    <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">The
                                                        same Subject, Chapter & Topic architecture exists in the
                                                        following class(es). Check the classes where this exam should be
                                                        automatically saved:</p>
                                                </div>
                                            </div>
                                            <div id="crossClassListContainer" class="flex flex-wrap gap-2 mt-2"></div>
                                        </div>
                                    </div>

                                    <!-- Creation Strategy (Only in Standard Studio Mode) -->
                                    <div id="strategySection" class="p-4 sm:p-8">
                                        <h3
                                            class="text-[14px] font-bold text-slate-900 dark:text-white tracking-tight mb-4 sm:mb-6 flex items-center gap-2">
                                            <span
                                                class="material-symbols-rounded text-[20px] text-violet-500">design_services</span>
                                            Composition Strategy
                                        </h3>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                            <label id="strategy-manual-label" onclick="toggleStrategy('manual')"
                                                class="p-3.5 rounded-xl border border-blue-500/50 bg-blue-50/20 dark:bg-blue-500/10 flex items-start gap-3 cursor-pointer transition-all active:scale-95 group">
                                                <input type="radio" name="strategy" value="manual" checked
                                                    class="w-4 h-4 mt-0.5 text-primary border-slate-300 focus:ring-primary shrink-0">
                                                <div class="flex flex-col min-w-0">
                                                    <span
                                                        class="text-xs font-semibold text-slate-800 dark:text-slate-200">Manual
                                                        Studio</span>
                                                    <span
                                                        class="text-[10.5px] text-slate-400 dark:text-slate-500 mt-0.5">Create
                                                        empty exam and add questions slot by slot.</span>
                                                </div>
                                            </label>
                                            <label id="strategy-automated-label" onclick="toggleStrategy('automated')"
                                                class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 hover:border-slate-300 dark:hover:border-slate-700 flex items-start gap-3 cursor-pointer transition-all active:scale-95 group">
                                                <input type="radio" name="strategy" value="automated"
                                                    class="w-4 h-4 mt-0.5 text-primary border-slate-300 focus:ring-primary shrink-0">
                                                <div class="flex flex-col min-w-0">
                                                    <span
