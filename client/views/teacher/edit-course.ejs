<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <script> const hasEditAccess = <%= typeof hasEditAccess !== 'undefined' ? hasEditAccess : false %>; </script>
    <title>Course Content | Teacher Hub</title>
    <style>
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
</head>

<body class="bg-[#F8F8FF] dark:bg-[#0b1120] text-slate-700 dark:text-slate-300 font-sans min-h-screen antialiased">
    <div class="flex">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'courses' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 flex flex-col w-full">
            <%- include('header', { pageTitle: 'Course Content' }) %>

            <section class="content-scroll custom-scrollbar flex-1 flex flex-col bg-[#F8F8FF] dark:bg-[#0b1120] border-l-0 lg:border-l border-slate-900/10 dark:border-white/5 pb-20 sm:pb-24 lg:pb-0">
                
                <!-- Tab Headers -->
                <div class="sticky top-0 z-40 border-b border-slate-200 dark:border-white/5 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md px-3 sm:px-6 pt-2.5 sm:pt-4 flex gap-3 sm:gap-6 overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap">
                    <button id="tabBtn-curriculum" onclick="switchTab('curriculum')" class="pb-2.5 sm:pb-3 border-b-2 font-medium text-xs sm:text-[13px] border-primary text-primary transition-colors shrink-0">
                        Curriculum
                    </button>
                    <button id="tabBtn-progress" onclick="switchTab('progress')" class="pb-2.5 sm:pb-3 border-b-2 font-medium text-xs sm:text-[13px] border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors shrink-0">
                        Student Progress
                    </button>
                    <button id="tabBtn-announcements" onclick="switchTab('announcements')" class="pb-2.5 sm:pb-3 border-b-2 font-medium text-xs sm:text-[13px] border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors shrink-0">
                        Announcements
                    </button>
                </div>

                <!-- Tab: Curriculum -->
                <div id="tab-curriculum" class="tab-pane">
                    <div class="p-2.5 sm:p-6">
                        <%- include('curriculum-studio-partial') %>
                    </div>
                </div>

                
                <!-- Tab: Student Progress -->
                <div id="tab-progress" class="tab-pane hidden p-3 sm:p-6 space-y-3.5 sm:space-y-5">
                    <!-- Top Summary & Search -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                        <div class="hidden sm:flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary text-lg sm:text-xl">trending_up</span>
                            <h2 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-white">Student Progress</h2>
                            <span class="px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-medium bg-slate-100 dark:bg-white/10 text-slate-600 dark:text-slate-300">
                                <%= students ? students.length : 0 %>
                            </span>
                        </div>

                        <!-- Quick Search -->
                        <div class="relative w-full sm:w-60">
                            <span class="material-symbols-rounded text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 text-base">search</span>
                            <input type="text" id="studentSearchInput" oninput="filterStudentsList()" placeholder="Search students..."
                                   class="w-full pl-8 pr-3 py-1.5 text-xs rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120] text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-primary transition-all">
                        </div>
                    </div>

                    <!-- Quick Metrics Strip -->
                    <% 
                        const totalStudents = students ? students.length : 0;
                        const avgProgress = totalStudents > 0 ? Math.round(students.reduce((acc, s) => acc + (s.progress || 0), 0) / totalStudents) : 0;
                        const completedCount = students ? students.filter(s => (s.progress || 0) >= 100).length : 0;
                    %>
                    <div class="grid grid-cols-3 gap-2 sm:gap-3">
                        <div class="p-2 sm:p-3 rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120] flex items-center gap-2 sm:gap-2.5 shadow-2xs">
                            <div class="size-7 sm:size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm sm:text-base">groups</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[9px] sm:text-[11px] text-slate-400 font-medium truncate">Enrolled</p>
                                <p class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-white"><%= totalStudents %></p>
                            </div>
                        </div>

                        <div class="p-2 sm:p-3 rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120] flex items-center gap-2 sm:gap-2.5 shadow-2xs">
                            <div class="size-7 sm:size-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm sm:text-base">donut_large</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[9px] sm:text-[11px] text-slate-400 font-medium truncate">Average</p>
                                <p class="text-xs sm:text-sm font-semibold text-emerald-500"><%= avgProgress %>%</p>
                            </div>
                        </div>

                        <div class="p-2 sm:p-3 rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120] flex items-center gap-2 sm:gap-2.5 shadow-2xs">
                            <div class="size-7 sm:size-8 rounded-lg bg-purple-50 dark:bg-purple-500/10 text-purple-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-sm sm:text-base">verified</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[9px] sm:text-[11px] text-slate-400 font-medium truncate">Finished</p>
                                <p class="text-xs sm:text-sm font-semibold text-purple-500"><%= completedCount %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Student Cards (Clean, Compact, No Overcrowding) -->
                    <div class="sm:hidden space-y-2" id="mobileStudentsContainer">
                        <% if (students && students.length > 0) { %>
                            <% students.forEach(student => { 
                                const prog = Math.round(student.progress || 0);
                                const isCompleted = prog >= 100;
                            %>
                                <div class="student-card p-3 rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120] shadow-2xs space-y-2 transition-all"
                                     data-name="<%= student.name.toLowerCase() %>" data-email="<%= (student.email || '').toLowerCase() %>">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <img src="<%= student.profileImage %>" alt="avatar" class="size-7.5 rounded-full object-cover shrink-0 border border-slate-100 dark:border-white/10">
                                            <div class="min-w-0">
                                                <p class="font-medium text-xs text-slate-800 dark:text-white truncate"><%= student.name %></p>
                                                <p class="text-[10px] text-slate-400">
                                                    <%= student.lastAccessed ? 'Active ' + new Date(student.lastAccessed).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : 'Never active' %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1.5 shrink-0">
                                            <% if (student.examAttended && student.examAttended > 0) { %>
                                                <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200/50 dark:border-amber-500/20">
                                                    <%= student.examAttended %> exam
                                                </span>
                                            <% } %>
                                            <span class="text-xs font-bold font-mono <%= isCompleted ? 'text-emerald-500' : 'text-primary' %>">
                                                <%= prog %>%
                                            </span>
                                        </div>
                                    </div>
                                    <div class="h-1.5 w-full bg-slate-100 dark:bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full <%= isCompleted ? 'bg-emerald-500' : 'bg-primary' %> rounded-full transition-all duration-300" style="width: <%= prog %>%"></div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="p-8 text-center bg-white dark:bg-[#0b1120] rounded-xl border border-slate-200/80 dark:border-white/10 text-xs text-slate-400">
                                <span class="material-symbols-rounded text-2xl mb-1 text-slate-300">group_off</span>
                                <p>No students enrolled yet</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Desktop / Tablet Table View -->
                    <div class="hidden sm:block bg-white dark:bg-[#0b1120] border border-slate-200/80 dark:border-white/10 rounded-xl overflow-hidden shadow-2xs">
                        <table class="w-full text-left text-xs" id="desktopStudentsTable">
                            <thead class="bg-slate-50 dark:bg-white/5 border-b border-slate-200/80 dark:border-white/10 text-slate-500 font-semibold">
                                <tr>
                                    <th class="px-4 py-2.5">Student</th>
                                    <th class="px-4 py-2.5">Enrolled</th>
                                    <th class="px-4 py-2.5">Last Active</th>
                                    <th class="px-4 py-2.5 text-center">Exams</th>
                                    <th class="px-4 py-2.5 w-[160px]">Progress</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(student => { 
                                        const prog = Math.round(student.progress || 0);
                                        const isCompleted = prog >= 100;
                                    %>
                                        <tr class="student-row hover:bg-slate-50 dark:hover:bg-white/5 transition-colors"
                                            data-name="<%= student.name.toLowerCase() %>" data-email="<%= (student.email || '').toLowerCase() %>">
                                            <td class="px-4 py-2.5">
                                                <div class="flex items-center gap-2.5">
                                                    <img src="<%= student.profileImage %>" alt="avatar" class="size-7 rounded-full object-cover shrink-0 border border-slate-100 dark:border-white/10">
                                                    <span class="font-medium text-slate-800 dark:text-white truncate"><%= student.name %></span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-2.5 text-slate-500 whitespace-nowrap">
                                                <%= new Date(student.enrolledAt).toLocaleDateString() %>
                                            </td>
                                            <td class="px-4 py-2.5 text-slate-500 whitespace-nowrap">
                                                <%= student.lastAccessed ? new Date(student.lastAccessed).toLocaleDateString() : 'Never' %>
                                            </td>
                                            <td class="px-4 py-2.5 text-center font-medium text-slate-700 dark:text-slate-300">
                                                <%= student.examAttended || 0 %>
                                            </td>
                                            <td class="px-4 py-2.5">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                        <div class="h-full <%= isCompleted ? 'bg-emerald-500' : 'bg-primary' %> rounded-full" style="width: <%= prog %>%"></div>
                                                    </div>
                                                    <span class="text-xs font-semibold font-mono <%= isCompleted ? 'text-emerald-500' : 'text-slate-600 dark:text-slate-300' %> shrink-0"><%= prog %>%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="px-4 py-8 text-center text-xs text-slate-400">
                                            No students enrolled yet.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>


                <!-- Tab: Announcements -->
                <div id="tab-announcements" class="tab-pane hidden p-3 sm:p-6 space-y-3 sm:space-y-4">
                    <!-- Top Bar -->
                    <div class="flex items-center justify-between gap-2.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary text-lg sm:text-xl">campaign</span>
                            <h2 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-white">Announcements</h2>
                            <span class="px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-medium bg-slate-100 dark:bg-white/10 text-slate-600 dark:text-slate-300">
                                <%= typeof announcements !== 'undefined' ? announcements.length : 0 %>
                            </span>
                        </div>
                        <button type="button" onclick="toggleAnnouncementForm()" id="newNoticeBtn"
                                class="px-3 sm:px-3.5 py-1.5 bg-primary hover:bg-primary/95 text-white rounded-xl font-medium text-xs transition-all shadow-sm shadow-primary/20 flex items-center gap-1.5 shrink-0">
                            <span class="material-symbols-rounded text-base">add</span>
                            <span>New Notice</span>
                        </button>
                    </div>

                    <!-- New Announcement Compose Form -->
                    <div id="announcementForm" class="hidden bg-white dark:bg-[#0b1120] border border-slate-200/80 dark:border-white/10 rounded-2xl p-3.5 sm:p-5 shadow-lg shadow-primary/5 space-y-3 animate-fade-in">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-white/5">
                            <span class="text-xs font-semibold text-slate-800 dark:text-white flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-primary text-base">edit_note</span>
                                <span>Create Announcement</span>
                            </span>
                            <button type="button" onclick="toggleAnnouncementForm(false)" class="size-7 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
                                <span class="material-symbols-rounded text-base">close</span>
                            </button>
                        </div>
                        <!-- Inline System Alert for Empty Inputs -->
                        <div id="announcementInlineError" class="hidden px-3 py-2 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-medium flex items-center gap-2 animate-fade-in">
                            <span class="material-symbols-rounded text-base shrink-0">error</span>
                            <span id="announcementInlineErrorText">Please enter both notice title and message details.</span>
                        </div>
                        <div>
                            <input type="text" id="annTitle" oninput="clearAnnouncementFormErrors()" placeholder="Notice Title..." 
                                   class="w-full px-3 py-2 text-xs sm:text-sm border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0f172a] text-slate-800 dark:text-white rounded-xl focus:outline-none focus:border-primary transition-all placeholder-slate-400">
                        </div>
                        <div>
                            <textarea id="annContent" oninput="clearAnnouncementFormErrors()" placeholder="Write your announcement details here..." 
                                      rows="3" class="w-full px-3 py-2 text-xs sm:text-sm border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0f172a] text-slate-800 dark:text-white rounded-xl focus:outline-none focus:border-primary transition-all placeholder-slate-400 resize-none"></textarea>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
                            <label class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300 cursor-pointer select-none">
                                <input type="checkbox" id="annPriority" class="accent-rose-500 size-4 rounded cursor-pointer">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-rose-500 text-sm">priority_high</span>
                                    <span>High Priority Notice</span>
                                </span>
                            </label>
                            <div class="flex items-center justify-end gap-2">
                                <button type="button" onclick="toggleAnnouncementForm(false)" 
                                        class="px-3 py-1.5 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-medium rounded-xl hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                                    Cancel
                                </button>
                                <button type="button" id="postNoticeBtn" onclick="postAnnouncement()" 
                                        class="px-4 py-1.5 bg-primary hover:bg-primary/95 text-white rounded-xl font-semibold text-xs transition-all shadow-sm shadow-primary/20 flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-base">send</span>
                                    <span>Post Notice</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Announcements Feed -->
                    <div class="space-y-2.5">
                        <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
                            <% announcements.forEach(ann => { 
                                const isHigh = ann.priority === 'high';
                            %>
                                <div class="p-3.5 sm:p-4 rounded-xl border <%= isHigh ? 'border-rose-500/40 bg-rose-50/20 dark:bg-rose-950/10' : 'border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0b1120]' %> shadow-2xs relative group transition-all">
                                    <div class="flex items-start justify-between gap-2.5 mb-1.5">
                                        <div class="flex items-center gap-2 min-w-0 flex-wrap">
                                            <% if (isHigh) { %>
                                                <span class="px-1.5 py-0.5 rounded-md bg-rose-500/10 text-rose-500 text-[10px] font-bold border border-rose-500/20 flex items-center gap-1 shrink-0">
                                                    <span class="material-symbols-rounded text-xs">error</span>
                                                    <span>Urgent</span>
                                                </span>
                                            <% } else { %>
                                                <span class="px-1.5 py-0.5 rounded-md bg-blue-50 dark:bg-blue-500/10 text-blue-500 text-[10px] font-medium border border-blue-200/50 dark:border-blue-500/20 flex items-center gap-1 shrink-0">
                                                    <span class="material-symbols-rounded text-xs">campaign</span>
                                                    <span>Notice</span>
                                                </span>
                                            <% } %>
                                            <span class="text-[11px] text-slate-400 dark:text-slate-500">
                                                <%= new Date(ann.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                        <button type="button" onclick="deleteAnnouncement('<%= ann._id %>')" title="Delete Notice"
                                                class="size-7 rounded-lg flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all shrink-0">
                                            <span class="material-symbols-rounded text-base">delete</span>
                                        </button>
                                    </div>
                                    <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-white mb-1 leading-snug"><%= ann.title %></h3>
                                    <p class="text-xs text-slate-600 dark:text-slate-300 whitespace-pre-wrap leading-relaxed"><%= ann.content %></p>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="p-8 text-center bg-white dark:bg-[#0b1120] rounded-xl border border-slate-200/80 dark:border-white/10 text-xs text-slate-400 space-y-1">
                                <span class="material-symbols-rounded text-2xl text-slate-300 dark:text-slate-600">campaign</span>
                                <p class="font-medium text-slate-600 dark:text-slate-300">No announcements yet</p>
                                <p class="text-[11px] text-slate-400">Notices published will appear here for your enrolled students.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <script>
                    function showSystemNotice(text, type = 'error') {
                        if (!text) return;
                        let container = document.getElementById('system-notice-container');
                        if (!container) {
                            container = document.createElement('div');
                            container.id = 'system-notice-container';
                            container.className = 'fixed top-4 left-1/2 -translate-x-1/2 z-[400] pointer-events-none flex flex-col items-center gap-2 max-w-[92vw] w-max';
                            document.body.appendChild(container);
                        }

                        const toast = document.createElement('div');
                        const isError = type === 'error';
                        const isSuccess = type === 'success';

                        const bgClass = isError 
                            ? 'bg-rose-950/95 text-rose-100 border-rose-700/80 shadow-rose-950/40' 
                            : isSuccess 
                                ? 'bg-emerald-950/95 text-emerald-100 border-emerald-700/80 shadow-emerald-950/40'
                                : 'bg-slate-900/95 text-slate-100 border-slate-700/80 shadow-slate-950/40';
                        
                        const iconName = isError ? 'error' : (isSuccess ? 'check_circle' : 'info');
                        const iconColor = isError ? 'text-rose-400' : (isSuccess ? 'text-emerald-400' : 'text-primary');

                        toast.className = `pointer-events-auto px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-2xl border ${bgClass} shadow-xl backdrop-blur-md flex items-center gap-2 text-xs sm:text-sm font-medium transition-all duration-300 transform -translate-y-2 opacity-0 select-none`;
                        toast.innerHTML = `
                            <span class="material-symbols-rounded text-base sm:text-lg leading-none shrink-0 ${iconColor}">${iconName}</span>
                            <span class="leading-snug">${text}</span>
                        `;

                        container.appendChild(toast);

                        requestAnimationFrame(() => {
                            toast.classList.remove('-translate-y-2', 'opacity-0');
                            toast.classList.add('translate-y-0', 'opacity-100');
                        });

                        setTimeout(() => {
                            toast.classList.remove('translate-y-0', 'opacity-100');
                            toast.classList.add('-translate-y-2', 'opacity-0');
                            setTimeout(() => toast.remove(), 320);
                        }, 3500);
                    }

                    function clearAnnouncementFormErrors() {
                        const errorEl = document.getElementById('announcementInlineError');
                        if (errorEl) errorEl.classList.add('hidden');
                        const titleEl = document.getElementById('annTitle');
                        const contentEl = document.getElementById('annContent');
                        if (titleEl) titleEl.classList.remove('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                        if (contentEl) contentEl.classList.remove('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                    }

                    function showInlineAnnouncementError(msg) {
                        const errorEl = document.getElementById('announcementInlineError');
                        const errorText = document.getElementById('announcementInlineErrorText');
                        if (errorEl && errorText) {
                            errorText.innerText = msg;
                            errorEl.classList.remove('hidden');
                        }
                    }

                    function toggleAnnouncementForm(show) {
                        const form = document.getElementById('announcementForm');
                        if (!form) return;
                        clearAnnouncementFormErrors();
                        if (show === undefined) {
                            form.classList.toggle('hidden');
                        } else if (show) {
                            form.classList.remove('hidden');
                        } else {
                            form.classList.add('hidden');
                        }
                        if (!form.classList.contains('hidden')) {
                            const titleInput = document.getElementById('annTitle');
                            if (titleInput) titleInput.focus();
                        }
                    }

                    async function postAnnouncement() {
                        const titleEl = document.getElementById('annTitle');
                        const contentEl = document.getElementById('annContent');
                        const title = (titleEl ? titleEl.value : '').trim();
                        const content = (contentEl ? contentEl.value : '').trim();
                        const priority = document.getElementById('annPriority').checked ? 'high' : 'normal';
                        const postBtn = document.getElementById('postNoticeBtn');
                        
                        clearAnnouncementFormErrors();

                        if (!title || !content) {
                            let msg = 'Please enter both notice title and message details.';
                            if (!title && !content) {
                                msg = 'Please fill in both title and announcement message.';
                                if (titleEl) titleEl.classList.add('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                                if (contentEl) contentEl.classList.add('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                                if (titleEl) titleEl.focus();
                            } else if (!title) {
                                msg = 'Please enter a title for the announcement.';
                                if (titleEl) {
                                    titleEl.classList.add('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                                    titleEl.focus();
                                }
                            } else {
                                msg = 'Please enter the announcement message content.';
                                if (contentEl) {
                                    contentEl.classList.add('border-rose-500', 'dark:border-rose-500', 'ring-2', 'ring-rose-500/20');
                                    contentEl.focus();
                                }
                            }
                            showInlineAnnouncementError(msg);
                            showSystemNotice(msg, 'error');
                            return;
                        }
                        
                        if (postBtn) {
                            postBtn.disabled = true;
                            postBtn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">progress_activity</span><span>Posting...</span>';
                        }
                        
                        try {
                            const res = await fetch(`/teacher/course/<%= course._id %>/announcement`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ title, content, priority })
                            });
                            if (res.ok) {
                                showSystemNotice('Announcement posted successfully!', 'success');
                                setTimeout(() => window.location.reload(), 600);
                            } else {
                                const errData = await res.json().catch(() => ({}));
                                const errMsg = errData.error || 'Failed to post announcement';
                                showInlineAnnouncementError(errMsg);
                                showSystemNotice(errMsg, 'error');
                                if (postBtn) {
                                    postBtn.disabled = false;
                                    postBtn.innerHTML = '<span class="material-symbols-rounded text-base">send</span><span>Post Notice</span>';
                                }
                            }
                        } catch (e) {
                            console.error(e);
                            showSystemNotice('Server error posting announcement', 'error');
                            if (postBtn) {
                                postBtn.disabled = false;
                                postBtn.innerHTML = '<span class="material-symbols-rounded text-base">send</span><span>Post Notice</span>';
                            }
                        }
                    }

                    async function deleteAnnouncement(id) {
                        if (!confirm('Are you sure you want to delete this announcement?')) return;
                        try {
                            const res = await fetch(`/teacher/course/<%= course._id %>/announcement/${id}`, { method: 'DELETE' });
                            if (res.ok) {
                                showSystemNotice('Announcement deleted', 'info');
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                const errData = await res.json().catch(() => ({}));
                                showSystemNotice(errData.error || 'Failed to delete announcement', 'error');
                            }
                        } catch (e) {
                            console.error(e);
                            showSystemNotice('Server error deleting announcement', 'error');
                        }
                    }
                </script>

                <script>
                    function filterStudentsList() {
                        const input = document.getElementById('studentSearchInput');
                        const query = (input ? input.value : '').toLowerCase().trim();
                        document.querySelectorAll('#mobileStudentsContainer .student-card').forEach(card => {
                            const name = card.getAttribute('data-name') || '';
                            const email = card.getAttribute('data-email') || '';
                            card.style.display = (name.includes(query) || email.includes(query)) ? '' : 'none';
                        });
                        document.querySelectorAll('#desktopStudentsTable .student-row').forEach(row => {
                            const name = row.getAttribute('data-name') || '';
                            const email = row.getAttribute('data-email') || '';
                            row.style.display = (name.includes(query) || email.includes(query)) ? '' : 'none';
                        });
                    }

                    function switchTab(tabId) {
                        ['curriculum', 'progress', 'announcements'].forEach(id => {
                            const btn = document.getElementById(`tabBtn-${id}`);
                            if (btn) btn.className = 'pb-2.5 sm:pb-3 border-b-2 font-medium text-xs sm:text-[13px] border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors shrink-0';
                            const pane = document.getElementById(`tab-${id}`);
                            if (pane) pane.classList.add('hidden');
                        });
                        const activeBtn = document.getElementById(`tabBtn-${tabId}`);
                        if (activeBtn) activeBtn.className = 'pb-2.5 sm:pb-3 border-b-2 font-semibold text-xs sm:text-[13px] border-primary text-primary transition-colors shrink-0';
                        const activePane = document.getElementById(`tab-${tabId}`);
                        if (activePane) activePane.classList.remove('hidden');
                        
                        // Save to localStorage
                        if (typeof(Storage) !== "undefined") {
                            localStorage.setItem('editCourseTab_<%= typeof course !== "undefined" ? course._id : "default" %>', tabId);
                        }
                    }

                    // Restore tab on load
                    document.addEventListener('DOMContentLoaded', () => {
                        if (typeof(Storage) !== "undefined") {
                            const savedTab = localStorage.getItem('editCourseTab_<%= typeof course !== "undefined" ? course._id : "default" %>');
                            if (savedTab && ['curriculum', 'progress', 'announcements'].includes(savedTab)) {
                                switchTab(savedTab);
                            }
                        }
                    });
                </script>
            </section>
            <%- include('bottom-nav', { activePage: 'courses' }) %>
        </main>
    </div>
</body>
</html>
