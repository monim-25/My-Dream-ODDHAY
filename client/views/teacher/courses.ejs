<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Assigned Courses | Teacher ODDHAY</title>
    <% 
        // Title Case Helper
        function toTitleCase(str) {
            if (!str) return '';
            const s = String(str);
            return s.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
        }

        // Number Formatter
        function formatNumber(num) {
            if (!num) return 0;
            if (num >= 1000) {
                return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
            }
            return num;
        }

        const totalCoursesCount = courses ? courses.length : 0;
        const freeCount = courses ? courses.filter(c => c.accessType !== 'paid' && c.accessType !== 'Paid').length : 0;
        const paidCount = courses ? courses.filter(c => c.accessType === 'paid' || c.accessType === 'Paid').length : 0;
        const totalStudentsCount = courses ? courses.reduce((acc, c) => acc + (c.studentCount || 0), 0) : 0;
    %>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .admin-sidebar.active { transform: translateX(0); }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'courses' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Assigned Courses' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <!-- SECTION 1: STATS OVERVIEW SECTION (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        
                        <!-- Total Courses Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400">Total Courses</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= totalCoursesCount %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">library_books</span>
                                </div>
                            </div>
                        </div>

                        <!-- Free Access Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Free Access</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400 tracking-tight"><%= freeCount %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">money_off</span>
                                </div>
                            </div>
                        </div>

                        <!-- Premium Batches Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400">Premium Batches</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-amber-600 dark:text-amber-400 tracking-tight"><%= paidCount %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">workspace_premium</span>
                                </div>
                            </div>
                        </div>

                        <!-- Enrolled Students Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400">Enrolled Students</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-purple-600 dark:text-purple-400 tracking-tight"><%= formatNumber(totalStudentsCount) %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">groups</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SECTION 2: STICKY FILTERS BAR (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-4 sm:px-6 py-2.5 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 shadow-2xs">
                    <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
                        
                        <!-- Search Box -->
                        <div class="relative flex-1 min-w-[200px] max-w-sm">
                            <input type="text" id="courseSearch" placeholder="Search assigned courses..." 
                                   class="w-full pl-3 pr-9 h-9 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-all">
                            <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
                        </div>

                        <!-- Class Filter Dropdown -->
                        <div class="relative w-40">
                            <select onchange="updateCourseFilter('class', this.value)" 
                                    class="w-full h-9 pl-3 pr-8 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100">
                                <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                <% assignedClasses.forEach(c => { %>
                                    <option value="<%= c %>" <%= filters.class === c ? 'selected' : '' %>><%= c %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Matches Counter -->
                        <div class="h-9 px-3 rounded-lg bg-primary/10 border border-primary/20 flex items-center">
                            <span class="text-xs font-bold text-primary"><span id="visibleCount"><%= courses.length %></span> Courses</span>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: COURSES GRID -->
                <div class="p-4 sm:p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="coursesGrid">
                        <% if (courses && courses.length > 0) { %>
                            <% courses.forEach(course => { %>
                                <div class="course-item group flex flex-col rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 shadow-2xs hover:shadow-md transition-all duration-200 overflow-hidden" 
                                     data-title="<%= course.title ? course.title.toLowerCase() : '' %>">
                                    
                                    <!-- Thumbnail -->
                                    <a href="/teacher/course/<%= course._id %>" class="block w-full aspect-video bg-slate-100 dark:bg-slate-800/60 relative overflow-hidden border-b border-slate-100 dark:border-slate-800/60">
                                        <% if (course.thumbnail) { %>
                                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="hidden w-full h-full items-center justify-center text-slate-300 dark:text-slate-600">
                                                <span class="material-symbols-rounded text-5xl">auto_stories</span>
                                            </div>
                                        <% } else { %>
                                            <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-600">
                                                <span class="material-symbols-rounded text-5xl">auto_stories</span>
                                            </div>
                                        <% } %>

                                        <!-- Badge Over Thumbnail -->
                                        <div class="absolute top-2.5 right-2.5">
                                            <% if (course.accessType === 'paid' || course.accessType === 'Paid') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-500/90 text-white text-[10px] font-bold shadow-xs backdrop-blur-xs flex items-center gap-1">
                                                    <span class="material-symbols-rounded text-xs">workspace_premium</span> Premium
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-600/90 text-white text-[10px] font-bold shadow-xs backdrop-blur-xs flex items-center gap-1">
                                                    <span class="material-symbols-rounded text-xs">money_off</span> Free
                                                </span>
                                            <% } %>
                                        </div>
                                    </a>

                                    <!-- Content -->
                                    <div class="p-4 flex-1 flex flex-col justify-between">
                                        <div>
                                            <!-- Class and Subject Badges -->
                                            <div class="flex flex-wrap items-center gap-1.5 mb-2">
                                                <% const classes = Array.isArray(course.classLevel) && course.classLevel.length ? course.classLevel : (course.classLevel ? [course.classLevel] : ['General']); %>
                                                <% classes.forEach(c => { %>
                                                    <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-semibold border border-slate-200/60 dark:border-slate-700/60"><%= c %></span>
                                                <% }) %>

                                                <% const subjects = Array.isArray(course.subject) && course.subject.length ? course.subject : (course.subject ? [course.subject] : ['General']); %>
                                                <% subjects.forEach(s => { %>
                                                    <span class="px-2 py-0.5 rounded-md bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 text-[10px] font-semibold border border-blue-200/60 dark:border-blue-900/60"><%= toTitleCase(s) %></span>
                                                <% }) %>
                                            </div>

                                            <h4 class="text-sm font-bold text-slate-900 dark:text-white line-clamp-2 leading-snug mb-1.5">
                                                <a href="/teacher/course/<%= course._id %>" class="hover:text-primary transition-colors">
                                                    <%= course.title || 'Untitled Course' %>
                                                </a>
                                            </h4>

                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-3">
                                                <%= course.description ? course.description.replace(/(<([^>]+)>)/gi, "") : 'Course materials, recorded sessions, and assignments for your class.' %>
                                            </p>
                                        </div>

                                        <!-- Footer: Students & Manage Button -->
                                        <div class="pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between gap-2 mt-auto">
                                            <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400" title="Enrolled Students">
                                                <span class="material-symbols-rounded text-base text-slate-400">group</span>
                                                <span class="text-xs font-bold text-slate-700 dark:text-slate-300"><%= formatNumber(course.studentCount) %></span>
                                            </div>

                                            <a href="/teacher/course/<%= course._id %>" 
                                               class="px-3.5 py-1.5 rounded-lg bg-primary hover:bg-blue-600 text-white text-xs font-bold transition-all shadow-2xs flex items-center gap-1">
                                                <span>Manage</span>
                                                <span class="material-symbols-rounded text-sm">chevron_right</span>
                                            </a>
                                        </div>

                                    </div>

                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-span-full py-20 text-center bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-2xs">
                                <span class="material-symbols-rounded text-5xl text-slate-300 dark:text-slate-700 mb-3">auto_stories</span>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">No courses assigned</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Please contact administration to assign courses to your profile.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('active');
        }

        function updateCourseFilter(key, value) {
            const params = new URLSearchParams(window.location.search);
            if (value === 'all') {
                params.delete(key);
            } else {
                params.set(key, value);
            }
            window.location.href = '?' + params.toString();
        }

        // Live frontend search
        const searchInput = document.getElementById('courseSearch');
        const countSpan = document.getElementById('visibleCount');
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                const term = e.target.value.toLowerCase().trim();
                const items = document.querySelectorAll('.course-item');
                let visible = 0;
                items.forEach(item => {
                    const title = item.getAttribute('data-title') || '';
                    if (!term || title.includes(term)) {
                        item.style.display = '';
                        visible++;
                    } else {
                        item.style.display = 'none';
                    }
                });
                if (countSpan) countSpan.textContent = visible;
            });
        }
    </script>
</body>
</html>
