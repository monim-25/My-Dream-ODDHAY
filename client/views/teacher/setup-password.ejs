<!DOCTYPE html>
<html lang="en" class="<%= (typeof user !== 'undefined' && user && user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Set Up Password | ODDHAY Teacher Hub</title>
</head>
<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans min-h-screen flex items-center justify-center p-3 sm:p-6 selection:bg-primary/20">

    <div class="max-w-md w-full bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xl overflow-hidden transition-all my-auto">
        <!-- Top Security Stripe -->
        <div class="h-1.5 bg-gradient-to-r from-blue-600 via-indigo-600 to-primary"></div>

        <div class="p-5 sm:p-7 space-y-4 sm:space-y-5">
            <!-- Header -->
            <div class="flex items-center gap-3">
                <div class="size-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 border border-primary/20 shadow-xs">
                    <span class="material-symbols-rounded text-2xl">lock_reset</span>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-primary bg-primary/10 px-2 py-0.5 rounded-full">Step 1 of 2</span>
                        <span class="text-[11px] text-slate-400">Account Security</span>
                    </div>
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white tracking-tight mt-0.5">
                        Set Up Your Password
                    </h1>
                </div>
            </div>

            <!-- Concise Security Alert Banner -->
            <div class="p-3 sm:p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-start gap-2.5 text-xs text-amber-900 dark:text-amber-200">
                <span class="material-symbols-rounded text-lg text-amber-600 dark:text-amber-400 shrink-0 mt-0.5">security</span>
                <p class="leading-relaxed text-[11.5px] font-medium">
                    This is your first login. Set a private, secure password of your choice to protect your instructor account and proceed.
                </p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center gap-2">
                    <span class="material-symbols-rounded text-base text-rose-500 shrink-0">error</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Password Setup Form -->
            <form action="/teacher/setup-password" method="POST" onsubmit="return validatePasswords(event)" class="space-y-3.5 sm:space-y-4">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <!-- New Password Field -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        New Password <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">key</span>
                        <input type="password" id="newPassword" name="newPassword" required minlength="6" placeholder="At least 6 characters"
                               class="w-full h-10 pl-9 pr-10 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-primary transition-all">
                        <button type="button" onclick="togglePassVisibility('newPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                            <span class="material-symbols-rounded text-base">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Confirm New Password <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">lock</span>
                        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="Re-type new password"
                               class="w-full h-10 pl-9 pr-10 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 outline-none focus:border-primary transition-all">
                        <button type="button" onclick="togglePassVisibility('confirmPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                            <span class="material-symbols-rounded text-base">visibility</span>
                        </button>
                    </div>
                    <p id="matchError" class="hidden text-[11px] text-rose-500 mt-1 flex items-center gap-1 font-medium">
                        <span class="material-symbols-rounded text-xs">close</span> Passwords do not match.
                    </p>
                </div>

                <!-- Requirement Hint -->
                <div class="text-[11px] text-slate-400 dark:text-slate-500 flex items-center gap-1.5 pt-0.5">
                    <span class="material-symbols-rounded text-sm text-emerald-500">check_circle</span>
                    <span>Minimum 6 characters, combinations of letters and numbers recommended.</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnSubmitPassword"
                        class="w-full h-10 rounded-lg bg-primary hover:bg-primary/90 text-white text-xs font-semibold shadow-xs transition-all flex items-center justify-center gap-2 mt-2 cursor-pointer active:scale-98">
                    <span>Save Password & Continue</span>
                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                </button>
            </form>
        </div>

        <!-- Footer Notice -->
        <div class="px-5 py-3 bg-slate-50 dark:bg-slate-900/60 border-t border-slate-100 dark:border-slate-800 text-center">
            <p class="text-[11px] text-slate-400">
                Logged in as <strong class="text-slate-600 dark:text-slate-300 font-semibold"><%= (typeof user !== 'undefined' && user) ? user.name : 'Teacher' %></strong> (<%= (typeof user !== 'undefined' && user) ? user.email : '' %>)
            </p>
        </div>
    </div>

    <script>
        function togglePassVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-rounded');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function validatePasswords(e) {
            const p1 = document.getElementById('newPassword').value;
            const p2 = document.getElementById('confirmPassword').value;
            const matchError = document.getElementById('matchError');
            if (p1 !== p2) {
                e.preventDefault();
                matchError.classList.remove('hidden');
                return false;
            }
            matchError.classList.add('hidden');

            const btn = document.getElementById('btnSubmitPassword');
            btn.innerHTML = '<span class="material-symbols-rounded text-sm animate-spin">progress_activity</span> Updating...';
            btn.style.pointerEvents = 'none';
            return true;
        }
    </script>
</body>
</html>
