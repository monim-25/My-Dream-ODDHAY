        function toggleQuizQuestionBangla(qid) {
            const q = questionsData.find(x => x._id === qid);
            if (q && q.isAutoGenerated) return;
            const hidden = document.getElementById(`isBangla-${qid}`);
            const next = hidden ? hidden.value !== 'true' : !globalQuizIsBangla;
            applyQuestionLanguage(qid, next, true);
        }
        window.toggleQuizQuestionBangla = toggleQuizQuestionBangla;

        async function saveCard(qid, type, isManual = false) {
            const q = questionsData.find(x => x._id === qid);
            if (q && q.isAutoGenerated) return;

            if (debounceTimers[qid]) {
                clearTimeout(debounceTimers[qid]);
                delete debounceTimers[qid];
            }
            pendingSaves.delete(qid);

            const data = extractCardData(qid, type);
            setCardStatus(qid, 'saving');
            setAutoSaveStatus('saving');

            try {
                const response = await fetch(`/teacher/quiz/${quizId}/question/${qid}/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (res && res.success) {
                    setCardStatus(qid, 'saved');
                    if (pendingSaves.size === 0) {
                        setAutoSaveStatus('saved');
                    }
                    if (isManual) {
                        const card = document.getElementById(`q-${qid}`);
                        if (card) {
                            card.classList.add('blink-effect');
                            setTimeout(() => card.classList.remove('blink-effect'), 500);
                        }
                    }
                } else {
                    setCardStatus(qid, 'error');
                    setAutoSaveStatus('error');
                    if (isManual) Swal.fire('Error', res.error || 'Update failed', 'error');
                }
            } catch (err) {
                setCardStatus(qid, 'error');
                setAutoSaveStatus('error');
                if (isManual) Swal.fire('Error', 'Network error', 'error');
            }
        }

        function queueAutoSave(qid, type) {
            const q = questionsData.find(x => x._id === qid);
            if (q && q.isAutoGenerated) return;

            setCardStatus(qid, 'saving');
            setAutoSaveStatus('saving');
            pendingSaves.add(qid);

            if (debounceTimers[qid]) {
                clearTimeout(debounceTimers[qid]);
            }
            debounceTimers[qid] = setTimeout(() => {
                saveCard(qid, type, false);
            }, 600);
        }

        function attachCardAutoSave(card, qid, type) {
            if (!card || card.getAttribute('data-auto-generated') === 'true') return;
            card.querySelectorAll('input, textarea, select').forEach(el => {
                el.addEventListener('input', () => queueAutoSave(qid, type));
                el.addEventListener('change', () => queueAutoSave(qid, type));
                el.addEventListener('blur', () => {
                    if (debounceTimers[qid]) {
                        saveCard(qid, type, false);
                    }
                });
            });
        }
        window.attachCardAutoSave = attachCardAutoSave;

        function initAutoSave() {
            questionsData.forEach(q => {
                if (q.isAutoGenerated) return;
                const card = document.getElementById(`q-${q._id}`);
                if (!card) return;
                attachCardAutoSave(card, q._id, q.questionType || 'MCQ');
            });

            // Flush any pending save before leaving / reloading page
            window.addEventListener('beforeunload', () => {
                pendingSaves.forEach(qid => {
                    const q = questionsData.find(x => x._id === qid);
                    if (q && !q.isAutoGenerated) {
                        const data = extractCardData(qid, q.questionType || 'MCQ');
                        navigator.sendBeacon(
                            `/teacher/quiz/${quizId}/question/${qid}/edit`,
                            new Blob([JSON.stringify(data)], { type: 'application/json' })
                        );
                    }
                });
            });
        }

        async function launchQuiz() {
            const updates = [];
            for (let i = 0; i < questionsData.length; i++) {
                const q = questionsData[i];
                const qid = q._id;
                const type = q.questionType;
                
                // If this is an auto-generated bank question, it's non-editable and already saved
                if (q.isAutoGenerated) {
                    continue;
                }
                
                // Marks Validation
                const marksVal = document.getElementById(`marks-${qid}`).value;
                if (!marksVal || marksVal.trim() === '') {
                    document.getElementById(`marks-${qid}`).focus();
                    document.getElementById(`marks-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }
                
                const isB = document.getElementById(`isBangla-${qid}`)?.value === 'true';
                const data = { 
                    questionType: type,
                    isBangla: isB,
                    language: isB ? 'bn' : 'en',
                    marks: parseInt(marksVal),
                    chapter: (document.getElementById(`chapter-${qid}`) ? document.getElementById(`chapter-${qid}`).value.trim() : '') || globalQuizChapter || '',
                    topic: (document.getElementById(`topic-${qid}`) ? document.getElementById(`topic-${qid}`).value.trim() : '') || globalQuizTopic || '',
                    subTopic: (document.getElementById(`subtopic-${qid}`) ? document.getElementById(`subtopic-${qid}`).value.trim() : '') || globalQuizSubTopic || '',
                    board: document.getElementById(`board-${qid}`).value.trim(),
                    year: document.getElementById(`year-${qid}`).value.trim()
                };
                
                const explainEl = document.getElementById(`explain-${qid}`);
                if (explainEl) {
                    data.explanation = explainEl.value.trim();
                }

                if (type === 'MCQ' || !type) {
                    data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                    data.options = [
                        document.getElementById(`optA-${qid}`).value.trim(),
                        document.getElementById(`optB-${qid}`).value.trim(),
                        document.getElementById(`optC-${qid}`).value.trim(),
                        document.getElementById(`optD-${qid}`).value.trim()
                    ];
                    data.correctAnswer = parseInt(document.getElementById(`correct-${qid}`).value);

                    if (!data.questionText) {
                        document.getElementById(`qtext-${qid}`).focus();
                        document.getElementById(`qtext-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    const filledOptions = data.options.filter(o => o !== '');
                    if (filledOptions.length < 3) {
                        const emptyInput = ['optA', 'optB', 'optC'].map(id => document.getElementById(`${id}-${qid}`)).find(el => el && !el.value.trim());
                        if (emptyInput) {
                            emptyInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            emptyInput.focus();
                            emptyInput.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
                            setTimeout(() => emptyInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500'), 3000);
                        }
                        return;
                    }
                    if (data.options[data.correctAnswer] === '') {
                        const optIds = ['optA', 'optB', 'optC', 'optD'];
                        const selEl = document.getElementById(`${optIds[data.correctAnswer]}-${qid}`);
                        if (selEl) {
                            selEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            selEl.focus();
                            selEl.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
                            setTimeout(() => selEl.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500'), 3000);
                        } else {
                            document.getElementById(`correct-${qid}`).focus();
                        }
                        return;
                    }
                } else if (type === 'Short' || type === 'Medium') {
                    data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                    data.answer = document.getElementById(`ans-${qid}`).value.trim();

                    if (!data.questionText) {
                        document.getElementById(`qtext-${qid}`).focus();
                        document.getElementById(`qtext-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.answer) {
                        document.getElementById(`ans-${qid}`).focus();
                        document.getElementById(`ans-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                } else if (type === 'Comprehension') {
                    data.context = document.getElementById(`context-${qid}`)?.value.trim() || '';
                    data.q1 = document.getElementById(`q1-${qid}`)?.value.trim() || '';
                    data.q2 = document.getElementById(`q2-${qid}`)?.value.trim() || '';
                    data.q3 = document.getElementById(`q3-${qid}`)?.value.trim() || '';
                    data.q4 = document.getElementById(`q4-${qid}`)?.value.trim() || '';
                    data.a1 = document.getElementById(`a1-${qid}`)?.value.trim() || '';
                    data.a2 = document.getElementById(`a2-${qid}`)?.value.trim() || '';
                    data.a3 = document.getElementById(`a3-${qid}`)?.value.trim() || '';
                    data.a4 = document.getElementById(`a4-${qid}`)?.value.trim() || '';
                    data.s1 = document.getElementById(`s1-${qid}`)?.value.trim() || '';
                    data.s2 = document.getElementById(`s2-${qid}`)?.value.trim() || '';
                    data.s3 = document.getElementById(`s3-${qid}`)?.value.trim() || '';
                    data.s4 = document.getElementById(`s4-${qid}`)?.value.trim() || '';
                    data.solution1 = data.s1;
                    data.solution2 = data.s2;
                    data.solution3 = data.s3;
                    data.solution4 = data.s4;

                    if (!data.context) {
                        document.getElementById(`context-${qid}`).focus();
                        document.getElementById(`context-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q1) {
                        document.getElementById(`q1-${qid}`).focus();
                        document.getElementById(`q1-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a1) {
                        document.getElementById(`a1-${qid}`).focus();
                        document.getElementById(`a1-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q2) {
                        document.getElementById(`q2-${qid}`).focus();
                        document.getElementById(`q2-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a2) {
                        document.getElementById(`a2-${qid}`).focus();
                        document.getElementById(`a2-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q3) {
                        document.getElementById(`q3-${qid}`).focus();
                        document.getElementById(`q3-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a3) {
                        document.getElementById(`a3-${qid}`).focus();
                        document.getElementById(`a3-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q4) {
                        document.getElementById(`q4-${qid}`).focus();
                        document.getElementById(`q4-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a4) {
                        document.getElementById(`a4-${qid}`).focus();
                        document.getElementById(`a4-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                }
                
                updates.push({ qid, data });
            }
            
            // Show loading during autosave and deploy
            Swal.fire({
                title: 'Deploying Quiz...',
                text: 'Autosaving and launching your assessment.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                // Post all question updates in parallel
                await Promise.all(updates.map(item => {
                    return fetch(`/teacher/quiz/${quizId}/question/${item.qid}/edit`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(item.data)
                    });
                }));

                // Publish quiz (transitions draft exam to proper live exam)
                await fetch(`/teacher/quiz/${quizId}/publish`, { method: 'POST' });

                // Redirect on success
                Swal.fire({
                    title: 'Success',
                    text: 'Quiz Launched & Published!',
                    icon: 'success',
                    timer: 1000,
                    showConfirmButton: false
                }).then(() => {
                    if (currentCourseId) {
                        window.location.href = `/teacher/course/${currentCourseId}/edit?quizCreatedId=${quizId}`;
                    } else {
                        window.location.href = '/teacher/quizzes';
                    }
                });
            } catch (err) {
                Swal.fire('Error', 'Failed to autosave questions before launching.', 'error');
            }
        }

        async function deleteQuestion(qid) {
            const card = document.getElementById(`q-${qid}`);
            if (card) {
                card.style.transition = 'all 0.25s ease';
                card.style.opacity = '0';
                card.style.transform = 'translateY(-8px)';
                setTimeout(() => {
                    card.remove();
                    reindexQuestions();
                }, 250);
            }
            if (debounceTimers[qid]) {
                clearTimeout(debounceTimers[qid]);
                delete debounceTimers[qid];
            }
            pendingSaves.delete(qid);
            const qIdx = questionsData.findIndex(x => x._id === qid);
            if (qIdx !== -1) questionsData.splice(qIdx, 1);

            try {
                const response = await fetch(`/teacher/quiz/${quizId}/question/${qid}/delete`, { method: 'POST' });
                const resJson = await response.json();
                if (!resJson.success) {
                    console.error('Failed to delete question:', resJson.error);
                }
            } catch (err) {
                console.error('Failed to delete question:', err);
            }
        }

        function openBulkModal() {
            Swal.fire({
                title: 'Bulk Import Questions',
                html: `
                    <div class="text-left space-y-2">
                        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Format: Question ### Opt1 ### Opt2 ### Opt3 ### Opt4 ### CorrectIndex(0-3) ### Explanation</p>
                        <textarea id="swal-bulk" class="w-full p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-xs font-mono outline-none focus:border-primary" rows="8" placeholder="Example: What is capital of BD? ### Dhaka ### Chittagong ### Sylhet ### Rajshahi ### 0 ### Dhaka is capital"></textarea>
                    </div>
                `,
                width: Math.min(720, window.innerWidth - 24) + 'px',
                showCancelButton: true,
                confirmButtonText: 'Import Questions',
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#94a3b8'
            }).then(result => {
                if(result.isConfirmed) {
                    const raw = document.getElementById('swal-bulk').value;
                    processBulk(raw);
                }
            });
        }

        async function processBulk(raw) {
            const lines = raw.split('\n').filter(l => l.trim().includes('###'));
            if(lines.length === 0) return;
            
            Swal.fire({ title: 'Processing Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            let count = 0;
            for(const line of lines) {
                const parts = line.split('###').map(p => p.trim());
                if(parts.length < 6) continue;
                const data = {
                    questionText: parts[0],
                    options: [parts[1], parts[2], parts[3], parts[4]],
                    correctAnswer: parseInt(parts[5]),
                    explanation: parts[6] || ''
                };
                await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                count++;
            }
            Swal.fire('Success', `${count} Vectors Deployed`, 'success').then(() => location.reload());
        }

