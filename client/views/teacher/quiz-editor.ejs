        async function saveQuestion(data) {
            try {
                const response = await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (res.success) {
                    const newQuestions = res.questions && res.questions.length ? res.questions : (res.question ? [res.question] : []);
                    const feed = document.getElementById('questions-feed');
                    const emptyState = document.getElementById('no-questions-placeholder');
                    if (emptyState) emptyState.remove();

                    const isBanglaNow = isQuizBanglaSet();
                    let firstNewCard = null;
                    newQuestions.forEach(newQ => {
                        newQ.isBangla = isBanglaNow;
                        newQ.language = isBanglaNow ? 'bn' : 'en';
                        questionsData.push(newQ);
                        const currentIndex = questionsData.length - 1;
                        const cardHTML = renderQuestionCardHTML(newQ, currentIndex);

                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = cardHTML.trim();
                        const newCard = tempDiv.firstElementChild;
                        if (feed && newCard) {
                            feed.appendChild(newCard);
                            attachCardAutoSave(newCard, newQ._id, newQ.questionType || 'MCQ');
                            populateCardTopicDropdowns(newQ._id);
                            applyQuestionLanguage(newQ._id, isBanglaNow, false);
                            if (!firstNewCard) firstNewCard = newCard;
                        }
                    });

                    reindexQuestions();
                    if (firstNewCard) {
                        firstNewCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } else {
                    Swal.fire('Error', res.error || 'Failed to deploy question', 'error');
                }
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function handleAddSlots() {
            const countInput = document.getElementById('bulkAddCount');
            const typeSelect = document.getElementById('bulkAddType');
            const count = Math.min(Math.max(parseInt(countInput ? countInput.value : 1) || 1, 1), 50);
            const type = typeSelect ? typeSelect.value : 'MCQ';

            const btn = document.getElementById('btnAddSlots');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">sync</span><span>Adding...</span>';
            }

            const isBanglaNow = isQuizBanglaSet();
            let data = { 
                questionType: type, 
                isSlot: true, 
                count: count,
                isBangla: isBanglaNow,
                language: isBanglaNow ? 'bn' : 'en'
            };
            if (type === 'MCQ') {
                data.questionText = '';
                data.options = ['', '', '', ''];
                data.correctAnswer = 0;
            } else if (type === 'Short') {
                data.questionText = '';
                data.answer = '';
                data.explanation = '';
            } else if (type === 'Medium') {
                data.questionText = '';
                data.answer = '';
            } else if (type === 'Comprehension') {
                data.questionText = '';
                data.context = '';
                data.q1 = '';
                data.q2 = '';
                data.q3 = '';
                data.q4 = '';
                data.a1 = '';
                data.a2 = '';
                data.a3 = '';
                data.a4 = '';
            }
            
            if (type === 'Medium') data.marks = 2;
            else if (type === 'Comprehension') data.marks = 10;
            else data.marks = 1;

            try {
                const response = await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (res.success) {
                    const newQuestions = res.questions && res.questions.length ? res.questions : (res.question ? [res.question] : []);
                    const feed = document.getElementById('questions-feed');
                    const emptyState = document.getElementById('no-questions-placeholder');
                    if (emptyState) emptyState.remove();

                    let firstNewCard = null;
                    newQuestions.forEach(newQ => {
                        newQ.isBangla = isBanglaNow;
                        newQ.language = isBanglaNow ? 'bn' : 'en';
                        questionsData.push(newQ);
                        const currentIndex = questionsData.length - 1;
                        const cardHTML = renderQuestionCardHTML(newQ, currentIndex);

                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = cardHTML.trim();
                        const newCard = tempDiv.firstElementChild;
                        if (feed && newCard) {
                            feed.appendChild(newCard);
                            attachCardAutoSave(newCard, newQ._id, newQ.questionType || type);
                            populateCardTopicDropdowns(newQ._id);
                            applyQuestionLanguage(newQ._id, isBanglaNow, false);
                            if (!firstNewCard) firstNewCard = newCard;
                        }
                    });

                    reindexQuestions();
                    if (firstNewCard) {
                        firstNewCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } else {
                    Swal.fire('Error', res.error || 'Failed to add slot', 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Network error', 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span class="material-symbols-rounded text-base">add</span><span>Add slot</span>';
                }
            }
        }
        window.handleAddSlots = handleAddSlots;

