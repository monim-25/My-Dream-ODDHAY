<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title><%= quiz.title %> | Teacher Assessment Studio</title>
    <style>
        :root { --sidebar-width: 260px; }
        .studio-main { margin-left: var(--sidebar-width); min-height: 100vh; }
        .studio-container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
        
        .q-card { 
            background: white; 
            border-radius: 0.5rem; 
            padding: 24px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        }
        .dark .q-card { background: #0f172a; }
        .q-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); }
        
        .option-dot {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 900;
            background: #f8fafc;
            color: #64748b;
            border: 1px solid #e2e8f0;
            transition: all 0.2s;
        }
        .dark .option-dot { background: #1e293b; color: #94a3b8; border-color: #334155; }
        .option-dot.correct { background: #10b981; color: white; border-color: #10b981; box-shadow: 0 6px 15px rgba(16, 185, 129, 0.25); }

        .btn-action {
            height: 38px;
            padding: 0 18px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        
        .stat-card {
            background: white;
            border: 1px solid #9D9CA3;
            border-radius: 0.5rem;
            padding: 4px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .dark .stat-card { background: #0f172a; border-color: #475569; }
        
        .stat-card-inner {
            border: 1px solid #f1f5f9;
            border-radius: 0.125rem;
            padding: 16px;
            background: white;
            display: flex;
            align-items: center;
            gap: 16px;
            width: 100%;
            height: 100%;
        }
        .dark .stat-card-inner { background: #0f172a; border-color: rgba(255,255,255,0.05); }

        .swal2-container { z-index: 9999 !important; }
        .swal2-popup { border-radius: 2rem !important; padding: 2rem !important; }
        .swal2-title { font-weight: 900 !important; tracking: -0.02em !important; }
        
        .form-label { font-size: 12px; font-weight: 700; color: #000000; margin-bottom: 0.5rem; display: block; }
        .dark .form-label { color: #ffffff; }
        .form-input { width: 100%; height: 42px; padding: 0.5rem 1rem; font-size: 8px; font-weight: 500; color: #334155 !important; background: #F7F8FA !important; border: none !important; border-radius: 0.5rem !important; outline: none; transition: all 0.2s ease; box-shadow: inset 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
        .dark .form-input { background: #1e293b; color: #f1f5f9; }
        textarea.form-input { height: auto; }
        .form-input::placeholder { color: #94a3b8; font-weight: 500; opacity: 0.8; font-size: 12px; }
        .form-input:focus { background: #e2e8f0; }
        .dark .form-input:focus { background: #334155; }

        @keyframes card-blink {
            0% { background-color: transparent; }
            50% { background-color: rgba(16, 185, 129, 0.1); } /* Emerald green tint */
            100% { background-color: transparent; }
        }
        .blink-effect {
            animation: card-blink 0.5s ease-in-out;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased">
    <div class="flex">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: active || 'quizzes' }) %>
        </aside>

        <main class="studio-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { 
                pageTitle: `
                    <div class="flex flex-col">
                        <h1 class="text-xl font-black text-slate-900 dark:text-white tracking-tight leading-none">${quiz.title}</h1>
                    </div>
                `, 
                user: user,
                extraContent: `
                    <div class="flex items-center gap-3">
                        <button onclick="openBulkModal()" class="h-10 px-5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-black text-[10px] uppercase tracking-widest hover:bg-slate-200 transition-all">
                            Matrix Import
                        </button>
                        <button onclick="openAddModal()" class="h-10 px-6 bg-black dark:bg-white text-white dark:text-black rounded-xl font-black text-[10px] uppercase tracking-widest flex items-center gap-2 hover:opacity-90 transition-all shadow-xl shadow-black/10 active:scale-95">
                            <span class="material-symbols-rounded text-[18px]">add_circle</span> New Vector
                        </button>
                    </div>
                `
            }) %>

            <div class="studio-container space-y-10">
                <!-- Metrics Bar -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="stat-card">
                        <div class="stat-card-inner">
                            <div class="size-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                                <span class="material-symbols-rounded text-2xl">layers</span>
                            </div>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Total Questions</p>
                                <h3 class="text-xl font-black leading-none" id="total-count"><%= quiz.questions.length %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-inner">
                            <div class="size-12 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                                <span class="material-symbols-rounded text-2xl">timer</span>
                            </div>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Time Limit</p>
                                <h3 class="text-xl font-black leading-none"><%= quiz.duration %> Min</h3>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-inner">
                            <div class="size-12 rounded-2xl bg-amber-500/10 flex items-center justify-center text-amber-500">
                                <span class="material-symbols-rounded text-2xl">verified_user</span>
                            </div>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Access Logic</p>
                                <h3 class="text-xl font-black leading-none"><%= quiz.accessType %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Feed -->
                <div class="space-y-6" id="questions-feed">
                    <% quiz.questions.forEach((q, index) => { %>
                        <div class="q-card group animate-in fade-in slide-in-from-bottom-4 duration-500" id="q-<%= q._id %>" style="animation-delay: <%= index * 50 %>ms">
                            <div class="flex items-start justify-between mb-8">
                                <div class="flex items-center gap-3">
                                    <div class="size-11 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-[14px] font-black text-slate-500">
                                        #<%= index + 1 %>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[11px] font-black text-emerald-500 uppercase tracking-widest"><%= q.questionType || 'MCQ' %></span>
                                        <span class="text-[12px] font-bold text-slate-500">Enter <%= q.questionType || 'MCQ' %></span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 ml-auto mr-4 text-[11px] font-bold text-slate-700">
                                    <div class="flex items-center gap-1">
                                        <span>Mark:</span>
                                        <% 
                                            let defaultMarks = 1;
                                            if (q.questionType === 'Medium') defaultMarks = 2;
                                            if (q.questionType === 'Comprehension') defaultMarks = 7;
                                        %>
                                        <input type="number" id="marks-<%= q._id %>" value="<%= (q.marks !== undefined && q.marks !== null) ? q.marks : defaultMarks %>" class="form-input w-12" style="height: 32px !important; padding: 0 0.5rem; text-align: center;">
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <span>Board:</span>
                                        <input type="text" id="board-<%= q._id %>" value="<%= q.board || '' %>" class="form-input w-20" style="height: 32px !important; padding: 0 0.5rem;" placeholder="Board">
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <span>Year:</span>
                                        <input type="text" id="year-<%= q._id %>" value="<%= q.year || '' %>" class="form-input w-16" style="height: 32px !important; padding: 0 0.5rem;" placeholder="Year">
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button onclick="editQuestion('<%= q._id %>')" class="btn-action bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black">
                                        <span class="material-symbols-rounded text-[18px]">edit_note</span> Edit
                                    </button>
                                    <button onclick="deleteQuestion('<%= q._id %>')" class="btn-action bg-rose-50 dark:bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white border border-rose-100 dark:border-rose-500/20">
                                        <span class="material-symbols-rounded text-[18px]">delete_sweep</span> Delete
                                    </button>
                                </div>
                            </div>

                            <% if (q.questionType === 'MCQ' || !q.questionType) { %>
                                <div class="space-y-4">
                                    <div>
                                        <label class="form-label">Question Text</label>
                                        <textarea id="qtext-<%= q._id %>" class="form-input w-full" rows="2" placeholder="<%= q.questionText.startsWith('New ') ? 'Enter Question..' : q.questionText %>"><%= q.questionText.startsWith('New ') ? '' : q.questionText %></textarea>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div><label class="form-label">Option A</label><input type="text" id="optA-<%= q._id %>" value="<%= q.options[0] && q.options[0].startsWith('Option ') ? '' : q.options[0] || '' %>" placeholder="Option A" class="form-input"></div>
                                        <div><label class="form-label">Option B</label><input type="text" id="optB-<%= q._id %>" value="<%= q.options[1] && q.options[1].startsWith('Option ') ? '' : q.options[1] || '' %>" placeholder="Option B" class="form-input"></div>
                                        <div><label class="form-label">Option C</label><input type="text" id="optC-<%= q._id %>" value="<%= q.options[2] && q.options[2].startsWith('Option ') ? '' : q.options[2] || '' %>" placeholder="Option C" class="form-input"></div>
                                        <div><label class="form-label">Option D</label><input type="text" id="optD-<%= q._id %>" value="<%= q.options[3] && q.options[3].startsWith('Option ') ? '' : q.options[3] || '' %>" placeholder="Option D" class="form-input"></div>
                                    </div>
                                    <div>
                                        <label class="form-label">Correct Answer</label>
                                        <div class="relative w-32">
                                            <select id="correct-<%= q._id %>" class="form-input cursor-pointer appearance-none pr-8">
                                                <option value="0" <%= q.correctAnswer === 0 ? 'selected' : '' %>>Option A</option>
                                                <option value="1" <%= q.correctAnswer === 1 ? 'selected' : '' %>>Option B</option>
                                                <option value="2" <%= q.correctAnswer === 2 ? 'selected' : '' %>>Option C</option>
                                                <option value="3" <%= q.correctAnswer === 3 ? 'selected' : '' %>>Option D</option>
                                            </select>
                                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-[16px] text-slate-500 pointer-events-none">expand_more</span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label">Explanation</label>
                                        <textarea id="explain-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter explanation here (optional)"><%= q.explanation %></textarea>
                                    </div>
                                </div>
                            <% } else if (q.questionType === 'Short') { %>
                                <div class="space-y-4">
                                    <div>
                                        <label class="form-label">Question Text</label>
                                        <textarea id="qtext-<%= q._id %>" class="form-input w-full" rows="2" placeholder="<%= q.questionText.startsWith('New ') ? 'Enter Question..' : q.questionText %>"><%= q.questionText.startsWith('New ') ? '' : q.questionText %></textarea>
                                    </div>
                                    <div>
                                        <label class="form-label">Answer</label>
                                        <textarea id="ans-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter answer here.."><%
                                            let ansValShort = q.answer || q.correctAnswer || '';
                                            if (ansValShort === 0 || ansValShort === '0') ansValShort = '';
                                        %><%= ansValShort %></textarea>
                                    </div>
                                    <div>
                                        <label class="form-label">Explanation</label>
                                        <textarea id="explain-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter explanation here (optional)"><%= q.explanation %></textarea>
                                    </div>
                                </div>
                            <% } else if (q.questionType === 'Medium') { %>
                                <div class="space-y-4">
                                    <div>
                                        <label class="form-label">Question Text</label>
                                        <textarea id="qtext-<%= q._id %>" class="form-input w-full" rows="2" placeholder="<%= q.questionText.startsWith('New ') ? 'Enter Question..' : q.questionText %>"><%= q.questionText.startsWith('New ') ? '' : q.questionText %></textarea>
                                    </div>
                                    <div>
                                        <label class="form-label">Answer</label>
                                        <textarea id="ans-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter answer here.."><%
                                            let ansValMed = q.answer || q.correctAnswer || '';
                                            if (ansValMed === 0 || ansValMed === '0') ansValMed = '';
                                        %><%= ansValMed %></textarea>
                                    </div>
                                    <div>
                                        <label class="form-label">Explanation</label>
                                        <textarea id="explain-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter explanation here (optional)"><%= q.explanation %></textarea>
                                    </div>
                                </div>
                            <% } else if (q.questionType === 'Comprehension') { %>
                                <div class="space-y-4">
                                    <div>
                                        <label class="form-label">Context</label>
                                        <textarea id="context-<%= q._id %>" class="form-input w-full" rows="3" placeholder="Enter context.."><%= q.context || '' %></textarea>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div><label class="form-label">Question 1</label><textarea id="q1-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter question here.."><%= q.q1 || '' %></textarea></div>
                                        <div><label class="form-label">Question 2</label><textarea id="q2-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter question here.."><%= q.q2 || '' %></textarea></div>
                                        <div><label class="form-label">Answer 1</label><textarea id="a1-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter answer here.."><%= q.a1 || '' %></textarea></div>
                                        <div><label class="form-label">Answer 2</label><textarea id="a2-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter answer here.."><%= q.a2 || '' %></textarea></div>
                                    </div>
                                    <div>
                                        <label class="form-label">Explanation</label>
                                        <textarea id="explain-<%= q._id %>" class="form-input w-full" rows="2" placeholder="Enter explanation here (optional)"><%= q.explanation %></textarea>
                                    </div>
                                </div>
                            <% } %>


                            
                            <div class="mt-6 flex justify-end">
                                <button onclick="saveCard('<%= q._id %>', '<%= q.questionType %>')" class="h-10 px-6 bg-emerald-600 text-white rounded-md text-[11px] font-bold hover:opacity-90 transition-all flex items-center gap-2">
                                    <span class="material-symbols-rounded text-[16px]">save</span> Save
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Add Slot Buttons -->
                <div class="mt-8 flex flex-wrap items-center gap-4 justify-center">
                    <button onclick="addSlot('MCQ')" class="h-10 px-5 bg-white border border-[#9D9CA3] rounded-md text-[11px] font-bold text-slate-700 hover:bg-slate-50 transition-all flex items-center gap-2">
                        <span class="material-symbols-rounded text-[16px]">add_circle</span> Add MCQ Slot
                    </button>
                    <button onclick="addSlot('Short')" class="h-10 px-5 bg-white border border-[#9D9CA3] rounded-md text-[11px] font-bold text-slate-700 hover:bg-slate-50 transition-all flex items-center gap-2">
                        <span class="material-symbols-rounded text-[16px]">add_circle</span> Add Short Slot
                    </button>
                    <button onclick="addSlot('Medium')" class="h-10 px-5 bg-white border border-[#9D9CA3] rounded-md text-[11px] font-bold text-slate-700 hover:bg-slate-50 transition-all flex items-center gap-2">
                        <span class="material-symbols-rounded text-[16px]">add_circle</span> Add Medium Slot
                    </button>
                    <button onclick="addSlot('Comprehension')" class="h-10 px-5 bg-white border border-[#9D9CA3] rounded-md text-[11px] font-bold text-slate-700 hover:bg-slate-50 transition-all flex items-center gap-2">
                        <span class="material-symbols-rounded text-[16px]">add_circle</span> Add Comprehension Slot
                    </button>
                </div>

                <div class="mt-12 flex justify-center">
                    <button onclick="launchQuiz()" class="h-14 px-12 bg-black text-white rounded-md font-black text-xs uppercase tracking-[0.2em] shadow-lg hover:bg-slate-800 transition-all active:scale-95">
                        Launch Quiz
                    </button>
                </div>

                <!-- Empty state handled by JS list or initial render -->
                <% if (quiz.questions.length === 0) { %>
                    <div class="py-32 flex flex-col items-center justify-center text-center">
                        <div class="size-24 rounded-[2.5rem] bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-300 mb-8 border border-slate-200 dark:border-slate-700">
                            <span class="material-symbols-rounded text-5xl">quiz</span>
                        </div>
                        <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-3 tracking-tight">Studio Empty</h2>
                        <p class="text-slate-500 dark:text-slate-400 font-bold mb-10 max-w-xs">Start building your assessment by adding the first evaluation vector.</p>
                        <button onclick="openAddModal()" class="h-14 px-10 bg-primary text-white rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] shadow-2xl shadow-primary/30 hover:scale-105 transition-all active:scale-95">
                            Initialize First Vector
                        </button>
                    </div>
                <% } %>
            </div>
            
            <!-- Safe Space -->
            <div class="h-20"></div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const questionsData = <%- JSON.stringify(quiz.questions) %>;
        const quizId = '<%= quiz._id %>';
        const currentCourseId = '<%= typeof courseId !== "undefined" ? courseId : "" %>';

        async function addSlot(type) {
            try {
                const response = await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questionText: `New ${type} Question`,
                        options: type === 'MCQ' ? ['Option A', 'Option B', 'Option C', 'Option D'] : [],
                        correctAnswer: 0,
                        explanation: '',
                        questionType: type
                    })
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Failed to add slot', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        function openAddModal() {
            Swal.fire({
                title: 'New Evaluation Vector',
                html: `
                    <div class="space-y-4 text-left p-1">
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">The Proposition</label>
                            <textarea id="swal-question" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="3" placeholder="Enter question text..."></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option A</label>
                                <input id="swal-opt-0" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                            </div>
                            <div>
                                <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option B</label>
                                <input id="swal-opt-1" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                            </div>
                            <div>
                                <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option C</label>
                                <input id="swal-opt-2" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                            </div>
                            <div>
                                <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option D</label>
                                <input id="swal-opt-3" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Correct Matrix</label>
                            <select id="swal-correct" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer">
                                <option value="0">Option A (Alpha)</option>
                                <option value="1">Option B (Beta)</option>
                                <option value="2">Option C (Gamma)</option>
                                <option value="3">Option D (Delta)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Solution Logic</label>
                            <textarea id="swal-explanation" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2" placeholder="Explain the correct answer..."></textarea>
                        </div>
                    </div>
                `,
                width: '560px',
                showCancelButton: true,
                confirmButtonText: 'Deploy Vector',
                confirmButtonColor: '#000000',
                cancelButtonColor: '#94a3b8',
                preConfirm: () => {
                    const data = {
                        questionText: document.getElementById('swal-question').value,
                        options: [
                            document.getElementById('swal-opt-0').value,
                            document.getElementById('swal-opt-1').value,
                            document.getElementById('swal-opt-2').value,
                            document.getElementById('swal-opt-3').value
                        ],
                        correctAnswer: parseInt(document.getElementById('swal-correct').value),
                        explanation: document.getElementById('swal-explanation').value
                    };
                    if(!data.questionText || data.options.some(o => !o)) {
                        Swal.showValidationMessage('Please fulfill all required fields');
                    }
                    return data;
                }
            }).then(result => {
                if(result.isConfirmed) saveQuestion(result.value);
            });
        }

        async function saveQuestion(data) {
            try {
                const response = await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Failed to deploy vector', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function addSlot(type) {
            let data = { questionType: type };
            if (type === 'MCQ') {
                data.questionText = 'New MCQ Question';
                data.options = ['Option A', 'Option B', 'Option C', 'Option D'];
                data.correctAnswer = 0;
            } else if (type === 'Short') {
                data.questionText = 'New Short Question';
                data.answer = '';
                data.explanation = '';
            } else if (type === 'Medium') {
                data.questionText = 'New Medium Question';
                data.answer = '';
            } else if (type === 'Comprehension') {
                data.questionText = 'New Comprehension Question';
                data.context = 'New Context';
                data.q1 = 'Question 1';
                data.q2 = 'Question 2';
                data.a1 = 'Answer 1';
                data.a2 = 'Answer 2';
            }
            
            if (type === 'Medium') data.marks = 2;
            else if (type === 'Comprehension') data.marks = 7;
            else data.marks = 1;

            try {
                const response = await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Failed to add slot', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function editQuestion(qid) {
            const q = questionsData.find(x => x._id === qid);
            if(!q) return;

            Swal.fire({
                title: 'Update Evaluation Vector',
                html: `
                    <div class="space-y-4 text-left p-1">
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">The Proposition</label>
                            <textarea id="swal-question" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="3">${q.questionText}</textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div><label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option A</label><input id="swal-opt-0" value="${q.options[0]}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                            <div><label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option B</label><input id="swal-opt-1" value="${q.options[1]}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                            <div><label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option C</label><input id="swal-opt-2" value="${q.options[2]}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                            <div><label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Option D</label><input id="swal-opt-3" value="${q.options[3]}" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all"></div>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Correct Matrix</label>
                            <select id="swal-correct" class="w-full h-11 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all cursor-pointer">
                                <option value="0" ${q.correctAnswer === 0 ? 'selected' : ''}>Option A (Alpha)</option>
                                <option value="1" ${q.correctAnswer === 1 ? 'selected' : ''}>Option B (Beta)</option>
                                <option value="2" ${q.correctAnswer === 2 ? 'selected' : ''}>Option C (Gamma)</option>
                                <option value="3" ${q.correctAnswer === 3 ? 'selected' : ''}>Option D (Delta)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase text-slate-400 tracking-widest mb-2 ml-1">Solution Logic</label>
                            <textarea id="swal-explanation" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[13px] font-bold outline-none focus:border-primary transition-all" rows="2">${q.explanation || ''}</textarea>
                        </div>
                    </div>
                `,
                width: '560px',
                showCancelButton: true,
                confirmButtonText: 'Update Vector',
                confirmButtonColor: '#000000',
                preConfirm: () => {
                    return {
                        questionText: document.getElementById('swal-question').value,
                        options: [
                            document.getElementById('swal-opt-0').value,
                            document.getElementById('swal-opt-1').value,
                            document.getElementById('swal-opt-2').value,
                            document.getElementById('swal-opt-3').value
                        ],
                        correctAnswer: parseInt(document.getElementById('swal-correct').value),
                        explanation: document.getElementById('swal-explanation').value
                    }
                }
            }).then(result => {
                if(result.isConfirmed) updateQuestion(qid, result.value);
            });
        }

        async function updateQuestion(qid, data) {
            try {
                const response = await fetch(`/teacher/quiz/${quizId}/question/${qid}/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) location.reload();
                else Swal.fire('Error', 'Update failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function saveCard(qid, type) {
            const data = { questionType: type };
            
            // Marks Validation
            const marksVal = document.getElementById(`marks-${qid}`).value;
            if (!marksVal || marksVal.trim() === '') {
                Swal.fire('Error', 'Marks cannot be blank!', 'error');
                return;
            }
            data.marks = parseInt(marksVal);
            data.board = document.getElementById(`board-${qid}`).value;
            data.year = document.getElementById(`year-${qid}`).value;

            if (type === 'MCQ' || !type) {
                data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                data.options = [
                    document.getElementById(`optA-${qid}`).value.trim(),
                    document.getElementById(`optB-${qid}`).value.trim(),
                    document.getElementById(`optC-${qid}`).value.trim(),
                    document.getElementById(`optD-${qid}`).value.trim()
                ];
                data.correctAnswer = parseInt(document.getElementById(`correct-${qid}`).value);

                if (!data.questionText) {
                    Swal.fire('Error', 'Question text is mandatory!', 'error');
                    return;
                }
                const filledOptions = data.options.filter(o => o !== '');
                if (filledOptions.length < 3) {
                    Swal.fire('Error', 'At least 3 options are mandatory for MCQ!', 'error');
                    return;
                }
                if (data.options[data.correctAnswer] === '') {
                    Swal.fire('Error', 'The correct answer must be one of the filled options!', 'error');
                    return;
                }
            } else if (type === 'Short') {
                data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                data.answer = document.getElementById(`ans-${qid}`).value.trim();

                if (!data.questionText || !data.answer) {
                    Swal.fire('Error', 'Question and Answer are mandatory!', 'error');
                    return;
                }
            } else if (type === 'Medium') {
                data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                data.answer = document.getElementById(`ans-${qid}`).value.trim();

                if (!data.questionText || !data.answer) {
                    Swal.fire('Error', 'Question and Answer are mandatory!', 'error');
                    return;
                }
            } else if (type === 'Comprehension') {
                data.context = document.getElementById(`context-${qid}`).value.trim();
                data.q1 = document.getElementById(`q1-${qid}`).value.trim();
                data.q2 = document.getElementById(`q2-${qid}`).value.trim();
                data.a1 = document.getElementById(`a1-${qid}`).value.trim();
                data.a2 = document.getElementById(`a2-${qid}`).value.trim();

                if (!data.context || !data.q1 || !data.q2 || !data.a1 || !data.a2) {
                    Swal.fire('Error', 'Context, Questions, and Answers are mandatory!', 'error');
                    return;
                }
            }

            // Extract explanation for all types (if element exists)
            const explainEl = document.getElementById(`explain-${qid}`);
            if (explainEl) {
                data.explanation = explainEl.value.trim();
            }
            
            try {
                const response = await fetch(`/teacher/quiz/${quizId}/question/${qid}/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if((await response.json()).success) {
                    const card = document.getElementById(`q-${qid}`);
                    if (card) {
                        card.classList.add('blink-effect');
                        setTimeout(() => card.classList.remove('blink-effect'), 500);
                    }
                } else Swal.fire('Error', 'Update failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function launchQuiz() {
            const updates = [];
            for (let i = 0; i < questionsData.length; i++) {
                const q = questionsData[i];
                const qid = q._id;
                const type = q.questionType;
                
                // Marks Validation
                const marksVal = document.getElementById(`marks-${qid}`).value;
                if (!marksVal || marksVal.trim() === '') {
                    document.getElementById(`marks-${qid}`).focus();
                    document.getElementById(`marks-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }
                
                const data = { 
                    questionType: type,
                    marks: parseInt(marksVal),
                    board: document.getElementById(`board-${qid}`).value.trim(),
                    year: document.getElementById(`year-${qid}`).value.trim()
                };
                
                const explainEl = document.getElementById(`explain-${qid}`);
                if (explainEl) {
                    data.explanation = explainEl.value.trim();
                }

                if (type === 'MCQ' || !type) {
                    data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                    data.options = [
                        document.getElementById(`optA-${qid}`).value.trim(),
                        document.getElementById(`optB-${qid}`).value.trim(),
                        document.getElementById(`optC-${qid}`).value.trim(),
                        document.getElementById(`optD-${qid}`).value.trim()
                    ];
                    data.correctAnswer = parseInt(document.getElementById(`correct-${qid}`).value);

                    if (!data.questionText) {
                        document.getElementById(`qtext-${qid}`).focus();
                        document.getElementById(`qtext-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    const filledOptions = data.options.filter(o => o !== '');
                    if (filledOptions.length < 3) {
                        if (!document.getElementById(`optA-${qid}`).value.trim()) document.getElementById(`optA-${qid}`).focus();
                        else if (!document.getElementById(`optB-${qid}`).value.trim()) document.getElementById(`optB-${qid}`).focus();
                        else if (!document.getElementById(`optC-${qid}`).value.trim()) document.getElementById(`optC-${qid}`).focus();
                        else if (!document.getElementById(`optD-${qid}`).value.trim()) document.getElementById(`optD-${qid}`).focus();
                        return;
                    }
                    if (data.options[data.correctAnswer] === '') {
                        document.getElementById(`correct-${qid}`).focus();
                        return;
                    }
                } else if (type === 'Short' || type === 'Medium') {
                    data.questionText = document.getElementById(`qtext-${qid}`).value.trim();
                    data.answer = document.getElementById(`ans-${qid}`).value.trim();

                    if (!data.questionText) {
                        document.getElementById(`qtext-${qid}`).focus();
                        document.getElementById(`qtext-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.answer) {
                        document.getElementById(`ans-${qid}`).focus();
                        document.getElementById(`ans-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                } else if (type === 'Comprehension') {
                    data.context = document.getElementById(`context-${qid}`).value.trim();
                    data.q1 = document.getElementById(`q1-${qid}`).value.trim();
                    data.q2 = document.getElementById(`q2-${qid}`).value.trim();
                    data.a1 = document.getElementById(`a1-${qid}`).value.trim();
                    data.a2 = document.getElementById(`a2-${qid}`).value.trim();

                    if (!data.context) {
                        document.getElementById(`context-${qid}`).focus();
                        document.getElementById(`context-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q1) {
                        document.getElementById(`q1-${qid}`).focus();
                        document.getElementById(`q1-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a1) {
                        document.getElementById(`a1-${qid}`).focus();
                        document.getElementById(`a1-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.q2) {
                        document.getElementById(`q2-${qid}`).focus();
                        document.getElementById(`q2-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    if (!data.a2) {
                        document.getElementById(`a2-${qid}`).focus();
                        document.getElementById(`a2-${qid}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                }
                
                updates.push({ qid, data });
            }
            
            // Show loading during autosave and deploy
            Swal.fire({
                title: 'Deploying Quiz...',
                text: 'Autosaving and launching your assessment.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                // Post all question updates in parallel
                await Promise.all(updates.map(item => {
                    return fetch(`/teacher/quiz/${quizId}/question/${item.qid}/edit`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(item.data)
                    });
                }));

                // Redirect on success
                Swal.fire({
                    title: 'Success',
                    text: 'Quiz Launched & Autosaved!',
                    icon: 'success',
                    timer: 1000,
                    showConfirmButton: false
                }).then(() => {
                    if (currentCourseId) {
                        window.location.href = `/teacher/course/${currentCourseId}/edit?quizCreatedId=${quizId}`;
                    } else {
                        window.location.href = '/teacher/quizzes';
                    }
                });
            } catch (err) {
                Swal.fire('Error', 'Failed to autosave questions before launching.', 'error');
            }
        }

        async function deleteQuestion(qid) {
            const res = await Swal.fire({
                title: 'Destroy Vector?',
                text: 'This removal is permanent.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Permanently Delete'
            });
            if (res.isConfirmed) {
                try {
                    const response = await fetch(`/teacher/quiz/${quizId}/question/${qid}/delete`, { method: 'POST' });
                    if ((await response.json()).success) {
                        document.getElementById(`q-${qid}`).classList.add('fade-out', 'translate-x-4');
                        setTimeout(() => location.reload(), 300);
                    }
                } catch (err) { Swal.fire('Error', 'Failed to delete', 'error'); }
            }
        }

        function openBulkModal() {
            Swal.fire({
                title: 'Matrix Bulk Import',
                html: `
                    <div class="text-left">
                        <p class="text-[10px] font-bold text-slate-400 mb-4 uppercase tracking-widest">Protocol: Question ### Opt1 ### Opt2 ### Opt3 ### Opt4 ### CorrectIndex (0-3) ### Explanation</p>
                        <textarea id="swal-bulk" class="w-full p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-[11px] font-mono outline-none focus:border-primary" rows="10" placeholder="Question ### A ### B ### C ### D ### 0 ### Logic..."></textarea>
                    </div>
                `,
                width: '800px',
                showCancelButton: true,
                confirmButtonText: 'Initialize Protocol',
                confirmButtonColor: '#000000'
            }).then(result => {
                if(result.isConfirmed) {
                    const raw = document.getElementById('swal-bulk').value;
                    processBulk(raw);
                }
            });
        }

        async function processBulk(raw) {
            const lines = raw.split('\n').filter(l => l.trim().includes('###'));
            if(lines.length === 0) return;
            
            Swal.fire({ title: 'Processing Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            let count = 0;
            for(const line of lines) {
                const parts = line.split('###').map(p => p.trim());
                if(parts.length < 6) continue;
                const data = {
                    questionText: parts[0],
                    options: [parts[1], parts[2], parts[3], parts[4]],
                    correctAnswer: parseInt(parts[5]),
                    explanation: parts[6] || ''
                };
                await fetch(`/teacher/quiz/${quizId}/add-question`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                count++;
            }
            Swal.fire('Success', `${count} Vectors Deployed`, 'success').then(() => location.reload());
        }
    </script>
</body>
</html>
