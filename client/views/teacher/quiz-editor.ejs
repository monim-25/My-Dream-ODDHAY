        async function loadQuizEditorTopics() {
            const subject = <%- JSON.stringify(quiz.subject || '') %>;
            const classLevel = <%- JSON.stringify(quiz.classLevel || '') %>;
            const quizTopic = <%- JSON.stringify(quiz.topic || '') %>;
            if (!subject && !classLevel) return;

            try {
                const endpoints = ['/teacher/api/topics', '/api/topics'];
                const query = new URLSearchParams({ subject, classLevel }).toString();
                let topicList = [];
                for (const ep of endpoints) {
                    try {
                        const res = await fetch(ep + '?' + query, { headers: { 'Accept': 'application/json' } });
                        if (!res.ok) continue;
                        const json = await res.json();
                        if (json && Array.isArray(json.topics)) {
                            topicList = json.topics;
                            break;
                        }
                    } catch (e) {}
                }
                cachedQuizEditorTopics = topicList;

                const chapters = Array.from(new Set(topicList.map(t => (t.chapter && t.chapter.name) ? t.chapter.name.trim() : '').filter(Boolean))).sort();

                document.querySelectorAll('.q-editor-chapter').forEach(select => {
                    const currentVal = globalQuizChapter || select.value || select.getAttribute('data-prefill') || '';
                    let html = '<option value="">Optional</option>';
                    chapters.forEach(ch => {
                        const isSel = currentVal && currentVal.toLowerCase() === ch.toLowerCase() ? 'selected' : '';
                        html += `<option value="${escapeEditorHtml(ch)}" ${isSel}>${escapeEditorHtml(ch)}</option>`;
                    });
                    if (currentVal && !chapters.some(c => c.toLowerCase() === currentVal.toLowerCase())) {
                        html += `<option value="${escapeEditorHtml(currentVal)}" selected>${escapeEditorHtml(currentVal)}</option>`;
                    }
                    select.innerHTML = html;
                    if (currentVal) select.value = currentVal;
                    if (globalQuizChapter) {
                        select.value = globalQuizChapter;
                        select.disabled = true;
                        select.classList.add('opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                        select.classList.remove('opacity-50');
                    } else {
                        select.disabled = false;
                        select.classList.remove('opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                    }
                    updateSelectPlaceholderStyle(select);
                });

                document.querySelectorAll('.q-editor-topic').forEach(select => {
                    const qid = select.id.replace('topic-', '');
                    const chapSelect = document.getElementById(`chapter-${qid}`);
                    const selectedChap = chapSelect ? (chapSelect.value || chapSelect.getAttribute('data-prefill') || '') : '';
                    const currentVal = globalQuizTopic || select.value || select.getAttribute('data-prefill') || '';
                    if (selectedChap) {
                        select.innerHTML = buildEditorTopicOptionsHTML(currentVal, selectedChap);
                        if (currentVal) select.value = currentVal;
                        if (globalQuizTopic) {
                            select.value = globalQuizTopic;
                            select.disabled = true;
                            select.classList.add('opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                            select.classList.remove('opacity-50');
                        } else {
                            select.disabled = false;
                            select.classList.remove('opacity-50', 'opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                        }
                    } else {
                        select.disabled = true;
                        select.classList.add('opacity-50', 'cursor-not-allowed');
                        select.classList.remove('opacity-75', 'pointer-events-none');
                        select.innerHTML = '<option value="">Select Chapter First</option>';
                        select.value = '';
                    }
                    updateSelectPlaceholderStyle(select);
                });

                document.querySelectorAll('.q-editor-subtopic').forEach(select => {
                    const qid = select.id.replace('subtopic-', '');
                    const chapSelect = document.getElementById(`chapter-${qid}`);
                    const topSelect = document.getElementById(`topic-${qid}`);
                    const selectedChap = chapSelect ? (chapSelect.value || chapSelect.getAttribute('data-prefill') || '') : '';
                    const selectedTop = topSelect ? (topSelect.value || topSelect.getAttribute('data-prefill') || '') : '';
                    const currentVal = globalQuizSubTopic || select.value || select.getAttribute('data-prefill') || '';
                    if (selectedTop) {
                        const matchedTopic = (cachedQuizEditorTopics || []).find(t => {
                            const name = (t.name || '').trim().toLowerCase();
                            return name === selectedTop.toLowerCase();
                        });
                        if (matchedTopic && Array.isArray(matchedTopic.subTopics) && matchedTopic.subTopics.length > 0) {
                            select.innerHTML = buildEditorSubTopicOptionsHTML(currentVal, selectedTop, selectedChap);
                            if (currentVal) select.value = currentVal;
                            if (globalQuizSubTopic) {
                                select.value = globalQuizSubTopic;
                                select.disabled = true;
                                select.classList.add('opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                                select.classList.remove('opacity-50');
                            } else {
                                select.disabled = false;
                                select.classList.remove('opacity-50', 'opacity-75', 'cursor-not-allowed', 'pointer-events-none');
                            }
                        } else {
                            select.disabled = true;
                            select.classList.add('opacity-50', 'cursor-not-allowed');
                            select.classList.remove('opacity-75', 'pointer-events-none');
                            select.innerHTML = '<option value="">No sub-topics</option>';
                            select.value = '';
                        }
                    } else {
                        select.disabled = true;
                        select.classList.add('opacity-50', 'cursor-not-allowed');
                        select.classList.remove('opacity-75', 'pointer-events-none');
                        select.innerHTML = '<option value="">Select Topic First</option>';
                        select.value = '';
                    }
                    updateSelectPlaceholderStyle(select);
                });
            } catch (err) {
                console.warn('Failed to load quiz editor topics:', err);
            }
        }

        function updateSelectPlaceholderStyle(select) {
            if (!select) return;
            const isEmpty = !select.value || select.value === '';
            select.setAttribute('data-is-empty', isEmpty ? 'true' : 'false');
            if (isEmpty) {
                select.classList.add('is-empty');
            } else {
                select.classList.remove('is-empty');
            }
        }
        window.updateSelectPlaceholderStyle = updateSelectPlaceholderStyle;

        function buildEditorTopicOptionsHTML(selectedTopic = '', selectedChapter = '') {
            if (!selectedChapter || selectedChapter.trim() === '') {
                return '<option value="">Select Chapter First</option>';
            }

            let html = '<option value="">Optional</option>';
            let filtered = (cachedQuizEditorTopics || []).filter(t => 
                (t.chapter && t.chapter.name) ? t.chapter.name.trim().toLowerCase() === selectedChapter.trim().toLowerCase() : false
            );

            if (filtered.length === 0) {
                return '<option value="">No topics in this chapter</option>';
            }

            const topicNames = new Set();
            filtered.forEach(t => {
                if (!t.name || topicNames.has(t.name)) return;
                topicNames.add(t.name);
                const isSel = selectedTopic && selectedTopic.trim().toLowerCase() === t.name.trim().toLowerCase() ? 'selected' : '';
                html += `<option value="${escapeEditorHtml(t.name)}" ${isSel}>${escapeEditorHtml(t.name)}</option>`;
            });

            if (selectedTopic && !topicNames.has(selectedTopic)) {
                html += `<option value="${escapeEditorHtml(selectedTopic)}" selected>${escapeEditorHtml(selectedTopic)}</option>`;
            }
            return html;
        }

        function buildEditorSubTopicOptionsHTML(selectedSubTopic = '', selectedTopic = '', selectedChapter = '') {
            if (!selectedTopic || selectedTopic.trim() === '') {
                return '<option value="">Select Topic First</option>';
            }

            const targetTop = selectedTopic.trim().toLowerCase();
            const matchedTopic = (cachedQuizEditorTopics || []).find(t => {
                const name = (t.name || '').trim().toLowerCase();
                return name === targetTop;
            });

            if (!matchedTopic || !Array.isArray(matchedTopic.subTopics) || matchedTopic.subTopics.length === 0) {
                return '<option value="">No sub-topics</option>';
            }

            let html = '<option value="">Optional</option>';
            matchedTopic.subTopics.forEach(sub => {
                const subStr = String(sub || '').trim();
                if (!subStr) return;
                const isSel = selectedSubTopic && selectedSubTopic.trim().toLowerCase() === subStr.toLowerCase() ? 'selected' : '';
                html += `<option value="${escapeEditorHtml(subStr)}" ${isSel}>${escapeEditorHtml(subStr)}</option>`;
            });

            if (selectedSubTopic && !matchedTopic.subTopics.some(s => String(s || '').trim().toLowerCase() === selectedSubTopic.trim().toLowerCase())) {
                html += `<option value="${escapeEditorHtml(selectedSubTopic)}" selected>${escapeEditorHtml(selectedSubTopic)}</option>`;
            }
            return html;
        }

        function onQuizEditorChapterChange(select, qid) {
            const topicSelect = document.getElementById(`topic-${qid}`);
            const subTopicSelect = document.getElementById(`subtopic-${qid}`);
            const selectedChap = select.value.trim();

            updateSelectPlaceholderStyle(select);

            if (selectedChap) {
                if (topicSelect) {
                    topicSelect.disabled = false;
                    topicSelect.classList.remove('opacity-50', 'cursor-not-allowed');
                    topicSelect.innerHTML = buildEditorTopicOptionsHTML('', selectedChap);
                    topicSelect.value = '';
                    updateSelectPlaceholderStyle(topicSelect);
                }
            } else {
                if (topicSelect) {
                    topicSelect.disabled = true;
                    topicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                    topicSelect.innerHTML = '<option value="">Select Chapter First</option>';
                    topicSelect.value = '';
                    updateSelectPlaceholderStyle(topicSelect);
                }
            }

            if (subTopicSelect) {
                subTopicSelect.disabled = true;
                subTopicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                subTopicSelect.innerHTML = '<option value="">Select Topic First</option>';
                subTopicSelect.value = '';
                updateSelectPlaceholderStyle(subTopicSelect);
            }

            const card = select.closest('.question-card');
            if (card) {
                const type = card.getAttribute('data-type') || 'MCQ';
                queueAutoSave(qid, type);
            }
        }
        window.onQuizEditorChapterChange = onQuizEditorChapterChange;

        function onQuizEditorTopicChange(select, qid) {
            updateSelectPlaceholderStyle(select);
            const chapSelect = document.getElementById(`chapter-${qid}`);
            const subTopicSelect = document.getElementById(`subtopic-${qid}`);
            const selectedTopic = select.value.trim();
            const selectedChap = chapSelect ? chapSelect.value.trim() : '';

            if (subTopicSelect) {
                if (selectedTopic) {
                    const matchedTopic = (cachedQuizEditorTopics || []).find(t => {
                        const name = (t.name || '').trim().toLowerCase();
                        return name === selectedTopic.toLowerCase();
                    });
                    if (matchedTopic && Array.isArray(matchedTopic.subTopics) && matchedTopic.subTopics.length > 0) {
                        subTopicSelect.disabled = false;
                        subTopicSelect.classList.remove('opacity-50', 'cursor-not-allowed');
                        subTopicSelect.innerHTML = buildEditorSubTopicOptionsHTML('', selectedTopic, selectedChap);
                        subTopicSelect.value = '';
                    } else {
                        subTopicSelect.disabled = true;
                        subTopicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                        subTopicSelect.innerHTML = '<option value="">No sub-topics</option>';
                        subTopicSelect.value = '';
                    }
                } else {
                    subTopicSelect.disabled = true;
                    subTopicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                    subTopicSelect.innerHTML = '<option value="">Select Topic First</option>';
                    subTopicSelect.value = '';
                }
            }

            const card = select.closest('.question-card');
            if (card) {
                const type = card.getAttribute('data-type') || 'MCQ';
                queueAutoSave(qid, type);
            }
        }
        window.onQuizEditorTopicChange = onQuizEditorTopicChange;

        function onQuizEditorSubTopicChange(select, qid) {
            const card = select.closest('.question-card');
            if (card) {
                const type = card.getAttribute('data-type') || 'MCQ';
                queueAutoSave(qid, type);
            }
        }
        window.onQuizEditorSubTopicChange = onQuizEditorSubTopicChange;

        function escapeEditorHtml(str) {
            return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    </script>
</body>
</html>
