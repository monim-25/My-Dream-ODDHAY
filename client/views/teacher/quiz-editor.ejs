                } else {
                    btn.className = 'px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-medium border transition-all cursor-pointer border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary shrink-0';
