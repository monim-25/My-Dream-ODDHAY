                else Swal.fire('Error', 'Update failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        // ─── Real-Time Auto-Save Engine ─────────────────────────────────────────
        const debounceTimers = {};
        const pendingSaves = new Set();

        function setAutoSaveStatus(state) {
            const iconWrapper = document.getElementById('autosave-icon-wrapper');
            const icon = document.getElementById('autosave-icon');
            const text = document.getElementById('autosave-text');
            if (!iconWrapper || !icon || !text) return;

            if (state === 'saving') {
                iconWrapper.className = 'size-8 sm:size-11 rounded-lg sm:rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 shrink-0';
                icon.className = 'material-symbols-rounded text-lg sm:text-2xl animate-spin';
                icon.textContent = 'sync';
                text.className = 'text-xs sm:text-sm font-bold leading-none text-blue-600 dark:text-blue-400 truncate';
                text.textContent = 'Saving...';
            } else if (state === 'saved') {
                iconWrapper.className = 'size-8 sm:size-11 rounded-lg sm:rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 shrink-0';
                icon.className = 'material-symbols-rounded text-lg sm:text-2xl';
                icon.textContent = 'cloud_done';
                text.className = 'text-xs sm:text-sm font-bold leading-none text-emerald-600 dark:text-emerald-400 truncate';
                text.textContent = 'All Saved';
            } else if (state === 'error') {
                iconWrapper.className = 'size-8 sm:size-11 rounded-lg sm:rounded-xl bg-rose-500/10 flex items-center justify-center text-rose-500 shrink-0';
                icon.className = 'material-symbols-rounded text-lg sm:text-2xl';
                icon.textContent = 'error';
                text.className = 'text-xs sm:text-sm font-bold leading-none text-rose-600 dark:text-rose-400 truncate';
                text.textContent = 'Retry Error';
            }
        }

        function setCardStatus(qid, state) {
            const statusEl = document.getElementById(`card-status-${qid}`);
            if (!statusEl) return;
            if (state === 'saving') {
                statusEl.innerHTML = '<span class="material-symbols-rounded text-sm animate-spin text-blue-500">sync</span><span class="text-blue-500 font-semibold">Saving...</span>';
            } else if (state === 'saved') {
                statusEl.innerHTML = '<span class="material-symbols-rounded text-sm text-emerald-500">cloud_done</span><span class="text-emerald-600 dark:text-emerald-400 font-semibold">Auto-saved</span>';
            } else if (state === 'error') {
                statusEl.innerHTML = '<span class="material-symbols-rounded text-sm text-rose-500">warning</span><span class="text-rose-500 font-semibold">Save failed</span>';
            }
        }

        function extractCardData(qid, type) {
            const marksEl = document.getElementById(`marks-${qid}`);
            const chapterEl = document.getElementById(`chapter-${qid}`);
            const topicEl = document.getElementById(`topic-${qid}`);
            const subTopicEl = document.getElementById(`subtopic-${qid}`);
            const boardEl = document.getElementById(`board-${qid}`);
            const yearEl  = document.getElementById(`year-${qid}`);
            const explainEl = document.getElementById(`explain-${qid}`);
            const isBanglaEl = document.getElementById(`isBangla-${qid}`);
            const isBangla = isBanglaEl ? (isBanglaEl.value === 'true') : false;

            const data = {
                questionType: type,
                isBangla: isBangla,
                language: isBangla ? 'bn' : 'en',
                marks: marksEl && marksEl.value.trim() !== '' ? (parseInt(marksEl.value) || 1) : 1,
                chapter: (chapterEl ? chapterEl.value.trim() : '') || globalQuizChapter || '',
                topic: (topicEl ? topicEl.value.trim() : '') || globalQuizTopic || '',
                subTopic: (subTopicEl ? subTopicEl.value.trim() : '') || globalQuizSubTopic || '',
                board: boardEl ? boardEl.value.trim() : '',
                year: yearEl ? yearEl.value.trim() : '',
                explanation: explainEl ? explainEl.value.trim() : ''
            };

            if (type === 'MCQ' || !type) {
                const qtextEl = document.getElementById(`qtext-${qid}`);
                const optAEl  = document.getElementById(`optA-${qid}`);
                const optBEl  = document.getElementById(`optB-${qid}`);
                const optCEl  = document.getElementById(`optC-${qid}`);
                const optDEl  = document.getElementById(`optD-${qid}`);
                const correctEl = document.getElementById(`correct-${qid}`);

                data.questionText = qtextEl ? qtextEl.value.trim() : '';
                data.options = [
                    optAEl ? optAEl.value.trim() : '',
                    optBEl ? optBEl.value.trim() : '',
                    optCEl ? optCEl.value.trim() : '',
                    optDEl ? optDEl.value.trim() : ''
                ];
                data.correctAnswer = correctEl ? (parseInt(correctEl.value) || 0) : 0;
            } else if (type === 'Short' || type === 'Medium') {
                const qtextEl = document.getElementById(`qtext-${qid}`);
                const ansEl   = document.getElementById(`ans-${qid}`);
                data.questionText = qtextEl ? qtextEl.value.trim() : '';
                data.answer = ansEl ? ansEl.value.trim() : '';
            } else if (type === 'Comprehension') {
                const contextEl = document.getElementById(`context-${qid}`);
                const q1El = document.getElementById(`q1-${qid}`);
                const q2El = document.getElementById(`q2-${qid}`);
                const q3El = document.getElementById(`q3-${qid}`);
                const q4El = document.getElementById(`q4-${qid}`);
                const a1El = document.getElementById(`a1-${qid}`);
                const a2El = document.getElementById(`a2-${qid}`);
                const a3El = document.getElementById(`a3-${qid}`);
                const a4El = document.getElementById(`a4-${qid}`);
                const s1El = document.getElementById(`s1-${qid}`);
                const s2El = document.getElementById(`s2-${qid}`);
                const s3El = document.getElementById(`s3-${qid}`);
                const s4El = document.getElementById(`s4-${qid}`);

                data.context = contextEl ? contextEl.value.trim() : '';
                data.q1 = q1El ? q1El.value.trim() : '';
                data.q2 = q2El ? q2El.value.trim() : '';
                data.q3 = q3El ? q3El.value.trim() : '';
                data.q4 = q4El ? q4El.value.trim() : '';
                data.a1 = a1El ? a1El.value.trim() : '';
                data.a2 = a2El ? a2El.value.trim() : '';
                data.a3 = a3El ? a3El.value.trim() : '';
                data.a4 = a4El ? a4El.value.trim() : '';
                data.s1 = s1El ? s1El.value.trim() : '';
                data.s2 = s2El ? s2El.value.trim() : '';
                data.s3 = s3El ? s3El.value.trim() : '';
                data.s4 = s4El ? s4El.value.trim() : '';
                data.solution1 = data.s1;
                data.solution2 = data.s2;
                data.solution3 = data.s3;
                data.solution4 = data.s4;
            }
            return data;
        }

        function applyQuestionLanguage(qid, isBangla, autoSave = true) {
