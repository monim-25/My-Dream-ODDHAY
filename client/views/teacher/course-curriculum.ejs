    // Global outside click listener to auto-close all dropdowns
    document.addEventListener('click', () => {
        document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
        const playerSettings = document.getElementById('playerSettingsDropdown');
        if (playerSettings) playerSettings.classList.add('hidden');
    });

    function toggleCommentDropdown(e, id) {
        e.stopPropagation();
        const dropdown = document.getElementById(`dropdown-${id}`);
        if (dropdown) {
            const isHidden = dropdown.classList.contains('hidden');
            // Hide all others
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
            if (isHidden) {
                dropdown.classList.remove('hidden');
            }
        }
    }

    function renderExpandableText(text, id) {
        const escaped = escapeHTML(text);
        if (text.length <= 220) {
            return `<p class="text-sm text-slate-600 dark:text-slate-400 mt-1 leading-relaxed whitespace-pre-wrap">${escaped}</p>`;
        }
        const shortText = escapeHTML(text.substring(0, 220));
        return `
            <div id="text-container-${id}" class="mt-1">
                <p id="text-short-${id}" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${shortText}... <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read more</button></p>
                <p id="text-full-${id}" class="hidden text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${escaped} <button type="button" onclick="toggleCommentTextExpand('${id}')" class="text-xs text-primary font-bold hover:underline inline ml-1">Read less</button></p>
            </div>
        `;
    }

    function toggleCommentTextExpand(id) {
        const shortEl = document.getElementById(`text-short-${id}`);
        const fullEl = document.getElementById(`text-full-${id}`);
        if (shortEl && fullEl) {
            if (shortEl.classList.contains('hidden')) {
                shortEl.classList.remove('hidden');
                fullEl.classList.add('hidden');
            } else {
                shortEl.classList.add('hidden');
                fullEl.classList.remove('hidden');
            }
        }
    }

    function triggerEditComment(id) {
        toggleEditCommentForm(id);
    }

    function triggerEditReply(commentId, replyId) {
        toggleEditReplyForm(commentId, replyId);
    }

    function triggerDeleteComment(commentId) {
        const modalText = document.getElementById('deleteModalText');
        if (modalText) {
            modalText.innerText = `Are you sure you want to delete this comment? This action is permanent and cannot be undone.`;
        }
        const confirmBtn = document.getElementById('confirmDeleteBtn');
        if (confirmBtn) {
            confirmBtn.onclick = async () => {
                const originalText = confirmBtn.innerText;
                confirmBtn.disabled = true;
                confirmBtn.innerText = 'Deleting...';
                try {
                    const res = await fetch(`/api/curriculum/comment/${commentId}`, {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (data.success) {
                        closeDeleteModal();
                        if (activePlayingNodeId) {
                            await loadNodeComments(activePlayingNodeId);
                        }
                    } else {
                        alert('Error deleting comment: ' + (data.error || 'Server error'));
                    }
                } catch (err) {
                    console.error('Error deleting comment:', err);
                    alert('Failed to delete comment');
                } finally {
                    confirmBtn.disabled = false;
                    confirmBtn.innerText = originalText;
                }
            };
        }
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function triggerDeleteReply(commentId, replyId) {
        const modalText = document.getElementById('deleteModalText');
        if (modalText) {
            modalText.innerText = `Are you sure you want to delete this reply? This action is permanent and cannot be undone.`;
        }
        const confirmBtn = document.getElementById('confirmDeleteBtn');
