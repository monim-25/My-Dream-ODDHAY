<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title><%= quiz.title %> | ODDHAY Command Center</title>
    <style>
        * { font-family: 'Inter', 'Hind Siliguri', sans-serif !important; }
        :root { --admin-sidebar-width: 260px; }
        html, body { 
            height: 100%; 
            height: 100dvh; 
            overflow: hidden; 
            margin: 0; 
            padding: 0; 
        }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            min-height: 0;
            width: calc(100% - var(--admin-sidebar-width));
            overflow: hidden;
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1 1 0%; 
            min-height: 0;
            height: 100%;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-y;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { 
                margin-left: 0 !important; 
                width: 100% !important; 
                height: 100% !important;
                height: 100dvh !important;
                overflow: hidden !important;
            } 
            .content-scroll { 
                flex: 1 1 0% !important;
                min-height: 0 !important;
                height: 100% !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
                -webkit-overflow-scrolling: touch !important;
                touch-action: pan-y !important;
            }
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden h-full h-[100dvh]">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'quizzes' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 flex flex-col w-full h-full h-[100dvh] min-h-0 overflow-hidden bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Quiz Intelligence', user: user }) %>

            <div class="content-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden border-l-0 lg:border-l border-slate-200 dark:border-white/5 bg-[#F8FAFC] dark:bg-[#020617]">
                <div class="p-3 sm:p-5 lg:p-6 space-y-4 sm:space-y-6 max-w-7xl mx-auto w-full">
                <!-- Top Summary Container -->
                <div class="bg-white dark:bg-[#0f172a] rounded-xl p-4 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-xs sm:shadow-sm flex flex-col gap-5">
                    <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
                        <div class="min-w-0 flex-1 w-full">
                            <h1 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white tracking-tight break-words"><%= quiz.title %></h1>
                            <div class="flex flex-wrap items-center gap-3 sm:gap-5 mt-3">
                                <div class="flex items-center gap-1.5 text-slate-700 dark:text-slate-300">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">book</span>
                                    <p class="text-[12px] sm:text-[13px] font-semibold"><%= quiz.course ? quiz.course.subject : (quiz.subject || '---') %></p>
                                </div>
                                <div class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">school</span>
                                    <p class="text-[12px] sm:text-[13px] font-semibold">
                                        Class <%= quiz.course ? quiz.course.classLevel : (quiz.classLevel || '---') %>
                                    </p>
                                </div>
                                <div class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">timer</span>
                                    <p class="text-[12px] sm:text-[13px] font-semibold"><%= quiz.duration %> min</p>
                                </div>
                                <div class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                                    <span class="material-symbols-rounded text-slate-400 text-[18px]">quiz</span>
                                    <p class="text-[12px] sm:text-[13px] font-semibold"><%= stats.total %> Questions</p>
                                </div>
                            </div>
                        </div>

                        <!-- Creator Profile -->
                        <div class="flex items-center gap-2.5 self-start sm:self-auto shrink-0 bg-slate-50 dark:bg-slate-800/40 sm:bg-transparent sm:dark:bg-transparent px-3 py-1.5 sm:p-0 rounded-lg sm:rounded-none border sm:border-0 border-slate-200/80 dark:border-slate-800">
                            <div class="size-8 sm:size-9 rounded-full bg-slate-100 dark:bg-slate-800 border-2 border-white dark:border-slate-700 shadow-xs overflow-hidden shrink-0">
                                <img src="<%= quiz.addedBy && quiz.addedBy.profileImage ? quiz.addedBy.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                            </div>
                            <div>
                                <h2 class="text-[11px] sm:text-[12px] font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= quiz.addedBy ? quiz.addedBy.name : 'System' %></h2>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-wider">Creator</p>
                            </div>
                        </div>
                    </div>

                    <!-- Intelligence Ring Hub -->
                    <div class="border-t border-slate-100 dark:border-slate-800/80 pt-5">
                        <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-6">
                            <!-- Donut Chart & Legend -->
                            <div class="flex flex-row items-center justify-start sm:justify-start gap-4 sm:gap-6 flex-1 min-w-0">
                                <!-- Donut Chart -->
                                <div class="relative size-28 sm:size-32 flex-shrink-0">
                                    <% 
                                        const t = stats.total || 1;
                                        const pM = (stats.MCQ / t) * 100;
                                        const pS = (stats.Short / t) * 100;
                                        const pMed = (stats.Medium / t) * 100;
                                        const pC = (stats.Comprehension / t) * 100;
                                    %>
                                    <svg viewBox="0 0 42 42" class="size-full -rotate-90">
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f1f5f9" stroke-width="4.5" class="dark:stroke-slate-800"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="4.5" stroke-dasharray="<%= pM %> <%= 100 - pM %>" stroke-dashoffset="0" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="4.5" stroke-dasharray="<%= pS %> <%= 100 - pS %>" stroke-dashoffset="<%= -pM %>" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f59e0b" stroke-width="4.5" stroke-dasharray="<%= pMed %> <%= 100 - pMed %>" stroke-dashoffset="<%= -(pM + pS) %>" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f43f5e" stroke-width="4.5" stroke-dasharray="<%= pC %> <%= 100 - pC %>" stroke-dashoffset="<%= -(pM + pS + pMed) %>" class="transition-all duration-1000"></circle>
                                    </svg>
                                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                                        <span class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-slate-100 leading-none"><%= stats.total %></span>
                                        <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Total</span>
                                    </div>
                                </div>

                                <!-- Legend -->
                                <div class="grid grid-cols-2 sm:grid-cols-1 gap-x-4 gap-y-2.5 sm:gap-y-2 flex-1 min-w-0">
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-2 rounded-full bg-blue-500 shrink-0"></div>
                                        <div class="flex items-baseline gap-1.5 min-w-0">
                                            <p class="text-[11px] font-medium text-slate-400 tracking-wide">MCQ:</p>
                                            <h3 class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-200 leading-none"><%= stats.MCQ %></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-2 rounded-full bg-emerald-500 shrink-0"></div>
                                        <div class="flex items-baseline gap-1.5 min-w-0">
                                            <p class="text-[11px] font-medium text-slate-400 tracking-wide">Short:</p>
                                            <h3 class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-200 leading-none"><%= stats.Short %></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-2 rounded-full bg-amber-500 shrink-0"></div>
                                        <div class="flex items-baseline gap-1.5 min-w-0">
                                            <p class="text-[11px] font-medium text-slate-400 tracking-wide">Medium:</p>
                                            <h3 class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-200 leading-none"><%= stats.Medium %></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-2 rounded-full bg-rose-500 shrink-0"></div>
                                        <div class="flex items-baseline gap-1.5 min-w-0">
                                            <p class="text-[11px] font-medium text-slate-400 tracking-wide">Comp:</p>
                                            <h3 class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-200 leading-none"><%= stats.Comprehension %></h3>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Engagement (Stacked on mobile, side border on desktop) -->
                            <div class="w-full lg:w-80 xl:w-96 border-t lg:border-t-0 lg:border-l border-slate-100 dark:border-slate-800 pt-4 lg:pt-0 lg:pl-6 flex flex-col gap-3 sm:gap-3.5">
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Active Exam Takers</p>
                                        <p class="text-[11px] font-bold text-indigo-500 leading-none"><%= engagement.activeTakers %></p>
                                    </div>
                                    <div class="h-2 sm:h-2.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full bg-indigo-500 rounded-full transition-all duration-1000" style="width: <%= (engagement.activeTakers / engagement.maxTakers) * 100 %>%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Avg. Study Duration</p>
                                        <p class="text-[11px] font-bold text-cyan-500 leading-none"><%= engagement.studyDuration %>m</p>
                                    </div>
                                    <div class="h-2 sm:h-2.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full bg-cyan-500 rounded-full transition-all duration-1000" style="width: <%= (engagement.studyDuration / engagement.maxDuration) * 100 %>%"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Popularity Score</p>
                                        <p class="text-[11px] font-bold text-rose-500 leading-none"><%= engagement.popularityScore %>%</p>
                                    </div>
                                    <div class="h-2 sm:h-2.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full bg-rose-500 rounded-full transition-all duration-1000" style="width: <%= engagement.popularityScore %>%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Questions List Container -->
                <div class="bg-white dark:bg-[#0b1120] rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs sm:shadow-sm overflow-hidden mb-6">
                    <div class="px-4 sm:px-6 py-3.5 sm:py-5 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-[#0b1120] flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white tracking-tight">Quiz Questions</h3>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium sm:hidden mt-0.5"><%= questions.length %> questions</p>
                        </div>
                        <button onclick="toggleAllAnswers()" id="btn-toggle-all" class="h-8 sm:h-9 px-3 sm:px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#0f172a] text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shadow-xs flex items-center gap-1.5 shrink-0 text-xs font-semibold">
                            <span class="material-symbols-rounded text-sm">visibility</span>
                            <span class="text-[11px] sm:text-[12px]">Show All Answers</span>
                        </button>
                    </div>

                    <div class="p-3.5 sm:p-6 space-y-4 sm:space-y-6">
                        <% questions.forEach((q, i) => { 
                            let correctIndex = -1;
                            if (q.questionType === 'MCQ') {
                                if (q.correctAnswerIndex !== undefined && q.correctAnswerIndex !== null) {
                                    correctIndex = parseInt(q.correctAnswerIndex);
                                } else if (q.correctAnswer !== undefined && q.correctAnswer !== null) {
                                    correctIndex = parseInt(q.correctAnswer);
                                }
                            }
                        %>
                            <div class="q-item p-4 sm:p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-xs hover:shadow-sm transition-all duration-300" data-type="<%= q.questionType %>">
                                <div class="flex flex-wrap items-center justify-between gap-2.5 sm:gap-3 mb-4 sm:mb-5">
                                    <div class="flex items-center gap-2.5 sm:gap-3.5">
                                        <div class="size-7 sm:size-8 rounded-lg bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-bold text-[11px] sm:text-xs shadow-xs shrink-0">
                                            <%= (i + 1).toString().padStart(2, '0') %>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border 
                                                <%= q.questionType === 'MCQ' ? 'bg-blue-50 dark:bg-blue-500/10 border-blue-200 dark:border-blue-500/20 text-blue-600 dark:text-blue-400' : '' %>
                                                <%= q.questionType === 'Short' ? 'bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400' : '' %>
                                                <%= q.questionType === 'Medium' ? 'bg-amber-50 dark:bg-amber-500/10 border-amber-200 dark:border-amber-500/20 text-amber-600 dark:text-amber-400' : '' %>
                                                <%= q.questionType === 'Comprehension' ? 'bg-rose-50 dark:bg-rose-500/10 border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400' : '' %>
                                            "><%= q.questionType %></span>
                                            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-400 dark:text-slate-500">Marks: <%= q.marks || 1 %></span>
                                        </div>
                                    </div>
                                    <button onclick="toggleAnswer('<%= i %>', this)" class="btn-toggle-answer h-7 sm:h-8 px-2.5 sm:px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0f172a] text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-black dark:hover:text-white transition-all shadow-xs flex items-center gap-1.5 shrink-0">
                                        <span class="material-symbols-rounded text-sm">visibility</span>
                                        <span class="text-[10px] sm:text-[11px] font-semibold">Show Answer</span>
                                    </button>
                                </div>

                                <div>
                                    <% if (q.questionType === 'Comprehension') { %>
                                        <!-- Comprehension Header & Context -->
                                        <div class="p-3.5 sm:p-5 rounded-xl bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800 mb-3 sm:mb-4 text-left">
                                            <p class="text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Context:</p>
                                            <div class="text-[13px] sm:text-[15px] font-medium text-slate-800 dark:text-slate-200 leading-relaxed"><%- q.context || 'Context not provided.' %></div>
                                        </div>
                                        <!-- Comprehension Questions -->
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 mb-3 sm:mb-4 text-left">
                                            <div class="p-3 sm:p-4 rounded-xl bg-slate-50 dark:bg-slate-800/20 border border-slate-200 dark:border-slate-800">
                                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Q1:</p>
                                                <p class="text-[13px] sm:text-[14px] font-semibold text-slate-800 dark:text-slate-200"><%- q.q1 || 'Question 1 not provided.' %></p>
                                            </div>
                                            <div class="p-3 sm:p-4 rounded-xl bg-slate-50 dark:bg-slate-800/20 border border-slate-200 dark:border-slate-800">
                                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Q2:</p>
                                                <p class="text-[13px] sm:text-[14px] font-semibold text-slate-800 dark:text-slate-200"><%- q.q2 || 'Question 2 not provided.' %></p>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="text-[13px] sm:text-[15px] font-semibold text-slate-800 dark:text-slate-200 leading-relaxed break-words">
                                            <%- q.questionText || 'Untitled Question' %>
                                        </div>
                                    <% } %>

                                    <div id="ans-<%= i %>" class="hidden mt-4 sm:mt-6 pt-4 sm:pt-6 border-t border-slate-100 dark:border-slate-800/80 animate-slide-up">
                                        <% if (q.questionType === 'MCQ') { %>
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 sm:gap-3 mb-4 sm:mb-6">
                                                <% (q.options || []).forEach((opt, idx) => { %>
                                                    <div class="p-3 sm:p-4 rounded-xl border <%= correctIndex === idx ? 'bg-emerald-500/5 dark:bg-emerald-500/10 border-emerald-300 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400' : 'bg-slate-50 dark:bg-slate-800/20 border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400' %> text-xs sm:text-[13px] font-medium flex gap-3 items-center">
                                                        <div class="size-6 sm:size-7 rounded-lg <%= correctIndex === idx ? 'bg-emerald-500 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-500 dark:text-slate-400' %> flex items-center justify-center text-[10px] sm:text-[11px] font-bold shrink-0">
                                                            <%= String.fromCharCode(65 + idx) %>
                                                        </div>
                                                        <span class="flex-1 break-words"><%- opt %></span>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else if (q.questionType === 'Short' || q.questionType === 'Medium') { %>
                                            <div class="p-3.5 sm:p-5 rounded-xl bg-emerald-500/5 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 mb-3 sm:mb-4">
                                                <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1.5">Answer:</p>
                                                <div class="text-[13px] sm:text-[14px] font-semibold text-slate-800 dark:text-slate-200 leading-relaxed break-words">
                                                    <% 
                                                        let ansText = (q.answer || q.correctAnswer || '').toString().trim();
                                                        if (!ansText || ansText === '0' || ansText === 'undefined' || ansText === 'null') {
                                                            ansText = 'Answer not provided.';
                                                        }
                                                    %>
                                                    <%- ansText %>
                                                </div>
                                            </div>
                                        <% } else if (q.questionType === 'Comprehension') { %>
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 mb-3 sm:mb-4 text-left">
                                                <div class="p-3 sm:p-4 rounded-xl bg-emerald-500/5 dark:bg-emerald-500/10 border border-emerald-200/40 dark:border-emerald-500/20">
                                                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-1">Answer 1:</p>
                                                    <p class="text-[13px] sm:text-[14px] font-semibold text-slate-800 dark:text-slate-200 break-words"><%- q.a1 || 'Answer 1 not provided.' %></p>
                                                </div>
                                                <div class="p-3 sm:p-4 rounded-xl bg-emerald-500/5 dark:bg-emerald-500/10 border border-emerald-200/40 dark:border-emerald-500/20">
                                                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-1">Answer 2:</p>
                                                    <p class="text-[13px] sm:text-[14px] font-semibold text-slate-800 dark:text-slate-200 break-words"><%- q.a2 || 'Answer 2 not provided.' %></p>
                                                </div>
                                            </div>
                                        <% } %>
                                        
                                        <% if (q.explanation) { %>
                                            <div class="flex items-start gap-3 mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-slate-100 dark:border-slate-800/50">
                                                <div class="size-8 sm:size-9 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-rounded text-slate-500 dark:text-slate-400 text-base sm:text-lg">psychology</span>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-0.5">Explanation</p>
                                                    <p class="text-xs sm:text-[13px] font-normal text-slate-600 dark:text-slate-400 leading-relaxed italic break-words"><%- q.explanation %></p>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Dedicated Bottom Spacer for Small Screen to scroll cleanly above bottom-nav -->
                <div class="h-24 sm:h-28 lg:hidden shrink-0"></div>
                </div>
            </div>
            <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>

    <script>
        function toggleAnswer(id, btn) {
            const ans = document.getElementById(`ans-${id}`);
            if (ans.classList.contains('hidden')) {
                ans.classList.remove('hidden');
                btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility_off</span><span class="text-[10px] font-bold">Hide Answer</span>';
                btn.classList.add('border-blue-500', 'text-blue-600');
            } else {
                ans.classList.add('hidden');
                btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility</span><span class="text-[10px] font-bold">Show Answer</span>';
                btn.classList.remove('border-blue-500', 'text-blue-600');
            }
        }

        let allShown = false;
        function toggleAllAnswers() {
            allShown = !allShown;
            const btnAll = document.getElementById('btn-toggle-all');
            
            if (allShown) {
                btnAll.innerHTML = '<span class="material-symbols-rounded text-sm">visibility_off</span><span class="text-[10px] font-bold">Hide All Answers</span>';
                btnAll.classList.add('border-blue-500', 'text-blue-600');
            } else {
                btnAll.innerHTML = '<span class="material-symbols-rounded text-sm">visibility</span><span class="text-[10px] font-bold">Show All Answers</span>';
                btnAll.classList.remove('border-blue-500', 'text-blue-600');
            }

            const total = <%= questions.length %>;
            for (let i = 0; i < total; i++) {
                const ans = document.getElementById(`ans-${i}`);
                if (!ans) continue;
                const qItem = ans.closest('.q-item');
                if (!qItem) continue;
                const btn = qItem.querySelector('.btn-toggle-answer');
                
                if (allShown) {
                    ans.classList.remove('hidden');
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility_off</span><span class="text-[10px] font-bold">Hide Answer</span>';
                        btn.classList.add('border-blue-500', 'text-blue-600');
                    }
                } else {
                    ans.classList.add('hidden');
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-rounded text-sm">visibility</span><span class="text-[10px] font-bold">Show Answer</span>';
                        btn.classList.remove('border-blue-500', 'text-blue-600');
                    }
                }
            }
        }
    </script>
</body>
</html>
