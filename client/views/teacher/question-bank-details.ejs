<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title><%= bank.board %> <%= bank.year %> | ODDHAY Command Center</title>
    <style>
        * { font-family: 'Inter', 'Hind Siliguri', sans-serif !important; }
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased overflow-hidden h-full h-[100dvh] flex flex-col">
    <div class="flex h-full h-[100dvh] w-full min-h-0 overflow-hidden flex-1">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'questions' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 flex flex-col h-full h-[100dvh] min-h-0 overflow-hidden">
            <%- include('header', { pageTitle: 'Bank Intelligence' }) %>

            <div class="content-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden flex flex-col gap-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-28 sm:pb-24 lg:pb-12 custom-scrollbar">
                <!-- Top Summary Container -->
                <div class="bg-white dark:bg-[#0b1120] rounded-2xl p-3.5 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col gap-4 sm:gap-5 m-2 sm:m-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <h1 class="text-base sm:text-2xl font-bold text-slate-800 dark:text-white tracking-tight leading-snug"><%= bank.board %> - <%= bank.year %></h1>
                            <div class="flex flex-wrap items-center gap-2 sm:gap-4 mt-2">
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-slate-400 text-[15px] sm:text-[18px]">book</span>
                                    <p class="text-[11px] sm:text-[13px] font-semibold text-slate-700 dark:text-slate-300"><%= bank.subject %></p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-slate-400 text-[15px] sm:text-[18px]">school</span>
                                    <p class="text-[11px] sm:text-[13px] font-semibold text-slate-600 dark:text-slate-400">
                                        Class <%= (Array.isArray(bank.classLevel) ? bank.classLevel : [bank.classLevel]).map(c => String(c).replace('Class', '').trim()).join(', ') %>
                                    </p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-slate-400 text-[15px] sm:text-[18px]">sell</span>
                                    <p class="text-[11px] sm:text-[13px] font-semibold text-slate-600 dark:text-slate-400"><%= bank.accessType %> Tier</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <div class="text-right hidden sm:block">
                                <h2 class="text-[11px] font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= bank.addedBy ? bank.addedBy.name : 'System' %></h2>
                                <p class="text-[8px] font-semibold text-slate-400 uppercase tracking-wider">Contributor</p>
                            </div>
                            <div class="size-8 sm:size-9 rounded-full bg-slate-100 dark:bg-slate-800 border-2 border-white dark:border-slate-700 shadow-xs overflow-hidden shrink-0">
                                <img src="<%= bank.addedBy && bank.addedBy.profileImage ? bank.addedBy.profileImage : '/images/default-avatar.png' %>" class="size-full object-cover">
                            </div>
                        </div>
                    </div>

                    <!-- Intelligence Ring Hub -->
                    <div class="border-t border-slate-100 dark:border-slate-800/70 pt-3.5 sm:pt-5">
                        <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-4 sm:gap-6">
                            <!-- Left: Donut Chart & Legend -->
                            <div class="flex flex-row items-center gap-3 sm:gap-6 flex-1 min-w-0">
                                <!-- Donut Chart -->
                                <div class="relative size-20 sm:size-28 lg:size-32 shrink-0">
                                    <% 
                                        const t = stats.total || 1;
                                        const pM = (stats.MCQ / t) * 100;
                                        const pS = (stats.Short / t) * 100;
                                        const pMed = (stats.Medium / t) * 100;
                                        const pC = (stats.Comprehension / t) * 100;
                                    %>
                                    <svg viewBox="0 0 42 42" class="size-full -rotate-90">
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f1f5f9" stroke-width="4.5" class="dark:stroke-slate-800"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="4.5" stroke-dasharray="<%= pM %> <%= 100 - pM %>" stroke-dashoffset="0" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="4.5" stroke-dasharray="<%= pS %> <%= 100 - pS %>" stroke-dashoffset="<%= -pM %>" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f59e0b" stroke-width="4.5" stroke-dasharray="<%= pMed %> <%= 100 - pMed %>" stroke-dashoffset="<%= -(pM + pS) %>" class="transition-all duration-1000"></circle>
                                        <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f43f5e" stroke-width="4.5" stroke-dasharray="<%= pC %> <%= 100 - pC %>" stroke-dashoffset="<%= -(pM + pS + pMed) %>" class="transition-all duration-1000"></circle>
                                    </svg>
                                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                                        <span class="text-base sm:text-2xl font-bold text-slate-800 dark:text-slate-100 leading-none"><%= stats.total %></span>
                                        <span class="text-[8px] sm:text-[9px] font-semibold text-slate-400 uppercase tracking-tight mt-0.5">Total</span>
                                    </div>
                                </div>

                                <!-- Legend (Compact Grid) -->
                                <div class="flex-1 min-w-0 grid grid-cols-2 gap-1.5 sm:gap-2.5">
                                    <div class="flex items-center gap-1.5 sm:gap-2 p-1.5 sm:p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
                                        <div class="size-1.5 sm:size-2 rounded-full bg-blue-500 shrink-0"></div>
                                        <div class="min-w-0">
                                            <p class="text-[9px] sm:text-[10px] font-medium text-slate-400 truncate">MCQ</p>
                                            <h3 class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= stats.MCQ %> <span class="text-[8px] sm:text-[9px] font-normal text-slate-400 hidden xs:inline">items</span></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 sm:gap-2 p-1.5 sm:p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
                                        <div class="size-1.5 sm:size-2 rounded-full bg-emerald-500 shrink-0"></div>
                                        <div class="min-w-0">
                                            <p class="text-[9px] sm:text-[10px] font-medium text-slate-400 truncate">Short</p>
                                            <h3 class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= stats.Short %> <span class="text-[8px] sm:text-[9px] font-normal text-slate-400 hidden xs:inline">items</span></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 sm:gap-2 p-1.5 sm:p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
                                        <div class="size-1.5 sm:size-2 rounded-full bg-amber-500 shrink-0"></div>
                                        <div class="min-w-0">
                                            <p class="text-[9px] sm:text-[10px] font-medium text-slate-400 truncate">Medium</p>
                                            <h3 class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= stats.Medium %> <span class="text-[8px] sm:text-[9px] font-normal text-slate-400 hidden xs:inline">items</span></h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 sm:gap-2 p-1.5 sm:p-2 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
                                        <div class="size-1.5 sm:size-2 rounded-full bg-rose-500 shrink-0"></div>
                                        <div class="min-w-0">
                                            <p class="text-[9px] sm:text-[10px] font-medium text-slate-400 truncate">Compr.</p>
                                            <h3 class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200 leading-tight"><%= stats.Comprehension %> <span class="text-[8px] sm:text-[9px] font-normal text-slate-400 hidden xs:inline">items</span></h3>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Live Engagement -->
                            <div class="w-full lg:w-80 border-t lg:border-t-0 lg:border-l border-slate-100 dark:border-slate-800 pt-3 lg:pt-0 lg:pl-6 flex flex-col gap-2.5 sm:gap-3">
                                <!-- Top mini stats row -->
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-[14px] text-slate-400">visibility</span>
                                        <p class="text-[10px] font-semibold text-slate-400 tracking-wide"><%= engagement.views %> Views</p>
                                    </div>
                                    <% if (bank.accessType === 'Paid' && engagement.buyers > 0) { %>
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-[14px] text-amber-500">payments</span>
                                        <p class="text-[10px] font-semibold text-amber-500 tracking-wide"><%= engagement.buyers %> Buyers</p>
                                    </div>
                                    <% } %>
                                </div>
                                <!-- Exam Takers -->
                                <div class="flex flex-col gap-1">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-semibold text-slate-400 tracking-wide leading-none">Exam Takers</p>
                                        <p class="text-[10px] sm:text-[11px] font-bold text-indigo-500 leading-none"><%= engagement.activeTakers %></p>
                                    </div>
                                    <div class="h-1.5 sm:h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-indigo-500 rounded-full transition-all duration-1000" style="width: <%= Math.min((engagement.activeTakers / engagement.maxTakers) * 100, 100) %>%"></div>
                                    </div>
                                    <% if (engagement.activeTakers === 0) { %>
                                        <p class="text-[8px] text-slate-400 font-normal italic">Tracked when an exam is launched</p>
                                    <% } %>
                                </div>
                                <!-- Avg. Study Duration -->
                                <div class="flex flex-col gap-1">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-semibold text-slate-400 tracking-wide leading-none">Avg. Study Duration</p>
                                        <p class="text-[10px] sm:text-[11px] font-bold text-cyan-500 leading-none"><%= engagement.studyDuration %>m</p>
                                    </div>
                                    <div class="h-1.5 sm:h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-cyan-500 rounded-full transition-all duration-1000" style="width: <%= Math.min((engagement.studyDuration / engagement.maxDuration) * 100, 100) %>%"></div>
                                    </div>
                                </div>
                                <!-- Popularity Score -->
                                <div class="flex flex-col gap-1">
                                    <div class="flex justify-between items-end">
                                        <p class="text-[10px] font-semibold text-slate-400 tracking-wide leading-none">Popularity Score</p>
                                        <p class="text-[10px] sm:text-[11px] font-bold text-rose-500 leading-none"><%= engagement.popularityScore %>%</p>
                                    </div>
                                    <div class="h-1.5 sm:h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-rose-500 rounded-full transition-all duration-1000" style="width: <%= engagement.popularityScore %>%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Material Action Bar -->
                    <% if (bank.fileUrl) { %>
                    <div class="bg-slate-50/70 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800 p-2.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3">
                        <div class="flex items-center gap-2">
                            <div class="size-7 sm:size-8 rounded-lg bg-orange-50 dark:bg-orange-500/10 border border-orange-100 dark:border-orange-500/20 flex items-center justify-center text-orange-500 shrink-0">
                                <span class="material-symbols-rounded text-sm sm:text-base">picture_as_pdf</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[10px] sm:text-[11px] font-bold text-slate-700 dark:text-slate-200 truncate">Primary Material Asset</p>
                                <p class="text-[8px] sm:text-[9px] font-semibold text-slate-400 uppercase tracking-wider">PDF Document</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 sm:gap-2 w-full sm:w-auto">
                            <a href="/teacher/deploy-bank-to-quiz/<%= bank._id %>" class="flex-1 sm:flex-none justify-center h-8 sm:h-9 px-2 sm:px-3 rounded-xl bg-emerald-600 text-white text-[11px] sm:text-xs font-semibold flex items-center gap-1 hover:bg-emerald-700 transition-all shadow-xs">
                                <span class="material-symbols-rounded text-xs sm:text-sm">rocket_launch</span>
                                <span>Launch</span>
                            </a>
                            <a href="<%= bank.fileUrl %>" download class="flex-1 sm:flex-none justify-center h-8 sm:h-9 px-2 sm:px-3 rounded-xl bg-primary text-white text-[11px] sm:text-xs font-semibold flex items-center gap-1 hover:bg-blue-600 transition-all shadow-xs">
                                <span class="material-symbols-rounded text-xs sm:text-sm">download</span>
                                <span>Download</span>
                            </a>
                            <a href="<%= bank.fileUrl %>" target="_blank" class="flex-1 sm:flex-none justify-center h-8 sm:h-9 px-2 sm:px-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[11px] sm:text-xs font-semibold flex items-center gap-1 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all shadow-2xs">
                                <span class="material-symbols-rounded text-xs sm:text-sm">open_in_new</span>
                                <span>Viewer</span>
                            </a>
                        </div>
                    </div>
                    <% } else { %>
                    <div class="bg-slate-50/70 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800 p-2.5 sm:p-4 flex items-center justify-end">
                        <a href="/teacher/deploy-bank-to-quiz/<%= bank._id %>" class="w-full sm:w-auto justify-center h-8 sm:h-9 px-3.5 rounded-xl bg-emerald-600 text-white text-xs font-semibold flex items-center gap-1.5 hover:bg-emerald-700 transition-all shadow-xs">
                            <span class="material-symbols-rounded text-sm">rocket_launch</span>
                            <span>Launch Exam</span>
                        </a>
                    </div>
                    <% } %>
                </div>

                <!-- Filters & List -->
                <div class="bg-white dark:bg-[#0b1120] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden m-2 sm:m-4 mb-6">
                    <div class="px-3 sm:px-6 py-3 sm:py-4 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-[#0b1120]">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3">
                            <div class="flex items-center gap-2">
                                <div class="size-7 sm:size-9 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-slate-500 text-base sm:text-lg">inventory_2</span>
                                </div>
                                <div>
                                    <h3 class="text-xs sm:text-base font-bold text-slate-900 dark:text-white leading-tight">Question Archive</h3>
                                    <p class="text-[9px] sm:text-[10px] font-medium text-slate-500 mt-0.5"><%= stats.total %> items cataloged</p>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-3 sm:flex items-center gap-1.5 sm:gap-2 w-full sm:w-auto">
                                <div class="col-span-1">
                                    <select onchange="filterQuestions(this.value)" class="h-8 sm:h-9 w-full sm:w-auto px-2 rounded-xl border border-slate-200 dark:border-slate-700 text-[11px] sm:text-xs font-semibold text-slate-700 dark:text-slate-200 outline-none bg-slate-50 dark:bg-slate-900 focus:border-primary transition-all">
                                        <option value="all">All types</option>
                                        <option value="MCQ">MCQ</option>
                                        <option value="Short">Short</option>
                                        <option value="Medium">Medium</option>
                                        <option value="Comprehension">Compr.</option>
                                    </select>
                                </div>
                                <button type="button" onclick="toggleAllAnswers(this)" class="col-span-1 justify-center h-8 sm:h-9 px-2 sm:px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-[11px] sm:text-xs font-semibold flex items-center gap-1 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all shadow-2xs cursor-pointer">
                                    <span class="material-symbols-rounded text-xs sm:text-sm">visibility</span>
                                    <span class="whitespace-nowrap">Answers</span>
                                </button>
                                <a href="/teacher/edit-question-bank/<%= bank._id %>" class="col-span-1 justify-center h-8 sm:h-9 px-2 sm:px-3.5 rounded-xl bg-slate-900 dark:bg-slate-700 text-white text-[11px] sm:text-xs font-semibold flex items-center gap-1 hover:bg-black dark:hover:bg-slate-600 transition-all shadow-2xs cursor-pointer">
                                    <span class="material-symbols-rounded text-xs sm:text-sm">edit</span>
                                    <span class="whitespace-nowrap">Edit</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="p-2.5 sm:p-5 space-y-3 sm:space-y-4">
                        <% questions.forEach((q, i) => { %>
                            <div class="q-item p-3.5 sm:p-6 rounded-2xl border border-slate-100 dark:border-slate-800 hover:border-primary/20 transition-all bg-white dark:bg-[#0f172a] shadow-xs hover:shadow-sm" data-type="<%= q.questionType %>">
                                <!-- Top Row: Metadata & Actions -->
                                <div class="flex items-center justify-between mb-3 sm:mb-5 gap-2">
                                    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                                        <div class="size-7 sm:size-8 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xs shrink-0">
                                            <%= (i + 1).toString().padStart(2, '0') %>
                                        </div>
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-[9px] sm:text-[10px] font-semibold text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"><%= q.questionType %></span>
                                            <span class="text-[9px] sm:text-[10px] font-medium text-slate-400">ID: <%= q._id.toString().slice(-6).toUpperCase() %></span>
                                        </div>
                                    </div>
                                    <button type="button" onclick="toggleAnswer('<%= i %>', this)" class="h-7.5 sm:h-8 px-2 sm:px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-black dark:hover:text-white transition-all shadow-xs flex items-center gap-1 shrink-0 cursor-pointer select-none">
                                        <span class="material-symbols-rounded text-xs sm:text-sm">visibility</span>
                                        <span class="text-[9px] sm:text-[10px] font-semibold">Answer</span>
                                    </button>
                                </div>

                                <!-- Question Content -->
                                <div class="pl-0 sm:pl-1">
                                    <% if (q.questionType === 'Comprehension') { %>
                                        <div class="space-y-2.5 sm:space-y-3">
                                            <!-- Context / উদ্দীপক -->
                                            <div class="p-3 sm:p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                                                <div class="flex items-center gap-1.5 text-primary text-[11px] sm:text-xs font-semibold mb-1">
                                                    <span class="material-symbols-rounded text-sm">auto_stories</span>
                                                    <span>উদ্দীপক / Passage Context</span>
                                                </div>
                                                <div class="text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 leading-relaxed whitespace-pre-wrap"><%- q.context || q.questionText || '' %></div>
                                            </div>

                                            <!-- Sub-Questions -->
                                            <div class="space-y-1.5 sm:space-y-2 pt-0.5">
                                                <% if (q.q1) { %>
                                                    <div class="p-2 sm:p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 flex items-start gap-2">
                                                        <span class="size-4.5 sm:size-5 rounded-md bg-primary/10 text-primary text-[10px] sm:text-[11px] font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
                                                        <div class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200 leading-relaxed"><%= q.q1 %></div>
                                                    </div>
                                                <% } %>
                                                <% if (q.q2) { %>
                                                    <div class="p-2 sm:p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 flex items-start gap-2">
                                                        <span class="size-4.5 sm:size-5 rounded-md bg-primary/10 text-primary text-[10px] sm:text-[11px] font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
                                                        <div class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200 leading-relaxed"><%= q.q2 %></div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="text-xs sm:text-base font-semibold text-slate-800 dark:text-slate-100 leading-relaxed mb-0">
                                            <%- q.questionText || q.title || 'Untitled Question' %>
                                        </div>
                                    <% } %>

                                    <!-- Answer Section (Hidden by default, shown when toggled) -->
                                    <div id="ans-<%= i %>" class="hidden mt-4 sm:mt-6 pt-4 sm:pt-6 border-t border-slate-100 dark:border-slate-800 animate-slide-up">
                                        <% if (q.questionType === 'Comprehension') { %>
                                            <div class="space-y-2.5 sm:space-y-3">
                                                <% if (q.q1) { %>
                                                    <div class="p-2.5 sm:p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5 sm:space-y-2">
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="size-4.5 sm:size-5 rounded-md bg-primary/10 text-primary text-[10px] sm:text-[11px] font-bold flex items-center justify-center">1</span>
                                                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300"><%= q.q1 %></span>
                                                        </div>
                                                        <% if (q.a1) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/40 text-xs">
                                                                <span class="font-semibold text-emerald-700 dark:text-emerald-400">উত্তর: </span>
                                                                <span class="text-emerald-900 dark:text-emerald-200 font-medium"><%= q.a1 %></span>
                                                            </div>
                                                        <% } %>
                                                        <% const sol1 = q.s1 || q.solution1; %>
                                                        <% if (sol1 && sol1.trim()) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700/60 text-xs">
                                                                <span class="font-semibold text-slate-600 dark:text-slate-400">সমাধান / ব্যাখ্যা: </span>
                                                                <span class="text-slate-700 dark:text-slate-300"><%= sol1 %></span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% } %>

                                                <% if (q.q2) { %>
                                                    <div class="p-2.5 sm:p-3.5 rounded-xl bg-slate-50/80 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5 sm:space-y-2">
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="size-4.5 sm:size-5 rounded-md bg-primary/10 text-primary text-[10px] sm:text-[11px] font-bold flex items-center justify-center">2</span>
                                                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300"><%= q.q2 %></span>
                                                        </div>
                                                        <% if (q.a2) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/40 text-xs">
                                                                <span class="font-semibold text-emerald-700 dark:text-emerald-400">উত্তর: </span>
                                                                <span class="text-emerald-900 dark:text-emerald-200 font-medium"><%= q.a2 %></span>
                                                            </div>
                                                        <% } %>
                                                        <% const sol2 = q.s2 || q.solution2; %>
                                                        <% if (sol2 && sol2.trim()) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700/60 text-xs">
                                                                <span class="font-semibold text-slate-600 dark:text-slate-400">সমাধান / ব্যাখ্যা: </span>
                                                                <span class="text-slate-700 dark:text-slate-300"><%= sol2 %></span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% } %>

                                                <% if (!q.q1 && !q.q2 && (q.correctAnswer || q.answer)) { %>
                                                    <div class="p-3 sm:p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                                                        <div class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-300">
                                                            <span class="font-bold">উত্তর: </span><%= q.correctAnswer || q.answer %>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <% const expComp = String(q.explanation || q.explanationText || q.solution || '').trim(); %>
                                                <% if (expComp !== '') { %>
                                                    <div class="mt-2.5 p-3 sm:p-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 flex gap-2.5 sm:gap-3 items-start">
                                                        <div class="size-7 sm:size-8 rounded-lg bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                                            <span class="material-symbols-rounded text-sm sm:text-base">lightbulb</span>
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <p class="text-[9px] sm:text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-0.5">Explanation</p>
                                                            <p class="text-xs sm:text-[13px] font-medium text-slate-700 dark:text-slate-300 leading-relaxed"><%= expComp %></p>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% } else if (q.questionType === 'MCQ') { %>
                                            <!-- Prominent Correct Answer Callout -->
                                            <% 
                                                const corrIdx = Number(q.correctAnswerIndex);
                                                const hasCorrIdx = !isNaN(corrIdx) && corrIdx >= 0 && corrIdx < ((q.options && q.options.length) || 4);
                                                const corrOptText = (hasCorrIdx && q.options && q.options[corrIdx]) ? q.options[corrIdx] : (q.correctAnswer || '');
                                            %>
                                            <% if (corrOptText || hasCorrIdx) { %>
                                                <div class="p-2.5 sm:p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 text-xs sm:text-[13px] font-semibold text-emerald-800 dark:text-emerald-300 flex items-center gap-2 mb-3">
                                                    <span class="material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400 shrink-0">check_circle</span>
                                                    <span>সঠিক উত্তর: 
                                                        <% if (hasCorrIdx) { %>
                                                            <strong class="font-bold underline decoration-emerald-500 underline-offset-2"><%= String.fromCharCode(65 + corrIdx) %></strong> - <%= corrOptText %>
                                                        <% } else { %>
                                                            <%= corrOptText %>
                                                        <% } %>
                                                    </span>
                                                </div>
                                            <% } %>

                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3 mb-4 sm:mb-6">
                                                <% (q.options || []).forEach((opt, idx) => { %>
                                                    <% 
                                                        const isSelected = (hasCorrIdx && corrIdx === idx) ||
                                                                          (String(q.correctAnswerIndex) === String(idx)) ||
                                                                          (q.correctAnswer && (String(q.correctAnswer).trim() === String(opt).trim() || String(q.correctAnswer).trim() === String.fromCharCode(65 + idx) || String(q.correctAnswer).trim() === String(idx)));
                                                    %>
                                                    <div class="p-2.5 sm:p-3.5 rounded-xl border <%= isSelected ? 'bg-emerald-50/90 dark:bg-emerald-950/40 border-emerald-400 dark:border-emerald-700 text-emerald-800 dark:text-emerald-200 font-semibold ring-1 ring-emerald-400/50' : 'bg-slate-50 dark:bg-slate-900/60 border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400' %> text-xs sm:text-[13px] font-medium flex gap-2.5 items-center">
                                                        <div class="size-5 sm:size-6 rounded-md <%= isSelected ? 'bg-emerald-500 text-white shadow-xs' : 'bg-slate-200 dark:bg-slate-700 text-slate-500' %> flex items-center justify-center text-[10px] sm:text-[11px] font-bold shrink-0">
                                                            <%= String.fromCharCode(65 + idx) %>
                                                        </div>
                                                        <span class="flex-1 leading-snug"><%= opt %></span>
                                                        <% if (isSelected) { %>
                                                            <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-sm shrink-0">check</span>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            </div>

                                            <% const expMCQ = String(q.explanation || q.explanationText || q.solution || '').trim(); %>
                                            <% if (expMCQ !== '') { %>
                                                <div class="mt-2.5 p-3 sm:p-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 flex gap-2.5 sm:gap-3 items-start">
                                                    <div class="size-7 sm:size-8 rounded-lg bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                                        <span class="material-symbols-rounded text-sm sm:text-base">lightbulb</span>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-[9px] sm:text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-0.5">Explanation</p>
                                                        <p class="text-xs sm:text-[13px] font-medium text-slate-700 dark:text-slate-300 leading-relaxed"><%= expMCQ %></p>
                                                    </div>
                                                </div>
                                            <% } %>
                                        <% } else { %>
                                            <div class="p-3.5 sm:p-5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                                                <div class="flex items-center gap-2 mb-2">
                                                    <div class="size-6 sm:size-7 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                                                        <span class="material-symbols-rounded text-slate-600 dark:text-slate-300 text-sm">verified</span>
                                                    </div>
                                                    <p class="text-[9px] sm:text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Model solution</p>
                                                </div>
                                                <div class="text-xs sm:text-[15px] font-semibold text-slate-700 dark:text-slate-200 leading-relaxed">
                                                    <%- q.correctAnswer || q.answer || q.modelAnswer || q.solution || 'Answer not provided.' %>
                                                </div>
                                            </div>
                                            <% const expNonMCQ = String(q.explanation || q.explanationText || q.solution || '').trim(); %>
                                            <% if (expNonMCQ !== '') { %>
                                                <div class="mt-2.5 p-3 sm:p-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 flex gap-2.5 sm:gap-3 items-start">
                                                    <div class="size-7 sm:size-8 rounded-lg bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                                        <span class="material-symbols-rounded text-sm sm:text-base">lightbulb</span>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-[9px] sm:text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-0.5">Explanation</p>
                                                        <p class="text-xs sm:text-[13px] font-medium text-slate-700 dark:text-slate-300 leading-relaxed"><%= expNonMCQ %></p>
                                                    </div>
                                                </div>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="px-4 sm:px-6 py-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30">
                        <p class="text-[10px] sm:text-[11px] font-semibold text-slate-500">Showing all <%= stats.total %> questions</p>
                    </div>
                </div>
            </div>
            <%- include('bottom-nav', { activePage: 'questions' }) %>
        </main>
    </div>

    <script>
        function toggleAnswer(id, btn) {
            const ans = document.getElementById(`ans-${id}`);
            if (!ans) return;
            const isHidden = ans.classList.contains('hidden');
            if (isHidden) {
                ans.classList.remove('hidden');
                if (btn) {
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs sm:text-sm">visibility_off</span><span class="text-[9px] sm:text-[10px] font-semibold">Hide</span>';
                    btn.classList.add('border-primary', 'text-primary');
                }
            } else {
                ans.classList.add('hidden');
                if (btn) {
                    btn.innerHTML = '<span class="material-symbols-rounded text-xs sm:text-sm">visibility</span><span class="text-[9px] sm:text-[10px] font-semibold">Answer</span>';
                    btn.classList.remove('border-primary', 'text-primary');
                }
            }
        }
        window.toggleAnswer = toggleAnswer;

        let allAnswersVisible = false;
        function toggleAllAnswers(btn) {
            allAnswersVisible = !allAnswersVisible;
            document.querySelectorAll('[id^="ans-"]').forEach(ans => {
                if (allAnswersVisible) {
                    ans.classList.remove('hidden');
                } else {
                    ans.classList.add('hidden');
                }
            });
            document.querySelectorAll('.q-item button[onclick^="toggleAnswer"]').forEach(b => {
                b.innerHTML = allAnswersVisible
                    ? '<span class="material-symbols-rounded text-xs sm:text-sm">visibility_off</span><span class="text-[9px] sm:text-[10px] font-semibold">Hide</span>'
                    : '<span class="material-symbols-rounded text-xs sm:text-sm">visibility</span><span class="text-[9px] sm:text-[10px] font-semibold">Answer</span>';
                if (allAnswersVisible) {
                    b.classList.add('border-primary', 'text-primary');
                } else {
                    b.classList.remove('border-primary', 'text-primary');
                }
            });
            if (btn) {
                const icon = btn.querySelector('.material-symbols-rounded');
                const label = btn.querySelector('span:last-child');
                if (icon) icon.textContent = allAnswersVisible ? 'visibility_off' : 'visibility';
                if (label) label.textContent = allAnswersVisible ? 'Hide Answers' : 'Answers';
            }
        }
        window.toggleAllAnswers = toggleAllAnswers;

        function filterQuestions(type) {
            const items = document.querySelectorAll('.q-item');
            items.forEach(item => {
                if (type === 'all' || item.getAttribute('data-type') === type) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        function openWizard() {
            document.getElementById('compositionWizardModal').classList.remove('hidden');
            document.getElementById('compositionWizardModal').classList.add('flex');
        }

        function closeWizard() {
            document.getElementById('compositionWizardModal').classList.add('hidden');
            document.getElementById('compositionWizardModal').classList.remove('flex');
        }

        async function startComposition() {
            const classLevel = document.getElementById('wizClass').value;
            const subject = document.getElementById('wizSubject').value;
            const topic = document.getElementById('wizTopic').value;
            const type = document.getElementById('wizType').value;
            const count = document.getElementById('wizCount').value;

            const params = new URLSearchParams({
                class: classLevel,
                subject: subject,
                topic: topic,
                type: type,
                count: count,
                bankId: '<%= bank._id %>'
            });

            window.location.href = `/teacher/add-question?${params.toString()}`;
        }
    </script>

    <!-- Composition Wizard Modal -->
    <div id="compositionWizardModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1000] hidden items-center justify-center p-3 sm:p-4">
        <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-2xl sm:rounded-3xl shadow-2xl border border-slate-200 dark:border-white/10 overflow-hidden animate-slide-up">
            <div class="p-5 sm:p-8 max-h-[90vh] overflow-y-auto">
                <div class="flex justify-between items-center mb-6 sm:mb-8">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white leading-tight">Composition Wizard</h2>
                        <p class="text-[11px] font-medium text-slate-500 mt-1 uppercase tracking-wider">Setup metadata before studio entry</p>
                    </div>
                    <button onclick="closeWizard()" class="size-9 sm:size-10 rounded-xl bg-slate-50 dark:bg-slate-800 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all flex items-center justify-center">
                        <span class="material-symbols-rounded">close</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 mb-6 sm:mb-8">
                    <div class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-slate-900 dark:text-slate-200 ml-1">Class</label>
                        <select id="wizClass" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-medium outline-none focus:border-primary">
                            <% 
                                const curCls = (Array.isArray(bank.classLevel) ? bank.classLevel : [bank.classLevel]).map(c => String(c).trim());
                                const hasCls = (v) => curCls.includes(v) || curCls.includes('Class ' + v) || curCls.includes(v.replace('Class', '').trim());
                            %>
                            <option value="Class 9" <%= hasCls('9') ? 'selected' : '' %>>Class 9</option>
                            <option value="Class 10" <%= hasCls('10') ? 'selected' : '' %>>Class 10</option>
                            <option value="Class 11" <%= hasCls('11') ? 'selected' : '' %>>Class 11</option>
                            <option value="Class 12" <%= hasCls('12') ? 'selected' : '' %>>Class 12</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-slate-900 dark:text-slate-200 ml-1">Subject</label>
                        <select id="wizSubject" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-medium outline-none focus:border-primary">
                            <% ['Physics','Chemistry','Biology','Higher Mathematics','General Mathematics','Bangla','English','ICT','Accounting','Business Organization','Finance & Banking','Economics'].forEach(s => { %>
                                <option value="<%= s %>" <%= bank.subject === s ? 'selected' : '' %>><%= s %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="sm:col-span-2 space-y-1.5">
                        <label class="text-[11px] font-semibold text-slate-900 dark:text-slate-200 ml-1">Chapter / Topic <span class="text-slate-400 font-normal">(Optional)</span></label>
                        <input type="text" id="wizTopic" placeholder="e.g. Linear Motion" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-medium outline-none focus:border-primary">
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-slate-900 dark:text-slate-200 ml-1">Question Type</label>
                        <select id="wizType" class="w-full h-11 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-medium outline-none focus:border-primary">
                            <option value="MCQ">MCQ</option>
                            <option value="Short">Short answer</option>
                            <option value="Medium">Medium Complexity</option>
                            <option value="Comprehension">Comprehension</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-slate-900 dark:text-slate-200 ml-1">Quantity</label>
                        <input type="number" id="wizCount" value="5" min="1" max="50" class="w-full h-11 px-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[12px] font-medium outline-none focus:border-primary">
                    </div>
                </div>

                <div class="flex items-center gap-3 sm:gap-4">
                    <button onclick="closeWizard()" class="flex-1 h-11 sm:h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[12px] font-semibold hover:bg-slate-200 transition-all">Cancel</button>
                    <button onclick="startComposition()" class="flex-[2] h-11 sm:h-12 rounded-xl bg-slate-900 dark:bg-slate-700 text-white text-[12px] font-semibold hover:bg-black transition-all shadow-md">Make questions</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
