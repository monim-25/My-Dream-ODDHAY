    function toggleQuizSelect() {
        const quizSelect = document.getElementById('quizSelect');
        const bankSelect = document.getElementById('bankSelect');
        const bankSelectContainer = document.getElementById('bankSelectContainer');
        const makeQuizBtnContainer = document.getElementById('makeQuizBtnContainer');
        
        if (quizSelect && quizSelect.value) {
            if (bankSelect) bankSelect.value = ''; // Clear bank selection
            if (bankSelectContainer) bankSelectContainer.classList.add('hidden');
            
            // If it's the freshly created quiz, keep the Done button container visible
            if (redirectQuizCreatedId && quizSelect.value === redirectQuizCreatedId) {
