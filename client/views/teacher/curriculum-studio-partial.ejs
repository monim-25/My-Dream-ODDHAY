        document.getElementById('assetForm').reset();
        document.getElementById('assetParentId').value = '';
        document.getElementById('assetNodeId').value = nodeId;
        document.getElementById('assetModalTitle').innerText = 'Edit Resource';
        document.getElementById('assetTitle').value = node.name;
        
        // Hide subtext, type tabs, and duration fields inside edit resource form
        const subtext = document.getElementById('assetModalSubtext');
        if (subtext) subtext.classList.add('hidden');
        const tabs = document.getElementById('assetTypeTabs');
        if (tabs) tabs.classList.add('hidden');
        const durationField = document.getElementById('durationFieldContainer');
        if (durationField) durationField.classList.add('hidden');
        
        setAssetType(node.type);
        
        if (node.type === 'video') {
            document.getElementById('videoPath').value = node.videoPath || '';
            const thumbPathInput = document.getElementById('thumbnailPath');
            if (thumbPathInput) thumbPathInput.value = node.thumbnail || '';
            document.getElementById('videoDuration').value = node.duration || '';
            document.getElementById('videoDescription').value = node.description || '';

            // Update Image & Video Source Preview Box
            const previewContainer = document.getElementById('videoAssetPreviewContainer');
            const thumbBox = document.getElementById('thumbnailPreviewBox');
            const thumbImg = document.getElementById('thumbnailPreviewImg');
            const vidText = document.getElementById('videoSourceText');
            const thumbText = document.getElementById('thumbnailSourceText');

            let hasPreview = false;
            if (node.videoPath) {
                const fileName = node.videoPath.split('/').pop();
                document.getElementById('videoFileNameDisplay').innerText = fileName;
                document.getElementById('videoFileNameDisplay').classList.add('text-primary', 'font-bold');
                if (vidText) vidText.innerText = 'Video: ' + fileName;
                hasPreview = true;
            }
            if (node.thumbnail) {
                const thumbName = node.thumbnail.split('/').pop();
                document.getElementById('thumbnailFileNameDisplay').innerText = thumbName;
                document.getElementById('thumbnailFileNameDisplay').classList.add('text-primary', 'font-bold');
                if (thumbImg) thumbImg.src = node.thumbnail;
                if (thumbBox) thumbBox.classList.remove('hidden');
                if (thumbText) thumbText.innerText = 'Thumbnail: ' + thumbName;
                hasPreview = true;
            }
            if (previewContainer) {
                if (hasPreview) previewContainer.classList.remove('hidden');
                else previewContainer.classList.add('hidden');
            }
        } else if (node.type === 'note') {
            document.getElementById('filePath').value = node.filePath || '';
        } else if (node.type === 'liveClass') {
            document.getElementById('meetingUrl').value = node.meetingUrl || '';
            if (node.date) {
                const localDate = new Date(node.date);
                const tzOffset = localDate.getTimezoneOffset() * 60000;
                const localISODate = new Date(localDate.getTime() - tzOffset).toISOString().slice(0, 16);
                document.getElementById('liveDate').value = localISODate;
            }
        } else if (node.type === 'quiz') {
            await fetchQuizzes();
            document.getElementById('quizSelect').value = node.quizId ? (node.quizId._id || node.quizId) : '';
            toggleQuizSelect();
            if (node.quizId) {
                const quizObj = node.quizId;
                if (quizObj.scheduledAt && new Date(quizObj.scheduledAt) > new Date(node.createdAt || Date.now() - 5000)) {
                    const localDate = new Date(quizObj.scheduledAt);
                    const tzOffset = localDate.getTimezoneOffset() * 60000;
                    const localISODate = new Date(localDate.getTime() - tzOffset).toISOString().slice(0, 16);
                    document.getElementById('quizDate').value = localISODate;
                    document.getElementById('quizMode').value = 'schedule';
                } else {
                    document.getElementById('quizMode').value = 'instant';
                    document.getElementById('quizDate').value = '';
                }
            } else {
                document.getElementById('quizMode').value = 'instant';
                document.getElementById('quizDate').value = '';
            }
            toggleQuizMode();
        }
        
        document.getElementById('assetModal').classList.remove('hidden');
    }

    async function handleAssetSubmit(event) {
        event.preventDefault();
        const form = document.getElementById('assetForm');
        const formData = new FormData(form);
        
        const nodeId = document.getElementById('assetNodeId').value;
        const isEdit = !!nodeId;
        const type = document.getElementById('assetType').value;
        
        const fileInputVideo = document.getElementById('videoFile');
        const fileInputNote = document.getElementById('noteFile');

        if (!isEdit && type === 'video' && fileInputVideo.files.length > 0) {
            const file = fileInputVideo.files[0];
            try {
                const durationStr = await new Promise((resolve) => {
                    const video = document.createElement('video');
                    video.preload = 'metadata';
                    video.onloadedmetadata = function() {
                        window.URL.revokeObjectURL(video.src);
                        const h = Math.floor(video.duration / 3600);
                        const m = Math.floor((video.duration % 3600) / 60).toString().padStart(2, '0');
                        const s = Math.floor(video.duration % 60).toString().padStart(2, '0');
                        resolve(h > 0 ? `${h}:${m}:${s}` : `${m}:${s}`);
                    };
                    video.onerror = () => resolve('');
                    video.src = URL.createObjectURL(file);
                });
                if (durationStr) {
                    formData.append('duration', durationStr);
                }
            } catch (e) {
                console.error("Duration extraction failed:", e);
            }
        }

        const url = isEdit 
            ? `/teacher/course/${currentCourseId}/curriculum/node/${nodeId}`
            : `/teacher/course/${currentCourseId}/curriculum/node`;
            
        const method = isEdit ? 'PUT' : 'POST';
        
        const xhr = new XMLHttpRequest();
        xhr.open(method, url);
        
        const progressContainer = document.getElementById('uploadProgressContainer');
        const progressBar = document.getElementById('uploadProgressBar');
        const progressPercent = document.getElementById('uploadPercent');
        
        const fileInputThumbnail = document.getElementById('thumbnailFile');
        const hasFile = (type === 'video' && ((fileInputVideo && fileInputVideo.files.length > 0) || (fileInputThumbnail && fileInputThumbnail.files.length > 0))) ||
                        (type === 'note' && fileInputNote && fileInputNote.files.length > 0);
                                     
        if (hasFile) {
            progressContainer.classList.remove('hidden');
            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    const percent = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = percent + '%';
                    progressPercent.innerText = percent + '%';
                }
            };
        }
        
        xhr.onload = function() {
            const progressContainer = document.getElementById('uploadProgressContainer');
            const progressBar = document.getElementById('uploadProgressBar');
            const progressPercent = document.getElementById('uploadPercent');
            
            if (xhr.status >= 200 && xhr.status < 300) {
                const res = JSON.parse(xhr.responseText);
                if (res.success) {
                    const statusText = document.querySelector('#uploadProgressContainer span.animate-pulse');
                    if (statusText) {
                        statusText.innerText = 'Uploading Successful!';
                        statusText.classList.remove('animate-pulse');
                        statusText.classList.add('text-emerald-500');
                    }
                    // Check if it's an instant live class to redirect immediately
                    const liveMode = document.getElementById('liveMode')?.value;
                    if (type === 'liveClass' && liveMode === 'instant' && res.node && res.node.meetingUrl) {
                        if (statusText) {
                            statusText.innerText = 'Redirecting to Live Room...';
                            statusText.classList.remove('animate-pulse');
                            statusText.classList.add('text-emerald-500');
                        }
                        setTimeout(() => {
                            window.location.href = `/live/${res.node.meetingUrl}`;
                        }, 1000);
                        return;
                    }

                    setTimeout(() => {
                        closeAssetModal();
                        fetchAndRenderCurriculum();
                        // Reset progress after closing
                        if (progressContainer) progressContainer.classList.add('hidden');
                        if (progressBar) progressBar.style.width = '0%';
                        if (progressPercent) progressPercent.innerText = '0%';
                        if (statusText) {
                            statusText.innerText = 'Uploading file...';
                            statusText.classList.add('animate-pulse');
                            statusText.classList.remove('text-emerald-500');
                        }
                    }, 1500);
                } else {
                    alert('Error: ' + (res.error || 'Server error saving asset'));
                    if (progressContainer) progressContainer.classList.add('hidden');
                }
            } else {
                alert('Request failed');
                if (progressContainer) progressContainer.classList.add('hidden');
            }
        };
        
        xhr.onerror = function() {
            alert('Network error during transfer');
            progressContainer.classList.add('hidden');
        };
        
        xhr.send(formData);
    }

    let activeDeleteNodeId = null;
    let selectedNodeIds = [];
    
    function confirmDeleteNode(nodeId, nodeName, isFolder) {
        activeDeleteNodeId = nodeId;
        const modalText = document.getElementById('deleteModalText');
        if (isFolder) {
            modalText.innerText = `Are you sure you want to delete "${nodeName}"? This folder and all its recursively nested sub-folders and child assets will be deleted permanently.`;
        } else {
            modalText.innerText = `Are you sure you want to delete the resource asset "${nodeName}"? This action cannot be undone.`;
        }
        
        document.getElementById('confirmDeleteBtn').onclick = handleDeleteConfirm;
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        activeDeleteNodeId = null;
        selectedNodeIds = [];
    }

    async function handleDeleteConfirm() {
        if (!activeDeleteNodeId) return;
        try {
            const res = await fetch(`/teacher/course/${currentCourseId}/curriculum/node/${activeDeleteNodeId}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                closeDeleteModal();
                fetchAndRenderCurriculum();
            } else {
                alert('Error: ' + data.error);
            }
        } catch (err) {
            console.error(err);
            alert('Failed to delete node');
        }
    }

    setInterval(() => {
        document.querySelectorAll('.countdown-timer').forEach(el => {
            const time = new Date(el.getAttribute('data-time')).getTime();
            const now = new Date().getTime();
            const diff = time - now;
            
            if (diff <= 0) {
                el.innerText = 'Starting...';
                el.classList.remove('countdown-timer');
            } else {
                const hours = Math.floor(diff / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                
                el.innerText = `${hours}h ${minutes}m ${seconds}s`;
            }
        });
    }, 1000);

    window.addEventListener('DOMContentLoaded', () => {
        fetchAndRenderCurriculum();
        
        // Auto-open quiz composer modal if redirected from quiz editor
        if (redirectQuizCreatedId) {
            triggerAssetCompose('quiz');
            // Immediately clean up URL query parameters so page refresh/nav back doesn't auto-open composer again
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
        }

        // Setup HTML5 video progress saver & restore speed settings listeners
        const videoEl = document.getElementById('playerVideoEl');
        if (videoEl) {
            let lastSavedTime = 0;
            let lastServerSyncTime = 0;
            videoEl.addEventListener('timeupdate', () => {
                if (!activePlayingNodeId) return;
                const now = videoEl.currentTime;
                // Save locally every 2 seconds
                if (Math.abs(now - lastSavedTime) > 2) {
                    localStorage.setItem(`video-progress-${currentUserId}-${activePlayingNodeId}`, now);
                    lastSavedTime = now;
                }
                
                // Sync to server every 10 seconds
                if (Math.abs(now - lastServerSyncTime) > 10 && typeof currentCourseId !== 'undefined') {
                    lastServerSyncTime = now;
                    const isCompleted = videoEl.duration && (videoEl.duration - now) < 5;
                    fetch(`/api/course/${currentCourseId}/progress/${activePlayingNodeId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ progress: now, completed: isCompleted })
                    }).catch(console.error);
                }
            });
            videoEl.addEventListener('pause', () => {
                if (activePlayingNodeId) {
                    localStorage.setItem(`video-progress-${currentUserId}-${activePlayingNodeId}`, videoEl.currentTime);
                    if (typeof currentCourseId !== 'undefined') {
                        const isCompleted = videoEl.duration && (videoEl.duration - videoEl.currentTime) < 5;
                        fetch(`/api/course/${currentCourseId}/progress/${activePlayingNodeId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ progress: videoEl.currentTime, completed: isCompleted })
                        }).catch(console.error);
                    }
                }
            });
            // Keep playback rate synced if changed via native video controls three-dot menu
            videoEl.addEventListener('ratechange', () => {
                if (videoEl.playbackRate) {
                    localStorage.setItem('video-speed', videoEl.playbackRate.toString());
                }
            });
        }

        // Periodically poll for new comments silently to enable live updates
        setInterval(() => {
            if (!activePlayingNodeId) return;
            
            // Do not poll if user is actively writing a new comment or interacting with reply/edit forms
            const mainInput = document.getElementById('commentInput');
            if (mainInput && document.activeElement === mainInput && mainInput.value.trim() !== '') return;
            
            const openForms = document.querySelectorAll('[id^="reply-form-"]:not(.hidden), [id^="edit-comment-form-"]:not(.hidden), [id^="edit-reply-form-"]:not(.hidden)');
            if (openForms.length > 0) return;
            
            // Silently poll the current comments state without rendering the loading spinner
            loadNodeComments(activePlayingNodeId, false, true);
        }, 5000); // Check for live comments every 5 seconds
    });



    // Bulk Delete Handlers
    function toggleSelectionMode() {
        selectionMode = !selectionMode;
        const container = document.getElementById('curriculum-tree-container');
        const btnText = document.getElementById('selectionText');
        const btnIcon = document.getElementById('selectionIcon');
        
        if (selectionMode) {
            container.classList.add('selection-active');
            if (btnText) btnText.innerText = 'Cancel Selection';
            if (btnIcon) btnIcon.innerText = 'close';
        } else {
            container.classList.remove('selection-active');
            if (btnText) btnText.innerText = 'Select Items';
            if (btnIcon) btnIcon.innerText = 'checklist';
            
            // Clear selections
            const checkboxes = document.querySelectorAll('.node-select-checkbox');
            checkboxes.forEach(cb => cb.checked = false);
            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) selectAll.checked = false;
            
            handleCheckboxChange();
        }
    }

    function handleCheckboxChange() {
        const checkboxes = document.querySelectorAll('.node-select-checkbox');
        const checked = document.querySelectorAll('.node-select-checkbox:checked');
        const selectAll = document.getElementById('selectAllCheckbox');
        const batchBar = document.getElementById('batchActionBar');
        const selectedCount = document.getElementById('selectedCountText');

        if (checked.length > 0) {
            if (batchBar) batchBar.classList.remove('hidden');
            if (selectedCount) selectedCount.innerText = `${checked.length} selected`;
            if (selectAll) {
                selectAll.checked = (checked.length === checkboxes.length);
            }
        } else {
            if (batchBar) batchBar.classList.add('hidden');
            if (selectAll) selectAll.checked = false;
        }
    }

    function toggleSelectAll(selectAllCheckbox) {
        const isChecked = selectAllCheckbox.checked;
        const checkboxes = document.querySelectorAll('.node-select-checkbox');
        checkboxes.forEach(cb => {
            cb.checked = isChecked;
        });
        handleCheckboxChange();
    }

    function handleRowClick(nodeId, event, isFolder) {
        // If clicking a button or checkbox, let the browser handle it naturally
        if (event.target.closest('button') || event.target.closest('input[type="checkbox"]')) {
            return;
        }
        
        if (selectionMode) {
            event.preventDefault();
            
            // Find the checkbox inside this row and toggle it!
            const row = event.currentTarget;
            const cb = row.querySelector('.node-select-checkbox');
            if (cb) {
                cb.checked = !cb.checked;
                handleCheckboxChange();
            }
        } else {
            // Standard action
            if (isFolder) {
                openFolder(nodeId);
            } else {
                const node = curriculumNodes.find(n => n._id === nodeId);
                if (node) {
                    playVideoNode(node, false, true);
                }
            }
        }
    }

    function deleteSelectedNodes() {
        const checked = document.querySelectorAll('.node-select-checkbox:checked');
        if (checked.length === 0) return;

        const count = checked.length;
        selectedNodeIds = Array.from(checked).map(cb => cb.getAttribute('data-id'));

        const modalText = document.getElementById('deleteModalText');
        if (modalText) {
            modalText.innerText = `Are you sure you want to delete the ${count} selected items?`;
        }

        document.getElementById('confirmDeleteBtn').onclick = handleBulkDeleteConfirm;
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    async function handleBulkDeleteConfirm() {
        if (selectedNodeIds.length === 0) return;
        try {
            const res = await fetch(`/teacher/course/${currentCourseId}/curriculum/nodes/batch-delete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ nodeIds: selectedNodeIds })
            });
            const data = await res.json();
            if (data.success) {
                closeDeleteModal();
                if (selectionMode) {
                    toggleSelectionMode();
                }
                fetchAndRenderCurriculum();
            } else {
                alert('Error: ' + data.error);
            }
        } catch (err) {
            console.error(err);
            alert('Failed to delete selected items');
        }
    }

    // Video Player (in-page panel, same sidebar/navbar chrome)
    const courseInstructorName = `<%= course.instructor ? course.instructor.name.replace(/'/g, "\\'") : 'Course Mentor' %>`;
    const courseInstructorAvatar = `<%= course.instructor ? (course.instructor.profileImage || course.instructor.profilePicture || '/images/default-avatar.png') : '/images/default-avatar.png' %>`;

    function playVideoNode(node, skipHash = false, incrementView = false) {
        if (typeof node === 'string') {
            node = curriculumNodes.find(n => String(n._id) === String(node));
            if (!node) return;
        }

        const panel = document.getElementById('videoPlayerPanel');
        const tree = document.getElementById('curriculum-tree-container');
        const videoEl = document.getElementById('playerVideoEl');
        const iframeEl = document.getElementById('playerIframeEl');
        const emptyState = document.getElementById('playerEmptyState');

        const url = node.videoPath;
        const title = node.name;
        const description = node.description || '';
        const nodeId = node._id;
        
        console.log("Playing node:", node.name, "Type:", node.type, "URL:", url);

        if (!url) {
            console.error("No video path found for this node");
            // If it's a note or quiz, maybe we shouldn't even call playVideoNode!
            if (node.type === 'note' && node.filePath) {
                window.open(node.filePath, '_blank');
                return;
            } else if (node.type === 'quiz') {
                const qId = (node.quizId && node.quizId._id) ? node.quizId._id : (node.quizId || node._id);
                window.open(`/teacher/quiz-details/${qId}`, '_blank');
                return;
            } else if (node.type === 'liveClass') {
                window.open(`/live/${node.meetingUrl || node._id}`, '_blank');
                return;
            }
            alert('This item does not have a valid video attached.');
            return;
        }

        // Extract Author Info
        let authorName = courseInstructorName;
        let authorAvatar = courseInstructorAvatar;
        
        if (node.addedBy) {
            authorName = node.addedBy.name || authorName;
            authorAvatar = node.addedBy.profileImage || node.addedBy.profilePicture || authorAvatar;
        }

        // Reset elements
        videoEl.onerror = null; // Clean up error handler before resetting src to prevent stray alerts
        videoEl.classList.add('hidden');
        videoEl.src = '';
        iframeEl.classList.add('hidden');
        iframeEl.src = '';
        emptyState.classList.add('hidden');

        // Detect URL type and load
        if (url.includes('youtube.com') || url.includes('youtu.be')) {
            let embedUrl = url;
            if (url.includes('watch?v=')) {
                embedUrl = 'https://www.youtube.com/embed/' + url.split('v=')[1].split('&')[0] + '?autoplay=1';
            } else if (url.includes('youtu.be/')) {
                embedUrl = 'https://www.youtube.com/embed/' + url.split('youtu.be/')[1].split('?')[0] + '?autoplay=1';
            }
            iframeEl.src = embedUrl;
            iframeEl.classList.remove('hidden');
        } else if (url.includes('vimeo.com')) {
            const videoId = url.split('vimeo.com/')[1].split('?')[0];
            iframeEl.src = 'https://player.vimeo.com/video/' + videoId + '?autoplay=1';
            iframeEl.classList.remove('hidden');
        } else {
            videoEl.src = url;
            videoEl.classList.remove('hidden');
            
            // Restore playback speed state
            const currentSpeed = parseFloat(localStorage.getItem('video-speed') || '1.0');
            videoEl.playbackRate = currentSpeed;
            
            // Add error handling to notify if the browser can't decode the video format
            videoEl.onerror = function() {
                // Only show alert if src is actually valid and not empty or during a deliberate state reset
                if (videoEl.src && videoEl.src !== window.location.href) {
                    alert('Error: The browser cannot play this video format. Make sure it is a standard MP4 (H.264 codec).');
                }
            };
            
            videoEl.load();
            
            // Resume watch progress from localStorage
            const savedProgress = localStorage.getItem(`video-progress-${currentUserId}-${nodeId}`);
            if (savedProgress) {
                const resumeTime = parseFloat(savedProgress);
                videoEl.addEventListener('loadedmetadata', function onLoaded() {
                    // Only resume if user had progress left and wasn't at the very end of the video
                    if (resumeTime < videoEl.duration - 5) {
                        videoEl.currentTime = resumeTime;
                    }
                    videoEl.removeEventListener('loadedmetadata', onLoaded);
                });
            }
            
            videoEl.play().catch((e) => { 
                console.error("Video playback error:", e);
                if(e.name !== 'NotAllowedError' && e.name !== 'AbortError') {
                    alert('Video playback error: ' + e.message);
                }
            });
        }

        // Populate metadata
        document.getElementById('playerVideoTitle').innerText = title || 'Untitled Lesson';
        
        const descEl = document.getElementById('playerVideoDesc');
        const descToggleBtn = document.getElementById('descToggleBtn');
        descEl.innerText = description || 'No detailed description is available for this video lesson.';
        
        // Reset description state
        descEl.classList.add('line-clamp-2');
        descToggleBtn.innerText = 'Details';
        
        // Use a short timeout to let the browser render the text so we can check its height
        setTimeout(() => {
            if (descEl.scrollHeight > descEl.clientHeight || description.length > 150) {
                descToggleBtn.classList.remove('hidden');
            } else {
                descToggleBtn.classList.add('hidden');
            }
        }, 50);
        // Set active playing node
        activePlayingNodeId = nodeId;

        document.getElementById('playerVideoViews').innerText = formatCount(node.views || 0);
        document.getElementById('playerVideoComments').innerText = '0';
        document.getElementById('playerAuthorName').innerText = authorName;
        document.getElementById('playerAuthorAvatar').src = authorAvatar;

        // Async views tracking and comments fetch
        if (incrementView) {
            incrementNodeView(nodeId);
        }
        loadNodeComments(nodeId);
        renderCoursePlaylist();

        // Write hash so refresh restores this video
        if (!skipHash && nodeId) {
            window.location.hash = 'video-' + nodeId;
        }

        // Switch views
        tree.classList.add('hidden');
        panel.classList.remove('hidden');
        
        // Scroll to top of content
        const scrollArea = document.getElementById('content-scroll-area') || document.querySelector('.content-scroll');
        if (scrollArea) scrollArea.scrollTo({ top: 0, behavior: 'smooth' });
    }

