

<style>
    /* Checkbox & Select All visibility based on selection mode */
    #curriculum-tree-container:not(.selection-active) .node-select-col {
        display: none !important;
    }
    #curriculum-tree-container:not(.selection-active) #selectAllHeader {
        display: none !important;
    }
    /* Cursor pointer for all rows when selection is active */
    #curriculum-tree-container.selection-active .group {
        cursor: pointer !important;
    }
</style>

<!-- Tree View Container -->
<div id="curriculum-tree-container" class="space-y-4">
    <div class="py-20 text-center">
        <div class="inline-block size-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs font-bold text-slate-400 mt-4">Loading Curriculum Studio...</p>
    </div>
</div>

<!-- In-Page Video Player Panel (slides in over the curriculum tree, same page chrome) -->
<div id="videoPlayerPanel" class="hidden -mx-5 -mt-5">

    <!-- Main Layout: Top row (video | playlist), Bottom (metadata + comments) -->
    <div class="max-w-[1600px] w-full mx-auto flex flex-col gap-2">
        
        <!-- TOP ROW: Video (left) | Playlist (right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start">
            <!-- LEFT: Video Player & Metadata -->
            <div class="lg:col-span-7 flex flex-col">
                <div class="overflow-hidden">
                    <div class="w-full aspect-video bg-black">
                        <video id="playerVideoEl" controls class="w-full h-full object-contain hidden" controlsList="nodownload"></video>
                        <iframe id="playerIframeEl" class="w-full h-full border-0 hidden" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                        <div id="playerEmptyState" class="w-full h-full flex items-center justify-center bg-slate-900">
                            <span class="material-symbols-rounded text-slate-600 text-6xl">play_circle</span>
                        </div>
                    </div>
                </div>

                <!-- METADATA BLOCK -->
                <div class="space-y-4 py-4 px-4 md:px-6">
                    <h2 class="text-xl font-medium text-slate-900 dark:text-white leading-snug flex items-center gap-2">
                        <span id="playerVideoTitle">Lesson Title</span>
                        <button type="button" onclick="openEditAssetModal(activePlayingNodeId)" class="p-1 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 hover:text-primary transition-all rounded-none inline-flex items-center justify-center shrink-0" title="Edit Lesson Title & Description">
                            <span class="material-symbols-rounded text-base leading-none">edit</span>
                        </button>
                    </h2>

                    <div class="flex items-center gap-5 pb-3 border-b border-slate-100 dark:border-white/5">
                        <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500">
                            <span class="material-symbols-rounded text-[16px] text-slate-400">visibility</span>
                            <span id="playerVideoViews">0</span> views
                        </div>
                        <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500">
                            <span class="material-symbols-rounded text-[16px] text-slate-400">comment</span>
                            <span id="playerVideoComments">0</span> comments
                        </div>
                    </div>

                    <div class="pt-3 pb-1 flex items-center gap-3">
                        <div class="size-10 rounded-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 shrink-0">
                            <img id="playerAuthorAvatar" src="/images/default-avatar.png" class="size-full object-cover" alt="Author">
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 id="playerAuthorName" class="text-[15px] font-semibold text-slate-800 dark:text-slate-200 leading-tight">Instructor Name</h4>
                        </div>
                    </div>

                    <div class="relative group !mt-3 p-3 bg-slate-50 dark:bg-white/5 rounded-md border border-slate-100 dark:border-white/10">
                        <p id="playerVideoDesc" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium line-clamp-2 whitespace-pre-wrap break-words">
                            No description available for this lesson.
                        </p>
                        <button id="descToggleBtn" type="button" class="hidden text-[12px] font-bold text-primary hover:underline mt-1" onclick="toggleDescription()">
                            Details
                        </button>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Course Playlist -->
            <div class="hidden lg:flex lg:col-span-5 flex-col">
                <div class="flex flex-col sticky top-6" style="max-height: calc(100vh - 100px);">
                    <div class="flex items-center justify-between p-3 border-b border-slate-100 dark:border-white/5 shrink-0 gap-2">
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span class="material-symbols-rounded text-slate-400 text-[18px]">playlist_play</span>
                            <h3 class="text-xs font-bold text-slate-800 dark:text-white hidden sm:block">Course Playlist</h3>
                            <span id="playlistCountBadge" class="px-1.5 py-0.5 bg-slate-100 dark:bg-white/5 text-slate-500 rounded-full text-[9px] font-bold"></span>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0 w-40 md:w-52">
                            <div class="relative flex-1">
                                <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-[14px] text-slate-400">search</span>
                                <input type="text" id="playlistSearchInput" oninput="filterPlaylist()" placeholder="Search..." class="w-full pl-8 pr-3 py-1.5 text-[11px] bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-full focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-slate-700 dark:text-slate-300 placeholder-slate-400">
                            </div>
                            <button type="button" onclick="filterPlaylist()" class="size-7 flex items-center justify-center shrink-0 bg-slate-900 dark:bg-white hover:bg-primary dark:hover:bg-primary text-white dark:text-slate-900 dark:hover:text-white rounded-full transition-all shadow-sm">
                                <span class="material-symbols-rounded text-[14px]">search</span>
                            </button>
                        </div>
                    </div>
                    <div id="playlistContainer" class="flex-1 overflow-y-auto p-2 space-y-0.5 min-h-[300px]">
                        <div class="flex flex-col items-center justify-center text-center py-12 opacity-60">
                            <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">playlist_play</span>
                            <p class="text-xs font-medium text-slate-500">No lessons yet</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM AREA: Comments -->
        <div class="flex flex-col gap-2 px-4 md:px-6 pb-6">
            <!-- COMMENTS BLOCK -->
            <div class="py-2">
                <div class="flex items-center gap-4 mb-4 pb-3 border-b border-slate-100 dark:border-white/5 flex-wrap">
                    <div class="flex items-center gap-2 shrink-0">
                        <span class="material-symbols-rounded text-slate-400">forum</span>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white">Comments</h3>
                        <span id="commentsCountBadge" class="px-2 py-0.5 bg-slate-100 dark:bg-white/5 text-slate-500 rounded-full text-[10px] font-bold">0</span>
                    </div>
                    <% if (hasEditAccess) { %>
                                                        <button type="button" id="toggleCommentsBtn" onclick="toggleNodeCommentsSetting()" class="text-xs font-bold px-3 py-1 bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-white/10 transition-all rounded-none flex items-center gap-1.5 shrink-0">
                        <span class="material-symbols-rounded text-[15px]" id="toggleCommentsIcon">chat</span>
                        <span id="toggleCommentsText">Turn off/on</span>
                                                        </button>
                                                        <% } %>
                </div>
                <div id="commentsDisabledBanner" class="hidden p-2.5 mb-3 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/30 text-amber-800 dark:text-amber-300 text-xs font-semibold rounded-none flex items-center gap-2 shrink-0">
                    <span class="material-symbols-rounded text-[16px]">info</span>
                    <span>Comments are currently turned off for students.</span>
                </div>
                <form id="commentForm" onsubmit="submitComment(event)" class="mb-4 shrink-0">
                    <textarea id="commentInput" rows="2" oninput="this.style.height = 'auto'; this.style.height = this.scrollHeight + 'px';" placeholder="Add a public comment..." required class="w-full text-sm p-2.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 focus:outline-none focus:border-primary rounded-none resize-y text-slate-800 dark:text-white leading-relaxed min-h-[50px]"></textarea>
                    <div class="flex justify-end mt-2">
                        <button type="submit" class="px-4 py-1.5 bg-primary hover:bg-primary/95 text-white text-[11px] font-bold uppercase tracking-wider rounded-none shadow transition-all">Comment</button>
                    </div>
                </form>
                <div id="commentsList" class="space-y-4 pr-1">
                    <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                        <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                        <p class="text-xs font-medium text-slate-500">No comments yet</p>
                        <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                    </div>
                </div>
                <div id="loadMoreCommentsContainer" class="mt-4 pt-2 text-center hidden shrink-0">
                    <button type="button" onclick="loadNextCommentsPage()" class="w-full py-2 border border-slate-200 dark:border-white/10 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all rounded-none uppercase tracking-wider">
                        Load More Comments
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Folder Composer Modal -->
<div id="folderModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#000]/80 backdrop-blur-sm transition-all duration-300">
    <div class="w-full max-w-lg bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-none shadow-2xl p-8 relative">
        <button type="button" onclick="closeFolderModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors">
            <span class="material-symbols-rounded">close</span>
        </button>
        
        <h3 id="folderModalTitle" class="text-base font-bold text-slate-800 dark:text-white mb-6">Create Folder</h3>
        
        <form id="folderForm" onsubmit="handleFolderSubmit(event)" class="space-y-4">
            <input type="hidden" id="folderParentId" name="parentId">
            <input type="hidden" id="folderNodeId" name="nodeId">
            
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Folder Name</label>
                <input type="text" id="folderName" name="name" required placeholder="e.g. Chapter 1: Introduction"
                       class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
            </div>
            
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeFolderModal()" 
                        class="px-4 py-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider rounded-none hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                    Cancel
                </button>
                <button type="submit" 
                        class="px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold uppercase tracking-wider rounded-none hover:bg-primary dark:hover:bg-primary dark:hover:text-white transition-all">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Unified Asset Composer Modal -->
<div id="assetModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#000]/80 backdrop-blur-sm transition-all duration-300">
    <div class="w-full max-w-lg bg-white dark:bg-[#0b1120] border border-slate-200 dark:border-white/10 rounded-none shadow-2xl p-6 relative max-h-[90vh] overflow-y-auto">
        <button type="button" onclick="closeAssetModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors">
            <span class="material-symbols-rounded">close</span>
        </button>
        
        <h3 id="assetModalTitle" class="text-base font-bold text-slate-800 dark:text-white mb-1">Add Content</h3>
        <p id="assetModalSubtext" class="text-xs font-semibold text-slate-400 mb-4">Curriculum Asset</p>
        
        <!-- Type Tabs Selector -->
        <div id="assetTypeTabs" class="grid grid-cols-4 gap-1 p-1 bg-slate-100 dark:bg-white/5 rounded-none mb-6">
            <button type="button" onclick="setAssetType('video')" id="tab-type-video"
                    class="py-2 text-xs font-semibold text-center transition-all rounded-none bg-slate-900 dark:bg-white text-white dark:text-slate-900">
                Video Lesson
            </button>
            <button type="button" onclick="setAssetType('note')" id="tab-type-note"
                    class="py-2 text-xs font-semibold text-center transition-all rounded-none text-slate-500 hover:text-slate-800 dark:hover:text-white">
                Note
            </button>
            <button type="button" onclick="setAssetType('liveClass')" id="tab-type-liveClass"
                    class="py-2 text-xs font-semibold text-center transition-all rounded-none text-slate-500 hover:text-slate-800 dark:hover:text-white">
                Live Class
            </button>
            <button type="button" onclick="setAssetType('quiz')" id="tab-type-quiz"
                    class="py-2 text-xs font-semibold text-center transition-all rounded-none text-slate-500 hover:text-slate-800 dark:hover:text-white">
                Exam
            </button>
        </div>
        
        <form id="assetForm" onsubmit="handleAssetSubmit(event)" class="space-y-4" enctype="multipart/form-data">
            <input type="hidden" id="assetParentId" name="parentId">
            <input type="hidden" id="assetNodeId" name="nodeId">
            <input type="hidden" id="assetType" name="type" value="video">
            
            <!-- Asset Title -->
            <div>
                <label id="assetTitleLabel" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Title</label>
                <input type="text" id="assetTitle" name="name" required placeholder="e.g. Introduction to Friction forces"
                       class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
            </div>
            
            <!-- Dynamic Fields: Video -->
            <div id="fields-video" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Video File</label>
                        <div class="relative">
                            <input type="file" id="videoFile" name="video" accept="video/*" onchange="updateSelectedFileName(this, 'videoFileNameDisplay')" class="hidden">
                            <button type="button" onclick="document.getElementById('videoFile').click()" class="w-full flex items-center justify-between px-3 py-2 text-xs border border-dashed border-slate-300 dark:border-white/20 bg-slate-50 dark:bg-[#0b1120] hover:bg-slate-100 dark:hover:bg-white/5 text-slate-700 dark:text-slate-200 rounded-none transition-all cursor-pointer">
                                <span class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-primary">upload_file</span>
                                    <span id="videoFileNameDisplay" class="truncate font-medium text-slate-600 dark:text-slate-300">Browse Video...</span>
                                </span>
                                <span class="px-2 py-0.5 bg-primary text-white font-semibold text-xs rounded-none shrink-0">Browse</span>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label id="videoPathLabel" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Video URL</label>
                        <input type="text" id="videoPath" name="videoPath" placeholder="e.g. /uploads/videos/file.mp4"
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Thumbnail Image</label>
                        <div class="relative">
                            <input type="file" id="thumbnailFile" name="thumbnail" accept="image/*" onchange="updateSelectedFileName(this, 'thumbnailFileNameDisplay')" class="hidden">
                            <button type="button" onclick="document.getElementById('thumbnailFile').click()" class="w-full flex items-center justify-between px-3 py-2 text-xs border border-dashed border-slate-300 dark:border-white/20 bg-slate-50 dark:bg-[#0b1120] hover:bg-slate-100 dark:hover:bg-white/5 text-slate-700 dark:text-slate-200 rounded-none transition-all cursor-pointer">
                                <span class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-rose-500">add_photo_alternate</span>
                                    <span id="thumbnailFileNameDisplay" class="truncate font-medium text-slate-600 dark:text-slate-300">Browse Thumbnail...</span>
                                </span>
                                <span class="px-2 py-0.5 bg-slate-800 dark:bg-white dark:text-slate-900 text-white font-semibold text-xs rounded-none shrink-0">Browse</span>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Thumbnail URL</label>
                        <input type="text" id="thumbnailPath" name="thumbnailPath" placeholder="e.g. /uploads/thumbnails/cover.jpg"
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div id="durationFieldContainer">
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Duration</label>
                        <input type="text" id="videoDuration" name="duration" placeholder="e.g. 15:30"
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Description</label>
                        <input type="text" id="videoDescription" name="description" placeholder="Short summary..."
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
                <!-- Live Thumbnail & Video Source Preview Box -->
                <div id="videoAssetPreviewContainer" class="hidden p-2.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-none flex items-center gap-3">
                    <div id="thumbnailPreviewBox" class="hidden size-14 rounded-none overflow-hidden bg-black shrink-0 border border-slate-200 dark:border-white/10 relative">
                        <img id="thumbnailPreviewImg" src="" class="size-full object-cover">
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold text-slate-700 dark:text-slate-200 truncate" id="videoSourceText">Video Source</p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate" id="thumbnailSourceText">Thumbnail Image</p>
                    </div>
                </div>
            </div>
            
            <!-- Dynamic Fields: Note -->
            <div id="fields-note" class="hidden space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label id="noteUploadLabel" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Note File</label>
                        <div class="relative">
                            <input type="file" id="noteFile" name="note" accept="application/pdf,image/*" onchange="updateSelectedFileName(this, 'noteFileNameDisplay')" class="hidden">
                            <button type="button" onclick="document.getElementById('noteFile').click()" class="w-full flex items-center justify-between px-3 py-2 text-xs border border-dashed border-slate-300 dark:border-white/20 bg-slate-50 dark:bg-[#0b1120] hover:bg-slate-100 dark:hover:bg-white/5 text-slate-700 dark:text-slate-200 rounded-none transition-all cursor-pointer">
                                <span class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-emerald-500">picture_as_pdf</span>
                                    <span id="noteFileNameDisplay" class="truncate font-medium text-slate-600 dark:text-slate-300">Browse Note...</span>
                                </span>
                                <span class="px-2 py-0.5 bg-emerald-600 text-white font-semibold text-xs rounded-none shrink-0">Browse</span>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label id="notePathLabel" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">File URL</label>
                        <input type="text" id="filePath" name="filePath" placeholder="e.g. /uploads/notes/slide.pdf"
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
            </div>
            
            <!-- Dynamic Fields: Live Class -->
            <div id="fields-liveClass" class="hidden space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Live Type</label>
                        <select id="liveMode" class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all" onchange="toggleLiveMode()">
                            <option value="instant">Instant Live</option>
                            <option value="schedule">Schedule Live</option>
                        </select>
                    </div>
                    <div id="meetingUrlContainer">
                        <label id="liveUrlLabel" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Meeting URL</label>
                        <input type="text" id="meetingUrl" name="meetingUrl" placeholder="Auto-generated if blank"
                               class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
                <div id="scheduleTimeContainer" class="hidden">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Scheduled Date & Time</label>
                    <input type="datetime-local" id="liveDate" name="date"
                           class="w-full px-3 py-1.5 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Description <span class="text-slate-400 font-normal normal-case">(optional)</span></label>
                    <textarea id="liveDescription" name="description" rows="3" placeholder="Enter Description here"
                              class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all resize-none leading-relaxed"></textarea>
                </div>
            </div>
            
            <!-- Dynamic Fields: Quiz -->
            <div id="fields-quiz" class="hidden space-y-4">
                <div id="bankSelectContainer">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Select Question Bank</label>
                    <select id="bankSelect" name="bankId" onchange="toggleBankSelect()"
                            class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                        <option value="">-- Choose Bank (Optional) --</option>
                    </select>
                </div>
                <div id="quizSelectContainer">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Select Previous Exam</label>
                    <select id="quizSelect" name="quizId" onchange="toggleQuizSelect()"
                            class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                        <option value="">-- Choose Previous Exam (Optional) --</option>
                    </select>
                </div>
                <div id="makeQuizBtnContainer">
                    <button type="button" onclick="goToMakeQuiz('<%= course._id %>')" class="inline-block px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold uppercase tracking-wider rounded-none hover:bg-primary dark:hover:bg-primary dark:hover:text-white transition-all">
                        Make Quize
                    </button>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Exam Type</label>
                        <select id="quizMode" name="quizMode" class="w-full px-3 py-2 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all" onchange="toggleQuizMode()">
                            <option value="instant">Instant Exam</option>
                            <option value="schedule">Scheduled Exam</option>
                        </select>
                    </div>
                    <div id="quizScheduleTimeContainer" class="hidden">
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Scheduled Date & Time</label>
                        <input type="datetime-local" id="quizDate" name="quizDate"
                               class="w-full px-3 py-1.5 text-xs border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#0b1120] text-slate-800 dark:text-white rounded-none focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>
            </div>
            
            <!-- Progress Bar -->
            <div id="uploadProgressContainer" class="hidden space-y-1.5 pt-2">
                <div class="flex items-center justify-between text-[10px] font-bold">
                    <span class="text-primary uppercase tracking-widest animate-pulse">Uploading file...</span>
                    <span id="uploadPercent" class="font-mono text-slate-600 dark:text-slate-400">0%</span>
                </div>
                <div class="h-1.5 w-full bg-slate-100 dark:bg-white/5 rounded-none overflow-hidden">
                    <div id="uploadProgressBar" class="h-full bg-primary transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>
            
            <div class="flex justify-end gap-2 pt-4 border-t border-slate-100 dark:border-white/5">
                <button type="button" onclick="closeAssetModal()" 
                        class="px-4 py-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-semibold rounded-none hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                    Cancel
                </button>
                <button type="submit" id="assetSubmitBtn" 
                        class="px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-semibold rounded-none hover:bg-primary dark:hover:bg-primary dark:hover:text-white transition-all">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Recursive Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#000]/80 backdrop-blur-sm transition-all duration-300">
    <div class="w-full max-w-sm bg-white dark:bg-[#0b1120] border border-red-500/20 dark:border-red-500/30 rounded-none shadow-2xl p-6 relative">
        <div class="size-12 bg-red-50 dark:bg-red-500/10 text-red-500 flex items-center justify-center mb-4">
            <span class="material-symbols-rounded text-2xl">warning</span>
        </div>
        
        <h3 class="text-base font-bold text-slate-800 dark:text-white mb-2">Delete Curriculum Element?</h3>
        <p id="deleteModalText" class="text-xs text-slate-500 dark:text-slate-400 mb-6 leading-relaxed">
            Are you sure you want to delete this folder? This action is permanent and will recursively delete all nested sub-folders and child assets.
        </p>
        
        <div class="flex justify-end gap-2">
            <button type="button" onclick="closeDeleteModal()" 
                    class="px-4 py-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider rounded-none hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                Cancel
            </button>
            <button type="button" id="confirmDeleteBtn"
                    class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold uppercase tracking-wider rounded-none transition-all">
                Confirm Delete
            </button>
        </div>
    </div>
</div>

<!-- Dropdown popover menu for adding assets -->
<div id="assetTypePopover" class="absolute hidden z-50 bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-white/10 shadow-xl rounded-none py-2 min-w-[180px] animate-fade-in">
    <button type="button" onclick="triggerAssetCompose('video')" class="w-full text-left px-4 py-3 hover:bg-slate-50 dark:hover:bg-white/5 text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-3">
        <span class="material-symbols-rounded text-[20px] leading-none flex-shrink-0 text-blue-500 flex items-center justify-center">play_circle</span>
        <span>Video Lesson</span>
    </button>
    <button type="button" onclick="triggerAssetCompose('note')" class="w-full text-left px-4 py-3 hover:bg-slate-50 dark:hover:bg-white/5 text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-3">
        <span class="material-symbols-rounded text-[20px] leading-none flex-shrink-0 text-emerald-500 flex items-center justify-center">description</span>
        <span>Resource Note</span>
    </button>
    <button type="button" onclick="triggerAssetCompose('liveClass')" class="w-full text-left px-4 py-3 hover:bg-slate-50 dark:hover:bg-white/5 text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-3">
        <span class="material-symbols-rounded text-[20px] leading-none flex-shrink-0 text-purple-500 flex items-center justify-center">podcasts</span>
        <span>Live Class</span>
    </button>
    <button type="button" onclick="triggerAssetCompose('quiz')" class="w-full text-left px-4 py-3 hover:bg-slate-50 dark:hover:bg-white/5 text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-3">
        <span class="material-symbols-rounded text-[20px] leading-none flex-shrink-0 text-amber-500 flex items-center justify-center">psychology</span>
        <span>Link Exam</span>
    </button>
</div>

<script>
    const currentUserId = '<%= user._id %>';
    let openCommentReplies = new Set();
    const currentCourseId = '<%= course._id %>';
    const currentCourseSubject = '<%= course.subject %>';
    const currentCourseClass = '<%= course.classLevel %>';
    let curriculumNodes = [];
    let currentFolderId = null;
    let activePopoverParentId = null;
    let redirectQuizCreatedId = new URLSearchParams(window.location.search).get('quizCreatedId') || '';
    let selectionMode = false;
    let activePlayingNodeId = null;

    // Initialize state from URL hash if present
    let pendingVideoNodeId = null;
    const initialHash = window.location.hash;
    if (initialHash && initialHash.startsWith('#folder-')) {
        currentFolderId = initialHash.replace('#folder-', '');
    } else if (initialHash && initialHash.startsWith('#video-')) {
        pendingVideoNodeId = initialHash.replace('#video-', '');
    }

    function filterPlaylist() {
        const input = document.getElementById('playlistSearchInput');
        const filter = input.value.toLowerCase();
        const playlistContainer = document.getElementById('playlistContainer');
        if (!playlistContainer) return;
        
        const items = playlistContainer.querySelectorAll('div.group');
        let visibleCount = 0;
        
        items.forEach(item => {
            const textContent = item.textContent || item.innerText;
            if (textContent.toLowerCase().includes(filter)) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });
        
        // Show empty state if nothing found
        let emptyState = playlistContainer.querySelector('.empty-playlist-msg');
        if (visibleCount === 0 && items.length > 0) {
            if (!emptyState) {
                const msg = document.createElement('div');
                msg.className = 'empty-playlist-msg flex flex-col items-center justify-center text-center py-12 opacity-60';
                msg.innerHTML = '<span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">search_off</span><p class="text-xs font-medium text-slate-500">No matching lessons found</p>';
                playlistContainer.appendChild(msg);
            }
        } else if (emptyState) {
            emptyState.remove();
        }
    }

    function stopVideoPlayback() {
        const videoEl = document.getElementById('playerVideoEl');
        const iframeEl = document.getElementById('playerIframeEl');
        if (videoEl) {
            if (activePlayingNodeId && videoEl.currentTime > 0) {
                localStorage.setItem(`video-progress-${currentUserId}-${activePlayingNodeId}`, videoEl.currentTime);
            }
            videoEl.onerror = null; // Clean up error handler before clearing src to prevent stray alerts
            videoEl.pause();
            videoEl.src = '';
        }
        if (iframeEl) {
            iframeEl.src = '';
        }
        activePlayingNodeId = null;
    }

    // Sync state with browser back/forward navigation
    window.addEventListener('hashchange', () => {
        const hash = window.location.hash;
        if (hash && hash.startsWith('#folder-')) {
            currentFolderId = hash.replace('#folder-', '');
            stopVideoPlayback();
            // Show tree, hide player
            document.getElementById('videoPlayerPanel').classList.add('hidden');
            document.getElementById('curriculum-tree-container').classList.remove('hidden');
            renderCurriculumTree();
        } else if (hash && hash.startsWith('#video-')) {
            // Restore video player from hash (do NOT increment views!)
            const nodeId = hash.replace('#video-', '');
            const node = curriculumNodes.find(n => n._id === nodeId);
            if (node && node.videoPath) {
                playVideoNode(node, true, false);
            }
        } else {
            // Back to root — show tree
            currentFolderId = null;
            stopVideoPlayback();
            const panel = document.getElementById('videoPlayerPanel');
            const tree = document.getElementById('curriculum-tree-container');
            if (panel && !panel.classList.contains('hidden')) {
                panel.classList.add('hidden');
                tree.classList.remove('hidden');
            }
            renderCurriculumTree();
        }
    });

    // Fetch and Render Curriculum Tree
    async function fetchAndRenderCurriculum() {
        try {
            const res = await fetch(`/teacher/course/${currentCourseId}/curriculum`);
            const data = await res.json();
            curriculumNodes = data.nodes || [];
            
            // Sync player metadata instantly if currently playing
            if (activePlayingNodeId) {
                const node = curriculumNodes.find(n => n._id === activePlayingNodeId);
                if (node) {
                    document.getElementById('playerVideoTitle').innerText = node.name || 'Untitled Lesson';
                    const descEl = document.getElementById('playerVideoDesc');
                    const descToggleBtn = document.getElementById('descToggleBtn');
                    descEl.innerText = node.description || 'No detailed description is available for this video lesson.';
                    
                    // Reset description clamp state cleanly
                    descEl.classList.add('line-clamp-2');
                    descToggleBtn.innerText = 'Details';
                    
                    // Trigger length check for clamp details toggle
                    if (descEl.scrollHeight > descEl.clientHeight || (node.description || '').length > 150) {
                        descToggleBtn.classList.remove('hidden');
                    } else {
                        descToggleBtn.classList.add('hidden');
                    }
                }
            }

            // Restore video player if hash pointed to a video
            if (pendingVideoNodeId) {
                const node = curriculumNodes.find(n => n._id === pendingVideoNodeId);
                if (node && node.videoPath) {
                    playVideoNode(node, true, false);
                }
                pendingVideoNodeId = null;
            } else {
                renderCurriculumTree();
            }
        } catch (e) {
            console.error('Failed to load curriculum:', e);
        }
    }

    // Recursive child node collector
    function getRecursiveChildNodeIds(nodes, parentId) {
        let childIds = [];
        const children = nodes.filter(n => String(n.parentId || '') === String(parentId));
        children.forEach(child => {
            childIds.push(child._id);
            childIds = childIds.concat(getRecursiveChildNodeIds(nodes, child._id.toString()));
        });
        return childIds;
    }

    function openFolder(folderId) {
        currentFolderId = folderId || null;
        if (currentFolderId) {
            window.location.hash = 'folder-' + currentFolderId;
        } else {
            // Remove hash from URL without page jump or pushState clutter
            history.replaceState("", document.title, window.location.pathname + window.location.search);
        }
        renderCurriculumTree();
    }

    // Render Drill-down View in DOM
    function renderCurriculumTree() {
        const container = document.getElementById('curriculum-tree-container');
        if (!container) return;
        
        let html = '';
        
        // Build Toolbar (Breadcrumb + Actions)
        const currentFolder = currentFolderId ? curriculumNodes.find(n => n._id === currentFolderId) : null;
        const parentId = currentFolder ? currentFolder.parentId : null;
        
        let actionButtonsHtml = '';
        if (typeof hasEditAccess !== "undefined" && hasEditAccess && (!currentFolder || !currentFolder.isReadonly)) {
            actionButtonsHtml = `
                <button type="button" onclick="toggleSelectionMode()" class="text-sm font-bold text-slate-600 hover:text-primary flex items-center gap-2 transition-colors">
                    <span class="material-symbols-rounded text-[22px]" id="selectionIcon">${selectionMode ? 'close' : 'checklist'}</span>
                    <span id="selectionText">${selectionMode ? 'Cancel Selection' : 'Select Items'}</span>
                </button>
                <button type="button" onclick="openFolderModal('${currentFolderId || ''}')" class="text-sm font-bold text-slate-600 hover:text-primary flex items-center gap-2 transition-colors">
                    <span class="material-symbols-rounded text-[22px]">create_new_folder</span> New Folder
                </button>
                <button type="button" onclick="openAssetDropdown('${currentFolderId || ''}', event)" class="text-sm font-bold text-slate-600 hover:text-primary flex items-center gap-2 transition-colors">
                    <span class="material-symbols-rounded text-[22px]">add_circle</span> Add Content
                </button>
            `;
        }

        html += `
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200 dark:border-white/10 bg-[#FFFFFF] dark:bg-[#0b1120]">
                <div class="flex items-center gap-3">
                    ${currentFolderId ? `
                        <button type="button" onclick="openFolder('${parentId || ''}')" class="p-1.5 hover:bg-slate-200 dark:hover:bg-white/10 rounded-none transition-all text-slate-500">
                            <span class="material-symbols-rounded text-[18px]">arrow_back</span>
                        </button>
                        <span class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2 font-sans">
                            <span class="material-symbols-rounded text-amber-500 text-xl">folder_open</span>
                            ${currentFolder.name}
                        </span>
                    ` : `
                        <div class="flex items-center gap-1 px-2">
                            ${ '<%= user.role %>' === 'teacher' ? `
                            <a href="/teacher/course/<%= typeof course !== 'undefined' ? course._id : '' %>#content" class="p-1.5 hover:bg-slate-200 dark:hover:bg-white/10 rounded-none transition-all text-slate-500">
                                <span class="material-symbols-rounded text-[18px]">arrow_back</span>
                            </a>
                            ` : '' }
                            <div class="flex flex-col">
                                <span class="text-lg font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                    <span class="material-symbols-rounded text-slate-500 text-2xl">folder_copy</span>
                                    Folder
                                </span>
                                <span class="text-[11px] font-bold text-slate-400 mt-0.5">${curriculumNodes.filter(n => n.type !== 'folder').length} Total Files</span>
                            </div>
                        </div>
                    `}
                </div>
                <div class="flex items-center gap-6">
                    ${actionButtonsHtml}
                </div>
            </div>
        `;

        const items = curriculumNodes.filter(n => (currentFolderId ? n.parentId === currentFolderId : !n.parentId));
        let listHtml = '';
        
        if (items.length > 0) {
            // Sort folders first, then items by creation time (reverse chronological: newest/last-made first)
            items.sort((a, b) => {
                // If both have order fields and they differ, sort by order
                if (a.order !== b.order) {
                    return (a.order || 0) - (b.order || 0);
                }
                
                const timeA = parseInt(a._id.toString().substring(0, 8), 16);
                const timeB = parseInt(b._id.toString().substring(0, 8), 16);
                return timeB - timeA;
            });

            // Add batch selection header control
            if (<%= typeof hasEditAccess !== "undefined" && hasEditAccess ? "true" : "false" %>) {
                html += `
                <div id="selectAllHeader" class="flex items-center justify-between px-4 py-2.5 bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-white/10 text-[11px] font-bold text-slate-500 rounded-none mb-3 mt-4">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)" class="size-4 rounded border-slate-300 accent-primary cursor-pointer">
                        <label for="selectAllCheckbox" class="cursor-pointer select-none">Select All</label>
                    </div>
                    <div id="batchActionBar" class="hidden flex items-center gap-3">
                        <span id="selectedCountText" class="text-slate-600 dark:text-slate-400 font-bold">0 selected</span>
                        <button type="button" onclick="deleteSelectedNodes()" class="flex items-center gap-1.5 px-3 py-1.5 bg-rose-500 hover:bg-rose-600 text-white rounded-none text-[10px] font-bold shadow transition-all">
                            <span class="material-symbols-rounded text-xs">delete</span>
                            Delete
                        </button>
                    </div>
                </div>
            `;
            }

            items.forEach(node => {
                const isFolder = node.type === 'folder';
                let icon = 'folder';
                let typeLabel = 'Folder';
                let detailHtml = '';
                
                if (isFolder) {
                    const childIds = getRecursiveChildNodeIds(curriculumNodes, node._id.toString());
                    const fileCount = curriculumNodes.filter(n => childIds.includes(n._id) && n.type !== 'folder').length;
                    typeLabel = `${fileCount} Files`;
                }
                
                if (node.type === 'video') {
                    icon = 'play_circle';
                    typeLabel = 'Video Lesson';
                    detailHtml = node.duration ? `<span class="text-[9px] px-1.5 py-0.5 bg-blue-50 dark:bg-blue-500/10 text-blue-500 rounded-none font-mono font-bold">${node.duration}</span>` : '';
                } else if (node.type === 'note') {
                    icon = 'description';
                    typeLabel = 'Note';
                    if (node.filePath) {
                        const ext = node.filePath.split('.').pop().toLowerCase();
                        const isImage = ['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(ext);
                        detailHtml = `<a href="${node.filePath}" target="_blank" class="text-[9px] text-emerald-500 hover:underline flex items-center gap-0.5 font-bold"><span class="material-symbols-rounded text-xs">${isImage ? 'image' : 'picture_as_pdf'}</span>View File</a>`;
                    }
                } else if (node.type === 'liveClass') {
                    icon = 'podcasts';
                    const isScheduled = node.date && new Date(node.date) > new Date();
                    const isEnded = node.videoPath || node.isRecorded;
                    
                    if (isEnded) {
                        typeLabel = 'Video Lesson';
                        icon = 'play_circle';
                        detailHtml = node.duration ? `<span class="text-[9px] px-1.5 py-0.5 bg-blue-50 dark:bg-blue-500/10 text-blue-500 rounded-none font-mono font-bold">${node.duration}</span>` : `<span class="text-[10px] text-slate-500 font-bold">Recorded Video</span>`;
                    } else if (isScheduled) {
                        typeLabel = 'scheduled Live Class';
                        detailHtml = `
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] text-slate-500 font-bold countdown-timer" data-time="${node.date}"></span>
                                <a href="/live/${node.meetingUrl}" target="_blank" class="text-[9px] text-primary hover:underline flex items-center gap-0.5 font-bold"><span class="material-symbols-rounded text-xs">link</span>Join</a>
                            </div>
                        `;
                    } else {
                        typeLabel = 'Live Class';
                        detailHtml = `
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] text-rose-500 font-bold">Live Now</span>
                                <a href="/live/${node.meetingUrl}" target="_blank" class="text-[9px] text-primary hover:underline flex items-center gap-0.5 font-bold"><span class="material-symbols-rounded text-xs">link</span>Join</a>
                            </div>
                        `;
                    }
                } else if (node.type === 'quiz') {
                    icon = 'psychology';
                    const isScheduled = node.date && new Date(node.date) > new Date();
                    
                    if (isScheduled) {
                        typeLabel = 'scheduled Quize';
                        detailHtml = `
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] text-slate-500 font-bold countdown-timer" data-time="${node.date}"></span>
                                <span class="text-[9px] px-1.5 py-0.5 bg-amber-50 dark:bg-amber-500/10 text-amber-500 rounded-none font-bold">${node.quizId ? (node.quizId.title || 'Quiz') : 'Quiz'}</span>
                            </div>
                        `;
                    } else {
                        typeLabel = 'Assessment';
                        detailHtml = `<span class="text-[9px] px-1.5 py-0.5 bg-amber-50 dark:bg-amber-500/10 text-amber-500 rounded-none font-bold">${node.quizId ? (node.quizId.title || 'Quiz') : 'Quiz'}</span>`;
                    }
                }
                
                let inlineActions = `<div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 shrink-0 ml-auto pl-4">`;
                if (!hasEditAccess) { 
                    // Do not show edit actions
                } else if (node.isReadonly) {
                    inlineActions += `<span title="Restricted Access" class="material-symbols-rounded text-slate-300 dark:text-slate-600 text-[18px]">lock</span>`;
                } else if (isFolder) {
                    inlineActions += `
                        <button type="button" onclick="openRenameModal('${node._id}', '${node.name.replace(/'/g, "\\'")}')" title="Rename Folder" class="size-8 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-white/10 text-slate-500 hover:text-primary transition-all rounded-none">
                            <span class="material-symbols-rounded text-[18px]">edit</span>
                        </button>
                        <button type="button" onclick="confirmDeleteNode('${node._id}', '${node.name.replace(/'/g, "\\'")}', true)" title="Delete Folder" class="size-8 flex items-center justify-center hover:bg-red-50 dark:hover:bg-red-500/10 text-slate-500 hover:text-red-500 transition-all rounded-none">
                            <span class="material-symbols-rounded text-[18px]">delete</span>
                        </button>
                    `;
                } else {
                    inlineActions += `
                        <button type="button" onclick="openEditAssetModal('${node._id}')" title="Edit Resource" class="size-8 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-white/10 text-slate-500 hover:text-primary transition-all rounded-none">
                            <span class="material-symbols-rounded text-[18px]">edit</span>
                        </button>
                        <button type="button" onclick="confirmDeleteNode('${node._id}', '${node.name.replace(/'/g, "\\'")}', false)" title="Delete Resource" class="size-8 flex items-center justify-center hover:bg-red-50 dark:hover:bg-red-500/10 text-slate-500 hover:text-red-500 transition-all rounded-none">
                            <span class="material-symbols-rounded text-[18px]">delete</span>
                        </button>
                    `;
                }
                inlineActions += `</div>`;

                const nodeStyle = isFolder 
                    ? `bg-[#FFFFFF] dark:bg-[#0b1120] hover:bg-slate-50 dark:hover:bg-white/5 cursor-pointer`
                    : `bg-[#F8FAFC] dark:bg-[#1e293b] hover:bg-slate-100 dark:hover:bg-white/10 ml-6`;
                    
                const clickAction = `onclick="handleRowClick('${node._id}', event, ${isFolder})"`;

                listHtml += `
                    <div ${clickAction} data-node-id="${node._id}" class="group flex items-center p-4 border border-slate-200 dark:border-white/10 bg-white dark:bg-[#0b1120] hover:bg-slate-50 dark:hover:bg-white/5 transition-all shadow-sm rounded-none">
                        ${typeof hasEditAccess !== "undefined" && hasEditAccess ? `
                        <div class="drag-handle mr-2 text-slate-300 hover:text-slate-500 cursor-grab active:cursor-grabbing px-1 hidden lg:flex items-center">
                            <span class="material-symbols-rounded text-lg">drag_indicator</span>
                        </div>
                        ` : ''}
                        <div class="node-select-col flex items-center gap-3 mr-2 shrink-0">
                            <input type="checkbox" class="node-select-checkbox size-4 accent-primary cursor-pointer" data-id="${node._id}" ${node.isReadonly ? 'disabled title="Restricted"' : ''} onclick="event.stopPropagation(); handleCheckboxChange();">
                        </div>
                        <div class="flex items-center gap-4 min-w-0 flex-1">
                            <span class="material-symbols-rounded ${isFolder ? 'text-amber-500' : 'text-slate-400 dark:text-slate-500'} shrink-0 text-[28px]">${icon}</span>
                            <div class="min-w-0 flex-1">
                                <h5 class="text-sm font-bold text-slate-800 dark:text-white truncate leading-normal font-sans">${node.name}</h5>
                                <div class="flex items-center gap-2.5 mt-1">
                                    <span class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">${typeLabel}</span>
                                    ${detailHtml}
                                </div>
                            </div>
                        </div>
                        ${inlineActions}
                    </div>
                `;
            });
        }
        
        html += `<div class="space-y-3 mt-6" id="curriculum-list">${listHtml}</div>`;
        
        container.innerHTML = `<div>${html}</div>`;
        
        // Initialize SortableJS
        if (typeof hasEditAccess !== "undefined" && hasEditAccess) {
            const listEl = document.getElementById('curriculum-list');
            if (listEl) {
                Sortable.create(listEl, {
                    animation: 150,
                    handle: '.drag-handle', // We'll add this to the row
                    onEnd: function (evt) {
                        const itemEls = listEl.children;
                        const newOrder = [];
                        for (let i = 0; i < itemEls.length; i++) {
                            const id = itemEls[i].getAttribute('data-node-id');
                            if (id) newOrder.push(id);
                        }
                        updateNodesOrder(newOrder);
                    }
                });
            }
        }
    }

