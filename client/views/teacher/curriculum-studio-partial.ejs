        const titleLabelEl = document.getElementById('assetTitleLabel');
        const videoPathLabelEl = document.getElementById('videoPathLabel');
        const durationEl = document.getElementById('durationFieldContainer');
        const submitBtnEl = document.getElementById('assetSubmitBtn');
        const noteUploadLabelEl = document.getElementById('noteUploadLabel');
        const notePathLabelEl = document.getElementById('notePathLabel');
        
        // Reset defaults
        titleEl.innerText = 'Add Content';
        if (tabsEl) tabsEl.classList.remove('hidden');
        if (subtextEl) subtextEl.classList.remove('hidden');
        if (titleLabelEl) titleLabelEl.innerText = 'Title';
        if (videoPathLabelEl) videoPathLabelEl.innerText = 'Video URL';
        if (durationEl) durationEl.classList.remove('hidden');
        if (submitBtnEl) submitBtnEl.innerText = 'Save';
        if (noteUploadLabelEl) noteUploadLabelEl.innerText = 'Note File';
        if (notePathLabelEl) notePathLabelEl.innerText = 'File URL';
        
        if (type === 'video') {
            titleEl.innerText = 'Add Video';
            if (tabsEl) tabsEl.classList.add('hidden');
            if (subtextEl) subtextEl.classList.add('hidden');
            if (titleLabelEl) titleLabelEl.innerText = 'Title';
            if (videoPathLabelEl) videoPathLabelEl.innerText = 'Video URL';
            if (durationEl) durationEl.classList.add('hidden');
            if (submitBtnEl) submitBtnEl.innerText = 'Save';
        } else if (type === 'note') {
            titleEl.innerText = 'Add Note';
            if (tabsEl) tabsEl.classList.add('hidden');
            if (subtextEl) subtextEl.classList.add('hidden');
            if (titleLabelEl) titleLabelEl.innerText = 'Title';
            if (noteUploadLabelEl) noteUploadLabelEl.innerText = 'Note File';
            if (notePathLabelEl) notePathLabelEl.innerText = 'File URL';
            if (submitBtnEl) submitBtnEl.innerText = 'Save';
        } else if (type === 'liveClass') {
            titleEl.innerText = 'Live Class';
            if (tabsEl) tabsEl.classList.add('hidden');
            if (subtextEl) subtextEl.classList.add('hidden');
            if (titleLabelEl) titleLabelEl.innerText = 'Title';
            
            setTimeout(toggleLiveMode, 0); // Defer to ensure elements are rendered
        } else if (type === 'quiz') {
            titleEl.innerText = 'Quiz';
            if (tabsEl) tabsEl.classList.add('hidden');
            if (subtextEl) subtextEl.classList.add('hidden');
            if (titleLabelEl) titleLabelEl.innerText = 'Title';
            if (submitBtnEl) submitBtnEl.innerText = 'Save';
            
            await fetchQuestionBanks();
            await fetchQuizzes();
            
            setTimeout(() => {
                toggleBankSelect();
                toggleQuizSelect();
                toggleQuizMode();
            }, 0);
        }
        
        setAssetType(type);
        
        document.getElementById('assetModal').classList.remove('hidden');
    }

