            const file = input.files[0];
            display.innerText = file.name;
            display.classList.add('text-primary', 'font-bold');

            // Live image preview when browsing thumbnail file
            if (displayId === 'thumbnailFileNameDisplay' && file.type.startsWith('image/')) {
                const imgEl = document.getElementById('thumbnailPreviewImg');
                const boxEl = document.getElementById('thumbnailPreviewBox');
                const container = document.getElementById('videoAssetPreviewContainer');
                const thumbText = document.getElementById('thumbnailSourceText');
                if (imgEl && boxEl && container) {
                    imgEl.src = URL.createObjectURL(file);
                    boxEl.classList.remove('hidden');
                    container.classList.remove('hidden');
                    if (thumbText) thumbText.innerText = 'New Image Selected: ' + file.name;
                }
            }
            if (displayId === 'videoFileNameDisplay') {
                const container = document.getElementById('videoAssetPreviewContainer');
                const vidText = document.getElementById('videoSourceText');
                if (container) container.classList.remove('hidden');
                if (vidText) vidText.innerText = 'Video Selected: ' + file.name;
            }
        } else {
            const defaultText = displayId.includes('video') ? 'Browse Video...' : (displayId.includes('thumbnail') ? 'Browse Thumbnail...' : 'Browse Note...');
            display.innerText = defaultText;
            display.classList.remove('text-primary', 'font-bold');
        }
    }

