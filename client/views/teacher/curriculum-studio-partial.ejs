    function renderCoursePlaylist() {
        const playlistContainer = document.getElementById('playlistContainer');
        if (!playlistContainer) return;

        if (!curriculumNodes || curriculumNodes.length === 0) {
            playlistContainer.innerHTML = `
                <div class="flex flex-col items-center justify-center text-center py-10 opacity-60">
                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">video_library</span>
                    <p class="text-xs font-medium text-slate-500">No lessons available</p>
                </div>
            `;
            return;
        }

        // Get all videos (both standalone and those inside folders)
        const allVideos = curriculumNodes.filter(n => 
            n.type === 'video' || (n.type === 'liveClass' && n.videoPath)
        ).sort((a, b) => {
            const timeA = parseInt(a._id.toString().substring(0, 8), 16);
            const timeB = parseInt(b._id.toString().substring(0, 8), 16);
            return timeA - timeB;
        });

        let html = '';

        // Render all videos in a flat, continuous list
        allVideos.forEach(node => {
            const isActive = node._id === activePlayingNodeId;
            const activeClass = isActive ? 'bg-[#EAE9ED] dark:bg-white/10 rounded-md' : 'hover:bg-[#EAE9ED]/60 dark:hover:bg-white/5 rounded-md';
            const iconColor = isActive ? 'text-black dark:text-white' : 'text-slate-400';
            const activeTextClass = isActive ? 'text-black dark:text-white font-medium' : 'text-black dark:text-slate-300 font-medium';
            
            html += `
                <div onclick="playVideoNode('${node._id}', false, true)" class="group flex items-center gap-3 p-2.5 cursor-pointer transition-all ${activeClass}">
                    <span class="material-symbols-rounded shrink-0 text-[22px] flex items-center justify-center ${iconColor}">play_circle</span>
                    <div class="min-w-0 flex-1 flex flex-col justify-center">
                        <p class="text-[13px] ${activeTextClass} truncate leading-tight">${node.name}</p>
