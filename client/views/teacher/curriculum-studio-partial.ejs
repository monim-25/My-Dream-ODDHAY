    function toggleBankSelect() {
        const bankSelect = document.getElementById('bankSelect');
        const quizSelect = document.getElementById('quizSelect');
        const quizSelectContainer = document.getElementById('quizSelectContainer');
        const makeQuizBtnContainer = document.getElementById('makeQuizBtnContainer');
        
        if (bankSelect && bankSelect.value) {
            if (quizSelect) quizSelect.value = ''; // Clear quiz selection
            if (quizSelectContainer) quizSelectContainer.classList.add('hidden');
            if (makeQuizBtnContainer) makeQuizBtnContainer.classList.add('hidden');
        } else {
            if (quizSelectContainer) quizSelectContainer.classList.remove('hidden');
            if (makeQuizBtnContainer && (!quizSelect || !quizSelect.value)) {
                makeQuizBtnContainer.classList.remove('hidden');
            }
        }
