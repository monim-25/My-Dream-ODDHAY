        const panel = document.getElementById('videoPlayerPanel');
        const tree = document.getElementById('curriculum-tree-container');
        
        stopVideoPlayback();
        
        panel.classList.add('hidden');
        tree.classList.remove('hidden');

        // Clear video hash from URL cleanly (no page jump)
        history.replaceState('', document.title, window.location.pathname + window.location.search);
    }

    function toggleDescription() {
        const descEl = document.getElementById('playerVideoDesc');
        const btn = document.getElementById('descToggleBtn');
        
        if (descEl.classList.contains('line-clamp-2')) {
            descEl.classList.remove('line-clamp-2');
            btn.innerText = 'Show less';
        } else {
            descEl.classList.add('line-clamp-2');
            btn.innerText = 'Details';
        }
    }

    // Format views and comments counts dynamically (e.g. 1.2k)
    function formatCount(num) {
        if (!num) return '0';
        num = parseInt(num, 10);
        if (isNaN(num)) return '0';
        if (num >= 1000000) {
            return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'm';
        }
        if (num >= 1000) {
            return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        }
        return num.toString();
    }

    async function incrementNodeView(nodeId) {
        try {
            const res = await fetch(`/api/curriculum/node/${nodeId}/view`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('playerVideoViews').innerText = formatCount(data.views);
                const cachedNode = curriculumNodes.find(n => n._id === nodeId);
                if (cachedNode) cachedNode.views = data.views;
            }
        } catch (err) {
            console.error('Error incrementing views:', err);
        }
    }

    let commentsSkip = 0;
    const commentsLimit = 10;
    let commentsHasMore = false;
    let loadedCommentsArray = [];

    async function loadNodeComments(nodeId, append = false, isSilent = false) {
        const list = document.getElementById('commentsList');
        const badge = document.getElementById('commentsCountBadge');
        const playerBadge = document.getElementById('playerVideoComments');
        const loadMoreContainer = document.getElementById('loadMoreCommentsContainer');
        
        if (!append && !isSilent) {
            commentsSkip = 0;
            loadedCommentsArray = [];
            list.innerHTML = `
                <div class="flex items-center justify-center py-10">
                    <div class="animate-spin rounded-full h-5 w-5 border-2 border-primary border-t-transparent"></div>
                </div>
            `;
        }

        try {
            const res = await fetch(`/api/curriculum/node/${nodeId}/comments?limit=${commentsLimit}&skip=${commentsSkip}`);
            const data = await res.json();
            if (data.success && data.comments) {
                commentsHasMore = data.hasMore;
                
                if (append) {
                    loadedCommentsArray = loadedCommentsArray.concat(data.comments);
                } else {
                    loadedCommentsArray = data.comments;
                }

                // Update counts with premium compact formatting
                badge.innerText = formatCount(loadedCommentsArray.length);
                playerBadge.innerText = formatCount(loadedCommentsArray.length);

                // Update Comments Settings Toggle UI & disabled state banner
                updateCommentsSettingUI(data.commentsDisabled);

                if (loadedCommentsArray.length === 0) {
                    list.innerHTML = `
                        <div class="flex flex-col items-center justify-center text-center pt-10 pb-6 opacity-60">
                            <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-3">chat_bubble_outline</span>
                            <p class="text-xs font-medium text-slate-500">No comments yet</p>
                            <p class="text-[10px] text-slate-400 mt-1">Be the first to share your thoughts!</p>
                        </div>
                    `;
                    if (loadMoreContainer) loadMoreContainer.classList.add('hidden');
                    return;
                }

                renderCommentsList(loadedCommentsArray);

                if (loadMoreContainer) {
                    if (commentsHasMore) {
                        loadMoreContainer.classList.remove('hidden');
                    } else {
                        loadMoreContainer.classList.add('hidden');
                    }
                }
            }
        } catch (err) {
            console.error('Error loading comments:', err);
            if (!isSilent) {
                list.innerHTML = `<p class="text-xs text-rose-500 text-center py-4">Failed to load comments</p>`;
            }
        }
    }

    function updateCommentsSettingUI(disabled) {
        const btn = document.getElementById('toggleCommentsBtn');
        const icon = document.getElementById('toggleCommentsIcon');
        const text = document.getElementById('toggleCommentsText');
        const banner = document.getElementById('commentsDisabledBanner');

        // Always keep the same class/color as requested
        if (btn) {
            btn.className = "text-xs font-bold px-3 py-1 bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-white/10 transition-all rounded-none flex items-center gap-1.5 shrink-0";
        }
        if (text) {
            text.innerText = disabled ? "Turn on" : "Turn off";
        }

        if (disabled) {
            if (icon) icon.innerText = "comments_disabled";
            if (banner) banner.classList.remove('hidden');
        } else {
            if (icon) icon.innerText = "chat";
            if (banner) banner.classList.add('hidden');
        }
    }

    async function toggleNodeCommentsSetting() {
        if (!activePlayingNodeId) return;
        const btn = document.getElementById('toggleCommentsBtn');
        if (btn) btn.disabled = true;

        try {
            const res = await fetch(`/api/curriculum/node/${activePlayingNodeId}/toggle-comments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                updateCommentsSettingUI(data.commentsDisabled);
            } else {
                alert(data.error || 'Failed to toggle comments setting');
            }
        } catch (err) {
            console.error('Error toggling comments setting:', err);
            alert('Failed to toggle comments setting');
        } finally {
            if (btn) btn.disabled = false;
        }
    }

