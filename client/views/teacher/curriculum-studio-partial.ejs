    async function fetchQuizzes() {
        try {
            const res = await fetch(`/teacher/api/quizzes?classLevel=${encodeURIComponent(currentCourseClass)}&subject=${encodeURIComponent(currentCourseSubject)}`);
            const data = await res.json();
            const select = document.getElementById('quizSelect');
            if (select) {
                select.innerHTML = '<option value="">-- Choose Previous Exam (Optional) --</option>';
                (data.quizzes || []).forEach(q => {
                    select.insertAdjacentHTML('beforeend', `<option value="${q._id}">${q.title}</option>`);
                });
                
                // Auto-select newly created quiz if query parameter exists
                if (redirectQuizCreatedId) {
                    select.value = redirectQuizCreatedId;
                    
                    // Prefill name with newly created quiz title
                    const createdQuiz = (data.quizzes || []).find(q => q._id === redirectQuizCreatedId);
                    if (createdQuiz) {
                        const assetTitle = document.getElementById('assetTitle');
                        if (assetTitle) assetTitle.value = createdQuiz.title;
                    }
                    
                    // Render green "Done" button
                    const makeQuizBtnContainer = document.getElementById('makeQuizBtnContainer');
                    if (makeQuizBtnContainer) {
                        makeQuizBtnContainer.innerHTML = `
                            <button type="button" disabled class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 dark:bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider rounded-none cursor-default opacity-90 shadow-sm border border-emerald-500/10">
                                <span class="material-symbols-rounded text-[14px]">check_circle</span> Done
                            </button>
                        `;
                    }
                }
            }
        } catch (err) {
            console.error('Failed to fetch quizzes:', err);
        }
    }

