<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Student Q&A Hub | Teacher ODDHAY</title>
    <% 
        // Relative Time Helper
        function timeAgo(date) {
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);
            let interval = seconds / 31536000;
            if (interval > 1) return Math.floor(interval) + " years ago";
            interval = seconds / 2592000;
            if (interval > 1) return Math.floor(interval) + " months ago";
            interval = seconds / 86400;
            if (interval > 1) return Math.floor(interval) + " days ago";
            interval = seconds / 3600;
            if (interval > 1) return Math.floor(interval) + " hours ago";
            interval = seconds / 60;
            if (interval > 1) return Math.floor(interval) + " minutes ago";
            return Math.floor(seconds) + " seconds ago";
        }

        // Title Case Helper
        function toTitleCase(str) {
            if (!str) return '';
            const s = String(str);
            return s.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
        }
    %>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        .admin-sidebar.active { transform: translateX(0); }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'qa' }) %>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Student Q&A Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <!-- SECTION 1: STATS OVERVIEW SECTION (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        
                        <!-- Pending Queries Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400">Pending Queries</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= filters.totalQAs %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">pending_actions</span>
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Courses Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400">Assigned Courses</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= assignedCourses.length %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">auto_stories</span>
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Subjects Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Subjects Scope</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= assignedSubjects.length %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">menu_book</span>
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Classes Card -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400">Classes Scope</p>
                                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= assignedClasses.length %></h3>
                                </div>
                                <div class="size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-lg">school</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SECTION 2: STICKY FILTERS BAR (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-4 sm:px-6 py-2.5 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 shadow-2xs">
                    <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
                        
                        <!-- Class Filter Dropdown -->
                        <div class="relative w-36">
                            <select onchange="updateFilters('class', this.value)" 
                                    class="w-full h-9 pl-3 pr-8 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100">
                                <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                <% assignedClasses.forEach(c => { %>
                                    <option value="<%= c %>" <%= filters.class === c ? 'selected' : '' %>><%= c %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Subject Filter Dropdown -->
                        <div class="relative w-36">
                            <select onchange="updateFilters('subject', this.value)" 
                                    class="w-full h-9 pl-3 pr-8 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100">
                                <option value="all" <%= filters.subject === 'all' ? 'selected' : '' %>>All Subjects</option>
                                <% assignedSubjects.forEach(s => { %>
                                    <option value="<%= s %>" <%= filters.subject === s ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Course Filter Dropdown -->
                        <div class="relative w-48">
                            <select onchange="updateFilters('course', this.value)" 
                                    class="w-full h-9 pl-3 pr-8 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100">
                                <option value="all" <%= filters.course === 'all' ? 'selected' : '' %>>All Courses</option>
                                <% assignedCourses.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= filters.course === c.id ? 'selected' : '' %>><%= c.title %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Match Counter -->
                        <div class="h-9 px-3 rounded-lg bg-primary/10 border border-primary/20 flex items-center">
                            <span class="text-xs font-bold text-primary"><%= filters.totalQAs %> Questions</span>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: QUESTIONS LIST -->
                <div class="p-4 sm:p-6">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <% if (qas && qas.length > 0) { %>
                            <% qas.forEach(qa => { %>
                                <div class="rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 p-4 sm:p-5 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between">
                                    
                                    <div>
                                        <!-- Header: Student Avatar & Meta -->
                                        <div class="flex items-start justify-between gap-3 mb-3">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="size-10 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center shrink-0 overflow-hidden text-slate-500 font-bold text-sm">
                                                    <% if (qa.askedBy && qa.askedBy.profilePicture) { %>
                                                        <img src="<%= qa.askedBy.profilePicture %>" alt="<%= qa.askedBy.name %>" class="size-full object-cover">
                                                    <% } else { %>
                                                        <span><%= qa.askedBy && qa.askedBy.name ? qa.askedBy.name[0].toUpperCase() : 'S' %></span>
                                                    <% } %>
                                                </div>
                                                <div class="min-w-0">
                                                    <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate leading-tight">
                                                        <%= toTitleCase(qa.askedBy ? qa.askedBy.name : 'Unknown Student') %>
                                                    </h4>
                                                    <div class="flex items-center gap-1.5 mt-1">
                                                        <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-semibold border border-slate-200/60 dark:border-slate-700/60">
                                                            <%= Array.isArray(qa.course?.classLevel) && qa.course.classLevel.length ? qa.course.classLevel.join(', ') : (qa.course?.classLevel || 'General') %>
                                                        </span>
                                                        <span class="text-[10px] font-medium text-slate-400">&bull; <%= timeAgo(qa.createdAt) %></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <span class="px-2 py-0.5 rounded-md bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 text-[10px] font-semibold border border-blue-200/60 dark:border-blue-900/60 shrink-0">
                                                <%= Array.isArray(qa.course?.subject) && qa.course.subject.length ? qa.course.subject.map(toTitleCase).join(', ') : toTitleCase(qa.course?.subject || 'General') %>
                                            </span>
                                        </div>

                                        <!-- Question Text Block -->
                                        <div class="p-3.5 rounded-lg bg-slate-50/80 dark:bg-slate-900/40 border border-slate-100 dark:border-white/5 mb-4">
                                            <p class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200 leading-relaxed italic">
                                                "<%= qa.question %>"
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Answer Form -->
                                    <form action="/teacher/qa/<%= qa._id %>/answer" method="POST" class="space-y-2.5 pt-3 border-t border-slate-100 dark:border-white/5">
                                        <div class="space-y-1">
                                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                                <span class="material-symbols-rounded text-sm text-primary">reply</span> Your Response:
                                            </label>
                                            <textarea name="answer" rows="2" placeholder="Write a clear, helpful response to this student..." required
                                                      class="w-full p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium outline-none focus:border-primary text-slate-800 dark:text-slate-100 transition-all resize-none shadow-2xs"></textarea>
                                        </div>
                                        <div class="flex justify-end">
                                            <button type="submit" 
                                                    class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer active:scale-95">
                                                <span>Submit Answer</span>
                                                <span class="material-symbols-rounded text-sm">send</span>
                                            </button>
                                        </div>
                                    </form>

                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-span-full py-20 text-center bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-2xs">
                                <span class="material-symbols-rounded text-5xl text-slate-300 dark:text-slate-700 mb-3">done_all</span>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">All caught up!</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">All student queries in this category have been answered.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <% if (filters.totalPages > 1) { %>
                        <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
                            <p class="text-xs font-semibold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                            <div class="flex items-center gap-1">
                                <% for(var i=1; i<=filters.totalPages; i++) { %>
                                    <a href="?page=<%= i %>&class=<%= encodeURIComponent(filters.class) %>&subject=<%= encodeURIComponent(filters.subject) %>&course=<%= encodeURIComponent(filters.course) %>" 
                                       class="size-8 rounded-lg flex items-center justify-center text-xs font-bold transition-all <%= (filters.page === i) ? 'bg-primary text-white shadow-2xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                </div>

            </div>
        </main>
    </div>

    <script>
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('active');
        }

        function updateFilters(key, value) {
            const params = new URLSearchParams(window.location.search);
            if (value === 'all') {
                params.delete(key);
            } else {
                params.set(key, value);
            }
            params.set('page', '1');
            window.location.href = '?' + params.toString();
        }
    </script>
</body>
</html>
