<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Student Q&A Hub | Instructor Portal</title>
    <% 
        // Relative Time Helper
        function timeAgo(date) {
            if (!date) return '';
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);
            let interval = seconds / 31536000;
            if (interval > 1) return Math.floor(interval) + "y ago";
            interval = seconds / 2592000;
            if (interval > 1) return Math.floor(interval) + "mo ago";
            interval = seconds / 86400;
            if (interval > 1) return Math.floor(interval) + "d ago";
            interval = seconds / 3600;
            if (interval > 1) return Math.floor(interval) + "h ago";
            interval = seconds / 60;
            if (interval > 1) return Math.floor(interval) + "m ago";
            return "just now";
        }

        // Title Case Helper
        function toTitleCase(str) {
            if (!str) return '';
            const s = String(str);
            return s.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
        }
    %>
    <style>
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">

    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'qa' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] flex flex-col h-screen overflow-hidden">
            <%- include('header', { pageTitle: 'Student Q&A Hub' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-24 sm:pb-24 lg:pb-8">
                
                <!-- SECTION 1: STATS OVERVIEW SECTION (COMPACT 2x2 ON MOBILE, 4-COL ON DESKTOP) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2.5 sm:p-3">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-2.5">
                        
                        <!-- Pending Queries Card -->
                        <div onclick="updateFilters('status', 'open')" class="p-2 sm:p-2.5 rounded-xl bg-slate-50/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 hover:border-amber-400 dark:hover:border-amber-500/50 transition-all cursor-pointer select-none active:scale-98">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-[10.5px] sm:text-xs font-semibold text-amber-600 dark:text-amber-400 truncate">Pending Queries</p>
                                    <h3 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight mt-0.5">
                                        <%= locals.openQAsCount !== undefined ? openQAsCount : (filters.totalQAs || 0) %>
                                    </h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-lg sm:text-xl">pending_actions</span>
                                </div>
                            </div>
                        </div>

                        <!-- Answered / Resolved Card -->
                        <div onclick="updateFilters('status', 'resolved')" class="p-2 sm:p-2.5 rounded-xl bg-slate-50/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-400 dark:hover:border-emerald-500/50 transition-all cursor-pointer select-none active:scale-98">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-[10.5px] sm:text-xs font-semibold text-emerald-600 dark:text-emerald-400 truncate">Answered</p>
                                    <h3 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight mt-0.5">
                                        <%= locals.resolvedQAsCount !== undefined ? resolvedQAsCount : 0 %>
                                    </h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-lg sm:text-xl">task_alt</span>
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Courses Card -->
                        <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-[10.5px] sm:text-xs font-semibold text-blue-600 dark:text-blue-400 truncate">My Courses</p>
                                    <h3 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight mt-0.5">
                                        <%= assignedCourses.length %>
                                    </h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-lg sm:text-xl">auto_stories</span>
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Classes Card -->
                        <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-[10.5px] sm:text-xs font-semibold text-purple-600 dark:text-purple-400 truncate">Classes Scope</p>
                                    <h3 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight mt-0.5">
                                        <%= assignedClasses.length %>
                                    </h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-lg sm:text-xl">school</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SECTION 2: STICKY FILTERS & SEARCH BAR (RESPONSIVE FOR ALL SCREEN SIZES) -->
                <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-3 sm:px-5 py-2.5 border-b border-slate-200 dark:border-slate-800 shadow-2xs space-y-2.5">
                    
                    <!-- Row 1: Status Filter Tabs + Search Input -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <!-- Status Pills -->
                        <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl self-start sm:self-auto">
                            <% const curStatus = filters.status || 'open'; %>
                            <button type="button" onclick="updateFilters('status', 'open')"
                                class="px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer select-none <%= curStatus === 'open' ? 'bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                Pending
                            </button>
                            <button type="button" onclick="updateFilters('status', 'resolved')"
                                class="px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer select-none <%= curStatus === 'resolved' ? 'bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                Answered
                            </button>
                            <button type="button" onclick="updateFilters('status', 'all')"
                                class="px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer select-none <%= curStatus === 'all' ? 'bg-white dark:bg-slate-900 text-primary shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200' %>">
                                All
                            </button>
                        </div>

                        <!-- Live Text Search Filter -->
                        <div class="relative flex-1 sm:max-w-xs">
                            <input type="text" id="qaSearchInput" oninput="filterQuestionsClient(this.value)" placeholder="Search questions or students..."
                                class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 font-medium transition-all">
                            <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
                        </div>
                    </div>

                    <!-- Row 2: Dropdowns (Grid on Mobile, Flex on Desktop) -->
                    <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-2">
                        <!-- Class Filter Dropdown -->
                        <div class="relative col-span-1 sm:w-36">
                            <select onchange="updateFilters('class', this.value)" 
                                    class="w-full h-8.5 pl-2.5 pr-7 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100 truncate">
                                <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All Classes</option>
                                <% assignedClasses.forEach(c => { %>
                                    <option value="<%= c %>" <%= filters.class === c ? 'selected' : '' %>><%= c %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Subject Filter Dropdown -->
                        <div class="relative col-span-1 sm:w-36">
                            <select onchange="updateFilters('subject', this.value)" 
                                    class="w-full h-8.5 pl-2.5 pr-7 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100 truncate">
                                <option value="all" <%= filters.subject === 'all' ? 'selected' : '' %>>All Subjects</option>
                                <% assignedSubjects.forEach(s => { %>
                                    <option value="<%= s %>" <%= filters.subject === s ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Course Filter Dropdown -->
                        <div class="relative col-span-2 sm:w-52">
                            <select onchange="updateFilters('course', this.value)" 
                                    class="w-full h-8.5 pl-2.5 pr-7 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-primary text-slate-800 dark:text-slate-100 truncate">
                                <option value="all" <%= filters.course === 'all' ? 'selected' : '' %>>All Courses</option>
                                <% assignedCourses.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= filters.course === c.id ? 'selected' : '' %>><%= c.title %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-base">expand_more</span>
                        </div>

                        <!-- Match Counter -->
                        <div class="col-span-2 sm:ml-auto flex items-center justify-between sm:justify-start gap-2">
                            <span class="px-2.5 py-1 rounded-lg bg-primary/10 border border-primary/20 text-[11px] font-bold text-primary">
                                <span id="qaDisplayCount"><%= filters.totalQAs %></span> Queries Found
                            </span>
                            <% if (filters.class !== 'all' || filters.subject !== 'all' || filters.course !== 'all' || filters.status !== 'open') { %>
                                <a href="/teacher/qa" class="text-[11px] font-semibold text-rose-500 hover:text-rose-600 flex items-center gap-0.5">
                                    <span class="material-symbols-rounded text-sm">filter_alt_off</span>
                                    <span>Reset</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: QUESTIONS LIST -->
                <div class="p-3 sm:p-5">
                    <div id="qaGridContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-3.5 sm:gap-4">
                        <% if (qas && qas.length > 0) { %>
                            <% qas.forEach(qa => { %>
                                <% const isResolved = qa.status === 'resolved'; %>
                                <div id="qa-card-<%= qa._id %>" class="qa-item-card rounded-2xl bg-white dark:bg-[#0f172a] border border-slate-200/90 dark:border-slate-800 p-3.5 sm:p-5 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between"
                                     data-question="<%= (qa.question || '').toLowerCase() %>"
                                     data-student="<%= (qa.askedBy && qa.askedBy.name ? qa.askedBy.name : '').toLowerCase() %>">
                                    
                                    <div>
                                        <!-- Header: Student Avatar & Meta -->
                                        <div class="flex items-start justify-between gap-2.5 mb-2.5">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                <div class="size-9 sm:size-10 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center shrink-0 overflow-hidden text-slate-600 dark:text-slate-300 font-bold text-xs sm:text-sm shadow-2xs">
                                                    <% if (qa.askedBy && qa.askedBy.profilePicture) { %>
                                                        <img src="<%= qa.askedBy.profilePicture %>" alt="<%= qa.askedBy.name %>" class="size-full object-cover">
                                                    <% } else { %>
                                                        <span><%= qa.askedBy && qa.askedBy.name ? qa.askedBy.name[0].toUpperCase() : 'S' %></span>
                                                    <% } %>
                                                </div>
                                                <div class="min-w-0">
                                                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate leading-tight">
                                                        <%= toTitleCase(qa.askedBy ? qa.askedBy.name : 'Enrolled Student') %>
                                                    </h4>
                                                    <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
                                                        <span class="px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[9.5px] sm:text-[10px] font-semibold border border-slate-200/60 dark:border-slate-700/60">
                                                            <%= Array.isArray(qa.course?.classLevel) && qa.course.classLevel.length ? qa.course.classLevel.join(', ') : (qa.course?.classLevel || 'General') %>
                                                        </span>
                                                        <span class="text-[10px] font-medium text-slate-400">&bull; <%= timeAgo(qa.createdAt) %></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1 shrink-0">
                                                <span class="px-2 py-0.5 rounded-md text-[9.5px] sm:text-[10px] font-bold border <%= isResolved ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border-emerald-200/60 dark:border-emerald-900/60' : 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border-amber-200/60 dark:border-amber-900/60' %>">
                                                    <%= isResolved ? 'Resolved' : 'Pending' %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Course & Subject Pills -->
                                        <div class="flex items-center gap-1.5 mb-2.5 flex-wrap">
                                            <span class="px-2 py-0.5 rounded-md bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 text-[10px] font-semibold border border-blue-200/60 dark:border-blue-900/60 truncate max-w-full">
                                                <%= Array.isArray(qa.course?.subject) && qa.course.subject.length ? qa.course.subject.map(toTitleCase).join(', ') : toTitleCase(qa.course?.subject || 'Subject') %>
                                            </span>
                                            <% if (qa.course?.title) { %>
                                                <span class="text-[10px] text-slate-400 truncate max-w-[180px] sm:max-w-xs">&bull; <%= qa.course.title %></span>
                                            <% } %>
                                        </div>

                                        <!-- Question Text Block -->
                                        <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50/90 dark:bg-slate-900/50 border border-slate-100 dark:border-white/5 mb-3">
                                            <p class="text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-200 leading-relaxed break-words">
                                                "<%= qa.question %>"
                                            </p>
                                        </div>

                                        <!-- Question Attached Image (If student attached a photo) -->
                                        <% if (qa.image) { %>
                                            <div class="mb-3">
                                                <div onclick="openQaImageLightbox('<%= qa.image %>')" class="relative rounded-xl overflow-hidden border border-slate-200/80 dark:border-slate-700/80 max-h-44 bg-slate-100 dark:bg-slate-900 cursor-pointer group">
                                                    <img src="<%= qa.image %>" alt="Question attachment" class="w-full h-auto object-cover max-h-44 group-hover:scale-102 transition-transform">
                                                    <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold gap-1">
                                                        <span class="material-symbols-rounded text-lg">zoom_in</span>
                                                        <span>View Photo</span>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>

                                        <!-- If already Answered: Display Existing Response -->
                                        <% if (isResolved && qa.answer) { %>
                                            <div class="p-3 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/70 dark:border-emerald-800/40 mb-3 space-y-1.5">
                                                <div class="flex items-center justify-between text-[11px] font-bold text-emerald-700 dark:text-emerald-300">
                                                    <span class="flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-sm">verified</span>
                                                        Instructor Response
                                                    </span>
                                                    <span class="text-[10px] text-emerald-600/70 dark:text-emerald-400/70 font-medium">
                                                        <%= timeAgo(qa.answeredAt || qa.updatedAt) %>
                                                    </span>
                                                </div>
                                                <p class="text-xs text-slate-800 dark:text-slate-200 leading-relaxed break-words font-medium">
                                                    <%= qa.answer %>
                                                </p>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Answer Form (For Pending Questions, or Edit for Resolved) -->
                                    <form onsubmit="submitQaAnswer(event, '<%= qa._id %>')" action="/teacher/qa/<%= qa._id %>/answer" method="POST" class="space-y-2 pt-2.5 border-t border-slate-100 dark:border-white/5">
                                        <div class="space-y-1">
                                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                                <span class="material-symbols-rounded text-sm text-primary">reply</span> 
                                                <span><%= isResolved ? 'Update Response:' : 'Your Response:' %></span>
                                            </label>
                                            <textarea id="qa-answer-input-<%= qa._id %>" name="answer" rows="2" placeholder="Write a clear, helpful response for this student..." required
                                                      class="w-full p-2.5 sm:p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium outline-none focus:border-primary text-slate-800 dark:text-slate-100 transition-all resize-none shadow-2xs"><%= isResolved ? qa.answer : '' %></textarea>
                                        </div>
                                        <div class="flex items-center justify-end gap-2">
                                            <button id="qa-submit-btn-<%= qa._id %>" type="submit" 
                                                    class="px-4 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer active:scale-95">
                                                <span><%= isResolved ? 'Update Answer' : 'Submit Answer' %></span>
                                                <span class="material-symbols-rounded text-sm">send</span>
                                            </button>
                                        </div>
                                    </form>

                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-span-full py-16 sm:py-20 text-center bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xs">
                                <div class="size-16 rounded-3xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3">
                                    <span class="material-symbols-rounded text-3xl">task_alt</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white">All caught up!</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">There are no queries in this category right now. Any questions asked by your students will appear here.</p>
                                <% if (filters.class !== 'all' || filters.subject !== 'all' || filters.course !== 'all' || filters.status !== 'open') { %>
                                    <a href="/teacher/qa" class="inline-flex items-center gap-1 text-xs font-bold text-primary mt-4 hover:underline">
                                        <span>Show all queries</span>
                                        <span class="material-symbols-rounded text-sm">arrow_forward</span>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <% if (filters.totalPages > 1) { %>
                        <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
                            <p class="text-xs font-semibold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %> (<%= filters.totalQAs %> queries)</p>
                            <div class="flex items-center gap-1 flex-wrap justify-center">
                                <% for(var i=1; i<=filters.totalPages; i++) { %>
                                    <a href="?page=<%= i %>&class=<%= encodeURIComponent(filters.class) %>&subject=<%= encodeURIComponent(filters.subject) %>&course=<%= encodeURIComponent(filters.course) %>&status=<%= encodeURIComponent(filters.status || 'open') %>" 
                                       class="size-8 rounded-xl flex items-center justify-center text-xs font-bold transition-all <%= (filters.page === i) ? 'bg-primary text-white shadow-2xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                </div>

            </div>
            <%- include('bottom-nav', { activePage: 'qa' }) %>
        </main>
    </div>

    <!-- Image Lightbox Modal for Question Attachments -->
    <div id="qaImageLightbox" class="fixed inset-0 z-[200] bg-black/80 backdrop-blur-xs hidden flex items-center justify-center p-3" onclick="if(event.target === this) closeQaImageLightbox()">
        <div class="relative max-w-2xl max-h-[85vh] bg-transparent flex flex-col items-center">
            <button type="button" onclick="closeQaImageLightbox()" class="absolute -top-10 right-0 size-8 rounded-full bg-white/20 text-white hover:bg-white/40 flex items-center justify-center cursor-pointer select-none">
                <span class="material-symbols-rounded text-xl">close</span>
            </button>
            <img id="qaLightboxImg" src="" alt="Enlarged attachment" class="max-w-full max-h-[80vh] rounded-2xl object-contain shadow-2xl">
        </div>
    </div>

    <!-- Floating System Toast Notice -->
    <div id="qaSystemNotice" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-[300] max-w-[92vw] sm:max-w-md w-full px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 animate-fade-in border transition-all pointer-events-auto">
        <span id="qaNoticeIcon" class="material-symbols-rounded text-xl shrink-0">check_circle</span>
        <span id="qaNoticeText" class="text-xs sm:text-sm font-semibold truncate flex-1"></span>
        <button type="button" onclick="closeQaNotice()" class="size-6 rounded-lg hover:bg-black/10 dark:hover:bg-white/10 flex items-center justify-center text-current cursor-pointer select-none shrink-0">
            <span class="material-symbols-rounded text-base">close</span>
        </button>
    </div>

    <script>
        // Update URL Filters without breaking history
        function updateFilters(key, value) {
            const params = new URLSearchParams(window.location.search);
            if (value === 'all') {
                params.delete(key);
            } else {
                params.set(key, value);
            }
            params.set('page', '1');
            window.location.href = '?' + params.toString();
        }

        // Live Client-side Question Search
        function filterQuestionsClient(query) {
            const q = (query || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.qa-item-card');
            let matchCount = 0;

            cards.forEach(card => {
                const qText = card.getAttribute('data-question') || '';
                const stuName = card.getAttribute('data-student') || '';
                if (!q || qText.includes(q) || stuName.includes(q)) {
                    card.style.display = 'flex';
                    matchCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countEl = document.getElementById('qaDisplayCount');
            if (countEl) countEl.textContent = matchCount;
        }

        // AJAX Answer Submission with Instant Feedback & Smooth Transition
        async function submitQaAnswer(e, qaId) {
            e.preventDefault();
            const input = document.getElementById('qa-answer-input-' + qaId);
            const btn = document.getElementById('qa-submit-btn-' + qaId);
            const card = document.getElementById('qa-card-' + qaId);
            const answer = input ? input.value.trim() : '';

            if (!answer) {
                showQaNotice('Please write an answer before submitting.', 'error');
                return;
            }

            const origBtnHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="material-symbols-rounded text-sm animate-spin">progress_activity</span><span>Saving...</span>`;
            }

            try {
                const res = await fetch('/teacher/qa/' + qaId + '/answer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ answer })
                });

                const data = await res.json().catch(() => ({}));

                if (res.ok && data.success) {
                    showQaNotice('Response submitted successfully!', 'success');
                    // Smoothly animate removal if currently filtering for pending
                    const currentStatus = '<%= filters.status || "open" %>';
                    if (currentStatus === 'open' && card) {
                        card.style.transition = 'all 0.4s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            card.remove();
                            const remaining = document.querySelectorAll('.qa-item-card').length;
                            const countEl = document.getElementById('qaDisplayCount');
                            if (countEl) countEl.textContent = remaining;
                            if (remaining === 0) {
                                window.location.reload();
                            }
                        }, 400);
                    } else {
                        setTimeout(() => window.location.reload(), 800);
                    }
                } else {
                    showQaNotice(data.message || 'Failed to submit response. Please try again.', 'error');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = origBtnHtml;
                    }
                }
            } catch (err) {
                console.error(err);
                // Fallback to standard form submission
                e.target.submit();
            }
        }

        // System Notice Toast
        let noticeTimer = null;
        function showQaNotice(text, type = 'success') {
            const toast = document.getElementById('qaSystemNotice');
            const toastText = document.getElementById('qaNoticeText');
            const toastIcon = document.getElementById('qaNoticeIcon');
            if (!toast || !toastText) return;

            toastText.textContent = text;
            if (type === 'error') {
                toast.className = 'fixed top-4 left-1/2 -translate-x-1/2 z-[300] max-w-[92vw] sm:max-w-md w-full px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 animate-fade-in border bg-rose-500/95 text-white border-rose-600/90 pointer-events-auto';
                if (toastIcon) toastIcon.textContent = 'error';
            } else {
                toast.className = 'fixed top-4 left-1/2 -translate-x-1/2 z-[300] max-w-[92vw] sm:max-w-md w-full px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 animate-fade-in border bg-emerald-600/95 text-white border-emerald-700/90 pointer-events-auto';
                if (toastIcon) toastIcon.textContent = 'check_circle';
            }

            if (noticeTimer) clearTimeout(noticeTimer);
            noticeTimer = setTimeout(closeQaNotice, 3500);
        }

        function closeQaNotice() {
            const toast = document.getElementById('qaSystemNotice');
            if (toast) toast.classList.add('hidden');
        }

        // Image Lightbox Helpers
        function openQaImageLightbox(imgUrl) {
            const modal = document.getElementById('qaImageLightbox');
            const img = document.getElementById('qaLightboxImg');
            if (modal && img) {
                img.src = imgUrl;
                modal.classList.remove('hidden');
            }
        }

        function closeQaImageLightbox() {
            const modal = document.getElementById('qaImageLightbox');
            if (modal) modal.classList.add('hidden');
        }

        // Check for URL query param feedback on page load
        window.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            if (params.get('success') === '1') {
                showQaNotice('Response submitted successfully!', 'success');
                params.delete('success');
                const newSearch = params.toString() ? '?' + params.toString() : window.location.pathname;
                window.history.replaceState({}, '', newSearch);
            }
        });
    </script>
</body>
</html>
