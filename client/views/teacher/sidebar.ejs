<style>
    /* Custom Transparent Scrollbar for Sidebar */
    .admin-sidebar::-webkit-scrollbar { width: 4px; }
    .admin-sidebar::-webkit-scrollbar-track { background: transparent; }
    .admin-sidebar::-webkit-scrollbar-thumb { background: rgba(203, 213, 225, 0.15); border-radius: 10px; }
    .admin-sidebar:hover::-webkit-scrollbar-thumb { background: rgba(203, 213, 225, 0.35); border-radius: 10px; }
    .admin-sidebar { scrollbar-width: thin; scrollbar-color: rgba(203, 213, 225, 0.15) transparent; }
</style>

<div class="flex flex-col h-full bg-white dark:bg-[#0f172a]">
    <!-- Teacher Identity -->
    <div class="px-4 py-3 sm:py-3.5 border-b border-slate-100 dark:border-white/5 flex items-center justify-between shrink-0">
        <a href="/teacher/profile" class="flex items-center gap-3 group min-w-0 flex-1 select-none" title="View Profile">
            <div class="w-10 h-10 min-w-[40px] min-h-[40px] max-w-[40px] max-h-[40px] rounded-xl bg-primary/10 flex items-center justify-center font-bold text-sm shadow-xs overflow-hidden border border-primary/20 shrink-0">
                <% if (user.profilePicture) { %>
                    <img src="<%= user.profilePicture %>" alt="<%= user.name || 'Profile' %>" class="w-full h-full object-cover block shrink-0" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';">
                    <span class="text-primary hidden w-full h-full items-center justify-center font-bold text-sm leading-none"><%= (user.name || 'T')[0] %></span>
                <% } else { %>
                    <span class="text-primary w-full h-full flex items-center justify-center font-bold text-sm leading-none"><%= (user.name || 'T')[0] %></span>
                <% } %>
            </div>
            <div class="flex-1 min-w-0">
                <h2 class="text-sm font-bold tracking-tight text-slate-900 dark:text-white truncate leading-tight group-hover:text-primary transition-colors"><%= user.name %></h2>
                <%
                    let sidebarRole = (user.designation && user.designation.trim()) || 'Instructor';
                    if (sidebarRole.toLowerCase() === 'instructor') sidebarRole = 'Instructor';
                %>
                <p class="text-[10.5px] font-semibold text-primary truncate leading-tight mt-0.5" title="<%= sidebarRole %>"><%= sidebarRole %></p>
            </div>
        </a>
        <!-- Close button for mobile drawer -->
        <button type="button" onclick="toggleTeacherSidebar(false)" class="lg:hidden size-8 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-colors shrink-0 cursor-pointer" title="Close Sidebar">
            <span class="material-symbols-rounded text-lg">close</span>
        </button>
    </div>

    <!-- Navigation Scroll Area -->
    <div id="sidebarScrollArea" class="flex-1 overflow-y-auto pl-1.5 pr-2.5 pt-2.5 pb-5 no-scrollbar space-y-5">
        
        <!-- ========== MAIN SECTION ========== -->
        <div>
            <p class="text-[9.5px] font-bold text-slate-400 dark:text-slate-500 tracking-wider mb-1.5 px-3 uppercase">Core Management</p>
            <nav class="space-y-0.5">
                <a href="/teacher" class="nav-link <%= active === 'dashboard' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">dashboard</span>
                    <span class="text-xs">Dashboard</span>
                </a>
                <a href="/teacher/messages" class="nav-link <%= active === 'messages' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">chat</span>
                    <span class="text-xs">Student messages</span>
                </a>
                <a href="/teacher/notifications" class="nav-link <%= active === 'notifications' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">notifications</span>
                    <span class="text-xs">Notifications</span>
                </a>
                <a href="/teacher/courses" class="nav-link <%= active === 'courses' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">auto_stories</span>
                    <span class="text-xs">Assigned courses</span>
                </a>
                <a href="/teacher/topics" class="nav-link <%= active === 'topics' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">account_tree</span>
                    <span class="text-xs">Syllabus & Topics</span>
                </a>
                <a href="/teacher/qa" class="nav-link <%= active === 'qa' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">forum</span>
                    <span class="text-xs">Q&A</span>
                </a>
                <a href="/teacher/notes" class="nav-link <%= active === 'notes' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">description</span>
                    <span class="text-xs">Notes</span>
                </a>
                <a href="/teacher/quizzes" class="nav-link <%= active === 'quizzes' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">psychology</span>
                    <span class="text-xs">Quiz</span>
                </a>
                <a href="/teacher/question-bank" class="nav-link <%= active === 'questions' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">archive</span>
                    <span class="text-xs">Question Archive</span>
                </a>
                <a href="/teacher/written-evaluations" class="nav-link <%= active === 'written-evaluations' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">rate_review</span>
                    <span class="text-xs">Written Evaluations</span>
                </a>
                <a href="/teacher/question-details" class="nav-link <%= active === 'question-details' ? 'active' : '' %>">
                    <span class="material-symbols-rounded">quiz</span>
                    <span class="text-xs">Questions</span>
                </a>
                <a href="/teacher/ai-knowledge" class="nav-link <%= active === 'ai-knowledge' ? 'active' : '' %>">
                    <span class="material-symbols-rounded text-indigo-500">auto_awesome</span>
                    <span class="text-xs">AI Knowledge Hub</span>
                </a>
            </nav>
        </div>
    </div>

    <!-- Sidebar Footer -->
    <div class="p-4 mt-auto border-t border-slate-50 dark:border-white/5">
        <a href="/logout" class="flex items-center gap-3 p-2.5 rounded-xl bg-rose-50/40 dark:bg-rose-500/5 hover:bg-rose-100/50 dark:hover:bg-rose-500/10 transition-all group">
            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 flex items-center justify-center text-rose-500 shadow-sm border border-rose-100/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-rounded text-[20px]">logout</span>
            </div>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-400 leading-none">Sign out</span>
        </a>
    </div>
</div>

<style>
    .nav-link {
        display: flex; align-items: center; gap: 11px; padding: 8.5px 14px; border-radius: 12px;
        font-weight: 600; font-size: 0.78rem; transition: all 0.2s ease; color: #1e293b;
    }
    .dark .nav-link { color: #cbd5e1; }
    .nav-link:hover { background: #f1f5f9; color: #020617; }
    .dark .nav-link:hover { background: #1e293b; color: #ffffff; }
    .nav-link.active { background: #e2e8f0; color: #020617; font-weight: 700; }
    .dark .nav-link.active { background: rgba(255, 255, 255, 0.08); color: #ffffff; font-weight: 700; }
    .nav-link .material-symbols-rounded { font-size: 19px; flex-shrink: 0; color: #334155; transition: color 0.2s ease; }
    .dark .nav-link .material-symbols-rounded { color: #94a3b8; }
    .nav-link:hover .material-symbols-rounded { color: #020617; }
    .dark .nav-link:hover .material-symbols-rounded { color: #ffffff; }
    .nav-link.active .material-symbols-rounded { color: var(--color-primary, #2563eb); }
    .dark .nav-link.active .material-symbols-rounded { color: #38bdf8; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
