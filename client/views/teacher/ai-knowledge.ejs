    <!-- Scripts for Math rendering, Modals, Tab toggling, and Toast notifications -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Render Math in all feed items on page load
            renderAllMath(document.body);

            // Handle URL query feedback toasts
            checkUrlFeedback();
        });

        // Function to render KaTeX math safely
        function renderAllMath(element) {
            if (typeof renderMathInElement === 'function' && element) {
                renderMathInElement(element, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false }
                    ],
                    throwOnError: false
                });
            }
        }

        // Search clear helper
        function clearSearchField() {
            const input = document.querySelector('input[name="search"]');
            if (input) {
                input.value = '';
                document.getElementById('filterForm').submit();
            }
        }

        // Quick filter by clicking a keyword chip
        function filterByKeyword(keyword) {
            const input = document.querySelector('input[name="search"]');
            if (input) {
                input.value = keyword;
                document.getElementById('filterForm').submit();
            }
        }

        // Cached topics from API for chapter cascading
        let _cachedKnowledgeTopics = [];

        function toggleAllSubjects() {
            const cbs = document.querySelectorAll('.knowledge-subject-cb');
            if (!cbs.length) return;
            const anyUnchecked = Array.from(cbs).some(cb => !cb.checked);
            cbs.forEach(cb => cb.checked = anyUnchecked);
            onKnowledgeSubjectOrClassChange();
        }

        function toggleAllClassesCheckbox(cbAll) {
            const cbs = document.querySelectorAll('.knowledge-class-cb');
            cbs.forEach(cb => cb.checked = cbAll.checked);
            onKnowledgeSubjectOrClassChange();
        }

        function onIndividualClassChange() {
            const cbs = Array.from(document.querySelectorAll('.knowledge-class-cb'));
            const cbAll = document.getElementById('cbAllClasses');
            if (cbAll) {
                cbAll.checked = cbs.length > 0 && cbs.every(cb => cb.checked);
            }
            onKnowledgeSubjectOrClassChange();
        }

        async function onKnowledgeSubjectOrClassChange(preselectedChapters = [], preselectedTopics = []) {
            const selectedSubjects = Array.from(document.querySelectorAll('.knowledge-subject-cb:checked')).map(cb => cb.value);
            const selectedClasses = Array.from(document.querySelectorAll('.knowledge-class-cb:checked')).map(cb => cb.value);
            const cbAllClasses = document.getElementById('cbAllClasses');
            const hasAllClasses = cbAllClasses && cbAllClasses.checked;

            const chaptersContainer = document.getElementById('chaptersContainer');
            const topicsContainer = document.getElementById('topicsContainer');
            const toggleChapBtn = document.getElementById('toggleAllChaptersBtn');
            const chaptersLoading = document.getElementById('chaptersLoading');

            if (selectedSubjects.length === 0 || (selectedClasses.length === 0 && !hasAllClasses)) {
                chaptersContainer.innerHTML = '<span class="text-slate-400 text-xs italic">Select subject(s) and class(es) to load chapters.</span>';
                topicsContainer.innerHTML = '<span class="text-slate-400 text-xs italic">Select chapter(s) to load topics.</span>';
                if (toggleChapBtn) toggleChapBtn.classList.add('hidden');
                _cachedKnowledgeTopics = [];
                return;
            }

            if (chaptersLoading) chaptersLoading.classList.remove('hidden');

            try {
                const params = new URLSearchParams();
                selectedSubjects.forEach(s => params.append('subjects[]', s));
                if (!hasAllClasses) {
                    selectedClasses.forEach(c => params.append('classLevels[]', c));
                }
                
                const res = await fetch(`/teacher/api/topics?${params.toString()}`);
                const data = await res.json();
                _cachedKnowledgeTopics = data.topics || [];
                
                // Get unique chapter list
                let chapters = data.chapters || [];
                if (!chapters.length && _cachedKnowledgeTopics.length) {
                    chapters = Array.from(new Set(_cachedKnowledgeTopics.map(t => (t.chapter && t.chapter.name) ? t.chapter.name.trim() : (t.chapter || '')).filter(Boolean)));
                }

                if (chapters.length === 0) {
                    chaptersContainer.innerHTML = '<span class="text-slate-400 text-xs italic">No chapters found for selected subject/class.</span>';
                    if (toggleChapBtn) toggleChapBtn.classList.add('hidden');
                } else {
                    if (toggleChapBtn) toggleChapBtn.classList.remove('hidden');
                    chaptersContainer.innerHTML = `
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                            ${chapters.map(ch => {
                                const isChecked = preselectedChapters.includes(ch) ? 'checked' : '';
                                return `
                                    <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 cursor-pointer text-xs transition-colors">
                                        <input type="checkbox" name="chapters[]" value="${ch.replace(/"/g, '&quot;')}" ${isChecked} class="knowledge-chapter-cb size-4 text-indigo-600 rounded cursor-pointer" onchange="onKnowledgeChapterChange()">
                                        <span class="truncate text-slate-700 dark:text-slate-300 font-medium">${ch}</span>
                                    </label>
                                `;
                            }).join('')}
                        </div>
                    `;
                }

                // Populate topics based on current checked chapters
                onKnowledgeChapterChange(preselectedTopics);
            } catch (err) {
                console.error('Error fetching chapters & topics:', err);
                chaptersContainer.innerHTML = '<span class="text-rose-400 text-xs">Failed to load chapters.</span>';
            } finally {
                if (chaptersLoading) chaptersLoading.classList.add('hidden');
            }
        }

        // Section collapsible toggles (normally collapsed)
        let isChapterSectionExpanded = false;
        function toggleChapterSection(forceState) {
            isChapterSectionExpanded = typeof forceState === 'boolean' ? forceState : !isChapterSectionExpanded;
            const body = document.getElementById('chapterSectionBody');
            const text = document.getElementById('chapterToggleText');
            const icon = document.getElementById('chapterToggleIcon');
            if (isChapterSectionExpanded) {
                body.classList.remove('hidden');
                text.textContent = 'Collapse';
                icon.style.transform = 'rotate(180deg)';
            } else {
                body.classList.add('hidden');
                text.textContent = 'Expand';
                icon.style.transform = 'rotate(0deg)';
            }
        }

        let isTopicSectionExpanded = false;
        function toggleTopicSection(forceState) {
            isTopicSectionExpanded = typeof forceState === 'boolean' ? forceState : !isTopicSectionExpanded;
            const body = document.getElementById('topicSectionBody');
            const text = document.getElementById('topicToggleText');
            const icon = document.getElementById('topicToggleIcon');
            if (isTopicSectionExpanded) {
                body.classList.remove('hidden');
                text.textContent = 'Collapse';
                icon.style.transform = 'rotate(180deg)';
            } else {
                body.classList.add('hidden');
                text.textContent = 'Expand';
                icon.style.transform = 'rotate(0deg)';
            }
        }

        function updateSelectedChaptersCount() {
            const checkedCount = document.querySelectorAll('.knowledge-chapter-cb:checked').length;
            const badge = document.getElementById('selectedChaptersCountBadge');
            if (badge) {
                if (checkedCount > 0) {
                    badge.textContent = checkedCount;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        }

        function updateSelectedTopicsCount() {
            const checkedCount = document.querySelectorAll('.knowledge-topic-cb:checked').length;
            const badge = document.getElementById('selectedTopicsCountBadge');
            if (badge) {
                if (checkedCount > 0) {
                    badge.textContent = checkedCount;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        }

        function onKnowledgeChapterChange(preselectedTopics = []) {
            const checkedChapters = Array.from(document.querySelectorAll('.knowledge-chapter-cb:checked')).map(cb => cb.value);
            const topicsContainer = document.getElementById('topicsContainer');
            const toggleTopicsBtn = document.getElementById('toggleAllTopicsBtn');

            updateSelectedChaptersCount();

            if (!_cachedKnowledgeTopics.length) {
                topicsContainer.innerHTML = '<span class="text-slate-400 text-xs italic">No topics available.</span>';
                if (toggleTopicsBtn) toggleTopicsBtn.classList.add('hidden');
                updateSelectedTopicsCount();
                return;
            }

            let filteredTopics = _cachedKnowledgeTopics;
            if (checkedChapters.length > 0) {
                filteredTopics = _cachedKnowledgeTopics.filter(t => {
                    const chName = (t.chapter && t.chapter.name) ? t.chapter.name.trim() : (t.chapter || '');
                    return chName && checkedChapters.includes(chName);
                });
            }

            const uniqueTopicNames = Array.from(new Set(filteredTopics.map(t => t.name).filter(Boolean)));

            if (uniqueTopicNames.length === 0) {
                topicsContainer.innerHTML = '<span class="text-slate-400 text-xs italic">No topics found for selected chapter(s).</span>';
                if (toggleTopicsBtn) toggleTopicsBtn.classList.add('hidden');
            } else {
                if (toggleTopicsBtn) toggleTopicsBtn.classList.remove('hidden');
                topicsContainer.innerHTML = `
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        ${uniqueTopicNames.map(top => {
                            const isChecked = preselectedTopics.includes(top) ? 'checked' : '';
                            return `
                                <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 cursor-pointer text-xs transition-colors">
                                    <input type="checkbox" name="topics[]" value="${top.replace(/"/g, '&quot;')}" ${isChecked} class="knowledge-topic-cb size-4 text-indigo-600 rounded cursor-pointer" onchange="updateSelectedTopicsCount()">
                                    <span class="truncate text-slate-700 dark:text-slate-300 font-medium">${top}</span>
                                </label>
                            `;
                        }).join('')}
                    </div>
                `;
            }
            updateSelectedTopicsCount();
        }

        function toggleAllChapters() {
            const cbs = document.querySelectorAll('.knowledge-chapter-cb');
            if (!cbs.length) return;
            const anyUnchecked = Array.from(cbs).some(cb => !cb.checked);
            cbs.forEach(cb => cb.checked = anyUnchecked);
            onKnowledgeChapterChange();
        }

        function toggleAllTopics() {
            const cbs = document.querySelectorAll('.knowledge-topic-cb');
            if (!cbs.length) return;
            const anyUnchecked = Array.from(cbs).some(cb => !cb.checked);
            cbs.forEach(cb => cb.checked = anyUnchecked);
            updateSelectedTopicsCount();
        }

        // Image Viewer Lightbox Modal in the same tab
        function openImageViewer(url, title = 'Image Preview') {
            const modal = document.getElementById('imageViewerModal');
            const img = document.getElementById('imageViewerImg');
            const titleEl = document.getElementById('imageViewerTitle');
            const downloadBtn = document.getElementById('imageViewerDownloadBtn');

            if (!modal || !img) return;

            img.src = url;
            titleEl.textContent = title || 'Image Preview';
            downloadBtn.href = url;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeImageViewer(event) {
            const modal = document.getElementById('imageViewerModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            const img = document.getElementById('imageViewerImg');
            if (img) img.src = '';
            document.body.style.overflow = '';
        }

        // Close image viewer on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const imgModal = document.getElementById('imageViewerModal');
                if (imgModal && !imgModal.classList.contains('hidden')) {
                    closeImageViewer();
                }
            }
        });

        function handleFileSelect(input) {
            const file = input.files && input.files[0];
            if (!file) return;

            // 10MB limit
            const maxSize = 10 * 1024 * 1024;
            if (file.size > maxSize) {
                showToast('File size must be 10MB or less.', 'error');
                input.value = '';
                return;
            }

            const allowedTypes = [
                'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/svg+xml',
                'application/pdf'
            ];
            if (!allowedTypes.includes(file.type) && !file.name.match(/\.(jpe?g|png|webp|gif|svg|pdf)$/i)) {
                showToast('Only Image or PDF files are allowed.', 'error');
                input.value = '';
                return;
            }

            document.getElementById('formRemoveFile').value = 'false';
            document.getElementById('fileUploadBox').classList.add('hidden');
            const previewCard = document.getElementById('filePreviewCard');
            previewCard.classList.remove('hidden');

            document.getElementById('filePreviewName').textContent = file.name;
            const sizeInMb = (file.size / (1024 * 1024)).toFixed(2);
            document.getElementById('filePreviewSize').textContent = `${sizeInMb} MB`;

            const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
            const iconSpan = document.getElementById('filePreviewIcon');
            iconSpan.textContent = isPdf ? 'picture_as_pdf' : 'image';

            const viewLink = document.getElementById('filePreviewLink');
            if (isPdf) {
                const blobUrl = URL.createObjectURL(file);
                viewLink.href = blobUrl;
                viewLink.onclick = null;
            } else {
                const blobUrl = URL.createObjectURL(file);
                viewLink.href = 'javascript:void(0)';
                viewLink.onclick = () => openImageViewer(blobUrl, file.name);
            }
            viewLink.classList.remove('hidden');
        }

        function removeAttachedFile() {
            const fileInput = document.getElementById('formFile');
            if (fileInput) fileInput.value = '';
            document.getElementById('formRemoveFile').value = 'true';
            document.getElementById('filePreviewCard').classList.add('hidden');
            document.getElementById('fileUploadBox').classList.remove('hidden');
        }

        function validateKnowledgeForm(event) {
            const subjectCbs = document.querySelectorAll('.knowledge-subject-cb:checked');
            const subjectError = document.getElementById('subjectError');
            if (subjectCbs.length === 0) {
                if (subjectError) subjectError.classList.remove('hidden');
                showToast('Please select at least one subject.', 'error');
                if (event) event.preventDefault();
                return false;
            } else if (subjectError) {
                subjectError.classList.add('hidden');
            }

            const classCbs = document.querySelectorAll('.knowledge-class-cb:checked');
            const cbAll = document.getElementById('cbAllClasses');
            const classError = document.getElementById('classError');
            if (classCbs.length === 0 && (!cbAll || !cbAll.checked)) {
                if (classError) classError.classList.remove('hidden');
                showToast('Please select at least one class.', 'error');
                if (event) event.preventDefault();
                return false;
            } else if (classError) {
                classError.classList.add('hidden');
            }

            const fileInput = document.getElementById('formFile');
            if (fileInput && fileInput.files && fileInput.files[0]) {
                if (fileInput.files[0].size > 10 * 1024 * 1024) {
                    showToast('Attachment exceeds 10MB limit.', 'error');
                    if (event) event.preventDefault();
                    return false;
                }
            }

            return true;
        }

        // Modal opening & editing handlers
        function openCreateModal() {
            document.getElementById('modalTitle').innerHTML = '<span class="material-symbols-rounded text-indigo-500 text-lg">add_circle</span><span>Add Rule</span>';
            document.getElementById('modalForm').action = '/teacher/ai-knowledge/create';
            document.getElementById('formTitle').value = '';
            document.getElementById('formTopic').value = '';
            document.getElementById('formKeywords').value = '';
            document.getElementById('formContent').value = '';
            document.getElementById('formPriority').value = '100';
            document.getElementById('formIsActive').checked = true;

            // Reset File
            document.getElementById('formRemoveFile').value = 'false';
            const fileInput = document.getElementById('formFile');
            if (fileInput) fileInput.value = '';
            document.getElementById('filePreviewCard').classList.add('hidden');
            document.getElementById('fileUploadBox').classList.remove('hidden');

            // Select all subjects or first subject by default
            const subCbs = document.querySelectorAll('.knowledge-subject-cb');
            subCbs.forEach((cb, idx) => { cb.checked = (idx === 0); });

            // Select All Classes by default
            const cbAll = document.getElementById('cbAllClasses');
            if (cbAll) cbAll.checked = true;
            const clsCbs = document.querySelectorAll('.knowledge-class-cb');
            clsCbs.forEach(cb => { cb.checked = true; });

            // Trigger chapter/topic loading
            onKnowledgeSubjectOrClassChange();

            // Sections collapsed normally by default
            toggleChapterSection(false);
            toggleTopicSection(false);
            updateSelectedChaptersCount();
            updateSelectedTopicsCount();

            // Default to Write tab
            switchContentTab('write');

            const modal = document.getElementById('knowledgeModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function openEditModal(item) {
            document.getElementById('modalTitle').innerHTML = '<span class="material-symbols-rounded text-indigo-500 text-lg">edit</span><span>Edit Rule</span>';
            document.getElementById('modalForm').action = '/teacher/ai-knowledge/' + item._id + '/edit';
            document.getElementById('formTitle').value = item.title || '';
            document.getElementById('formKeywords').value = (item.keywords || []).join(', ');
            document.getElementById('formContent').value = item.content || '';
            document.getElementById('formPriority').value = item.priority || 100;
            document.getElementById('formIsActive').checked = item.isActive !== false;
            document.getElementById('formTopic').value = item.topic || '';

            // Handle subjects
            const itemSubjects = Array.isArray(item.subject) 
                ? item.subject 
                : (item.subject ? [item.subject] : []);
            const subCbs = document.querySelectorAll('.knowledge-subject-cb');
            subCbs.forEach(cb => {
                cb.checked = itemSubjects.some(s => s.toLowerCase() === cb.value.toLowerCase());
            });

            // Handle classes
            const itemClasses = Array.isArray(item.classLevel) 
                ? item.classLevel 
                : (item.classLevel ? [item.classLevel] : []);
            const cbAll = document.getElementById('cbAllClasses');
            const clsCbs = document.querySelectorAll('.knowledge-class-cb');
            const isAllClasses = itemClasses.some(c => c.toLowerCase() === 'all classes');

            if (isAllClasses) {
                if (cbAll) cbAll.checked = true;
                clsCbs.forEach(cb => cb.checked = true);
            } else {
                if (cbAll) cbAll.checked = false;
                clsCbs.forEach(cb => {
                    cb.checked = itemClasses.some(c => c.toLowerCase() === cb.value.toLowerCase());
                });
            }

            // Handle file
            document.getElementById('formRemoveFile').value = 'false';
            const fileInput = document.getElementById('formFile');
            if (fileInput) fileInput.value = '';

            if (item.fileUrl) {
                document.getElementById('fileUploadBox').classList.add('hidden');
                const previewCard = document.getElementById('filePreviewCard');
                previewCard.classList.remove('hidden');
                document.getElementById('filePreviewName').textContent = item.fileName || 'Attached file';
                const sizeText = item.fileSize ? (item.fileSize / (1024 * 1024)).toFixed(2) + ' MB' : '';
                document.getElementById('filePreviewSize').textContent = sizeText;
                
                const isPdf = Boolean(item.fileType?.includes('pdf') || item.fileUrl?.toLowerCase().endsWith('.pdf') || item.fileUrl?.toLowerCase().includes('.pdf'));
                const viewLink = document.getElementById('filePreviewLink');
                if (isPdf) {
                    viewLink.href = '/teacher/ai-knowledge/' + item._id + '/view-file';
                    viewLink.onclick = null;
                } else {
                    viewLink.href = 'javascript:void(0)';
                    viewLink.onclick = () => openImageViewer(item.fileUrl, item.fileName || item.title);
                }
                viewLink.classList.remove('hidden');

                const iconSpan = document.getElementById('filePreviewIcon');
                iconSpan.textContent = isPdf ? 'picture_as_pdf' : 'image';
            } else {
                document.getElementById('filePreviewCard').classList.add('hidden');
                document.getElementById('fileUploadBox').classList.remove('hidden');
            }

            // Handle Chapters & Topics preselection
            const preselectedChapters = Array.isArray(item.chapters) && item.chapters.length > 0 
                ? item.chapters 
                : (item.chapter ? item.chapter.split(',').map(s => s.trim()).filter(Boolean) : []);
            
            const preselectedTopics = Array.isArray(item.topics) && item.topics.length > 0 
                ? item.topics 
                : (item.topic ? item.topic.split(',').map(s => s.trim()).filter(Boolean) : []);

            onKnowledgeSubjectOrClassChange(preselectedChapters, preselectedTopics);

            // Collapsed normally unless already has preselected items
            toggleChapterSection(preselectedChapters.length > 0);
            toggleTopicSection(preselectedTopics.length > 0);

            // Default to Write tab
            switchContentTab('write');

            const modal = document.getElementById('knowledgeModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('knowledgeModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        // Tab switcher: Write vs Live Preview
        let currentTab = 'write';
        function switchContentTab(tab) {
            currentTab = tab;
            const writeBtn = document.getElementById('tabWriteBtn');
            const previewBtn = document.getElementById('tabPreviewBtn');
            const writeContainer = document.getElementById('editorWriteContainer');
            const previewContainer = document.getElementById('editorPreviewContainer');

            if (tab === 'write') {
                writeBtn.className = 'px-2.5 py-0.5 text-xs font-medium rounded-md bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-2xs transition-all';
                previewBtn.className = 'px-2.5 py-0.5 text-xs font-medium rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all';
                writeContainer.classList.remove('hidden');
                previewContainer.classList.add('hidden');
            } else {
                previewBtn.className = 'px-2.5 py-0.5 text-xs font-medium rounded-md bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-2xs transition-all';
                writeBtn.className = 'px-2.5 py-0.5 text-xs font-medium rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all';
                writeContainer.classList.add('hidden');
                previewContainer.classList.remove('hidden');

                renderLivePreview();
            }
        }

        function updatePreviewIfActive() {
            if (currentTab === 'preview') {
                renderLivePreview();
            }
        }

        function renderLivePreview() {
            const content = document.getElementById('formContent').value.trim();
            const output = document.getElementById('previewOutput');
            if (!content) {
                output.innerHTML = '<span class="text-slate-400 italic">No content to preview yet. Switch to Write to enter text and formulas.</span>';
                return;
            }

            // Convert markdown using marked if available
            if (typeof marked !== 'undefined') {
                output.innerHTML = marked.parse(content);
            } else {
                output.textContent = content;
            }

            // Render math formulas
            renderAllMath(output);
        }

        // Quick syntax insertion into content textarea
        function insertSyntax(snippet) {
            const textarea = document.getElementById('formContent');
            if (!textarea) return;

            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;

            textarea.value = text.substring(0, start) + snippet + text.substring(end);
            textarea.focus();
            textarea.selectionStart = textarea.selectionEnd = start + snippet.length;
        }

        // Toggle active status via fetch API
        async function toggleStatus(id, btn) {
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.style.opacity = '0.7';

            try {
                const res = await fetch('/teacher/ai-knowledge/' + id + '/toggle', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const isActive = data.isActive;
                    btn.className = 'px-2 py-0.5 rounded-md text-[10.5px] font-bold transition-all flex items-center gap-1 cursor-pointer ' + 
                        (isActive 
                            ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60' 
                            : 'bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800 dark:text-slate-400');
                    btn.innerHTML = `<span class="size-1.5 rounded-full ${isActive ? 'bg-emerald-500' : 'bg-slate-400'}"></span><span>${isActive ? 'Active' : 'Disabled'}</span>`;
                    showToast(isActive ? 'Rule is now Active' : 'Rule disabled', 'success');
                } else {
                    btn.innerHTML = originalContent;
                    showToast('Failed to toggle status', 'error');
                }
            } catch (e) {
                console.error(e);
                btn.innerHTML = originalContent;
                showToast('Network error while toggling status', 'error');
            } finally {
                btn.disabled = false;
                btn.style.opacity = '1';
            }
        }

        // Toast notification system
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            const isSuccess = type === 'success';
            const isError = type === 'error';

            toast.className = `p-3 rounded-xl shadow-lg border text-xs font-bold flex items-center gap-2 pointer-events-auto transition-all animate-slide-up ${
                isSuccess ? 'bg-emerald-600 text-white border-emerald-500' :
                isError ? 'bg-rose-600 text-white border-rose-500' :
                'bg-indigo-600 text-white border-indigo-500'
            }`;

            const iconName = isSuccess ? 'check_circle' : isError ? 'error' : 'info';
            toast.innerHTML = `<span class="material-symbols-rounded text-base">${iconName}</span><span class="flex-1">${message}</span>`;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => toast.remove(), 250);
            }, 3500);
        }

        // Check URL parameters for feedback alerts
        function checkUrlFeedback() {
            const params = new URLSearchParams(window.location.search);
            const success = params.get('success');
            const error = params.get('error');

            if (success) {
                if (success === 'created') showToast('Knowledge rule created successfully!', 'success');
                else if (success === 'updated') showToast('Knowledge rule updated successfully!', 'success');
                else if (success === 'deleted') showToast('Knowledge rule deleted successfully!', 'success');
                else showToast('Operation completed successfully!', 'success');
                
                // Clean URL query without page reload
                params.delete('success');
                const newQuery = params.toString() ? '?' + params.toString() : window.location.pathname;
                window.history.replaceState({}, document.title, newQuery);
            } else if (error) {
                showToast('Action failed. Please try again.', 'error');
                params.delete('error');
                const newQuery = params.toString() ? '?' + params.toString() : window.location.pathname;
                window.history.replaceState({}, document.title, newQuery);
            }
        }
    </script>
</body>

