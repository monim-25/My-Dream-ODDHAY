<!-- Teacher Mobile Bottom Navigation (Visible strictly on small screens < lg) -->
<nav id="teacher-bottom-nav" class="teacher-bottom-nav lg:hidden fixed bottom-0 left-0 right-0 w-full bg-white dark:bg-[#0b1120] border-t border-slate-200/90 dark:border-slate-800/90 z-40 px-2 shadow-[0_-4px_16px_rgba(0,0,0,0.04)] dark:shadow-[0_-4px_24px_rgba(0,0,0,0.3)] transition-all" style="padding-top: 5px; padding-bottom: max(12px, env(safe-area-inset-bottom, 0px));">
    <% 
    const curPage = locals.activePage || locals.active || '';
    
    // 5 Symmetrical Balanced Mobile Tabs for Teacher Panel
    const teacherMenus = [
        { 
            id: 'dashboard', 
            icon: 'home', 
            label: 'Home', 
            link: '/teacher',
            isActive: (curPage === 'dashboard' || curPage === 'home' || curPage === '')
        }, 
        { 
            id: 'courses', 
            icon: 'auto_stories', 
            label: 'Courses', 
            link: '/teacher/courses',
            isActive: (curPage === 'courses' || curPage === 'course' || curPage === 'curriculum' || curPage === 'notes' || curPage === 'note-details' || curPage === 'ai-knowledge')
        }, 
        { 
            id: 'qa', 
            icon: 'forum', 
            label: 'Q&A', 
            link: '/teacher/qa',
            isActive: (curPage === 'qa' || curPage === 'qa-hub')
        }, 
        { 
            id: 'written-evaluations', 
            icon: 'assignment', 
            label: 'Exams', 
            link: '/teacher/written-evaluations',
            isActive: (curPage === 'written-evaluations' || curPage === 'evaluations' || curPage === 'quizzes' || curPage === 'quiz' || curPage === 'questions' || curPage === 'question-bank' || curPage === 'question-details' || curPage === 'add-question')
        }, 
        { 
            id: 'messages', 
            icon: 'chat_bubble', 
            label: 'Messages', 
            link: '/teacher/messages',
            isActive: (curPage === 'messages' || curPage === 'chat')
        } 
    ]; 
    %>

    <div class="grid grid-cols-5 items-center w-full max-w-lg mx-auto h-[56px] sm:h-[60px]">
        <% teacherMenus.forEach(menu => { 
            const isActive = menu.isActive || (curPage === menu.id);
        %>
            <div class="flex items-center justify-center h-full">
                <a href="<%= menu.link %>"
                    class="w-full h-full flex flex-col items-center justify-center group select-none transition-transform active:scale-95 focus:outline-none" 
                    title="<%= menu.label %>">
                    
                    <!-- Clean Container -->
                    <div class="w-11 sm:w-12 h-7 sm:h-8 rounded-full flex items-center justify-center transition-all duration-200 <%= isActive ? 'bg-blue-600/10 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300' %>">
                        <span class="material-symbols-rounded text-[22px] sm:text-[23px] leading-none flex items-center justify-center pointer-events-none" 
                              style="font-variation-settings: 'FILL' <%= isActive ? 1 : 0 %>, 'wght' <%= isActive ? 500 : 400 %>, 'opsz' 24;">
                            <%= menu.icon %>
                        </span>
                    </div>

                    <!-- Clean Typography Label -->
                    <span class="text-[10px] sm:text-[10.5px] mt-0.5 leading-none tracking-tight transition-colors truncate max-w-full px-0.5 text-center <%= isActive ? 'text-blue-600 dark:text-blue-400 font-medium' : 'text-slate-400 dark:text-slate-500 font-normal group-hover:text-slate-700 dark:group-hover:text-slate-300' %>">
                        <%= menu.label %>
                    </span>
                </a>
            </div>
        <% }); %>
    </div>
</nav>
