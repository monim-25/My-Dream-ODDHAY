<!-- Teacher Mobile Bottom Navigation (Visible strictly on small screens < lg) -->
<nav class="lg:hidden shrink-0 w-full bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-xl border-t border-slate-200/90 dark:border-slate-800/90 z-40 px-2 shadow-[0_-6px_28px_rgba(0,0,0,0.06)] dark:shadow-[0_-6px_28px_rgba(0,0,0,0.4)] sticky bottom-0" style="padding-top: 4px; padding-bottom: max(10px, env(safe-area-inset-bottom, 0px));">
    <% 
    const curPage = locals.activePage || locals.active || '';
    
    // 5 Symmetrical Balanced Mobile Tabs for Teacher Panel
    const teacherMenus = [
        { 
            id: 'dashboard', 
            icon: 'dashboard', 
            label: 'Home', 
            link: '/teacher',
            isActive: (curPage === 'dashboard' || curPage === 'home' || curPage === '')
        }, 
        { 
            id: 'courses', 
            icon: 'auto_stories', 
            label: 'Courses', 
            link: '/teacher/courses',
            isActive: (curPage === 'courses' || curPage === 'course' || curPage === 'curriculum')
        }, 
        { 
            id: 'qa', 
            icon: 'forum', 
            label: 'Q&A', 
            link: '/teacher/qa',
            isActive: (curPage === 'qa' || curPage === 'qa-hub')
        }, 
        { 
            id: 'written-evaluations', 
            icon: 'rate_review', 
            label: 'Exams', 
            link: '/teacher/written-evaluations',
            isActive: (curPage === 'written-evaluations' || curPage === 'evaluations' || curPage === 'quizzes' || curPage === 'quiz' || curPage === 'questions' || curPage === 'question-bank')
        }, 
        { 
            id: 'messages', 
            icon: 'chat', 
            label: 'Chat', 
            link: '/teacher/messages',
            isActive: (curPage === 'messages' || curPage === 'chat')
        } 
    ]; 
    %>

    <div class="grid grid-cols-5 items-center w-full max-w-lg mx-auto h-[68px] sm:h-[72px]">
        <% teacherMenus.forEach(menu => { 
            const isActive = menu.isActive || (curPage === menu.id);
        %>
            <div class="flex items-center justify-center h-full">
                <a href="<%= menu.link %>"
                    class="w-full h-full flex flex-col items-center justify-center group select-none py-1 transition-all active:scale-95 focus:outline-none" 
                    title="<%= menu.label %>">
                    
                    <!-- Modern Soft Pill Container -->
                    <div class="w-12 sm:w-14 h-8 rounded-full flex items-center justify-center transition-all duration-200 <%= isActive ? 'bg-blue-600/10 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400' : 'text-slate-500 dark:text-slate-400 group-hover:text-slate-800 dark:group-hover:text-slate-200 group-hover:bg-slate-100/60 dark:group-hover:bg-slate-800/40' %>">
                        <span class="material-symbols-rounded text-[24px] sm:text-[25px] leading-none transition-transform duration-200 <%= isActive ? 'scale-105' : 'group-hover:scale-105' %>" 
                              style="font-variation-settings: 'FILL' <%= isActive ? 1 : 0 %>, 'wght' <%= isActive ? 600 : 450 %>, 'opsz' 24;">
                            <%= menu.icon %>
                        </span>
                    </div>

                    <!-- Crisp Typography Label -->
                    <span class="text-[10.5px] sm:text-[11px] mt-1 leading-tight tracking-tight transition-colors truncate max-w-full px-1 text-center <%= isActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-slate-500 dark:text-slate-400 font-medium group-hover:text-slate-800 dark:group-hover:text-slate-200' %>">
                        <%= menu.label %>
                    </span>
                </a>
            </div>
        <% }); %>
    </div>
</nav>
