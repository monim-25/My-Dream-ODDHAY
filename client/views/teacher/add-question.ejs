        let cachedStudioTopics = [];
        let cachedStudioChapters = [];

        async function fetchStudioTopicsSafely(subject, classLevel) {
            const endpoints = ['/teacher/api/topics', '/api/topics'];
            const query = new URLSearchParams({ subject, classLevel }).toString();
            for (const ep of endpoints) {
                try {
                    const res = await fetch(ep + '?' + query, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) continue;
                    const ct = res.headers.get('content-type') || '';
                    if (!ct.includes('application/json')) continue;
                    const json = await res.json();
                    if (json && (json.success || Array.isArray(json.topics))) return json;
                } catch (e) { console.warn('Topic endpoint error:', ep, e); }
            }
            return { success: true, count: 0, topics: [], chapters: [] };
        }

        function escapeTopicHtml(str) {
            return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function buildChapterOptionsHTML(selectedChapter = '') {
            let html = '<option value="">Chapter (Optional)</option>';
            const chapterSet = new Set();
            (cachedStudioChapters || []).forEach(ch => { if (ch && String(ch).trim()) chapterSet.add(String(ch).trim()); });
            (cachedStudioTopics || []).forEach(t => {
                if (!t) return;
                if (typeof t.chapter === 'string' && t.chapter.trim()) chapterSet.add(t.chapter.trim());
                else if (t.chapter && typeof t.chapter.name === 'string' && t.chapter.name.trim()) chapterSet.add(t.chapter.name.trim());
            });

            const chapters = Array.from(chapterSet).sort();
            chapters.forEach(chap => {
                const isSel = selectedChapter && selectedChapter.trim().toLowerCase() === chap.toLowerCase() ? 'selected' : '';
                html += `<option value="${escapeTopicHtml(chap)}" ${isSel}>${escapeTopicHtml(chap)}</option>`;
            });
            if (selectedChapter && !chapters.some(c => c.toLowerCase() === selectedChapter.trim().toLowerCase())) {
                html += `<option value="${escapeTopicHtml(selectedChapter)}" selected>${escapeTopicHtml(selectedChapter)}</option>`;
            }
            html += '<option value="__custom__">+ Enter custom chapter...</option>';
            return html;
        }

        function buildTopicOptionsHTML(selectedTopic = '', selectedChapter = '') {
            if (!selectedChapter || selectedChapter.trim() === '') {
                return '<option value="">Select Chapter First</option>';
            }

            let html = '<option value="">Topic (Optional)</option>';
            const targetChap = selectedChapter.trim().toLowerCase();
            const filtered = (cachedStudioTopics || []).filter(t => {
                if (!t) return false;
                const chapName = typeof t.chapter === 'string' ? t.chapter.trim().toLowerCase() : (t.chapter && t.chapter.name ? t.chapter.name.trim().toLowerCase() : '');
                return chapName === targetChap;
            });

            const topicNames = new Set();
            filtered.forEach(t => {
                const name = (t.name || (typeof t === 'string' ? t : '')).trim();
                if (!name || topicNames.has(name.toLowerCase())) return;
                topicNames.add(name.toLowerCase());
                const isSel = selectedTopic && selectedTopic.trim().toLowerCase() === name.toLowerCase() ? 'selected' : '';
                html += `<option value="${escapeTopicHtml(name)}" ${isSel}>${escapeTopicHtml(name)}</option>`;
            });

            if (selectedTopic && !Array.from(topicNames).includes(selectedTopic.trim().toLowerCase())) {
                html += `<option value="${escapeTopicHtml(selectedTopic)}" selected>${escapeTopicHtml(selectedTopic)}</option>`;
            }

            html += '<option value="__custom__">+ Enter custom topic...</option>';
            return html;
        }

        function onStudioChapterChange(chapterSelect) {
            const row = chapterSelect.closest('.question-row');
            if (!row) return;
            const topicSelect = row.querySelector('.q-topic-select');
            if (!topicSelect) return;

            if (chapterSelect.value === '__custom__') {
                const customChap = prompt('Enter custom chapter name:');
                if (customChap && customChap.trim()) {
                    const trimmed = customChap.trim();
                    const opt = document.createElement('option');
                    opt.value = trimmed;
                    opt.textContent = trimmed;
                    opt.selected = true;
                    chapterSelect.insertBefore(opt, chapterSelect.lastElementChild);
                    chapterSelect.value = trimmed;
                    cachedStudioTopics.push({
                        name: trimmed,
                        chapter: { name: trimmed }
                    });
                } else {
                    chapterSelect.value = '';
                }
            }

            const selectedChapter = chapterSelect.value.trim();

            if (selectedChapter) {
                topicSelect.disabled = false;
                topicSelect.classList.remove('opacity-50', 'cursor-not-allowed');
                topicSelect.innerHTML = buildTopicOptionsHTML('', selectedChapter);
                topicSelect.value = '';
            } else {
                topicSelect.disabled = true;
                topicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                topicSelect.innerHTML = '<option value="">Select Chapter First</option>';
                topicSelect.value = '';
            }
            saveStudioDraft();
        }
        window.onStudioChapterChange = onStudioChapterChange;

        function onStudioTopicChange(topicSelect) {
            if (topicSelect.value === '__custom__') {
                const customTopic = prompt('Enter custom topic name:');
                if (customTopic && customTopic.trim()) {
                    const trimmed = customTopic.trim();
                    const opt = document.createElement('option');
                    opt.value = trimmed;
                    opt.textContent = trimmed;
                    opt.selected = true;
                    topicSelect.insertBefore(opt, topicSelect.lastElementChild);
                    topicSelect.value = trimmed;
                } else {
                    topicSelect.value = '';
                }
            }
            saveStudioDraft();
        }
        window.onStudioTopicChange = onStudioTopicChange;

        async function loadTopicsForQuestionStudio() {
            const urlParams = new URLSearchParams(window.location.search);
            // Read active form values first, fallback to URL parameters
            const subject = (document.getElementById('globalSubject')?.value || document.getElementById('hiddenSubject')?.value || urlParams.get('subject') || '').trim();
            const classLevel = (document.getElementById('globalClass')?.value || document.getElementById('hiddenClass')?.value || urlParams.get('class') || '').trim();

            if (subject || classLevel) {
                try {
                    const data = await fetchStudioTopicsSafely(subject, classLevel);
                    if (data) {
                        if (Array.isArray(data.topics)) cachedStudioTopics = data.topics;
                        if (Array.isArray(data.chapters)) cachedStudioChapters = data.chapters;
                    }
                } catch (e) {
                    console.warn('Failed to load syllabus topics:', e);
                }
            }

            document.querySelectorAll('.question-row').forEach(row => {
                const chapSelect = row.querySelector('.q-chapter-select');
                const topSelect = row.querySelector('.q-topic-select');
                const currentChap = chapSelect ? (chapSelect.value || chapSelect.getAttribute('data-prefill') || '') : '';
                const currentTop = topSelect ? (topSelect.value || topSelect.getAttribute('data-prefill') || '') : '';

                if (chapSelect) {
                    chapSelect.innerHTML = buildChapterOptionsHTML(currentChap);
                    if (currentChap) chapSelect.value = currentChap;
                }
                if (topSelect) {
                    if (currentChap) {
                        topSelect.disabled = false;
                        topSelect.classList.remove('opacity-50', 'cursor-not-allowed');
                        topSelect.innerHTML = buildTopicOptionsHTML(currentTop, currentChap);
                        if (currentTop) topSelect.value = currentTop;
                    } else {
                        topSelect.disabled = true;
                        topSelect.classList.add('opacity-50', 'cursor-not-allowed');
                        topSelect.innerHTML = '<option value="">Select Chapter First</option>';
                        topSelect.value = '';
                    }
                }
            });
        }

        window.onload = () => {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';
            
            if (urlParams.has('class')) {
                const hiddenClass = document.querySelector('input[name="classLevel"]');
                if (hiddenClass) hiddenClass.value = urlParams.get('class');
            }
            if (urlParams.has('bankId')) {
                const hiddenBank = document.querySelector('input[name="bankId"]');
                if (hiddenBank) hiddenBank.value = urlParams.get('bankId');
            }
            
            const studioMode = document.getElementById('studioMode');
            if (studioMode) studioMode.value = mode;

            if (mode === 'archive') {
                const archiveHeader = document.getElementById('archiveGlobalHeader');
                if (archiveHeader) archiveHeader.classList.remove('hidden');

                const hiddenMeta = document.getElementById('hiddenMetaFields');
                if (hiddenMeta) hiddenMeta.remove(); 
                
                const gBoard = document.getElementById('globalBoard');
                if (gBoard && urlParams.has('board')) gBoard.value = urlParams.get('board');

                const gYear = document.getElementById('globalYear');
                if (gYear && urlParams.has('year')) gYear.value = urlParams.get('year');

                if (urlParams.has('subject')) selectSystemOption('globalSubject', urlParams.get('subject'), urlParams.get('subject'));
                if (urlParams.has('class')) {
    const rawClass = urlParams.get('class');
    // If URL already includes the word "Class", strip it for the value but keep label prefixed.
    const classVal = rawClass.replace(/^Class\s+/i, '');
    const classLabel = rawClass.startsWith('Class') ? rawClass : `Class ${rawClass}`;
    selectSystemOption('globalClass', classVal, classLabel);
}

                const gAccess = document.getElementById('globalAccessType');
                if (gAccess && urlParams.has('access')) gAccess.value = urlParams.get('access');
            } else {
                const globalHeader = document.getElementById('archiveGlobalHeader');
                if (globalHeader) globalHeader.remove();
                
                const hBoard = document.getElementById('hiddenBoard');
                if (hBoard && urlParams.has('board')) hBoard.value = urlParams.get('board');

                const hYear = document.getElementById('hiddenYear');
                if (hYear && urlParams.has('year')) hYear.value = urlParams.get('year');

                const hSubject = document.getElementById('hiddenSubject');
                if (hSubject && urlParams.has('subject')) hSubject.value = urlParams.get('subject');

                const hClass = document.getElementById('hiddenClass');
                if (hClass && urlParams.has('class')) hClass.value = urlParams.get('class');

                const hAccess = document.getElementById('hiddenAccessType');
                if (hAccess && urlParams.has('access')) hAccess.value = urlParams.get('access');
            }

            if (urlParams.has('type')) {
                selectSystemOption('bulkAddType', urlParams.get('type'), urlParams.get('type'));
            }

            renderMetadataBadges(urlParams);

            if (urlParams.has('fileUrl')) {
                const fUrl = urlParams.get('fileUrl');
                const fName = urlParams.get('fileName') || 'Paper Attachment';
                const gFile = document.getElementById('globalFileUrl');
                if (gFile) gFile.value = fUrl;
                const hFile = document.getElementById('hiddenFileUrl');
                if (hFile) hFile.value = fUrl;
                const label = document.getElementById('fileNameLabel');
                if (label) {
                    label.textContent = fName;
                    label.classList.add('text-primary');
                }
            }

            // If URL explicitly requests fresh start (e.g. initial navigation from wizard modal)
            if (urlParams.get('fresh') === 'true') {
                clearStudioDraft();
                // Strip fresh=true from URL via history.replaceState so that future page reloads or errors never wipe typed data!
                urlParams.delete('fresh');
                const newQuery = urlParams.toString();
                const cleanUrl = window.location.pathname + (newQuery ? '?' + newQuery : '');
                window.history.replaceState({}, '', cleanUrl);
            }

            // Always attempt to restore saved draft first so any refresh or network reconnect never loses data
            let restored = restoreStudioDraft();

            if (!restored) {
                const slotsParam = urlParams.get('slots');
                if (slotsParam) {
                    const pairs = slotsParam.split(',');
                    let totalSlotsAdded = 0;
                    pairs.forEach(pair => {
                        const [t, cStr] = pair.split(':');
                        const c = parseInt(cStr) || 0;
                        if (c > 0 && t) {
                            addQuestionRows(c, t);
                            totalSlotsAdded += c;
                        }
                    });
                    if (totalSlotsAdded === 0) {
                        addQuestionRows(1, 'MCQ');
                    }
                } else {
                    const initialCount = parseInt(urlParams.get('count')) || 1;
                    const initialType = urlParams.get('type') || 'MCQ';
                    addQuestionRows(initialCount, initialType);
                }
                // Save initial layout immediately
                saveStudioDraft();
            }

            let isSubmittingPaper = false;
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('input', () => {
                    saveStudioDraft();
                });
                form.addEventListener('change', () => {
                    saveStudioDraft();
                });
                form.addEventListener('submit', () => {
                    document.querySelectorAll('.question-row').forEach(row => {
                        const typeHidden = row.querySelector('input[name="qType[]"]');
                        if (typeHidden && typeHidden.value === 'Comprehension') {
                            const ctx = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
                            const q1 = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
                            const textInput = row.querySelector('.standard-question-block textarea[name="qText[]"]');
                            if (textInput) {
                                textInput.value = (ctx && ctx.value.trim()) || (q1 && q1.value.trim()) || 'Comprehension Stimulus';
                            }
                        }
                    });
                    // Save latest draft state right before submission
                    saveStudioDraft();
                    isSubmittingPaper = true;
                    setTimeout(() => {
                        // Reset submitting flag if user stayed on page (e.g. form validation prevented submission)
                        isSubmittingPaper = false;
                    }, 2500);
                });
            }

            // Auto-save on page unload/blur/reload
            window.addEventListener('beforeunload', () => {
                saveStudioDraft();
            });

            // Clean draft only if submission actually succeeded and page is navigating away
            window.addEventListener('pagehide', () => {
                if (isSubmittingPaper) {
                    clearStudioDraft();
                }
            });

            // Periodic auto-save heartbeat every 10 seconds
            setInterval(saveStudioDraft, 10000);

            loadTopicsForQuestionStudio();
        };

        function changeRowType(itemEl, type) {
            const row = itemEl.closest('.question-row');
            if (row) {
                toggleTypeUI(row, type);
                closeAllSystemDropdowns();
            }
        }
        window.changeRowType = changeRowType;

        function setComprehensionRequired(row, isRequired) {
            const ctx = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
            const q1 = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
            const a1 = row.querySelector('.comprehension-area textarea[name="qSubA1[]"]');
            const q2 = row.querySelector('.comprehension-area textarea[name="qSubQ2[]"]');
            const a2 = row.querySelector('.comprehension-area textarea[name="qSubA2[]"]');
            if (ctx) ctx.required = isRequired;
            if (q1) q1.required = isRequired;
            if (a1) a1.required = isRequired;
            if (q2) q2.required = isRequired;
            if (a2) a2.required = isRequired;
        }

        function toggleTypeUI(row, type, preserveCustomMarks = false) {
            const mcq = row.querySelector('.mcq-area');
            const answer = row.querySelector('.answer-area');
            const comp = row.querySelector('.comprehension-area');
            const stdQ = row.querySelector('.standard-question-block');
            const typeLabel = row.querySelector('.q-type-label');
            const marksInput = row.querySelector('input[name="qMarks[]"]');
            const textInput = row.querySelector('.standard-question-block textarea[name="qText[]"]');
            
            if (typeLabel) typeLabel.innerText = type;
            const qTypeHidden = row.querySelector('input[name="qType[]"]');
            if (qTypeHidden) qTypeHidden.value = type;

            if (!preserveCustomMarks && marksInput) {
                marksInput.value = getDefaultMarks(type);
            }

            if (type === 'MCQ') {
                if (mcq) mcq.classList.remove('hidden');
                if (answer) answer.classList.add('hidden');
                if (comp) comp.classList.add('hidden');
                if (stdQ) stdQ.classList.remove('hidden');
                if (textInput) textInput.required = true;
                setComprehensionRequired(row, false);
            } else if (type === 'Comprehension') {
                if (mcq) mcq.classList.add('hidden');
                if (answer) answer.classList.add('hidden');
                if (comp) comp.classList.remove('hidden');
                if (stdQ) stdQ.classList.add('hidden');
                if (textInput) textInput.required = false;
                setComprehensionRequired(row, true);
            } else {
                if (mcq) mcq.classList.add('hidden');
                if (answer) answer.classList.remove('hidden');
                if (comp) comp.classList.add('hidden');
                if (stdQ) stdQ.classList.remove('hidden');
                if (textInput) textInput.required = true;
                setComprehensionRequired(row, false);
            }
            saveStudioDraft();
        }

        function addQuestionRows(count = null, type = null) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            if (!container || !template) return;

            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            const num = count || parseInt(document.getElementById('bulkAddCount').value) || 1;
            const qType = type || (document.getElementById('bulkAddType') ? document.getElementById('bulkAddType').value : 'MCQ');

            const defaultBoard = urlParams.get('board') || '';
            const defaultYear = urlParams.get('year') || '';
            const defaultTopic = urlParams.get('topic') || '';

            for (let i = 0; i < num; i++) {
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('.question-row');
                
                toggleTypeUI(row, qType);
                
                const chapSelect = row.querySelector('.q-chapter-select');
                if (chapSelect && typeof buildChapterOptionsHTML === 'function') {
                    chapSelect.innerHTML = buildChapterOptionsHTML('');
                }

                const topicInput = row.querySelector('.q-topic-select');
                if (topicInput) {
                    topicInput.disabled = true;
                    topicInput.classList.add('opacity-50', 'cursor-not-allowed');
                    topicInput.innerHTML = '<option value="">Select Chapter First</option>';
                    topicInput.value = '';
                }

                if (mode !== 'archive') {
                    const boardInput = row.querySelector('input[name="qBoard[]"]');
                    if (boardInput && defaultBoard && !boardInput.value) boardInput.value = defaultBoard;

                    const yearInput = row.querySelector('input[name="qYear[]"]');
                    if (yearInput && defaultYear && !yearInput.value) yearInput.value = defaultYear;
                }

                if (mode === 'archive') {
                    const indMeta = row.querySelector('.individual-meta');
                    if (indMeta) indMeta.classList.add('hidden');
                }

                container.appendChild(clone);
            }
            updateIndices();
            saveStudioDraft();
        }

        function removeRow(btn) {
            const row = btn.closest('.question-row');
            if (row) {
                row.remove();
                updateIndices();
                saveStudioDraft();
            }
        }

        function updateIndices() {
            const rows = document.querySelectorAll('.question-row');
            rows.forEach((row, i) => {
                const indexSpan = row.querySelector('.q-index');
                if (indexSpan) indexSpan.innerText = i + 1;
            });

            const countBadge = document.getElementById('questionCountBadge');
            if (countBadge) {
                countBadge.innerText = `${rows.length} ${rows.length === 1 ? 'question' : 'questions'}`;
            }
        }
    </script>
</body>
</html>
