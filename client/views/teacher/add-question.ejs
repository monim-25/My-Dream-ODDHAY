                        <div class="flex items-center gap-2 mt-4">
                            <button type="button" onclick="loadBulkDemo('bn')" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-primary shadow-2xs hover:bg-primary/5 transition-all cursor-pointer">
                                + বাংলা ডেমো লোড করুন
                            </button>
                        </div>
                    </div>
                `;
                return;
            }

            const bnLetters = ['ক', 'খ', 'গ', 'ঘ'];
            const enLetters = ['A', 'B', 'C', 'D'];

            let html = '';
            _parsedBulkQuestions.forEach((q, qIdx) => {
                const optLetters = q.isBangla ? bnLetters : enLetters;
                const cardBorder = q.isValid ? 'border-slate-200/90 dark:border-slate-800' : 'border-amber-400/80 dark:border-amber-500/50 bg-amber-50/10';

                html += `
                    <div class="bulk-q-card bg-white dark:bg-[#0f172a] rounded-xl p-3.5 border ${cardBorder} shadow-2xs space-y-3 transition-all" data-qidx="${qIdx}">
