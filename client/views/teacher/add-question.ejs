                }

                const expText = row.querySelector('.mcq-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';

                if (qData.mcqSubtype) {
                    const targetBtn = qData.mcqSubtype === 'multiple_completion'
                        ? row.querySelector('.subtype-btn-multiple')
                        : (qData.mcqSubtype === 'contextual' ? row.querySelector('.subtype-btn-contextual') : row.querySelector('.subtype-btn-standard'));
                    if (targetBtn) setRowMcqSubtype(targetBtn, qData.mcqSubtype);

                    if (qData.mcqSubtype === 'multiple_completion') {
                        const s1 = row.querySelector('input[name="qStatement1[]"]');
                        const s2 = row.querySelector('input[name="qStatement2[]"]');
                        const s3 = row.querySelector('input[name="qStatement3[]"]');
                        if (s1 && qData.statement1) s1.value = qData.statement1;
                        if (s2 && qData.statement2) s2.value = qData.statement2;
