<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Compose Matrix | ODDHAY Command Center</title>
        <!-- KaTeX for High-Performance Math Equation Rendering -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
        <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>
        <style>
            * {
                font-family: 'Inter', 'Noto Sans Bengali', 'Hind Siliguri', sans-serif;
            }

            .katex-display {
                overflow-x: auto;
                overflow-y: hidden;
                padding: 4px 0;
                margin: 4px 0;
            }

            .math-sym-btn {
                height: 26px;
                min-width: 26px;
                padding: 0 6px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.8);
                border: 1px solid rgba(139, 92, 246, 0.25);
                color: #6d28d9;
                cursor: pointer;
                transition: all 0.15s ease;
                user-select: none;
            }

            .dark .math-sym-btn {
                background: rgba(30, 41, 59, 0.8);
                border-color: rgba(139, 92, 246, 0.35);
                color: #c4b5fd;
            }

            .math-sym-btn:hover {
                background: rgba(139, 92, 246, 0.15);
                border-color: rgba(139, 92, 246, 0.5);
                transform: translateY(-1px);
            }

            .math-sym-btn:active {
                transform: scale(0.95);
            }

            .material-symbols-rounded {
                font-family: 'Material Symbols Rounded' !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
            }

            :root {
                --admin-sidebar-width: 260px;
            }

            html,
            body {
                height: 100%;
                height: 100dvh;
                overflow: hidden;
                margin: 0;
                padding: 0;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100%;
                height: 100dvh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                width: calc(100% - var(--admin-sidebar-width));
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                -webkit-overflow-scrolling: touch;
                touch-action: pan-y;
                position: relative;
            }

            @media (max-width: 1024px) {

                .admin-sidebar,
                #adminSidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0 !important;
                    width: 100% !important;
                }
            }

            .admin-sidebar.active,
            #adminSidebar.active,
            .admin-sidebar.translate-x-0,
            #adminSidebar.translate-x-0 {
                transform: translateX(0) !important;
            }

            .q-row,
            .question-row {
                transition: all 0.25s ease;
            }

            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            .q-chapter-select,
            .q-topic-select,
            .q-subtopic-select {
                appearance: none !important;
                -webkit-appearance: none !important;
                -moz-appearance: none !important;
                background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
                background-repeat: no-repeat !important;
                background-position: right 0.5rem center !important;
                background-size: 14px 14px !important;
                padding-right: 1.75rem !important;
                padding-left: 0.625rem !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                height: 32px !important;
                line-height: 30px !important;
                font-size: 11.5px !important;
                font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                vertical-align: middle !important;
                box-sizing: border-box !important;
            }
        </style>
</head>

<body
    class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased overflow-hidden h-full h-[100dvh] flex flex-col">
    <div class="flex h-full h-[100dvh] w-full min-h-0 overflow-hidden flex-1">
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: locals.active || 'question-details' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)"
            class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300">
        </div>

        <main class="admin-main flex-1 flex flex-col h-full h-[100dvh] min-h-0 overflow-hidden">
            <%- include('header', { pageTitle: 'Questions' , user: user }) %>

                <div
                    class="content-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden p-3 sm:p-6 lg:p-8 bg-[#FFFFFF] dark:bg-[#020617]">
                    <div class="max-w-4xl mx-auto pb-6">
                        <form action="/teacher/add-question-full" method="POST" enctype="multipart/form-data"
                            class="space-y-4 sm:space-y-5">

                            <!-- Global Metadata Header (Visible in Archive Mode) -->
                            <div id="archiveGlobalHeader" class="hidden animate-slide-up mb-5">
                                <div
                                    class="bg-white dark:bg-[#0f172a] rounded-xl p-3.5 sm:p-5 border border-slate-200 dark:border-white/5 shadow-xs">
                                    <div class="flex items-center justify-between gap-2 cursor-pointer sm:cursor-default select-none"
                                        onclick="togglePaperDetailsMobile()">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div
                                                class="size-8 rounded-lg bg-primary/10 flex items-center justify-center border border-primary/20 shrink-0">
                                                <span
                                                    class="material-symbols-rounded text-primary text-[17px]">archive</span>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-2">
                                                    <h4
                                                        class="text-[13px] font-semibold text-slate-900 dark:text-white">
                                                        Paper details</h4>
                                                    <span id="paperDetailsSummaryBadge"
                                                        class="hidden sm:hidden text-[11px] font-medium text-primary bg-primary/10 border border-primary/20 px-2 py-0.5 rounded-full truncate max-w-[170px]"></span>
                                                </div>
                                                <p class="text-[10.5px] text-slate-400 sm:hidden">ট্যাপ করে বিবরণ দেখুন
                                                    বা পরিবর্তন করুন</p>
                                            </div>
                                        </div>
                                        <button type="button"
                                            class="sm:hidden size-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 flex items-center justify-center shrink-0"
                                            aria-label="Toggle paper details">
                                            <span id="paperDetailsToggleIcon"
                                                class="material-symbols-rounded text-base transition-transform duration-200">expand_more</span>
                                        </button>
                                    </div>

                                    <!-- Collapsible Container on Mobile, Always Visible on sm+ -->
                                    <div id="paperDetailsBody"
                                        class="hidden sm:block pt-3 sm:pt-0 mt-2 sm:mt-3.5 border-t border-slate-100 dark:border-white/5 sm:border-0">
                                        <div
                                            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
                                            <!-- Board -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Board
                                                    <span class="text-rose-500">*</span></label>
                                                <% const activeBoardList=(typeof boards !=='undefined' &&
                                                    Array.isArray(boards) && boards.length> 0)
                                                    ? boards
                                                    : ['Dhaka Board', 'Rajshahi Board', 'Comilla Board', 'Jessore Board', 'Chittagong Board', 'Barisal Board', 'Sylhet Board', 'Dinajpur Board', 'Mymensingh Board', 'Madrasah Board', 'Technical Board', 'All Board'];
                                                    const initialBoard = activeBoardList[0] || 'Dhaka Board';
                                                    %>
                                                    <input type="hidden" name="board" id="globalBoard"
                                                        value="<%= initialBoard %>" required>
                                                    <div class="relative system-dropdown" id="dropdown-globalBoard">
                                                        <button type="button"
                                                            onclick="toggleSystemDropdown('globalBoard', event)"
                                                            class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                            <span id="globalBoard-label"
                                                                class="truncate text-[11px] font-normal">
                                                                <%= initialBoard %>
                                                            </span>
                                                            <span
                                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                        </button>
                                                        <div id="dropdown-menu-globalBoard"
                                                            class="hidden absolute top-full left-0 right-0 mt-1 w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                            <% activeBoardList.forEach((b, bIdx)=> { %>
                                                                <div onclick="selectSystemOption('globalBoard', '<%= b %>', '<%= b %>')"
                                                                    data-val="<%= b %>"
                                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors <%= bIdx === 0 ? 'font-medium text-primary bg-primary/10' : 'font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                                    <span class="truncate">
                                                                        <%= b %>
                                                                    </span>
                                                                    <% if (bIdx===0) { %><span
                                                                            class="material-symbols-rounded text-sm text-primary check-icon">check</span>
                                                                        <% } %>
                                                                </div>
                                                                <% }) %>
                                                        </div>
                                                    </div>
                                            </div>
                                            <!-- Year -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Year
                                                    <span class="text-rose-500">*</span></label>
                                                <% const activeYearList=(typeof years !=='undefined' &&
                                                    Array.isArray(years) && years.length> 0)
                                                    ? years
                                                    : ['2026', '2025', '2024', '2023', '2022', '2021', '2020', '2019',
                                                    '2018', '2017', '2016', '2015'];
                                                    const initialYear = activeYearList[0] || '2026';
                                                    %>
                                                    <input type="hidden" name="year" id="globalYear"
                                                        value="<%= initialYear %>" required>
                                                    <div class="relative system-dropdown" id="dropdown-globalYear">
                                                        <button type="button"
                                                            onclick="toggleSystemDropdown('globalYear', event)"
                                                            class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                            <span id="globalYear-label"
                                                                class="truncate text-[11px] font-normal">
                                                                <%= initialYear %>
                                                            </span>
                                                            <span
                                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                        </button>
                                                        <div id="dropdown-menu-globalYear"
                                                            class="hidden absolute top-full left-0 right-0 mt-1 w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                            <% activeYearList.forEach((y, yIdx)=> { %>
                                                                <div onclick="selectSystemOption('globalYear', '<%= y %>', '<%= y %>')"
                                                                    data-val="<%= y %>"
                                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors <%= yIdx === 0 ? 'font-medium text-primary bg-primary/10' : 'font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                                    <span class="truncate font-mono">
                                                                        <%= y %>
                                                                    </span>
                                                                    <% if (yIdx===0) { %><span
                                                                            class="material-symbols-rounded text-sm text-primary check-icon">check</span>
                                                                        <% } %>
                                                                </div>
                                                                <% }) %>
                                                        </div>
                                                    </div>
                                            </div>
                                            <!-- Exam Duration (Mins) -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Time
                                                    (mins)</label>
                                                <input type="number" name="duration" id="globalDuration" value="30"
                                                    min="1" max="600"
                                                    class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all">
                                            </div>
                                            <!-- Subject – Multi-Select -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Subject
                                                    <span class="text-rose-500">*</span></label>
                                                <% const defaultSubjects=['Physics', 'Chemistry' , 'Higher Math'
                                                    , 'Biology' , 'General Science' , 'ICT' , 'Bangla' , 'English'
                                                    , 'Accounting' , 'Finance' , 'Economics' , 'Business Studies' ];
                                                    const subjectList=(assignedSubjects && assignedSubjects.length> 0) ?
                                                    assignedSubjects : ((typeof subjects !== 'undefined' && subjects &&
                                                    subjects.length > 0) ? subjects : defaultSubjects);
                                                    const defaultInitialSub = subjectList[0] || '';
                                                    %>
                                                    <input type="hidden" name="subject" id="globalSubject"
                                                        value="<%= defaultInitialSub %>" required>
                                                    <div class="relative system-dropdown" id="dropdown-globalSubject">
                                                        <button type="button"
                                                            onclick="toggleSystemDropdown('globalSubject', event)"
                                                            class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                            <span id="globalSubject-label" class="truncate font-medium">
                                                                <%= defaultInitialSub || 'Select Subject' %>
                                                            </span>
                                                            <span
                                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                        </button>
                                                        <div id="dropdown-menu-globalSubject"
                                                            class="hidden absolute top-full left-0 right-0 mt-1 min-w-[190px] w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                            <% if (subjectList.length===0) { %>
                                                                <div class="px-3 py-2 text-xs text-slate-400 italic">No
                                                                    assigned subjects</div>
                                                                <% } else { %>
                                                                    <% subjectList.forEach((s, idx)=> { %>
                                                                        <div onclick="selectGlobalSubjectDirect('<%= s %>')"
                                                                            data-val="<%= s %>"
                                                                            class="global-sub-item px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors <%= idx === 0 ? 'font-medium text-primary bg-primary/10' : 'font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                                            <span class="truncate font-medium">
                                                                                <%= s %>
                                                                            </span>
                                                                            <% if (idx===0) { %>
                                                                                <span
                                                                                    class="material-symbols-rounded text-sm text-primary sub-check-icon">check</span>
                                                                                <% } %>
                                                                        </div>
                                                                        <% }) %>
                                                                            <% } %>
                                                        </div>
                                                    </div>
                                            </div>
                                            <!-- Class – Multi-Select -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Classes
                                                    <span class="text-rose-500">*</span></label>
                                                <% const defaultClasses=['Class 6', 'Class 7' , 'Class 8' , 'Class 9'
                                                    , 'Class 10' , 'Class 11' , 'Class 12' ]; const
                                                    classList=(assignedClasses && assignedClasses.length> 0) ?
                                                    assignedClasses : ((typeof classes !== 'undefined' && classes &&
                                                    classes.length > 0) ? classes : defaultClasses);
                                                    const initialRawClass = classList[0] ? String(classList[0]) : '';
                                                    const initialClassVal = initialRawClass.replace(/^Class\s+/i, '');
                                                    const initialClassLabel = initialRawClass ?
                                                    (initialRawClass.startsWith('Class') ? initialRawClass : 'Class ' +
                                                    initialRawClass) : 'Select Class';
                                                    %>
                                                    <input type="hidden" name="classLevel" id="globalClass"
                                                        value="<%= initialClassVal %>" required>
                                                    <div class="relative system-dropdown" id="dropdown-globalClass">
                                                        <button type="button"
                                                            onclick="toggleSystemDropdown('globalClass', event)"
                                                            class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                            <span id="globalClass-label" class="truncate font-medium">
                                                                <%= initialClassLabel %>
                                                            </span>
                                                            <span
                                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                        </button>
                                                        <div id="dropdown-menu-globalClass"
                                                            class="hidden absolute top-full left-0 right-0 mt-1 min-w-[180px] w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                            <% if (classList.length===0) { %>
                                                                <div class="px-3 py-2 text-xs text-slate-400 italic">No
                                                                    assigned classes</div>
                                                                <% } else { %>
                                                                    <% classList.forEach((c, idx)=> {
                                                                        const cRaw = String(c);
                                                                        const cVal = cRaw.replace(/^Class\s+/i, '');
                                                                        const cLbl = cRaw.startsWith('Class') ? cRaw :
                                                                        'Class ' + cRaw;
                                                                        %>
                                                                        <div onclick="selectGlobalClassDirect('<%= cVal %>', '<%= cLbl %>')"
                                                                            class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors select-none">
                                                                            <label
                                                                                class="flex items-center gap-2 cursor-pointer flex-1"
                                                                                onclick="event.stopPropagation()">
                                                                                <input type="checkbox"
                                                                                    name="classLevel[]"
                                                                                    value="<%= cVal %>" <%=idx===0
                                                                                    ? 'checked' : '' %>
                                                                                class="accent-primary rounded size-3.5
                                                                                global-class-cb"
                                                                                onchange="syncGlobalClasses()">
                                                                                <span class="truncate font-medium">
                                                                                    <%= cLbl %>
                                                                                </span>
                                                                            </label>
                                                                        </div>
                                                                        <% }) %>
                                                                            <% } %>
                                                        </div>
                                                    </div>
                                            </div>
                                            <!-- Source PDF -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">File</label>
                                                <label
                                                    class="flex items-center gap-1.5 h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-700 cursor-pointer hover:border-primary/60 transition-all overflow-hidden">
                                                    <span
                                                        class="material-symbols-rounded text-slate-400 text-[15px] shrink-0">attach_file</span>
                                                    <span id="fileNameLabel"
                                                        class="text-xs font-normal text-slate-500 dark:text-slate-400 truncate flex-1">Attach</span>
                                                    <input type="file" name="file" class="hidden"
                                                        onchange="document.getElementById('fileNameLabel').textContent = this.files[0]?.name || 'Attach'; document.getElementById('fileNameLabel').classList.add('text-primary');">
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Global Syllabus Scope: Chapter, Topic, Sub-topic (Archive Mode) -->
                                        <div
                                            class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3 pt-3 border-t border-slate-100 dark:border-white/5">
                                            <!-- Chapter -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Chapter
                                                    <span
                                                        class="text-slate-400 font-normal text-[10px]">(Optional)</span></label>
                                                <select name="chapter" id="globalChapter"
                                                    class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all cursor-pointer"
                                                    onchange="onGlobalChapterSelect(this.value)">
                                                    <option value="">Chapter (Optional)</option>
                                                </select>
                                            </div>
                                            <!-- Topic -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Topic
                                                    <span
                                                        class="text-slate-400 font-normal text-[10px]">(Optional)</span></label>
                                                <select name="topic" id="globalTopic" disabled
                                                    class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all cursor-pointer opacity-50 cursor-not-allowed"
                                                    onchange="onGlobalTopicSelect(this.value)">
                                                    <option value="">Select Chapter First</option>
                                                </select>
                                            </div>
                                            <!-- Sub-topic -->
                                            <div class="space-y-1">
                                                <label
                                                    class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Sub-topic
                                                    <span
                                                        class="text-slate-400 font-normal text-[10px]">(Optional)</span></label>
                                                <select name="subTopic" id="globalSubTopic" disabled
                                                    class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all cursor-pointer opacity-50 cursor-not-allowed"
                                                    onchange="onGlobalSubTopicSelect(this.value)">
                                                    <option value="">Select Topic First</option>
                                                </select>
                                            </div>
                                        </div>

                                        <input type="hidden" name="accessType" id="globalAccessType" value="Free">
                                        <input type="hidden" name="fileUrl" id="globalFileUrl" value="">

                                        <!-- No courses assigned warning -->
                                        <% if (!assignedSubjects || assignedSubjects.length===0) { %>
