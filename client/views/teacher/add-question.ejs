    <script>
        function getDefaultMarks(type) {
            if (type === 'Medium') return 2;
            if (type === 'Comprehension') return 10;
            return 1;
        }

        const DRAFT_KEY_BASE = 'oddhay_question_studio_draft';

        function getDraftStorageKey() {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';
            const bankId = urlParams.get('bankId') || urlParams.get('paperId') || '';
            const board = (urlParams.get('board') || document.getElementById('globalBoard')?.value || document.getElementById('hiddenBoard')?.value || '').trim();
            const year = (urlParams.get('year') || document.getElementById('globalYear')?.value || document.getElementById('hiddenYear')?.value || '').trim();
            const subject = (urlParams.get('subject') || document.getElementById('globalSubject')?.value || document.getElementById('hiddenSubject')?.value || '').trim();
            let rawClass = (urlParams.get('class') || document.getElementById('globalClass')?.value || document.getElementById('hiddenClass')?.value || '').trim();
            const classLevel = rawClass.split(',').map(c => c.trim().toLowerCase().replace(/^class\s+/i, '')).filter(Boolean).sort().join('_');

            if (bankId) {
                return `${DRAFT_KEY_BASE}_${bankId}`;
            }
            return `${DRAFT_KEY_BASE}_${mode}_${subject}_${classLevel}_${board}_${year}`.toLowerCase().replace(/\s+/g, '_');
        }

        // --- Custom In-System Dropdown Controls ---
        function toggleSystemDropdown(type, e) {
            if (e) e.stopPropagation();
            const targetMenu = document.getElementById(`dropdown-menu-${type}`);
            const parent = document.getElementById(`dropdown-${type}`);
            if (!targetMenu) return;
            const isCurrentlyHidden = targetMenu.classList.contains('hidden');

            closeAllSystemDropdowns();

            if (isCurrentlyHidden) {
                targetMenu.classList.remove('hidden');
                if (parent) {
                    const arrow = parent.querySelector('.dropdown-arrow');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }
        window.toggleSystemDropdown = toggleSystemDropdown;

        function closeAllSystemDropdowns() {
            document.querySelectorAll('.system-dropdown').forEach(d => {
                const menu = d.querySelector('[id^="dropdown-menu-"], .row-dropdown-menu');
                const arrow = d.querySelector('.dropdown-arrow');
                if (menu) menu.classList.add('hidden');
                if (arrow) arrow.style.removeProperty('transform');
            });
        }
        window.closeAllSystemDropdowns = closeAllSystemDropdowns;

        function selectSystemOption(fieldId, value, label) {
            if (fieldId === 'globalSubject') {
                selectGlobalSubjectDirect(value);
                return;
            }

            const input = document.getElementById(fieldId);
            const labelEl = document.getElementById(`${fieldId}-label`);
            if (input) input.value = value;
            if (labelEl) labelEl.innerText = label;

            if (fieldId === 'globalClass') {
                const targetVal = String(value).trim().toLowerCase().replace(/^class\s+/i, '');
                document.querySelectorAll('.global-class-cb').forEach(cb => {
                    const cbVal = cb.value.trim().toLowerCase().replace(/^class\s+/i, '');
                    cb.checked = (cbVal === targetVal);
                });
            }

            const menu = document.getElementById(`dropdown-menu-${fieldId}`);
            if (menu) {
                menu.querySelectorAll('[data-val]').forEach(opt => {
                    const isSelected = opt.getAttribute('data-val') === String(value);
                    if (isSelected) {
                        opt.className = 'px-2.5 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        if (!opt.querySelector('.check-icon')) {
                            const check = document.createElement('span');
                            check.className = 'material-symbols-rounded text-sm text-primary check-icon';
                            check.innerText = 'check';
                            opt.appendChild(check);
                        }
                    } else {
                        opt.className = 'px-2.5 py-1.5 text-xs font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        const c = opt.querySelector('.check-icon');
                        if (c) c.remove();
                    }
                });
            }

            if (typeof renderMetadataBadges === 'function') {
                renderMetadataBadges();
            }
            if (typeof updatePaperDetailsSummaryBadge === 'function') {
                updatePaperDetailsSummaryBadge();
            }

            if (fieldId === 'globalClass') {
                if (typeof loadTopicsForQuestionStudio === 'function') {
                    loadTopicsForQuestionStudio();
                }
            }
            closeAllSystemDropdowns();
            saveStudioDraft();
        }
        window.selectSystemOption = selectSystemOption;

        function syncGlobalSubjects() {
            const hidden = document.getElementById('globalSubject');
            const label = document.getElementById('globalSubject-label');
            if (hidden && label) {
                label.innerText = hidden.value || 'Select Subject';
            }
            if (typeof renderMetadataBadges === 'function') renderMetadataBadges();
            if (typeof loadTopicsForQuestionStudio === 'function') {
                loadTopicsForQuestionStudio();
            }
            saveStudioDraft();
        }
        window.syncGlobalSubjects = syncGlobalSubjects;

        function syncGlobalClasses() {
            const checked = Array.from(document.querySelectorAll('.global-class-cb:checked')).map(cb => cb.value);
            const label = document.getElementById('globalClass-label');
            const hidden = document.getElementById('globalClass');
            if (checked.length === 0) {
                const firstCb = document.querySelector('.global-class-cb');
                if (firstCb) { firstCb.checked = true; checked.push(firstCb.value); }
            }
            if (hidden) hidden.value = checked.join(',');
            if (label) {
                const displayNames = checked.map(c => String(c).startsWith('Class') ? c : 'Class ' + c);
                if (displayNames.length === 1) label.innerText = displayNames[0];
                else label.innerText = `${displayNames[0]} (+${displayNames.length - 1})`;
            }
            if (typeof renderMetadataBadges === 'function') renderMetadataBadges();
            if (typeof loadTopicsForQuestionStudio === 'function') {
                loadTopicsForQuestionStudio();
            }
            saveStudioDraft();
        }
        window.syncGlobalClasses = syncGlobalClasses;

        function selectGlobalClassDirect(cVal, cLbl) {
            document.querySelectorAll('.global-class-cb').forEach(cb => {
                const v = cb.value.trim().toLowerCase().replace(/^class\s+/i, '');
                const targetV = String(cVal).trim().toLowerCase().replace(/^class\s+/i, '');
                cb.checked = (v === targetV);
            });
            syncGlobalClasses();
            closeAllSystemDropdowns();
        }
        window.selectGlobalClassDirect = selectGlobalClassDirect;

        function selectGlobalSubjectDirect(sName) {
            const input = document.getElementById('globalSubject');
            const label = document.getElementById('globalSubject-label');
            if (input) input.value = sName;
            if (label) label.innerText = sName || 'Select Subject';

            const menu = document.getElementById(`dropdown-menu-globalSubject`);
            if (menu) {
                menu.querySelectorAll('.global-sub-item').forEach(el => {
                    const val = el.getAttribute('data-val');
                    const isSel = (val && String(val).toLowerCase() === String(sName).toLowerCase());
                    if (isSel) {
                        el.className = 'global-sub-item px-2.5 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        if (!el.querySelector('.sub-check-icon')) {
                            const chk = document.createElement('span');
                            chk.className = 'material-symbols-rounded text-sm text-primary sub-check-icon';
                            chk.innerText = 'check';
                            el.appendChild(chk);
                        }
                    } else {
                        el.className = 'global-sub-item px-2.5 py-1.5 text-xs font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        const chk = el.querySelector('.sub-check-icon');
                        if (chk) chk.remove();
                    }
                });
            }

            if (typeof renderMetadataBadges === 'function') renderMetadataBadges();
            if (typeof loadTopicsForQuestionStudio === 'function') {
                loadTopicsForQuestionStudio();
            }
            if (typeof updateMathTierUI === 'function') {
                updateMathTierUI(sName);
            }
            closeAllSystemDropdowns();
            saveStudioDraft();
            updatePaperDetailsSummaryBadge();
        }
        window.selectGlobalSubjectDirect = selectGlobalSubjectDirect;

        // ==========================================
        // 3-TIER MATHEMATICAL EQUATION (fx) SYSTEM
        // ==========================================
        const MATH_TIER_KEYWORDS = {
            TIER_1: [
                'math', 'mathematics', 'higher math', 'physics', 'chemistry',
                'finance', 'banking', 'accounting', 'economics', 'statistics', 'geography', 'science',
                'গণিত', 'উচ্চতর গণিত', 'পদার্থ', 'রসায়ন', 'রসায়ন', 'ফিন্যান্স', 'হিসাববিজ্ঞান',
                'অর্থনীতি', 'পরিসংখ্যান', 'ভূগোল', 'বিজ্ঞান'
            ],
            TIER_2: [
                'ict', 'information technology', 'general science', 'business', 'agriculture', 'agricultural',
                'তথ্য ও যোগাযোগ প্রযুক্তি', 'কৃষি শিক্ষা', 'ব্যবসায় উদ্যোগ', 'গার্হস্থ্য বিজ্ঞান'
            ]
        };

        let _currentMathTier = 3;
        let _isTier2MathActive = false;
        window._lastFocusedStudioInput = null;

        function detectSubjectMathTier(subjectName) {
            if (!subjectName) return 3;
            const s = String(subjectName).trim().toLowerCase();
            if (MATH_TIER_KEYWORDS.TIER_1.some(k => s.includes(k.toLowerCase()))) return 1;
            if (MATH_TIER_KEYWORDS.TIER_2.some(k => s.includes(k.toLowerCase()))) return 2;
            return 3;
        }
        window.detectSubjectMathTier = detectSubjectMathTier;

        function updateMathTierUI(subjectName) {
            const tier = detectSubjectMathTier(subjectName);
            _currentMathTier = tier;

            const tier2Wrap = document.getElementById('tier2MathToggleWrap');
            const globalMathBtnWrap = document.getElementById('globalMathToolbarWrap');
            const globalTray = document.getElementById('globalMathTray');
            const bulkMathToggleWrap = document.getElementById('bulkMathPreviewToggleWrap');
            const rowFxButtons = document.querySelectorAll('.btn-row-fx-tool');

            if (tier === 1) {
                // TIER 1: Core Math/Science -> Always available
                if (tier2Wrap) tier2Wrap.classList.add('hidden');
                if (globalMathBtnWrap) globalMathBtnWrap.classList.remove('hidden');
                if (bulkMathToggleWrap) bulkMathToggleWrap.classList.remove('hidden');
                rowFxButtons.forEach(btn => btn.classList.remove('hidden'));
            } else if (tier === 2) {
                // TIER 2: Semi-Math -> Subtle toggle
                if (tier2Wrap) tier2Wrap.classList.remove('hidden');
                if (_isTier2MathActive) {
                    if (globalMathBtnWrap) globalMathBtnWrap.classList.remove('hidden');
                    if (bulkMathToggleWrap) bulkMathToggleWrap.classList.remove('hidden');
                    rowFxButtons.forEach(btn => btn.classList.remove('hidden'));
                } else {
                    if (globalMathBtnWrap) globalMathBtnWrap.classList.add('hidden');
                    if (globalTray) globalTray.classList.add('hidden');
                    if (bulkMathToggleWrap) bulkMathToggleWrap.classList.add('hidden');
                    rowFxButtons.forEach(btn => btn.classList.add('hidden'));
                }
            } else {
                // TIER 3: Pure Humanities & Languages -> 100% hidden & clean
                if (tier2Wrap) tier2Wrap.classList.add('hidden');
                if (globalMathBtnWrap) globalMathBtnWrap.classList.add('hidden');
                if (globalTray) globalTray.classList.add('hidden');
                if (bulkMathToggleWrap) bulkMathToggleWrap.classList.add('hidden');
                rowFxButtons.forEach(btn => btn.classList.add('hidden'));
            }
        }
        window.updateMathTierUI = updateMathTierUI;

        function onTier2MathToggle(checked) {
            _isTier2MathActive = Boolean(checked);
            const globalSub = document.getElementById('globalSubject')?.value || '';
            updateMathTierUI(globalSub);
            if (_isTier2MathActive) {
                toggleGlobalMathToolbar(true);
            }
        }
        window.onTier2MathToggle = onTier2MathToggle;

        function toggleGlobalMathToolbar(forceState = null) {
            const tray = document.getElementById('globalMathTray');
            if (!tray) return;
            const isOpen = !tray.classList.contains('hidden');
            const shouldOpen = (forceState !== null) ? forceState : !isOpen;
            if (shouldOpen) {
                tray.classList.remove('hidden');
            } else {
                tray.classList.add('hidden');
            }
        }
        window.toggleGlobalMathToolbar = toggleGlobalMathToolbar;

        function onBulkMathToggle() {
            if (typeof renderBulkPreviewCards === 'function') {
                renderBulkPreviewCards();
            }
        }
        window.onBulkMathToggle = onBulkMathToggle;

        function insertMathCode(code, mode) {
            let target = window._lastFocusedStudioInput;
            if (!target || !document.body.contains(target)) {
                target = document.querySelector('textarea[name="qText[]"]');
                if (target) window._lastFocusedStudioInput = target;
            }
            if (!target) return;

            const start = target.selectionStart || 0;
            const end = target.selectionEnd || 0;
            const val = target.value || '';
            const selectedText = val.substring(start, end);

            let insertion = code;
            const beforeCursor = val.substring(0, start);
            const afterCursor = val.substring(end);
            const dollarMatches = beforeCursor.match(/\$/g);
            const isInsideDollar = dollarMatches ? (dollarMatches.length % 2 === 1) : false;

            if (mode === 'dollar') {
                insertion = selectedText ? `$${selectedText}$` : `$$`;
            } else if (mode === 'power' || mode === 'sub') {
                if (isInsideDollar) {
                    insertion = code;
                } else {
                    insertion = selectedText ? `$${selectedText}${code}$` : `$x${code}$`;
                }
            } else if (mode === 'wrap') {
                if (isInsideDollar) {
                    insertion = code;
                } else {
                    insertion = `$${code}$`;
                }
            } else { // symbol
                if (isInsideDollar) {
                    insertion = ` ${code} `;
                } else {
                    insertion = `$${code}$`;
                }
            }

            target.value = beforeCursor + insertion + afterCursor;
            const newPos = (mode === 'dollar' && !selectedText) ? (start + 1) : (start + insertion.length);
            target.focus();
            try {
                target.setSelectionRange(newPos, newPos);
            } catch (e) {}

            target.dispatchEvent(new Event('input', { bubbles: true }));
        }
        window.insertMathCode = insertMathCode;

        // Track last focused input inside question studio (Question, Options, Explanation, Short/Medium/Comprehension)
        document.addEventListener('focusin', (e) => {
            const t = e.target;
            if (t && (
                t.matches('textarea[name="qText[]"]') ||
                t.matches('input[name="qOptions[]"]') ||
                t.matches('textarea[name="qExplanation[]"]') ||
                t.matches('textarea[name="qContext[]"]') ||
                t.matches('textarea[name="qAnswer[]"]') ||
                t.matches('textarea[name="qSampleAnswer[]"]') ||
                t.matches('textarea[name^="qSubQ"]') ||
                t.matches('textarea[name^="qSubA"]') ||
                t.matches('textarea[name^="qSubS"]')
            )) {
                window._lastFocusedStudioInput = t;
            }
        });

        // Universal Real-time live math equation preview on input for ANY field
        function updateLiveMathPreviewForInput(inputEl) {
            if (!inputEl) return;
            const textVal = (inputEl.value || '').trim();
            const parent = inputEl.parentElement;
            if (!parent) return;

            let previewEl = parent.querySelector('.live-math-preview');
            const hasMath = textVal.includes('$');

            if (!hasMath) {
                if (previewEl) previewEl.classList.add('hidden');
                return;
            }

            if (!previewEl) {
                previewEl = document.createElement('div');
                previewEl.className = 'live-math-preview mt-1 p-2 rounded-lg bg-violet-50/70 dark:bg-violet-950/30 border border-violet-200/80 dark:border-violet-800/50 text-xs text-slate-800 dark:text-slate-200 leading-relaxed overflow-x-auto';
                inputEl.insertAdjacentElement('afterend', previewEl);
            }

            const escText = (typeof escapeBulkHtml === 'function') ? escapeBulkHtml(textVal) : textVal;
            previewEl.innerHTML = `<span class="text-[10px] font-semibold text-violet-600 dark:text-violet-400 block mb-0.5">📐 লাইভ সমীকরণ প্রিভিউ:</span><div>${escText}</div>`;
            previewEl.classList.remove('hidden');

            if (typeof renderMathInElement === 'function') {
                renderMathInElement(previewEl, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false }
                    ],
                    throwOnError: false
                });
            }
        }
        window.updateLiveMathPreviewForInput = updateLiveMathPreviewForInput;

        document.addEventListener('input', (e) => {
            const t = e.target;
            if (!t) return;
            if (
                t.matches('textarea[name="qText[]"]') ||
                t.matches('input[name="qOptions[]"]') ||
                t.matches('textarea[name="qExplanation[]"]') ||
                t.matches('textarea[name="qContext[]"]') ||
                t.matches('textarea[name="qAnswer[]"]') ||
                t.matches('textarea[name="qSampleAnswer[]"]') ||
                t.matches('textarea[name^="qSubQ"]') ||
                t.matches('textarea[name^="qSubA"]') ||
                t.matches('textarea[name^="qSubS"]')
            ) {
                updateLiveMathPreviewForInput(t);
            }
        });

        function togglePaperDetailsMobile(forceOpen = null) {
            const body = document.getElementById('paperDetailsBody');
            const icon = document.getElementById('paperDetailsToggleIcon');
            if (!body) return;

            const shouldOpen = (forceOpen !== null) ? forceOpen : body.classList.contains('hidden');
            if (shouldOpen) {
                body.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                body.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        }
        window.togglePaperDetailsMobile = togglePaperDetailsMobile;

        function updatePaperDetailsSummaryBadge() {
            const badge = document.getElementById('paperDetailsSummaryBadge');
            if (!badge) return;
            const board = (document.getElementById('globalBoard')?.value || '').trim();
            const year = (document.getElementById('globalYear')?.value || '').trim();
            const sub = (document.getElementById('globalSubject')?.value || '').trim();
            const parts = [board, year, sub].filter(Boolean);
            if (parts.length > 0) {
                badge.textContent = parts.join(' • ');
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }
        window.updatePaperDetailsSummaryBadge = updatePaperDetailsSummaryBadge;

        function toggleRowDropdown(btn, e) {
            if (e) e.stopPropagation();
            const parent = btn.closest('.row-dropdown');
            const menu = parent ? parent.querySelector('.row-dropdown-menu') : null;
            const arrow = btn.querySelector('.dropdown-arrow');
            if (!menu) return;

            const isHidden = menu.classList.contains('hidden');
            closeAllSystemDropdowns();

            if (isHidden) {
                menu.classList.remove('hidden');
                if (arrow) arrow.style.transform = 'rotate(180deg)';
            }
