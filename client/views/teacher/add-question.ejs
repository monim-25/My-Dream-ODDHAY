                    <div class="space-y-1 relative system-dropdown row-dropdown">
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5">Correct answer</label>
                        <input type="hidden" name="qCorrectIndex[]" class="row-correct-input" value="0">
