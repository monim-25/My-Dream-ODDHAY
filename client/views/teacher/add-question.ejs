                    }
                } else {
                    subTopicSelect.disabled = true;
                    subTopicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                    subTopicSelect.innerHTML = '<option value="">Select Topic First</option>';
                    subTopicSelect.value = '';
