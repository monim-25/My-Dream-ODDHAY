                                            <button type="button" onclick="insertMathCode('\\Omega', 'symbol')" class="math-sym-btn" title="ওহম (Omega)">Ω</button>
                                            <button type="button" onclick="insertMathCode('$', 'dollar')" class="math-sym-btn font-mono font-bold" title="সমীকরণ ট্যাগ ($...$)">$...$</button>
                                        </div>
                                    </div>
                                </div>
                                </div>

