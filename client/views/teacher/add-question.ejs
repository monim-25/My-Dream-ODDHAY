                        <input type="text" name="qOptions[]" placeholder="Option A" class="flex-1 h-8 sm:h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all">
                    </div>
                    <div class="flex items-center gap-2 group">
                        <span class="size-7 sm:size-8 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xs font-medium text-slate-500 group-focus-within:bg-primary group-focus-within:text-white transition-all shrink-0">B</span>
                        <input type="text" name="qOptions[]" placeholder="Option B" class="flex-1 h-8 sm:h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all">
                    </div>
