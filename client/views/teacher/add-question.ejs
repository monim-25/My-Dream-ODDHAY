        window.toggleBulkFormatGuide = toggleBulkFormatGuide;

        function parseBulkQuestionsText(rawText) {
            if (!rawText || !rawText.trim()) return [];

            const lines = rawText.split(/\r?\n/);

            const qStartRegex = /^\s*(?:[\d০-৯]+[\.\)]|\([\d০-৯]+\)|Q(?:uestion)?\s*[\d০-৯]+[:\.\)]|প্রশ্ন\s*[\d০-৯]+[:\.\)])/i;
            const stimulusHeaderRegex = /^\s*(?:\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]|(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–]|(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে)/i;

            const bnToEn = s => String(s).replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d));

            function extractRangeFromInstruction(text) {
                const m = text.match(/([\d০-৯]+)\s*(?:[ও\-,–]|এবং|হতে|থেকে|to)\s*([\d০-৯]+)\s*নং/i);
                if (m) {
                    const start = parseInt(bnToEn(m[1]));
                    const end = parseInt(bnToEn(m[2]));
                    return { start, end };
                }
                return null;
            }

            // Step 1: Chunk into question blocks with associated preambles (stimuli)
            const blocks = [];
            let currentBlock = [];
            let pendingPreambleLines = [];
            let inPreamble = false;

            lines.forEach(line => {
                const trimmed = line.trim();
                if (!trimmed) return;

                if (stimulusHeaderRegex.test(trimmed)) {
                    if (currentBlock.length > 0) {
                        blocks.push({
                            text: currentBlock.join('\n'),
                            preamble: pendingPreambleLines.join('\n')
                        });
                        currentBlock = [];
                        pendingPreambleLines = [];
                    }
                    inPreamble = true;
                    pendingPreambleLines.push(line);
                    return;
                }

                if (inPreamble) {
                    if (qStartRegex.test(trimmed)) {
                        inPreamble = false;
                        currentBlock.push(line);
                    } else {
                        pendingPreambleLines.push(line);
                    }
                    return;
                }

                if (qStartRegex.test(trimmed)) {
                    if (currentBlock.length > 0) {
                        blocks.push({
                            text: currentBlock.join('\n'),
                            preamble: pendingPreambleLines.join('\n')
                        });
                        currentBlock = [];
                        pendingPreambleLines = [];
                    }
                    currentBlock.push(line);
                    return;
                }

                if (currentBlock.length > 0) {
                    currentBlock.push(line);
                } else {
                    pendingPreambleLines.push(line);
                }
            });

            if (currentBlock.length > 0) {
                blocks.push({
                    text: currentBlock.join('\n'),
                    preamble: pendingPreambleLines.join('\n')
                });
            }

            if (blocks.length === 0 && pendingPreambleLines.length > 0) {
                blocks.push({ text: pendingPreambleLines.join('\n'), preamble: '' });
            }

            // Step 2: Parse each block into a structured question object
            const parsed = [];
            let activeSharedContext = null;

            blocks.forEach((blockObj, idx) => {
                const block = blockObj.text;
                const preamble = blockObj.preamble || '';
                const bLines = block.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
                if (bLines.length === 0) return;

                // Check preamble stimulus
                if (preamble && (stimulusHeaderRegex.test(preamble) || /উদ্দীপক|অনুচ্ছেদ|Stem|Context/i.test(preamble))) {
                    let pInst = 'উদ্দীপকটি পড়ে নিচের প্রশ্নগুলোর উত্তর দিন';
                    const instMatch = preamble.match(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/im);
                    if (instMatch) {
                        pInst = instMatch[0].replace(/[\:\-\–]+$/, '').trim();
                    }
                    let cleanCtx = preamble
                        .replace(/\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]/gi, '')
                        .replace(/^(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–]/gim, '')
                        .replace(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/gim, '')
                        .trim();

                    const range = extractRangeFromInstruction(pInst);
                    activeSharedContext = {
                        contextId: 'ctx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                        context: cleanCtx || preamble.trim(),
                        contextInstruction: pInst,
                        range: range,
                        remainingCount: range ? (range.end - range.start + 1) : 2
                    };
                }

                let qText = '';
                let options = [];
                let correctIndex = -1;
                let explanation = '';
                let isBangla = /[\u0980-\u09FF]/.test(block + ' ' + preamble);

                // Extract Question Number
                let qNum = null;
                const qNumMatch = bLines[0].match(/^\s*(?:([\d০-৯]+)[\.\)]|\(([\d০-৯]+)\)|Q(?:uestion)?\s*([\d০-৯]+)|প্রশ্ন\s*([\d০-৯]+))/i);
                if (qNumMatch) {
                    const rawNum = qNumMatch[1] || qNumMatch[2] || qNumMatch[3] || qNumMatch[4];
                    qNum = parseInt(bnToEn(rawNum));
                }

                // Clean first line
                let firstLine = bLines[0]
                    .replace(/^\s*(?:[\d০-৯]+[\.\)]|\([\d০-৯]+\)|Q(?:uestion)?\s*[\d০-৯]*[:\.\)\-]?|প্রশ্ন\s*[\d০-৯]*[:\.\)\-]?)\s*/i, '')
                    .trim();
                qText = firstLine;

                let inOptions = false;
                let inExplanation = false;

                for (let i = 1; i < bLines.length; i++) {
                    const line = bLines[i];

                    // Answer Detection
                    const ansMatch = line.match(/^(?:উত্তরঃ|উত্তর|উঃ|উ:|Ans(?:wer)?|Correct(?:\s*Answer)?|Key|সঠিক(?:\s*উত্তর)?)\s*[:\-\–\.\ঃ]?\s*(.+)$/i);
                    if (ansMatch) {
                        const ansRaw = ansMatch[1].trim();
                        const cleanAns = ansRaw.replace(/[\(\)\[\]\.\,\:\ঃ]/g, '').trim().toLowerCase();
                        if (['ক', 'a', '১', '1', 'i'].includes(cleanAns)) correctIndex = 0;
                        else if (['খ', 'b', '২', '2', 'ii'].includes(cleanAns)) correctIndex = 1;
                        else if (['গ', 'c', '৩', '3', 'iii'].includes(cleanAns)) correctIndex = 2;
                        else if (['ঘ', 'd', '৪', '4', 'iv'].includes(cleanAns)) correctIndex = 3;
                        else {
                            const optIdx = options.findIndex(opt => opt && opt.toLowerCase() === ansRaw.toLowerCase());
                            if (optIdx !== -1) correctIndex = optIdx;
                        }
                        continue;
                    }

                    // Explanation Detection
                    const expMatch = line.match(/^(?:ব্যাখ্যা|ব্যাখ্যাঃ|Explanation|Exp|Note)\s*[:\-\–\.]?\s*(.*)$/i);
                    if (expMatch) {
                        explanation = expMatch[1].trim();
                        inExplanation = true;
                        continue;
                    }

                    if (inExplanation) {
                        explanation += ' ' + line;
                        continue;
                    }

                    // Check multiple options on single line
                    const multiParts = line.split(/(?=(?:^|[\s\t]+)(?:\(?([ক-ঘa-dA-D1-4])[\)\.\:]\s*))/).filter(Boolean);
                    let hasMulti = false;
                    let tempOpts = [];
                    for (let part of multiParts) {
                        const pMatch = part.trim().match(/^[\(\[]?([ক-ঘa-dA-D1-4])[\)\.\:\]]\s*(.+)$/);
                        if (pMatch) {
                            tempOpts.push(pMatch[2].trim());
                            hasMulti = true;
                        }
                    }
                    if (hasMulti && tempOpts.length >= 2) {
                        options.push(...tempOpts);
                        inOptions = true;
                        continue;
                    }

                    // Single option on this line
                    const singleOptMatch = line.match(/^[\(\[]?([ক-ঘa-dA-D1-4])[\)\.\:\]]\s*(.+)$/);
                    if (singleOptMatch) {
                        options.push(singleOptMatch[2].trim());
                        inOptions = true;
                        continue;
                    }

                    if (!inOptions && !inExplanation) {
                        qText += '\n' + line;
                    }
                }

                while (options.length < 4) {
                    options.push('');
                }

                let mcqSubtype = 'standard';
                let statements = [];
                let context = '';
                let contextInstruction = 'উদ্দীপকটি পড়ে নিচের প্রশ্নগুলোর উত্তর দিন';
                let contextId = '';

                // 1. Detect Roman numeral statements (i., ii., iii. or ⅰ., ⅱ., ⅲ. or I., II., III.)
                const stmtMatches = [];
                const nonStmtLines = [];
                const romanSplitRegex = /(?=(?:^|[\s\t]+)(?:(?:i{1,3}|I{1,3}|[ⅰ-ⅲ])[\.\)]|\((?:i{1,3}|I{1,3}|[ⅰ-ⅲ])\))\s*)/i;
                qText.split('\n').forEach(ql => {
                    const parts = ql.split(romanSplitRegex).map(p => p.trim()).filter(Boolean);
                    let lineHadStmt = false;
                    parts.forEach(p => {
                        const m = p.match(/^(?:(?:i{1,3}|I{1,3}|[ⅰ-ⅲ])[\.\)]|\((?:i{1,3}|I{1,3}|[ⅰ-ⅲ])\))\s*(.+)$/i);
                        if (m) {
                            stmtMatches.push(m[1].trim());
                            lineHadStmt = true;
                        }
                    });
                    if (!lineHadStmt) {
                        nonStmtLines.push(ql);
                    }
                });

                if (stmtMatches.length >= 2) {
                    mcqSubtype = 'multiple_completion';
                    statements = stmtMatches;
                    qText = nonStmtLines.join('\n').trim() || 'নিচের তথ্যের আলোকে কোনটি সঠিক?';
                }

                // 2. Stimulus/Context Detection
                const ctxMatch = block.match(/(?:\[(?:উদ্দীপক|অনুচ্ছেদ|Stem|Context|Passage)\]|^(?:উদ্দীপক|অনুচ্ছেদ|দৃশ্যকল্প|Stem|Context)\s*[:\-\–])\s*([\s\S]*?)(?=(?:[\d০-৯]+[\.\)]|Q\d|প্রশ্ন|\(?ক[\)\.]))/im);
                if (ctxMatch) {
                    context = ctxMatch[1].trim();
                    mcqSubtype = 'contextual';
                    const instMatch = block.match(/(?:(?:নিচের\s+)?(?:উদ্দীপকটি|অনুচ্ছেদটি|দৃশ্যকল্পটি)\s+পড়ে[^\n]+প্রশ্নের?\s+উত্তর\s+(?:দাও|দিন)[\:\-\–]?)/im);
                    if (instMatch) {
                        contextInstruction = instMatch[0].replace(/[\:\-\–]+$/, '').trim();
                    }
                    contextId = 'ctx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                } else if (activeSharedContext) {
                    let applies = false;
                    if (activeSharedContext.range && qNum !== null) {
                        applies = (qNum >= activeSharedContext.range.start && qNum <= activeSharedContext.range.end);
                    } else if (activeSharedContext.remainingCount > 0) {
                        applies = true;
                        activeSharedContext.remainingCount--;
                    }

                    if (applies) {
                        mcqSubtype = 'contextual';
                        context = activeSharedContext.context;
                        contextInstruction = activeSharedContext.contextInstruction;
                        contextId = activeSharedContext.contextId;
                    } else {
                        activeSharedContext = null;
                    }
                }

                const isValid = (qText.trim().length > 0 && options.filter(o => o.trim().length > 0).length >= 3 && correctIndex >= 0);

                parsed.push({
                    qText: qText.trim(),
                    mcqSubtype,
                    statements,
                    context,
                    contextInstruction,
                    contextId,
                    options: options.slice(0, 4),
                    correctIndex,
                    explanation: explanation.trim(),
                    isBangla,
                    isValid
                });
            });

            return parsed;
        }

        function onBulkInputChanged() {
            clearTimeout(_bulkDebounceTimer);
            _bulkDebounceTimer = setTimeout(() => {
                const rawInput = document.getElementById('bulkRawInput');
                const rawText = rawInput ? rawInput.value : '';
                _parsedBulkQuestions = parseBulkQuestionsText(rawText);
                renderBulkPreviewCards();
                updateBulkStats();
            }, 250);
        }
        window.onBulkInputChanged = onBulkInputChanged;

        function updateBulkStats() {
            const total = _parsedBulkQuestions.length;
            const valid = _parsedBulkQuestions.filter(q => q.isValid).length;

            const totalEl = document.getElementById('bulkTotalParsedText');
            const validEl = document.getElementById('bulkValidParsedText');
            const saveCountEl = document.getElementById('bulkSaveCount');
            const subtextEl = document.getElementById('bulkPreviewSubtext');

            if (totalEl) totalEl.innerText = `${total} টি প্রশ্ন শনাক্ত`;
            if (validEl) validEl.innerText = `${valid} টি রেডি`;
            if (saveCountEl) saveCountEl.innerText = total;
            if (subtextEl) subtextEl.innerText = total > 0 ? `${total}টি প্রশ্নের লাইভ ভিউ` : '০টি প্রশ্ন';
        }

        function renderBulkPreviewCards() {
            const container = document.getElementById('bulkPreviewContainer');
            if (!container) return;

            if (_parsedBulkQuestions.length === 0) {
                container.innerHTML = `
                    <div class="h-full min-h-[360px] flex flex-col items-center justify-center p-8 text-center">
                        <div class="size-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 mb-3">
                            <span class="material-symbols-rounded text-3xl">bolt</span>
                        </div>
                        <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200">কোনো প্রশ্ন পেস্ট করা হয়নি</h4>
                        <p class="text-xs text-slate-400 max-w-sm mt-1 leading-relaxed">
                            ওয়ার্ড বা নোটপ্যাড থেকে প্রশ্নপত্র কপি করে বামপাশের বক্সে পেস্ট করুন, অথবা ডেমো বাটন চেপে পরীক্ষা করুন।
