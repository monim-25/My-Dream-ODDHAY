<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Compose Matrix | ODDHAY Command Center</title>
        <style>
            * {
                font-family: 'Inter', 'Hind Siliguri', sans-serif !important;
            }

            :root {
                --admin-sidebar-width: 260px;
            }

            html,
            body {
                height: 100%;
                height: 100dvh;
                overflow: hidden;
                margin: 0;
                padding: 0;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100%;
                height: 100dvh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                width: calc(100% - var(--admin-sidebar-width));
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                -webkit-overflow-scrolling: touch;
                touch-action: pan-y;
                position: relative;
            }

            @media (max-width: 1024px) {

                .admin-sidebar,
                #adminSidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0 !important;
                    width: 100% !important;
                }
            }

            .admin-sidebar.active,
            #adminSidebar.active,
            .admin-sidebar.translate-x-0,
            #adminSidebar.translate-x-0 {
                transform: translateX(0) !important;
            }

            .q-row,
            .question-row {
                transition: all 0.25s ease;
            }

            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            .q-chapter-select,
            .q-topic-select,
            .q-subtopic-select {
                appearance: none !important;
                -webkit-appearance: none !important;
                -moz-appearance: none !important;
                background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
                background-repeat: no-repeat !important;
                background-position: right 0.5rem center !important;
                background-size: 14px 14px !important;
                padding-right: 1.75rem !important;
                padding-left: 0.625rem !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                height: 32px !important;
                line-height: 30px !important;
                font-size: 11.5px !important;
                font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                vertical-align: middle !important;
                box-sizing: border-box !important;
            }
        </style>
</head>

<body
    class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans antialiased overflow-hidden h-full h-[100dvh] flex flex-col">
    <div class="flex h-full h-[100dvh] w-full min-h-0 overflow-hidden flex-1">
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: locals.active || 'question-details' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)"
            class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300">
        </div>

        <main class="admin-main flex-1 flex flex-col h-full h-[100dvh] min-h-0 overflow-hidden">
            <%- include('header', { pageTitle: 'Questions' , user: user }) %>

                <div
                    class="content-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden p-3 sm:p-6 lg:p-8 bg-[#FFFFFF] dark:bg-[#020617]">
                    <div class="max-w-4xl mx-auto pb-6">
                        <form action="/teacher/add-question-full" method="POST" enctype="multipart/form-data"
                            class="space-y-4 sm:space-y-5">

                            <!-- Global Metadata Header (Visible in Archive Mode) -->
                            <div id="archiveGlobalHeader" class="hidden animate-slide-up mb-5">
                                <div
                                    class="bg-white dark:bg-[#0f172a] rounded-xl p-4 sm:p-5 border border-slate-200 dark:border-white/5 shadow-xs">
                                    <div class="flex items-center gap-2.5 mb-3.5">
                                        <div
                                            class="size-8 rounded-lg bg-primary/10 flex items-center justify-center border border-primary/20 shrink-0">
                                            <span
                                                class="material-symbols-rounded text-primary text-[17px]">archive</span>
                                        </div>
                                        <h4 class="text-[13px] font-medium text-slate-900 dark:text-white">Paper details
                                        </h4>
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
                                        <!-- Board -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Board
                                                <span class="text-rose-500">*</span></label>
                                            <input type="text" name="board" id="globalBoard" required
                                                class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all"
                                                placeholder="e.g. Dhaka">
                                        </div>
                                        <!-- Year -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Year
                                                <span class="text-rose-500">*</span></label>
                                            <input type="number" name="year" id="globalYear" required
                                                class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all"
                                                placeholder="2024">
                                        </div>
                                        <!-- Exam Duration (Mins) -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Time
                                                (mins)</label>
                                            <input type="number" name="duration" id="globalDuration" value="30" min="1"
                                                max="600"
                                                class="w-full h-9 px-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-900 dark:text-white outline-none focus:border-primary transition-all">
                                        </div>
                                        <!-- Subject – Multi-Select -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Subject
                                                <span class="text-rose-500">*</span></label>
                                            <% const subjectList=(assignedSubjects && assignedSubjects.length> 0) ?
                                                assignedSubjects : [];
                                                const defaultInitialSub = subjectList[0] || '';
                                                %>
                                                <input type="hidden" name="subject" id="globalSubject"
                                                    value="<%= defaultInitialSub %>" required>
                                                <div class="relative system-dropdown" id="dropdown-globalSubject">
                                                    <button type="button"
                                                        onclick="toggleSystemDropdown('globalSubject', event)"
                                                        class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                        <span id="globalSubject-label" class="truncate font-medium">
                                                            <%= defaultInitialSub || 'Select Subject' %>
                                                        </span>
                                                        <span
                                                            class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                    </button>
                                                    <div id="dropdown-menu-globalSubject"
                                                        class="hidden absolute top-full left-0 right-0 mt-1 min-w-[190px] w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                        <% if (subjectList.length===0) { %>
                                                            <div class="px-3 py-2 text-xs text-slate-400 italic">No
                                                                assigned subjects</div>
                                                            <% } else { %>
                                                                <% subjectList.forEach((s, idx)=> { %>
                                                                    <div onclick="selectGlobalSubjectDirect('<%= s %>')"
                                                                        data-val="<%= s %>"
                                                                        class="global-sub-item px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors <%= idx === 0 ? 'font-medium text-primary bg-primary/10' : 'font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                                        <span class="truncate font-medium">
                                                                            <%= s %>
                                                                        </span>
                                                                        <% if (idx===0) { %>
                                                                            <span
                                                                                class="material-symbols-rounded text-sm text-primary sub-check-icon">check</span>
                                                                            <% } %>
                                                                    </div>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </div>
                                                </div>
                                        </div>
                                        <!-- Class – Multi-Select -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">Classes
                                                <span class="text-rose-500">*</span></label>
                                            <% const classList=(assignedClasses && assignedClasses.length> 0) ?
                                                assignedClasses : [];
                                                const initialRawClass = classList[0] ? String(classList[0]) : '';
                                                const initialClassVal = initialRawClass.replace(/^Class\s+/i, '');
                                                const initialClassLabel = initialRawClass ?
                                                (initialRawClass.startsWith('Class') ? initialRawClass : 'Class ' +
                                                initialRawClass) : 'Select Class';
                                                %>
                                                <input type="hidden" name="classLevel" id="globalClass"
                                                    value="<%= initialClassVal %>" required>
                                                <div class="relative system-dropdown" id="dropdown-globalClass">
                                                    <button type="button"
                                                        onclick="toggleSystemDropdown('globalClass', event)"
                                                        class="w-full h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between transition-all cursor-pointer shadow-2xs select-none">
                                                        <span id="globalClass-label" class="truncate font-medium">
                                                            <%= initialClassLabel %>
                                                        </span>
                                                        <span
                                                            class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                                    </button>
                                                    <div id="dropdown-menu-globalClass"
                                                        class="hidden absolute top-full left-0 right-0 mt-1 min-w-[180px] w-full rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 max-h-56 overflow-y-auto no-scrollbar">
                                                        <% if (classList.length===0) { %>
                                                            <div class="px-3 py-2 text-xs text-slate-400 italic">No
                                                                assigned classes</div>
                                                            <% } else { %>
                                                                <% classList.forEach((c, idx)=> {
                                                                    const cRaw = String(c);
                                                                    const cVal = cRaw.replace(/^Class\s+/i, '');
                                                                    const cLbl = cRaw.startsWith('Class') ? cRaw :
                                                                    'Class ' + cRaw;
                                                                    %>
                                                                    <div onclick="selectGlobalClassDirect('<%= cVal %>', '<%= cLbl %>')"
                                                                        class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors select-none">
                                                                        <label
                                                                            class="flex items-center gap-2 cursor-pointer flex-1"
                                                                            onclick="event.stopPropagation()">
                                                                            <input type="checkbox" name="classLevel[]"
                                                                                value="<%= cVal %>" <%=idx===0
                                                                                ? 'checked' : '' %>
                                                                            class="accent-primary rounded size-3.5
                                                                            global-class-cb"
                                                                            onchange="syncGlobalClasses()">
                                                                            <span class="truncate font-medium">
                                                                                <%= cLbl %>
                                                                            </span>
                                                                        </label>
                                                                    </div>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </div>
                                                </div>
                                        </div>
                                        <!-- Source PDF -->
                                        <div class="space-y-1">
                                            <label
                                                class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5 block">File</label>
                                            <label
                                                class="flex items-center gap-1.5 h-9 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-700 cursor-pointer hover:border-primary/60 transition-all overflow-hidden">
                                                <span
                                                    class="material-symbols-rounded text-slate-400 text-[15px] shrink-0">attach_file</span>
                                                <span id="fileNameLabel"
                                                    class="text-xs font-normal text-slate-500 dark:text-slate-400 truncate flex-1">Attach</span>
                                                <input type="file" name="file" class="hidden"
                                                    onchange="document.getElementById('fileNameLabel').textContent = this.files[0]?.name || 'Attach'; document.getElementById('fileNameLabel').classList.add('text-primary');">
                                            </label>
                                        </div>
                                    </div>

                                    <input type="hidden" name="accessType" id="globalAccessType" value="Free">
                                    <input type="hidden" name="fileUrl" id="globalFileUrl" value="">

                                    <!-- No courses assigned warning -->
                                    <% if (!assignedSubjects || assignedSubjects.length===0) { %>
                                        <div
                                            class="mt-3 px-3 py-2 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 flex items-center gap-2">
                                            <span
                                                class="material-symbols-rounded text-amber-500 text-[15px] shrink-0">info</span>
                                            <p class="text-xs font-normal text-amber-700 dark:text-amber-400">No courses
                                                assigned — enter subject and class manually.</p>
                                        </div>
                                        <% } %>
                                </div>
                            </div>

                            <input type="hidden" name="mode" id="studioMode" value="standalone">
                            <div id="hiddenMetaFields">
                                <input type="hidden" name="classLevel" value="" id="hiddenClass">
                                <input type="hidden" name="isBoardQuestion" value="on">
                                <input type="hidden" name="bankId" value="">
                                <input type="hidden" name="board" value="" id="hiddenBoard">
                                <input type="hidden" name="year" value="" id="hiddenYear">
                                <input type="hidden" name="subject" value="" id="hiddenSubject">
                                <input type="hidden" name="accessType" value="Free" id="hiddenAccessType">
                                <input type="hidden" name="fileUrl" value="" id="hiddenFileUrl">
                            </div>

                            <!-- Question Count & Metadata Info -->
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 px-0.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span id="questionCountBadge"
                                        class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 shadow-2xs">
                                        1 question
                                    </span>
                                    <!-- Metadata Badges -->
                                    <div id="studioMetaBadges" class="flex flex-wrap items-center gap-1.5"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <!-- Form-Level Language Toggle (Applies to all questions) -->
                                    <div
                                        class="inline-flex items-center p-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                                        <button type="button" onclick="setGlobalBangla(true)" id="formLangBnBtn"
                                            class="px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-500 text-white shadow-xs transition-all cursor-pointer">
                                            বাংলা
                                        </button>
                                        <button type="button" onclick="setGlobalBangla(false)" id="formLangEnBtn"
                                            class="px-2.5 py-1 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer">
                                            English
                                        </button>
                                    </div>
                                    <div id="draftStatusBadge"
                                        class="hidden items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 transition-all">
                                        <span class="material-symbols-rounded text-[14px]">cloud_done</span>
                                        <span id="draftStatusText">Draft autosaved</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Bulk Question Container -->
                            <div id="questionsContainer" class="space-y-3.5 sm:space-y-4">
                                <!-- Question rows will be injected here -->
                            </div>

                            <!-- Addition Controls -->
                            <div
                                class="bg-white dark:bg-[#0f172a] rounded-xl p-3.5 sm:p-4 border border-slate-200 dark:border-white/5 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <div
                                        class="flex items-center h-9 sm:h-10 bg-slate-100 dark:bg-slate-800 rounded-lg overflow-visible flex-1 sm:flex-initial border border-slate-200 dark:border-slate-700">
                                        <input type="number" id="bulkAddCount" value="1" min="1" max="50"
                                            class="w-12 sm:w-14 h-full pl-2.5 bg-transparent text-xs font-normal text-slate-700 dark:text-slate-200 outline-none text-center">
                                        <div class="w-px h-4 bg-slate-300 dark:bg-slate-600 mx-1 flex-shrink-0"></div>

                                        <!-- In-System Dropdown for Bulk Add Type -->
                                        <input type="hidden" id="bulkAddType" value="MCQ">
                                        <div class="relative system-dropdown h-full" id="dropdown-bulkAddType">
                                            <button type="button" onclick="toggleSystemDropdown('bulkAddType', event)"
                                                class="h-full px-2.5 bg-transparent text-xs font-normal text-slate-700 dark:text-slate-200 flex items-center gap-1 transition-all cursor-pointer select-none">
                                                <span id="bulkAddType-label" class="truncate">MCQ</span>
                                                <span
                                                    class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                            </button>
                                            <div id="dropdown-menu-bulkAddType"
                                                class="hidden absolute bottom-full mb-1 sm:mb-0 sm:bottom-auto sm:top-full left-0 w-36 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50 overflow-y-auto no-scrollbar">
                                                <div onclick="selectSystemOption('bulkAddType', 'MCQ', 'MCQ')"
                                                    data-val="MCQ"
                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors bg-primary/10 text-primary font-medium">
                                                    <span>MCQ</span>
                                                    <span
                                                        class="material-symbols-rounded text-sm text-primary check-icon">check</span>
                                                </div>
                                                <div onclick="selectSystemOption('bulkAddType', 'Short', 'Short')"
                                                    data-val="Short"
                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-normal">
                                                    <span>Short</span>
                                                </div>
                                                <div onclick="selectSystemOption('bulkAddType', 'Medium', 'Medium')"
                                                    data-val="Medium"
                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-normal">
                                                    <span>Medium</span>
                                                </div>
                                                <div onclick="selectSystemOption('bulkAddType', 'Comprehension', 'Comprehension')"
                                                    data-val="Comprehension"
                                                    class="px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-normal">
                                                    <span>Comprehension</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" onclick="addQuestionRows()"
                                        class="h-9 sm:h-10 px-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1 shrink-0 border border-slate-200 dark:border-slate-700 active:scale-95">
                                        <span class="material-symbols-rounded text-[17px]">add</span>
                                        <span>Add slot</span>
                                    </button>
                                </div>

                                <div
                                    class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 dark:border-slate-800">
                                    <a href="<%= mode === 'archive' ? '/teacher/question-bank' : '/teacher/questions' %>"
                                        onclick="clearStudioDraft()"
                                        class="text-xs font-normal text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-all px-2">Discard</a>
                                    <button type="submit"
                                        class="flex-1 sm:flex-initial h-9 sm:h-10 px-5 sm:px-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-black dark:hover:bg-slate-100 rounded-lg font-medium text-xs shadow-xs transition-all active:scale-95 flex items-center justify-center gap-1.5">
                                        <span class="material-symbols-rounded text-[17px]">check</span>
                                        <span>Save</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Mobile clearance spacer so bottom-nav never covers action bar -->
                            <div class="h-28 lg:hidden shrink-0"></div>
                        </form>
                    </div>
                </div>
                <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <template id="questionTemplate">
        <div
            class="question-row bg-white dark:bg-[#0f172a] rounded-xl sm:rounded-2xl p-3.5 sm:p-5 border border-slate-200 dark:border-white/5 shadow-xs transition-all animate-slide-up relative space-y-3.5 sm:space-y-4">

            <!-- Hidden Fields -->
            <input type="hidden" name="qType[]" value="MCQ">

            <!-- Row Header -->
            <div class="space-y-2.5 pb-2.5 sm:pb-3 border-b border-slate-100 dark:border-slate-800/80">
                <!-- Line 1: Question Number & Type on Left; Board, Year, Marks & Delete on Right -->
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <div class="relative system-dropdown row-type-dropdown">
                            <button type="button" onclick="toggleRowDropdown(this, event)"
                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200/80 dark:border-slate-700/80 transition-all cursor-pointer">
                                <span class="q-index font-bold">1</span>
                                <span class="text-slate-300 dark:text-slate-600">•</span>
                                <span class="q-type-label font-bold text-primary">MCQ</span>
                                <span
                                    class="material-symbols-rounded text-xs text-slate-400 dropdown-arrow">expand_more</span>
                            </button>
                            <div
                                class="row-dropdown-menu hidden absolute top-full left-0 mt-1 w-36 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50">
