        async function loadTopicsForQuestionStudio() {
            const urlParams = new URLSearchParams(window.location.search);
            // Read active form values first, fallback to URL parameters
            const subject = (document.getElementById('globalSubject')?.value || document.getElementById('hiddenSubject')?.value || urlParams.get('subject') || '').trim();
            const classLevel = (document.getElementById('globalClass')?.value || document.getElementById('hiddenClass')?.value || urlParams.get('class') || '').trim();
            const cacheKey = `${subject}__${classLevel}`.toLowerCase();

            const globalChapEl = document.getElementById('globalChapter');
            if (globalChapEl && !_studioTopicsCache.has(cacheKey) && cachedStudioChapters.length === 0) {
                globalChapEl.innerHTML = '<option value="">Loading chapters...</option>';
            }

            if (subject || classLevel) {
                try {
                    const data = await fetchStudioTopicsSafely(subject, classLevel);
                    if (data) {
                        cachedStudioTopics = Array.isArray(data.topics) ? data.topics : [];
                        cachedStudioChapters = Array.isArray(data.chapters) ? data.chapters : [];
                    }
                } catch (e) {
                    console.warn('Failed to load syllabus topics:', e);
                }
            }

            const availableChapterSet = new Set();
            (cachedStudioChapters || []).forEach(ch => { if (ch && String(ch).trim()) availableChapterSet.add(String(ch).trim().toLowerCase()); });
            (cachedStudioTopics || []).forEach(t => {
                if (!t) return;
                const chName = typeof t.chapter === 'string' ? t.chapter.trim() : (t.chapter && t.chapter.name ? t.chapter.name.trim() : '');
                if (chName) availableChapterSet.add(chName.toLowerCase());
            });

            // If archive global header has chapter/topic/subtopic, populate and sync them
            const globalTopEl = document.getElementById('globalTopic');
            const globalSubEl = document.getElementById('globalSubTopic');
            if (globalChapEl) {
                const currentGlobalChap = globalChapEl.value || urlParams.get('chapter') || '';
                let gHtml = '<option value="">Chapter (Optional)</option>';
                Array.from(availableChapterSet).sort().forEach(ch => {
                    const isSel = currentGlobalChap && currentGlobalChap.toLowerCase() === ch.toLowerCase() ? 'selected' : '';
                    gHtml += `<option value="${escapeTopicHtml(ch)}" ${isSel}>${escapeTopicHtml(ch)}</option>`;
                });
                if (currentGlobalChap && !Array.from(availableChapterSet).some(c => c.toLowerCase() === currentGlobalChap.toLowerCase())) {
                    gHtml += `<option value="${escapeTopicHtml(currentGlobalChap)}" selected>${escapeTopicHtml(currentGlobalChap)}</option>`;
                }
                globalChapEl.innerHTML = gHtml;
                if (currentGlobalChap) globalChapEl.value = currentGlobalChap;

                if (globalTopEl) {
                    const currentGlobalTop = globalTopEl.value || urlParams.get('topic') || '';
                    if (globalChapEl.value) {
                        globalTopEl.disabled = false;
                        globalTopEl.classList.remove('opacity-50', 'cursor-not-allowed');
                        globalTopEl.innerHTML = buildTopicOptionsHTML(currentGlobalTop, globalChapEl.value);
                        if (currentGlobalTop) globalTopEl.value = currentGlobalTop;
                    } else {
                        globalTopEl.disabled = true;
                        globalTopEl.classList.add('opacity-50', 'cursor-not-allowed');
                        globalTopEl.innerHTML = '<option value="">Select Chapter First</option>';
                        globalTopEl.value = '';
                    }
                }

                if (globalSubEl) {
                    const currentGlobalSub = globalSubEl.value || urlParams.get('subTopic') || '';
                    if (globalTopEl && globalTopEl.value && globalChapEl.value) {
                        const matchedTopic = (cachedStudioTopics || []).find(t => {
                            const name = (t.name || (typeof t === 'string' ? t : '')).trim().toLowerCase();
                            return name === globalTopEl.value.toLowerCase();
                        });
                        if (matchedTopic && Array.isArray(matchedTopic.subTopics) && matchedTopic.subTopics.length > 0) {
                            globalSubEl.disabled = false;
                            globalSubEl.classList.remove('opacity-50', 'cursor-not-allowed');
                            globalSubEl.innerHTML = buildSubTopicOptionsHTML(currentGlobalSub, globalTopEl.value, globalChapEl.value);
                            if (currentGlobalSub) globalSubEl.value = currentGlobalSub;
                        } else {
                            globalSubEl.disabled = true;
                            globalSubEl.classList.add('opacity-50', 'cursor-not-allowed');
                            globalSubEl.innerHTML = '<option value="">No sub-topics available</option>';
                            globalSubEl.value = '';
                        }
                    } else {
                        globalSubEl.disabled = true;
                        globalSubEl.classList.add('opacity-50', 'cursor-not-allowed');
                        globalSubEl.innerHTML = '<option value="">Select Topic First</option>';
                        globalSubEl.value = '';
                    }
                }
            }

            document.querySelectorAll('.question-row').forEach(row => syncRowHierarchy(row));
        }

        function initQuestionStudio() {
            if (window._studioHasInitialized) return;
            window._studioHasInitialized = true;
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            if (urlParams.has('class')) {
                const hiddenClass = document.querySelector('input[name="classLevel"]');
                if (hiddenClass) hiddenClass.value = urlParams.get('class');
            }
            if (urlParams.has('bankId')) {
                const hiddenBank = document.querySelector('input[name="bankId"]');
                if (hiddenBank) hiddenBank.value = urlParams.get('bankId');
            }

            const studioMode = document.getElementById('studioMode');
            if (studioMode) studioMode.value = mode;

            if (mode === 'archive') {
                const archiveHeader = document.getElementById('archiveGlobalHeader');
                if (archiveHeader) archiveHeader.classList.remove('hidden');

                const hiddenMeta = document.getElementById('hiddenMetaFields');
                if (hiddenMeta) hiddenMeta.remove();

                if (urlParams.has('board')) {
                    selectSystemOption('globalBoard', urlParams.get('board'), urlParams.get('board'));
                }

                if (urlParams.has('year')) {
                    selectSystemOption('globalYear', urlParams.get('year'), urlParams.get('year'));
                }

                if (urlParams.has('subject')) {
                    const rawSub = urlParams.get('subject').split(',')[0].trim();
                    const subItem = Array.from(document.querySelectorAll('#dropdown-menu-globalSubject .global-sub-item'))
                        .find(el => (el.getAttribute('data-val') || '').toLowerCase() === rawSub.toLowerCase());
                    if (subItem) {
                        selectGlobalSubjectDirect(subItem.getAttribute('data-val'));
                    } else {
                        const firstItem = document.querySelector('#dropdown-menu-globalSubject .global-sub-item');
                        if (firstItem) selectGlobalSubjectDirect(firstItem.getAttribute('data-val'));
                    }
                } else {
                    const firstItem = document.querySelector('#dropdown-menu-globalSubject .global-sub-item');
                    if (firstItem) selectGlobalSubjectDirect(firstItem.getAttribute('data-val'));
                }

                if (urlParams.has('class')) {
                    const rawCls = urlParams.get('class').split(',').map(c => c.trim().toLowerCase().replace(/^class\s+/i, ''));
                    let matchedAny = false;
                    document.querySelectorAll('.global-class-cb').forEach(cb => {
                        const v = cb.value.trim().toLowerCase().replace(/^class\s+/i, '');
                        if (rawCls.includes(v)) {
                            cb.checked = true;
                            matchedAny = true;
                        } else {
                            cb.checked = false;
                        }
                    });
                    if (!matchedAny) {
                        const firstCb = document.querySelector('.global-class-cb');
                        if (firstCb) firstCb.checked = true;
                    }
                    syncGlobalClasses();
                } else {
                    syncGlobalClasses();
                }

                const gAccess = document.getElementById('globalAccessType');
                if (gAccess && urlParams.has('access')) gAccess.value = urlParams.get('access');

                const gChapter = document.getElementById('globalChapter');
                if (gChapter && urlParams.has('chapter')) gChapter.value = urlParams.get('chapter');

                const gTopic = document.getElementById('globalTopic');
                if (gTopic && urlParams.has('topic')) gTopic.value = urlParams.get('topic');

                const gSubTopic = document.getElementById('globalSubTopic');
                if (gSubTopic && urlParams.has('subTopic')) gSubTopic.value = urlParams.get('subTopic');

                if (typeof updatePaperDetailsSummaryBadge === 'function') updatePaperDetailsSummaryBadge();
            } else {
                const globalHeader = document.getElementById('archiveGlobalHeader');
                if (globalHeader) globalHeader.remove();

                const hBoard = document.getElementById('hiddenBoard');
                if (hBoard && urlParams.has('board')) hBoard.value = urlParams.get('board');

                const hYear = document.getElementById('hiddenYear');
                if (hYear && urlParams.has('year')) hYear.value = urlParams.get('year');

                const hSubject = document.getElementById('hiddenSubject');
                if (hSubject && urlParams.has('subject')) hSubject.value = urlParams.get('subject');

                const hClass = document.getElementById('hiddenClass');
                if (hClass && urlParams.has('class')) hClass.value = urlParams.get('class');

                const hChapter = document.getElementById('hiddenChapter');
                if (hChapter && urlParams.has('chapter')) hChapter.value = urlParams.get('chapter');

                const hTopic = document.getElementById('hiddenTopic');
                if (hTopic && urlParams.has('topic')) hTopic.value = urlParams.get('topic');

                const hSubTopic = document.getElementById('hiddenSubTopic');
                if (hSubTopic && urlParams.has('subTopic')) hSubTopic.value = urlParams.get('subTopic');

                const hAccess = document.getElementById('hiddenAccessType');
                if (hAccess && urlParams.has('access')) hAccess.value = urlParams.get('access');
            }

            if (urlParams.has('type')) {
                selectSystemOption('bulkAddType', urlParams.get('type'), urlParams.get('type'));
            }

            renderMetadataBadges(urlParams);

            if (urlParams.has('fileUrl')) {
                const fUrl = urlParams.get('fileUrl');
                const fName = urlParams.get('fileName') || 'Paper Attachment';
                const gFile = document.getElementById('globalFileUrl');
                if (gFile) gFile.value = fUrl;
                const hFile = document.getElementById('hiddenFileUrl');
                if (hFile) hFile.value = fUrl;
                const label = document.getElementById('fileNameLabel');
                if (label) {
                    label.textContent = fName;
                    label.classList.add('text-primary');
                }
            }

            // 1. Language Setup first so newly added question rows immediately adopt the chosen language
            const urlLang = urlParams.get('lang');
            const urlIsBangla = urlParams.get('isBangla');
            if (urlLang === 'en' || urlIsBangla === 'false') {
                isGlobalBangla = false;
                if (typeof updateGlobalBanglaUI === 'function') updateGlobalBanglaUI();
            } else {
                isGlobalBangla = true;
                if (typeof updateGlobalBanglaUI === 'function') updateGlobalBanglaUI();
            }

            // 2. Fresh start handling (e.g. from Paper Composition modal or Question Wizard)
            const isFreshStart = urlParams.get('fresh') === 'true' || urlParams.has('slots') || urlParams.has('count');
            if (isFreshStart) {
                clearStudioDraft();
                // Strip fresh=true from URL via history.replaceState so future page reloads preserve typed data
                urlParams.delete('fresh');
                const newQuery = urlParams.toString();
                const cleanUrl = window.location.pathname + (newQuery ? '?' + newQuery : '');
                window.history.replaceState({}, '', cleanUrl);
            }

            // 3. Draft Restoration (only if not a fresh start from form/modal)
            let restored = false;
            if (!isFreshStart) {
                restored = restoreStudioDraft();
            }

            // 4. If draft not restored, generate requested question slots from URL
            if (!restored) {
                const container = document.getElementById('questionsContainer');
                if (container) container.innerHTML = '';

                const slotsParam = urlParams.get('slots');
                if (slotsParam) {
                    const pairs = slotsParam.split(',');
                    let totalSlotsAdded = 0;
                    pairs.forEach(pair => {
                        const [tRaw, cStr] = pair.split(':');
                        const c = parseInt(cStr) || 0;
                        const t = (tRaw || '').trim();
                        let normalizedType = 'MCQ';
                        if (/^mcq/i.test(t)) normalizedType = 'MCQ';
                        else if (/^short/i.test(t)) normalizedType = 'Short';
                        else if (/^med/i.test(t)) normalizedType = 'Medium';
                        else if (/^comp/i.test(t)) normalizedType = 'Comprehension';

                        if (c > 0) {
                            addQuestionRows(c, normalizedType);
                            totalSlotsAdded += c;
                        }
                    });
                    if (totalSlotsAdded === 0) {
                        addQuestionRows(1, 'MCQ');
                    }
                } else {
                    const initialCount = parseInt(urlParams.get('count')) || 1;
                    const rawType = (urlParams.get('type') || 'MCQ').trim();
                    let normalizedType = 'MCQ';
                    if (/^short/i.test(rawType)) normalizedType = 'Short';
                    else if (/^med/i.test(rawType)) normalizedType = 'Medium';
                    else if (/^comp/i.test(rawType)) normalizedType = 'Comprehension';

                    addQuestionRows(initialCount, normalizedType);
                }
                // Save initial layout immediately
                saveStudioDraft();
            }

            let isSubmittingPaper = false;
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('input', () => {
                    saveStudioDraft();
                });
                form.addEventListener('change', () => {
                    saveStudioDraft();
                });
                form.addEventListener('submit', (e) => {
                    if (typeof validateBulkRequiredMetadata === 'function' && !validateBulkRequiredMetadata()) {
                        e.preventDefault();
                        e.stopPropagation();
                        return false;
                    }
                    const rows = document.querySelectorAll('.question-row');

                    // Validate each question row
                    for (let i = 0; i < rows.length; i++) {
                        const row = rows[i];
                        const typeHidden = row.querySelector('input[name="qType[]"]');
                        const qType = typeHidden ? typeHidden.value : 'MCQ';

                        if (qType === 'MCQ') {
                            const optionInputs = Array.from(row.querySelectorAll('.mcq-area input[name="qOptions[]"]'));
                            const filledOptions = optionInputs.filter(input => (input.value || '').trim().length > 0);

                            if (filledOptions.length < 3) {
                                e.preventDefault();
                                e.stopPropagation();

                                const firstEmpty = optionInputs.slice(0, 3).find(input => !input.value.trim()) || optionInputs.find(input => !input.value.trim());
                                if (firstEmpty) {
                                    firstEmpty.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    firstEmpty.focus();
                                    firstEmpty.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
                                    setTimeout(() => { firstEmpty.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500'); }, 3000);
                                } else {
                                    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    row.classList.add('ring-2', 'ring-rose-500');
                                    setTimeout(() => { row.classList.remove('ring-2', 'ring-rose-500'); }, 3000);
                                }
                                return false;
                            }

                            // Verify that selected correct answer is one of the filled options
                            const correctIdxInput = row.querySelector('.mcq-area input[name="qCorrectIndex[]"]');
                            const correctIdx = correctIdxInput ? parseInt(correctIdxInput.value) : 0;
                            const selectedOptionInput = optionInputs[correctIdx];
                            if (!selectedOptionInput || !selectedOptionInput.value.trim()) {
                                e.preventDefault();
                                e.stopPropagation();

                                if (selectedOptionInput) {
                                    selectedOptionInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    selectedOptionInput.focus();
                                    selectedOptionInput.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
                                    setTimeout(() => { selectedOptionInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500'); }, 3000);
                                } else {
                                    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                }
                                return false;
                            }
                        } else if (qType === 'Comprehension') {
                            const ctx = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
                            const q1 = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
                            const textInput = row.querySelector('.standard-question-block textarea[name="qText[]"]');
                            if (textInput) {
                                textInput.value = (ctx && ctx.value.trim()) || (q1 && q1.value.trim()) || 'Comprehension Stimulus';
                            }
                        }
                    }

                    // Temporarily enable any disabled scope dropdowns so they are included in form POST
                    form.querySelectorAll('.q-chapter-select, .q-topic-select, .q-subtopic-select, select[name="chapter"], select[name="topic"], select[name="subTopic"]').forEach(s => {
                        s.disabled = false;
                    });

                    // Save latest draft state right before submission
                    saveStudioDraft();
                    isSubmittingPaper = true;
                    setTimeout(() => {
                        // Reset submitting flag if user stayed on page (e.g. form validation prevented submission)
                        isSubmittingPaper = false;
                    }, 2500);
                });
            }

            // Auto-save on page unload/blur/reload
            window.addEventListener('beforeunload', () => {
                saveStudioDraft();
            });

            // Clean draft only if submission actually succeeded and page is navigating away
            window.addEventListener('pagehide', () => {
                if (isSubmittingPaper) {
                    clearStudioDraft();
                }
            });

            // Periodic auto-save heartbeat every 10 seconds
            setInterval(saveStudioDraft, 10000);

            loadTopicsForQuestionStudio();
            const initialSubVal = document.getElementById('globalSubject')?.value || '';
            if (typeof updateMathTierUI === 'function') {
                updateMathTierUI(initialSubVal);
            }

            if (urlParams.get('tab') === 'bulk' || urlParams.get('entryMode') === 'bulk') {
                switchStudioEntryMode('bulk');
            }
        }

        // Run instantly on DOM ready without waiting for heavy external assets
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
            initQuestionStudio();
        } else {
            document.addEventListener('DOMContentLoaded', initQuestionStudio);
        }
        window.addEventListener('load', initQuestionStudio);

        function changeRowType(itemEl, type) {
            const row = itemEl.closest('.question-row');
            if (row) {
                toggleTypeUI(row, type);
                updateIndices();
                closeAllSystemDropdowns();
            }
        }
        window.changeRowType = changeRowType;

        function setComprehensionRequired(row, isRequired) {
            const ctx = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
            const q1 = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
            const a1 = row.querySelector('.comprehension-area textarea[name="qSubA1[]"]');
            const q2 = row.querySelector('.comprehension-area textarea[name="qSubQ2[]"]');
            const a2 = row.querySelector('.comprehension-area textarea[name="qSubA2[]"]');
            const q3 = row.querySelector('.comprehension-area textarea[name="qSubQ3[]"]');
            const a3 = row.querySelector('.comprehension-area textarea[name="qSubA3[]"]');
            const q4 = row.querySelector('.comprehension-area textarea[name="qSubQ4[]"]');
            const a4 = row.querySelector('.comprehension-area textarea[name="qSubA4[]"]');
            if (ctx) ctx.required = isRequired;
            if (q1) q1.required = isRequired;
            if (a1) a1.required = isRequired;
            if (q2) q2.required = isRequired;
            if (a2) a2.required = isRequired;
            if (q3) q3.required = isRequired;
            if (a3) a3.required = isRequired;
            if (q4) q4.required = isRequired;
            if (a4) a4.required = isRequired;
        }

        function toggleTypeUI(row, type, preserveCustomMarks = false, skipDraftSave = false) {
            const mcq = row.querySelector('.mcq-area');
            const answer = row.querySelector('.answer-area');
            const comp = row.querySelector('.comprehension-area');
            const stdQ = row.querySelector('.standard-question-block');
            const typeLabel = row.querySelector('.q-type-label');
            const marksInput = row.querySelector('input[name="qMarks[]"]');
            const textInput = row.querySelector('.standard-question-block textarea[name="qText[]"]');

            if (typeLabel) typeLabel.innerText = type;
            const qTypeHidden = row.querySelector('input[name="qType[]"]');
            if (qTypeHidden) qTypeHidden.value = type;

            if (!preserveCustomMarks && marksInput) {
                marksInput.value = getDefaultMarks(type);
            }

            if (type === 'MCQ') {
                if (mcq) mcq.classList.remove('hidden');
                if (answer) answer.classList.add('hidden');
                if (comp) comp.classList.add('hidden');
                if (stdQ) stdQ.classList.remove('hidden');
                if (textInput) textInput.required = true;
                setComprehensionRequired(row, false);
            } else if (type === 'Comprehension') {
                if (mcq) mcq.classList.add('hidden');
                if (answer) answer.classList.add('hidden');
                if (comp) comp.classList.remove('hidden');
                if (stdQ) stdQ.classList.add('hidden');
                if (textInput) textInput.required = false;
                setComprehensionRequired(row, true);
            } else {
                if (mcq) mcq.classList.add('hidden');
                if (answer) answer.classList.remove('hidden');
                if (comp) comp.classList.add('hidden');
                if (stdQ) stdQ.classList.remove('hidden');
                if (textInput) textInput.required = true;
                setComprehensionRequired(row, false);
            }
            if (!skipDraftSave) {
                saveStudioDraft();
            }
        }

        function setRowMcqSubtype(btn, subtype) {
            const row = btn.closest('.question-row');
            if (!row) return;
            const input = row.querySelector('.row-mcq-subtype');
            if (input) input.value = subtype;

            const btnStd = row.querySelector('.subtype-btn-standard');
            const btnMulti = row.querySelector('.subtype-btn-multiple');
            const btnCtx = row.querySelector('.subtype-btn-contextual');

            const inactiveCls = 'px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer flex items-center gap-1';
            const activeCls = 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-white dark:bg-slate-800 text-primary shadow-xs transition-all cursor-pointer flex items-center gap-1';

            if (btnStd) btnStd.className = (subtype === 'standard' ? activeCls : inactiveCls);
            if (btnMulti) btnMulti.className = (subtype === 'multiple_completion' ? activeCls : inactiveCls);
            if (btnCtx) btnCtx.className = (subtype === 'contextual' ? activeCls : inactiveCls);

            const multiBox = row.querySelector('.row-mcq-multiple-box');
            const ctxBox = row.querySelector('.row-mcq-contextual-box');
            const autoFillBtn = row.querySelector('.btn-autofill-nctb');
            const addLinkedBtn = row.querySelector('.btn-add-linked-q');
            const qTextarea = row.querySelector('.standard-question-block textarea[name="qText[]"]');

            if (subtype === 'multiple_completion') {
                if (multiBox) multiBox.classList.remove('hidden');
                if (ctxBox) ctxBox.classList.add('hidden');
                if (autoFillBtn) autoFillBtn.classList.remove('hidden');
                if (addLinkedBtn) addLinkedBtn.classList.add('hidden');
                if (qTextarea && !qTextarea.value.trim()) {
                    qTextarea.value = 'নিচের তথ্যের আলোকে কোনটি সঠিক?';
                }
            } else if (subtype === 'contextual') {
                if (multiBox) multiBox.classList.add('hidden');
                if (ctxBox) ctxBox.classList.remove('hidden');
                if (autoFillBtn) autoFillBtn.classList.add('hidden');
                if (addLinkedBtn) addLinkedBtn.classList.remove('hidden');
                const ctxIdInput = row.querySelector('.row-context-id');
                if (ctxIdInput && !ctxIdInput.value) {
                    ctxIdInput.value = 'ctx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                }
            } else {
                if (multiBox) multiBox.classList.add('hidden');
                if (ctxBox) ctxBox.classList.add('hidden');
                if (autoFillBtn) autoFillBtn.classList.add('hidden');
                if (addLinkedBtn) addLinkedBtn.classList.add('hidden');
            }
            saveStudioDraft();
        }
        window.setRowMcqSubtype = setRowMcqSubtype;

        function autoFillNctbOptions(btn) {
            const row = btn.closest('.question-row');
            if (!row) return;
            const optionInputs = row.querySelectorAll('input[name="qOptions[]"]');
            if (optionInputs.length >= 4) {
                optionInputs[0].value = 'i ও ii';
                optionInputs[1].value = 'i ও iii';
                optionInputs[2].value = 'ii ও iii';
                optionInputs[3].value = 'i, ii ও iii';
                saveStudioDraft();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'NCTB অপশন যুক্ত হয়েছে!',
                        text: 'ক: i ও ii, খ: i ও iii, গ: ii ও iii, ঘ: i, ii ও iii সেট করা হয়েছে।',
                        timer: 1400,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            }
        }
        window.autoFillNctbOptions = autoFillNctbOptions;

        function addLinkedContextualQuestion(btn) {
            const row = btn.closest('.question-row');
            if (!row) return;
            const ctxIdInput = row.querySelector('.row-context-id');
            const ctxTextarea = row.querySelector('textarea[name="qContext[]"]');
            const ctxInstInput = row.querySelector('.row-context-instruction');
            const contextId = (ctxIdInput && ctxIdInput.value) ? ctxIdInput.value : ('ctx_' + Date.now());
            if (ctxIdInput) ctxIdInput.value = contextId;
            const contextText = ctxTextarea ? ctxTextarea.value : '';
            const contextInst = ctxInstInput ? ctxInstInput.value : '';

            addQuestionRows(1, 'MCQ');

            const container = document.getElementById('questionsContainer');
            const rows = container.querySelectorAll('.question-row');
            const newRow = rows[rows.length - 1];

            if (newRow) {
                const contextualBtn = newRow.querySelector('.subtype-btn-contextual');
                if (contextualBtn) setRowMcqSubtype(contextualBtn, 'contextual');

                const newCtxIdInput = newRow.querySelector('.row-context-id');
                const newCtxTextarea = newRow.querySelector('textarea[name="qContext[]"]');
                const newCtxInstInput = newRow.querySelector('.row-context-instruction');
                if (newCtxIdInput) newCtxIdInput.value = contextId;
                if (newCtxTextarea) newCtxTextarea.value = contextText;
                if (newCtxInstInput && contextInst) newCtxInstInput.value = contextInst;

                newRow.scrollIntoView({ behavior: 'smooth', block: 'center' });

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'লিঙ্কড প্রশ্ন তৈরি হয়েছে!',
                        text: 'একই উদ্দীপকের অধীনে পরবর্তী প্রশ্নটি প্রস্তুত।',
                        timer: 1800,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            }
        }
        window.addLinkedContextualQuestion = addLinkedContextualQuestion;

        function addQuestionRows(count = null, type = null) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            if (!container || !template) return;

            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            const num = count || parseInt(document.getElementById('bulkAddCount').value) || 1;
            const qType = type || (document.getElementById('bulkAddType') ? document.getElementById('bulkAddType').value : 'MCQ');

            const defaultBoard = urlParams.get('board') || '';
            const defaultYear = urlParams.get('year') || '';
            const defaultChapter = urlParams.get('chapter') || '';
            const defaultTopic = urlParams.get('topic') || '';

            for (let i = 0; i < num; i++) {
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('.question-row');

                toggleTypeUI(row, qType, false, true);
                syncRowHierarchy(row);

                if (mode !== 'archive') {
                    const boardInput = row.querySelector('[name="qBoard[]"]');
                    if (boardInput && defaultBoard && !boardInput.value) boardInput.value = defaultBoard;

                    const yearInput = row.querySelector('[name="qYear[]"]');
                    if (yearInput && defaultYear && !yearInput.value) yearInput.value = defaultYear;
                }

                if (mode === 'archive') {
                    const indMeta = row.querySelector('.individual-meta');
                    if (indMeta) indMeta.classList.add('hidden');
                }

                if (typeof isGlobalBangla !== 'undefined' && isGlobalBangla) {
                    applyRowBanglaUI(row, true);
                } else {
                    applyRowBanglaUI(row, false);
                }

                container.appendChild(clone);
            }
            updateIndices();
            if (typeof updateMathTierUI === 'function') {
                updateMathTierUI(document.getElementById('globalSubject')?.value || '');
            }
            saveStudioDraft();
        }

        const BN_DIGITS = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
        const BN_MCQ_LETTERS = ['ক', 'খ', 'গ', 'ঘ'];
        const EN_MCQ_LETTERS = ['A', 'B', 'C', 'D'];

        function toBanglaNumber(num) {
            return String(num).replace(/[0-9]/g, d => BN_DIGITS[d]);
        }

        function applyRowBanglaUI(row, isBangla) {
            if (!row) return;
            const isBanglaHidden = row.querySelector('.row-is-bangla');
            const langBtn = row.querySelector('.row-lang-btn');
            const langText = row.querySelector('.row-lang-btn .lang-text');

            if (isBanglaHidden) isBanglaHidden.value = isBangla ? 'true' : 'false';

            if (langBtn && langText) {
                if (isBangla) {
                    langBtn.className = 'row-lang-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold transition-all border border-emerald-300 dark:border-emerald-600/60 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 cursor-pointer shadow-2xs';
                    langText.innerText = 'বাংলা (ক, খ, গ, ঘ)';
                } else {
                    langBtn.className = 'row-lang-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium transition-all border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-primary/50 cursor-pointer shadow-2xs';
                    langText.innerText = 'English (A, B, C, D)';
                }
            }

            // MCQ Area Options
            const mcqArea = row.querySelector('.mcq-area');
            if (mcqArea) {
                const optGroups = mcqArea.querySelectorAll('.grid > .group');
                optGroups.forEach((group, idx) => {
                    const badge = group.querySelector('span');
                    const inp = group.querySelector('input[name="qOptions[]"]');
                    if (badge) {
                        badge.innerText = isBangla ? (BN_MCQ_LETTERS[idx] || (idx + 1)) : (EN_MCQ_LETTERS[idx] || (idx + 1));
                    }
                    if (inp) {
                        const isRequired = idx < 3;
                        if (isBangla) {
                            inp.placeholder = isRequired ? `অপশন ${BN_MCQ_LETTERS[idx]} *` : `অপশন ${BN_MCQ_LETTERS[idx]}`;
                        } else {
                            inp.placeholder = isRequired ? `Option ${EN_MCQ_LETTERS[idx]} *` : `Option ${EN_MCQ_LETTERS[idx]}`;
                        }
                    }
                });

                // Correct answer dropdown menu options & label
                const correctMenu = mcqArea.querySelector('.row-dropdown-menu');
                const correctLabel = mcqArea.querySelector('.row-correct-label');
                const correctInp = mcqArea.querySelector('input[name="qCorrectIndex[]"]');
                const selectedIdx = correctInp ? parseInt(correctInp.value || 0) : 0;

                if (correctMenu) {
                    const menuItems = correctMenu.querySelectorAll('[data-val]');
                    menuItems.forEach((item, idx) => {
                        const span = item.querySelector('span:first-child');
                        const letter = isBangla ? BN_MCQ_LETTERS[idx] : EN_MCQ_LETTERS[idx];
                        const text = isBangla ? `অপশন ${letter}` : `Option ${letter}`;
                        if (span) span.innerText = text;
                        item.setAttribute('onclick', `selectRowOption(this, '${idx}', '${text}')`);
                    });
                }
                if (correctLabel) {
                    const letter = isBangla ? (BN_MCQ_LETTERS[selectedIdx] || selectedIdx) : (EN_MCQ_LETTERS[selectedIdx] || selectedIdx);
                    correctLabel.innerText = isBangla ? `অপশন ${letter}` : `Option ${letter}`;
                }

                // Explanation in MCQ Area
                const mcqExpInp = mcqArea.querySelector('textarea[name="qExplanation[]"]');
                const mcqExpLbl = mcqExpInp ? mcqExpInp.parentElement.querySelector('label') : null;
                if (mcqExpLbl) mcqExpLbl.innerText = isBangla ? 'ব্যাখ্যা' : 'Explanation';
                if (mcqExpInp) mcqExpInp.placeholder = isBangla ? 'ব্যাখ্যা...' : 'Explanation...';
            }

            // Short / Medium Answer Area
            const ansArea = row.querySelector('.answer-area');
            if (ansArea) {
                const ansInp = ansArea.querySelector('textarea[name="qAnswer[]"]');
                const ansLbl = ansInp ? ansInp.parentElement.querySelector('label') : null;
                const expInp = ansArea.querySelector('textarea[name="qExplanation[]"]');
                const expLbl = expInp ? expInp.parentElement.querySelector('label') : null;

                if (ansLbl) ansLbl.innerText = isBangla ? 'উত্তর' : 'Answer';
                if (ansInp) ansInp.placeholder = isBangla ? 'উত্তর...' : 'Answer...';
                if (expLbl) expLbl.innerText = isBangla ? 'ব্যাখ্যা' : 'Explanation';
                if (expInp) expInp.placeholder = isBangla ? 'ব্যাখ্যা...' : 'Explanation...';
            }

            // Comprehension Area Cards
            const compArea = row.querySelector('.comprehension-area');
            if (compArea) {
                // Card 1: Short (ক)
                const c1Title = compArea.querySelector('.comp-title-1');
                const c1Badge = compArea.querySelector('.comp-badge-1');
                const c1QLbl = compArea.querySelector('.comp-qlbl-1');
                const c1QInp = compArea.querySelector('.comp-qinp-1');
                const c1ALbl = compArea.querySelector('.comp-albl-1');
                const c1AInp = compArea.querySelector('.comp-ainp-1');
                const c1SLbl = compArea.querySelector('.comp-slbl-1');
                const c1SInp = compArea.querySelector('.comp-sinp-1');

                if (c1Badge) c1Badge.innerText = isBangla ? 'ক' : '1';
                if (c1Title) c1Title.innerText = isBangla ? 'ক ও ব্যাখ্যা' : 'Question 1 & Explanation';
                if (c1QLbl) c1QLbl.innerText = isBangla ? 'প্রশ্ন ক' : 'Question 1';
                if (c1QInp) c1QInp.placeholder = isBangla ? 'প্রশ্ন ক...' : 'Question 1...';
                if (c1ALbl) c1ALbl.innerText = isBangla ? 'ক এর উত্তর' : 'Answer 1';
                if (c1AInp) c1AInp.placeholder = isBangla ? 'ক এর উত্তর...' : 'Answer 1...';
                if (c1SLbl) c1SLbl.innerText = isBangla ? 'ক এর ব্যাখ্যা' : 'Explanation 1';
                if (c1SInp) c1SInp.placeholder = isBangla ? 'ক এর ব্যাখ্যা...' : 'Explanation 1...';

                // Card 2: (খ)
                const c2Title = compArea.querySelector('.comp-title-2');
                const c2Badge = compArea.querySelector('.comp-badge-2');
                const c2QLbl = compArea.querySelector('.comp-qlbl-2');
