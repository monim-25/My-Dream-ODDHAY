                const s2El = row.querySelector('.comprehension-area textarea[name="qSubS2[]"]');
                const q3El = row.querySelector('.comprehension-area textarea[name="qSubQ3[]"]');
                const a3El = row.querySelector('.comprehension-area textarea[name="qSubA3[]"]');
                const s3El = row.querySelector('.comprehension-area textarea[name="qSubS3[]"]');
                const q4El = row.querySelector('.comprehension-area textarea[name="qSubQ4[]"]');
                const a4El = row.querySelector('.comprehension-area textarea[name="qSubA4[]"]');
                const s4El = row.querySelector('.comprehension-area textarea[name="qSubS4[]"]');

                if (ctxEl) ctxEl.value = qData.context || '';
                if (q1El) q1El.value = qData.q1 || '';
                if (a1El) a1El.value = qData.a1 || '';
                if (s1El) s1El.value = qData.s1 || '';
                if (q2El) q2El.value = qData.q2 || '';
                if (a2El) a2El.value = qData.a2 || '';
                if (s2El) s2El.value = qData.s2 || '';
                if (q3El) q3El.value = qData.q3 || '';
                if (a3El) a3El.value = qData.a3 || '';
                if (s3El) s3El.value = qData.s3 || '';
                if (q4El) q4El.value = qData.q4 || '';
                if (a4El) a4El.value = qData.a4 || '';
                if (s4El) s4El.value = qData.s4 || '';
            } else {
                const ansText = row.querySelector('.answer-area textarea[name="qAnswer[]"]');
                if (ansText) ansText.value = qData.answer || '';
                const expText = row.querySelector('.answer-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';
            }

            const boardInput = row.querySelector('[name="qBoard[]"]');
            const yearInput = row.querySelector('[name="qYear[]"]');
            if (boardInput && qData.board) boardInput.value = qData.board;
            if (yearInput && qData.year) yearInput.value = qData.year;

            if (mode === 'archive') {
                const indMeta = row.querySelector('.individual-meta');
                if (indMeta) indMeta.classList.add('hidden');
            }

            if (qData.isBangla) {
                applyRowBanglaUI(row, true);
            } else {
