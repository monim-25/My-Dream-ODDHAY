                                            <button type="button" onclick="insertMathCode('_{1}', 'sub')" class="math-sym-btn" title="সাবস্ক্রিপ্ট ১">x₁</button>
                                            <button type="button" onclick="insertMathCode('_{2}', 'sub')" class="math-sym-btn" title="সাবস্ক্রিপ্ট ২">x₂</button>
                                        </div>
                                        <!-- Fractions, Roots & Operators -->
                                        <div class="flex items-center gap-1 pr-1.5 border-r border-violet-200 dark:border-violet-800">
                                            <button type="button" onclick="insertMathCode('\\frac{a}{b}', 'wrap')" class="math-sym-btn font-mono" title="ভগ্নাংশ (Fraction)">a/b</button>
                                            <button type="button" onclick="insertMathCode('\\sqrt{x}', 'wrap')" class="math-sym-btn" title="বর্গমূল (Square Root)">√x</button>
                                            <button type="button" onclick="insertMathCode('\\pm', 'symbol')" class="math-sym-btn" title="প্লাস-মাইনাস">±</button>
                                            <button type="button" onclick="insertMathCode('\\times', 'symbol')" class="math-sym-btn" title="গুণ">×</button>
                                            <button type="button" onclick="insertMathCode('\\div', 'symbol')" class="math-sym-btn" title="ভাগ">÷</button>
                                            <button type="button" onclick="insertMathCode('\\neq', 'symbol')" class="math-sym-btn" title="সমান নয়">≠</button>
                                            <button type="button" onclick="insertMathCode('\\le', 'symbol')" class="math-sym-btn" title="ছোট বা সমান">≤</button>
                                            <button type="button" onclick="insertMathCode('\\ge', 'symbol')" class="math-sym-btn" title="বড় বা সমান">≥</button>
                                            <button type="button" onclick="insertMathCode('\\infty', 'symbol')" class="math-sym-btn" title="অসীম (Infinity)">∞</button>
                                        </div>
                                        <!-- Geometry -->
                                        <div class="flex items-center gap-1 pr-1.5 border-r border-violet-200 dark:border-violet-800">
                                            <button type="button" onclick="insertMathCode('\\triangle ', 'symbol')" class="math-sym-btn" title="ত্রিভুজ (Triangle)">△</button>
                                            <button type="button" onclick="insertMathCode('\\angle ', 'symbol')" class="math-sym-btn" title="কোণ (Angle)">∠</button>
                                            <button type="button" onclick="insertMathCode('\\perp ', 'symbol')" class="math-sym-btn" title="লম্ব (Perpendicular)">⊥</button>
                                            <button type="button" onclick="insertMathCode('\\parallel ', 'symbol')" class="math-sym-btn" title="সমান্তরাল (Parallel)">∥</button>
                                            <button type="button" onclick="insertMathCode('^\\circ', 'symbol')" class="math-sym-btn" title="ডিগ্রি (Degree)">°</button>
                                            <button type="button" onclick="insertMathCode('\\pi', 'symbol')" class="math-sym-btn" title="পাই (Pi)">π</button>
                                        </div>
                                        <!-- Greek & Science -->
