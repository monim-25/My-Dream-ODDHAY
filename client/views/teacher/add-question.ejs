                                    #${q.isBangla ? toBanglaNumber(qIdx + 1) : (qIdx + 1)}
                                </span>
                                <span class="text-[11px] font-medium text-slate-400">MCQ</span>
                                ${q.mcqSubtype === 'multiple_completion' ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary/10 text-primary border border-primary/20">
                                        <span class="material-symbols-rounded text-[11px]">format_list_numbered</span>
                                        <span>বহুপদী</span>
                                    </span>
                                ` : (q.mcqSubtype === 'contextual' ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                                        <span class="material-symbols-rounded text-[11px]">auto_stories</span>
                                        <span>উদ্দীপকভিত্তিক</span>
                                    </span>
                                ` : '')}
                                ${q.isValid ? `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30">
                                        <span class="material-symbols-rounded text-[13px]">check_circle</span>
                                        <span>রেডি</span>
                                    </span>
                                ` : `
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/30">
                                        <span class="material-symbols-rounded text-[13px]">priority_high</span>
                                        <span>${q.correctIndex < 0 ? 'উত্তর নির্বাচন করুন' : 'অপশন অসম্পূর্ণ'}</span>
                                    </span>
                                `}
                            </div>
                            <button type="button" onclick="deleteBulkQuestion(${qIdx})" title="মুছে ফেলুন" class="size-7 rounded-md text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 flex items-center justify-center transition-all cursor-pointer">
                                <span class="material-symbols-rounded text-[17px]">delete</span>
                            </button>
                        </div>

                        ${q.context ? `
                            <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-900 dark:text-amber-200 space-y-1">
                                <div class="flex items-center justify-between text-[11px] font-semibold text-amber-700 dark:text-amber-400">
                                    <span class="flex items-center gap-1"><span class="material-symbols-rounded text-sm">auto_stories</span> উদ্দীপক</span>
                                    <span class="text-[10.5px] truncate max-w-[200px]">${escapeBulkHtml(q.contextInstruction || '')}</span>
                                </div>
                                <p class="text-xs leading-relaxed whitespace-pre-wrap">${escapeBulkHtml(q.context)}</p>
                            </div>
                        ` : ''}

                        <!-- Question Text Textarea & Live Math Preview -->
                        <div class="space-y-1.5">
                            <textarea rows="2" placeholder="প্রশ্ন..." oninput="updateBulkQText(${qIdx}, this.value); autoResizeBulkTextarea(this);"
                                class="w-full p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all leading-relaxed resize-y min-h-[50px]">${escapeBulkHtml(q.qText || '')}</textarea>
                            ${q.qText && q.qText.includes('$') ? `
                                <div class="bulk-math-preview-pill p-2 rounded-lg bg-violet-50/70 dark:bg-violet-950/30 border border-violet-200/80 dark:border-violet-800/50 text-xs text-slate-800 dark:text-slate-200 leading-relaxed overflow-x-auto">
                                    <span class="text-[10px] font-semibold text-violet-600 dark:text-violet-400 block mb-0.5">📐 সমীকরণ প্রিভিউ:</span>
                                    <div class="bulk-math-content">${escapeBulkHtml(q.qText)}</div>
                                </div>
                            ` : ''}
                        </div>

                        ${q.statements && q.statements.length > 0 ? `
                            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800 space-y-1 text-xs">
                                ${q.statements.map((st, sI) => `
                                    <div class="flex items-center gap-1.5 text-slate-700 dark:text-slate-300">
                                        <span class="px-1.5 py-0.2 rounded bg-primary/10 text-primary font-bold text-[10px]">${['i.', 'ii.', 'iii.', 'iv.'][sI] || (sI + 1) + '.'}</span>
                                        <span class="truncate">${escapeBulkHtml(st)}</span>
                                    </div>
                                `).join('')}
                                <p class="text-[10px] font-semibold text-slate-400 pt-0.5">নিচের কোনটি সঠিক?</p>
                            </div>
                        ` : ''}

                        <!-- 4 Options Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            ${[0, 1, 2, 3].map(optIdx => {
                    const isCorrect = q.correctIndex === optIdx;
                    const pillActive = isCorrect ? 'border-emerald-500 bg-emerald-50/50 dark:bg-emerald-500/10 ring-1 ring-emerald-500/40' : 'border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60';
                    const letterBadge = isCorrect ? 'bg-emerald-500 text-white font-bold' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold';

                    return `
                                    <div class="flex items-center gap-1.5 p-1 rounded-lg border ${pillActive} transition-all">
                                        <button type="button" onclick="setBulkCorrectAnswer(${qIdx}, ${optIdx})" title="সঠিক উত্তর হিসেবে চিহ্নিত করতে ক্লিক করুন"
                                            class="size-7 rounded-md ${letterBadge} flex items-center justify-center text-xs shrink-0 cursor-pointer shadow-2xs transition-transform active:scale-90">
                                            ${optLetters[optIdx]}
                                        </button>
                                        <input type="text" value="${escapeBulkHtml((q.options && q.options[optIdx]) || '')}" placeholder="অপশন ${optLetters[optIdx]}"
                                            oninput="updateBulkOption(${qIdx}, ${optIdx}, this.value)"
                                            class="flex-1 min-w-0 bg-transparent text-xs font-normal text-slate-800 dark:text-slate-200 outline-none px-1">
                                        ${isCorrect ? `<span class="material-symbols-rounded text-emerald-500 text-[16px] mr-1 shrink-0">check</span>` : ''}
                                    </div>
                                `;
                }).join('')}
                        </div>

                        <!-- Explanation Input (Expandable) -->
                        <div class="flex items-start gap-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
                            <span class="material-symbols-rounded text-slate-400 text-[16px] shrink-0 mt-1">lightbulb</span>
                            <textarea placeholder="ব্যাখ্যা (ঐচ্ছিক)..."
                                oninput="updateBulkExplanation(${qIdx}, this.value); autoResizeBulkTextarea(this);"
                                class="flex-1 bg-transparent text-xs font-normal text-slate-600 dark:text-slate-400 outline-none placeholder:text-slate-400 resize-y min-h-[34px] leading-relaxed py-1 px-1.5 rounded-md transition-colors focus:bg-slate-100/60 dark:focus:bg-slate-800/60"
                                rows="1">${escapeBulkHtml(q.explanation || '')}</textarea>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            const bulkMathToggle = document.getElementById('bulkMathPreviewToggle');
            const shouldRenderBulkMath = bulkMathToggle ? bulkMathToggle.checked : true;
            if (shouldRenderBulkMath && typeof renderMathInElement === 'function') {
                renderMathInElement(container, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false }
                    ],
                    throwOnError: false
                });
            }
        }

        function updateBulkQText(qIdx, val) {
            if (_parsedBulkQuestions[qIdx]) {
                _parsedBulkQuestions[qIdx].qText = val;
                _parsedBulkQuestions[qIdx].isValid = (_parsedBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _parsedBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _parsedBulkQuestions[qIdx].correctIndex >= 0);
                updateBulkStats();
            }
        }
        window.updateBulkQText = updateBulkQText;

        function updateBulkOption(qIdx, optIdx, val) {
            if (_parsedBulkQuestions[qIdx]) {
                _parsedBulkQuestions[qIdx].options[optIdx] = val;
                _parsedBulkQuestions[qIdx].isValid = (_parsedBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _parsedBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _parsedBulkQuestions[qIdx].correctIndex >= 0);
                updateBulkStats();
            }
        }
        window.updateBulkOption = updateBulkOption;

        function setBulkCorrectAnswer(qIdx, optIdx) {
            if (_parsedBulkQuestions[qIdx]) {
                _parsedBulkQuestions[qIdx].correctIndex = optIdx;
                _parsedBulkQuestions[qIdx].isValid = (_parsedBulkQuestions[qIdx].qText.trim().length > 0 &&
                    _parsedBulkQuestions[qIdx].options.filter(o => o.trim().length > 0).length >= 3 &&
                    _parsedBulkQuestions[qIdx].correctIndex >= 0);
                renderBulkPreviewCards();
                updateBulkStats();
            }
        }
        window.setBulkCorrectAnswer = setBulkCorrectAnswer;

        function escapeBulkHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }
        window.escapeBulkHtml = escapeBulkHtml;

        function autoResizeBulkTextarea(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.max(34, el.scrollHeight) + 'px';
        }
        window.autoResizeBulkTextarea = autoResizeBulkTextarea;

        function updateBulkExplanation(qIdx, val) {
            if (_parsedBulkQuestions[qIdx]) {
                _parsedBulkQuestions[qIdx].explanation = val;
            }
        }
        window.updateBulkExplanation = updateBulkExplanation;

        function deleteBulkQuestion(qIdx) {
            if (_parsedBulkQuestions[qIdx]) {
                _parsedBulkQuestions.splice(qIdx, 1);
                renderBulkPreviewCards();
                updateBulkStats();
            }
        }
        window.deleteBulkQuestion = deleteBulkQuestion;

        function clearBulkText() {
            const rawInput = document.getElementById('bulkRawInput');
            if (rawInput) rawInput.value = '';
            _parsedBulkQuestions = [];
            renderBulkPreviewCards();
            updateBulkStats();
        }
        window.clearBulkText = clearBulkText;

        function loadBulkDemo(lang) {
            const rawInput = document.getElementById('bulkRawInput');
            if (!rawInput) return;

            if (lang === 'bn') {
                rawInput.value = `১. [এখানে ১ম প্রশ্নের বিবরণ লিখুন]
ক) [প্রথম বিকল্প]
খ) [দ্বিতীয় বিকল্প]
গ) [তৃতীয় বিকল্প]
