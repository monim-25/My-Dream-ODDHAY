                        <textarea name="qExplanation[]" placeholder="Explanation..." class="w-full h-8 sm:h-9 py-1.5 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-700 dark:text-slate-300 outline-none focus:border-primary transition-all resize-none" rows="1"></textarea>
                    </div>
                </div>
            </div>

            <!-- Short / Medium Answer Area -->
            <div class="answer-area hidden space-y-2.5 sm:space-y-3">
                <div class="space-y-1">
                    <label class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5">Solution</label>
                    <textarea name="qAnswer[]" placeholder="Solution..." class="w-full p-2.5 sm:p-3 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-0.5">Explanation</label>
                    <textarea name="qExplanation[]" placeholder="Explanation..." class="w-full p-2.5 sm:p-3 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-700 dark:text-slate-300 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                </div>
            </div>

            <!-- Comprehension Area (Context + Two Questions, Two Answers, Two Solutions) -->
            <div class="comprehension-area hidden space-y-3 sm:space-y-3.5">
                <!-- Context / Stimulus -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="flex items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 ml-0.5">
                            <span class="material-symbols-rounded text-sm text-primary">auto_stories</span>
                            <span>Context (Passage / উদ্দীপক)</span>
                        </label>
                        <span class="text-[10px] text-slate-400 font-normal">Stimulus / reading passage</span>
                    </div>
                    <textarea name="qContext[]" placeholder="Enter passage / context here..." class="w-full p-2.5 sm:p-3 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all leading-relaxed resize-none" rows="3"></textarea>
                </div>

                <!-- Two Questions Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
                    <!-- Sub-Question 1 Card -->
                    <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 space-y-2.5">
                        <div class="flex items-center gap-1.5 pb-2 border-b border-slate-200/60 dark:border-slate-800/60">
                            <span class="size-5 rounded-md bg-primary/10 text-primary text-[11px] font-medium flex items-center justify-center">1</span>
                            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Question 1 &amp; Solution</span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Question 1</label>
                            <textarea name="qSubQ1[]" placeholder="Question 1..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Answer 1</label>
                            <textarea name="qSubA1[]" placeholder="Answer 1..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Solution 1</label>
                            <textarea name="qSubS1[]" placeholder="Solution 1..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-700 dark:text-slate-300 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>
                    </div>

                    <!-- Sub-Question 2 Card -->
                    <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 space-y-2.5">
                        <div class="flex items-center gap-1.5 pb-2 border-b border-slate-200/60 dark:border-slate-800/60">
                            <span class="size-5 rounded-md bg-primary/10 text-primary text-[11px] font-medium flex items-center justify-center">2</span>
                            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Question 2 &amp; Solution</span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Question 2</label>
                            <textarea name="qSubQ2[]" placeholder="Question 2..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Answer 2</label>
                            <textarea name="qSubA2[]" placeholder="Answer 2..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-800 dark:text-slate-200 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-medium text-slate-500 dark:text-slate-400 ml-0.5">Solution 2</label>
                            <textarea name="qSubS2[]" placeholder="Solution 2..." class="w-full p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal text-slate-700 dark:text-slate-300 outline-none focus:border-primary transition-all resize-none" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </template>

    <script>
        function getDefaultMarks(type) {
            if (type === 'Medium') return 2;
            if (type === 'Comprehension') return 10;
            return 1;
        }

        const DRAFT_KEY_BASE = 'oddhay_question_studio_draft';

        function getDraftStorageKey() {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';
            const bankId = urlParams.get('bankId') || urlParams.get('paperId') || '';
            const board = urlParams.get('board') || document.getElementById('globalBoard')?.value || '';
            const year = urlParams.get('year') || document.getElementById('globalYear')?.value || '';
            const subject = urlParams.get('subject') || document.getElementById('globalSubject')?.value || document.getElementById('hiddenSubject')?.value || '';
            const classLevel = urlParams.get('class') || document.getElementById('globalClass')?.value || document.getElementById('hiddenClass')?.value || '';

            if (bankId) {
                return `${DRAFT_KEY_BASE}_${bankId}`;
            }
            return `${DRAFT_KEY_BASE}_${mode}_${subject}_${classLevel}_${board}_${year}`.toLowerCase().replace(/\s+/g, '_');
        }

        // --- Custom In-System Dropdown Controls ---
        function toggleSystemDropdown(type, e) {
            if (e) e.stopPropagation();
            const targetMenu = document.getElementById(`dropdown-menu-${type}`);
            const parent = document.getElementById(`dropdown-${type}`);
            if (!targetMenu) return;
            const isCurrentlyHidden = targetMenu.classList.contains('hidden');

            closeAllSystemDropdowns();

            if (isCurrentlyHidden) {
                targetMenu.classList.remove('hidden');
                if (parent) {
                    const arrow = parent.querySelector('.dropdown-arrow');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }
        window.toggleSystemDropdown = toggleSystemDropdown;

        function closeAllSystemDropdowns() {
            document.querySelectorAll('.system-dropdown').forEach(d => {
                const menu = d.querySelector('[id^="dropdown-menu-"], .row-dropdown-menu');
                const arrow = d.querySelector('.dropdown-arrow');
                if (menu) menu.classList.add('hidden');
                if (arrow) arrow.style.removeProperty('transform');
            });
        }
        window.closeAllSystemDropdowns = closeAllSystemDropdowns;

        function selectSystemOption(fieldId, value, label) {
            const input = document.getElementById(fieldId);
            const labelEl = document.getElementById(`${fieldId}-label`);
            if (input) input.value = value;
            if (labelEl) labelEl.innerText = label;

            const menu = document.getElementById(`dropdown-menu-${fieldId}`);
            if (menu) {
                menu.querySelectorAll('[data-val]').forEach(opt => {
                    const isSelected = opt.getAttribute('data-val') === String(value);
                    if (isSelected) {
                        opt.className = 'px-2.5 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        if (!opt.querySelector('.check-icon')) {
                            const check = document.createElement('span');
                            check.className = 'material-symbols-rounded text-sm text-primary check-icon';
                            check.innerText = 'check';
                            opt.appendChild(check);
                        }
                    } else {
                        opt.className = 'px-2.5 py-1.5 text-xs font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        const c = opt.querySelector('.check-icon');
                        if (c) c.remove();
                    }
                });
            }

            if (fieldId === 'globalSubject' || fieldId === 'globalClass') {
                if (typeof loadTopicsForQuestionStudio === 'function') {
                    loadTopicsForQuestionStudio();
                }
            }
            closeAllSystemDropdowns();
            saveStudioDraft();
        }
        window.selectSystemOption = selectSystemOption;

        function toggleRowDropdown(btn, e) {
            if (e) e.stopPropagation();
            const parent = btn.closest('.row-dropdown');
            const menu = parent ? parent.querySelector('.row-dropdown-menu') : null;
            const arrow = btn.querySelector('.dropdown-arrow');
            if (!menu) return;

            const isHidden = menu.classList.contains('hidden');
            closeAllSystemDropdowns();

            if (isHidden) {
                menu.classList.remove('hidden');
                if (arrow) arrow.style.transform = 'rotate(180deg)';
            }
        }
        window.toggleRowDropdown = toggleRowDropdown;

        function selectRowOption(itemEl, val, label) {
            const parent = itemEl.closest('.row-dropdown');
            if (!parent) return;

            const input = parent.querySelector('.row-correct-input');
            const labelEl = parent.querySelector('.row-correct-label');
            if (input) input.value = val;
            if (labelEl) labelEl.innerText = label;

            const menu = parent.querySelector('.row-dropdown-menu');
            if (menu) {
                menu.querySelectorAll('[data-val]').forEach(opt => {
                    const isSelected = opt.getAttribute('data-val') === String(val);
                    if (isSelected) {
                        opt.className = 'px-2.5 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        if (!opt.querySelector('.check-icon')) {
                            const check = document.createElement('span');
                            check.className = 'material-symbols-rounded text-sm text-primary check-icon';
                            check.innerText = 'check';
                            opt.appendChild(check);
                        }
                    } else {
                        opt.className = 'px-2.5 py-1.5 text-xs font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                        const c = opt.querySelector('.check-icon');
                        if (c) c.remove();
                    }
                });
            }

            if (fieldId === 'globalSubject' || fieldId === 'globalClass') {
                if (typeof loadTopicsForQuestionStudio === 'function') {
                    loadTopicsForQuestionStudio();
                }
            }
            closeAllSystemDropdowns();
            saveStudioDraft();
        }
        window.selectRowOption = selectRowOption;

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.system-dropdown')) {
                closeAllSystemDropdowns();
            }
        });

        function saveStudioDraft() {
            try {
                const key = getDraftStorageKey();
                const urlParams = new URLSearchParams(window.location.search);
                const mode = urlParams.get('mode') || 'standalone';

                const draft = {
                    mode,
                    globalMeta: {},
                    questions: []
                };

                if (mode === 'archive') {
                    const boardEl = document.getElementById('globalBoard');
                    const yearEl = document.getElementById('globalYear');
                    const subjectEl = document.getElementById('globalSubject');
                    const classEl = document.getElementById('globalClass');

                    if (boardEl) draft.globalMeta.board = boardEl.value;
                    if (yearEl) draft.globalMeta.year = yearEl.value;
                    if (subjectEl) draft.globalMeta.subject = subjectEl.value;
                    if (classEl) draft.globalMeta.classLevel = classEl.value;
                }

                document.querySelectorAll('.question-row').forEach(row => {
                    const typeInput = row.querySelector('input[name="qType[]"]');
                    const textInput = row.querySelector('textarea[name="qText[]"]');
                    const marksInput = row.querySelector('input[name="qMarks[]"]');
                    const chapInput = row.querySelector('select[name="qChapter[]"], input[name="qChapter[]"]');
                    const topicInput = row.querySelector('select[name="qTopic[]"], input[name="qTopic[]"]');
                    const type = typeInput ? typeInput.value : 'MCQ';

                    const qData = {
                        type,
                        text: textInput ? textInput.value : '',
                        marks: marksInput ? marksInput.value : getDefaultMarks(type),
                        chapter: chapInput ? chapInput.value : '',
                        topic: topicInput ? topicInput.value : '',
                        options: [],
                        correctIndex: 0,
                        answer: '',
                        explanation: '',
                        context: '',
                        q1: '',
                        a1: '',
                        s1: '',
                        q2: '',
                        a2: '',
                        s2: '',
                        board: '',
                        year: ''
                    };

                    if (type === 'MCQ') {
                        const optInputs = row.querySelectorAll('.mcq-area input[name="qOptions[]"]');
                        optInputs.forEach(opt => qData.options.push(opt.value));
                        const correctInput = row.querySelector('.mcq-area input[name="qCorrectIndex[]"]');
                        if (correctInput) qData.correctIndex = correctInput.value;
                        const expText = row.querySelector('.mcq-area textarea[name="qExplanation[]"]');
                        if (expText) qData.explanation = expText.value;
                    } else if (type === 'Comprehension') {
                        const ctxEl = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
                        const q1El = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
                        const a1El = row.querySelector('.comprehension-area textarea[name="qSubA1[]"]');
                        const s1El = row.querySelector('.comprehension-area textarea[name="qSubS1[]"]');
                        const q2El = row.querySelector('.comprehension-area textarea[name="qSubQ2[]"]');
                        const a2El = row.querySelector('.comprehension-area textarea[name="qSubA2[]"]');
                        const s2El = row.querySelector('.comprehension-area textarea[name="qSubS2[]"]');

                        if (ctxEl) qData.context = ctxEl.value;
                        if (q1El) qData.q1 = q1El.value;
                        if (a1El) qData.a1 = a1El.value;
                        if (s1El) qData.s1 = s1El.value;
                        if (q2El) qData.q2 = q2El.value;
                        if (a2El) qData.a2 = a2El.value;
                        if (s2El) qData.s2 = s2El.value;
                    } else {
                        const ansText = row.querySelector('.answer-area textarea[name="qAnswer[]"]');
                        if (ansText) qData.answer = ansText.value;
                        const expText = row.querySelector('.answer-area textarea[name="qExplanation[]"]');
                        if (expText) qData.explanation = expText.value;
                    }

                    const boardInput = row.querySelector('input[name="qBoard[]"]');
                    const yearInput = row.querySelector('input[name="qYear[]"]');
                    if (boardInput) qData.board = boardInput.value;
                    if (yearInput) qData.year = yearInput.value;

                    draft.questions.push(qData);
                });

                if (draft.questions.length > 0) {
                    localStorage.setItem(key, JSON.stringify(draft));
                    const badge = document.getElementById('draftStatusBadge');
                    const statusText = document.getElementById('draftStatusText');
                    if (badge) {
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                        if (statusText) {
                            const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                            statusText.innerText = `Autosaved (${nowStr})`;
                        }
                    }
                }
            } catch (err) {
                console.error('Failed to save draft:', err);
            }
        }

        function restoreStudioDraft() {
            try {
                const key = getDraftStorageKey();
                const rawData = localStorage.getItem(key);
                if (!rawData) return false;

                const draft = JSON.parse(rawData);
                if (!draft || !draft.questions || draft.questions.length === 0) return false;

                if (draft.globalMeta) {
                    if (draft.globalMeta.board && document.getElementById('globalBoard')) document.getElementById('globalBoard').value = draft.globalMeta.board;
                    if (draft.globalMeta.year && document.getElementById('globalYear')) document.getElementById('globalYear').value = draft.globalMeta.year;
                    if (draft.globalMeta.subject) selectSystemOption('globalSubject', draft.globalMeta.subject, draft.globalMeta.subject);
                    if (draft.globalMeta.classLevel) {
                        const cl = draft.globalMeta.classLevel;
                        const classVal = String(cl).replace(/^Class\s+/i, '');
                        const classLabel = String(cl).startsWith('Class') ? cl : `Class ${cl}`;
                        selectSystemOption('globalClass', classVal, classLabel);
                    }
                }

                const container = document.getElementById('questionsContainer');
                if (container) container.innerHTML = '';

                draft.questions.forEach(qData => {
                    addSingleQuestionFromDraft(qData);
                });

                updateIndices();
                const badge = document.getElementById('draftStatusBadge');
                const statusText = document.getElementById('draftStatusText');
                if (badge) {
                    badge.classList.remove('hidden');
                    badge.classList.add('flex');
                    if (statusText) statusText.innerText = 'Draft restored from autosave';
                }
                return true;
            } catch (err) {
                console.error('Failed to restore draft:', err);
                return false;
            }
        }

        function addSingleQuestionFromDraft(qData) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            if (!container || !template) return;

            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'standalone';

            const clone = template.content.cloneNode(true);
            const row = clone.querySelector('.question-row');

            toggleTypeUI(row, qData.type, true);

            const textInput = row.querySelector('textarea[name="qText[]"]');
            if (textInput) textInput.value = qData.text || '';

            const marksInput = row.querySelector('input[name="qMarks[]"]');
            if (marksInput) marksInput.value = qData.marks || getDefaultMarks(qData.type);

            const chapSelect = row.querySelector('.q-chapter-select');
            const targetChap = qData.chapter || '';
            if (chapSelect) {
                chapSelect.setAttribute('data-prefill', targetChap);
                if (typeof buildChapterOptionsHTML === 'function') {
                    chapSelect.innerHTML = buildChapterOptionsHTML(targetChap);
                }
                if (targetChap) chapSelect.value = targetChap;
            }

            const topicSelect = row.querySelector('.q-topic-select');
            if (topicSelect) {
                const targetTopic = qData.topic || '';
                topicSelect.setAttribute('data-prefill', targetTopic);
                if (targetChap) {
                    topicSelect.disabled = false;
                    topicSelect.classList.remove('opacity-50', 'cursor-not-allowed');
                    if (typeof buildTopicOptionsHTML === 'function') {
                        topicSelect.innerHTML = buildTopicOptionsHTML(targetTopic, targetChap);
                    }
                    if (targetTopic) topicSelect.value = targetTopic;
                } else {
                    topicSelect.disabled = true;
                    topicSelect.classList.add('opacity-50', 'cursor-not-allowed');
                    topicSelect.innerHTML = '<option value="">Select Chapter First</option>';
                    topicSelect.value = '';
                }
            }

            if (qData.type === 'MCQ') {
                const optInputs = row.querySelectorAll('.mcq-area input[name="qOptions[]"]');
                (qData.options || []).forEach((optVal, idx) => {
                    if (optInputs[idx]) optInputs[idx].value = optVal || '';
                });
                
                const cVal = qData.correctIndex || '0';
                const correctInput = row.querySelector('.mcq-area input[name="qCorrectIndex[]"]');
                const labelEl = row.querySelector('.row-correct-label');
                if (correctInput) correctInput.value = cVal;
                if (labelEl) labelEl.innerText = `Option ${String.fromCharCode(65 + parseInt(cVal || 0))}`;

                const menu = row.querySelector('.row-dropdown-menu');
                if (menu) {
                    menu.querySelectorAll('[data-val]').forEach(opt => {
                        const isSelected = opt.getAttribute('data-val') === String(cVal);
                        if (isSelected) {
                            opt.className = 'px-2.5 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                            if (!opt.querySelector('.check-icon')) {
                                const check = document.createElement('span');
                                check.className = 'material-symbols-rounded text-sm text-primary check-icon';
                                check.innerText = 'check';
                                opt.appendChild(check);
                            }
                        } else {
                            opt.className = 'px-2.5 py-1.5 text-xs font-normal text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors';
                            const c = opt.querySelector('.check-icon');
                            if (c) c.remove();
                        }
                    });
                }

                const expText = row.querySelector('.mcq-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';
            } else if (qData.type === 'Comprehension') {
                const ctxEl = row.querySelector('.comprehension-area textarea[name="qContext[]"]');
                const q1El = row.querySelector('.comprehension-area textarea[name="qSubQ1[]"]');
                const a1El = row.querySelector('.comprehension-area textarea[name="qSubA1[]"]');
                const s1El = row.querySelector('.comprehension-area textarea[name="qSubS1[]"]');
                const q2El = row.querySelector('.comprehension-area textarea[name="qSubQ2[]"]');
                const a2El = row.querySelector('.comprehension-area textarea[name="qSubA2[]"]');
                const s2El = row.querySelector('.comprehension-area textarea[name="qSubS2[]"]');

                if (ctxEl) ctxEl.value = qData.context || '';
                if (q1El) q1El.value = qData.q1 || '';
                if (a1El) a1El.value = qData.a1 || '';
                if (s1El) s1El.value = qData.s1 || '';
                if (q2El) q2El.value = qData.q2 || '';
                if (a2El) a2El.value = qData.a2 || '';
                if (s2El) s2El.value = qData.s2 || '';
            } else {
                const ansText = row.querySelector('.answer-area textarea[name="qAnswer[]"]');
                if (ansText) ansText.value = qData.answer || '';
                const expText = row.querySelector('.answer-area textarea[name="qExplanation[]"]');
                if (expText) expText.value = qData.explanation || '';
            }

            const boardInput = row.querySelector('input[name="qBoard[]"]');
            const yearInput = row.querySelector('input[name="qYear[]"]');
            if (boardInput && qData.board) boardInput.value = qData.board;
            if (yearInput && qData.year) yearInput.value = qData.year;

            if (mode === 'archive') {
                const indMeta = row.querySelector('.individual-meta');
                if (indMeta) indMeta.classList.add('hidden');
            }

            container.appendChild(clone);
        }

