A. [Option A]
B. [Option B]
C. [Option C]
D. [Option D]
Correct Answer: B`;
            }

            onBulkInputChanged();
        }
        window.loadBulkDemo = loadBulkDemo;

        function validateBulkRequiredMetadata() {
            const urlParams = new URLSearchParams(window.location.search);
            const isArchive = '<%= mode %>' === 'archive' || urlParams.get('mode') === 'archive';

            const board = (document.getElementById('globalBoard')?.value || document.getElementById('hiddenBoard')?.value || urlParams.get('board') || '').trim();
            const year = (document.getElementById('globalYear')?.value || document.getElementById('hiddenYear')?.value || urlParams.get('year') || '').trim();
            const subject = (document.getElementById('globalSubject')?.value || document.getElementById('hiddenSubject')?.value || urlParams.get('subject') || '').trim();
            const classLevel = (document.getElementById('globalClass')?.value || document.getElementById('hiddenClass')?.value || urlParams.get('class') || '').trim();

            if (isArchive) {
                const missing = [];
                if (!board) missing.push('বোর্ড (Board)');
                if (!year) missing.push('সাল (Year)');
                if (!classLevel) missing.push('শ্রেণি (Class)');
                if (!subject) missing.push('বিষয় (Subject)');

                if (missing.length > 0) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'প্রয়োজনীয় তথ্য বাকি রয়েছে',
                            html: `প্রশ্ন সেভ করার আগে অনুগ্রহ করে নিচের তথ্যগুলো পূরণ করুন:<br><b>${missing.join(', ')}</b>`,
                            confirmButtonColor: '#4f46e5'
                        });
                    } else {
                        alert('অনুগ্রহ করে পূরণ করুন: ' + missing.join(', '));
                    }
                    if (typeof togglePaperDetailsMobile === 'function') togglePaperDetailsMobile(true);
                    const header = document.getElementById('archiveGlobalHeader') || document.getElementById('globalBoard');
                    if (header) header.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return false;
                }
            } else {
                const missing = [];
                if (!classLevel) missing.push('শ্রেণি (Class)');
                if (!subject) missing.push('বিষয় (Subject)');

                if (missing.length > 0) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'শ্রেণি ও বিষয় নির্বাচন আবশ্যক',
                            text: 'প্রশ্ন সেভ করার জন্য শ্রেণি ও বিষয় আবশ্যক। প্রশ্ন ব্যাংক পেজ থেকে শ্রেণি ও বিষয় নির্ধারণ করে আসুন।',
                            showCancelButton: true,
                            confirmButtonText: 'প্রশ্ন পেজে যান',
                            cancelButtonText: 'এখানেই থাকুন',
                            confirmButtonColor: '#4f46e5'
                        }).then((res) => {
                            if (res.isConfirmed) {
                                window.location.href = '/teacher/questions';
                            }
                        });
                    } else {
                        alert('অনুগ্রহ করে শ্রেণি ও বিষয় নির্বাচন করুন।');
                    }
                    return false;
                }
            }
            return true;
        }
        window.validateBulkRequiredMetadata = validateBulkRequiredMetadata;

        function transferBulkToStudio(isSilent = false) {
            if (!isSilent && !validateBulkRequiredMetadata()) {
                return false;
            }
            if (_parsedBulkQuestions.length === 0) {
                if (!isSilent) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'কোনো প্রশ্ন পাওয়া যায়নি',
                            text: 'দয়া করে বামপাশের বক্সে প্রশ্ন পেস্ট করুন।',
                            confirmButtonColor: '#4f46e5'
                        });
                    } else {
                        alert('দয়া করে বামপাশের বক্সে প্রশ্ন পেস্ট করুন।');
                    }
                }
                return false;
            }

            const invalidQuestions = _parsedBulkQuestions.filter(q => !q.isValid);
            if (invalidQuestions.length > 0 && !isSilent) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'কিছু প্রশ্নে সতর্কতা রয়েছে',
                        text: `${invalidQuestions.length}টি প্রশ্নে সঠিক উত্তর চিহ্নিত করা নেই বা অপশন অসম্পূর্ণ। তবুও কি স্টুডিওতে এডিট করতে চান?`,
                        showCancelButton: true,
                        confirmButtonText: 'হ্যাঁ, স্টুডিওতে যান',
                        cancelButtonText: 'বাতিল',
                        confirmButtonColor: '#4f46e5'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            executeTransferToStudio();
                        }
                    });
                    return false;
                }
            }

            return executeTransferToStudio(isSilent);
        }
        window.transferBulkToStudio = transferBulkToStudio;

        function executeTransferToStudio(isSilent = false) {
            const container = document.getElementById('questionsContainer');
            const template = document.getElementById('questionTemplate');
            if (!container || !template) return false;

            // Clear existing rows
            container.innerHTML = '';

            const urlParams = new URLSearchParams(window.location.search);
            const defaultBoard = urlParams.get('board') || '';
            const defaultYear = urlParams.get('year') || '';

            _parsedBulkQuestions.forEach((q, idx) => {
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('.question-row');

                toggleTypeUI(row, 'MCQ', false, true);
                syncRowHierarchy(row);

                // Set board & year
                const boardInput = row.querySelector('[name="qBoard[]"]');
                if (boardInput && defaultBoard && !boardInput.value) boardInput.value = defaultBoard;

                const yearInput = row.querySelector('[name="qYear[]"]');
                if (yearInput && defaultYear && !yearInput.value) yearInput.value = defaultYear;

                // Set Question Text
                const qTextarea = row.querySelector('textarea[name="qText[]"]');
                if (qTextarea) qTextarea.value = q.qText || '';

                // Set 4 Options
                const optInputs = row.querySelectorAll('input[name="qOptions[]"]');
                (q.options || []).forEach((opt, optIdx) => {
                    if (optInputs[optIdx]) optInputs[optIdx].value = opt || '';
                });

                // Set Correct Answer
                if (q.correctIndex >= 0) {
                    const correctInp = row.querySelector('.row-correct-input');
                    if (correctInp) correctInp.value = q.correctIndex;

                    const correctLabel = row.querySelector('.row-correct-label');
                    if (correctLabel) {
                        const labels = q.isBangla ? ['Option A (ক)', 'Option B (খ)', 'Option C (গ)', 'Option D (ঘ)'] : ['Option A', 'Option B', 'Option C', 'Option D'];
                        correctLabel.innerText = labels[q.correctIndex] || `Option ${q.correctIndex + 1}`;
                    }
                }

                // Set Explanation
                const expTextarea = row.querySelector('textarea[name="qExplanation[]"]');
                if (expTextarea && q.explanation) {
                    expTextarea.value = q.explanation;
                }

                // Set Language UI
                applyRowBanglaUI(row, q.isBangla);

                // Transfer MCQ Subtype & Statements / Context
                if (q.mcqSubtype === 'multiple_completion' && q.statements && q.statements.length > 0) {
                    const multiBtn = row.querySelector('.subtype-btn-multiple');
                    if (multiBtn) setRowMcqSubtype(multiBtn, 'multiple_completion');
                    const stmtInputs = [
                        row.querySelector('input[name="qStatement1[]"]'),
                        row.querySelector('input[name="qStatement2[]"]'),
                        row.querySelector('input[name="qStatement3[]"]')
                    ];
                    q.statements.forEach((st, sIdx) => {
                        if (stmtInputs[sIdx]) stmtInputs[sIdx].value = st;
                    });
                } else if (q.mcqSubtype === 'contextual' || q.context) {
                    const ctxBtn = row.querySelector('.subtype-btn-contextual');
                    if (ctxBtn) setRowMcqSubtype(ctxBtn, 'contextual');
                    const ctxTextarea = row.querySelector('textarea[name="qContext[]"]');
                    if (ctxTextarea && q.context) ctxTextarea.value = q.context;
                    const ctxInstInput = row.querySelector('.row-context-instruction');
                    if (ctxInstInput && q.contextInstruction) ctxInstInput.value = q.contextInstruction;
                    const ctxIdInput = row.querySelector('.row-context-id');
                    if (ctxIdInput && q.contextId) ctxIdInput.value = q.contextId;
                }

                container.appendChild(clone);
            });

            updateIndices();
            if (typeof updateMathTierUI === 'function') {
                updateMathTierUI(document.getElementById('globalSubject')?.value || '');
            }
            saveStudioDraft();

            if (!isSilent) {
                switchStudioEntryMode('studio');

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'স্টুডিও প্রস্তুত!',
                        text: `${_parsedBulkQuestions.length}টি প্রশ্ন স্টুডিওতে লোড করা হয়েছে।`,
                        timer: 2000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            }

            return true;
        }

        function submitBulkDirectly() {
            if (!validateBulkRequiredMetadata()) {
                return;
            }
            if (_parsedBulkQuestions.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'কোনো প্রশ্ন পাওয়া যায়নি',
                        text: 'দয়া করে প্রথমে প্রশ্ন পেস্ট করুন।',
                        confirmButtonColor: '#4f46e5'
                    });
                } else {
                    alert('দয়া করে প্রথমে প্রশ্ন পেস্ট করুন।');
                }
                return;
            }

            const invalidIdx = _parsedBulkQuestions.findIndex(q => !q.isValid);
            if (invalidIdx !== -1) {
                const invalidCard = document.querySelector(`.bulk-q-card[data-qidx="${invalidIdx}"]`);
                if (invalidCard) {
                    invalidCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    invalidCard.classList.add('ring-2', 'ring-rose-500');
                    setTimeout(() => invalidCard.classList.remove('ring-2', 'ring-rose-500'), 2500);
                }

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'অসম্পূর্ণ প্রশ্ন রয়েছে',
                        text: `প্রশ্ন #${invalidIdx + 1}-এ সঠিক উত্তর চিহ্নিত করা নেই বা অপশন অসম্পূর্ণ। অনুগ্রহ করে উত্তর চিহ্নিত করুন।`,
                        confirmButtonColor: '#4f46e5'
                    });
                } else {
                    alert(`প্রশ্ন #${invalidIdx + 1}-এ সঠিক উত্তর চিহ্নিত করা নেই।`);
                }
                return;
            }

            // Execute transfer to form hidden inputs/rows silently and submit
            const transferred = executeTransferToStudio(true);
            if (transferred) {
                const form = document.querySelector('form');
                if (form) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'সংরক্ষণ করা হচ্ছে...',
                            text: `${_parsedBulkQuestions.length}টি প্রশ্ন ডাটাবেজে সেভ হচ্ছে।`,
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });
                    }
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                }
            }
        }
        window.submitBulkDirectly = submitBulkDirectly;

        // --- Studio Image Upload & Clipboard Paste Handlers ---
        function triggerStudioImageUpload(btn) {
            const slot = btn.closest('.image-uploader-slot');
            if (!slot) return;
            const fileInput = slot.querySelector('.image-file-input');
            if (fileInput) fileInput.click();
        }
        window.triggerStudioImageUpload = triggerStudioImageUpload;

        async function handleStudioImageUpload(fileInput) {
            const file = fileInput.files && fileInput.files[0];
            if (!file) return;

            const slot = fileInput.closest('.image-uploader-slot');
            if (!slot) return;

            const btn = slot.querySelector('.btn-trigger-upload');
            const badge = slot.querySelector('.image-preview-badge');
            const previewLink = slot.querySelector('.preview-img-link');
            const urlInput = slot.querySelector('.image-url-input');

            const origBtnHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = `<span class="text-xs">⏳</span> <span class="text-[10px]">আপলোড হচ্ছে...</span>`;
                btn.disabled = true;
            }

            const formData = new FormData();
            formData.append('image', file);

            try {
                const res = await fetch('/teacher/upload-question-image', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data && (data.fileUrl || data.url)) {
                    const finalUrl = data.fileUrl || data.url;
                    if (urlInput) urlInput.value = finalUrl;
                    if (previewLink) {
                        previewLink.href = finalUrl;
                    }
                    if (btn) btn.classList.add('hidden');
                    if (badge) {
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    }
                    // Show inline preview thumbnail in place
                    const inlinePreview = slot.closest('.space-y-1, .standard-question-block')?.querySelector('.studio-inline-img-preview');
                    if (inlinePreview) {
                        const pImg = inlinePreview.querySelector('img');
                        if (pImg) pImg.src = finalUrl;
                        inlinePreview.classList.remove('hidden');
                        inlinePreview.classList.add('flex');
                        const posSelect = slot.querySelector('.img-pos-selector select');
                        if (posSelect) updateStudioQuestionImageLayout(posSelect);
                    }
                } else {
                    alert('Image upload failed: ' + (data.error || 'Server error'));
                    if (btn) {
                        btn.innerHTML = origBtnHtml;
                        btn.disabled = false;
                    }
                }
            } catch (err) {
                console.error('Image upload error:', err);
                alert('Image upload failed. Please try again.');
                if (btn) {
                    btn.innerHTML = origBtnHtml;
                    btn.disabled = false;
                }
            } finally {
                fileInput.value = '';
            }
        }
        window.handleStudioImageUpload = handleStudioImageUpload;

        function updateStudioQuestionImageLayout(selectEl) {
            const block = selectEl.closest('.standard-question-block');
            if (!block) return;
            const pos = selectEl.value || 'above';
            const hiddenPos = block.querySelector('.image-pos-input');
            if (hiddenPos) hiddenPos.value = pos;

            const box = block.querySelector('.studio-question-interactive-box');
            const preview = block.querySelector('.studio-inline-img-preview');
            const textWrap = block.querySelector('.studio-text-wrap') || block.querySelector('textarea[name="qText[]"]');
            if (!box || !preview || !textWrap) return;

            if (pos === 'above') {
                box.className = 'studio-question-interactive-box flex flex-col gap-2 items-start mt-1 w-full';
                box.insertBefore(preview, textWrap);
            } else if (pos === 'below') {
                box.className = 'studio-question-interactive-box flex flex-col gap-2 items-start mt-1 w-full';
                box.appendChild(preview);
            } else if (pos === 'left') {
                box.className = 'studio-question-interactive-box flex flex-col sm:flex-row gap-3 items-start mt-1 w-full';
                box.insertBefore(preview, textWrap);
            } else if (pos === 'right') {
                box.className = 'studio-question-interactive-box flex flex-col sm:flex-row-reverse gap-3 items-start justify-between mt-1 w-full';
                box.insertBefore(preview, textWrap);
            }
        }
        window.updateStudioQuestionImageLayout = updateStudioQuestionImageLayout;

        function removeStudioImage(btn) {
            const slot = btn.closest('.image-uploader-slot');
            if (!slot) return;
            const urlInput = slot.querySelector('.image-url-input');
            const triggerBtn = slot.querySelector('.btn-trigger-upload');
            const badge = slot.querySelector('.image-preview-badge');
            if (urlInput) urlInput.value = '';
            if (badge) {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            }
            if (triggerBtn) {
                triggerBtn.classList.remove('hidden');
                triggerBtn.disabled = false;
                triggerBtn.innerHTML = `<span class="material-symbols-rounded text-sm">add_photo_alternate</span> <span>চিত্র যুক্ত করুন</span>`;
            }
            const inlinePreview = slot.closest('.space-y-1, .standard-question-block')?.querySelector('.studio-inline-img-preview');
            if (inlinePreview) {
                inlinePreview.classList.add('hidden');
                inlinePreview.classList.remove('flex');
                const pImg = inlinePreview.querySelector('img');
                if (pImg) pImg.src = '';
            }
        }
        window.removeStudioImage = removeStudioImage;

        function openStudioLightbox(el) {
            let src = '';
            if (el.tagName === 'IMG') {
                src = el.src;
            } else {
                const slot = el.closest('.image-uploader-slot') || el.closest('.standard-question-block')?.querySelector('.image-uploader-slot');
                src = slot?.querySelector('.image-url-input')?.value || '';
            }
            if (!src) return;
            const m = document.getElementById('studioImageLightbox');
            const img = document.getElementById('studioLightboxImg');
            if (m && img) {
                img.src = src;
                m.classList.remove('hidden');
            }
        }
        window.openStudioLightbox = openStudioLightbox;

        function closeStudioLightbox() {
            const m = document.getElementById('studioImageLightbox');
            if (m) m.classList.add('hidden');
        }
        window.closeStudioLightbox = closeStudioLightbox;

        // Clipboard Paste Listener for Image Upload (Ctrl+V)
        document.addEventListener('paste', async (e) => {
            const target = e.target;
            if (!target || !target.matches('textarea[name="qText[]"], textarea[name="qContext[]"], textarea[name="qExplanation[]"]')) return;
            const items = (e.clipboardData || e.originalEvent.clipboardData)?.items;
            if (!items) return;
            for (let i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    const blob = items[i].getAsFile();
                    if (!blob) continue;
                    e.preventDefault();
                    const container = target.closest('.standard-question-block, .row-mcq-contextual-box, .comprehension-area, .space-y-1');
                    const slot = container ? container.querySelector('.image-uploader-slot') : null;
                    if (slot) {
                        const fileInput = slot.querySelector('.image-file-input');
                        if (fileInput) {
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(blob);
                            fileInput.files = dataTransfer.files;
                            handleStudioImageUpload(fileInput);
                        }
                    }
                    break;
                }
            }
        });
    </script>

    <!-- Studio In-Page Image Lightbox Modal -->
    <div id="studioImageLightbox" class="fixed inset-0 z-[9999] hidden bg-black/80 backdrop-blur-xs flex items-center justify-center p-4 cursor-zoom-out" onclick="closeStudioLightbox()">
        <div class="relative max-w-4xl max-h-[90vh] flex items-center justify-center" onclick="event.stopPropagation()">
            <img id="studioLightboxImg" src="" class="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl bg-white/5 border border-white/10" alt="Enlarged Diagram">
            <button type="button" onclick="closeStudioLightbox()" class="absolute -top-3 -right-3 size-8 rounded-full bg-slate-900/90 hover:bg-rose-600 text-white flex items-center justify-center text-sm shadow-lg transition-all cursor-pointer border border-white/20">✕</button>
        </div>
    </div>
</body>

</html>