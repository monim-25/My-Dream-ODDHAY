                                    <span class="text-slate-400 font-normal">Grand Total:</span>
                                    <span id="footerGrandPreview" class="font-semibold text-emerald-600 dark:text-emerald-400">0</span>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" id="saveBtn" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs sm:text-sm transition-all shadow-xs active:scale-95">
                                <span class="material-symbols-rounded text-base leading-none">check_circle</span>
                                <span>Save & Release Evaluation</span>
                            </button>

                        </div>
                    </div>

                </form>

            </div>
        </main>
    </div>

    <!-- SCRIPT FOR DYNAMIC SCORE CALCULATION -->
    <script>
        const mcqScore = <%= mcqEarned %>;
        const totalMaxMarks = <%= questions.reduce((sum, q) => sum + (q.maxMarks || 1), 0) %>;

        function updateScoreTotals() {
            let total = 0;
            const inputs = document.querySelectorAll('.score-input');
            inputs.forEach(input => {
                const val = parseFloat(input.value);
                const max = parseFloat(input.getAttribute('data-max')) || 0;
                if (!isNaN(val)) {
                    // Clamp
                    if (val < 0) input.value = 0;
                    if (val > max) input.value = max;
                    total += parseFloat(input.value);
                }
            });

            // Round to 1 decimal
            const rounded = Math.round(total * 10) / 10;
            const writtenDisplay = rounded + ' / ' + totalMaxMarks;
            const grandTotal = Math.round((mcqScore + rounded) * 10) / 10;

            const headerElem = document.getElementById('headerScorePreview');
            if (headerElem) headerElem.innerText = writtenDisplay;

            const footerWritten = document.getElementById('footerWrittenPreview');
            if (footerWritten) footerWritten.innerText = writtenDisplay;

            const footerGrand = document.getElementById('footerGrandPreview');
            if (footerGrand) footerGrand.innerText = grandTotal;
        }

        function setQuickScore(key, score) {
            const input = document.getElementById(`marks_${key}`) || 
                          document.querySelector(`input[name="marks_${key}"]`) ||
                          document.querySelector(`input[name="${key}"]`);
            if (input) {
                input.value = score;
                updateScoreTotals();
            }
        }

        // Image upload preview and removal handlers
        function handleTeacherImageUpload(fileInput, key) {
            if (fileInput.files && fileInput.files[0]) {
                const file = fileInput.files[0];
                if (file.size > 10 * 1024 * 1024) {
                    alert('Image size exceeds 10MB limit. Please choose a smaller file.');
                    fileInput.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    const hiddenInput = document.getElementById('hidden_image_' + key);
                    const previewImg = document.getElementById('image_preview_' + key);
                    const previewLink = document.getElementById('image_link_' + key);
                    const previewWrap = document.getElementById('image_preview_wrap_' + key);

                    if (hiddenInput) hiddenInput.value = dataUrl;
                    if (previewImg) previewImg.src = dataUrl;
                    if (previewLink) previewLink.href = dataUrl;
                    if (previewWrap) previewWrap.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function removeTeacherImage(key) {
            const fileInput = document.getElementById('file_input_' + key);
            const hiddenInput = document.getElementById('hidden_image_' + key);
            const previewWrap = document.getElementById('image_preview_wrap_' + key);
            const previewImg = document.getElementById('image_preview_' + key);
            const previewLink = document.getElementById('image_link_' + key);

            if (fileInput) fileInput.value = '';
            if (hiddenInput) hiddenInput.value = '';
            if (previewImg) previewImg.src = '';
            if (previewLink) previewLink.href = '#';
            if (previewWrap) previewWrap.classList.add('hidden');
        }

        function handleOverallImageUpload(fileInput) {
            if (fileInput.files && fileInput.files[0]) {
                const file = fileInput.files[0];
                if (file.size > 10 * 1024 * 1024) {
                    alert('Image size exceeds 10MB limit. Please choose a smaller file.');
                    fileInput.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    const hiddenInput = document.getElementById('hidden_overall_image');
                    const previewImg = document.getElementById('overall_image_preview');
                    const previewLink = document.getElementById('overall_image_link');
                    const previewWrap = document.getElementById('overall_image_preview_wrap');

                    if (hiddenInput) hiddenInput.value = dataUrl;
                    if (previewImg) previewImg.src = dataUrl;
                    if (previewLink) previewLink.href = dataUrl;
                    if (previewWrap) previewWrap.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function removeOverallTeacherImage() {
            const fileInput = document.getElementById('overall_file_input');
            const hiddenInput = document.getElementById('hidden_overall_image');
            const previewWrap = document.getElementById('overall_image_preview_wrap');
            const previewImg = document.getElementById('overall_image_preview');
            const previewLink = document.getElementById('overall_image_link');

            if (fileInput) fileInput.value = '';
            if (hiddenInput) hiddenInput.value = '';
            if (previewImg) previewImg.src = '';
            if (previewLink) previewLink.href = '#';
            if (previewWrap) previewWrap.classList.add('hidden');
        }

        // Listen for input changes
        document.querySelectorAll('.score-input').forEach(input => {
            input.addEventListener('input', updateScoreTotals);
            input.addEventListener('change', updateScoreTotals);
        });

        // Initialize on page load
        updateScoreTotals();

        // Form submission security: ONLY submit when user explicitly clicks the Save button
        const evalForm = document.getElementById('evaluationForm');
        const saveBtn = document.getElementById('saveBtn');
        let isExplicitSaveClicked = false;

        // Block Enter key from submitting form from score inputs or other controls
        evalForm.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                if (e.target && e.target.tagName && e.target.tagName.toLowerCase() === 'textarea') {
                    // Allow normal line breaks in textareas
                    return;
                }
                e.preventDefault();
                return false;
            }
        });

        if (saveBtn) {
            saveBtn.addEventListener('click', function() {
                isExplicitSaveClicked = true;
            });
        }

        evalForm.addEventListener('submit', function(e) {
            if (!isExplicitSaveClicked) {
                e.preventDefault();
                return false;
            }
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="material-symbols-rounded text-base animate-spin">progress_activity</span><span>Saving Evaluation...</span>';
            }
        });

        // Fullscreen student attachment lightbox
        function openFullscreenEvaluationImage(src) {
            const modal = document.getElementById('evalImgModal');
            const img = document.getElementById('evalModalImg');
            if (!modal || !img) return;
            img.src = src;
            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                modal.classList.remove('opacity-0');
            });
            document.body.style.overflow = 'hidden';
        }

        function closeFullscreenEvaluationImage() {
            const modal = document.getElementById('evalImgModal');
            if (!modal) return;
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }, 200);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeFullscreenEvaluationImage();
        });
    </script>

    <!-- FULLSCREEN EVALUATION IMAGE MODAL -->
    <div id="evalImgModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4" onclick="closeFullscreenEvaluationImage()">
        <button type="button" onclick="closeFullscreenEvaluationImage()" class="absolute top-4 right-4 size-10 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors">
            <span class="material-symbols-rounded text-2xl">close</span>
        </button>
        <img id="evalModalImg" src="" class="max-h-[92vh] max-w-[95vw] rounded-xl object-contain shadow-2xl" onclick="event.stopPropagation()">
    </div>
</body>
</html>
