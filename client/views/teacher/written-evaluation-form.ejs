<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Evaluate Written Exam | Teacher ODDHAY</title>

    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; }
        @media (max-width: 1024px) { .admin-sidebar { transform: translateX(-100%); } .admin-main { margin-left: 0; } }
        
        .material-symbols-rounded {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            line-height: 1;
        }
    </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'written-evaluations' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Evaluate Written Submission' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <%
                   const subDate = attempt.submittedAt ? new Date(attempt.submittedAt) : new Date();
                   const formattedSubDate = subDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + subDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

                   const isReviewed = attempt.writtenStatus === 'reviewed';
                   const mcqEarned = attempt.mcqScore || 0;
                   const mcqMax = attempt.maxMcqScore || 0;
                   const teacherNote = (attempt.teacherReview && attempt.teacherReview.overallFeedback) ? attempt.teacherReview.overallFeedback : '';
                   const teacherOverallImage = (attempt.teacherReview && attempt.teacherReview.overallImage) ? attempt.teacherReview.overallImage : '';
                %>



                <!-- ALERTS / NOTICES -->
                <% if (errorMsg) { %>
                    <div class="mx-4 sm:mx-6 mt-4 p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/60 text-xs font-medium text-rose-800 dark:text-rose-300 flex items-center gap-2">
                        <span class="material-symbols-rounded text-base text-rose-600">error</span>
                        <span><%= errorMsg %></span>
                    </div>
                <% } %>
                <% if (successMsg) { %>
                    <div class="mx-4 sm:mx-6 mt-4 p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 text-xs font-medium text-emerald-800 dark:text-emerald-300 flex items-center gap-2">
                        <span class="material-symbols-rounded text-base text-emerald-600">check_circle</span>
                        <span><%= successMsg %></span>
                    </div>
                <% } %>

                <form id="evaluationForm" method="POST" action="/teacher/written-evaluations/<%= attempt._id %>" class="p-4 sm:p-6 max-w-5xl w-full mx-auto space-y-5 pb-24">
                    
                    <!-- STUDENT & EXAM HEADER CARD -->
                    <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-2xs space-y-4">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            
                            <!-- Student Profile -->
                            <div class="flex items-center gap-3">
                                <div class="size-12 rounded-xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center font-bold text-base shrink-0 overflow-hidden">
                                    <% if (student.profilePicture || student.profileImage) { %>
                                        <img src="<%= student.profilePicture || student.profileImage %>" alt="<%= student.name %>" class="size-full object-cover">
                                    <% } else { %>
                                        <span><%= (student.name || 'S')[0].toUpperCase() %></span>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
                                            <%= student.name || 'Student' %>
                                        </h3>
                                        <% if (student.classLevel) { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                                <%= student.classLevel %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <p class="text-xs text-slate-400 font-normal">
                                        <%= student.email || student.phone || 'Student Submission' %>
                                    </p>
                                </div>
                            </div>

                            <!-- Exam Details Pill -->
                            <div class="flex flex-col sm:items-end gap-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-300 border border-cyan-200/80 dark:border-cyan-800/60">
                                        <%= bank.subject || 'Subject' %>
                                    </span>
                                    <span class="text-xs text-slate-400 font-normal flex items-center gap-1">
                                        <span class="material-symbols-rounded text-sm">calendar_today</span>
                                        <span><%= formattedSubDate %></span>
                                    </span>
                                </div>
                                <span class="text-xs font-normal text-slate-700 dark:text-slate-300">
                                    Exam: <strong class="font-medium text-slate-900 dark:text-white"><%= (bank.title && bank.title.trim()) || [bank.subject, bank.topic, bank.board, bank.year].filter(Boolean).join(' - ') || bank.subject || 'Written Exam' %></strong>
                                </span>
                            </div>

                        </div>

                        <!-- SCORE SUMMARY BAR -->
                        <div class="pt-3 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between gap-3 flex-wrap text-xs">
                            <div class="flex items-center gap-3 flex-wrap">
                                <% if (mcqMax > 0) { %>
                                    <div class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                                        <span class="text-slate-400 font-normal">Auto-graded MCQ Score: </span>
                                        <strong class="font-semibold text-slate-800 dark:text-slate-200"><%= mcqEarned %> / <%= mcqMax %></strong>
                                    </div>
                                <% } %>
                                <div class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                                    <span class="text-slate-400 font-normal">Written Questions: </span>
                                    <strong class="font-semibold text-slate-800 dark:text-slate-200"><%= questions.length %></strong>
                                </div>
                            </div>

                            <!-- Live Calculated Total -->
                            <div class="px-3.5 py-1.5 rounded-xl bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-200/80 dark:border-cyan-800/60 flex items-center gap-2">
                                <span class="text-cyan-600 dark:text-cyan-400 font-medium text-xs">Written Total:</span>
                                <span id="headerScorePreview" class="font-semibold text-cyan-800 dark:text-cyan-200 text-sm">0</span>
                            </div>
                        </div>
                    </div>

                    <!-- QUESTIONS FEED -->
                    <div class="space-y-4">
                        <% 
                            let displayQuestionIndex = 0;
                            questions.forEach(function(q, index) { 
                                const ua = q.userAnswer || {};
                                const qMaxMark = q.maxMarks || 1;
                                const existingMark = (ua.marksObtained !== undefined && ua.marksObtained !== null) ? ua.marksObtained : '';
                                const existingComment = ua.teacherComment || '';
                                const existingImage = ua.teacherImage || '';
                                const modelSolution = q.correctAnswer || q.answer || '';
                                const qIdKey = q._id ? q._id.toString() : String(index);
                                const isComprehension = (q.questionType === 'Comprehension') && (q.q1 || q.q2);
                        %>

                            <% if (isComprehension) { %>
                                <!-- COMPREHENSION: QUESTION 1 (MAX 3 MARKS) -->
                                <% 
                                    displayQuestionIndex++;
                                    let ans1 = ua.q1Answer || '';
                                    let img1 = ua.q1Image || '';
                                    if (!ans1 && ua.writtenAnswer) {
                                        if (ua.writtenAnswer.includes('[Question 2 / প্রশ্ন ২]:')) {
                                            const parts = ua.writtenAnswer.split('[Question 2 / প্রশ্ন ২]:');
                                            ans1 = parts[0].replace(/\[Question 1 \/ প্রশ্ন ১\]:?\s*/i, '').trim();
                                        } else if (ua.writtenAnswer.includes('[Question 1 / প্রশ্ন ১]:')) {
                                            ans1 = ua.writtenAnswer.replace(/\[Question 1 \/ প্রশ্ন ১\]:?\s*/i, '').trim();
                                        } else {
                                            ans1 = ua.writtenAnswer.trim();
                                        }
                                    }
                                    if (!img1 && Array.isArray(ua.writtenImages) && ua.writtenImages.length > 0) {
                                        img1 = ua.writtenImages[0] || '';
                                    }
                                    if (!img1 && ua.writtenImage) {
                                        img1 = ua.writtenImage;
                                    }

                                    let markValQ1 = (ua.q1Marks !== undefined && ua.q1Marks !== null) ? ua.q1Marks : '';
                                    let commValQ1 = '';
                                    if (existingComment.includes('[Question 2]:')) {
                                        const cParts = existingComment.split('[Question 2]:');
                                        commValQ1 = cParts[0].replace('[Question 1]:', '').trim();
                                    } else {
                                        commValQ1 = existingComment;
                                    }
                                    let imgValQ1 = existingImage;

                                    const mAns1 = (q.a1 || '').trim();
                                    const hasMAns1 = mAns1 && mAns1 !== '0' && mAns1 !== 'undefined' && mAns1 !== 'null';
                                %>
                                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-2xs space-y-4">
                                    <!-- QUESTION HEADER -->
                                    <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200/60 dark:border-slate-800">
                                        <div class="flex items-center gap-2">
                                            <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                                Question <%= displayQuestionIndex %>
                                            </span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-normal bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                                Comprehension
                                            </span>
                                        </div>
                                        <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            Max Marks: 3
                                        </span>
                                    </div>

                                    <!-- STIMULUS / CONTEXT -->
                                    <div class="space-y-1">
                                        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 block">উদ্দীপক:</span>
                                        <div class="text-sm sm:text-base font-normal text-slate-800 dark:text-slate-100 leading-relaxed whitespace-pre-wrap"><%- q.context || q.questionText %></div>
                                    </div>

                                    <!-- QUESTION STATEMENT -->
                                    <div class="text-sm sm:text-base font-normal text-slate-800 dark:text-slate-100 leading-relaxed">
                                        <%- q.q1 %>
                                    </div>

                                    <!-- OFFICIAL MODEL SOLUTION -->
                                    <% if (hasMAns1) { %>
                                        <div class="rounded-xl overflow-hidden border border-emerald-500/25 bg-emerald-50/20 dark:bg-emerald-950/15">
                                            <div class="px-3.5 py-1.5 bg-emerald-500/10 dark:bg-emerald-500/15 flex items-center gap-1.5 border-b border-emerald-500/20">
                                                <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-sm leading-none">verified</span>
                                                <span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400">Model Solution (Reference Answer)</span>
                                            </div>
                                            <div class="p-3.5 text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 leading-relaxed">
                                                <%- mAns1 %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <!-- STUDENT'S SUBMITTED ANSWER -->
                                    <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
                                                <span class="material-symbols-rounded text-sm text-cyan-600 dark:text-cyan-400 leading-none">edit_note</span>
                                                <span>Student's Submitted Answer:</span>
                                            </span>
                                            <% if ((!ans1 || ans1.trim() === '') && !img1) { %>
                                                <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/40">
                                                    Not Answered / Left Blank
                                                </span>
                                            <% } %>
                                        </div>
                                        <% if (ans1 && ans1.trim() !== '') { %>
                                            <div class="p-3 rounded-lg bg-white dark:bg-[#0b1120] border border-slate-200/60 dark:border-slate-800 text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 leading-relaxed whitespace-pre-wrap min-h-[44px]">
                                                <%= ans1 %>
                                            </div>
                                        <% } %>
                                        <% if (img1) { %>
                                            <div class="pt-2 space-y-1.5">
                                                <span class="text-[11px] font-bold text-indigo-700 dark:text-indigo-400 flex items-center gap-1.5">
                                                    <span class="material-symbols-rounded text-sm">photo_library</span>
                                                    <span>Student's Submitted Picture:</span>
                                                </span>
                                                <div>
                                                    <div class="inline-block relative group rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xs cursor-pointer select-none" onclick="openFullscreenEvaluationImage('<%= img1 %>')">
                                                        <img src="<%= img1 %>" alt="Student Submission" class="max-h-56 sm:max-h-72 w-auto rounded-xl object-contain block transition-transform duration-200 group-hover:scale-[1.02]">
                                                        <div class="absolute inset-0 bg-slate-950/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center pointer-events-none">
                                                            <div class="size-9 rounded-xl bg-black/70 backdrop-blur-md text-white flex items-center justify-center shadow border border-white/20">
                                                                <span class="material-symbols-rounded text-xl">fullscreen</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- TEACHER EVALUATION INPUTS (MARKS & FEEDBACK) -->
                                    <div class="p-3.5 rounded-xl bg-indigo-50/40 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/30 space-y-3">
                                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <label class="text-xs font-medium text-slate-700 dark:text-slate-300">
                                                    Award Marks:
                                                </label>
                                                <div class="flex items-center gap-1.5">
                                                    <input type="number" 
                                                           name="marks_<%= qIdKey %>_q1" 
                                                           id="marks_<%= qIdKey %>_q1"
                                                           value="<%= markValQ1 %>" 
                                                           min="0" 
                                                           max="3" 
                                                           step="0.5" 
                                                           placeholder="0"
                                                           data-max="3"
                                                           class="score-input w-20 px-3 py-1.5 rounded-xl text-sm font-semibold bg-white dark:bg-slate-900 border border-indigo-200 dark:border-indigo-800/80 text-indigo-700 dark:text-indigo-300 focus:outline-hidden focus:border-indigo-500 text-center"
                                                           required>
                                                    <span class="text-xs font-normal text-slate-400">/ 3</span>
                                                </div>
                                                <div class="flex items-center gap-1 ml-2">
                                                    <button type="button" onclick="setQuickScore('<%= qIdKey %>_q1', 0)" class="px-2 py-1 rounded-lg text-[11px] font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all cursor-pointer">
                                                        0
                                                    </button>
                                                    <button type="button" onclick="setQuickScore('<%= qIdKey %>_q1', 1.5)" class="px-2 py-1 rounded-lg text-[11px] font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all cursor-pointer">
                                                        Half (1.5)
                                                    </button>
                                                    <button type="button" onclick="setQuickScore('<%= qIdKey %>_q1', 3)" class="px-2 py-1 rounded-lg text-[11px] font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-all cursor-pointer">
                                                        Full (3)
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="space-y-2">
                                            <div class="flex items-start gap-2">
                                                <div class="flex-1 min-w-0">
                                                    <textarea 
                                                        name="comment_<%= qIdKey %>_q1" 
                                                        rows="2" 
                                                        placeholder="Teacher's comment / feedback note for Question <%= displayQuestionIndex %>..."
                                                        class="w-full p-2.5 rounded-xl text-xs sm:text-sm bg-white dark:bg-slate-900 border border-indigo-200/80 dark:border-indigo-800/60 text-slate-800 dark:text-slate-200 focus:outline-hidden focus:border-indigo-500 placeholder:text-slate-400 transition-colors resize-y leading-relaxed min-h-[56px]"><%= commValQ1 %></textarea>
                                                </div>
                                                <div class="flex flex-col items-center shrink-0 pt-0.5">
                                                    <input type="file" 
                                                           id="file_input_<%= qIdKey %>_q1" 
                                                           accept="image/*" 
                                                           class="hidden" 
                                                           onchange="handleTeacherImageUpload(this, '<%= qIdKey %>_q1')">
                                                    <input type="hidden" 
                                                           id="hidden_image_<%= qIdKey %>_q1" 
                                                           name="image_<%= qIdKey %>_q1" 
                                                           value="<%= imgValQ1 %>">
                                                    
                                                    <button type="button" 
                                                            onclick="document.getElementById('file_input_<%= qIdKey %>_q1').click()" 
                                                            class="size-10 rounded-xl flex items-center justify-center border border-indigo-200/90 dark:border-indigo-800/80 bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 hover:border-indigo-400 transition-all shadow-2xs group cursor-pointer" 
                                                            title="Attach picture / solution note for this question">
                                                        <span class="material-symbols-rounded text-xl group-hover:scale-110 transition-transform">add_photo_alternate</span>
                                                    </button>
                                                    <span class="text-[9.5px] text-slate-400 font-medium mt-0.5">Photo</span>
                                                </div>
                                            </div>

                                            <div id="image_preview_wrap_<%= qIdKey %>_q1" class="<%= imgValQ1 ? '' : 'hidden' %>">
                                                <div class="relative inline-flex items-center gap-2.5 p-1.5 rounded-xl bg-white dark:bg-slate-900 border border-indigo-200/80 dark:border-indigo-800/60 shadow-2xs">
                                                    <a id="image_link_<%= qIdKey %>_q1" href="<%= imgValQ1 || '#' %>" target="_blank" class="block size-12 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 shrink-0">
                                                        <img id="image_preview_<%= qIdKey %>_q1" src="<%= imgValQ1 || '' %>" alt="Attached preview" class="size-full object-cover">
                                                    </a>
                                                    <div class="space-y-0.5 pr-2">
                                                        <p class="text-[11px] font-medium text-slate-700 dark:text-slate-300">Attached Picture</p>
                                                        <button type="button" onclick="removeTeacherImage('<%= qIdKey %>_q1')" class="text-[11px] font-medium text-rose-600 hover:text-rose-500 inline-flex items-center gap-0.5 cursor-pointer">
                                                            <span class="material-symbols-rounded text-xs">delete</span>
                                                            <span>Remove</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- COMPREHENSION: QUESTION 2 (MAX 4 MARKS) -->
                                <% 
                                    displayQuestionIndex++;
                                    let ans2 = ua.q2Answer || '';
                                    let img2 = ua.q2Image || '';
                                    if (!ans2 && ua.writtenAnswer && ua.writtenAnswer.includes('[Question 2 / প্রশ্ন ২]:')) {
                                        const parts = ua.writtenAnswer.split('[Question 2 / প্রশ্ন ২]:');
                                        ans2 = (parts[1] || '').trim();
                                    }
                                    if (!img2 && Array.isArray(ua.writtenImages) && ua.writtenImages.length > 1) {
                                        img2 = ua.writtenImages[1] || '';
                                    }

                                    let markValQ2 = (ua.q2Marks !== undefined && ua.q2Marks !== null) ? ua.q2Marks : '';
                                    let commValQ2 = '';
                                    if (existingComment.includes('[Question 2]:')) {
                                        const cParts = existingComment.split('[Question 2]:');
                                        commValQ2 = (cParts[1] || '').trim();
                                    }
                                    let imgValQ2 = '';

                                    const mAns2 = (q.a2 || '').trim();
                                    const hasMAns2 = mAns2 && mAns2 !== '0' && mAns2 !== 'undefined' && mAns2 !== 'null';
                                %>
                                <div class="bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-2xs space-y-4">
                                    <!-- QUESTION HEADER -->
                                    <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200/60 dark:border-slate-800">
                                        <div class="flex items-center gap-2">
                                            <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                                Question <%= displayQuestionIndex %>
                                            </span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-normal bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                                Comprehension
                                            </span>
                                        </div>
                                        <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            Max Marks: 4
                                        </span>
                                    </div>

                                    <!-- QUESTION STATEMENT -->
                                    <div class="text-sm sm:text-base font-normal text-slate-800 dark:text-slate-100 leading-relaxed">
                                        <%- q.q2 %>
                                    </div>

                                    <!-- OFFICIAL MODEL SOLUTION -->
                                    <% if (hasMAns2) { %>
                                        <div class="rounded-xl overflow-hidden border border-emerald-500/25 bg-emerald-50/20 dark:bg-emerald-950/15">
                                            <div class="px-3.5 py-1.5 bg-emerald-500/10 dark:bg-emerald-500/15 flex items-center gap-1.5 border-b border-emerald-500/20">
                                                <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-sm leading-none">verified</span>
                                                <span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400">Model Solution (Reference Answer)</span>
                                            </div>
