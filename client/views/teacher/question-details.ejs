        let _wizardDefaultBulk = false;

        function openCompositionWizard(isBulk = false) {
            _wizardDefaultBulk = Boolean(isBulk);
            const modal = document.getElementById('compositionWizardModal');
            if (modal) modal.classList.remove('hidden');

            const titleEl = document.getElementById('wizModalTitle');
