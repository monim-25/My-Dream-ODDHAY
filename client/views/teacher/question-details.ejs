<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
        <title>Questions | ODDHAY Command Center</title>
        <style>
            * {
                font-family: 'Inter', 'Noto Sans Bengali', 'Hind Siliguri', sans-serif;
            }

            .material-symbols-rounded {
                font-family: 'Material Symbols Rounded' !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
            }

            :root {
                --admin-sidebar-width: 260px;
            }

            html,
            body {
                height: 100%;
                height: 100dvh;
                overflow: hidden;
                margin: 0;
                padding: 0;
            }

            .admin-main {
                margin-left: var(--admin-sidebar-width);
                height: 100%;
                height: 100dvh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                min-height: 0;
                width: calc(100% - var(--admin-sidebar-width));
                overflow: hidden;
                transition: all 0.3s ease;
            }

            .content-scroll {
                flex: 1 1 0%;
                min-height: 0;
                height: 100%;
                overflow-y: auto;
                overflow-x: hidden;
                -webkit-overflow-scrolling: touch;
                touch-action: pan-y;
                padding: 0;
                position: relative;
            }

            @media (max-width: 1024px) {

                .admin-sidebar,
                #adminSidebar {
                    transform: translateX(-100%);
                }

                .admin-main {
                    margin-left: 0 !important;
                    width: 100% !important;
                    height: 100% !important;
                    height: 100dvh !important;
                    overflow: hidden !important;
                }

                .content-scroll {
                    flex: 1 1 0% !important;
                    min-height: 0 !important;
                    height: 100% !important;
                    overflow-y: auto !important;
                    overflow-x: hidden !important;
                    -webkit-overflow-scrolling: touch !important;
                    touch-action: pan-y !important;
                }
            }

            .admin-sidebar.active,
            #adminSidebar.active,
            .admin-sidebar.translate-x-0,
            #adminSidebar.translate-x-0 {
                transform: translateX(0) !important;
            }

            .line-clamp-2 {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 4px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: rgba(0, 0, 0, 0.1);
                border-radius: 10px;
            }

            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            .question-mobile-card {
                -webkit-touch-callout: none;
                -webkit-user-select: none;
                user-select: none;
                touch-action: pan-y;
            }

            #mobileQuestionsView:not(.mobile-selection-active) .mobile-cb-wrapper {
                display: none !important;
            }

            #mobileQuestionsView.mobile-selection-active .mobile-cb-wrapper {
                display: inline-flex !important;
            }

            #mobileQuestionsView:not(.mobile-selection-active) #mobileSelectBar {
                display: none !important;
            }

            #mobileQuestionsView.mobile-selection-active #mobileSelectBar {
                display: flex !important;
            }

            #mobileQuestionsView.mobile-selection-active #mobileHeaderInfo {
                display: none !important;
            }
        </style>
</head>

<body
    class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden h-full h-[100dvh]">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar"
            class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'question-details' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)"
            class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300">
        </div>

        <main
            class="admin-main flex-1 bg-[#FFFFFF] dark:bg-[#020617] flex flex-col h-full h-[100dvh] min-h-0 overflow-hidden">
            <%- include('header', { pageTitle: 'Questions' , user: user }) %>

                <div
                    class="content-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 bg-[#FFFFFF] dark:bg-[#020617]">
                    <!-- Archive Stats (PERFECTLY ATTACHED WITH BORDER) -->
                    <div
                        class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                            <!-- Card 1: MCQ -->
                            <div onclick="window.location.href='?type=MCQ'"
                                class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer transition-all">
                                <div
                                    class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                    <div class="space-y-0.5">
                                        <p class="text-[11px] font-bold text-blue-600 dark:text-blue-400">MCQ</p>
                                        <h3
                                            class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                                            <%= mCQCount %>
                                        </h3>
                                    </div>
                                    <div
                                        class="size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                        <span class="material-symbols-rounded text-lg">list_alt</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Short -->
                            <div onclick="window.location.href='?type=Short'"
                                class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer transition-all">
                                <div
                                    class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                    <div class="space-y-0.5">
                                        <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Short
                                            Answer</p>
                                        <h3
                                            class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                                            <%= shortCount %>
                                        </h3>
                                    </div>
                                    <div
                                        class="size-9 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                                        <span class="material-symbols-rounded text-lg">short_text</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 3: Medium -->
                            <div onclick="window.location.href='?type=Medium'"
                                class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer transition-all">
                                <div
                                    class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                    <div class="space-y-0.5">
                                        <p class="text-[11px] font-bold text-amber-600 dark:text-amber-400">Medium</p>
                                        <h3
                                            class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                                            <%= mediumCount %>
                                        </h3>
                                    </div>
                                    <div
                                        class="size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                                        <span class="material-symbols-rounded text-lg">notes</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 4: Comprehension -->
                            <div onclick="window.location.href='?type=Comprehension'"
                                class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer transition-all">
                                <div
                                    class="p-3 border border-slate-100 dark:border-white/5 rounded-sm flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                    <div class="space-y-0.5">
                                        <p class="text-[11px] font-bold text-purple-600 dark:text-purple-400">
                                            Comprehension</p>
                                        <h3
                                            class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                                            <%= compCount %>
                                        </h3>
                                    </div>
                                    <div
                                        class="size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                        <span class="material-symbols-rounded text-lg">article</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% const activeType=filters.type || 'all' ; const activeSubject=filters.subject || 'all' ; const
                        activeClass=filters.class || 'all' ; const activeBoard=filters.board || 'all' ; const
                        activeAccess=filters.access || 'all' ; const typeLabel=activeType==='all' ? 'All Types' :
                        activeType; const subjectLabel=activeSubject==='all' ? 'All Subjects' : activeSubject; const
                        classLabel=activeClass==='all' ? 'All Classes' : (String(activeClass).startsWith('Class') ?
                        activeClass : 'Class ' + activeClass); const boardLabel=activeBoard==='all' ? 'All Boards' :
                        activeBoard.replace(' Board', '' ); const accessLabel=activeAccess==='all' ? 'All Access' :
                        activeAccess; const hasActiveFilters=(activeType !=='all' ) || (activeSubject !=='all' ) ||
                        (activeClass !=='all' ) || (activeBoard !=='all' ) || (activeAccess !=='all' ) || (filters.q &&
                        filters.q.trim().length> 0);
                        %>

                        <div
                            class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-none flex-1">
                            <!-- Filters Bar (Responsive with Custom In-System Dropdowns) -->
                            <div
                                class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-3 sm:px-6 py-2.5 border-b border-slate-200 dark:border-slate-800 shadow-2xs">
                                <!-- Top Row: Search + Quick Actions -->
                                <div class="flex items-center gap-2">
                                    <form action="" method="GET"
                                        class="relative flex-1 min-w-0 max-w-md flex items-center">
                                        <input type="text" name="q" value="<%= filters.q %>"
                                            placeholder="Search questions..."
                                            class="w-full pl-8 pr-7 h-9 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 text-xs font-semibold outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-all">
                                        <span
                                            class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none">search</span>
                                        <% if (filters.q) { %>
                                            <a href="?type=<%= encodeURIComponent(filters.type) %>&class=<%= encodeURIComponent(filters.class) %>&subject=<%= encodeURIComponent(filters.subject) %>&board=<%= encodeURIComponent(filters.board) %>&access=<%= encodeURIComponent(filters.access) %>"
                                                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                                                <span class="material-symbols-rounded text-sm">close</span>
                                            </a>
                                            <% } %>
                                                <input type="hidden" name="type" value="<%= filters.type %>">
                                                <input type="hidden" name="class" value="<%= filters.class %>">
                                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                                <input type="hidden" name="board" value="<%= filters.board %>">
                                                <input type="hidden" name="access" value="<%= filters.access %>">
                                                <% if (filters.author) { %><input type="hidden" name="author"
                                                        value="<%= filters.author %>">
                                                    <% } %>
                                    </form>

                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <button type="button" onclick="openCompositionWizard(true)"
                                            title="Smart Bulk Paste (Select Class & Subject First)"
                                            class="h-8 sm:h-9 px-2.5 sm:px-3 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 border border-amber-500/30 text-xs font-semibold shadow-2xs transition-all flex items-center gap-1 active:scale-95 cursor-pointer">
                                            <span class="material-symbols-rounded text-base text-amber-500">bolt</span>
                                            <span>Bulk Paste</span>
                                        </button>
                                        <button onclick="openCompositionWizard(false)"
                                            class="h-8 sm:h-9 px-3 sm:px-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold shadow-xs shadow-primary/30 transition-all flex items-center gap-1 active:scale-95 cursor-pointer">
                                            <span class="material-symbols-rounded text-base">add</span>
                                            <span>Add</span>
                                        </button>
                                        <button onclick="exportToCSV()" title="Export CSV"
                                            class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-xl bg-white/70 dark:bg-white/10 backdrop-blur-md border border-slate-200/80 dark:border-white/10 hover:bg-white/90 dark:hover:bg-white/15 text-slate-700 dark:text-slate-200 text-xs font-medium shadow-2xs transition-all flex items-center gap-1 cursor-pointer">
                                            <span
                                                class="material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400">download</span>
                                            <span class="hidden md:inline">Export</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Dropdowns Row (Custom In-System Dropdowns) -->
                                <div class="mt-2 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                                    <!-- Type Dropdown -->
                                    <div class="relative system-dropdown shrink-0" id="dropdown-type">
                                        <button type="button" onclick="toggleSystemDropdown('type', event)"
                                            class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeType !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                            <span class="truncate max-w-[85px]">
                                                <%= typeLabel %>
                                            </span>
                                            <span
                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                        </button>
                                        <div id="dropdown-menu-type"
                                            class="hidden absolute top-full left-0 mt-1 w-36 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                            <div onclick="updateFilter('type', 'all')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeType === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>All Types</span>
                                                <% if (activeType==='all' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <% ['MCQ', 'Short' , 'Medium' , 'Comprehension' ].forEach(t=> { %>
                                                <div onclick="updateFilter('type', '<%= t %>')"
                                                    class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeType === t ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                    <span>
                                                        <%= t %>
                                                    </span>
                                                    <% if (activeType===t) { %><span
                                                            class="material-symbols-rounded text-sm text-primary">check</span>
                                                        <% } %>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <!-- Subject Dropdown -->
                                    <div class="relative system-dropdown shrink-0" id="dropdown-subject">
                                        <button type="button" onclick="toggleSystemDropdown('subject', event)"
                                            class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeSubject !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                            <span class="truncate max-w-[95px]">
                                                <%= subjectLabel %>
                                            </span>
                                            <span
                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                        </button>
                                        <div id="dropdown-menu-subject"
                                            class="hidden absolute top-full left-0 mt-1 w-44 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                            <div onclick="updateFilter('subject', 'all')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeSubject === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>All Subjects</span>
                                                <% if (activeSubject==='all' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <% (assignedSubjects || []).forEach(s=> { %>
                                                <div onclick="updateFilter('subject', '<%= s %>')"
                                                    class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeSubject === s ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                    <span class="truncate">
                                                        <%= s %>
                                                    </span>
                                                    <% if (activeSubject===s) { %><span
                                                            class="material-symbols-rounded text-sm text-primary">check</span>
                                                        <% } %>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <!-- Class Dropdown -->
                                    <div class="relative system-dropdown shrink-0" id="dropdown-class">
                                        <button type="button" onclick="toggleSystemDropdown('class', event)"
                                            class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeClass !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                            <span class="truncate max-w-[90px]">
                                                <%= classLabel %>
                                            </span>
                                            <span
                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                        </button>
                                        <div id="dropdown-menu-class"
                                            class="hidden absolute top-full left-0 mt-1 w-40 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                            <div onclick="updateFilter('class', 'all')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeClass === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>All Classes</span>
                                                <% if (activeClass==='all' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <% (assignedClasses || []).forEach(c=> { %>
                                                <div onclick="updateFilter('class', '<%= c %>')"
                                                    class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= (activeClass === c || activeClass === String(c).replace(/^Class\s*/i, '')) ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                    <span class="truncate">
                                                        <%= String(c).startsWith('Class') ? c : 'Class ' + c %>
                                                    </span>
                                                    <% if (activeClass===c || activeClass === String(c).replace(/^Class\s*/i, '')) { %><span
                                                            class="material-symbols-rounded text-sm text-primary">check</span>
                                                        <% } %>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <!-- Board Dropdown -->
                                    <div class="relative system-dropdown shrink-0" id="dropdown-board">
                                        <button type="button" onclick="toggleSystemDropdown('board', event)"
                                            class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeBoard !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                            <span class="truncate max-w-[90px]">
                                                <%= boardLabel %>
                                            </span>
                                            <span
                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                        </button>
                                        <div id="dropdown-menu-board"
                                            class="hidden absolute top-full left-0 mt-1 w-44 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                            <div onclick="updateFilter('board', 'all')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeBoard === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>All Boards</span>
                                                <% if (activeBoard==='all' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <% 
                                                const boardFilterList = (typeof boards !== 'undefined' && Array.isArray(boards) && boards.length > 0)
                                                    ? boards
                                                    : ['Dhaka Board', 'Rajshahi Board', 'Comilla Board', 'Jessore Board', 'Chittagong Board', 'Barisal Board', 'Sylhet Board', 'Dinajpur Board', 'Mymensingh Board', 'Madrasah Board', 'Technical Board', 'All Board'];
                                                boardFilterList.forEach(b => { 
                                            %>
                                                <div onclick="updateFilter('board', '<%= b %>')"
                                                    class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeBoard === b ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                    <span class="truncate">
                                                        <%= b %>
                                                    </span>
                                                    <% if (activeBoard===b) { %><span
                                                            class="material-symbols-rounded text-sm text-primary">check</span>
                                                        <% } %>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <!-- Access Dropdown -->
                                    <div class="relative system-dropdown shrink-0" id="dropdown-access">
                                        <button type="button" onclick="toggleSystemDropdown('access', event)"
                                            class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeAccess !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                            <span class="truncate max-w-[80px]">
                                                <%= accessLabel %>
                                            </span>
                                            <span
                                                class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                        </button>
                                        <div id="dropdown-menu-access"
                                            class="hidden absolute top-full right-0 sm:left-0 sm:right-auto mt-1 w-36 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                            <div onclick="updateFilter('access', 'all')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeAccess === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>All Access</span>
                                                <% if (activeAccess==='all' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <div onclick="updateFilter('access', 'Free')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeAccess === 'Free' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>Free</span>
                                                <% if (activeAccess==='Free' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                            <div onclick="updateFilter('access', 'Paid')"
                                                class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeAccess === 'Paid' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                                <span>Paid</span>
                                                <% if (activeAccess==='Paid' ) { %><span
                                                        class="material-symbols-rounded text-sm text-primary">check</span>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Count Badge -->
                                    <div
                                        class="h-7 sm:h-8 px-2 sm:px-2.5 bg-primary/10 border border-primary/20 rounded-lg sm:rounded-xl flex items-center shrink-0">
                                        <span class="text-[11px] font-bold text-primary whitespace-nowrap">
                                            <%= filters.totalCount %> Qs
                                        </span>
                                    </div>

                                    <% if (hasActiveFilters) { %>
                                        <a href="/teacher/question-details"
                                            class="h-7 sm:h-8 px-2 rounded-lg sm:rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 text-[11px] font-bold flex items-center gap-1 shrink-0 transition-colors">
                                            <span class="material-symbols-rounded text-xs">close</span>
                                            <span>Reset</span>
                                        </a>
                                        <% } %>
                                </div>
                            </div>

                            <!-- MOBILE QUESTIONS VIEW (< md screens) -->
                            <div id="mobileQuestionsView" class="md:hidden flex flex-col flex-1">
                                <!-- Mobile Header Info (Default state when NOT selecting) -->
                                <div id="mobileHeaderInfo"
                                    class="px-3.5 py-2.5 bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between text-xs">
                                    <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                                        <span class="material-symbols-rounded text-sm text-primary/70">touch_app</span>
                                        <span class="text-[11px] font-normal">Tap &amp; hold to select questions</span>
                                    </div>
                                    <span
                                        class="text-[10px] font-medium text-slate-400 bg-slate-200/50 dark:bg-slate-800 px-2 py-0.5 rounded-full">Total
                                        <%= filters.totalCount %>
                                    </span>
                                </div>

                                <!-- Mobile Select All Bar (Shown only when selection mode is active) -->
                                <div id="mobileSelectBar"
                                    class="hidden px-3.5 py-2 bg-primary/10 dark:bg-primary/20 border-b border-primary/20 items-center justify-between text-xs transition-all">
                                    <label class="flex items-center gap-2 cursor-pointer select-none">
                                        <input type="checkbox" id="selectAllMobile" onchange="toggleSelectAllMobile()"
                                            class="size-4 rounded border-slate-300 dark:border-slate-700 text-primary cursor-pointer">
                                        <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200">Select
                                            all (<%= questions.length %>)</span>
                                    </label>
                                    <div class="flex items-center gap-2">
                                        <span id="mobileSelectedCounter"
                                            class="text-[11px] font-semibold text-primary">0 selected</span>
                                        <button type="button" onclick="exitMobileSelection()"
                                            class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-medium shadow-xs border border-slate-200/60 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors cursor-pointer">
                                            Done
                                        </button>
                                    </div>
                                </div>

                                <!-- Mobile Cards List -->
                                <div class="p-2.5 sm:p-3 space-y-2.5 flex-1">
                                    <% if (questions && questions.length> 0) { %>
                                        <% questions.forEach(q=> { %>
                                            <div class="question-mobile-card p-3 rounded-xl bg-white dark:bg-[#0b1120] border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-2 transition-all active:scale-[0.99] cursor-pointer"
                                                data-question-card="<%= q._id %>"
                                                onclick="handleMobileCardClick('<%= q._id %>', event)"
                                                ontouchstart="handleCardTouchStart('<%= q._id %>', event)"
                                                ontouchmove="handleCardTouchMove(event)"
                                                ontouchend="handleCardTouchEnd(event)"
                                                ontouchcancel="handleCardTouchCancel(event)"
                                                onmousedown="handleCardTouchStart('<%= q._id %>', event)"
                                                onmousemove="handleCardTouchMove(event)"
                                                onmouseup="handleCardTouchEnd(event)">
                                                <!-- Header of Card: Checkbox (hidden until selection mode), Badges, Quick Actions -->
                                                <div class="flex items-center justify-between gap-2">
                                                    <div class="flex items-center gap-1.5 flex-wrap">
                                                        <div class="mobile-cb-wrapper items-center"
                                                            onclick="event.stopPropagation()">
                                                            <input type="checkbox" name="itemSelect"
                                                                value="<%= q._id %>" id="cb-m-<%= q._id %>"
                                                                onchange="toggleSelection(this)"
                                                                class="item-cb size-4.5 rounded border-slate-300 dark:border-slate-700 text-primary cursor-pointer">
                                                        </div>
                                                        <% const typeMap={ 'MCQ' : 'blue' , 'Short' : 'emerald'
                                                            , 'Medium' : 'amber' , 'Comprehension' : 'purple' }; const
                                                            color=typeMap[q.questionType] || 'slate' ; %>
                                                            <span
                                                                class="inline-flex items-center px-2 py-0.5 rounded-md bg-<%= color %>-50 dark:bg-<%= color %>-500/10 text-<%= color %>-600 dark:text-<%= color %>-400 text-[10px] font-medium border border-<%= color %>-100 dark:border-<%= color %>-500/20">
                                                                <%= q.questionType %>
                                                            </span>
                                                            <% if (q.accessType==='Paid' ) { %>
                                                                <span
                                                                    class="px-1.5 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-medium border border-amber-100 dark:border-amber-500/20">Paid</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="px-1.5 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-medium border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                                                    <% } %>
                                                    </div>
                                                    <div class="flex items-center gap-1 shrink-0"
                                                        onclick="event.stopPropagation()">
                                                        <button type="button" onclick="viewQuestion('<%= q._id %>')"
                                                            class="size-7 rounded-lg bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 flex items-center justify-center hover:bg-blue-500 hover:text-white transition-all cursor-pointer"
                                                            title="View">
                                                            <span
                                                                class="material-symbols-rounded text-sm">visibility</span>
                                                        </button>
                                                        <button type="button" onclick="deleteQuestion('<%= q._id %>')"
                                                            class="size-7 rounded-lg bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all cursor-pointer"
                                                            title="Delete">
                                                            <span class="material-symbols-rounded text-sm">delete</span>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Question Content -->
                                                <p
                                                    class="text-xs font-normal text-slate-800 dark:text-slate-200 leading-relaxed line-clamp-3">
                                                    <%= q.questionText %>
                                                </p>

                                                <!-- Footer Info -->
                                                <div
                                                    class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-[10px] text-slate-500 dark:text-slate-400">
                                                    <div class="flex items-center gap-1.5 flex-wrap">
                                                        <span class="font-medium text-primary">
                                                            <%= q.subject || 'General' %>
                                                        </span>
                                                        <span>•</span>
                                                        <span class="font-normal">Class <%= q.classLevel %></span>
                                                        <% if (q.board) { %>
                                                            <span>•</span>
                                                            <span class="font-normal">
                                                                <%= q.board %>
                                                                    <%= q.year ? ('(' + q.year + ')' ) : '' %>
                                                            </span>
                                                            <% } %>
                                                    </div>
                                                    <div class="flex items-center gap-1 shrink-0">
                                                        <div
                                                            class="size-4.5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-[8px] font-bold text-slate-400">
                                                            <%= (q.addedBy && q.addedBy.name ?
                                                                q.addedBy.name[0].toUpperCase() : 'A' ) %>
                                                        </div>
                                                        <span class="truncate max-w-[65px] font-normal">
                                                            <%= q.addedBy ? q.addedBy.name : 'System' %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div
                                                        class="p-8 text-center bg-white dark:bg-[#0b1120] rounded-xl border border-slate-200/80 dark:border-slate-800">
                                                        <span
                                                            class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600">help_center</span>
                                                        <p
                                                            class="mt-2 text-xs font-medium text-slate-600 dark:text-slate-300">
                                                            No questions found</p>
                                                        <p class="text-[10px] text-slate-400 mt-0.5">Try adjusting your
                                                            filters or search keywords</p>
                                                    </div>
                                                    <% } %>
                                </div>
                            </div>

                            <!-- DESKTOP QUESTIONS VIEW (>= md screens) -->
                            <div class="hidden md:block table-wrapper">
                                <table class="w-full text-left border-collapse">
                                    <thead
                                        class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                        <tr>
                                            <th class="pl-4 pr-1 text-center w-10">
                                                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()"
                                                    class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                            </th>
                                            <th class="pl-1 pr-3 py-2 text-[10px] font-bold text-slate-500 text-left">
                                                Question Content</th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Type
                                            </th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Board
                                            </th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Subject
                                            </th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Class
                                            </th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Access
                                            </th>
                                            <th class="px-6 py-2 text-[10px] font-bold text-slate-500 text-left">Author
                                            </th>
                                            <th
                                                class="pr-4 py-3 text-[10px] font-black uppercase tracking-widest text-slate-400 text-right border-0">
                                                Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                        <% questions.forEach(q=> { %>
                                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group"
                                                onclick="viewQuestion('<%= q._id %>')">
                                                <td class="pl-4 pr-1 py-3" onclick="event.stopPropagation()">
                                                    <input type="checkbox" name="itemSelect" value="<%= q._id %>"
                                                        id="cb-<%= q._id %>" onchange="toggleSelection(this)"
                                                        class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                                </td>
                                                <td class="pl-1 pr-3 py-3 max-w-md">
                                                    <p
                                                        class="text-[11px] font-bold text-slate-900 dark:text-white leading-relaxed line-clamp-2">
                                                        <%= q.questionText %>
                                                    </p>
                                                </td>
                                                <td class="px-6 py-3 whitespace-nowrap">
                                                    <% const typeMap={ 'MCQ' : 'blue' , 'Short' : 'emerald' , 'Medium'
                                                        : 'amber' , 'Comprehension' : 'purple' }; const
                                                        color=typeMap[q.questionType] || 'slate' ; %>
                                                        <span
                                                            class="inline-flex items-center px-2 py-0.5 rounded-md bg-<%= color %>-50 dark:bg-<%= color %>-500/10 text-<%= color %>-600 dark:text-<%= color %>-400 text-[9px] font-bold border border-<%= color %>-100 dark:border-<%= color %>-500/20">
                                                            <%= q.questionType %>
                                                        </span>
                                                </td>
                                                <td class="px-6 py-3 whitespace-nowrap">
                                                    <div class="flex flex-col">
                                                        <span
                                                            class="text-[10px] font-bold text-slate-700 dark:text-slate-300">
                                                            <%= q.board || '---' %>
                                                        </span>
                                                        <span class="text-[8px] font-bold text-slate-400">
                                                            <%= q.year || '' %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-3 whitespace-nowrap"><span
                                                        class="text-[10px] font-bold text-primary">
                                                        <%= q.subject || 'General' %>
                                                    </span></td>
                                                <td
                                                    class="px-6 py-3 whitespace-nowrap font-bold text-slate-500 dark:text-slate-400 text-[10px]">
                                                    Class: <%= q.classLevel %>
                                                </td>
                                                <td class="px-6 py-3 whitespace-nowrap">
                                                    <% if (q.accessType==='Paid' ) { %>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-bold border border-amber-100 dark:border-amber-500/20">Paid</span>
                                                        <% } else { %>
                                                            <span
                                                                class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-bold border border-emerald-100 dark:border-emerald-500/20">Free</span>
                                                            <% } %>
                                                </td>
                                                <td class="px-6 py-3 whitespace-nowrap">
                                                    <div class="flex items-center gap-2">
                                                        <div
                                                            class="size-6 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
                                                            <% if (q.addedBy && q.addedBy.profileImage) { %>
                                                                <img src="<%= q.addedBy.profileImage %>"
                                                                    class="size-full object-cover"
                                                                    onerror="this.src='/images/default-avatar.png';">
                                                                <% } else { %>
                                                                    <span class="text-[9px] font-bold text-slate-400">
                                                                        <%= (q.addedBy && q.addedBy.name ?
                                                                            q.addedBy.name[0].toUpperCase() : 'A' ) %>
                                                                    </span>
                                                                    <% } %>
                                                        </div>
                                                        <span
                                                            class="text-[10px] font-bold text-slate-400 truncate max-w-[80px]">
                                                            <%= q.addedBy ? q.addedBy.name : 'System' %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="pr-4 py-3 whitespace-nowrap border-0 text-right">
                                                    <div class="flex items-center justify-end gap-1">
                                                        <button
                                                            onclick="event.stopPropagation(); viewQuestion('<%= q._id %>')"
                                                            class="size-8 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm group"
                                                            title="View Details">
                                                            <span
                                                                class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">visibility</span>
                                                        </button>
                                                        <button
                                                            onclick="event.stopPropagation(); deleteQuestion('<%= q._id %>')"
                                                            class="size-8 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm group"
                                                            title="Delete">
                                                            <span
                                                                class="material-symbols-rounded text-sm group-hover:scale-110 transition-transform">delete</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination Bar (Responsive) -->
                            <div
                                class="px-3 sm:px-4 py-2.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                <p class="text-[10px] font-bold text-slate-500">Page <%= filters.page %> of <%=
                                            filters.totalPages %>
                                </p>
                                <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5">
                                    <% for(var i=1; i<=filters.totalPages; i++) { %>
                                        <a href="?page=<%= i %>&q=<%= encodeURIComponent(filters.q) %>&type=<%= encodeURIComponent(filters.type) %>&class=<%= encodeURIComponent(filters.class) %>&board=<%= encodeURIComponent(filters.board) %>&subject=<%= encodeURIComponent(filters.subject) %>&access=<%= encodeURIComponent(filters.access) %>"
                                            class="size-7 rounded-lg flex items-center justify-center text-[10px] font-bold <%= filters.page === i ? 'bg-primary text-white shadow-md shadow-primary/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200' %> transition-all shrink-0">
                                            <%= i %>
                                        </a>
                                        <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Floating Bulk Action Bar -->
                        <div id="bulkActions"
                            class="fixed bottom-20 sm:bottom-24 lg:bottom-6 left-1/2 -translate-x-1/2 z-50 hidden bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 backdrop-blur-md px-3.5 py-2 rounded-2xl shadow-2xl flex items-center gap-2.5 border border-slate-700/60 dark:border-slate-200 text-xs font-bold transition-all">
                            <div class="flex items-center gap-1.5">
                                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-[11px] whitespace-nowrap"><span id="selectedCount">0</span>
                                    selected</span>
                            </div>
                            <div class="h-3.5 w-px bg-white/20 dark:bg-black/20"></div>
                            <button type="button" onclick="handleBulkAction('delete')"
                                class="px-2 py-1 rounded-lg bg-rose-500/20 text-rose-300 dark:text-rose-600 hover:bg-rose-500/30 transition-all flex items-center gap-1 text-[11px] cursor-pointer">
                                <span class="material-symbols-rounded text-sm">delete</span>
                                <span>Delete</span>
                            </button>
                            <button type="button" onclick="clearSelection()"
                                class="size-6 rounded-full hover:bg-white/10 dark:hover:bg-black/10 flex items-center justify-center text-slate-400 dark:text-slate-500 cursor-pointer"
                                title="Cancel selection">
                                <span class="material-symbols-rounded text-sm">close</span>
                            </button>
                        </div>

                        <!-- Mobile bottom spacer to guarantee bottom-nav clearance -->
                        <div class="h-24 sm:h-28 lg:hidden shrink-0"></div>
                </div>
                <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>

    <!-- Question Details Drawer (View + Inline Edit) -->
    <!-- View & Edit Modal -->
    <div id="viewModal" class="fixed inset-0 z-[200] hidden">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-xs" onclick="closeModal()"></div>
        <div
            class="absolute inset-y-0 right-0 w-full sm:max-w-[560px] bg-white dark:bg-[#0b1120] shadow-2xl animate-slide-left border-l border-slate-200/80 dark:border-white/5">
            <div class="h-full flex flex-col overflow-hidden">
                <!-- Modal Header -->
                <div
                    class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-100 dark:border-white/5 flex items-center justify-between bg-white dark:bg-[#0b1120]">
                    <div class="flex items-center gap-2.5">
                        <div
                            class="size-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded text-lg">visibility</span>
                        </div>
                        <h2 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white" id="modalTitle">
                            Question details</h2>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button id="modalEditBtn"
                            class="h-8 px-3 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium flex items-center gap-1.5 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all cursor-pointer">
                            <span class="material-symbols-rounded text-[16px]">edit</span>
                            <span>Edit</span>
                        </button>
                        <button onclick="closeModal()"
                            class="size-8 rounded-lg hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors flex items-center justify-center cursor-pointer">
                            <span class="material-symbols-rounded text-[18px]">close</span>
                        </button>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto custom-scrollbar">
                    <!-- VIEW MODE CONTAINER -->
                    <div id="viewModeContainer" class="p-4 sm:p-6 space-y-4 sm:space-y-5">
                        <!-- Top Meta Badges -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <span id="modalType"
