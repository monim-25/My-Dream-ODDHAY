                }
            }
        }
        window.setWizCompLanguage = setWizCompLanguage;

        const additionalClasses = new Set();
        const crossClassCache = new Map();
        let crossClassCheckTimer = null;

        function checkCrossClassFast() {
            clearTimeout(crossClassCheckTimer);
            const subject = (document.getElementById('wizSubject')?.value || '').trim();
            const primaryClass = (document.getElementById('wizClass')?.value || '').trim();
            const chapter = (document.getElementById('wizChapter')?.value || '').trim();
            const topic = (document.getElementById('wizTopic')?.value || '').trim();
            const box = document.getElementById('crossClassSuggestionBox');
            const chipsContainer = document.getElementById('suggestedClassChips');

            if (!subject || (!chapter && !topic)) {
                if (box) box.classList.add('hidden');
                if (chipsContainer) chipsContainer.innerHTML = '';
                return;
            }

            const currentClassList = [primaryClass, ...Array.from(additionalClasses)].filter(Boolean);
            const cacheKey = `${subject}__${chapter}__${topic}__${currentClassList.sort().join(',')}`;

            if (crossClassCache.has(cacheKey)) {
                renderClassSuggestions(crossClassCache.get(cacheKey));
                return;
            }

            crossClassCheckTimer = setTimeout(async () => {
                try {
                    const params = new URLSearchParams({
                        subject,
                        chapter,
                        topic,
                        currentClasses: currentClassList.join(',')
                    });
                    const res = await fetch(`/teacher/api/topics/cross-class-check?${params.toString()}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data && data.success) {
                        crossClassCache.set(cacheKey, data.matchingClasses || []);
                        renderClassSuggestions(data.matchingClasses || []);
                    }
                } catch (e) {
                    console.warn('Cross-class check failed:', e);
                }
            }, 80);
        }
        window.checkCrossClassFast = checkCrossClassFast;

        function renderClassSuggestions(matchingClasses) {
            const box = document.getElementById('crossClassSuggestionBox');
            const chipsContainer = document.getElementById('suggestedClassChips');
            if (!box || !chipsContainer) return;

            const primaryClass = (document.getElementById('wizClass')?.value || '').trim().toLowerCase();
            const unaddedClasses = (matchingClasses || []).filter(c => {
                const cClean = String(c).trim();
                const cNorm = cClean.toLowerCase().replace(/^class\s+/i, '');
                const pNorm = primaryClass.replace(/^class\s+/i, '');
                const isAlready = Array.from(additionalClasses).some(ac => ac.toLowerCase().replace(/^class\s+/i, '') === cNorm);
                return cNorm !== pNorm && !isAlready;
            });

            if (unaddedClasses.length === 0) {
                box.classList.add('hidden');
                chipsContainer.innerHTML = '';
                return;
            }

            chipsContainer.innerHTML = '';
            unaddedClasses.forEach(c => {
                const cStr = String(c).trim();
                const label = cStr.toLowerCase().startsWith('class') ? cStr : `Class ${cStr}`;
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-white dark:bg-slate-800 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-600/50 hover:bg-amber-50 dark:hover:bg-amber-500/20 shadow-2xs transition-all cursor-pointer active:scale-95';
                chip.innerHTML = `<span class="material-symbols-rounded text-sm">add_circle</span><span>${label}</span>`;
                chip.onclick = () => addAdditionalClass(label);
                chipsContainer.appendChild(chip);
            });

            box.classList.remove('hidden');
        }

        function addAdditionalClass(cLabel) {
            additionalClasses.add(cLabel);
            updateSelectedClassesUI();
            checkCrossClassFast();
        }
        window.addAdditionalClass = addAdditionalClass;

        function removeAdditionalClass(cLabel) {
            additionalClasses.delete(cLabel);
            updateSelectedClassesUI();
            checkCrossClassFast();
        }
        window.removeAdditionalClass = removeAdditionalClass;

        function updateSelectedClassesUI() {
            const wrap = document.getElementById('additionalClassesWrap');
            const container = document.getElementById('selectedClassesBadges');
            const primaryClass = (document.getElementById('wizClass')?.value || '').trim();
            if (!wrap || !container) return;

            if (additionalClasses.size === 0) {
                wrap.classList.add('hidden');
                container.innerHTML = '';
                return;
            }

            wrap.classList.remove('hidden');
            container.innerHTML = '';

            if (primaryClass) {
                const pSpan = document.createElement('span');
                pSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700';
                pSpan.innerText = primaryClass + ' (Primary)';
                container.appendChild(pSpan);
            }

            additionalClasses.forEach(c => {
                const cSpan = document.createElement('span');
                cSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-primary/10 text-primary border border-primary/20';
                cSpan.innerHTML = `<span>${c}</span><button type="button" onclick="removeAdditionalClass('${c}')" class="size-3.5 flex items-center justify-center hover:text-rose-500 cursor-pointer text-xs font-bold leading-none">&times;</button>`;
                container.appendChild(cSpan);
            });
