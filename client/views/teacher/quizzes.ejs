<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Exam Center | ODDHAY Teacher Panel</title>
    <style>
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        </style>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'quizzes' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617] flex flex-col h-full h-[100dvh] overflow-hidden">
            <%- include('header', { pageTitle: 'Exam Intelligence' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-28 sm:pb-32 lg:pb-0">
                <!-- Exam Stats Grid (Compact 2x2 on mobile, 4-col on desktop) -->
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-1.5 sm:gap-2">
                        <!-- Card 1: Total Exams -->
                        <div class="p-1 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-2 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5 min-w-0">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-blue-600 dark:text-blue-400 truncate">Total Exams</p>
                                    <h3 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= filters.totalQuizzes %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">quiz</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Model Tests -->
                        <div onclick="window.location.href='?type=model'" class="p-1 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs cursor-pointer hover:border-slate-300 dark:hover:border-slate-700 transition-all">
                            <div class="p-2 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5 min-w-0">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-amber-600 dark:text-amber-400 truncate">Model Tests</p>
                                    <h3 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.modelTestCount || 0 %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">psychology</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: Course Exams -->
                        <div onclick="window.location.href='?type=course'" class="p-1 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs cursor-pointer hover:border-slate-300 dark:hover:border-slate-700 transition-all">
                            <div class="p-2 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5 min-w-0">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-emerald-600 dark:text-emerald-400 truncate">Course Exams</p>
                                    <h3 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.courseExamCount || 0 %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">auto_stories</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 4: Question Pool -->
                        <div class="p-1 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-2 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5 min-w-0">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-purple-600 dark:text-purple-400 truncate">Question Pool</p>
                                    <h3 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= stats.totalQuestions || 0 %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">help</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Exam Inventory (PERFECTLY ATTACHED WITH BORDER) -->
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-none">
                    <!-- Filters: Mobile View (< sm) -->
                    <div class="sm:hidden sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-3 py-2 border-b border-slate-200 dark:border-slate-800 space-y-2">
                        <!-- Top Row: Compact Search + New Exam Button -->
                        <div class="flex items-center gap-2 w-full">
                            <form action="" method="GET" class="relative flex-1 min-w-0">
                                <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search exams..." 
                                       class="w-full pl-8 pr-3 h-8.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-xs font-normal outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400">
                                <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
                                <input type="hidden" name="type" value="<%= filters.type || '' %>">
                                <input type="hidden" name="class" value="<%= filters.class || '' %>">
                                <input type="hidden" name="subject" value="<%= filters.subject || '' %>">
                            </form>
                            <a href="/teacher/make-quiz" class="h-8.5 px-3 rounded-xl bg-primary hover:bg-blue-600 text-white font-medium text-xs shadow-xs flex items-center gap-1 shrink-0 transition-colors">
                                <span class="material-symbols-rounded text-base">add_task</span>
                                <span>Exam</span>
                            </a>
                        </div>

                        <!-- Bottom Row: 3 Custom In-System Dropdown Filters Side-by-Side -->
                        <div class="grid grid-cols-3 gap-1.5 w-full">
                            <% 
                                const activeType = filters.type || 'all';
                                const typeLabel = activeType === 'model' ? 'Model Test' : (activeType === 'course' ? 'Course' : 'All Types');
                                
                                const activeClass = filters.class || 'all';
                                const classLabel = activeClass === 'all' ? 'All Classes' : (activeClass.includes('Class') ? activeClass : 'Class ' + activeClass);
                                
                                const activeSubject = filters.subject || 'all';
                                const subjectLabel = activeSubject === 'all' ? 'All Subjects' : activeSubject;
                            %>

                            <!-- Type In-System Dropdown (Mobile) -->
                            <div class="relative system-dropdown" id="dropdown-type-mobile">
                                <button type="button" onclick="toggleSystemDropdown('type-mobile', event)" 
                                        class="w-full h-8 px-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 flex items-center justify-between gap-0.5 text-[11px] font-medium text-slate-800 dark:text-slate-100 transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate"><%= typeLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-type-mobile" class="hidden absolute top-full left-0 mt-1.5 w-max min-w-full max-w-[170px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="applyFilter('type', 'all')" 
                                         class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Types</span>
                                        <% if (activeType === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <div onclick="applyFilter('type', 'model')" 
                                         class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'model' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>Model Test</span>
                                        <% if (activeType === 'model') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <div onclick="applyFilter('type', 'course')" 
                                         class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'course' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>Course</span>
                                        <% if (activeType === 'course') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Class In-System Dropdown (Mobile) -->
                            <div class="relative system-dropdown" id="dropdown-class-mobile">
                                <button type="button" onclick="toggleSystemDropdown('class-mobile', event)" 
                                        class="w-full h-8 px-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 flex items-center justify-between gap-0.5 text-[11px] font-medium text-slate-800 dark:text-slate-100 transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate"><%= classLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-class-mobile" class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-1.5 w-max min-w-full max-w-[170px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="applyFilter('class', 'all')" 
                                         class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeClass === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Classes</span>
                                        <% if (activeClass === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% (classes || []).forEach(cls => { %>
                                        <div onclick="applyFilter('class', '<%= cls %>')" 
                                             class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeClass === cls ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= cls.includes('Class') ? cls : 'Class ' + cls %></span>
                                            <% if (activeClass === cls) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Subject In-System Dropdown (Mobile) -->
                            <div class="relative system-dropdown" id="dropdown-subject-mobile">
                                <button type="button" onclick="toggleSystemDropdown('subject-mobile', event)" 
                                        class="w-full h-8 px-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 flex items-center justify-between gap-0.5 text-[11px] font-medium text-slate-800 dark:text-slate-100 transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate"><%= subjectLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-subject-mobile" class="hidden absolute top-full right-0 mt-1.5 w-max min-w-full max-w-[180px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="applyFilter('subject', 'all')" 
                                         class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeSubject === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Subjects</span>
                                        <% if (activeSubject === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% (subjects || []).forEach(sub => { %>
                                        <div onclick="applyFilter('subject', '<%= sub %>')" 
                                             class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeSubject === sub ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= sub %></span>
                                            <% if (activeSubject === sub) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>

                        <!-- Sub-bar: Matches Count & Quick Select -->
                        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 px-0.5 pt-0.5">
                            <span class="font-medium"><%= filters.totalQuizzes %> exams found</span>
                            <% if (quizzes && quizzes.length > 0) { %>
                                <label class="flex items-center gap-1.5 cursor-pointer select-none">
                                    <input type="checkbox" id="selectAllMobile" onchange="selectAllRows(this.checked)" class="size-3.5 rounded border-slate-300 text-blue-600 focus:ring-0">
                                    <span class="text-[10.5px]">Select All</span>
                                </label>
                            <% } %>
                        </div>
                    </div>

                    <!-- Filters: Desktop View (>= sm) (In-System Custom Dropdowns on Desktop) -->
                    <div class="hidden sm:flex sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-4 sm:px-6 py-2.5 border-b border-slate-200 dark:border-slate-800 flex-wrap items-center justify-between gap-3 shadow-2xs">
                        <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[280px]">
                            <!-- Search -->
                            <form action="" method="GET" class="relative flex-1 min-w-[180px] max-w-sm flex items-center">
                                <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search exams..." 
                                       class="w-full pl-3 pr-9 h-9 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-all">
                                <span class="material-symbols-rounded absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
                                <input type="hidden" name="type" value="<%= filters.type || '' %>">
                                <input type="hidden" name="class" value="<%= filters.class || '' %>">
                                <input type="hidden" name="subject" value="<%= filters.subject || '' %>">
                            </form>

                            <!-- Type In-System Dropdown (Desktop) -->
                            <div class="relative w-36 system-dropdown" id="dropdown-type-desktop">
                                <button type="button" onclick="toggleSystemDropdown('type-desktop', event)" 
                                        class="w-full h-9 px-3 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold flex items-center justify-between gap-1 text-slate-800 dark:text-slate-100 transition-all cursor-pointer">
                                    <span class="truncate"><%= typeLabel %></span>
                                    <span class="material-symbols-rounded text-base text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-type-desktop" class="hidden absolute top-full left-0 mt-1.5 w-full min-w-[150px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all">
                                    <div onclick="applyFilter('type', 'all')" 
                                         class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'all' ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Types</span>
                                        <% if (activeType === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <div onclick="applyFilter('type', 'model')" 
                                         class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'model' ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>Model Test</span>
                                        <% if (activeType === 'model') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <div onclick="applyFilter('type', 'course')" 
                                         class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeType === 'course' ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>Course</span>
                                        <% if (activeType === 'course') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Subject In-System Dropdown (Desktop) -->
                            <div class="relative w-36 system-dropdown" id="dropdown-subject-desktop">
                                <button type="button" onclick="toggleSystemDropdown('subject-desktop', event)" 
                                        class="w-full h-9 px-3 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold flex items-center justify-between gap-1 text-slate-800 dark:text-slate-100 transition-all cursor-pointer">
                                    <span class="truncate"><%= subjectLabel %></span>
                                    <span class="material-symbols-rounded text-base text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-subject-desktop" class="hidden absolute top-full left-0 mt-1.5 w-max min-w-full max-w-[200px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all max-h-60 overflow-y-auto no-scrollbar">
                                    <div onclick="applyFilter('subject', 'all')" 
                                         class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeSubject === 'all' ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Subjects</span>
                                        <% if (activeSubject === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% (subjects || []).forEach(sub => { %>
                                        <div onclick="applyFilter('subject', '<%= sub %>')" 
                                             class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeSubject === sub ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= sub %></span>
                                            <% if (activeSubject === sub) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Class In-System Dropdown (Desktop) -->
                            <div class="relative w-36 system-dropdown" id="dropdown-class-desktop">
                                <button type="button" onclick="toggleSystemDropdown('class-desktop', event)" 
                                        class="w-full h-9 px-3 rounded-lg bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs font-semibold flex items-center justify-between gap-1 text-slate-800 dark:text-slate-100 transition-all cursor-pointer">
                                    <span class="truncate"><%= classLabel %></span>
                                    <span class="material-symbols-rounded text-base text-slate-400 transition-transform duration-200 dropdown-arrow shrink-0">expand_more</span>
                                </button>
                                <div id="dropdown-menu-class-desktop" class="hidden absolute top-full left-0 mt-1.5 w-max min-w-full max-w-[200px] rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 transition-all max-h-60 overflow-y-auto no-scrollbar">
                                    <div onclick="applyFilter('class', 'all')" 
                                         class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeClass === 'all' ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All Classes</span>
                                        <% if (activeClass === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% (classes || []).forEach(cls => { %>
                                        <div onclick="applyFilter('class', '<%= cls %>')" 
                                             class="px-3 py-2 text-xs font-semibold cursor-pointer rounded-lg mx-1 flex items-center justify-between transition-colors <%= activeClass === cls ? 'bg-primary/10 text-primary font-bold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= cls.includes('Class') ? cls : 'Class ' + cls %></span>
                                            <% if (activeClass === cls) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Found Items Counter -->
                            <div class="h-9 px-3 bg-primary/10 border border-primary/20 rounded-lg flex items-center">
                                <span class="text-xs font-bold text-primary">Found <%= filters.totalQuizzes %> Matches</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button onclick="exportQuizzesToCSV()" class="h-9 px-3 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-xs border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5 cursor-pointer">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                            <a href="/teacher/make-quiz" class="h-9 px-3.5 rounded-lg bg-primary text-white font-bold text-xs shadow-2xs flex items-center gap-1.5 hover:bg-blue-600 transition-all">
                                <span class="material-symbols-rounded text-sm">add_task</span> New Exam
                            </a>
                        </div>
                    </div>

                    <!-- ==================== MOBILE QUIZ CARDS (< md) ==================== -->
                    <div class="md:hidden p-2 sm:p-3 space-y-2">
                        <% if (!quizzes || quizzes.length === 0) { %>
                            <div class="py-12 px-4 text-center">
                                <div class="size-12 rounded-2xl bg-indigo-50 dark:bg-indigo-500/10 text-indigo-500 flex items-center justify-center mx-auto mb-3">
                                    <span class="material-symbols-rounded text-2xl">quiz</span>
                                </div>
                                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200">No exams found</h4>
                                <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">Try clearing search filters or create a new assessment.</p>
                                <a href="/teacher/make-quiz" class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary text-white rounded-lg text-xs font-medium">
                                    <span class="material-symbols-rounded text-sm">add_task</span> Create Exam
                                </a>
                            </div>
                        <% } else { %>
                            <% quizzes.forEach(quiz => { 
                                const isModelTest = !quiz.course;
                            %>
                                <div class="p-3 bg-white dark:bg-[#0f172a] rounded-xl border border-slate-200/90 dark:border-slate-800/90 shadow-2xs space-y-2.5 quiz-mobile-card">
                                    <!-- Header: Icon, Title, Type Badge -->
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                            <div class="size-9 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center text-indigo-500 border border-indigo-100 dark:border-indigo-500/20 shrink-0">
                                                <span class="material-symbols-rounded text-lg">psychology</span>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <h4 class="text-xs font-semibold text-slate-900 dark:text-white truncate"><%= quiz.title %></h4>
                                                <div class="flex items-center gap-1.5 mt-0.5 text-[10px] text-slate-500 dark:text-slate-400">
                                                    <span><%= quiz.course ? quiz.course.classLevel : (quiz.classLevel || 'Class N/A') %></span>
                                                    <span>•</span>
                                                    <span class="truncate max-w-[130px]"><%= quiz.course ? quiz.course.subject : (quiz.subject || 'All Subjects') %></span>
                                                </div>
                                            </div>
                                        </div>
                                        <span class="text-[9.5px] font-medium px-2 py-0.5 rounded-md shrink-0 <%= isModelTest ? 'bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400 border border-amber-200/60' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 border border-emerald-200/60' %>">
                                            <%= isModelTest ? 'Model Test' : 'Course' %>
                                        </span>
                                    </div>

                                    <!-- Meta Metrics Pill Row -->
                                    <div class="grid grid-cols-3 gap-1 py-1.5 px-2 bg-slate-50 dark:bg-slate-900/60 rounded-lg text-center">
                                        <div>
                                            <span class="text-slate-400 dark:text-slate-500 text-[9px] block">Questions</span>
                                            <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200"><%= quiz.questions.length %> Qs</span>
                                        </div>
                                        <div>
                                            <span class="text-slate-400 dark:text-slate-500 text-[9px] block">Duration</span>
                                            <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200"><%= quiz.duration %> min</span>
                                        </div>
                                        <div>
                                            <span class="text-slate-400 dark:text-slate-500 text-[9px] block">Attempts</span>
                                            <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200"><%= quiz.attemptsCount || 0 %></span>
                                        </div>
                                    </div>

                                    <!-- Action Row -->
                                    <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800/60">
                                        <label class="flex items-center gap-1.5 cursor-pointer text-[10.5px] font-medium text-slate-500 select-none">
                                            <input type="checkbox" name="itemSelect" value="<%= quiz._id %>" id="cb-mobile-<%= quiz._id %>" onchange="toggleSelection(this)" class="item-cb size-3.5 rounded border-slate-300 text-blue-600 focus:ring-0">
                                            <span>Select</span>
                                        </label>
                                        
                                        <div class="flex items-center gap-1.5">
                                            <a href="/teacher/quiz-details/<%= quiz._id %>" class="px-2.5 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-medium flex items-center gap-1 hover:bg-blue-100 transition-colors" title="Preview">
                                                <span class="material-symbols-rounded text-sm">visibility</span>
                                                <span>Preview</span>
                                            </a>
                                            <a href="/teacher/quiz/<%= quiz._id %>" class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-medium flex items-center gap-1 hover:bg-slate-200 transition-colors" title="Edit">
                                                <span class="material-symbols-rounded text-sm">edit</span>
                                                <span>Edit</span>
                                            </a>
                                            <button type="button" onclick="deleteQuiz('<%= quiz._id %>')" class="size-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center hover:bg-rose-100 transition-colors" title="Delete">
                                                <span class="material-symbols-rounded text-[17px]">delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>

                    <!-- ==================== DESKTOP TABLE (>= md) (Preserved exactly for large screens) ==================== -->
                    <div class="hidden md:block table-wrapper">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-white dark:bg-[#0f172a] border-b border-slate-100 dark:border-white/5 sticky top-[48px] z-20">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Exam Name</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Class</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Type</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Subject</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Course</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Questions</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Attempts</th>
                                    <th class="px-3 py-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-left">Duration</th>
                                    <th class="pr-4 py-2 text-right text-[11px] font-semibold text-slate-500 dark:text-slate-400">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                                <% quizzes.forEach(quiz => { 
                                    const isModelTest = !quiz.course;
                                %>
                                    <tr class="quiz-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group"
                                        data-title="<%= quiz.title.toLowerCase() %>"
                                        ondblclick="toggleRowSelection('<%= quiz._id %>')">
                                        <td class="pl-4 pr-1 py-2" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= quiz._id %>" id="cb-<%= quiz._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-2">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center text-indigo-500 border border-indigo-100 dark:border-indigo-500/20 shadow-sm">
                                                    <span class="material-symbols-rounded text-lg">psychology</span>
                                                </div>
                                                <p class="text-[11px] font-bold text-slate-900 dark:text-white leading-tight truncate max-w-[180px]"><%= quiz.title %></p>
                                            </div>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-600 dark:text-slate-400">
                                                <%= quiz.course ? quiz.course.classLevel : (quiz.classLevel || '---') %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2">
                                            <span class="text-[10px] font-bold <%= isModelTest ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400' %>">
                                                <%= isModelTest ? 'Model test' : 'Course' %>
                                            </span>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate max-w-[150px]">
                                                <%= quiz.course ? quiz.course.subject : (quiz.subject || '---') %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2">
                                            <p class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate max-w-[150px]">
                                                <%= quiz.course ? quiz.course.title : '---' %>
                                            </p>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="inline-flex items-center justify-center size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[11px] font-bold border border-blue-100 dark:border-blue-500/20"><%= quiz.questions.length %></span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="inline-flex items-center justify-center size-8 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[11px] font-bold"><%= quiz.attemptsCount || 0 %></span>
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <span class="text-[10px] font-bold text-slate-600 dark:text-slate-400"><%= quiz.duration %> min</span>
                                        </td>
                                        <td class="pr-4 py-2">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <a href="/teacher/quiz-details/<%= quiz._id %>" class="size-8 rounded-md bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Preview">
                                                    <span class="material-symbols-rounded text-[18px]">visibility</span>
                                                </a>
                                                <a href="/teacher/quiz/<%= quiz._id %>" class="size-8 rounded-md bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-primary transition-all flex items-center justify-center shadow-sm" title="Edit">
                                                    <span class="material-symbols-rounded text-[18px]">edit</span>
                                                </a>
                                                <button onclick="deleteQuiz('<%= quiz._id %>')" class="size-8 rounded-md bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Delete">
                                                    <span class="material-symbols-rounded text-[18px]">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 bg-white dark:bg-[#0f172a] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <p class="text-[10px] font-medium text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-1 overflow-x-auto max-w-[200px] sm:max-w-none no-scrollbar">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&type=<%= filters.type || 'all' %>&class=<%= filters.class || 'all' %>&subject=<%= filters.subject || 'all' %>&q=<%= filters.q || '' %>"
                                    class="size-7 rounded-md flex items-center justify-center text-[10px] font-medium <% if(filters.page === i) { %> bg-primary text-white <% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 <% } %> transition-all shrink-0">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Bulk Action Bar (elevated bottom on mobile to clear bottom-nav) -->
                    <div id="bulkActions" class="hidden fixed sm:sticky bottom-20 sm:bottom-4 left-4 right-4 sm:left-auto sm:right-auto bg-white/95 dark:bg-slate-800/95 backdrop-blur-xl text-slate-800 dark:text-white px-4 sm:px-6 py-3 flex items-center justify-between z-50 animate-slide-up border border-slate-200 dark:border-slate-700 mx-auto max-w-lg rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/50">
                        <div class="flex items-center gap-3 sm:gap-6">
                            <div class="flex items-center gap-2">
                                <div class="size-7 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-rounded text-primary text-base">check_circle</span>
                                </div>
                                <span class="text-xs font-semibold tracking-tight">Selected <span id="selectedCount" class="text-primary">0</span></span>
                            </div>
                            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                            <div class="flex items-center gap-2">
                                <button onclick="selectAllRows(true)" class="text-[10px] font-medium text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-700 px-2 py-1 rounded-md">Select All</button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="handleBulkAction('delete')" class="h-8 px-3.5 bg-rose-500 text-white rounded-lg text-xs font-medium hover:bg-rose-600 transition-all shadow-sm">Delete</button>
                            <button onclick="clearSelection()" class="h-8 px-3 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-xs font-medium hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('bottom-nav', { activePage: 'written-evaluations' }) %>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();

        function toggleSelectAll() {
            const isChecked = document.getElementById('selectAll').checked;
            selectAllRows(isChecked);
        }

        function selectAllRows(force) {
            const cbs = document.querySelectorAll('.item-cb');
            cbs.forEach(cb => {
                cb.checked = force;
                if(force) selectedItems.add(cb.value);
                else selectedItems.delete(cb.value);
            });
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = force;
            const selectAllMobile = document.getElementById('selectAllMobile');
            if(selectAllMobile) selectAllMobile.checked = force;
            updateBulkUI();
        }

        function toggleRowSelection(id) {
            const cb = document.getElementById(`cb-${id}`);
            if (cb) {
                cb.checked = !cb.checked;
                toggleSelection(cb);
            }
        }

        function toggleSelection(el) {
            const val = el.value;
            const isChecked = el.checked;
            if(isChecked) selectedItems.add(val);
            else selectedItems.delete(val);

            // Sync both mobile and desktop checkboxes for this quiz
            document.querySelectorAll(`.item-cb[value="${val}"]`).forEach(cb => cb.checked = isChecked);

            // Update desktop and mobile Select All status
            const uniqueTotal = new Set(Array.from(document.querySelectorAll('.item-cb')).map(cb => cb.value)).size;
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = uniqueTotal > 0 && uniqueTotal === selectedItems.size;
            const selectAllMobile = document.getElementById('selectAllMobile');
            if(selectAllMobile) selectAllMobile.checked = uniqueTotal > 0 && uniqueTotal === selectedItems.size;

            updateBulkUI();
        }

        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            if(selectedItems.size > 0) {
                bar.classList.remove('hidden');
                countEl.innerText = selectedItems.size;
            } else { bar.classList.add('hidden'); }
        }

        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            const selectAllCb = document.getElementById('selectAll');
            if(selectAllCb) selectAllCb.checked = false;
            const selectAllMobile = document.getElementById('selectAllMobile');
            if(selectAllMobile) selectAllMobile.checked = false;
            updateBulkUI();
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({
                title: 'Bulk Action',
                text: `Are you sure you want to ${action} ${selectedItems.size} exams?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#137fec'
            });
            if (!res.isConfirmed) return;
            
            try {
                const response = await fetch('/teacher/quizzes/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        function deleteQuiz(id) {
            Swal.fire({
                title: 'Delete Exam?',
                text: 'This quiz and all its questions will be removed forever.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                confirmButtonText: 'Yes, delete it'
            }).then((result) => {
                if (result.isConfirmed) window.location.href = `/teacher/quiz/${id}/delete`;
            });
        }

        // In-System Custom Dropdown Controller
        function toggleSystemDropdown(name, e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const menu = document.getElementById('dropdown-menu-' + name);
            const parent = document.getElementById('dropdown-' + name);
            if (!menu) return;

            const isHidden = menu.classList.contains('hidden');
            closeAllSystemDropdowns();

            if (isHidden) {
                menu.classList.remove('hidden');
                if (parent) {
                    const arrow = parent.querySelector('.dropdown-arrow');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }
        window.toggleSystemDropdown = toggleSystemDropdown;

        function closeAllSystemDropdowns() {
            document.querySelectorAll('.system-dropdown').forEach(d => {
                const menu = d.querySelector('[id^="dropdown-menu-"]');
                const arrow = d.querySelector('.dropdown-arrow');
                if (menu) menu.classList.add('hidden');
                if (arrow) arrow.style.removeProperty('transform');
            });
        }
        window.closeAllSystemDropdowns = closeAllSystemDropdowns;

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.system-dropdown')) {
                closeAllSystemDropdowns();
            }
        });

        function applyFilter(key, val) {
            const params = new URLSearchParams(window.location.search);
            if (val === 'all' || !val) {
                params.delete(key);
            } else {
                params.set(key, val);
            }
            params.delete('page');
            const str = params.toString();
            window.location.href = str ? ('?' + str) : window.location.pathname;
        }
        window.applyFilter = applyFilter;

        function exportQuizzesToCSV() {
            const rows = [['Exam Title', 'Type', 'Course', 'Questions', 'Attempts', 'Duration']];
            document.querySelectorAll('.quiz-row').forEach(row => {
                if (row.style.display !== 'none') {
                    const cells = row.querySelectorAll('td');
                    rows.push([
                        cells[1].querySelector('p').innerText,
                        cells[2].innerText.trim(),
                        cells[3].querySelector('p').innerText.trim(),
                        cells[4].querySelector('span').innerText,
                        cells[5].querySelector('span').innerText,
                        cells[6].querySelector('span').innerText
                    ]);
                }
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "teacher_exams.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
