        <div class="bg-white dark:bg-[#0f172a] rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl border border-slate-200 dark:border-white/10 relative flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 dark:border-white/5 flex-shrink-0">
                <div class="flex items-center gap-3">
                    <div class="size-9 rounded-xl bg-primary/10 flex items-center justify-center border border-primary/20">
                        <span class="material-symbols-rounded text-primary text-[20px]">upload_file</span>
                    </div>
                    <div>
                        <h3 class="text-[15px] font-bold text-slate-900 dark:text-white tracking-tight">Upload Note Material</h3>
                        <p class="text-[10px] font-bold text-slate-400">Add a new lecture note or study PDF document</p>
                    </div>
                </div>
                <button onclick="document.getElementById('addNoteModal').classList.add('hidden')" class="size-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-all">
                    <span class="material-symbols-rounded text-[18px]">close</span>
                </button>
            </div>
            <div class="overflow-y-auto flex-1">
                <form id="addNoteForm" action="/teacher/add-note" method="POST" enctype="multipart/form-data" class="divide-y divide-slate-100 dark:divide-white/5">
                    <input type="hidden" id="noteParentFolderId" name="parentFolderId" value="">
                    <div class="p-6 space-y-4">
                        <div>
                            <label class="form-label">Title <span class="text-rose-500">*</span></label>
                            <input type="text" name="title" required placeholder="e.g., Physics Handnote — Vector Chapter" class="form-input w-full">
