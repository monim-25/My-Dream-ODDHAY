                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="form-label">Subject <span class="text-rose-500">*</span></label>
                                <select name="subject" id="noteSubject" required class="form-input w-full cursor-pointer">
                                    <option value="">Select subject</option>
                                    <% subList.forEach(s => { %>
                                        <option value="<%= s %>"><%= s %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Class Level <span class="text-rose-500">*</span></label>
                                <select name="classLevel" id="noteClassLevel" required class="form-input w-full cursor-pointer">
                                    <% const classOptions = (locals.classes && locals.classes.length > 0) ? locals.classes : ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'HSC 1st Year', 'HSC 2nd Year', 'Admission']; %>
