<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Notes | ODDHAY Command Center</title>
    <style>
                :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        

        .form-label {
            display: block;
            font-size: 11px;
            font-weight: 500;
            color: #64748b;
            margin-bottom: 4px;
        }

        .dark .form-label {
            color: #94a3b8;
        }

        .form-input {
            height: 40px;
            width: 100%;
            padding: 0 12px;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            font-size: 13px;
            font-weight: 500;
            color: #1e293b;
            outline: none;
            transition: border-color 0.2s;
        }

        .dark .form-input {
            background: #0f172a;
            border-color: rgba(255, 255, 255, 0.08);
            color: #e2e8f0;
        }

        .form-input:focus {
            border-color: #137fec;
        }

        /* Notes List Mode Overrides for Perfect Organization */
        body.notes-list-mode .notes-grid-container,
        body.notes-list-mode #chapters-grid,
        body.notes-list-mode #subject-folders-section > div {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.375rem !important;
        }

        body.notes-list-mode .subject-folder-card,
        body.notes-list-mode .chapter-folder-card {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            text-align: left !important;
            padding: 0.5rem 0.85rem !important;
            gap: 0.75rem !important;
            border-radius: 0.625rem !important;
        }

        body.notes-list-mode .subject-folder-card > div:first-child,
        body.notes-list-mode .chapter-folder-card > div:first-child {
            margin-bottom: 0 !important;
            width: 2.25rem !important;
            height: 2.25rem !important;
            border-radius: 0.5rem !important;
            flex-shrink: 0 !important;
        }

        body.notes-list-mode .subject-folder-card > div:last-child {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex: 1 !important;
            min-width: 0 !important;
            text-align: left !important;
        }

        body.notes-list-mode .note-card {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 0.5rem 0.85rem !important;
            gap: 0.75rem !important;
            border-radius: 0.625rem !important;
        }

        body.notes-list-mode .note-card > div:first-child {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 0.75rem !important;
            min-width: 0 !important;
            flex: 1 !important;
            margin-bottom: 0 !important;
        }

        body.notes-list-mode .note-card > div:first-child > div:first-child {
            margin-bottom: 0 !important;
            width: 2.25rem !important;
            height: 2.25rem !important;
            border-radius: 0.5rem !important;
        }

        body.notes-list-mode .note-card h3 {
            margin-bottom: 0 !important;
            font-size: 0.8125rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-width: 340px !important;
        }

        body.notes-list-mode .note-card p {
            display: none !important;
        }

        body.notes-list-mode .note-card > div:last-child {
            padding-top: 0 !important;
            border-top: none !important;
            flex-shrink: 0 !important;
            margin-top: 0 !important;
        }

        body.notes-list-mode .hidden,
        body.notes-list-mode .subject-folder-card.hidden,
        body.notes-list-mode .chapter-folder-card.hidden,
        body.notes-list-mode .note-card.hidden,
        body.notes-list-mode #chapters-container.hidden,
        body.notes-list-mode #folders-container.hidden,
        body.notes-list-mode #notes-content-container.hidden,
        body.notes-list-mode #notes-grid-view.hidden {
            display: none !important;
        }

        body.notes-list-mode #empty-folder-state:not(.hidden),
        body.notes-list-mode #no-notes-found:not(.hidden) {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
        }
    </style>
</head>

<body class="bg-white dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'notes' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 bg-white dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Notes' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-28 sm:pb-32 lg:pb-0">
                
                <% 
                   const noteList = locals.notes || []; 
                   const cFolders = locals.courseFolders || []; 
                   const subList = locals.subjects || []; 
                   const classList = locals.classes || [];
                   const activeClass = locals.activeClass || 'all';
                   const activeSubject = locals.activeSubject || 'all'; 
                   const activeCourseId = locals.activeCourseId || null; 
                   const statsData = locals.stats || {};
                %>

                <!-- Sticky Navigation Bar: Filter, Compact Search & Action Buttons -->
                <div class="sticky top-0 z-20 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur border-b border-slate-200/80 dark:border-slate-800/80 px-2.5 sm:px-3 py-2 shadow-none">
                    <div class="flex items-center justify-between gap-2 w-full">
                        
                        <!-- Left Group: Filter (Class Selector OR Breadcrumbs) + Compact Search Bar -->
                        <div class="flex items-center gap-2 min-w-0">
                            <!-- Filter: Class Selector -->
                            <div id="folder-selector-wrapper" class="<%= (activeClass !== 'all' || activeCourseId) ? 'hidden' : '' %> flex items-center shrink-0">
                                <select name="class" onchange="window.location.href='/teacher/notes?class=' + encodeURIComponent(this.value)" class="w-[100px] xs:w-[115px] sm:w-[145px] px-2 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-xs font-medium text-slate-700 dark:text-slate-200 rounded-xl outline-none cursor-pointer shrink-0">
                                    <option value="all" <%= activeClass === 'all' ? 'selected' : '' %>>All Classes</option>
                                    <% classList.forEach(function(c) { %>
                                        <option value="<%= c %>" <%= activeClass === c ? 'selected' : '' %>><%= c %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Filter: Breadcrumb Navigation Bar -->
                            <div id="breadcrumb-bar" class="<%= (activeClass !== 'all' || activeCourseId) ? '' : 'hidden' %> flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-300 shrink-0">
                                <a href="/teacher/notes" class="px-2 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-600 dark:text-slate-300 rounded-xl transition-colors flex items-center gap-1 shrink-0 font-medium">
                                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">arrow_back</span>
                                    <span class="text-xs">All</span>
                                </a>
                                <span class="text-slate-300 dark:text-slate-600">/</span>
                                <span id="breadcrumb-title" class="font-medium text-slate-700 dark:text-slate-200 flex items-center gap-1 truncate max-w-[75px] xs:max-w-[110px] sm:max-w-none">
                                    <span class="truncate"><%= activeClass !== 'all' ? activeClass : 'Course Files' %></span>
                                </span>
                            </div>

                            <!-- Compact Search Input (Properly padded so icon never overlaps text) -->
                            <div class="relative w-32 xs:w-40 sm:w-48 md:w-56 shrink-0">
                                <input type="text" id="notes-search-input" placeholder="Search notes..." autocomplete="off"
                                    style="padding-left: 32px; padding-right: 28px;"
                                    class="w-full py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-xs font-medium text-slate-700 dark:text-slate-200 rounded-xl outline-none focus:border-blue-500 transition-all placeholder:text-slate-400">
                                <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-base leading-none flex items-center justify-center pointer-events-none select-none">search</span>
                                <button type="button" id="clear-notes-search" onclick="clearNotesSearch()" class="hidden absolute right-2 top-1/2 -translate-y-1/2 size-4 text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center cursor-pointer select-none">
                                    <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">cancel</span>
                                </button>
                            </div>
                        </div>

                        <!-- Right Group: Action Buttons (Folder & Note - prominent icons for easy touch) -->
                        <div id="header-action-buttons" class="<%= (activeSubject !== 'all' || activeCourseId) ? '' : 'hidden' %> flex items-center gap-1.5 shrink-0 ml-auto">
                            <button type="button" onclick="openAddFolderModal()" class="size-9 sm:size-auto sm:px-3 sm:py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-xs font-medium transition-all shadow-xs flex items-center justify-center sm:gap-1.5 shrink-0 cursor-pointer active:scale-95" title="New Folder">
                                <span class="material-symbols-rounded text-[20px] sm:text-[21px] leading-none pointer-events-none">create_new_folder</span>
                                <span class="hidden sm:inline">Folder</span>
                            </button>
                            <button type="button" onclick="openAddNoteModal()" class="size-9 sm:size-auto sm:px-3 sm:py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-medium transition-all shadow-xs flex items-center justify-center sm:gap-1.5 shrink-0 cursor-pointer active:scale-95" title="Add Note">
                                <span class="material-symbols-rounded text-[20px] sm:text-[21px] leading-none pointer-events-none">upload_file</span>
                                <span class="hidden sm:inline">Add Note</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- MAIN WORKSPACE CONTENT CONTAINER -->
                <div class="p-3 sm:p-4 space-y-3 flex-1 bg-white dark:bg-[#0f172a] min-h-[calc(100vh-65px)]">
                    
                    <!-- Search No Results State -->
                    <div id="no-notes-found" class="hidden min-h-[calc(100vh-120px)] w-full bg-white dark:bg-[#0f172a] p-6 sm:p-12 flex flex-col items-center justify-center text-center shadow-none">
                        <div class="size-16 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-center mb-3 text-slate-400">
                            <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">search_off</span>
                        </div>
                        <h3 class="text-base font-bold text-slate-800 dark:text-white">No Notes Found</h3>
                        <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                            Try refining your search keyword or selecting a different folder.
                        </p>
                        <button onclick="clearNotesSearch()" class="mt-4 px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold inline-flex items-center gap-1.5 transition-all">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">refresh</span> Reset Search
                        </button>
                    </div>

                    <!-- LEVEL 0: FOLDERS GRID VIEW (Assigned Class Folders) -->
                    <% if (classList.length > 0) { %>
                        <div id="folders-container" class="<%= (activeClass === 'all' && !activeCourseId) ? '' : 'hidden' %> space-y-4">
                            <!-- Class Folders Grid -->
                            <div id="subject-folders-section">
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
                                    <% classList.forEach(function(cls) { %>
                                        <% 
                                           const count = noteList.filter(n => {
                                               if (!n.classLevel) return false;
                                               if (Array.isArray(n.classLevel)) return n.classLevel.includes(cls);
                                               return n.classLevel === cls;
                                           }).length; 
                                        %>
                                        <a href="/teacher/notes?class=<%= encodeURIComponent(cls) %>"
                                           class="subject-folder-card bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 hover:border-primary/50 dark:hover:border-primary/50 rounded-xl p-3.5 sm:p-4 flex flex-col items-center justify-center text-center transition-all duration-200 group shadow-none space-y-2"
                                           data-search="<%= cls.toLowerCase().replace(/"/g, '&quot;') %>">
                                            <div class="size-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                                                <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">school</span>
                                            </div>
                                            <div class="w-full min-w-0">
                                                <h4 class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 truncate group-hover:text-blue-600 transition-colors">
                                                    <%= cls %>
                                                </h4>
                                            </div>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- LEVEL 1 & 2: DYNAMIC CHAPTER FOLDERS & NOTES CONTAINER -->
                    <div id="notes-content-container" class="<%= (activeClass !== 'all' || activeCourseId) ? '' : 'hidden' %> space-y-3">
                        
                        <!-- CHAPTER FOLDERS SECTION -->
                        <div id="chapters-container" class="hidden">
                            <div id="chapters-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
                                <!-- Chapter Cards Rendered via JS -->
                            </div>
                        </div>

                        <!-- NOTES GRID VIEW -->
                        <div id="notes-grid-view">
                            <div id="empty-folder-state" class="hidden min-h-[calc(100vh-120px)] w-full bg-white dark:bg-[#0f172a] p-6 sm:p-12 flex flex-col items-center justify-center text-center shadow-none">
                                <div class="size-16 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-center mb-3 text-slate-400">
                                    <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">folder_off</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-800 dark:text-white">No Notes Found</h3>
                                <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                                    No notes uploaded to this folder yet.
                                </p>
                                <button type="button" onclick="openAddNoteModal()" class="mt-4 px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl text-xs font-bold inline-flex items-center gap-1.5 shadow-sm transition-all cursor-pointer">
                                    <span class="material-symbols-rounded text-sm leading-none">upload_file</span>
                                    <span>Add Note</span>
                                </button>
                            </div>

                            <% if (noteList.length > 0) { %>
                            <div class="notes-grid-container grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3">
                                <% noteList.forEach(function(note) { %>
                                    <% 
                                       const title = note.title || 'Untitled Note';
                                       const subject = note.subject || 'General Academic';
                                       const classLevelStr = Array.isArray(note.classLevel) ? note.classLevel.join(', ') : (note.classLevel || 'General');
                                       const fileUrl = note.filePath || note.fileUrl || note.url || '#';
                                       const isPdf = fileUrl.toLowerCase().endsWith('.pdf');
                                       const isPaid = (note.accessType || '').toLowerCase() === 'paid';
                                       const authorName = note.addedBy ? note.addedBy.name : (note.author || 'Instructor');
                                       const courseTitle = note.course ? (note.course.title || note.course) : null;
                                       const searchableText = [title, subject, classLevelStr, authorName, courseTitle || '', note.chapter || note.chapterTitle || ''].join(' ').toLowerCase();

                                       const noteAuthorId = note.addedBy ? String(note.addedBy._id || note.addedBy) : '';
                                       const isNoteOwner = Boolean(user && user._id && String(user._id) === noteAuthorId);
                                    %>
                                    <div class="note-card relative bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-3.5 sm:p-4 flex flex-col justify-between hover:border-primary/50 dark:hover:border-primary/50 transition-all duration-200 group shadow-none"
                                         data-id="<%= note._id %>"
                                         data-search="<%= searchableText.replace(/"/g, '&quot;') %>"
                                         data-unlocked="<%= !isPaid ? 'true' : 'false' %>"
                                         data-iscourse="<%= note.course ? 'true' : 'false' %>"
                                         data-subject="<%= subject.toLowerCase().replace(/"/g, '&quot;') %>"
                                         data-class-level="<%= classLevelStr.toLowerCase().replace(/"/g, '&quot;') %>"
                                         data-chapter-name="<%= (note.chapter || note.chapterTitle || 'General Notes').replace(/"/g, '&quot;') %>"
                                         data-parent-folder-id="<%= note.parentFolderId || '' %>">
                                        
                                        <!-- Selection Checkbox -->
                                        <input type="checkbox" class="item-select-checkbox hidden absolute top-3 left-3 size-4.5 accent-primary cursor-pointer z-10" data-note-id="<%= note._id %>" data-owner="<%= isNoteOwner ? 'true' : 'false' %>" onchange="updateSelectedCount()">

                                        <div>
                                            <!-- Top 1st Line: Document Icon + Title + Class/Subject + Access Badge -->
                                            <div class="flex items-start justify-between gap-2 mb-2">
                                                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                                    <div class="size-9 rounded-xl <%= isPaid ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-600 border border-amber-200 dark:border-amber-500/20' : 'bg-primary/10 text-primary border border-primary/20' %> flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                                        <span class="material-symbols-rounded text-lg leading-none select-none"><%= isPdf ? 'picture_as_pdf' : 'description' %></span>
                                                    </div>

                                                    <div class="min-w-0 flex-1">
                                                        <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 leading-snug group-hover:text-blue-600 transition-colors truncate" title="<%= title %>">
                                                            <%= title %>
                                                        </h3>
                                                        <p class="text-[10px] font-normal text-slate-400 truncate mt-0.5 flex items-center gap-1">
                                                            <span><%= classLevelStr %></span>
                                                            <span>•</span>
                                                            <span class="text-blue-600 dark:text-blue-400 font-medium"><%= subject %></span>
                                                        </p>
                                                    </div>
                                                </div>

                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-medium shrink-0 <%= isPaid ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' %>">
                                                    <%= isPaid ? 'Paid' : 'Free' %>
                                                </span>
                                            </div>

                                            <% if (courseTitle) { %>
                                                <div class="mb-2 px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-[10px] font-semibold text-slate-600 dark:text-slate-300 flex items-center gap-1.5 truncate">
                                                    <span class="material-symbols-rounded text-xs text-primary shrink-0">school</span>
                                                    <span class="truncate"><%= courseTitle %></span>
                                                </div>
                                            <% } %>

                                            <% if (note.description) { %>
                                                <p class="text-[11px] font-medium text-slate-400 line-clamp-2 mb-2"><%= note.description %></p>
                                            <% } %>
                                        </div>

                                        <!-- Teacher Actions Footer -->
                                        <div class="pt-2.5 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                                            <span class="text-[10px] font-medium text-slate-400 truncate">
                                                By <%= authorName %>
                                            </span>

                                            <div class="flex items-center gap-1.5 shrink-0">
                                                <!-- Preview Button -->
                                                <button type="button" onclick="openNoteModal('<%= fileUrl %>', '<%= title.replace(/'/g, "\\'") %>')" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-600 dark:text-slate-300 text-[10px] font-medium transition-all flex items-center gap-1 cursor-pointer">
                                                    <span class="material-symbols-rounded text-xs leading-none">visibility</span>
                                                    <span>View</span>
                                                </button>

                                                <% if (isNoteOwner) { %>
                                                    <!-- Edit Button (Owner Only) -->
                                                    <a href="/teacher/note-details/<%= note._id %>" class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-500/10 hover:bg-blue-100 text-blue-600 dark:text-blue-400 text-[10px] font-medium transition-all flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-xs leading-none">edit</span>
                                                        <span>Edit</span>
                                                    </a>
                                                    <!-- Delete Button (Owner Only) -->
                                                    <button type="button" onclick="confirmDeleteNote(event, '<%= note._id %>')" class="p-1 rounded bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-100 text-rose-600 dark:text-rose-400 transition-all cursor-pointer" title="Delete Note">
                                                        <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">delete</span>
                                                    </button>
                                                <% } else { %>
                                                    <!-- Lock Indicator (Not Owner) -->
                                                    <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-400 text-[9px] font-semibold flex items-center gap-0.5" title="Read Only (Added by another teacher/admin)">
                                                        <span class="material-symbols-rounded text-[10px]">lock</span>
                                                        <span>Read-only</span>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
            <%- include('bottom-nav', { activePage: 'notes' }) %>
        </main>
    </div>

    <!-- PDF Viewer Modal -->
    <div id="note-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-md flex items-center justify-center p-2 sm:p-4">
        <div class="bg-white dark:bg-[#0f172a] rounded-xl w-full max-w-4xl h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800">
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="material-symbols-rounded text-primary text-xl flex items-center justify-center leading-none select-none">picture_as_pdf</span>
                    <h3 id="note-modal-title" class="text-sm font-bold text-slate-800 dark:text-white truncate">Note Document</h3>
                </div>
                <div class="flex items-center gap-2">
                    <a id="note-modal-download" href="#" download class="px-2.5 py-1 bg-primary hover:bg-primary/90 text-white rounded text-xs font-bold transition-all flex items-center gap-1 shadow-xs">
                        <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">download</span>
                        <span>Download</span>
                    </a>
                    <button onclick="closeNoteModal()" class="size-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 flex items-center justify-center transition-colors">
                        <span class="material-symbols-rounded text-base flex items-center justify-center leading-none">close</span>
                    </button>
                </div>
            </div>
            <div class="flex-1 w-full bg-slate-100 dark:bg-slate-950 relative">
                <iframe id="note-modal-frame" src="" class="w-full h-full border-none"></iframe>
            </div>
        </div>
    </div>

    <!-- Add Note Upload Modal (Clean & Minimal for Small Screens) -->
    <div id="addNoteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-[250] hidden flex items-center justify-center p-3 sm:p-4 transition-all">
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl w-full max-w-md overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 relative flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex-shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="size-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-lg leading-none">upload_file</span>
                    </div>
                    <div>
                        <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100 leading-tight">Upload Note</h3>
                    </div>
                </div>
                <button type="button" onclick="document.getElementById('addNoteModal').classList.add('hidden')" class="size-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center transition-colors cursor-pointer select-none">
                    <span class="material-symbols-rounded text-lg leading-none">close</span>
                </button>
            </div>

            <!-- Form Content -->
            <div class="overflow-y-auto flex-1 no-scrollbar">
                <form id="addNoteForm" action="/teacher/add-note" method="POST" enctype="multipart/form-data" class="flex flex-col h-full">
                    <input type="hidden" id="noteParentFolderId" name="parentFolderId" value="">
                                        <input type="hidden" name="course" id="noteCoursePicker" value="">

                    <div class="p-4 sm:p-5 space-y-3.5">
                        <!-- Target Folder Context Badge -->
                        <div id="noteFolderContextBadge" class="hidden px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-medium flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm leading-none">folder</span>
                            <span class="truncate">Folder: <span id="noteTargetFolderText" class="font-semibold"></span></span>
                        </div>

                        <!-- Note Title -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">
                                Title <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="title" required placeholder="Note title"
                                class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 outline-none focus:border-blue-500 transition-all placeholder:text-slate-400">
                        </div>

                        <!-- Target Classes Row (Multi-Class Selection - Assigned Only & Context-Locked) -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                    Target Classes <span class="text-rose-500">*</span>
                                </label>
                            </div>

                            <!-- Locked Class Card (Shown when inside a specific class folder) -->
                            <div id="noteClassLockedNotice" class="hidden flex items-center justify-between px-3 py-2 rounded-xl bg-indigo-50 dark:bg-indigo-900/25 border border-indigo-200 dark:border-indigo-800 text-xs font-semibold text-indigo-700 dark:text-indigo-300 mb-1.5">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-indigo-600 dark:text-indigo-400 leading-none">lock</span>
                                    <span>Class: <strong id="lockedClassText" class="font-bold"></strong></span>
                                </div>
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-100 dark:bg-indigo-800/60 text-indigo-800 dark:text-indigo-200 font-bold shrink-0">Current Folder</span>
                            </div>

                            <!-- Hidden field to guarantee target class POST even when checkbox container is hidden/locked -->
                            <input type="hidden" name="classLevel[]" id="noteClassHidden" value="" disabled>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 max-h-36 overflow-y-auto p-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 rounded-xl" id="noteClassesContainer">
                                <% 
                                    const strictlyAssignedClasses = (locals.assignedClasses && locals.assignedClasses.length > 0) 
                                        ? locals.assignedClasses 
                                        : ((locals.classes && locals.classes.length > 0) ? locals.classes : []);
                                %>
                                <% if (strictlyAssignedClasses.length === 0) { %>
                                    <div class="col-span-full py-2 text-center text-xs text-amber-500">
                                        No assigned classes found.
                                    </div>
                                <% } else { %>
                                    <% strictlyAssignedClasses.forEach(c => { %>
                                        <label class="note-class-card flex items-center gap-1.5 p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary/50 dark:hover:border-primary/50 bg-white dark:bg-slate-900 cursor-pointer transition-colors text-[11px] select-none">
                                            <input type="checkbox" name="classLevel[]" value="<%= c %>" class="note-class-checkbox accent-primary rounded size-3.5" onchange="onNoteSubjectOrClassChange()">
                                            <span class="font-medium text-slate-700 dark:text-slate-200 truncate"><%= c %></span>
                                        </label>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>

                        <!-- Subject Row (Assigned Only & Context-Locked) -->
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                    Subject <span class="text-rose-500">*</span>
                                </label>
                                <span id="noteSubjectBadge" class="text-[10px] font-bold text-blue-600 dark:text-blue-400 hidden"></span>
                            </div>

                            <!-- Locked Subject Card (Shown when inside a specific subject folder) -->
                            <div id="noteSubjectLockedNotice" class="hidden flex items-center justify-between px-3 py-2 rounded-xl bg-blue-50 dark:bg-blue-900/25 border border-blue-200 dark:border-blue-800 text-xs font-semibold text-blue-700 dark:text-blue-300">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-blue-600 dark:text-blue-400 leading-none">lock</span>
                                    <span>Subject: <strong id="lockedSubjectText" class="font-bold"></strong></span>
                                </div>
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-800/60 text-blue-800 dark:text-blue-200 font-bold shrink-0">Current Folder</span>
                            </div>

                            <!-- Hidden field to guarantee subject POST even when dropdown is hidden/locked -->
                            <input type="hidden" name="subject" id="noteSubjectHidden" value="">

                            <!-- Select Subject Dropdown (Visible only when not inside a subject folder) -->
                            <select id="noteSubject" onchange="onNoteSubjectSelectChange(this.value)"
                                class="w-full px-2.5 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 outline-none focus:border-blue-500 transition-all cursor-pointer">
                                <option value="">Select Subject</option>
                                <% 
                                    const strictlyAssignedSubjects = (locals.assignedSubjects && locals.assignedSubjects.length > 0) 
                                        ? locals.assignedSubjects 
                                        : (subList.length > 0 ? subList : []);
                                %>
                                <% strictlyAssignedSubjects.forEach(s => { %>
                                    <option value="<%= s %>"><%= s %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Chapter Row (Dynamic & Auto-selected / Locked from current folder) -->
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                    Chapter <span class="text-rose-500">*</span>
                                </label>
                                <span id="noteChapterBadge" class="text-[10px] font-bold text-amber-600 dark:text-amber-400"></span>
                            </div>

                            <!-- Locked Chapter Card (Shown when inside a specific chapter folder) -->
                            <div id="noteChapterLockedNotice" class="hidden flex items-center justify-between px-3 py-2 rounded-xl bg-amber-50 dark:bg-amber-900/25 border border-amber-200 dark:border-amber-800 text-xs font-semibold text-amber-700 dark:text-amber-300">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="material-symbols-rounded text-base text-amber-600 dark:text-amber-400 leading-none">lock</span>
                                    <span>Chapter: <strong id="lockedChapterText" class="font-bold"></strong></span>
                                </div>
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-800/60 text-amber-800 dark:text-amber-200 font-bold shrink-0">Current Folder</span>
                            </div>

                            <!-- Hidden chapter input to guarantee submission when dropdown is locked/hidden -->
                            <input type="hidden" name="chapter" id="noteChapterHidden" value="">

                            <!-- Select Chapter Dropdown (Visible only when not locked) -->
                            <select id="noteChapter" onchange="onNoteChapterChange(this.value)"
                                class="w-full px-2.5 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 outline-none focus:border-blue-500 transition-all cursor-pointer">
                                <option value="">Select Chapter</option>
                            </select>
                        </div>

                        <!-- Topics Section (Scoped to Selected Chapter) -->
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm text-primary">bookmark</span>
                                    <span>Select Topic(s) <span class="text-rose-500">* (Required)</span></span>
                                </label>
                                <div class="flex items-center gap-1.5">
                                    <span id="noteTopicCountBadge" class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-primary/10 text-primary hidden">0 selected</span>
                                </div>
                            </div>

                            <!-- Hidden primary topic for backward compatibility -->
                            <input type="hidden" name="topic" id="notePrimaryTopicInput" value="">

                            <div id="noteTopicsWrapper" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 min-h-[60px] max-h-40 overflow-y-auto">
                                <div id="noteTopicsEmptyState" class="py-3 text-center text-slate-400 text-xs flex flex-col items-center justify-center gap-1">
                                    <span class="material-symbols-rounded text-base text-slate-300 dark:text-slate-600">info</span>
                                    <span>Please select a Subject and Chapter above to load syllabus topics</span>
                                </div>
                                <div id="noteTopicsLoading" class="hidden py-3 text-center text-primary text-xs flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-rounded text-base animate-spin">progress_activity</span>
                                    <span>Loading syllabus topics...</span>
                                </div>
                                <div id="noteTopicsList" class="hidden flex flex-wrap gap-1.5">
                                    <!-- Dynamic Topic Checkboxes / Pills will be injected here -->
                                </div>
                            </div>
                        </div>

                        <!-- Cross-Class Auto-Sync Portal (Shown when same subject, chapter & topic exist in other classes) -->
                        <div id="crossClassSyncPortal" class="hidden p-2.5 rounded-xl bg-emerald-50/90 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 space-y-1.5 transition-all">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1.5 text-emerald-800 dark:text-emerald-300 font-bold text-xs">
                                    <span class="material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400">auto_awesome</span>
                                    <span>Architecture Matched</span>
                                </div>
                                <span class="px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200 text-[10px] font-bold">Auto-Sync</span>
                            </div>
                            <p class="text-[11px] text-emerald-700 dark:text-emerald-300/90 leading-tight">
                                Same syllabus structure found. Also save note in:
                            </p>
                            <div id="crossClassListContainer" class="flex flex-wrap gap-1.5 pt-0.5">
                                <!-- Dynamically injected cross-class checkboxes -->
                            </div>
                        </div>

                        <!-- Access Type (Managed by SuperAdmin) -->
                        <input type="hidden" name="accessType" id="noteAccessType" value="Free">

                        <!-- PDF Upload Zone -->
                        <div>
                            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">
                                PDF Document <span class="text-rose-500">*</span>
                            </label>
                            <label for="noteFileInput" id="noteFileDropzone" class="w-full flex flex-col items-center justify-center p-3.5 sm:p-4 border border-dashed border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 bg-slate-50/60 dark:bg-slate-800/40 rounded-xl transition-all cursor-pointer group text-center select-none">
                                <div id="noteFileIconBox" class="size-9 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-1.5 transition-transform">
                                    <span class="material-symbols-rounded text-xl leading-none">picture_as_pdf</span>
                                </div>
                                <div id="noteFileNamePreview" class="text-xs font-medium text-slate-600 dark:text-slate-300 truncate max-w-[230px] sm:max-w-xs">
                                    Select PDF file
                                </div>
                                <p id="noteFileSizePreview" class="text-[10px] text-slate-400 mt-0.5">
                                    Max 25MB
                                </p>
                            </label>
                            <input type="file" id="noteFileInput" name="note" accept="application/pdf" required class="sr-only" onchange="handleNoteFileSelected(this)">
                        </div>
                    </div>

                    <!-- Modal Actions Footer -->
                    <div class="px-4 py-3 bg-slate-50 dark:bg-slate-900/60 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2 shrink-0 mt-auto">
                        <button type="button" onclick="document.getElementById('addNoteModal').classList.add('hidden')" class="px-3.5 py-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-xs font-medium transition-all cursor-pointer">
                            Cancel
                        </button>
                        <button type="submit" id="addNoteSubmitBtn" class="px-4 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium transition-all flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95">
                            <span class="material-symbols-rounded text-sm leading-none">cloud_upload</span>
                            <span>Upload Note</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ADD FOLDER MODAL -->
    <div id="addFolderModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="relative w-full max-w-sm bg-white dark:bg-[#0f172a] rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <span class="size-7.5 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 border border-amber-200 dark:border-amber-500/20 flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-base leading-none select-none">create_new_folder</span>
                    </span>
                    <span>Create New Folder</span>
                </h3>
                <button type="button" onclick="document.getElementById('addFolderModal').classList.add('hidden')" class="size-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-colors cursor-pointer">
                    <span class="material-symbols-rounded text-base leading-none">close</span>
                </button>
            </div>

            <form id="addFolderForm" onsubmit="submitAddFolder(event)" class="p-3.5 sm:p-4 space-y-3">
                <input type="hidden" id="folderParentId" name="parentId" value="">
                <input type="hidden" id="folderSubject" name="subject" value="">
                <input type="hidden" id="folderClassLevel" name="classLevel" value="">
                
                <div>
                    <label class="form-label text-xs font-bold text-slate-700 dark:text-slate-300 mb-1 flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-amber-500 text-sm leading-none">folder</span>
                        <span>Folder Name</span>
                        <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="folderName" name="name" placeholder="Folder Name" required autocomplete="off"
                               class="w-full pl-9 pr-3 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 transition-all">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base leading-none select-none pointer-events-none">folder_open</span>
                    </div>
                </div>

                <div class="pt-1 flex items-center justify-end gap-2">
                    <button type="button" onclick="document.getElementById('addFolderModal').classList.add('hidden')" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-md hover:shadow-amber-500/25 transition-all flex items-center gap-1.5 cursor-pointer">
                        <span class="material-symbols-rounded text-sm leading-none">create_new_folder</span>
                        <span>Create Folder</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Custom Confirmation Modal (Replaces browser confirm popup) -->
    <div id="customConfirmModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[300] hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl max-w-sm w-full p-5 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center gap-3">
                <div id="confirm-modal-icon-wrapper" class="size-10 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-600 flex items-center justify-center border border-rose-200 dark:border-rose-500/20 shrink-0">
                    <span class="material-symbols-rounded text-xl">delete</span>
                </div>
                <div>
                    <h3 id="confirm-modal-title" class="text-sm font-bold text-slate-900 dark:text-white">Confirm Action</h3>
                    <p id="confirm-modal-subtitle" class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Please confirm your action</p>
                </div>
            </div>

