                <input type="hidden" id="folderSubject" name="subject" value="">
                <input type="hidden" id="folderClassLevel" name="classLevel" value="">
                
                <div>
                    <label class="form-label text-xs font-bold text-slate-700 dark:text-slate-300 mb-1 flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-amber-500 text-sm leading-none">folder</span>
                        <span>Folder Name</span>
                        <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="folderName" name="name" placeholder="Folder Name" required autocomplete="off"
                               class="w-full pl-9 pr-3 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 transition-all">
                        <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base leading-none select-none pointer-events-none">folder_open</span>
