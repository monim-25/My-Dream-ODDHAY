        function filterLiveNotes() {
            const searchInput = document.getElementById('notes-search-input');
            const clearBtn = document.getElementById('clear-notes-search');
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

            const folderSelectorWrapper = document.getElementById('folder-selector-wrapper');
            const foldersContainer = document.getElementById('folders-container');
            const chaptersContainer = document.getElementById('chapters-container');
            const chaptersGrid = document.getElementById('chapters-grid');
            const chaptersCounter = document.getElementById('chapters-counter');
            const notesContainer = document.getElementById('notes-content-container');
            const breadcrumbBar = document.getElementById('breadcrumb-bar');
            const breadcrumbTitle = document.getElementById('breadcrumb-title');
            const notesCounter = document.getElementById('notes-counter');
            const noResultsBox = document.getElementById('no-notes-found');
            const emptyFolderState = document.getElementById('empty-folder-state');

            if (clearBtn) {
                if (query.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            const subjectCards = document.querySelectorAll('.subject-folder-card');
            const courseCards = document.querySelectorAll('.course-folder-card');
            const noteCards = document.querySelectorAll('.note-card');

            const isInitialFiltered = <%- JSON.stringify(activeClass !== 'all' || Boolean(activeCourseId)) %>;
            const parentName = <%- JSON.stringify(activeClass !== 'all' ? activeClass : (activeCourseId ? 'Course Files' : 'Files')) %>;

            const activeCourseId = <%- JSON.stringify(activeCourseId || '') %>;
            const activeClass = <%- JSON.stringify(activeClass || 'all') %>;
            const activeSubject = <%- JSON.stringify(activeSubject || 'all') %>;
            const courseCurriculums = <%- JSON.stringify(locals.courseCurriculums || {}) %>;
            const currentParentId = window.activeFolderIdFilter;

            const headerActionBtns = document.getElementById('header-action-buttons');
            const isSubfolderOrClassOpen = (activeClass !== 'all') || Boolean(activeCourseId) || Boolean(window.activeChapterFilter) || Boolean(window.activeFolderIdFilter);

            if (headerActionBtns) {
                if (isSubfolderOrClassOpen) {
                    headerActionBtns.classList.remove('hidden');
                } else {
                    headerActionBtns.classList.add('hidden');
                }
            }

            let visibleNotesCount = 0;
            let visibleSubjectCount = 0;
            let visibleCourseCount = 0;

            const chapterMap = new Map();
            const activeClassClean = activeClass.trim().toLowerCase();

            // 1. First pass: Count notes for chapter badges (matching search & chip filter)
            noteCards.forEach(card => {
                const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                const isGeneral = !cardClass || cardClass === 'general academic' || cardClass === 'general' || cardClass === 'all';
                const matchesClass = activeClass === 'all' || !activeClassClean || isGeneral || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);
                if (!matchesClass) return;

                const isUnlocked = card.getAttribute('data-unlocked') === 'true';
                const isCourse = card.getAttribute('data-iscourse') === 'true';
                const chapName = card.getAttribute('data-chapter-name') || 'General Notes';
                const searchable = card.getAttribute('data-search') || '';

                let matchesChip = true;
                if (window.currentQuickFilter === 'free') matchesChip = isUnlocked;
                else if (window.currentQuickFilter === 'paid') matchesChip = !isUnlocked;
                else if (window.currentQuickFilter === 'course') matchesChip = isCourse;

                const matchesQuery = query.length === 0 || searchable.includes(query);

                if (matchesChip && matchesQuery) {
                    if (chapName && chapName !== 'General Notes' && chapName !== 'General Course Notes') {
                        const key = chapName.trim().toLowerCase();
                        chapterMap.set(key, (chapterMap.get(key) || 0) + 1);
                    }
                }
            });

            // 2. Build current level folders list
            const isInsideSubfolder = Boolean(window.activeFolderIdFilter || window.activeChapterFilter);
            const foldersMap = new Map();

            // Aggregate custom folders created via Folder model for this class
            if (window.customFolders && window.customFolders.length > 0) {
                window.customFolders.forEach(f => {
                    if (!f || !f.name || f.name === 'undefined' || f.name === 'null' || !f.name.trim()) return;
                    if (activeClass === 'all' && !activeCourseId) return;

                    const fClassClean = (f.classLevel || '').trim().toLowerCase();
                    const matchesClass = !activeClassClean || fClassClean === activeClassClean || fClassClean.includes(activeClassClean) || activeClassClean.includes(fClassClean);
                    if (matchesClass) {
                        if (!isInsideSubfolder) {
                            if (!f.parentId || f.parentId === 'null' || f.parentId === 'undefined' || f.parentId === '') {
                                foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: null, isSyllabusFolder: Boolean(f.isSyllabusFolder || f.isSystem) });
                            }
                        } else {
                            if (window.activeFolderIdFilter && String(f.parentId) === String(window.activeFolderIdFilter)) {
                                foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: f.parentId, isSyllabusFolder: Boolean(f.isSyllabusFolder || f.isSystem) });
                            }
                        }
                    }
                });
            }

            if (!isInsideSubfolder) {
                // COURSE ROOT LEVEL: If a specific course is open, collect top-level folders for that course
                if (activeCourseId && courseCurriculums[activeCourseId]) {
                    courseCurriculums[activeCourseId].forEach(f => {
                        if (f && f.name && f.name !== 'undefined' && f.name !== 'null' && f.name.trim() !== '' && (!f.parentId || f.parentId === 'null' || f.parentId === 'undefined' || f.parentId === '')) {
                            foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: null });
                        }
                    });
                }

                // Also include implicit chapter folders from noteCards at root level for this class
                noteCards.forEach(card => {
                    const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                    const matchesClass = activeClass === 'all' || !activeClassClean || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);
                    if (!matchesClass) return;

                    const chap = card.getAttribute('data-chapter-name');
                    if (chap && chap !== 'General Notes' && chap !== 'General Course Notes' && chap !== 'undefined' && chap !== 'null' && chap.trim() !== '') {
                        const key = chap.trim().toLowerCase();
                        if (!foldersMap.has(key)) {
                            foldersMap.set(key, { _id: null, name: chap, parentId: null });
                        }
                    }
                });
            } else {
                // INSIDE A SUB-FOLDER: Collect child sub-folders belonging to current parent folder
                if (activeCourseId && courseCurriculums[activeCourseId]) {
                    courseCurriculums[activeCourseId].forEach(f => {
                        if (f && f.name && f.name !== 'undefined' && f.name !== 'null' && f.name.trim() !== '' && window.activeFolderIdFilter && String(f.parentId) === String(window.activeFolderIdFilter)) {
                            foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: f.parentId });
                        }
                    });
                }
            }

            let currentLevelFolders = Array.from(foldersMap.values()).filter(f => 
                f && f.name && f.name.trim() !== '' && f.name !== 'undefined' && f.name !== 'null' && f.name !== 'General Notes'
            );

            // 3. Second pass: Filter note cards visibility based on current folder level
            noteCards.forEach(card => {
                const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                const isGeneral = !cardClass || cardClass === 'general academic' || cardClass === 'general' || cardClass === 'all';
                const matchesClass = activeClass === 'all' || !activeClassClean || isGeneral || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);

                if (!matchesClass) {
                    card.classList.add('hidden');
                    return;
                }

                const isUnlocked = card.getAttribute('data-unlocked') === 'true';
                const isCourse = card.getAttribute('data-iscourse') === 'true';
                const chapName = card.getAttribute('data-chapter-name') || 'General Notes';
                const parentFId = card.getAttribute('data-parent-folder-id') || '';
                const searchable = card.getAttribute('data-search') || '';

                let matchesChip = true;
                if (window.currentQuickFilter === 'free') matchesChip = isUnlocked;
                else if (window.currentQuickFilter === 'paid') matchesChip = !isUnlocked;
                else if (window.currentQuickFilter === 'course') matchesChip = isCourse;

                const matchesQuery = query.length === 0 || searchable.includes(query);

                let matchesChapter = true;
                if (window.activeFolderIdFilter) {
                    const curFolder = (window.customFolders || []).find(f => String(f._id) === String(window.activeFolderIdFilter));
                    const curChapterName = curFolder ? curFolder.name : window.activeChapterFilter;
                    matchesChapter = Boolean(parentFId && String(parentFId) === String(window.activeFolderIdFilter)) ||
                                     Boolean(curChapterName && chapName && chapName.trim().toLowerCase() === curChapterName.trim().toLowerCase());
                } else if (window.activeChapterFilter) {
                    matchesChapter = (chapName && chapName.trim().toLowerCase() === window.activeChapterFilter.trim().toLowerCase());
                } else if (isInitialFiltered) {
                    // At Course or Subject root (no folder opened yet):
                    // Hide notes that belong to any subfolder
                    const hasExplicitParentFolder = Boolean(parentFId && parentFId !== '' && parentFId !== 'null');
                    
                    const matchesFolderByName = currentLevelFolders.some(f => 
                        f.name && chapName && f.name.trim().toLowerCase() === chapName.trim().toLowerCase()
                    );

                    const matchesFolderById = currentLevelFolders.some(f => 
                        f._id && parentFId && (f._id.toString() === parentFId.toString())
                    );

                    const belongsToSubfolder = hasExplicitParentFolder || matchesFolderByName || matchesFolderById;

                    matchesChapter = !belongsToSubfolder;
                }

                if (matchesChip && matchesChapter && matchesQuery) {
                    card.classList.remove('hidden');
                    visibleNotesCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            // 4. Handle global search filtering for Subject and Course cards
            if (query.length > 0) {
                subjectCards.forEach(card => {
                    const searchable = card.getAttribute('data-search') || '';
                    if (searchable.includes(query)) {
                        card.classList.remove('hidden');
                        visibleSubjectCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                courseCards.forEach(card => {
                    const searchable = card.getAttribute('data-search') || '';
                    if (searchable.includes(query)) {
                        card.classList.remove('hidden');
                        visibleCourseCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });
            } else {
                subjectCards.forEach(card => card.classList.remove('hidden'));
                courseCards.forEach(card => card.classList.remove('hidden'));
                visibleSubjectCount = subjectCards.length;
                visibleCourseCount = courseCards.length;
            }

            const subjectSection = document.getElementById('subject-folders-section');
            if (subjectSection) {
                if (visibleSubjectCount > 0) subjectSection.classList.remove('hidden');
                else subjectSection.classList.add('hidden');
            }

            const courseSection = document.getElementById('course-folders-section');
            if (courseSection) {
                if (visibleCourseCount > 0) courseSection.classList.remove('hidden');
                else courseSection.classList.add('hidden');
            }

            const hasActiveSearchOrFilter = query.length > 0 || window.currentQuickFilter !== 'all';
            const isInsideCourseOrSubject = isInitialFiltered;

            const actionBtns = document.getElementById('header-action-buttons');

            if (!isInsideCourseOrSubject && !hasActiveSearchOrFilter) {
                // LEVEL 0: Main Subject & Course Folders View
                if (actionBtns) actionBtns.classList.add('hidden');
                if (foldersContainer) foldersContainer.classList.remove('hidden');
                if (folderSelectorWrapper) folderSelectorWrapper.classList.remove('hidden');
                if (breadcrumbBar) breadcrumbBar.classList.add('hidden');
                if (chaptersContainer) chaptersContainer.classList.add('hidden');
                if (notesContainer) notesContainer.classList.add('hidden');

                const notesGridView = document.getElementById('notes-grid-view');
                if (notesGridView) notesGridView.classList.add('hidden');
                if (emptyFolderState) emptyFolderState.classList.add('hidden');
                if (noResultsBox) noResultsBox.classList.add('hidden');

            } else {
                // LEVEL 1 & 2: Sub-Folders & Files View inside Subject or Nested Folder
                if (actionBtns) actionBtns.classList.remove('hidden');
                if (foldersContainer) foldersContainer.classList.add('hidden');
                if (folderSelectorWrapper) folderSelectorWrapper.classList.add('hidden');
                if (breadcrumbBar) breadcrumbBar.classList.remove('hidden');
                if (notesContainer) notesContainer.classList.remove('hidden');

                const breadcrumbLink = breadcrumbBar.querySelector('a');
                if (window.folderNavStack.length > 0) {
                    const currentFolder = window.folderNavStack[window.folderNavStack.length - 1];
                    const prevFolder = window.folderNavStack.length > 1 ? window.folderNavStack[window.folderNavStack.length - 2].name : parentName;
                    if (breadcrumbTitle) breadcrumbTitle.textContent = currentFolder.name;
                    if (breadcrumbLink) {
                        breadcrumbLink.setAttribute('href', '#');
                        breadcrumbLink.onclick = (e) => { e.preventDefault(); closeChapterFolder(); };
                        breadcrumbLink.querySelector('span:last-child').textContent = prevFolder;
                    }
                } else {
                    if (breadcrumbTitle) breadcrumbTitle.textContent = parentName;
                    if (breadcrumbLink) {
                        breadcrumbLink.setAttribute('href', '/teacher/notes');
                        breadcrumbLink.onclick = null;
                        breadcrumbLink.querySelector('span:last-child').textContent = 'All Folders';
                    }
                }

                // Render Sub-folders if available at current level
                if (currentLevelFolders && currentLevelFolders.length > 0) {
                    if (chaptersContainer) chaptersContainer.classList.remove('hidden');
                    if (chaptersGrid) {
                        chaptersGrid.innerHTML = '';
                        currentLevelFolders.forEach(f => {
                            const chapName = f.name;
                            const cardEl = document.createElement('div');
                            cardEl.className = 'chapter-folder-card relative bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 hover:border-amber-500/50 rounded-xl p-3.5 flex items-center justify-between transition-all duration-200 group shadow-none cursor-pointer';
                            cardEl.onclick = () => {
                                openChapterFolder(chapName, f._id);
                            };

                            let deleteBtnHtml = '';
                            // Only allow delete button on user-created custom folders, NOT on auto-generated syllabus folders
                            if (f._id && !f.isSyllabusFolder) {
                                deleteBtnHtml = `
                                    <button type="button" onclick="deleteCustomFolder(event, '${f._id}')" class="size-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/10 flex items-center justify-center transition-all z-10 shrink-0 cursor-pointer" title="Delete Folder">
                                        <span class="material-symbols-rounded text-base leading-none">delete</span>
                                    </button>
                                `;
                            }

                            cardEl.innerHTML = `
                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                    <div class="size-10 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-500 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                        <span class="material-symbols-rounded text-xl leading-none select-none">folder</span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white truncate group-hover:text-amber-500 transition-colors">
                                            ${chapName}
                                        </h4>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1 shrink-0">
                                    ${deleteBtnHtml}
                                    <span class="material-symbols-rounded text-slate-300 dark:text-slate-600 group-hover:text-amber-500 group-hover:translate-x-0.5 transition-all text-xl leading-none select-none">chevron_right</span>
                                </div>
                            `;
                            chaptersGrid.appendChild(cardEl);
                        });
                    }
                } else {
                    if (chaptersContainer) chaptersContainer.classList.add('hidden');
                    if (chaptersGrid) chaptersGrid.innerHTML = '';
                }

                // Render Files container if matching notes exist or show empty state if no subfolders exist
                const notesGridView = document.getElementById('notes-grid-view');
                if (visibleNotesCount > 0) {
                    if (notesGridView) notesGridView.classList.remove('hidden');
                    if (emptyFolderState) emptyFolderState.classList.add('hidden');
                    if (noResultsBox) noResultsBox.classList.add('hidden');
                } else {
                    if (query.length > 0) {
                        if (notesGridView) notesGridView.classList.add('hidden');
                        if (emptyFolderState) emptyFolderState.classList.add('hidden');
                        if (noResultsBox) noResultsBox.classList.remove('hidden');
                    } else {
                        if (currentLevelFolders && currentLevelFolders.length > 0) {
                            if (notesGridView) notesGridView.classList.add('hidden');
                            if (emptyFolderState) emptyFolderState.classList.add('hidden');
                            if (noResultsBox) noResultsBox.classList.add('hidden');
                        } else {
                            if (notesGridView) notesGridView.classList.remove('hidden');
                            if (emptyFolderState) emptyFolderState.classList.remove('hidden');
                            if (noResultsBox) noResultsBox.classList.add('hidden');
                        }
                    }
                }
            }
        }

        function clearNotesSearch() {
            const searchInput = document.getElementById('notes-search-input');
            if (searchInput) {
                searchInput.value = '';
                filterLiveNotes();
                searchInput.focus();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.body.classList.remove('notes-list-mode');
            filterLiveNotes();

            const searchInput = document.getElementById('notes-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', filterLiveNotes);
            }

            // Note Topics and Multi-Class Logic
            window.selectNoteClasses = function(type) {
                const cbs = document.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]');
                if (type === 'all') {
                    cbs.forEach(cb => cb.checked = true);
                } else if (type === 'clear') {
                    cbs.forEach(cb => cb.checked = false);
                } else if (type === 'ssc') {
                    cbs.forEach(cb => {
                        const val = cb.value.toLowerCase();
                        cb.checked = (val.includes('9') || val.includes('10') || val.includes('ssc'));
                    });
                } else if (type === 'hsc') {
                    cbs.forEach(cb => {
                        const val = cb.value.toLowerCase();
                        cb.checked = (val.includes('11') || val.includes('12') || val.includes('hsc'));
                    });
                }
                cbs.forEach(cb => {
                    const card = cb.closest('.note-class-card');
                    if (card) {
                        if (cb.checked) card.classList.add('bg-primary/10', 'border-primary', 'text-primary');
                        else card.classList.remove('bg-primary/10', 'border-primary', 'text-primary');
                    }
                });
                onNoteSubjectOrClassChange();
            };

            async function fetchTopicsSafely(subject, classList) {
                const endpoints = ['/teacher/api/topics', '/api/topics', '/topics'];
                const query = new URLSearchParams({
                    subject: subject,
                    classLevels: classList.join(',')
                }).toString();

                for (const ep of endpoints) {
                    try {
                        const res = await fetch(ep + '?' + query, {
                            method: 'GET',
                            headers: { 'Accept': 'application/json' }
                        });
                        if (!res.ok) continue;
                        const contentType = res.headers.get('content-type') || '';
                        if (!contentType.includes('application/json')) continue;
                        const json = await res.json();
                        if (json && (json.success || Array.isArray(json.topics))) return json;
                    } catch (e) {
                        console.warn('Endpoint error for ' + ep + ':', e);
                    }
                }
                return { success: true, count: 0, topics: [], chapters: [] };
            }

            window.onNoteSubjectSelectChange = function(val) {
                const subjectHidden = document.getElementById('noteSubjectHidden');
                if (subjectHidden) subjectHidden.value = val;
                onNoteSubjectOrClassChange();
            };

            window.onNoteSubjectOrClassChange = async function() {
                const subjectHidden = document.getElementById('noteSubjectHidden');
                const subjSelect = document.getElementById('noteSubject');
                const subject = (subjectHidden && subjectHidden.value) ? subjectHidden.value.trim() : (subjSelect ? subjSelect.value.trim() : '');
                
                const classHidden = document.getElementById('noteClassHidden');
                let checkedClasses = [];
                if (classHidden && !classHidden.disabled && classHidden.value) {
                    checkedClasses = [classHidden.value.trim()];
                } else {
                    checkedClasses = Array.from(document.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]:checked')).map(cb => cb.value.trim());
                }

                // Sync card borders
                document.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]').forEach(cb => {
                    const card = cb.closest('.note-class-card');
                    if (card) {
                        if (cb.checked) card.classList.add('bg-primary/10', 'border-primary', 'text-primary');
                        else card.classList.remove('bg-primary/10', 'border-primary', 'text-primary');
                    }
                });

                const chapterSelect = document.getElementById('noteChapter');
                const topicDropdown = document.getElementById('noteTopicDropdown');
                const emptyState = document.getElementById('noteTopicsEmptyState');
                const loadingState = document.getElementById('noteTopicsLoading');
                const topicsList = document.getElementById('noteTopicsList');
                const countBadge = document.getElementById('noteTopicCountBadge');
                const syncPortal = document.getElementById('crossClassSyncPortal');

                if (syncPortal) syncPortal.classList.add('hidden');

                if (!subject || checkedClasses.length === 0) {
                    if (chapterSelect) {
                        chapterSelect.innerHTML = '<option value="">Select Chapter</option>';
                    }
                    if (topicDropdown) {
                        topicDropdown.innerHTML = '<option value="">Select a Topic from Chapter</option>';
                    }
                    if (emptyState) {
                        emptyState.classList.remove('hidden');
                        emptyState.innerHTML = '<span class="material-symbols-rounded text-base text-slate-300 dark:text-slate-600">info</span><span>Please select a Subject and at least one Class to load syllabus chapters</span>';
                    }
                    if (loadingState) loadingState.classList.add('hidden');
                    if (topicsList) {
                        topicsList.classList.add('hidden');
                        topicsList.innerHTML = '';
                    }
                    if (countBadge) countBadge.classList.add('hidden');
                    return;
                }

                if (emptyState) emptyState.classList.add('hidden');
                if (loadingState) loadingState.classList.remove('hidden');
                if (topicsList) {
                    topicsList.classList.add('hidden');
                    topicsList.innerHTML = '';
                }

                try {
                    const data = await fetchTopicsSafely(subject, checkedClasses);
                    window._cachedSyllabusTopics = (data && Array.isArray(data.topics)) ? data.topics : [];

                    // Populate Chapters Dropdown
                    if (chapterSelect) {
                        const chaptersMap = new Map();
                        (window._cachedSyllabusTopics || []).forEach(t => {
                            if (t.chapter && t.chapter.name && t.chapter.name.trim()) {
                                const cName = t.chapter.name.trim();
                                const cNum = typeof t.chapter.number === 'number' ? t.chapter.number : (parseInt(t.chapter.number, 10) || 1);
                                if (!chaptersMap.has(cName.toLowerCase())) {
                                    chaptersMap.set(cName.toLowerCase(), { name: cName, number: cNum });
                                }
                            }
                        });
                        (data.chapters || []).forEach(cName => {
                            if (cName && typeof cName === 'string' && cName.trim() && !chaptersMap.has(cName.trim().toLowerCase())) {
                                chaptersMap.set(cName.trim().toLowerCase(), { name: cName.trim(), number: 999 });
                            }
                        });

                        const sortedChapters = Array.from(chaptersMap.values()).sort((a, b) => a.number - b.number);
                        chapterSelect.innerHTML = '<option value="">Select Chapter</option>';
                        sortedChapters.forEach(ch => {
                            const opt = document.createElement('option');
                            opt.value = ch.name;
                            opt.textContent = ch.name;
                            chapterSelect.appendChild(opt);
                        });

                        // Auto-select chapter if opening from within a chapter folder
                        if (window._initialNoteChapter) {
                            const targetChap = window._initialNoteChapter.trim().toLowerCase();
                            const matched = sortedChapters.find(c => c.name.toLowerCase() === targetChap);
                            if (matched) {
                                chapterSelect.value = matched.name;
                            } else {
                                const customOpt = document.createElement('option');
                                customOpt.value = window._initialNoteChapter;
                                customOpt.textContent = window._initialNoteChapter + ' (Current Folder)';
                                chapterSelect.appendChild(customOpt);
                                chapterSelect.value = window._initialNoteChapter;
                            }
                        }
                    }

                    if (loadingState) loadingState.classList.add('hidden');
                    window.onNoteChapterChange();
                } catch (err) {
                    console.error('Failed to load syllabus:', err);
                    if (loadingState) loadingState.classList.add('hidden');
                    window.onNoteChapterChange();
                }
            };

            function isSameChapterClient(c1, c2) {
                if (!c1 || !c2) return false;
                const a = String(c1).trim().toLowerCase();
                const b = String(c2).trim().toLowerCase();
                if (a === b) return true;
                const norm = (s) => s.replace(/^(?:অধ্যায়|অধ্যায়|chapter|ch)[\s\d:.-]+/i, '').replace(/\([^\)]*\)/g, '').replace(/[\s\-_:]+/g, ' ').trim();
                const na = norm(a);
                const nb = norm(b);
                if (na && nb && (na === nb || na.includes(nb) || nb.includes(na))) return true;
                return false;
            }

            window.onNoteChapterChange = function(val) {
                const chapterSelect = document.getElementById('noteChapter');
                const chapterHidden = document.getElementById('noteChapterHidden');
                if (val && chapterHidden) {
                    chapterHidden.value = val;
                }
                const selectedChapter = (val || (chapterHidden && chapterHidden.value) || (chapterSelect ? chapterSelect.value : '')).trim();

                const emptyState = document.getElementById('noteTopicsEmptyState');
                const loadingState = document.getElementById('noteTopicsLoading');
                const topicsList = document.getElementById('noteTopicsList');
                const syncPortal = document.getElementById('crossClassSyncPortal');
                const badge = document.getElementById('noteChapterBadge');

                if (badge) {
                    badge.textContent = selectedChapter ? selectedChapter : '';
                }
                if (syncPortal) syncPortal.classList.add('hidden');

                if (!selectedChapter) {
                    if (emptyState) {
                        emptyState.classList.remove('hidden');
                        emptyState.innerHTML = '<span class="material-symbols-rounded text-base text-slate-300 dark:text-slate-600">info</span><span>Please select a Chapter to view available topics</span>';
                    }
                    if (topicsList) {
                        topicsList.classList.add('hidden');
                        topicsList.innerHTML = '';
                    }
                    syncNoteTopicSelection();
                    return;
                }

                // Filter topics by selected chapter using flexible matcher
                const allTopics = window._cachedSyllabusTopics || [];
                const chapterTopics = allTopics.filter(t => t.chapter && t.chapter.name && isSameChapterClient(t.chapter.name, selectedChapter));

                if (chapterTopics.length > 0) {
                    renderNoteTopics(chapterTopics);
                } else {
                    if (topicsList) {
                        topicsList.classList.add('hidden');
                        topicsList.innerHTML = '';
                    }
                    if (emptyState) {
                        emptyState.classList.remove('hidden');
                        emptyState.innerHTML = '<div class="flex flex-col items-center gap-1.5 py-2.5 text-center">' +
                            '<span class="material-symbols-rounded text-amber-500 text-xl">playlist_remove</span>' +
                            '<span class="text-xs font-semibold text-slate-700 dark:text-slate-200">No approved topics found for this chapter</span>' +
                            '<span class="text-[11px] text-slate-400 max-w-xs">Please add topics to this chapter in the Syllabus first.</span>' +
                            '<a href="/teacher/topics" target="_blank" class="inline-flex items-center gap-1 mt-1 px-2.5 py-1 rounded-lg bg-primary text-white text-[11px] font-bold hover:bg-primary/90 transition-all"><span class="material-symbols-rounded text-xs">add</span> Add Syllabus Topics</a>' +
                            '</div>';
                    }
                    syncNoteTopicSelection();
                }
            };
            window.onNoteChapterSelectChange = window.onNoteChapterChange; // Backward compat alias

            window.onNoteTopicChipChange = function(cb) {
                const chip = cb ? cb.closest('.topic-select-chip') : null;
                if (chip && cb) {
                    if (cb.checked) {
                        chip.classList.add('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
                    } else {
                        chip.classList.remove('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
                    }
                }
                syncNoteTopicSelection();
            };

            function renderNoteTopics(topics) {
                const topicsList = document.getElementById('noteTopicsList');
                const emptyState = document.getElementById('noteTopicsEmptyState');
                if (!topicsList) return;
                topicsList.innerHTML = '';

                const seen = new Set();
                const uniqueTopics = [];
                topics.forEach(t => {
                    const key = (t.name || '').trim().toLowerCase();
                    if (key && !seen.has(key)) {
                        seen.add(key);
                        uniqueTopics.push(t);
                    }
                });

                uniqueTopics.forEach(t => {
                    const tName = (t.name || '').trim();
                    const chip = document.createElement('label');
                    chip.className = 'topic-select-chip flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/60 dark:hover:border-primary/60 bg-white dark:bg-slate-900 cursor-pointer text-xs select-none transition-all';
                    chip.innerHTML = '<input type="checkbox" name="topics[]" value="' + escapeHtml(tName) + '" data-chapter="' + escapeHtml(t.chapter?.name || '') + '" class="note-topic-checkbox accent-primary rounded size-4 cursor-pointer" onchange="onNoteTopicChipChange(this)">' +
                        '<span class="font-medium text-slate-700 dark:text-slate-200 text-xs leading-tight">' + escapeHtml(tName) + '</span>';
                    topicsList.appendChild(chip);
                });

                if (emptyState) emptyState.classList.add('hidden');
                topicsList.classList.remove('hidden');
                syncNoteTopicSelection();
            }

            window.syncNoteTopicSelection = function() {
                const primaryInput = document.getElementById('notePrimaryTopicInput');
                const badge = document.getElementById('noteTopicCountBadge');
                const checkedBoxes = Array.from(document.querySelectorAll('#noteTopicsList input[name="topics[]"]:checked'));

                if (badge) {
                    if (checkedBoxes.length > 0) {
                        badge.textContent = checkedBoxes.length + ' selected';
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                if (checkedBoxes.length > 0) {
                    const selectedTopicNames = checkedBoxes.map(b => b.value.trim()).filter(Boolean);
                    if (primaryInput) primaryInput.value = selectedTopicNames[0] || '';

                    const subjectHidden = document.getElementById('noteSubjectHidden');
                    const subjSelect = document.getElementById('noteSubject');
                    const subject = (subjectHidden && subjectHidden.value) ? subjectHidden.value.trim() : (subjSelect ? subjSelect.value.trim() : '');

                    const chapterHidden = document.getElementById('noteChapterHidden');
                    const chapterSelect = document.getElementById('noteChapter');
                    const chapter = (chapterHidden && chapterHidden.value) ? chapterHidden.value.trim() : (chapterSelect ? chapterSelect.value.trim() : '');

                    const classHidden = document.getElementById('noteClassHidden');
                    let checkedClasses = [];
                    if (classHidden && !classHidden.disabled && classHidden.value) {
                        checkedClasses = [classHidden.value.trim()];
                    } else {
                        checkedClasses = Array.from(document.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]:checked')).map(cb => cb.value.trim());
                    }

                    checkAndRenderCrossClassSync(subject, selectedTopicNames, chapter, checkedClasses);
                } else {
                    if (primaryInput) primaryInput.value = '';
                    const syncPortal = document.getElementById('crossClassSyncPortal');
                    if (syncPortal) syncPortal.classList.add('hidden');
                }

                document.querySelectorAll('.topic-select-chip').forEach(chip => {
                    const cb = chip.querySelector('input[type="checkbox"]');
                    if (cb && cb.checked) {
                        chip.classList.add('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
                    } else {
                        chip.classList.remove('bg-primary/5', 'dark:bg-primary/15', 'border-primary', 'dark:border-primary');
                    }
                });
            };

            async function checkAndRenderCrossClassSync(subject, topicNames, chapterName, checkedClasses) {
                const portal = document.getElementById('crossClassSyncPortal');
                const container = document.getElementById('crossClassListContainer');
                if (!portal || !container) return;

                const topicsParam = Array.isArray(topicNames) ? topicNames.join(',') : String(topicNames || '').trim();
                if (!subject || !topicsParam) {
                    portal.classList.add('hidden');
                    container.innerHTML = '';
                    return;
                }

                try {
                    const query = new URLSearchParams({
                        subject: subject,
                        topic: topicsParam,
                        chapter: chapterName || '',
                        currentClasses: checkedClasses.join(',')
                    }).toString();

                    let res = await fetch('/api/topics/cross-class-check?' + query, {
                        headers: { 'Accept': 'application/json' }
                    }).catch(() => null);

                    if (!res || !res.ok) {
                        res = await fetch('/teacher/api/topics/cross-class-check?' + query, {
                            headers: { 'Accept': 'application/json' }
                        }).catch(() => null);
                    }

                    if (!res || !res.ok) {
                        portal.classList.add('hidden');
                        return;
                    }

                    const data = await res.json();
                    if (data && data.success && data.hasCrossClass && Array.isArray(data.details) && data.details.length > 0) {
                        container.innerHTML = '';
                        data.details.forEach(item => {
                            const label = document.createElement('label');
                            label.className = 'flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-emerald-300 dark:border-emerald-700 text-xs font-semibold text-slate-800 dark:text-slate-100 cursor-pointer shadow-xs hover:border-emerald-500 transition-colors select-none';
                            label.innerHTML = '<input type="checkbox" name="syncClasses[]" value="' + escapeHtml(item.classLevel) + '" checked class="accent-emerald-600 rounded size-3.5 cursor-pointer">' +
                                '<span class="font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1"><span class="material-symbols-rounded text-sm">school</span>' + escapeHtml(item.classLevel) + '</span>' +
                                '<span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal truncate max-w-[140px]">(' + escapeHtml(item.chapterName || '') + ')</span>';
                            container.appendChild(label);
                        });
                        portal.classList.remove('hidden');
                    } else {
                        portal.classList.add('hidden');
                        container.innerHTML = '';
                    }
                } catch (e) {
                    console.warn('Cross-class check failed:', e);
                    portal.classList.add('hidden');
                }
            }

            // Direct browser-to-Cloudinary upload helper (for files <= 10MB)
            async function uploadFileDirectlyToCloudinary(file, onProgress) {
                const endpoints = ['/api/cloudinary-signature?folder=notes', '/teacher/api/cloudinary-signature?folder=notes'];
                let sigData = null;
                for (const ep of endpoints) {
                    try {
                        const r = await fetch(ep, { headers: { 'Accept': 'application/json' } });
                        if (r.ok) {
                            const j = await r.json();
                            if (j && j.success && j.signature) {
                                sigData = j;
                                break;
                            }
                        }
                    } catch (err) {}
                }

                if (!sigData) throw new Error('Could not obtain upload credentials from server.');

                // Determine resource type: for PDF and documents, Cloudinary requires 'raw' upload endpoint
                const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
                const resourceType = isPdf ? 'raw' : 'auto';

                return new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    const url = `https://api.cloudinary.com/v1_1/${sigData.cloudName}/${resourceType}/upload`;
                    xhr.open('POST', url, true);

                    xhr.upload.onprogress = (e) => {
                        if (e.lengthComputable && typeof onProgress === 'function') {
                            const percent = Math.round((e.loaded / e.total) * 100);
                            onProgress(percent);
                        }
                    };

                    xhr.onload = () => {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            try {
                                const resp = JSON.parse(xhr.responseText);
                                if (resp.secure_url || resp.url) {
                                    resolve(resp.secure_url || resp.url);
                                } else {
                                    reject(new Error(resp.error?.message || 'Invalid upload response'));
                                }
                            } catch (err) {
                                reject(err);
                            }
                        } else {
                            try {
                                const errJson = JSON.parse(xhr.responseText);
                                reject(new Error(errJson.error?.message || ('Cloudinary upload error: ' + xhr.status)));
                            } catch (e) {
                                reject(new Error('Cloudinary upload error status: ' + xhr.status));
                            }
                        }
                    };

                    xhr.onerror = () => reject(new Error('Network error during file upload'));

                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('api_key', sigData.apiKey);
                    formData.append('timestamp', String(sigData.timestamp));
                    formData.append('signature', sigData.signature);
                    formData.append('folder', sigData.folder);

                    xhr.send(formData);
                });
            }

            // Chunked upload helper for large files (supports up to 25MB, bypassing Vercel 4.5MB & Cloudinary 10MB limits)
            async function uploadFileInChunks(file, onProgress) {
                const chunkSize = 2 * 1024 * 1024; // 2MB slices safely under Vercel payload limit
                const totalChunks = Math.ceil(file.size / chunkSize);
                const uploadId = 'up_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);

                for (let index = 0; index < totalChunks; index++) {
                    const start = index * chunkSize;
                    const end = Math.min(start + chunkSize, file.size);
                    const chunkBlob = file.slice(start, end);

                    const formData = new FormData();
                    formData.append('uploadId', uploadId);
                    formData.append('chunkIndex', String(index));
                    formData.append('totalChunks', String(totalChunks));
                    formData.append('chunk', chunkBlob, file.name);

                    let chunkUploaded = false;
                    let lastErr = null;
                    for (let attempt = 0; attempt < 3; attempt++) {
                        try {
                            const res = await fetch('/api/upload-chunk', {
                                method: 'POST',
                                body: formData
                            });
                            if (res.ok) {
                                const json = await res.json();
                                if (json && json.success) {
                                    chunkUploaded = true;
                                    break;
                                }
                            }
                        } catch (err) {
                            lastErr = err;
                        }
                    }

                    if (!chunkUploaded) {
                        throw new Error(`Failed to upload chunk ${index + 1} of ${totalChunks}: ` + (lastErr?.message || 'Network error'));
                    }

                    if (typeof onProgress === 'function') {
                        const percent = Math.round(((index + 1) / (totalChunks + 1)) * 100);
                        onProgress(percent);
                    }
                }

                // Finalize assembly into MongoDB GridFS
                const completeRes = await fetch('/api/upload-complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        uploadId,
                        filename: file.name,
                        mimeType: file.type || 'application/pdf',
                        totalChunks
                    })
                });

                if (!completeRes.ok) {
                    throw new Error('Server failed to assemble uploaded chunks.');
                }

                const completeJson = await completeRes.json();
                if (!completeJson || !completeJson.success || !completeJson.fileUrl) {
                    throw new Error(completeJson?.message || 'Failed to finalize uploaded file.');
                }

                if (typeof onProgress === 'function') {
                    onProgress(100);
                }

                return completeJson.fileUrl;
            }

            // Universal smart uploader (handles up to 25MB seamlessly)
            async function uploadNoteFile(file, onProgress) {
                if (file.size > 25 * 1024 * 1024) {
                    throw new Error('File exceeds the 25MB maximum limit.');
                }

                // If file is <= 10MB, try direct Cloudinary upload first
                if (file.size <= 10485760) {
                    try {
                        return await uploadFileDirectlyToCloudinary(file, onProgress);
                    } catch (err) {
                        console.warn('Direct Cloudinary upload failed, falling back to chunked storage:', err);
                        return await uploadFileInChunks(file, onProgress);
                    }
                }

                // If file is > 10MB (Cloudinary free tier limit is 10MB), use chunked storage directly
                return await uploadFileInChunks(file, onProgress);
            }

            const addNoteForm = document.getElementById('addNoteForm');
            if (addNoteForm) {
                addNoteForm.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    // 1. Validate Classes
                    const classHidden = document.getElementById('noteClassHidden');
                    let checkedClasses = [];
                    if (classHidden && !classHidden.disabled && classHidden.value.trim()) {
                        checkedClasses = [classHidden.value.trim()];
                    } else {
                        checkedClasses = Array.from(addNoteForm.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]:checked')).map(cb => cb.value.trim()).filter(Boolean);
                    }

                    if (checkedClasses.length === 0) {
                        showCustomAlert('Please select at least one Target Class for this note.', 'warning', 'Class Required');
                        const classesBox = document.getElementById('noteClassesContainer');
                        if (classesBox) classesBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }

                    // Ensure hidden class input is set and enabled if locked
                    if (classHidden && !classHidden.disabled && checkedClasses.length > 0) {
                        classHidden.value = checkedClasses[0];
                    }

                    // Also ensure locked / chosen subject & chapter hidden inputs are set
                    const subjectHidden = document.getElementById('noteSubjectHidden');
                    const subjSelect = document.getElementById('noteSubject');
                    if (subjectHidden && !subjectHidden.value && subjSelect) {
                        subjectHidden.value = subjSelect.value;
                    }

                    const chapterHidden = document.getElementById('noteChapterHidden');
                    const chapterSelect = document.getElementById('noteChapter');
                    if (chapterHidden && !chapterHidden.value && chapterSelect) {
                        chapterHidden.value = chapterSelect.value;
                    }

                    // 2. Validate Topics (Required from approved syllabus)
                    const primaryInput = document.getElementById('notePrimaryTopicInput');
                    let checkedTopics = Array.from(addNoteForm.querySelectorAll('#noteTopicsList input[name="topics[]"]:checked')).map(cb => cb.value.trim()).filter(Boolean);

                    if (checkedTopics.length === 0 && primaryInput && primaryInput.value.trim()) {
                        checkedTopics = [primaryInput.value.trim()];
                    }

                    if (checkedTopics.length === 0) {
                        showCustomAlert('Please select at least one syllabus Topic for this note. If none exist, add them from Syllabus & Topics first.', 'warning', 'Topic Required');
                        const topicsBox = document.getElementById('noteTopicsWrapper');
                        if (topicsBox) topicsBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }

                    // Ensure at least one input[name="topics[]"] is in the form with the selected topic
                    let existingTopicCb = addNoteForm.querySelector('input[name="topics[]"][value="' + checkedTopics[0].replace(/"/g, '\\"') + '"]');
                    if (!existingTopicCb) {
                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'topics[]';
                        hiddenInput.value = checkedTopics[0];
                        addNoteForm.appendChild(hiddenInput);
                    }

                    // 3. Validate PDF
                    const fileInput = document.getElementById('noteFileInput');
                    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                        showCustomAlert('Please attach a PDF document file.', 'warning', 'Missing File');
                        return;
                    }
                    const file = fileInput.files[0];
                    if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                        showCustomAlert('Only PDF files are supported.', 'warning', 'Invalid File Type');
                        return;
                    }

                    const submitBtn = document.getElementById('addNoteSubmitBtn');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="material-symbols-rounded text-base leading-none animate-spin">progress_activity</span><span>Preparing upload...</span>';
                    }

                    try {
                        let directUrl = null;
                        if (submitBtn) {
                            submitBtn.innerHTML = '<span class="material-symbols-rounded text-base leading-none animate-spin">cloud_upload</span><span id="btnUploadProgressText">Uploading PDF (0%)...</span>';
                        }

                        directUrl = await uploadNoteFile(file, (percent) => {
                            const progEl = document.getElementById('btnUploadProgressText');
                            if (progEl) progEl.textContent = `Uploading PDF (${percent}%)...`;
                        });

                        if (!directUrl) {
                            throw new Error('Cloud storage upload did not return a valid file URL.');
                        }

                        // Inject direct Cloudinary URL into form
                        let fileUrlInput = addNoteForm.querySelector('input[name="fileUrl"]');
                        if (!fileUrlInput) {
                            fileUrlInput = document.createElement('input');
                            fileUrlInput.type = 'hidden';
                            fileUrlInput.name = 'fileUrl';
                            addNoteForm.appendChild(fileUrlInput);
                        }
                        fileUrlInput.value = directUrl;

                        // IMPORTANT: Disable raw file input so ZERO binary payload is posted to Vercel!
                        fileInput.disabled = true;

                        if (submitBtn) {
                            submitBtn.innerHTML = '<span class="material-symbols-rounded text-base leading-none animate-spin">save</span><span>Saving Note...</span>';
                        }

                        addNoteForm.submit();
                    } catch (err) {
                        console.error('Note upload failed:', err);
                        showCustomAlert('File upload failed: ' + (err.message || 'Please check your connection'), 'error', 'Upload Failed');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<span class="material-symbols-rounded text-sm leading-none">cloud_upload</span><span>Upload Note</span>';
                        }
                        if (fileInput) fileInput.disabled = false;
                    }
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeNoteModal();
                    const noteModal = document.getElementById('addNoteModal');
                    if (noteModal) noteModal.classList.add('hidden');
                }
            });
        });
    </script>
</body>

