<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">

<head>
    <%- include('../partials/head') %>
    <title>Notes | ODDHAY Command Center</title>
    <style>
        :root {
            --admin-sidebar-width: 260px;
        }

        .admin-main {
            margin-left: var(--admin-sidebar-width);
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .content-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 0;
            position: relative;
        }

        @media (max-width: 1024px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            .admin-main {
                margin-left: 0;
            }
        }

        .form-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            margin-bottom: 5px;
        }

        .dark .form-label {
            color: #94a3b8;
        }

        .form-input {
            height: 42px;
            width: 100%;
            padding: 0 14px;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            outline: none;
            transition: border-color 0.2s;
        }

        .dark .form-input {
            background: #0f172a;
            border-color: rgba(255, 255, 255, 0.08);
            color: #e2e8f0;
        }

        .form-input:focus {
            border-color: #137fec;
        }

        /* Notes List Mode Overrides for Perfect Organization */
        body.notes-list-mode .notes-grid-container,
        body.notes-list-mode #chapters-grid,
        body.notes-list-mode #subject-folders-section > div {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.375rem !important;
        }

        body.notes-list-mode .subject-folder-card,
        body.notes-list-mode .chapter-folder-card {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            text-align: left !important;
            padding: 0.5rem 0.85rem !important;
            gap: 0.75rem !important;
            border-radius: 0.625rem !important;
        }

        body.notes-list-mode .subject-folder-card > div:first-child,
        body.notes-list-mode .chapter-folder-card > div:first-child {
            margin-bottom: 0 !important;
            width: 2.25rem !important;
            height: 2.25rem !important;
            border-radius: 0.5rem !important;
            flex-shrink: 0 !important;
        }

        body.notes-list-mode .subject-folder-card > div:last-child {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex: 1 !important;
            min-width: 0 !important;
            text-align: left !important;
        }

        body.notes-list-mode .note-card {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 0.5rem 0.85rem !important;
            gap: 0.75rem !important;
            border-radius: 0.625rem !important;
        }

        body.notes-list-mode .note-card > div:first-child {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 0.75rem !important;
            min-width: 0 !important;
            flex: 1 !important;
            margin-bottom: 0 !important;
        }

        body.notes-list-mode .note-card > div:first-child > div:first-child {
            margin-bottom: 0 !important;
            width: 2.25rem !important;
            height: 2.25rem !important;
            border-radius: 0.5rem !important;
        }

        body.notes-list-mode .note-card h3 {
            margin-bottom: 0 !important;
            font-size: 0.8125rem !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-width: 340px !important;
        }

        body.notes-list-mode .note-card p {
            display: none !important;
        }

        body.notes-list-mode .note-card > div:last-child {
            padding-top: 0 !important;
            border-top: none !important;
            flex-shrink: 0 !important;
            margin-top: 0 !important;
        }

        body.notes-list-mode .hidden,
        body.notes-list-mode .subject-folder-card.hidden,
        body.notes-list-mode .chapter-folder-card.hidden,
        body.notes-list-mode .note-card.hidden,
        body.notes-list-mode #chapters-container.hidden,
        body.notes-list-mode #folders-container.hidden,
        body.notes-list-mode #notes-content-container.hidden,
        body.notes-list-mode #notes-grid-view.hidden {
            display: none !important;
        }

        body.notes-list-mode #empty-folder-state:not(.hidden),
        body.notes-list-mode #no-notes-found:not(.hidden) {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
        }
    </style>
</head>

<body class="bg-white dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar"
            class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'notes' }) %>
        </aside>

        <main class="admin-main flex-1 bg-white dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Notes' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                
                <% 
                   const noteList = locals.notes || []; 
                   const cFolders = locals.courseFolders || []; 
                   const subList = locals.subjects || []; 
                   const classList = locals.classes || [];
                   const activeClass = locals.activeClass || 'all';
                   const activeSubject = locals.activeSubject || 'all'; 
                   const activeCourseId = locals.activeCourseId || null; 
                   const statsData = locals.stats || {};
                %>

                <!-- Sticky Navigation Bar (Matching Student Panel UI + Teacher Extra Buttons) -->
                <div class="sticky top-0 z-20 w-full bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur border-b border-slate-200 dark:border-slate-800 p-2.5 sm:p-3 shadow-none space-y-2">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-2.5 w-full">
                        
                        <!-- Left Side: Class Selector OR Breadcrumb Navigation -->
                        <div class="flex items-center gap-2.5 w-full md:w-auto overflow-x-auto no-scrollbar">
                            
                            <!-- Class Selector Dropdown -->
                            <div id="folder-selector-wrapper" class="<%= (activeClass !== 'all' || activeCourseId) ? 'hidden' : '' %> flex items-center gap-1.5 shrink-0">
                                <span class="material-symbols-rounded text-indigo-500 text-lg flex items-center justify-center leading-none select-none">school</span>
                                <span class="text-xs font-bold text-slate-500 dark:text-slate-400 select-none">Class:</span>
                                <select name="class" onchange="window.location.href='/teacher/notes?class=' + encodeURIComponent(this.value)" class="min-w-[170px] sm:min-w-[200px] px-3 py-1.5 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-slate-800 dark:text-white rounded-lg outline-none cursor-pointer shrink-0">
                                    <option value="all" <%= activeClass === 'all' ? 'selected' : '' %>>All Classes</option>
                                    <% classList.forEach(function(c) { %>
                                        <option value="<%= c %>" <%= activeClass === c ? 'selected' : '' %>><%= c %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Breadcrumb Navigation Bar -->
                            <div id="breadcrumb-bar" class="<%= (activeClass !== 'all' || activeCourseId) ? '' : 'hidden' %> flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 shrink-0">
                                <a href="/teacher/notes" class="px-2 py-1 bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-md transition-colors flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">arrow_back</span>
                                    <span>All Classes</span>
                                </a>
                                <span class="text-slate-300 dark:text-slate-600">/</span>
                                <span id="breadcrumb-title" class="font-bold text-slate-900 dark:text-white flex items-center gap-1">
                                    <span class="material-symbols-rounded text-indigo-500 text-sm flex items-center justify-center leading-none">school</span>
                                    <span><%= activeClass !== 'all' ? activeClass : 'Course Files' %></span>
                                </span>
                            </div>
                        </div>

                        <!-- Right Side: View Mode, Search & Action Buttons -->
                        <div class="flex items-center gap-2 w-full md:w-auto shrink-0 justify-between md:justify-end">
                            
                            <!-- View Mode Toggle -->
                            <div class="flex items-center bg-slate-100 dark:bg-slate-800/80 p-0.5 rounded-lg border border-slate-200/60 dark:border-slate-700/60 shrink-0">
                                <button type="button" id="view-mode-grid-btn" onclick="setViewMode('grid')" class="px-2 py-1 rounded-md text-xs font-bold transition-all flex items-center gap-1 bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-xs" title="Grid View">
                                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">grid_view</span>
                                </button>
                                <button type="button" id="view-mode-list-btn" onclick="setViewMode('list')" class="px-2 py-1 rounded-md text-xs font-bold transition-all flex items-center gap-1 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white" title="Compact List View">
                                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">view_list</span>
                                </button>
                            </div>

                            <!-- Search Input -->
                            <div class="relative w-full md:w-44 shrink-0">
                                <input type="text" id="notes-search-input" placeholder="Search notes..." autocomplete="off"
                                    class="w-full pl-8 pr-8 py-1.5 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-slate-800 dark:text-white rounded-lg outline-none focus:border-primary transition-all">
                                <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm flex items-center justify-center leading-none select-none pointer-events-none">search</span>
                                <button type="button" id="clear-notes-search" onclick="clearNotesSearch()" class="hidden absolute right-2 top-1/2 -translate-y-1/2 size-5 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer select-none">
                                    <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">cancel</span>
                                </button>
                            </div>

                            <!-- Action Buttons: New Folder & Add Note -->
                            <div id="header-action-buttons" class="<%= (activeSubject !== 'all' || activeCourseId) ? '' : 'hidden' %> flex items-center gap-2 shrink-0">
                                <button type="button" onclick="openAddFolderModal()" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer">
                                    <span class="material-symbols-rounded text-sm leading-none">create_new_folder</span>
                                    <span>New Folder</span>
                                </button>

                                <button type="button" onclick="openAddNoteModal()" class="px-3 py-1.5 bg-primary hover:bg-primary/90 text-white rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer">
                                    <span class="material-symbols-rounded text-sm leading-none">upload_file</span>
                                    <span>Add Note</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MAIN WORKSPACE CONTENT CONTAINER -->
                <div class="p-3 sm:p-4 space-y-3 flex-1 bg-white dark:bg-[#0f172a] min-h-[calc(100vh-65px)]">
                    
                    <!-- Search No Results State -->
                    <div id="no-notes-found" class="hidden min-h-[calc(100vh-120px)] w-full bg-white dark:bg-[#0f172a] p-6 sm:p-12 flex flex-col items-center justify-center text-center shadow-none">
                        <div class="size-16 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-center mb-3 text-slate-400">
                            <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">search_off</span>
                        </div>
                        <h3 class="text-base font-bold text-slate-800 dark:text-white">No Notes Found</h3>
                        <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                            Try refining your search keyword or selecting a different folder.
                        </p>
                        <button onclick="clearNotesSearch()" class="mt-4 px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold inline-flex items-center gap-1.5 transition-all">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none select-none">refresh</span> Reset Search
                        </button>
                    </div>

                    <!-- LEVEL 0: FOLDERS GRID VIEW (Assigned Class Folders) -->
                    <% if (classList.length > 0) { %>
                        <div id="folders-container" class="<%= (activeClass === 'all' && !activeCourseId) ? '' : 'hidden' %> space-y-4">
                            <!-- Class Folders Grid -->
                            <div id="subject-folders-section">
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
                                    <% classList.forEach(function(cls) { %>
                                        <% 
                                           const count = noteList.filter(n => {
                                               if (!n.classLevel) return false;
                                               if (Array.isArray(n.classLevel)) return n.classLevel.includes(cls);
                                               return n.classLevel === cls;
                                           }).length; 
                                        %>
                                        <a href="/teacher/notes?class=<%= encodeURIComponent(cls) %>"
                                           class="subject-folder-card bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 hover:border-primary/50 dark:hover:border-primary/50 rounded-xl p-3.5 sm:p-4 flex flex-col items-center justify-center text-center transition-all duration-200 group shadow-none space-y-2"
                                           data-search="<%= cls.toLowerCase().replace(/"/g, '&quot;') %>">
                                            <div class="size-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                                                <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">school</span>
                                            </div>
                                            <div class="w-full min-w-0">
                                                <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white truncate group-hover:text-primary transition-colors">
                                                    <%= cls %>
                                                </h4>
                                            </div>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- LEVEL 1 & 2: DYNAMIC CHAPTER FOLDERS & NOTES CONTAINER -->
                    <div id="notes-content-container" class="<%= (activeClass !== 'all' || activeCourseId) ? '' : 'hidden' %> space-y-3">
                        
                        <!-- CHAPTER FOLDERS SECTION -->
                        <div id="chapters-container" class="hidden">
                            <div id="chapters-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
                                <!-- Chapter Cards Rendered via JS -->
                            </div>
                        </div>

                        <!-- NOTES GRID VIEW -->
                        <div id="notes-grid-view">
                            <div id="empty-folder-state" class="hidden min-h-[calc(100vh-120px)] w-full bg-white dark:bg-[#0f172a] p-6 sm:p-12 flex flex-col items-center justify-center text-center shadow-none">
                                <div class="size-16 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-center mb-3 text-slate-400">
                                    <span class="material-symbols-rounded text-3xl flex items-center justify-center leading-none select-none">folder_off</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-800 dark:text-white">No Notes Found</h3>
                                <p class="text-xs font-medium text-slate-400 mt-1 max-w-sm mx-auto">
                                    No notes uploaded to this folder yet.
                                </p>
                                <button type="button" onclick="openAddNoteModal()" class="mt-4 px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-xl text-xs font-bold inline-flex items-center gap-1.5 shadow-sm transition-all cursor-pointer">
                                    <span class="material-symbols-rounded text-sm leading-none">upload_file</span>
                                    <span>Add Note</span>
                                </button>
                            </div>

                            <% if (noteList.length > 0) { %>
                            <div class="notes-grid-container grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3">
                                <% noteList.forEach(function(note) { %>
                                    <% 
                                       const title = note.title || 'Untitled Note';
                                       const subject = note.subject || 'General Academic';
                                       const classLevelStr = Array.isArray(note.classLevel) ? note.classLevel.join(', ') : (note.classLevel || 'General');
                                       const fileUrl = note.filePath || note.fileUrl || note.url || '#';
                                       const isPdf = fileUrl.toLowerCase().endsWith('.pdf');
                                       const isPaid = (note.accessType || '').toLowerCase() === 'paid';
                                       const authorName = note.addedBy ? note.addedBy.name : (note.author || 'Instructor');
                                       const courseTitle = note.course ? (note.course.title || note.course) : null;
                                       const searchableText = [title, subject, classLevelStr, authorName, courseTitle || '', note.chapter || note.chapterTitle || ''].join(' ').toLowerCase();

                                       const noteAuthorId = note.addedBy ? String(note.addedBy._id || note.addedBy) : '';
                                       const isNoteOwner = Boolean(user && user._id && String(user._id) === noteAuthorId);
                                    %>
                                    <div class="note-card relative bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-3.5 sm:p-4 flex flex-col justify-between hover:border-primary/50 dark:hover:border-primary/50 transition-all duration-200 group shadow-none"
                                         data-id="<%= note._id %>"
                                         data-search="<%= searchableText.replace(/"/g, '&quot;') %>"
                                         data-unlocked="<%= !isPaid ? 'true' : 'false' %>"
                                         data-iscourse="<%= note.course ? 'true' : 'false' %>"
                                         data-subject="<%= subject.toLowerCase().replace(/"/g, '&quot;') %>"
                                         data-class-level="<%= classLevelStr.toLowerCase().replace(/"/g, '&quot;') %>"
                                         data-chapter-name="<%= (note.chapter || note.chapterTitle || 'General Notes').replace(/"/g, '&quot;') %>"
                                         data-parent-folder-id="<%= note.parentFolderId || '' %>">
                                        
                                        <!-- Selection Checkbox -->
                                        <input type="checkbox" class="item-select-checkbox hidden absolute top-3 left-3 size-4.5 accent-primary cursor-pointer z-10" data-note-id="<%= note._id %>" data-owner="<%= isNoteOwner ? 'true' : 'false' %>" onchange="updateSelectedCount()">

                                        <div>
                                            <!-- Top 1st Line: Document Icon + Title + Class/Subject + Access Badge -->
                                            <div class="flex items-start justify-between gap-2 mb-2">
                                                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                                    <div class="size-9 rounded-xl <%= isPaid ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-600 border border-amber-200 dark:border-amber-500/20' : 'bg-primary/10 text-primary border border-primary/20' %> flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                                        <span class="material-symbols-rounded text-lg leading-none select-none"><%= isPdf ? 'picture_as_pdf' : 'description' %></span>
                                                    </div>

                                                    <div class="min-w-0 flex-1">
                                                        <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-tight group-hover:text-primary transition-colors truncate" title="<%= title %>">
                                                            <%= title %>
                                                        </h3>
                                                        <p class="text-[10px] font-semibold text-slate-400 truncate mt-0.5 flex items-center gap-1">
                                                            <span><%= classLevelStr %></span>
                                                            <span>•</span>
                                                            <span class="text-primary font-bold"><%= subject %></span>
                                                        </p>
                                                    </div>
                                                </div>

                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold shrink-0 <%= isPaid ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-500/20' : 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20' %>">
                                                    <%= isPaid ? 'Paid Note' : 'Free Note' %>
                                                </span>
                                            </div>

                                            <% if (courseTitle) { %>
                                                <div class="mb-2 px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-[10px] font-semibold text-slate-600 dark:text-slate-300 flex items-center gap-1.5 truncate">
                                                    <span class="material-symbols-rounded text-xs text-primary shrink-0">school</span>
                                                    <span class="truncate"><%= courseTitle %></span>
                                                </div>
                                            <% } %>

                                            <% if (note.description) { %>
                                                <p class="text-[11px] font-medium text-slate-400 line-clamp-2 mb-2"><%= note.description %></p>
                                            <% } %>
                                        </div>

                                        <!-- Teacher Actions Footer -->
                                        <div class="pt-2.5 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                                            <span class="text-[10px] font-medium text-slate-400 truncate">
                                                By <%= authorName %>
                                            </span>

                                            <div class="flex items-center gap-1.5 shrink-0">
                                                <!-- Preview Button -->
                                                <button type="button" onclick="openNoteModal('<%= fileUrl %>', '<%= title.replace(/'/g, "\\'") %>')" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-[10px] font-bold transition-all flex items-center gap-1 cursor-pointer">
                                                    <span class="material-symbols-rounded text-xs leading-none">visibility</span>
                                                    <span>View</span>
                                                </button>

                                                <% if (isNoteOwner) { %>
                                                    <!-- Edit Button (Owner Only) -->
                                                    <a href="/teacher/note-details/<%= note._id %>" class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-500/10 hover:bg-blue-100 text-blue-600 dark:text-blue-400 text-[10px] font-bold transition-all flex items-center gap-1">
                                                        <span class="material-symbols-rounded text-xs leading-none">edit</span>
                                                        <span>Edit</span>
                                                    </a>
                                                    <!-- Delete Button (Owner Only) -->
                                                    <button type="button" onclick="confirmDeleteNote(event, '<%= note._id %>')" class="p-1 rounded bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-100 text-rose-600 dark:text-rose-400 transition-all cursor-pointer" title="Delete Note">
                                                        <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">delete</span>
                                                    </button>
                                                <% } else { %>
                                                    <!-- Lock Indicator (Not Owner) -->
                                                    <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-400 text-[9px] font-semibold flex items-center gap-0.5" title="Read Only (Added by another teacher/admin)">
                                                        <span class="material-symbols-rounded text-[10px]">lock</span>
                                                        <span>Read-only</span>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- PDF Viewer Modal -->
    <div id="note-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-md flex items-center justify-center p-2 sm:p-4">
        <div class="bg-white dark:bg-[#0f172a] rounded-xl w-full max-w-4xl h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800">
