    <!-- Custom Alert Toast (Replaces browser alert popup) -->
    <div id="customAlertModal" class="fixed top-4 right-4 z-[350] hidden max-w-sm w-full bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-3.5 shadow-2xl flex items-start gap-3 transition-all duration-300">
        <div id="alert-modal-icon-bg" class="size-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
            <span id="alert-modal-icon" class="material-symbols-rounded text-lg">info</span>
        </div>
        <div class="flex-1 min-w-0">
            <h4 id="alert-modal-title" class="text-xs font-bold text-slate-900 dark:text-white">Notice</h4>
            <p id="alert-modal-msg" class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Alert message text</p>
        </div>
        <button type="button" onclick="closeCustomAlert()" class="size-6 text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center rounded-md cursor-pointer">
            <span class="material-symbols-rounded text-sm">close</span>
        </button>
