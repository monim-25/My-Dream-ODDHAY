        function closeChapterFolder() {
            if (window.folderNavStack.length > 0) {
                window.folderNavStack.pop();
            }
            const current = window.folderNavStack[window.folderNavStack.length - 1];
            if (current) {
                window.activeChapterFilter = current.name;
                window.activeFolderIdFilter = current.id;
            } else {
                window.activeChapterFilter = null;
                window.activeFolderIdFilter = null;
            }
            filterLiveNotes();
        }

        function setQuickFilter(filterName) {
            window.currentQuickFilter = filterName;
            window.activeChapterFilter = null;
            window.activeFolderIdFilter = null;
            window.folderNavStack = [];

            document.querySelectorAll('.quick-chip').forEach(chip => {
                if (chip.getAttribute('data-chip') === filterName) {
                    chip.classList.add('bg-primary', 'text-white', 'shadow-xs', 'font-bold');
                    chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                } else {
                    chip.classList.remove('bg-primary', 'text-white', 'shadow-xs', 'font-bold');
                    chip.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                }
            });

            filterLiveNotes();
        }

