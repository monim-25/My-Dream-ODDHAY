    <!-- Custom Confirmation Modal (Replaces browser confirm popup) -->
    <div id="customConfirmModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[300] hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl max-w-sm w-full p-5 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center gap-3">
                <div id="confirm-modal-icon-wrapper" class="size-10 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-600 flex items-center justify-center border border-rose-200 dark:border-rose-500/20 shrink-0">
                    <span class="material-symbols-rounded text-xl">delete</span>
                </div>
                <div>
                    <h3 id="confirm-modal-title" class="text-sm font-bold text-slate-900 dark:text-white">Confirm Action</h3>
                    <p id="confirm-modal-subtitle" class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Please confirm your action</p>
                </div>
            </div>

            <p id="confirm-modal-body" class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-medium bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
                Are you sure you want to proceed?
            </p>

            <div class="flex items-center justify-end gap-2 pt-1">
                <button type="button" id="confirm-modal-cancel-btn" class="px-3.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="button" id="confirm-modal-ok-btn" class="px-4 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-all shadow-sm cursor-pointer">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <!-- Custom Alert Toast (Replaces browser alert popup) -->
    <div id="customAlertModal" class="fixed top-4 right-4 z-[350] hidden max-w-sm w-full bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-3.5 shadow-2xl flex items-start gap-3 transition-all duration-300">
        <div id="alert-modal-icon-bg" class="size-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
            <span id="alert-modal-icon" class="material-symbols-rounded text-lg">info</span>
        </div>
        <div class="flex-1 min-w-0">
            <h4 id="alert-modal-title" class="text-xs font-bold text-slate-900 dark:text-white">Notice</h4>
            <p id="alert-modal-msg" class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Alert message text</p>
        </div>
        <button type="button" onclick="closeCustomAlert()" class="size-6 text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center rounded-md cursor-pointer">
            <span class="material-symbols-rounded text-sm">close</span>
        </button>
    </div>

    <%- include('../partials/app-scripts') %>

    <script>
        window.customFolders = <%- JSON.stringify(customFolders || []) %>;
        window.activeClass = <%- JSON.stringify(activeClass || 'all') %>;
        window.activeSubject = <%- JSON.stringify(activeSubject || 'all') %>;
        window.activeCourseId = <%- JSON.stringify(activeCourseId || null) %>;
        window.assignedClasses = <%- JSON.stringify(classes || []) %>;
        window.assignedSubjects = <%- JSON.stringify(subjects || []) %>;
        window.currentQuickFilter = 'all';
        window.activeChapterFilter = null;
        window.activeFolderIdFilter = null;
        window.folderNavStack = [];
        window.isSelectMode = false;

        // Custom UI Alert Notification (Replaces browser alert popup)
        function showCustomAlert(msg, type = 'warning', title = 'Notice') {
            const alertModal = document.getElementById('customAlertModal');
            const alertMsg = document.getElementById('alert-modal-msg');
            const alertTitle = document.getElementById('alert-modal-title');
            const alertIcon = document.getElementById('alert-modal-icon');
            const alertIconBg = document.getElementById('alert-modal-icon-bg');

            if (!alertModal) return;

            if (alertTitle) alertTitle.textContent = title;
            if (alertMsg) alertMsg.textContent = msg;

            if (type === 'danger' || type === 'error') {
                alertIcon.textContent = 'error';
                alertIconBg.className = 'size-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0';
            } else if (type === 'success') {
                alertIcon.textContent = 'check_circle';
                alertIconBg.className = 'size-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0';
            } else {
                alertIcon.textContent = 'warning';
                alertIconBg.className = 'size-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0';
            }

            alertModal.classList.remove('hidden');
            setTimeout(() => { alertModal.classList.add('hidden'); }, 4000);
        }

        function closeCustomAlert() {
            const alertModal = document.getElementById('customAlertModal');
            if (alertModal) alertModal.classList.add('hidden');
        }

        // Custom UI Confirmation Dialog (Replaces browser confirm popup)
        function showCustomConfirm({ title = 'Confirm Deletion', subtitle = 'Please confirm your action', body, onConfirm }) {
            const modal = document.getElementById('customConfirmModal');
            const titleEl = document.getElementById('confirm-modal-title');
            const subEl = document.getElementById('confirm-modal-subtitle');
            const bodyEl = document.getElementById('confirm-modal-body');
            const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
            const okBtn = document.getElementById('confirm-modal-ok-btn');

            if (!modal) return;

            if (titleEl) titleEl.textContent = title;
            if (subEl) subEl.textContent = subtitle;
            if (bodyEl) bodyEl.textContent = body;

            modal.classList.remove('hidden');

            const handleCancel = () => {
                modal.classList.add('hidden');
                cancelBtn.removeEventListener('click', handleCancel);
                okBtn.removeEventListener('click', handleOk);
            };

            const handleOk = () => {
                modal.classList.add('hidden');
                cancelBtn.removeEventListener('click', handleCancel);
                okBtn.removeEventListener('click', handleOk);
                if (typeof onConfirm === 'function') onConfirm();
            };

            cancelBtn.addEventListener('click', handleCancel);
            okBtn.addEventListener('click', handleOk);
        }

        function confirmDeleteNote(event, noteId) {
            event.preventDefault();
            showCustomConfirm({
                title: 'Delete Note File',
                subtitle: 'Permanent deletion',
                body: 'Are you sure you want to delete this note file? This action cannot be undone.',
                onConfirm: () => {
                    window.location.href = `/teacher/note/${noteId}/delete`;
                }
            });
        }

        function deleteCustomFolder(event, folderId) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            showCustomConfirm({
                title: 'Delete Folder',
                subtitle: 'Permanent deletion',
                body: 'Are you sure you want to delete this folder? All child notes will be unlinked.',
                onConfirm: async () => {
                    try {
                        const res = await fetch(`/teacher/folder/${folderId}/delete`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            if (window.customFolders) {
                                window.customFolders = window.customFolders.filter(f => String(f._id) !== String(folderId));
                            }
                            showCustomAlert('Folder deleted successfully.', 'success', 'Folder Deleted');
                            filterLiveNotes();
                        } else {
                            showCustomAlert(data.error || 'Failed to delete folder', 'danger', 'Error');
                        }
                    } catch (e) {
                        console.error(e);
                        showCustomAlert('Failed to delete folder', 'danger', 'Error');
                    }
                }
            });
        }

        function openAddFolderModal(presetSubject = '', presetParentId = '') {
            const modal = document.getElementById('addFolderModal');
            if (!modal) return;

            const subjInput = document.getElementById('folderSubject');
            const classInput = document.getElementById('folderClassLevel');
            const parentInput = document.getElementById('folderParentId');

            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = urlParams.get('subject') || '';

            const activeSubj = presetSubject || urlSubj || (window.activeSubject && window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'));
            const activeParent = presetParentId || window.activeFolderIdFilter || '';

            if (subjInput) subjInput.value = activeSubj;
            if (parentInput) parentInput.value = activeParent;
            if (classInput) {
                const assignedClassesList = <%- JSON.stringify(locals.classes || []) %>;
                classInput.value = assignedClassesList[0] || 'Class 10';
            }

            const folderNameInput = document.getElementById('folderName');
            if (folderNameInput) folderNameInput.value = '';

            modal.classList.remove('hidden');
        }

        async function submitAddFolder(e) {
            e.preventDefault();
            const name = document.getElementById('folderName').value.trim();
            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = urlParams.get('subject') || '';

            const subject = document.getElementById('folderSubject').value || urlSubj || (window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'));
            const classLevel = document.getElementById('folderClassLevel').value || '';
            const parentId = document.getElementById('folderParentId').value || window.activeFolderIdFilter || '';

            if (!name) {
                showCustomAlert('Please enter a folder name.', 'warning', 'Missing Name');
                return;
            }

            try {
                const res = await fetch('/teacher/add-folder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ name, subject, classLevel, parentId })
                });
                const data = await res.json();
                if (data.success && data.folder) {
                    document.getElementById('addFolderModal').classList.add('hidden');
                    document.getElementById('folderName').value = '';
                    
                    if (!window.customFolders) window.customFolders = [];
                    window.customFolders.push(data.folder);
                    
                    showCustomAlert('Folder created successfully.', 'success', 'Folder Created');
                    filterLiveNotes();
                } else {
                    showCustomAlert(data.error || 'Failed to create folder', 'danger', 'Error');
                }
            } catch (err) {
                console.error(err);
                showCustomAlert('Failed to create folder', 'danger', 'Error');
            }
        }

        function openAddNoteModal(presetSubject = '', presetCourseId = '', presetChapter = '') {
            const modal = document.getElementById('addNoteModal');
            if (!modal) return;
            
            const subjInput = document.getElementById('noteSubject');
            const parentFolderInput = document.getElementById('noteParentFolderId');
            const chapterInput = document.getElementById('noteChapter');

            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = urlParams.get('subject') || '';

            const activeSubj = presetSubject || urlSubj || (window.activeSubject && window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'));
            const activeParentId = window.activeFolderIdFilter || '';
            const activeChapter = presetChapter || window.activeChapterFilter || '';

            if (subjInput) subjInput.value = activeSubj;
            if (parentFolderInput) parentFolderInput.value = activeParentId;
            if (chapterInput) chapterInput.value = activeChapter;

            modal.classList.remove('hidden');
        }

        function openChapterFolder(chapterName, folderId) {
            window.activeChapterFilter = chapterName;
            window.activeFolderIdFilter = folderId || null;
            window.folderNavStack.push({ name: chapterName, id: folderId || null });
            filterLiveNotes();
        }

        function closeChapterFolder() {
            if (window.folderNavStack.length > 0) {
                window.folderNavStack.pop();
            }
            const current = window.folderNavStack[window.folderNavStack.length - 1];
            if (current) {
                window.activeChapterFilter = current.name;
                window.activeFolderIdFilter = current.id;
            } else {
                window.activeChapterFilter = null;
                window.activeFolderIdFilter = null;
            }
            filterLiveNotes();
        }

        function setQuickFilter(filterName) {
            window.currentQuickFilter = filterName;
            window.activeChapterFilter = null;
            window.activeFolderIdFilter = null;
            window.folderNavStack = [];

            document.querySelectorAll('.quick-chip').forEach(chip => {
                if (chip.getAttribute('data-chip') === filterName) {
                    chip.classList.add('bg-primary', 'text-white', 'shadow-xs', 'font-bold');
                    chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                } else {
                    chip.classList.remove('bg-primary', 'text-white', 'shadow-xs', 'font-bold');
                    chip.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                }
            });

            filterLiveNotes();
        }

        function setViewMode(mode) {
            try {
                localStorage.setItem('oddhay_teacher_notes_view_mode', mode);
            } catch(e) {}

            const gridBtn = document.getElementById('view-mode-grid-btn');
            const listBtn = document.getElementById('view-mode-list-btn');

            if (mode === 'list') {
                if (gridBtn) {
                    gridBtn.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-800', 'dark:text-white', 'shadow-xs');
                    gridBtn.classList.add('text-slate-500', 'dark:text-slate-400');
                }
                if (listBtn) {
                    listBtn.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-800', 'dark:text-white', 'shadow-xs');
                    listBtn.classList.remove('text-slate-500', 'dark:text-slate-400');
                }
                document.body.classList.add('notes-list-mode');
            } else {
                if (listBtn) {
                    listBtn.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-800', 'dark:text-white', 'shadow-xs');
                    listBtn.classList.add('text-slate-500', 'dark:text-slate-400');
                }
                if (gridBtn) {
                    gridBtn.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-800', 'dark:text-white', 'shadow-xs');
                    gridBtn.classList.remove('text-slate-500', 'dark:text-slate-400');
                }
                document.body.classList.remove('notes-list-mode');
            }
        }

        function openNoteModal(url, title) {
            const modal = document.getElementById('note-modal');
            const frame = document.getElementById('note-modal-frame');
            const titleEl = document.getElementById('note-modal-title');
            const downloadBtn = document.getElementById('note-modal-download');
            
            if (modal && frame) {
                titleEl.textContent = title || 'Note Document';
                downloadBtn.href = url;
                frame.src = url;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeNoteModal() {
            const modal = document.getElementById('note-modal');
            const frame = document.getElementById('note-modal-frame');
            if (modal) {
                modal.classList.add('hidden');
                if (frame) frame.src = '';
                document.body.style.overflow = '';
            }
        }

        function filterLiveNotes() {
            const searchInput = document.getElementById('notes-search-input');
            const clearBtn = document.getElementById('clear-notes-search');
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

            const folderSelectorWrapper = document.getElementById('folder-selector-wrapper');
            const foldersContainer = document.getElementById('folders-container');
            const chaptersContainer = document.getElementById('chapters-container');
            const chaptersGrid = document.getElementById('chapters-grid');
            const chaptersCounter = document.getElementById('chapters-counter');
            const notesContainer = document.getElementById('notes-content-container');
            const breadcrumbBar = document.getElementById('breadcrumb-bar');
            const breadcrumbTitle = document.getElementById('breadcrumb-title');
            const notesCounter = document.getElementById('notes-counter');
            const noResultsBox = document.getElementById('no-notes-found');
            const emptyFolderState = document.getElementById('empty-folder-state');

            if (clearBtn) {
                if (query.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            const subjectCards = document.querySelectorAll('.subject-folder-card');
            const courseCards = document.querySelectorAll('.course-folder-card');
            const noteCards = document.querySelectorAll('.note-card');

            const isInitialFiltered = <%- JSON.stringify(activeClass !== 'all' || Boolean(activeCourseId)) %>;
            const parentName = <%- JSON.stringify(activeClass !== 'all' ? activeClass : (activeCourseId ? 'Course Files' : 'Files')) %>;

            const activeCourseId = <%- JSON.stringify(activeCourseId || '') %>;
            const activeClass = <%- JSON.stringify(activeClass || 'all') %>;
            const activeSubject = <%- JSON.stringify(activeSubject || 'all') %>;
            const courseCurriculums = <%- JSON.stringify(locals.courseCurriculums || {}) %>;
            const currentParentId = window.activeFolderIdFilter;

            const headerActionBtns = document.getElementById('header-action-buttons');
            const isSubfolderOrClassOpen = (activeClass !== 'all') || Boolean(activeCourseId) || Boolean(window.activeChapterFilter) || Boolean(window.activeFolderIdFilter);

            if (headerActionBtns) {
                if (isSubfolderOrClassOpen) {
                    headerActionBtns.classList.remove('hidden');
                } else {
                    headerActionBtns.classList.add('hidden');
                }
            }

            let visibleNotesCount = 0;
            let visibleSubjectCount = 0;
            let visibleCourseCount = 0;

            const chapterMap = new Map();
            const activeClassClean = activeClass.trim().toLowerCase();

            // 1. First pass: Count notes for chapter badges (matching search & chip filter)
            noteCards.forEach(card => {
                const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                const isGeneral = !cardClass || cardClass === 'general academic' || cardClass === 'general' || cardClass === 'all';
                const matchesClass = activeClass === 'all' || !activeClassClean || isGeneral || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);
                if (!matchesClass) return;

                const isUnlocked = card.getAttribute('data-unlocked') === 'true';
                const isCourse = card.getAttribute('data-iscourse') === 'true';
                const chapName = card.getAttribute('data-chapter-name') || 'General Notes';
                const searchable = card.getAttribute('data-search') || '';

                let matchesChip = true;
                if (window.currentQuickFilter === 'free') matchesChip = isUnlocked;
                else if (window.currentQuickFilter === 'paid') matchesChip = !isUnlocked;
                else if (window.currentQuickFilter === 'course') matchesChip = isCourse;

                const matchesQuery = query.length === 0 || searchable.includes(query);

                if (matchesChip && matchesQuery) {
                    if (chapName && chapName !== 'General Notes' && chapName !== 'General Course Notes') {
                        const key = chapName.trim().toLowerCase();
                        chapterMap.set(key, (chapterMap.get(key) || 0) + 1);
                    }
                }
            });

            // 2. Build current level folders list
            const isInsideSubfolder = Boolean(window.activeFolderIdFilter || window.activeChapterFilter);
            const foldersMap = new Map();

            // Aggregate custom folders created via Folder model for this class
            if (window.customFolders && window.customFolders.length > 0) {
                window.customFolders.forEach(f => {
                    if (!f || !f.name || f.name === 'undefined' || f.name === 'null' || !f.name.trim()) return;
                    if (activeClass === 'all' && !activeCourseId) return;

                    const fClassClean = (f.classLevel || '').trim().toLowerCase();
                    const matchesClass = !activeClassClean || fClassClean === activeClassClean || fClassClean.includes(activeClassClean) || activeClassClean.includes(fClassClean);
                    if (matchesClass) {
                        if (!isInsideSubfolder) {
                            if (!f.parentId || f.parentId === 'null' || f.parentId === 'undefined' || f.parentId === '') {
                                foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: null });
                            }
                        } else {
                            if (window.activeFolderIdFilter && String(f.parentId) === String(window.activeFolderIdFilter)) {
                                foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: f.parentId });
                            }
                        }
                    }
                });
            }

            if (!isInsideSubfolder) {
                // COURSE ROOT LEVEL: If a specific course is open, collect top-level folders for that course
                if (activeCourseId && courseCurriculums[activeCourseId]) {
                    courseCurriculums[activeCourseId].forEach(f => {
                        if (f && f.name && f.name !== 'undefined' && f.name !== 'null' && f.name.trim() !== '' && (!f.parentId || f.parentId === 'null' || f.parentId === 'undefined' || f.parentId === '')) {
                            foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: null });
                        }
                    });
                }

                // Also include implicit chapter folders from noteCards at root level for this class
                noteCards.forEach(card => {
                    const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                    const matchesClass = activeClass === 'all' || !activeClassClean || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);
                    if (!matchesClass) return;

                    const chap = card.getAttribute('data-chapter-name');
                    if (chap && chap !== 'General Notes' && chap !== 'General Course Notes' && chap !== 'undefined' && chap !== 'null' && chap.trim() !== '') {
                        const key = chap.trim().toLowerCase();
                        if (!foldersMap.has(key)) {
                            foldersMap.set(key, { _id: null, name: chap, parentId: null });
                        }
                    }
                });
            } else {
                // INSIDE A SUB-FOLDER: Collect child sub-folders belonging to current parent folder
                if (activeCourseId && courseCurriculums[activeCourseId]) {
                    courseCurriculums[activeCourseId].forEach(f => {
                        if (f && f.name && f.name !== 'undefined' && f.name !== 'null' && f.name.trim() !== '' && window.activeFolderIdFilter && String(f.parentId) === String(window.activeFolderIdFilter)) {
                            foldersMap.set(f.name.trim().toLowerCase(), { _id: f._id, name: f.name, parentId: f.parentId });
                        }
                    });
                }
            }

            let currentLevelFolders = Array.from(foldersMap.values()).filter(f => 
                f && f.name && f.name.trim() !== '' && f.name !== 'undefined' && f.name !== 'null' && f.name !== 'General Notes'
            );

            // 3. Second pass: Filter note cards visibility based on current folder level
            noteCards.forEach(card => {
                const cardClass = (card.getAttribute('data-class-level') || '').trim().toLowerCase();
                const isGeneral = !cardClass || cardClass === 'general academic' || cardClass === 'general' || cardClass === 'all';
                const matchesClass = activeClass === 'all' || !activeClassClean || isGeneral || cardClass === activeClassClean || cardClass.includes(activeClassClean) || activeClassClean.includes(cardClass);

                if (!matchesClass) {
                    card.classList.add('hidden');
                    return;
                }

                const isUnlocked = card.getAttribute('data-unlocked') === 'true';
                const isCourse = card.getAttribute('data-iscourse') === 'true';
                const chapName = card.getAttribute('data-chapter-name') || 'General Notes';
                const parentFId = card.getAttribute('data-parent-folder-id') || '';
                const searchable = card.getAttribute('data-search') || '';

                let matchesChip = true;
                if (window.currentQuickFilter === 'free') matchesChip = isUnlocked;
                else if (window.currentQuickFilter === 'paid') matchesChip = !isUnlocked;
                else if (window.currentQuickFilter === 'course') matchesChip = isCourse;

                const matchesQuery = query.length === 0 || searchable.includes(query);

                let matchesChapter = true;
                if (window.activeFolderIdFilter) {
                    matchesChapter = Boolean(parentFId && String(parentFId) === String(window.activeFolderIdFilter));
                } else if (window.activeChapterFilter) {
                    matchesChapter = (chapName && chapName.trim().toLowerCase() === window.activeChapterFilter.trim().toLowerCase());
                } else if (isInitialFiltered) {
                    // At Course or Subject root (no folder opened yet):
                    // Hide notes that belong to any subfolder
                    const hasExplicitParentFolder = Boolean(parentFId && parentFId !== '' && parentFId !== 'null');
                    
                    const matchesFolderByName = currentLevelFolders.some(f => 
                        f.name && chapName && f.name.trim().toLowerCase() === chapName.trim().toLowerCase()
                    );

                    const matchesFolderById = currentLevelFolders.some(f => 
                        f._id && parentFId && (f._id.toString() === parentFId.toString())
                    );

                    const belongsToSubfolder = hasExplicitParentFolder || matchesFolderByName || matchesFolderById;

                    matchesChapter = !belongsToSubfolder;
                }

                if (matchesChip && matchesChapter && matchesQuery) {
                    card.classList.remove('hidden');
                    visibleNotesCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            // 4. Handle global search filtering for Subject and Course cards
            if (query.length > 0) {
                subjectCards.forEach(card => {
                    const searchable = card.getAttribute('data-search') || '';
                    if (searchable.includes(query)) {
                        card.classList.remove('hidden');
                        visibleSubjectCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                courseCards.forEach(card => {
                    const searchable = card.getAttribute('data-search') || '';
                    if (searchable.includes(query)) {
                        card.classList.remove('hidden');
                        visibleCourseCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });
            } else {
                subjectCards.forEach(card => card.classList.remove('hidden'));
                courseCards.forEach(card => card.classList.remove('hidden'));
                visibleSubjectCount = subjectCards.length;
                visibleCourseCount = courseCards.length;
            }

            const subjectSection = document.getElementById('subject-folders-section');
            if (subjectSection) {
                if (visibleSubjectCount > 0) subjectSection.classList.remove('hidden');
                else subjectSection.classList.add('hidden');
            }

            const courseSection = document.getElementById('course-folders-section');
            if (courseSection) {
                if (visibleCourseCount > 0) courseSection.classList.remove('hidden');
                else courseSection.classList.add('hidden');
            }

            const hasActiveSearchOrFilter = query.length > 0 || window.currentQuickFilter !== 'all';
            const isInsideCourseOrSubject = isInitialFiltered;

            if (!isInsideCourseOrSubject && !hasActiveSearchOrFilter) {
                // LEVEL 0: Main Subject & Course Folders View
                if (foldersContainer) foldersContainer.classList.remove('hidden');
                if (folderSelectorWrapper) folderSelectorWrapper.classList.remove('hidden');
                if (breadcrumbBar) breadcrumbBar.classList.add('hidden');
                if (chaptersContainer) chaptersContainer.classList.add('hidden');
                if (notesContainer) notesContainer.classList.add('hidden');

                const notesGridView = document.getElementById('notes-grid-view');
                if (notesGridView) notesGridView.classList.add('hidden');
                if (emptyFolderState) emptyFolderState.classList.add('hidden');
                if (noResultsBox) noResultsBox.classList.add('hidden');

            } else {
                // LEVEL 1 & 2: Sub-Folders & Files View inside Subject or Nested Folder
                if (foldersContainer) foldersContainer.classList.add('hidden');
                if (folderSelectorWrapper) folderSelectorWrapper.classList.add('hidden');
                if (breadcrumbBar) breadcrumbBar.classList.remove('hidden');
                if (notesContainer) notesContainer.classList.remove('hidden');

                const breadcrumbLink = breadcrumbBar.querySelector('a');
                if (window.folderNavStack.length > 0) {
                    const currentFolder = window.folderNavStack[window.folderNavStack.length - 1];
                    const prevFolder = window.folderNavStack.length > 1 ? window.folderNavStack[window.folderNavStack.length - 2].name : parentName;
                    if (breadcrumbTitle) breadcrumbTitle.textContent = currentFolder.name;
                    if (breadcrumbLink) {
                        breadcrumbLink.setAttribute('href', '#');
                        breadcrumbLink.onclick = (e) => { e.preventDefault(); closeChapterFolder(); };
                        breadcrumbLink.querySelector('span:last-child').textContent = prevFolder;
                    }
                } else {
                    if (breadcrumbTitle) breadcrumbTitle.textContent = parentName;
                    if (breadcrumbLink) {
                        breadcrumbLink.setAttribute('href', '/teacher/notes');
                        breadcrumbLink.onclick = null;
                        breadcrumbLink.querySelector('span:last-child').textContent = 'All Folders';
                    }
                }

                // Render Sub-folders if available at current level
                if (currentLevelFolders && currentLevelFolders.length > 0) {
                    if (chaptersContainer) chaptersContainer.classList.remove('hidden');
                    if (chaptersGrid) {
                        chaptersGrid.innerHTML = '';
                        currentLevelFolders.forEach(f => {
                            const chapName = f.name;
                            const cardEl = document.createElement('div');
                            cardEl.className = 'chapter-folder-card relative bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 hover:border-amber-500/50 rounded-xl p-3.5 flex items-center justify-between transition-all duration-200 group shadow-none cursor-pointer';
                            cardEl.onclick = () => {
                                openChapterFolder(chapName, f._id);
                            };

                            let deleteBtnHtml = '';
                            if (f._id) {
                                deleteBtnHtml = `
                                    <button type="button" onclick="deleteCustomFolder(event, '${f._id}')" class="size-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/10 flex items-center justify-center transition-all z-10 shrink-0 cursor-pointer" title="Delete Folder">
                                        <span class="material-symbols-rounded text-base leading-none">delete</span>
                                    </button>
                                `;
                            }

                            cardEl.innerHTML = `
                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                    <div class="size-10 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-500 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
                                        <span class="material-symbols-rounded text-xl leading-none select-none">folder</span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white truncate group-hover:text-amber-500 transition-colors">
                                            ${chapName}
                                        </h4>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1 shrink-0">
                                    ${deleteBtnHtml}
                                    <span class="material-symbols-rounded text-slate-300 dark:text-slate-600 group-hover:text-amber-500 group-hover:translate-x-0.5 transition-all text-xl leading-none select-none">chevron_right</span>
                                </div>
                            `;
                            chaptersGrid.appendChild(cardEl);
                        });
                    }
                } else {
                    if (chaptersContainer) chaptersContainer.classList.add('hidden');
                    if (chaptersGrid) chaptersGrid.innerHTML = '';
                }

                // Render Files container if matching notes exist or show empty state if no subfolders exist
                const notesGridView = document.getElementById('notes-grid-view');
                if (visibleNotesCount > 0) {
                    if (notesGridView) notesGridView.classList.remove('hidden');
                    if (emptyFolderState) emptyFolderState.classList.add('hidden');
                    if (noResultsBox) noResultsBox.classList.add('hidden');
                } else {
                    if (query.length > 0) {
                        if (notesGridView) notesGridView.classList.add('hidden');
                        if (emptyFolderState) emptyFolderState.classList.add('hidden');
                        if (noResultsBox) noResultsBox.classList.remove('hidden');
                    } else {
                        if (currentLevelFolders && currentLevelFolders.length > 0) {
                            if (notesGridView) notesGridView.classList.add('hidden');
                            if (emptyFolderState) emptyFolderState.classList.add('hidden');
                            if (noResultsBox) noResultsBox.classList.add('hidden');
                        } else {
                            if (notesGridView) notesGridView.classList.remove('hidden');
                            if (emptyFolderState) emptyFolderState.classList.remove('hidden');
                            if (noResultsBox) noResultsBox.classList.add('hidden');
                        }
                    }
                }
            }
        }

        function clearNotesSearch() {
            const searchInput = document.getElementById('notes-search-input');
            if (searchInput) {
                searchInput.value = '';
                filterLiveNotes();
                searchInput.focus();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            try {
                const savedMode = localStorage.getItem('oddhay_teacher_notes_view_mode') || 'grid';
                setViewMode(savedMode);
            } catch(e) {}

            filterLiveNotes();

            const searchInput = document.getElementById('notes-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', filterLiveNotes);
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeNoteModal();
            });
        });
    </script>
</body>

</html>