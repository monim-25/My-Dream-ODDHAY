                    </div>

                    <div class="p-4 bg-slate-50 dark:bg-slate-900/60 flex items-center justify-end gap-2 shrink-0">
                        <button type="button" onclick="document.getElementById('addNoteModal').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold hover:bg-slate-200">Cancel</button>
