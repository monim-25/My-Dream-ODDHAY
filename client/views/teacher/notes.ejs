                                        <option value="<%= c %>"><%= c %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <input type="hidden" name="chapter" id="noteChapter" value="">
                        <input type="hidden" name="course" id="noteCoursePicker" value="">

                        <div>
                            <label class="form-label">Access Type</label>
                            <select id="noteAccessType" name="accessType" class="form-input w-full cursor-pointer">
                                <option value="Free">Free — Open Access</option>
                                <option value="Paid">Paid — Premium Only</option>
