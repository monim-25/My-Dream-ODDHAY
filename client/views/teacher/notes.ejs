        // Custom UI Alert Notification (Replaces browser alert popup)
        function showCustomAlert(msg, type = 'warning', title = 'Notice') {
            const alertModal = document.getElementById('customAlertModal');
            const alertMsg = document.getElementById('alert-modal-msg');
            const alertTitle = document.getElementById('alert-modal-title');
            const alertIcon = document.getElementById('alert-modal-icon');
            const alertIconBg = document.getElementById('alert-modal-icon-bg');

            if (!alertModal) return;

            if (alertTitle) alertTitle.textContent = title;
            if (alertMsg) alertMsg.textContent = msg;

            if (type === 'danger' || type === 'error') {
                alertIcon.textContent = 'error';
                alertIconBg.className = 'size-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-500 flex items-center justify-center shrink-0';
            } else if (type === 'success') {
                alertIcon.textContent = 'check_circle';
                alertIconBg.className = 'size-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0';
            } else {
                alertIcon.textContent = 'warning';
                alertIconBg.className = 'size-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0';
            }

            alertModal.classList.remove('hidden');
            setTimeout(() => { alertModal.classList.add('hidden'); }, 4000);
        }

        function closeCustomAlert() {
            const alertModal = document.getElementById('customAlertModal');
            if (alertModal) alertModal.classList.add('hidden');
        }

        // Custom UI Confirmation Dialog (Replaces browser confirm popup)
        function showCustomConfirm({ title = 'Confirm Deletion', subtitle = 'Please confirm your action', body, onConfirm }) {
            const modal = document.getElementById('customConfirmModal');
            const titleEl = document.getElementById('confirm-modal-title');
            const subEl = document.getElementById('confirm-modal-subtitle');
            const bodyEl = document.getElementById('confirm-modal-body');
            const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
            const okBtn = document.getElementById('confirm-modal-ok-btn');

            if (!modal) return;

            if (titleEl) titleEl.textContent = title;
            if (subEl) subEl.textContent = subtitle;
            if (bodyEl) bodyEl.textContent = body;

            modal.classList.remove('hidden');

            const handleCancel = () => {
                modal.classList.add('hidden');
                cancelBtn.removeEventListener('click', handleCancel);
                okBtn.removeEventListener('click', handleOk);
            };

            const handleOk = () => {
                modal.classList.add('hidden');
                cancelBtn.removeEventListener('click', handleCancel);
                okBtn.removeEventListener('click', handleOk);
                if (typeof onConfirm === 'function') onConfirm();
            };

            cancelBtn.addEventListener('click', handleCancel);
            okBtn.addEventListener('click', handleOk);
        }

        function confirmDeleteNote(event, noteId) {
            event.preventDefault();
            showCustomConfirm({
                title: 'Delete Note File',
                subtitle: 'Permanent deletion',
                body: 'Are you sure you want to delete this note file? This action cannot be undone.',
                onConfirm: () => {
                    window.location.href = `/teacher/note/${noteId}/delete`;
                }
            });
        }

        function deleteCustomFolder(event, folderId) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            const targetFolder = (window.customFolders || []).find(f => String(f._id) === String(folderId));
            if (targetFolder && (targetFolder.isSyllabusFolder || targetFolder.isSystem)) {
                return showCustomAlert('Auto-generated syllabus folders cannot be deleted from the notes portal.', 'warning', 'Protected Folder');
            }
            showCustomConfirm({
                title: 'Delete Folder',
                subtitle: 'Permanent deletion',
                body: 'Are you sure you want to delete this folder? All child notes will be unlinked.',
                onConfirm: async () => {
                    try {
                        const res = await fetch(`/teacher/folder/${folderId}/delete`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            if (window.customFolders) {
                                window.customFolders = window.customFolders.filter(f => String(f._id) !== String(folderId));
                            }
                            showCustomAlert('Folder deleted successfully.', 'success', 'Folder Deleted');
                            filterLiveNotes();
                        } else {
                            showCustomAlert(data.error || 'Failed to delete folder', 'danger', 'Error');
                        }
                    } catch (e) {
                        console.error(e);
                        showCustomAlert('Failed to delete folder', 'danger', 'Error');
                    }
                }
            });
        }

        function openAddFolderModal(presetSubject = '', presetParentId = '') {
            const modal = document.getElementById('addFolderModal');
            if (!modal) return;

            const subjInput = document.getElementById('folderSubject');
            const classInput = document.getElementById('folderClassLevel');
            const parentInput = document.getElementById('folderParentId');

            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = urlParams.get('subject') || '';

            const activeSubj = presetSubject || urlSubj || (window.activeSubject && window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'));
            const activeParent = presetParentId || window.activeFolderIdFilter || '';

            if (subjInput) subjInput.value = activeSubj;
            if (parentInput) parentInput.value = activeParent;
            if (classInput) {
                const assignedClassesList = <%- JSON.stringify(locals.classes || []) %>;
                classInput.value = assignedClassesList[0] || 'Class 10';
            }

            const folderNameInput = document.getElementById('folderName');
            if (folderNameInput) folderNameInput.value = '';

            modal.classList.remove('hidden');
        }

        async function submitAddFolder(e) {
            e.preventDefault();
            const name = document.getElementById('folderName').value.trim();
            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = urlParams.get('subject') || '';

            const subject = document.getElementById('folderSubject').value || urlSubj || (window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'));
            const classLevel = document.getElementById('folderClassLevel').value || '';
            const parentId = document.getElementById('folderParentId').value || window.activeFolderIdFilter || '';

            if (!name) {
                showCustomAlert('Please enter a folder name.', 'warning', 'Missing Name');
                return;
            }

            try {
                const res = await fetch('/teacher/add-folder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ name, subject, classLevel, parentId })
                });
                const data = await res.json();
                if (data.success && data.folder) {
                    document.getElementById('addFolderModal').classList.add('hidden');
                    document.getElementById('folderName').value = '';
                    
                    if (!window.customFolders) window.customFolders = [];
                    window.customFolders.push(data.folder);
                    
                    showCustomAlert('Folder created successfully.', 'success', 'Folder Created');
                    filterLiveNotes();
                } else {
                    showCustomAlert(data.error || 'Failed to create folder', 'danger', 'Error');
                }
            } catch (err) {
                console.error(err);
                showCustomAlert('Failed to create folder', 'danger', 'Error');
            }
        }

        function handleNoteFileSelected(input) {
            const file = input.files && input.files[0];
            const nameEl = document.getElementById('noteFileNamePreview');
            const sizeEl = document.getElementById('noteFileSizePreview');
            const iconBox = document.getElementById('noteFileIconBox');
            const dropzone = document.getElementById('noteFileDropzone');

            if (!file) {
                if (nameEl) nameEl.textContent = 'Select PDF file';
                if (sizeEl) sizeEl.textContent = 'Max 25MB';
                if (dropzone) {
                    dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/10');
                    dropzone.classList.add('border-slate-200', 'dark:border-slate-700');
                }
                return;
            }

            if (file.size > 25 * 1024 * 1024) {
                showCustomAlert('File size exceeds the 25MB maximum limit. Please select a file under 25MB.', 'warning', 'File Too Large');
                input.value = '';
                if (nameEl) nameEl.textContent = 'Select PDF file';
                if (sizeEl) sizeEl.textContent = 'Max 25MB';
                return;
            }

            if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                showCustomAlert('Please select a valid PDF file.', 'warning', 'Invalid File');
                input.value = '';
                if (nameEl) nameEl.textContent = 'Tap to choose PDF document';
                if (sizeEl) sizeEl.textContent = 'PDF document only (up to 25MB)';
                return;
            }

            const sizeStr = file.size > 1048576 
                ? (file.size / 1048576).toFixed(1) + ' MB'
                : (file.size / 1024).toFixed(0) + ' KB';

            if (nameEl) nameEl.textContent = file.name;
            if (sizeEl) sizeEl.textContent = sizeStr;
            if (dropzone) {
                dropzone.classList.remove('border-slate-200', 'dark:border-slate-700');
                dropzone.classList.add('border-emerald-500', 'bg-emerald-50/10');
            }
            if (iconBox) {
                iconBox.className = 'size-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-2 border border-emerald-500/20';
                iconBox.innerHTML = '<span class="material-symbols-rounded text-2xl leading-none">task</span>';
            }
        }
        window.handleNoteFileSelected = handleNoteFileSelected;

        function openAddNoteModal(presetSubject = '', presetCourseId = '', presetChapter = '') {
            const modal = document.getElementById('addNoteModal');
            if (!modal) return;
            
            const subjInput = document.getElementById('noteSubject');
            const parentFolderInput = document.getElementById('noteParentFolderId');
            const courseInput = document.getElementById('noteCoursePicker');
            const targetBadge = document.getElementById('noteFolderContextBadge');
            const targetText = document.getElementById('noteTargetFolderText');

            // Detect folder context from active folder navigation
            let detectedSubject = '';
            let detectedChapter = '';
            let detectedClass = '';
            let detectedFolderId = window.activeFolderIdFilter || '';

            if (detectedFolderId && window.customFolders) {
                const curFolder = window.customFolders.find(f => String(f._id) === String(detectedFolderId));
                if (curFolder) {
                    if (curFolder.parentId) {
                        detectedChapter = curFolder.name;
                        const parentFolder = window.customFolders.find(f => String(f._id) === String(curFolder.parentId));
                        detectedSubject = curFolder.subject || (parentFolder ? (parentFolder.subject || parentFolder.name) : '');
                        detectedClass = curFolder.classLevel || (parentFolder ? parentFolder.classLevel : '') || window.activeClass || '';
                    } else {
                        detectedSubject = curFolder.subject || curFolder.name;
                        detectedClass = curFolder.classLevel || window.activeClass || '';
                    }
                }
            }

            if (!detectedSubject && window.folderNavStack && window.folderNavStack.length > 0) {
                if (window.folderNavStack.length >= 2) {
                    detectedSubject = window.folderNavStack[0].name;
                    detectedChapter = window.folderNavStack[1].name;
                } else if (window.folderNavStack.length === 1) {
                    detectedSubject = window.folderNavStack[0].name;
                }
                detectedClass = window.activeClass || '';
            }

            const urlParams = new URLSearchParams(window.location.search);
            const urlSubj = (urlParams.get('subject') && urlParams.get('subject') !== 'all') ? urlParams.get('subject') : '';
            const isInsideSubjectFolder = Boolean(presetSubject || detectedSubject || urlSubj || (window.activeSubject && window.activeSubject !== 'all'));
            const activeSubj = (presetSubject || detectedSubject || urlSubj || (window.activeSubject && window.activeSubject !== 'all' ? window.activeSubject : (window.assignedSubjects && window.assignedSubjects[0] ? window.assignedSubjects[0] : 'General Academic'))).trim();
            const activeChapter = (presetChapter || detectedChapter || window.activeChapterFilter || '').trim();
            const activeClass = (detectedClass || (window.activeClass && window.activeClass !== 'all' ? window.activeClass : '') || urlParams.get('class') || '').trim();
            const activeParentId = detectedFolderId || '';
            const activeCourse = presetCourseId || window.activeCourseId || '';

            window._initialNoteChapter = activeChapter;

            // Handle Subject UI & Context Locking
            const lockedNotice = document.getElementById('noteSubjectLockedNotice');
            const lockedText = document.getElementById('lockedSubjectText');
            const subjectHidden = document.getElementById('noteSubjectHidden');

            if (subjectHidden) subjectHidden.value = activeSubj;

            if (subjInput) {
                let match = Array.from(subjInput.options).find(o => o.value.trim().toLowerCase() === activeSubj.toLowerCase());
                if (!match) {
                    const aliases = (typeof getSubjectAliases === 'function') ? getSubjectAliases(activeSubj) : [activeSubj];
                    match = Array.from(subjInput.options).find(o => aliases.some(a => a.toLowerCase() === o.value.trim().toLowerCase()));
                }
                if (match) {
                    subjInput.value = match.value;
                    if (subjectHidden) subjectHidden.value = match.value;
                } else if (activeSubj) {
                    const opt = document.createElement('option');
                    opt.value = activeSubj;
                    opt.textContent = activeSubj;
                    subjInput.appendChild(opt);
                    subjInput.value = activeSubj;
                }

                if (isInsideSubjectFolder && activeSubj) {
                    // Lock subject: hide dropdown so no different subject can be chosen, show locked card!
                    subjInput.classList.add('hidden');
                    if (lockedNotice) {
                        lockedNotice.classList.remove('hidden');
                        if (lockedText) lockedText.textContent = activeSubj;
                    }
                } else {
                    subjInput.classList.remove('hidden');
                    if (lockedNotice) lockedNotice.classList.add('hidden');
                }
            }

            // Handle Chapter UI & Context Locking
            const isInsideChapterFolder = Boolean(presetChapter || detectedChapter || (window.folderNavStack && window.folderNavStack.length >= 2));
            const activeChapterVal = (presetChapter || detectedChapter || (window.folderNavStack && window.folderNavStack.length >= 2 ? window.folderNavStack[1].name : '') || window.activeChapterFilter || '').trim();

            window._initialNoteChapter = activeChapterVal;

            const chapterLockedNotice = document.getElementById('noteChapterLockedNotice');
            const lockedChapterText = document.getElementById('lockedChapterText');
            const chapterHidden = document.getElementById('noteChapterHidden');
            const chapterSelect = document.getElementById('noteChapter');

            if (chapterHidden) chapterHidden.value = activeChapterVal;

            if (chapterSelect) {
                if (isInsideChapterFolder && activeChapterVal) {
                    chapterSelect.classList.add('hidden');
                    if (chapterLockedNotice) {
                        chapterLockedNotice.classList.remove('hidden');
                        if (lockedChapterText) lockedChapterText.textContent = activeChapterVal;
                    }
                } else {
                    chapterSelect.classList.remove('hidden');
                    if (chapterLockedNotice) chapterLockedNotice.classList.add('hidden');
                }
            }

            if (parentFolderInput) parentFolderInput.value = activeParentId;
            if (courseInput) courseInput.value = activeCourse;

            // Handle Class UI & Context Locking
            const isInsideClassFolder = Boolean(activeClass && activeClass.toLowerCase() !== 'all');
            const classLockedNotice = document.getElementById('noteClassLockedNotice');
            const lockedClassText = document.getElementById('lockedClassText');
            const classHidden = document.getElementById('noteClassHidden');
            const classesContainer = document.getElementById('noteClassesContainer');

            if (classHidden) {
                if (isInsideClassFolder) {
                    classHidden.disabled = false;
                    classHidden.value = activeClass;
                } else {
                    classHidden.disabled = true;
                    classHidden.value = '';
                }
            }

            if (isInsideClassFolder) {
                if (classesContainer) classesContainer.classList.add('hidden');
                if (classLockedNotice) {
                    classLockedNotice.classList.remove('hidden');
                    if (lockedClassText) lockedClassText.textContent = activeClass;
                }
            } else {
                if (classesContainer) classesContainer.classList.remove('hidden');
                if (classLockedNotice) classLockedNotice.classList.add('hidden');
            }

            // Auto-check target class matching active folder / filter
            const classCheckboxes = document.querySelectorAll('#noteClassesContainer input[name="classLevel[]"]');
            let hasAnyChecked = false;
            classCheckboxes.forEach(cb => {
                const cbVal = cb.value.toLowerCase();
                const actVal = activeClass.toLowerCase();
                if (activeClass && activeClass !== 'all' && (cbVal === actVal || cbVal.includes(actVal) || actVal.includes(cbVal))) {
                    cb.checked = true;
                    hasAnyChecked = true;
                } else {
                    cb.checked = false;
                }
            });
            if (!hasAnyChecked && classCheckboxes.length > 0 && !isInsideClassFolder) {
                classCheckboxes[0].checked = true;
            }

            if (window.onNoteSubjectOrClassChange) window.onNoteSubjectOrClassChange();

            if (targetBadge && targetText) {
                const parts = [];
                if (activeSubj) parts.push(activeSubj);
                if (activeChapter) parts.push(activeChapter);
                if (activeClass && activeClass !== 'all') parts.push(activeClass);
                if (parts.length > 0) {
                    targetText.textContent = parts.join(' • ');
                    targetBadge.classList.remove('hidden');
                } else {
                    targetBadge.classList.add('hidden');
                }
            }

            // Reset file preview
            const fileInput = document.getElementById('noteFileInput');
            if (fileInput) {
                fileInput.value = '';
                fileInput.disabled = false;
            }
            const existingUrlInput = document.getElementById('addNoteForm')?.querySelector('input[name="fileUrl"]');
            if (existingUrlInput) existingUrlInput.remove();
            const nameEl = document.getElementById('noteFileNamePreview');
            const sizeEl = document.getElementById('noteFileSizePreview');
            const iconBox = document.getElementById('noteFileIconBox');
            const dropzone = document.getElementById('noteFileDropzone');
            if (nameEl) nameEl.textContent = 'Select PDF file';
            if (sizeEl) sizeEl.textContent = 'Max 25MB';
            if (dropzone) {
                dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/10');
                dropzone.classList.add('border-slate-200', 'dark:border-slate-700');
            }
            if (iconBox) {
                iconBox.className = 'size-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-2 border border-primary/20';
                iconBox.innerHTML = '<span class="material-symbols-rounded text-2xl leading-none">picture_as_pdf</span>';
            }

            // Reset submit button state
            const submitBtn = document.getElementById('addNoteSubmitBtn');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span class="material-symbols-rounded text-sm leading-none">cloud_upload</span><span>Upload Note</span>';
            }

            modal.classList.remove('hidden');
        }

        function openChapterFolder(chapterName, folderId) {
            window.activeChapterFilter = chapterName;
            window.activeFolderIdFilter = folderId || null;
            window.folderNavStack.push({ name: chapterName, id: folderId || null });
            filterLiveNotes();
