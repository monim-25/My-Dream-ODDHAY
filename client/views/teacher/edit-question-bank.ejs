<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Edit <%= bank.board %> <%= bank.year %> | ODDHAY</title>
    <style>
        * { font-family: 'Inter', 'Hind Siliguri', sans-serif !important; }
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .glass-panel { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(16px); border: 1px solid rgba(226, 232, 240, 0.8); }
        .dark .glass-panel { background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(51, 65, 85, 0.8); }
        .q-card { transition: all 0.2s ease; border-radius: 1rem; }
        .edit-mode .static-content { display: none !important; }
        .edit-mode .edit-content { display: block !important; }
        .static-content { display: block; }
        .edit-content { display: none; }
        
        .icon-box { display: inline-flex; align-items: center; justify-content: center; vertical-align: middle; line-height: 1; }
        .material-symbols-rounded { display: block; line-height: 1; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans h-full h-[100dvh] overflow-hidden">
    <div class="flex h-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'questions' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 flex flex-col h-full overflow-hidden">
            <%- include('header', { pageTitle: 'Archive Editor' }) %>

            <!-- Main Scrollable Area -->
            <div class="flex-1 overflow-y-auto px-3 sm:px-4 md:px-6 pt-2 pb-28 sm:pb-24 scroll-smooth relative custom-scrollbar">
                <div class="max-w-6xl mx-auto">


                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-5 items-start relative">
                        
                        <!-- Left Column: Archive Metadata -->
                        <div class="lg:col-span-4 lg:sticky lg:top-3 z-10">
                            <div class="glass-panel rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200/80 dark:border-slate-800">
                                <div class="flex items-center justify-between gap-2 mb-3 cursor-pointer select-none" onclick="toggleArchiveInfoMobile()">
                                    <div class="flex items-center gap-2">
                                        <div class="size-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                                            <span class="material-symbols-rounded text-base">info</span>
                                        </div>
                                        <div>
                                            <h2 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white">Paper Details</h2>
                                            <p class="text-[10px] font-medium text-slate-400"><%= bank.board %> • <%= bank.year %></p>
                                        </div>
                                    </div>
                                    <button type="button" class="lg:hidden size-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 flex items-center justify-center" aria-label="Toggle details">
                                        <span id="metaToggleIcon" class="material-symbols-rounded text-base transition-transform">expand_more</span>
                                    </button>
                                </div>

                                <form id="archiveMetaForm" action="/teacher/edit-question-bank/<%= bank._id %>" method="POST" enctype="multipart/form-data" class="space-y-3 pt-1 hidden lg:block">
                                    <div class="space-y-1">
                                        <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5">Board / Institution</label>
                                        <input type="text" name="board" value="<%= bank.board %>" required class="w-full h-9 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold focus:border-primary outline-none transition-all">
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                        <div class="space-y-1">
                                            <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5">Year</label>
                                            <input type="text" name="year" value="<%= bank.year %>" required class="w-full h-9 px-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold focus:border-primary outline-none transition-all">
                                        </div>
                                        <div class="space-y-1">
                                             <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5">Level</label>
                                             <%
                                                 const bankClasses = (Array.isArray(bank.classLevel) ? bank.classLevel : [bank.classLevel]).map(c => String(c).trim());
                                             %>
                                             <input type="hidden" name="classLevel" value="<%= bankClasses[0] || '' %>">
                                             <div class="w-full h-9 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1.5 cursor-not-allowed select-none">
                                                 <span class="material-symbols-rounded text-sm text-slate-400 shrink-0">lock</span>
                                                 <span class="truncate"><%= bankClasses.join(', ') || '' %></span>
                                             </div>
                                        </div>
                                        <div class="space-y-1">
                                            <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5">Time (M)</label>
                                            <input type="number" name="duration" value="<%= bank.duration || 30 %>" min="1" max="600" class="w-full h-9 px-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold focus:border-primary outline-none transition-all text-center">
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                         <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5">Subject</label>
                                         <input type="hidden" name="subject" value="<%= bank.subject || '' %>">
                                         <div class="w-full h-9 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1.5 cursor-not-allowed select-none">
                                             <span class="material-symbols-rounded text-sm text-slate-400 shrink-0">lock</span>
                                             <span class="truncate"><%= bank.subject || '' %></span>
                                         </div>
                                    </div>

                                    <div class="pt-1">
                                        <label class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 ml-0.5 mb-1.5 block">Attached Paper PDF (Optional)</label>
                                        <% if (bank.fileUrl) { %>
                                            <div class="mb-2 p-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200/60 dark:border-emerald-500/20 flex items-center justify-between gap-2">
                                                <div class="flex items-center gap-2 overflow-hidden flex-1">
                                                    <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-base shrink-0">check_circle</span>
                                                    <p class="text-[11px] font-medium truncate text-emerald-800 dark:text-emerald-300"><%= bank.fileUrl.split('/').pop() %></p>
                                                </div>
                                                <button type="button" onclick="deleteAttachment(event, '<%= bank._id %>')" class="size-7 rounded-lg bg-red-100 hover:bg-red-200 text-red-600 dark:bg-red-500/20 dark:hover:bg-red-500/30 dark:text-red-400 transition-colors flex items-center justify-center shrink-0 cursor-pointer" title="Delete Attachment">
                                                    <span class="material-symbols-rounded text-sm">delete</span>
                                                </button>
                                            </div>
                                        <% } %>
                                        <div class="relative group">
                                            <input type="file" name="file" class="absolute inset-0 size-full opacity-0 cursor-pointer z-10" onchange="updateFileName(this)">
                                            <div class="w-full h-10 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 flex items-center justify-center gap-2 group-hover:border-primary/50 transition-all bg-slate-50/50 dark:bg-slate-900/50">
                                                <span class="material-symbols-rounded text-base text-slate-400 group-hover:text-primary">upload_file</span>
                                                <p id="file-label" class="text-[11px] font-medium text-slate-500">Replace/Upload PDF</p>
                                            </div>
                                        </div>
                                    </div>

                                    <button type="submit" class="w-full h-9 bg-slate-900 dark:bg-white dark:text-slate-900 text-white rounded-xl font-medium text-xs hover:bg-black dark:hover:bg-slate-100 transition-all shadow-xs cursor-pointer">
                                        Save Paper Info
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Right Column: Question Inventory -->
                        <div class="lg:col-span-8 space-y-3.5">
                            <!-- Controls Bar -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 px-1">
                                <div class="flex items-center gap-2">
                                    <div class="size-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-rounded text-base">format_list_bulleted</span>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <h2 class="text-sm sm:text-base font-bold text-slate-800 dark:text-white">Question Inventory</h2>
                                        <span class="text-[11px] font-medium text-slate-400">(<%= questions.length %> items)</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button id="toggleEditBtn" type="button" onclick="toggleEditMode()" class="flex-1 sm:flex-none h-8 sm:h-9 px-3 rounded-xl border border-slate-200 dark:border-slate-800 text-[11px] font-medium flex items-center justify-center gap-1.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all shadow-2xs cursor-pointer">
                                        <span class="material-symbols-rounded text-sm text-slate-500">edit</span>
                                        <span id="toggleEditLabel">Edit Mode</span>
                                    </button>
                                    <button type="button" onclick="toggleAllAnswers()" class="flex-1 sm:flex-none h-8 sm:h-9 px-3 rounded-xl border border-slate-200 dark:border-slate-800 text-[11px] font-medium flex items-center justify-center gap-1.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all shadow-2xs cursor-pointer">
                                        <span class="material-symbols-rounded text-sm text-slate-500">visibility</span>
                                        <span>Answers</span>
                                    </button>
                                </div>
                            </div>

                            <form id="bulkQuestionForm" action="/teacher/question-bank/<%= bank._id %>/bulk-update-questions" method="POST" class="space-y-3">
                                <div class="space-y-3" id="questionList">
                                    <% questions.forEach((q, i) => { %>
                                        <div class="q-card glass-panel p-3.5 sm:p-5 border border-slate-200/80 dark:border-slate-800 relative group/card" id="q-block-<%= i %>">
                                            <input type="hidden" name="questionIds[]" value="<%= q._id %>">
                                            
                                            <!-- Card Header -->
                                            <div class="flex justify-between items-center gap-2 mb-2 pb-2 border-b border-slate-100 dark:border-slate-800/60">
                                                <div class="flex items-center gap-2">
                                                    <span class="size-6 rounded-md bg-slate-900 dark:bg-slate-800 text-white text-[11px] font-bold flex items-center justify-center shrink-0">
                                                        <%= (i + 1).toString().padStart(2, '0') %>
                                                    </span>
                                                    <% const typeCol = { 'MCQ': 'blue', 'Short': 'emerald', 'Medium': 'amber', 'Comprehension': 'purple' }[q.questionType] || 'slate'; %>
                                                    <span class="px-2 py-0.5 rounded-md bg-<%= typeCol %>-50 dark:bg-<%= typeCol %>-500/10 text-[10px] font-semibold text-<%= typeCol %>-600 dark:text-<%= typeCol %>-400 border border-<%= typeCol %>-200/50 dark:border-<%= typeCol %>-500/20">
                                                        <%= q.questionType %>
                                                    </span>
                                                    <span class="text-[10px] font-medium text-slate-400">
                                                        <%= q.marks || (q.questionType === 'Comprehension' ? 4 : (q.questionType === 'Short' ? 2 : (q.questionType === 'Medium' ? 4 : 1))) %> Marks
                                                    </span>
                                                </div>

                                                <!-- Action Buttons: Always visible on mobile, hover on desktop -->
                                                <div class="flex items-center gap-1 opacity-100 sm:opacity-0 sm:group-hover/card:opacity-100 transition-opacity">
                                                    <button type="button" onclick="toggleAnswer(<%= i %>)" class="size-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200 transition-colors cursor-pointer" title="View Answer">
                                                        <span class="material-symbols-rounded text-sm">visibility</span>
                                                    </button>
                                                    <button type="button" onclick="deleteQuestion('<%= q._id %>')" class="size-7 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-500 flex items-center justify-center hover:bg-rose-100 transition-colors cursor-pointer" title="Delete Question">
                                                        <span class="material-symbols-rounded text-sm">delete</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- STATIC VIEW CONTENT -->
                                            <div class="static-content space-y-2.5">
                                                <% if (q.questionType === 'Comprehension') { %>
                                                    <!-- Comprehension Static Content -->
                                                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                                                        <div class="flex items-center gap-1.5 text-primary text-xs font-medium mb-1">
                                                            <span class="material-symbols-rounded text-sm">auto_stories</span>
                                                            <span>উদ্দীপক / Passage Context</span>
                                                        </div>
                                                        <div class="text-xs sm:text-sm font-normal text-slate-800 dark:text-slate-200 leading-relaxed whitespace-pre-wrap"><%- q.context || q.questionText || '' %></div>
                                                    </div>

                                                    <div class="space-y-1.5 pt-1">
                                                        <% if (q.q1) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
                                                                <span class="text-primary font-bold">1. </span> <%= q.q1 %>
                                                            </div>
                                                        <% } %>
                                                        <% if (q.q2) { %>
                                                            <div class="p-2 sm:p-2.5 rounded-lg bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
                                                                <span class="text-primary font-bold">2. </span> <%= q.q2 %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% } else { %>
                                                    <!-- Standard Question Text -->
                                                    <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 leading-relaxed">
                                                        <%- q.questionText %>
                                                    </div>
                                                <% } %>

                                                <!-- Solutions & Options (Toggleable) -->
                                                <div id="ans-<%= i %>" class="hidden pt-3 border-t border-slate-100 dark:border-slate-800/60 space-y-2">
                                                    <% if (q.questionType === 'Comprehension') { %>
                                                        <div class="space-y-2">
                                                            <% if (q.q1) { %>
                                                                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800/70 text-xs space-y-1">
                                                                    <div class="font-medium text-slate-700 dark:text-slate-300">1. <%= q.q1 %></div>
                                                                    <% if (q.a1) { %>
                                                                        <div class="text-emerald-600 dark:text-emerald-400 font-medium">উত্তর: <%= q.a1 %></div>
                                                                    <% } %>
                                                                    <% const sol1 = q.s1 || q.solution1; %>
                                                                    <% if (sol1 && sol1.trim()) { %>
                                                                        <div class="text-slate-500 dark:text-slate-400 text-[11px]">সমাধান: <%= sol1 %></div>
                                                                    <% } %>
                                                                </div>
                                                            <% } %>
                                                            <% if (q.q2) { %>
                                                                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800/70 text-xs space-y-1">
                                                                    <div class="font-medium text-slate-700 dark:text-slate-300">2. <%= q.q2 %></div>
                                                                    <% if (q.a2) { %>
                                                                        <div class="text-emerald-600 dark:text-emerald-400 font-medium">উত্তর: <%= q.a2 %></div>
                                                                    <% } %>
                                                                    <% const sol2 = q.s2 || q.solution2; %>
                                                                    <% if (sol2 && sol2.trim()) { %>
                                                                        <div class="text-slate-500 dark:text-slate-400 text-[11px]">সমাধান: <%= sol2 %></div>
                                                                    <% } %>
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    <% } else if (q.questionType === 'MCQ') { %>
                                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                            <% (q.options || []).forEach((opt, idx) => { %>
                                                                <div class="p-2 rounded-lg border <%= q.correctAnswerIndex === idx ? 'bg-emerald-50 dark:bg-emerald-950/20 border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 font-semibold' : 'bg-slate-50 dark:bg-slate-900 border-slate-200/70 dark:border-slate-800 text-slate-600 dark:text-slate-400' %> text-xs flex items-center gap-2">
                                                                    <span class="size-5 rounded flex items-center justify-center text-[10px] font-bold shrink-0 <%= q.correctAnswerIndex === idx ? 'bg-emerald-500 text-white' : 'bg-slate-200 dark:bg-slate-700 text-slate-500' %>">
                                                                        <%= String.fromCharCode(65 + idx) %>
                                                                    </span>
                                                                    <span class="truncate"><%= opt %></span>
                                                                </div>
                                                            <% }) %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200/60 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs">
                                                            <span class="font-bold">Model Answer: </span>
                                                            <span><%= q.correctAnswer || 'Not provided' %></span>
                                                        </div>
                                                    <% } %>

                                                    <% if (q.explanation && q.explanation.trim() !== '') { %>
                                                        <div class="p-2.5 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200/60 dark:border-amber-500/20 text-amber-800 dark:text-amber-300 text-xs">
                                                            <span class="font-bold">Explanation: </span>
                                                            <span><%= q.explanation %></span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <!-- EDIT MODE CONTENT -->
                                            <div class="edit-content space-y-3 pt-1">
                                                <% if (q.questionType === 'Comprehension') { %>
                                                    <!-- Comprehension Edit Fields -->
                                                    <div class="space-y-1">
                                                        <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Context / Passage (উদ্দীপক)</label>
                                                        <textarea name="contexts[]" rows="3" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal focus:border-primary outline-none transition-all resize-none"><%= q.context || q.questionText || '' %></textarea>
                                                        <input type="hidden" name="texts[]" value="<%= q.questionText || q.context || '' %>">
                                                    </div>

                                                    <!-- Sub-Question 1 -->
                                                    <div class="p-2.5 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800/70 space-y-2">
                                                        <span class="text-[11px] font-bold text-primary">Question 1</span>
                                                        <input type="text" name="q1s[]" value="<%= q.q1 || '' %>" placeholder="Question 1..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                        <input type="text" name="a1s[]" value="<%= q.a1 || '' %>" placeholder="Answer 1..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                        <input type="text" name="s1s[]" value="<%= q.s1 || q.solution1 || '' %>" placeholder="Solution 1..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                    </div>

                                                    <!-- Sub-Question 2 -->
                                                    <div class="p-2.5 rounded-xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800/70 space-y-2">
                                                        <span class="text-[11px] font-bold text-primary">Question 2</span>
                                                        <input type="text" name="q2s[]" value="<%= q.q2 || '' %>" placeholder="Question 2..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                        <input type="text" name="a2s[]" value="<%= q.a2 || '' %>" placeholder="Answer 2..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                        <input type="text" name="s2s[]" value="<%= q.s2 || q.solution2 || '' %>" placeholder="Solution 2..." class="w-full h-8 px-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                    </div>
                                                <% } else { %>
                                                    <!-- Standard Question Text Edit -->
                                                    <div class="space-y-1">
                                                        <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Question Text</label>
                                                        <textarea name="texts[]" rows="2" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-normal focus:border-primary outline-none transition-all resize-none"><%= q.questionText.replace(/<[^>]*>?/gm, '') %></textarea>
                                                    </div>

                                                    <% if (q.questionType === 'MCQ') { %>
                                                        <!-- MCQ Options: 1 column on mobile phones, 2 columns on sm+ -->
                                                        <div class="space-y-1.5">
                                                            <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Options</label>
                                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                                <% for(let j=0; j<4; j++) { %>
                                                                    <div class="flex items-center gap-2">
                                                                        <span class="size-7 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xs font-semibold text-slate-500 shrink-0">
                                                                            <%= String.fromCharCode(65+j) %>
                                                                        </span>
                                                                        <input type="text" name="options_<%= i %>[]" value="<%= q.options ? q.options[j] : '' %>" placeholder="Option <%= String.fromCharCode(65+j) %>" class="flex-1 h-8 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="space-y-1">
                                                            <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Correct Option Index (0=A, 1=B, 2=C, 3=D)</label>
                                                            <input type="number" name="correctAnswers[]" value="<%= q.correctAnswerIndex %>" min="0" max="3" class="w-24 h-8 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold outline-none focus:border-primary text-center">
                                                        </div>
                                                    <% } else { %>
                                                        <div class="space-y-1">
                                                            <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Answer Content</label>
                                                            <input type="text" name="answers[]" value="<%= q.correctAnswer %>" class="w-full h-8 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                        </div>
                                                    <% } %>
                                                <% } %>

                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                                    <div class="sm:col-span-2 space-y-1">
                                                        <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Explanation</label>
                                                        <input type="text" name="explanations[]" value="<%= q.explanation %>" placeholder="Optional explanation" class="w-full h-8 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs outline-none focus:border-primary">
                                                    </div>
                                                    <div class="space-y-1">
                                                        <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Marks</label>
                                                        <input type="number" name="marks[]" value="<%= q.marks || (q.questionType === 'Comprehension' ? 4 : (q.questionType === 'Short' ? 2 : (q.questionType === 'Medium' ? 4 : 1))) %>" min="1" max="100" class="w-full h-8 px-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold outline-none focus:border-primary text-center">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>

                                <!-- Floating Save Bar: position cleanly above mobile bottom-nav -->
                                <div id="saveAllBar" class="hidden fixed bottom-20 sm:bottom-6 right-3 sm:right-6 z-50 p-1">
                                    <button type="submit" class="h-10 px-5 sm:px-6 bg-primary text-white rounded-xl text-xs font-semibold hover:bg-blue-600 transition-all shadow-xl shadow-primary/30 cursor-pointer active:scale-95 flex items-center gap-2">
                                        <span class="material-symbols-rounded text-base">save</span>
                                        <span>Save All Changes</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('bottom-nav', { activePage: 'questions' }) %>
        </main>
    </div>

    <script>

        function toggleArchiveInfoMobile() {
            if (window.innerWidth >= 1024) return;
            const form = document.getElementById('archiveMetaForm');
            const icon = document.getElementById('metaToggleIcon');
            if (form) {
                form.classList.toggle('hidden');
                if (icon) {
                    icon.style.transform = form.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                }
            }
        }

        function updateFileName(input) {
            const label = document.getElementById('file-label');
            if (input.files && input.files[0]) {
                label.textContent = input.files[0].name;
                label.classList.add('text-primary');
            }
        }

        function toggleEditMode() {
            document.body.classList.toggle('edit-mode');
            const btn = document.getElementById('toggleEditBtn');
            const label = document.getElementById('toggleEditLabel');
            const saveBar = document.getElementById('saveAllBar');
            
            if (document.body.classList.contains('edit-mode')) {
                btn.classList.add('bg-primary', 'text-white', 'border-primary');
                btn.classList.remove('hover:bg-slate-50', 'dark:hover:bg-slate-800');
                if (label) label.textContent = 'Done Editing';
                if (saveBar) saveBar.classList.remove('hidden');
            } else {
                btn.classList.remove('bg-primary', 'text-white', 'border-primary');
                btn.classList.add('hover:bg-slate-50', 'dark:hover:bg-slate-800');
                if (label) label.textContent = 'Edit Mode';
                if (saveBar) saveBar.classList.add('hidden');
            }
        }

        function toggleAnswer(id) {
            const ans = document.getElementById(`ans-${id}`);
            if (ans) ans.classList.toggle('hidden');
        }

        function toggleAllAnswers() {
            document.querySelectorAll('[id^="ans-"]').forEach(a => a.classList.toggle('hidden'));
        }

        async function deleteQuestion(id) {
            const res = await Swal.fire({
                title: 'Delete Question?',
                text: 'Are you sure you want to remove this question?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            });
            if (res.isConfirmed) {
                window.location.href = `/teacher/question/${id}/delete?redirect=/teacher/edit-question-bank/<%= bank._id %>`;
            }
        }

        async function deleteAttachment(e, bankId) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            const res = await Swal.fire({
                title: 'Delete Attachment?',
                text: 'Are you sure you want to remove this PDF?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete File',
                cancelButtonText: 'Cancel'
            });

            if (res.isConfirmed) {
                try {
                    const resp = await fetch(`/teacher/question-bank/${bankId}/delete-file`, {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        }
                    });
                    const data = await resp.json();
                    if (data.success) {
                        await Swal.fire({
                            title: 'Deleted!',
                            text: 'The attachment has been removed successfully.',
                            icon: 'success',
                            confirmButtonColor: '#137fec',
                            timer: 1500,
                            timerProgressBar: true
                        });
                        window.location.href = `/teacher/edit-question-bank/${bankId}?success=Attachment deleted`;
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.error || 'Failed to delete attachment',
                            icon: 'error',
                            confirmButtonColor: '#ef4444'
                        });
                    }
                } catch (err) {
                    console.error('Delete attachment error:', err);
                    window.location.href = `/teacher/question-bank/${bankId}/delete-file`;
                }
            }
        }
    </script>
</body>
</html>
