<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Question Bank | ODDHAY Command Center</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        .admin-main { margin-left: var(--admin-sidebar-width); height: 100vh; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .content-scroll { flex: 1; overflow-y: auto; padding: 0; position: relative; scroll-behavior: smooth; }
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-slide-up { animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @media (max-width: 1024px) { 
            #adminSidebar { transform: translateX(-100%); } 
            #adminSidebar.active { transform: translateX(0); box-shadow: 20px 0 50px rgba(0,0,0,0.2); }
            .admin-main { margin-left: 0; } 
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-screen">
        <aside id="adminSidebar" class="fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] border-r border-slate-100 dark:border-slate-800 transition-transform duration-300 z-[100]">
            <%- include('sidebar', { active: 'questions' }) %>
        </aside>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('../admin/header_v2', { pageTitle: 'Question Bank Archive' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l border-slate-200 dark:border-white/5">
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/50 p-2">
                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-1">
                        <!-- Card 1: Total -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                            <div class="p-3.5 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-white dark:bg-[#0f172a] h-full min-h-[110px] relative overflow-hidden">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-slate-400 text-[18px]">database</span>
                                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Your banks</p>
                                    </div>
                                    <span class="material-symbols-rounded text-[40px] text-slate-100 dark:text-slate-800/40 absolute -right-2 -bottom-2 select-none pointer-events-none z-0">database</span>
                                </div>
                                <div class="flex-1"></div>
                                <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none relative z-10"><%= stats.totalBanks %></h3>
                            </div>
                        </div>

                        <!-- Card 2: Global -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                            <div class="p-3.5 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-white dark:bg-[#0f172a] h-full min-h-[110px] relative overflow-hidden">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-slate-400 text-[18px]">public</span>
                                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Global banks</p>
                                    </div>
                                    <span class="material-symbols-rounded text-[40px] text-slate-100 dark:text-slate-800/40 absolute -right-2 -bottom-2 select-none pointer-events-none z-0">public</span>
                                </div>
                                <div class="flex-1"></div>
                                <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none relative z-10"><%= stats.globalCount %></h3>
                            </div>
                        </div>

                        <!-- Card 3: Course Linked -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                            <div class="p-3.5 border border-slate-100 dark:border-white/5 rounded-sm flex flex-col bg-white dark:bg-[#0f172a] h-full min-h-[110px] relative overflow-hidden">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-rounded text-slate-400 text-[18px]">library_books</span>
                                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Course banks</p>
                                    </div>
                                    <span class="material-symbols-rounded text-[40px] text-slate-100 dark:text-slate-800/40 absolute -right-2 -bottom-2 select-none pointer-events-none z-0">library_books</span>
                                </div>
                                <div class="flex-1"></div>
                                <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none relative z-10"><%= stats.courseCount %></h3>
                            </div>
                        </div>

                        <!-- Card 4: Access Breakdown (Split Paid/Free) -->
                        <div class="p-1.5 rounded-md bg-white dark:bg-[#0f172a] border border-[#9D9CA3] shadow-sm">
                            <div class="border border-slate-100 dark:border-white/5 rounded-sm flex bg-white dark:bg-[#0f172a] h-full min-h-[110px] divide-x divide-slate-200 dark:divide-white/10">
                                <!-- Paid Half -->
                                <div class="flex-1 p-3.5 flex flex-col">
                                    <div class="flex items-center gap-1.5 mb-1">
                                        <span class="material-symbols-rounded text-amber-500 text-[16px]">workspace_premium</span>
                                        <p class="text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">Paid</p>
                                    </div>
                                    <div class="flex-1"></div>
                                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none"><%= stats.paidCount %></h3>
                                </div>
                                <!-- Free Half -->
                                <div class="flex-1 p-3.5 flex flex-col">
                                    <div class="flex items-center gap-1.5 mb-1">
                                        <span class="material-symbols-rounded text-emerald-500 text-[16px]">money_off</span>
                                        <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Free</p>
                                    </div>
                                    <div class="flex-1"></div>
                                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tighter leading-none"><%= stats.freeCount %></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none">
                    <!-- Filters Bar (Synchronized with History Hub Standard) -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-4 py-3 border-b border-slate-200 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
                            <form action="" method="GET" class="relative flex-1 max-w-[480px] flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search archive..." class="w-full pl-3 pr-10 h-10 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[12px] font-semibold outline-none focus:border-blue-500 transition-all">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none">search</span>
                                <input type="hidden" name="board" value="<%= filters.board %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                <input type="hidden" name="access" value="<%= filters.access %>">
                                <input type="hidden" name="courseLink" value="<%= filters.courseLink %>">
                            </form>
                            
                            <!-- Board Filter -->
                            <div class="relative w-28">
                                <select id="filterBoard" onchange="updateFilter('board', this.value)" class="w-full h-10 pl-3 pr-8 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.board === 'all' ? 'selected' : '' %>>All boards</option>
                                    <% boards.forEach(board => { %>
                                        <option value="<%= board %>" <%= filters.board === board ? 'selected' : '' %>><%= board %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Class Filter -->
                            <div class="relative w-28">
                                <select id="filterClass" onchange="updateFilter('class', this.value)" class="w-full h-10 pl-3 pr-8 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500">
                                    <option value="all" <%= filters.class === 'all' ? 'selected' : '' %>>All classes</option>
                                    <% classes.forEach(c => { %>
                                        <option value="<%= c %>" <%= filters.class === c ? 'selected' : '' %>><%= c %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Subject Filter -->
                            <div class="relative w-28">
                                <select id="filterSubject" onchange="updateFilter('subject', this.value)" class="h-10 pl-3 pr-8 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500 w-full">
                                    <option value="all" <%= filters.subject === 'all' ? 'selected' : '' %>>All subjects</option>
                                    <% subjects.forEach(sub => { %>
                                        <option value="<%= sub %>" <%= filters.subject === sub ? 'selected' : '' %>><%= sub %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Status Filter -->
                            <div class="relative w-28">
                                <select id="filterStatus" onchange="updateFilter('status', this.value)" class="h-10 pl-3 pr-8 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500 w-full">
                                    <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All status</option>
                                    <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <!-- Year Filter -->
                            <div class="relative w-28">
                                <select id="filterYear" onchange="updateFilter('year', this.value)" class="h-10 pl-3 pr-8 rounded-md bg-slate-50/50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-[11px] font-semibold outline-none cursor-pointer appearance-none transition-all focus:border-blue-500 w-full">
                                    <option value="all" <%= (locals.filters && filters.year === 'all') || (!locals.filters?.year) ? 'selected' : '' %>>All years</option>
                                    <% (locals.years || ['2026','2025','2024','2023','2022','2021','2020','2019','2018','2017','2016','2015']).forEach(y => { %>
                                        <option value="<%= y %>" <%= (locals.filters && filters.year === y) ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                </select>
                                <span class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-[18px]">expand_more</span>
                            </div>

                            <div class="h-10 px-4 bg-primary/10 border border-primary/20 rounded-md flex items-center transition-all">
                                <span class="text-[11px] font-semibold text-primary whitespace-nowrap">Found <span><%= filters.totalCount %></span> total</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/teacher/add-question?mode=archive" class="h-10 px-4 rounded-md bg-primary text-white font-semibold text-[11px] shadow-lg shadow-primary/20 hover:bg-blue-600 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">upload_file</span> New question
                            </a>
                            <button onclick="exportToCSV()" class="h-10 px-4 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold text-[11px] border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm">download</span> Export
                            </button>
                        </div>
                    </div>

                    <div class="table-wrapper overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[1000px]">
                            <thead class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="pl-4 pr-1 text-center w-10">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="size-4 rounded border-slate-300 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    </th>
                                    <th class="pl-1 pr-3 py-3 text-[11px] font-semibold text-slate-500">Archive identity</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Total questions</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Exam authority</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Session</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Subject</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Academic level</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Status</th>
                                    <th class="px-6 py-3 text-[11px] font-semibold text-slate-500 text-left">Creator</th>
                                    <th class="pr-4 py-3 text-[11px] font-semibold text-slate-500 text-right">Operations</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                                <% questions.forEach(item => { %>
                                    <tr class="question-row hover:bg-slate-50/50 dark:hover:bg-slate-800/10 transition-all cursor-pointer group" onclick="window.location.href='/teacher/question-bank/<%= item._id %>'">
                                        <td class="pl-4 pr-1 py-3" onclick="event.stopPropagation()">
                                            <input type="checkbox" name="itemSelect" value="<%= item._id %>" id="cb-<%= item._id %>" onchange="toggleSelection(this)" class="item-cb size-4 rounded border-slate-300 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity checked:opacity-100">
                                        </td>
                                        <td class="pl-1 pr-3 py-3">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg overflow-hidden bg-orange-50 dark:bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-100 dark:border-orange-500/20 shadow-sm transition-transform hover:scale-105">
                                                    <% if (item.fileUrl) { %>
                                                        <span class="material-symbols-rounded text-lg">picture_as_pdf</span>
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-lg">inventory_2</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex flex-col max-w-[250px]">
                                                    <p class="text-[11px] font-semibold text-slate-900 dark:text-white leading-tight truncate"><%= item.title || item.topic || (item.board ? item.board + ' Archive' : 'Question Bank') %></p>
                                                    <p class="text-[9px] text-slate-400 font-medium mt-0.5"><%= item.board %> • <%= item.year %> • <%= item.subject %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-bold border border-slate-200 dark:border-slate-700">
                                                <%= item.questionCount || 0 %> Questions
                                            </span>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex flex-col gap-1">
                                                <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                                                    <%= item.board || 'General archive' %>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                                <%= item.year || '---' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-3 text-[10px] font-semibold text-primary">
                                            <%= item.subject %>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[10px] font-semibold text-slate-500">
                                                Class <%= Array.isArray(item.classLevel) ? item.classLevel.join(', ') : item.classLevel %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-3">
                                            <% const qStatus = item.status || 'approved'; %>
                                            <% if (qStatus === 'pending') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-semibold border border-amber-100 dark:border-amber-500/20 flex items-center gap-1 w-fit">
                                                    <span class="material-symbols-rounded text-[10px]">hourglass_empty</span>Pending
                                                </span>
                                            <% } else if (qStatus === 'rejected') { %>
                                                <span class="px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[9px] font-semibold border border-rose-100 dark:border-rose-500/20 flex items-center gap-1 w-fit">
                                                    <span class="material-symbols-rounded text-[10px]">cancel</span>Rejected
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] font-semibold border border-emerald-100 dark:border-emerald-500/20 flex items-center gap-1 w-fit">
                                                    <span class="material-symbols-rounded text-[10px]">verified</span>Approved
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex items-center gap-2">
                                                <div class="size-7 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center flex-shrink-0">
                                                    <% const avatar = item.addedBy && (item.addedBy.profilePicture || item.addedBy.profileImage); %>
                                                    <% if (avatar) { %>
                                                        <img src="<%= avatar %>" class="size-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                        <span class="hidden text-[10px] font-semibold text-slate-400"><%= item.addedBy ? item.addedBy.name[0] : 'S' %></span>
                                                    <% } else { %>
                                                        <span class="text-[10px] font-semibold text-slate-400"><%= item.addedBy ? item.addedBy.name[0] : 'S' %></span>
                                                    <% } %>
                                                </div>
                                                <span class="text-[10px] font-semibold text-slate-700 dark:text-slate-300 truncate max-w-[80px]"><%= item.addedBy ? item.addedBy.name : 'System' %></span>
                                            </div>
                                        </td>
                                        <td class="pr-4 py-3" onclick="event.stopPropagation()">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <% if (item.addedBy && item.addedBy._id && item.addedBy._id.toString() === user._id.toString()) { %>
                                                <a href="/teacher/edit-question-bank/<%= item._id %>" class="size-7 rounded bg-amber-50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 text-amber-500 hover:bg-amber-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Edit Metadata">
                                                    <span class="material-symbols-rounded text-[18px]">edit</span>
                                                </a>
                                                <% } %>
                                                <a href="/teacher/question-bank/<%= item._id %>" class="size-7 rounded bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="View Details">
                                                    <span class="material-symbols-rounded text-[18px]">visibility</span>
                                                </a>
                                                <button onclick="event.stopPropagation(); deleteResource('<%= item._id %>')" class="size-7 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm" title="Delete Entry">
                                                    <span class="material-symbols-rounded text-[18px]">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <p class="text-[9px] font-bold text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-0.5">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= encodeURIComponent(filters.q) %>&board=<%= encodeURIComponent(filters.board) %>&class=<%= encodeURIComponent(filters.class) %>&subject=<%= encodeURIComponent(filters.subject) %>&status=<%= encodeURIComponent(filters.status) %>&courseLink=<%= encodeURIComponent(filters.courseLink) %>" class="size-7 rounded-md flex items-center justify-center text-[9px] font-bold<% if(filters.page === i) { %> bg-primary text-white shadow-lg shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Bulk Action Bar -->
                    <div id="bulkActions" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl text-slate-800 dark:text-white px-6 py-4 flex items-center gap-8 z-50 animate-slide-up border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl shadow-slate-200/50 dark:shadow-black/50 min-w-[400px]">
                        <div class="flex items-center gap-3">
                            <div class="size-9 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                                <span class="material-symbols-rounded text-[22px]">check_circle</span>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[13px] font-semibold tracking-tight leading-none"><span id="selectedCount" class="text-primary">0</span> items selected</span>
                                <span class="text-[10px] font-semibold text-slate-400 mt-1">Ready for action</span>
                            </div>
                        </div>
