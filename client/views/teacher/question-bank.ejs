<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Question Bank | ODDHAY Command Center</title>
    <style>
        * { font-family: 'Inter', 'Hind Siliguri', sans-serif !important; }
        :root { --admin-sidebar-width: 260px; }
        html, body { 
            height: 100%; 
            height: 100dvh; 
            overflow: hidden; 
            margin: 0; 
            padding: 0; 
        }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            min-height: 0;
            width: calc(100% - var(--admin-sidebar-width));
            overflow: hidden;
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1 1 0%; 
            min-height: 0;
            height: 100%;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-y;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { 
                margin-left: 0 !important; 
                width: 100% !important; 
                height: 100% !important;
                height: 100dvh !important;
                overflow: hidden !important;
            } 
            .content-scroll { 
                flex: 1 1 0% !important;
                min-height: 0 !important;
                height: 100% !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
                -webkit-overflow-scrolling: touch !important;
                touch-action: pan-y !important;
            }
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .question-bank-mobile-card {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
            touch-action: pan-y;
        }
        #mobileBanksView:not(.mobile-selection-active) .mobile-cb-wrapper {
            display: none !important;
        }
        #mobileBanksView.mobile-selection-active .mobile-cb-wrapper {
            display: inline-flex !important;
        }
        #mobileBanksView:not(.mobile-selection-active) #mobileSelectBar {
            display: none !important;
        }
        #mobileBanksView.mobile-selection-active #mobileSelectBar {
            display: flex !important;
        }
        #mobileBanksView.mobile-selection-active #mobileHeaderInfo {
            display: none !important;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'questions' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <main class="admin-main flex-1 bg-[#F8FAFC] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Question Bank Archive' }) %>

            <div class="content-scroll flex flex-col gap-0 p-0 border-l-0 lg:border-l border-slate-200 dark:border-white/5 pb-20 sm:pb-24 lg:pb-0">
                <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800/80 p-2 sm:p-2.5">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                        <!-- Card 1: Total -->
                        <div class="p-1.5 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-2.5 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-blue-600 dark:text-blue-400">Your Banks</p>
                                    <h3 class="text-lg sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.totalBanks %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">database</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Global -->
                        <div class="p-1.5 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-2.5 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-amber-600 dark:text-amber-400">Global Banks</p>
                                    <h3 class="text-lg sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.globalCount %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">public</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: Course Linked -->
                        <div class="p-1.5 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="p-2.5 sm:p-3 border border-slate-100 dark:border-white/5 rounded-md flex items-center justify-between bg-slate-50/50 dark:bg-white/[0.02] h-full">
                                <div class="space-y-0.5">
                                    <p class="text-[10px] sm:text-[11px] font-medium text-purple-600 dark:text-purple-400">Course Banks</p>
                                    <h3 class="text-lg sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.courseCount %></h3>
                                </div>
                                <div class="size-8 sm:size-9 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-base sm:text-lg">library_books</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 4: Access Breakdown (Split Paid/Free) -->
                        <div class="p-1.5 rounded-lg bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-2xs">
                            <div class="border border-slate-100 dark:border-white/5 rounded-md flex bg-slate-50/50 dark:bg-white/[0.02] h-full divide-x divide-slate-200 dark:divide-white/10">
                                <!-- Paid Half -->
                                <div class="flex-1 p-2 sm:p-3 flex flex-col justify-center">
                                    <div class="flex items-center gap-1 mb-0.5">
                                        <span class="material-symbols-rounded text-amber-500 text-xs">workspace_premium</span>
                                        <p class="text-[9px] sm:text-[10px] font-medium text-amber-600 dark:text-amber-400 uppercase tracking-wider">Paid</p>
                                    </div>
                                    <h3 class="text-base sm:text-xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.paidCount %></h3>
                                </div>
                                <!-- Free Half -->
                                <div class="flex-1 p-2 sm:p-3 flex flex-col justify-center">
                                    <div class="flex items-center gap-1 mb-0.5">
                                        <span class="material-symbols-rounded text-emerald-500 text-xs">money_off</span>
                                        <p class="text-[9px] sm:text-[10px] font-medium text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Free</p>
                                    </div>
                                    <h3 class="text-base sm:text-xl font-semibold text-slate-900 dark:text-white tracking-tight"><%= stats.freeCount %></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%
                    const activeBoard = filters.board || 'all';
                    const activeClass = filters.class || 'all';
                    const activeSubject = filters.subject || 'all';
                    const activeStatus = filters.status || 'all';
                    const activeYear = filters.year || 'all';

                    const boardLabel = activeBoard === 'all' ? 'All Boards' : activeBoard.replace(' Board', '');
                    const classLabel = activeClass === 'all' ? 'All Classes' : (String(activeClass).startsWith('Class') ? activeClass : 'Class ' + activeClass);
                    const subjectLabel = activeSubject === 'all' ? 'All Subjects' : activeSubject;
                    const statusLabel = activeStatus === 'all' ? 'All Status' : (activeStatus.charAt(0).toUpperCase() + activeStatus.slice(1));
                    const yearLabel = activeYear === 'all' ? 'All Years' : activeYear;

                    const hasActiveFilters = (activeBoard !== 'all') || (activeClass !== 'all') || (activeSubject !== 'all') || (activeStatus !== 'all') || (activeYear !== 'all') || (filters.q && filters.q.trim().length > 0);
                %>

                <div class="bg-white dark:bg-[#0f172a] border-0 flex flex-col relative rounded-none shadow-none">
                    <!-- Filters Bar (Responsive with Custom In-System Dropdowns) -->
                    <div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md px-3 sm:px-6 py-2.5 border-b border-slate-200 dark:border-slate-800 shadow-2xs">
                        <!-- Top Row: Search + Quick Actions -->
                        <div class="flex items-center gap-2">
                            <form action="" method="GET" class="relative flex-1 min-w-0 max-w-md flex items-center">
                                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search archive..." 
                                       class="w-full pl-8 pr-7 h-9 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 text-xs font-semibold outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-all">
                                <span class="material-symbols-rounded absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none">search</span>
                                <% if (filters.q) { %>
                                    <a href="?board=<%= encodeURIComponent(filters.board || '') %>&class=<%= encodeURIComponent(filters.class || '') %>&subject=<%= encodeURIComponent(filters.subject || '') %>&status=<%= encodeURIComponent(filters.status || '') %>&year=<%= encodeURIComponent(filters.year || '') %>" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                                        <span class="material-symbols-rounded text-sm">close</span>
                                    </a>
                                <% } %>
                                <input type="hidden" name="board" value="<%= filters.board %>">
                                <input type="hidden" name="class" value="<%= filters.class %>">
                                <input type="hidden" name="subject" value="<%= filters.subject %>">
                                <input type="hidden" name="status" value="<%= filters.status %>">
                                <input type="hidden" name="year" value="<%= filters.year %>">
                            </form>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="openAddPaperModal()" 
                                   class="h-8 sm:h-9 px-2.5 sm:px-3 rounded-xl bg-white/70 dark:bg-white/10 backdrop-blur-md border border-slate-200/80 dark:border-white/10 hover:bg-white/90 dark:hover:bg-white/15 text-slate-800 dark:text-slate-100 text-xs font-medium shadow-2xs transition-all flex items-center gap-1 active:scale-95 cursor-pointer">
                                    <span class="material-symbols-rounded text-base text-primary">add</span>
                                    <span>Add</span>
                                </button>
                                <button type="button" onclick="exportToCSV()" title="Export CSV" 
                                        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-xl bg-white/70 dark:bg-white/10 backdrop-blur-md border border-slate-200/80 dark:border-white/10 hover:bg-white/90 dark:hover:bg-white/15 text-slate-700 dark:text-slate-200 text-xs font-medium shadow-2xs transition-all flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-rounded text-base text-emerald-600 dark:text-emerald-400">download</span>
                                    <span class="hidden md:inline">Export</span>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Dropdowns Row (Custom In-System Dropdowns) -->
                        <div class="mt-2 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                            <!-- Board Dropdown -->
                            <div class="relative system-dropdown shrink-0" id="dropdown-filter-board">
                                <button type="button" onclick="toggleSystemDropdown('filter-board', event)" 
                                        class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeBoard !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate max-w-[85px]"><%= boardLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                </button>
                                <div id="dropdown-menu-filter-board" class="hidden absolute top-full left-0 mt-1 w-44 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="updateFilter('board', 'all')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeBoard === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All boards</span>
                                        <% if (activeBoard === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% boards.forEach(b => { %>
                                        <div onclick="updateFilter('board', '<%= b %>')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeBoard === b ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= b %></span>
                                            <% if (activeBoard === b) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Class Dropdown -->
                            <div class="relative system-dropdown shrink-0" id="dropdown-filter-class">
                                <button type="button" onclick="toggleSystemDropdown('filter-class', event)" 
                                        class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeClass !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate max-w-[85px]"><%= classLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                </button>
                                <div id="dropdown-menu-filter-class" class="hidden absolute top-full left-0 mt-1 w-40 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="updateFilter('class', 'all')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeClass === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All classes</span>
                                        <% if (activeClass === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% classes.forEach(c => { %>
                                        <div onclick="updateFilter('class', '<%= c %>')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeClass === c ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span>Class <%= c %></span>
                                            <% if (activeClass === c) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Subject Dropdown -->
                            <div class="relative system-dropdown shrink-0" id="dropdown-filter-subject">
                                <button type="button" onclick="toggleSystemDropdown('filter-subject', event)" 
                                        class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeSubject !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate max-w-[95px]"><%= subjectLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                </button>
                                <div id="dropdown-menu-filter-subject" class="hidden absolute top-full left-0 mt-1 w-44 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="updateFilter('subject', 'all')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeSubject === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All subjects</span>
                                        <% if (activeSubject === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% subjects.forEach(sub => { %>
                                        <div onclick="updateFilter('subject', '<%= sub %>')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeSubject === sub ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="truncate"><%= sub %></span>
                                            <% if (activeSubject === sub) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Status Dropdown -->
                            <div class="relative system-dropdown shrink-0" id="dropdown-filter-status">
                                <button type="button" onclick="toggleSystemDropdown('filter-status', event)" 
                                        class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeStatus !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate max-w-[85px]"><%= statusLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                </button>
                                <div id="dropdown-menu-filter-status" class="hidden absolute top-full left-0 mt-1 w-40 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40">
                                    <div onclick="updateFilter('status', 'all')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeStatus === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All status</span>
                                        <% if (activeStatus === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% ['pending', 'approved', 'rejected'].forEach(st => { %>
                                        <div onclick="updateFilter('status', '<%= st %>')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeStatus === st ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span class="capitalize"><%= st %></span>
                                            <% if (activeStatus === st) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Year Dropdown -->
                            <div class="relative system-dropdown shrink-0" id="dropdown-filter-year">
                                <button type="button" onclick="toggleSystemDropdown('filter-year', event)" 
                                        class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-slate-50 dark:bg-slate-900 border <%= activeYear !== 'all' ? 'border-primary/50 text-primary bg-primary/5 font-bold' : 'border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-semibold' %> flex items-center gap-1 text-[11px] transition-all cursor-pointer shadow-2xs select-none">
                                    <span class="truncate max-w-[85px]"><%= yearLabel %></span>
                                    <span class="material-symbols-rounded text-sm text-slate-400 transition-transform duration-200 dropdown-arrow">expand_more</span>
                                </button>
                                <div id="dropdown-menu-filter-year" class="hidden absolute top-full left-0 mt-1 w-40 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-40 max-h-56 overflow-y-auto no-scrollbar">
                                    <div onclick="updateFilter('year', 'all')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeYear === 'all' ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                        <span>All years</span>
                                        <% if (activeYear === 'all') { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                    </div>
                                    <% (years || ['2026','2025','2024','2023','2022','2021','2020']).forEach(y => { %>
                                        <div onclick="updateFilter('year', '<%= y %>')" class="px-2.5 py-1.5 text-xs font-medium cursor-pointer rounded-lg mx-1 flex items-center justify-between <%= activeYear === y ? 'bg-primary/10 text-primary font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                                            <span><%= y %></span>
                                            <% if (activeYear === y) { %><span class="material-symbols-rounded text-sm text-primary">check</span><% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Reset Button if active -->
                            <% if (hasActiveFilters) { %>
                                <a href="/teacher/question-bank" class="h-7 sm:h-8 px-2.5 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-500 hover:bg-rose-100 dark:hover:bg-rose-500/20 transition-all flex items-center gap-1 text-[11px] font-medium shrink-0 shadow-2xs">
                                    <span class="material-symbols-rounded text-xs">close</span>
                                    <span>Reset</span>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- MOBILE QUESTION BANKS VIEW (< md screens) -->
                    <div id="mobileBanksView" class="md:hidden flex flex-col flex-1">
                        <!-- Mobile Header Info (Default state when NOT selecting) -->
                        <div id="mobileHeaderInfo" class="px-3.5 py-2.5 bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                                <span class="material-symbols-rounded text-sm text-primary/70">touch_app</span>
                                <span class="text-[11px] font-normal">Tap &amp; hold to select question banks</span>
                            </div>
                            <span class="text-[10px] font-medium text-slate-400 bg-slate-200/50 dark:bg-slate-800 px-2 py-0.5 rounded-full">Total <%= filters.totalCount %></span>
