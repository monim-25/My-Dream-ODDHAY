                    <!-- Pagination -->
                    <div class="px-3.5 py-2.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                        <p class="text-[10px] font-normal text-slate-500">Page <%= filters.page %> of <%= filters.totalPages %></p>
                        <div class="flex items-center gap-1">
                            <% for(var i=1; i<=filters.totalPages; i++) { %>
                                <a href="?page=<%= i %>&q=<%= encodeURIComponent(filters.q) %>&board=<%= encodeURIComponent(filters.board) %>&class=<%= encodeURIComponent(filters.class) %>&subject=<%= encodeURIComponent(filters.subject) %>&status=<%= encodeURIComponent(filters.status) %>&courseLink=<%= encodeURIComponent(filters.courseLink) %>" class="size-7 rounded-lg flex items-center justify-center text-[10px] font-medium <% if(filters.page === i) { %> bg-primary text-white shadow-md shadow-primary/20<% } else { %> bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700<% } %> transition-all shrink-0">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Floating Bulk Action Bar -->
                    <div id="bulkActions" class="fixed bottom-20 sm:bottom-24 lg:bottom-6 left-1/2 -translate-x-1/2 z-50 hidden bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 backdrop-blur-md px-3.5 py-2 rounded-2xl shadow-2xl flex items-center gap-2.5 border border-slate-700/60 dark:border-slate-200 text-xs font-medium transition-all max-w-[92vw]">
                        <div class="flex items-center gap-1.5">
                            <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span class="text-[11px] whitespace-nowrap"><span id="selectedCount">0</span> selected</span>
                        </div>
                        <div class="h-3.5 w-px bg-white/20 dark:bg-black/20"></div>
                        <button type="button" onclick="handleBulkAction('delete')" class="px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-300 dark:text-rose-600 hover:bg-rose-500/30 transition-all flex items-center gap-1 text-[11px] cursor-pointer">
                            <span class="material-symbols-rounded text-sm">delete</span>
                            <span>Delete</span>
                        </button>
                        <button type="button" onclick="clearSelection()" class="size-6 rounded-full hover:bg-white/10 dark:hover:bg-black/10 flex items-center justify-center text-slate-400 dark:text-slate-500 cursor-pointer" title="Cancel selection">
                            <span class="material-symbols-rounded text-sm">close</span>
