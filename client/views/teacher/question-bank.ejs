                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="selectAllMobile" onchange="toggleSelectAllMobile()" class="size-4 rounded border-slate-300 dark:border-slate-700 text-primary cursor-pointer">
                                <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200">Select all (<%= questions.length %>)</span>
                            </label>
                            <div class="flex items-center gap-2">
                                <span id="mobileSelectedCounter" class="text-[11px] font-semibold text-primary">0 selected</span>
                                <button type="button" onclick="exitMobileSelection()" class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-medium shadow-xs border border-slate-200/60 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors cursor-pointer">
                                    Done
                                </button>
                            </div>
                        </div>

                        <!-- Mobile Cards List -->
                        <div class="p-2.5 sm:p-3 space-y-2.5 flex-1">
                            <% if (questions && questions.length > 0) { %>
                                <% questions.forEach(item => { %>
                                    <div class="question-bank-mobile-card p-3 rounded-xl bg-white dark:bg-[#0b1120] border border-slate-200/80 dark:border-slate-800 shadow-2xs space-y-2.5 transition-all active:scale-[0.99] cursor-pointer"
                                         data-bank-card="<%= item._id %>"
                                         onclick="handleMobileCardClick('<%= item._id %>', event)"
                                         ontouchstart="handleCardTouchStart('<%= item._id %>', event)"
                                         ontouchmove="handleCardTouchMove(event)"
                                         ontouchend="handleCardTouchEnd(event)"
                                         ontouchcancel="handleCardTouchCancel(event)"
                                         onmousedown="handleCardTouchStart('<%= item._id %>', event)"
                                         onmousemove="handleCardTouchMove(event)"
                                         onmouseup="handleCardTouchEnd(event)">
                                        
                                        <!-- Header of Card: Checkbox (hidden until selection mode), Badges, Quick Actions -->
                                        <div class="flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2 min-w-0 flex-1">
                                                <div class="mobile-cb-wrapper items-center" onclick="event.stopPropagation()">
                                                    <input type="checkbox" name="itemSelect" value="<%= item._id %>" id="cb-m-<%= item._id %>" onchange="toggleSelection(this)" class="item-cb size-4.5 rounded border-slate-300 dark:border-slate-700 text-primary cursor-pointer">
                                                </div>
                                                <div class="size-8 rounded-lg overflow-hidden bg-orange-50 dark:bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-100 dark:border-orange-500/20 shrink-0">
                                                    <% if (item.fileUrl) { %>
                                                        <span class="material-symbols-rounded text-base">picture_as_pdf</span>
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-base">inventory_2</span>
                                                    <% } %>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <h4 class="text-xs font-medium text-slate-900 dark:text-white truncate">
                                                        <%= item.title || item.topic || (item.board ? item.board + ' Archive' : 'Question Bank') %>
                                                    </h4>
                                                    <p class="text-[10px] text-slate-400 font-normal truncate mt-0.5">
                                                        <%= item.board || 'General' %> • <%= item.year || '---' %> • <span class="text-primary font-medium"><%= item.subject %></span>
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Actions -->
                                            <div class="flex items-center gap-1 shrink-0" onclick="event.stopPropagation()">
                                                <% if (item.addedBy && item.addedBy._id && item.addedBy._id.toString() === user._id.toString()) { %>
                                                    <a href="/teacher/edit-question-bank/<%= item._id %>" class="size-7 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-100 dark:border-amber-500/20 text-amber-500 hover:bg-amber-500 hover:text-white transition-all flex items-center justify-center cursor-pointer" title="Edit">
                                                        <span class="material-symbols-rounded text-sm">edit</span>
                                                    </a>
                                                <% } %>
                                                <a href="/teacher/question-bank/<%= item._id %>" class="size-7 rounded-lg bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 text-blue-500 hover:bg-blue-500 hover:text-white transition-all flex items-center justify-center cursor-pointer" title="View">
                                                    <span class="material-symbols-rounded text-sm">visibility</span>
                                                </a>
                                                <button type="button" onclick="deleteResource('<%= item._id %>')" class="size-7 rounded-lg bg-rose-50 dark:bg-rose-500/10 border border-rose-100 dark:border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center cursor-pointer" title="Delete">
                                                    <span class="material-symbols-rounded text-sm">delete</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Meta Badges & Academic Level -->
                                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-[10px] text-slate-500 dark:text-slate-400">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
