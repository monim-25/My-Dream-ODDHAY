        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const selectedItems = new Set();

        // System Custom Dropdowns
        function toggleSystemDropdown(type, e) {
            if (e) e.stopPropagation();
            const targetMenu = document.getElementById(`dropdown-menu-${type}`);
            const parent = document.getElementById(`dropdown-${type}`);
            if (!targetMenu) return;
            const isCurrentlyHidden = targetMenu.classList.contains('hidden');

            closeAllSystemDropdowns();

            if (isCurrentlyHidden) {
                targetMenu.classList.remove('hidden');
                if (parent) {
                    const arrow = parent.querySelector('.dropdown-arrow');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                }
            }
        }
        window.toggleSystemDropdown = toggleSystemDropdown;

        function closeAllSystemDropdowns() {
            document.querySelectorAll('.system-dropdown').forEach(d => {
                const menu = d.querySelector('[id^="dropdown-menu-"]');
                const arrow = d.querySelector('.dropdown-arrow');
                if (menu) menu.classList.add('hidden');
                if (arrow) arrow.style.removeProperty('transform');
            });
        }
        window.closeAllSystemDropdowns = closeAllSystemDropdowns;

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.system-dropdown')) {
                closeAllSystemDropdowns();
            }
        });

        // Mobile Tap-and-Hold (Long Press) & Selection System
        let isMobileSelectionActive = false;
        let touchTimer = null;
        let touchStartX = 0;
        let touchStartY = 0;
        let justLongPressed = false;
        let lastTouchStartTime = 0;

        function handleCardTouchStart(id, e) {
            if (e.type === 'touchstart') {
                lastTouchStartTime = Date.now();
            } else if (e.type === 'mousedown' && Date.now() - lastTouchStartTime < 500) {
                return;
            }
            touchStartX = e.touches ? e.touches[0].clientX : e.clientX;
            touchStartY = e.touches ? e.touches[0].clientY : e.clientY;
            justLongPressed = false;

            clearTimeout(touchTimer);
            touchTimer = setTimeout(() => {
                justLongPressed = true;
                if (navigator.vibrate) {
                    try { navigator.vibrate(40); } catch(err) {}
                }
                enterMobileSelection(id);
            }, 450);
        }

        function handleCardTouchMove(e) {
            if (!touchTimer) return;
            const curX = e.touches ? e.touches[0].clientX : e.clientX;
            const curY = e.touches ? e.touches[0].clientY : e.clientY;
            if (Math.hypot(curX - touchStartX, curY - touchStartY) > 10) {
                clearTimeout(touchTimer);
                touchTimer = null;
            }
        }

        function handleCardTouchEnd(e) {
            if (touchTimer) {
                clearTimeout(touchTimer);
                touchTimer = null;
            }
        }

        function handleCardTouchCancel(e) {
            if (touchTimer) {
                clearTimeout(touchTimer);
                touchTimer = null;
            }
        }

        function enterMobileSelection(id) {
            isMobileSelectionActive = true;
            const view = document.getElementById('mobileBanksView');
            if (view) view.classList.add('mobile-selection-active');
            
            if (id) {
                const cb = document.getElementById(`cb-m-${id}`);
                if (cb && !cb.checked) {
                    cb.checked = true;
                    toggleSelection(cb);
                } else if (cb && cb.checked) {
                    updateBulkUI();
                }
            }
        }

        function exitMobileSelection() {
            isMobileSelectionActive = false;
            const view = document.getElementById('mobileBanksView');
            if (view) view.classList.remove('mobile-selection-active');
            clearSelection();
        }

        function handleMobileCardClick(id, e) {
            if (justLongPressed) {
                justLongPressed = false;
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                return;
            }
            if (isMobileSelectionActive) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                toggleCardSelection(id);
            } else {
                window.location.href = `/teacher/question-bank/${id}`;
            }
        }

        function toggleCardSelection(id) {
            const cb = document.getElementById(`cb-m-${id}`);
            if (cb) {
                cb.checked = !cb.checked;
                toggleSelection(cb);
            }
        }

        // Selections (Mobile & Desktop sync)
        function toggleSelectAll() { 
            const cb = document.getElementById('selectAll');
            selectAllRows(cb ? cb.checked : false); 
        }
        function toggleSelectAllMobile() {
            const cb = document.getElementById('selectAllMobile');
            selectAllRows(cb ? cb.checked : false);
        }
        function selectAllRows(force) {
            document.querySelectorAll('.item-cb').forEach(cb => { 
                cb.checked = force; 
                if(force) selectedItems.add(cb.value); else selectedItems.delete(cb.value); 
            });
            const d = document.getElementById('selectAll'); if(d) d.checked = force;
            const m = document.getElementById('selectAllMobile'); if(m) m.checked = force;
            updateBulkUI();

            if (isMobileSelectionActive && !force) {
                isMobileSelectionActive = false;
                const view = document.getElementById('mobileBanksView');
                if (view) view.classList.remove('mobile-selection-active');
            }
        }
        function toggleRowSelection(id) { 
            const cb = document.getElementById(`cb-${id}`); 
            if (cb) { 
                cb.checked = !cb.checked; 
                toggleSelection(cb); 
            } 
        }
        function toggleSelection(el) {
            if(el.checked) selectedItems.add(el.value); else selectedItems.delete(el.value);
            document.querySelectorAll(`.item-cb[value="${el.value}"]`).forEach(cb => cb.checked = el.checked);
            updateBulkUI();

            if (isMobileSelectionActive && selectedItems.size === 0) {
                isMobileSelectionActive = false;
                const view = document.getElementById('mobileBanksView');
                if (view) view.classList.remove('mobile-selection-active');
            }
        }
        function updateBulkUI() {
            const bar = document.getElementById('bulkActions');
            const countEl = document.getElementById('selectedCount');
            const mobileCountEl = document.getElementById('mobileSelectedCounter');

            if (countEl) countEl.innerText = selectedItems.size;
            if (mobileCountEl) mobileCountEl.innerText = `${selectedItems.size} selected`;

            if (bar) {
                if (selectedItems.size > 0) { 
                    bar.classList.remove('hidden'); 
                } else { 
                    bar.classList.add('hidden'); 
                }
            }

            // Sync visual highlight on mobile cards
            document.querySelectorAll('[data-bank-card]').forEach(card => {
                const id = card.getAttribute('data-bank-card');
                if (selectedItems.has(id)) {
                    card.classList.add('ring-2', 'ring-primary', 'bg-primary/5', 'dark:bg-primary/10', 'border-primary/50');
                } else {
                    card.classList.remove('ring-2', 'ring-primary', 'bg-primary/5', 'dark:bg-primary/10', 'border-primary/50');
                }
            });
        }
        function clearSelection() {
            selectedItems.clear();
            document.querySelectorAll('.item-cb').forEach(i => i.checked = false);
            const d = document.getElementById('selectAll'); if(d) d.checked = false;
            const m = document.getElementById('selectAllMobile'); if(m) m.checked = false;
            if (isMobileSelectionActive) {
                isMobileSelectionActive = false;
                const view = document.getElementById('mobileBanksView');
                if (view) view.classList.remove('mobile-selection-active');
            }
            updateBulkUI();
        }

        async function handleBulkAction(action) {
            const res = await Swal.fire({ title: 'Bulk Action', text: `Apply ${action} to ${selectedItems.size} items?`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#137fec' });
            if (!res.isConfirmed) return;
            try {
                const response = await fetch('/teacher/question-bank/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, itemIds: Array.from(selectedItems) })
                });
                const data = await response.json();
                if (data.success) location.reload();
                else Swal.fire('Error', data.error || 'Failed', 'error');
            } catch (err) { Swal.fire('Error', 'Network error', 'error'); }
        }

        async function deleteResource(id) {
            try {
                const res = await Swal.fire({ 
                    title: 'Confirm Deletion', 
                    text: 'This action cannot be undone and will remove all linked questions.', 
                    icon: 'warning', 
                    showCancelButton: true, 
                    confirmButtonColor: '#f43f5e',
                    confirmButtonText: 'Yes, Delete Archive'
                });
                
                if (res.isConfirmed) { 
                    window.location.href = `/teacher/question-bank/${id}/delete`; 
                }
            } catch (err) {
                console.error('Deletion UI Error:', err);
            }
        }

        function exportToCSV() {
            const rows = [['Board', 'Year', 'Subject', 'Class']];
            // Extract from DOM
            document.querySelectorAll('.question-row').forEach(tr => {
                const board = tr.querySelectorAll('span')[1].innerText;
                const year = tr.querySelectorAll('span')[2].innerText;
                const subject = tr.querySelector('.text-primary').innerText;
                const classLevel = tr.querySelectorAll('span')[3].innerText;
                rows.push([board, year, subject, classLevel]);
            });
            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "question_bank.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // --- Paper Composition Wizard ---
        function openAddPaperModal() {
            const modal = document.getElementById('addPaperModal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeAddPaperModal() {
            const modal = document.getElementById('addPaperModal');
            if (modal) modal.classList.add('hidden');
        }

        function selectWizardOption(type, val, label) {
            const hiddenInput = document.getElementById(type);
            const labelSpan = document.getElementById(`${type}-label`);
            const menu = document.getElementById(`dropdown-menu-${type}`);
            if (hiddenInput) hiddenInput.value = val;
            if (labelSpan) labelSpan.innerText = label;

            if (menu) {
                menu.querySelectorAll('[data-wiz-value]').forEach(item => {
                    const isSelected = item.getAttribute('data-wiz-value') === String(val);
                    if (isSelected) {
                        item.className = 'px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors bg-primary/10 text-primary font-medium';
                        if (!item.querySelector('.wiz-check')) {
                            const check = document.createElement('span');
                            check.className = 'material-symbols-rounded text-sm text-primary wiz-check';
                            check.innerText = 'check';
                            item.appendChild(check);
                        }
                    } else {
                        item.className = 'px-2.5 py-1.5 text-xs rounded-lg mx-1 flex items-center justify-between cursor-pointer transition-colors text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800';
                        const check = item.querySelector('.wiz-check');
                        if (check) check.remove();
                    }
                });
            }
            closeAllSystemDropdowns();
        }

        function updateTotalWizSlots() {
            const mcq = parseInt(document.getElementById('wizCountMCQ')?.value) || 0;
            const shortQ = parseInt(document.getElementById('wizCountShort')?.value) || 0;
            const med = parseInt(document.getElementById('wizCountMedium')?.value) || 0;
            const comp = parseInt(document.getElementById('wizCountComprehension')?.value) || 0;
            const total = mcq + shortQ + med + comp;
            const badge = document.getElementById('wizTotalSlotsBadge');
            if (badge) {
                badge.innerText = `Total: ${total} ${total === 1 ? 'slot' : 'slots'}`;
            }
        }

        function handleWizFileSelect(input) {
            const display = document.getElementById('wizFileNameDisplay');
            const icon = document.getElementById('wizFileIcon');
            if (input.files && input.files[0]) {
                if (display) {
                    display.innerText = input.files[0].name;
                    display.classList.remove('text-slate-500', 'dark:text-slate-400');
                    display.classList.add('text-primary', 'font-medium');
                }
                if (icon) {
                    icon.classList.remove('text-slate-400');
                    icon.classList.add('text-primary');
                }
            } else {
                if (display) {
                    display.innerText = 'Choose PDF / Document...';
                    display.classList.remove('text-primary', 'font-medium');
                    display.classList.add('text-slate-500', 'dark:text-slate-400');
                }
                if (icon) {
                    icon.classList.remove('text-primary');
                    icon.classList.add('text-slate-400');
                }
            }
        }

        async function startPaperComposition() {
            const board = document.getElementById('wizBoard') ? document.getElementById('wizBoard').value.trim() : '';
            const year = document.getElementById('wizYear') ? document.getElementById('wizYear').value.trim() : '';
            const classLevel = document.getElementById('wizClass') ? document.getElementById('wizClass').value.trim() : '';
            const subject = document.getElementById('wizSubject') ? document.getElementById('wizSubject').value.trim() : '';
            const topicInput = document.getElementById('wizTopic');
            const topic = topicInput ? topicInput.value.trim() : '';
            const access = document.getElementById('wizAccessType') ? document.getElementById('wizAccessType').value : 'Free';

            const mcq = parseInt(document.getElementById('wizCountMCQ')?.value) || 0;
            const shortQ = parseInt(document.getElementById('wizCountShort')?.value) || 0;
            const med = parseInt(document.getElementById('wizCountMedium')?.value) || 0;
            const comp = parseInt(document.getElementById('wizCountComprehension')?.value) || 0;
            const total = mcq + shortQ + med + comp;

            const fileInput = document.getElementById('wizFileInput');
            const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

            // Mandatory Validation Checks
            if (!board) {
                Swal.fire({ icon: 'warning', title: 'Board Required', text: 'Please select an education board.', timer: 2500, showConfirmButton: false });
                return;
            }

            if (!year) {
                Swal.fire({ icon: 'warning', title: 'Year Required', text: 'Please select an exam year.', timer: 2500, showConfirmButton: false });
                return;
            }

            if (!classLevel) {
                Swal.fire({ icon: 'warning', title: 'Class Required', text: 'Please select a class.', timer: 2500, showConfirmButton: false });
                return;
            }

            if (!subject) {
                Swal.fire({ icon: 'warning', title: 'Subject Required', text: 'Please select a subject.', timer: 2500, showConfirmButton: false });
                return;
            }

            if (!topic) {
                if (topicInput) {
                    topicInput.focus();
                    topicInput.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                    setTimeout(() => topicInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500'), 3000);
                }
                Swal.fire({ icon: 'warning', title: 'Paper Title Required', text: 'Please enter the paper title or topic.', timer: 2500, showConfirmButton: false });
                return;
            }

            if (total <= 0) {
                Swal.fire({ icon: 'warning', title: 'Slots Required', text: 'Please enter at least 1 question slot.', timer: 2500, showConfirmButton: false });
                return;
            }



            const slotsList = [];
            if (mcq > 0) slotsList.push(`MCQ:${mcq}`);
            if (shortQ > 0) slotsList.push(`Short:${shortQ}`);
            if (med > 0) slotsList.push(`Medium:${med}`);
            if (comp > 0) slotsList.push(`Comprehension:${comp}`);
            const slotsStr = slotsList.join(',');

            let fileUrl = '';
            let fileName = '';

            const btn = document.getElementById('wizSubmitBtn');
            const btnText = document.getElementById('wizSubmitBtnText');
            const btnIcon = document.getElementById('wizSubmitBtnIcon');

            if (hasFile) {
                if (btn) btn.disabled = true;
                if (btnText) btnText.innerText = 'Uploading paper file...';
                if (btnIcon) btnIcon.innerText = 'hourglass_empty';

                try {
                    const formData = new FormData();
                    formData.append('file', fileInput.files[0]);
                    const uploadRes = await fetch('/teacher/upload-paper-file', {
                        method: 'POST',
                        body: formData
                    });
                    const uploadData = await uploadRes.json();
                    if (uploadData.success && uploadData.fileUrl) {
                        fileUrl = uploadData.fileUrl;
                        fileName = uploadData.originalName || fileInput.files[0].name;
                    } else {
                        throw new Error(uploadData.error || 'Upload failed');
                    }
                } catch (e) {
                    console.error('File upload error:', e);
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.innerText = 'Make questions';
                    if (btnIcon) btnIcon.innerText = 'arrow_forward';
                    Swal.fire({ icon: 'error', title: 'Upload Failed', text: 'Failed to upload paper attachment. Please try again.' });
                    return;
                }
            }

            const params = new URLSearchParams({
                mode: 'archive',
                board: board,
                year: year,
                class: classLevel,
                subject: subject,
                topic: topic,
                access: access,
                slots: slotsStr,
                count: total,
                fresh: 'true'
            });

            if (fileUrl) {
                params.set('fileUrl', fileUrl);
                params.set('fileName', fileName);
            }

            window.location.href = `/teacher/add-question?${params.toString()}`;
        }
    </script>

