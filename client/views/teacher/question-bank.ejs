                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg overflow-hidden bg-orange-50 dark:bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-100 dark:border-orange-500/20 shadow-sm transition-transform hover:scale-105">
                                                    <% if (item.fileUrl) { %>
                                                        <span class="material-symbols-rounded text-lg">picture_as_pdf</span>
                                                    <% } else { %>
                                                        <span class="material-symbols-rounded text-lg">inventory_2</span>
                                                    <% } %>
                                                </div>
                                                <div class="flex flex-col max-w-[250px]">
                                                    <p class="text-[11px] font-medium text-slate-900 dark:text-white leading-tight truncate"><%= item.title || item.topic || (item.board ? item.board + ' Archive' : 'Question Bank') %></p>
                                                    <p class="text-[9px] text-slate-400 font-normal mt-0.5"><%= item.board %> • <%= item.year %> • <%= item.subject %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-medium border border-slate-200 dark:border-slate-700">
                                                <%= item.questionCount || 0 %> Questions
                                            </span>
                                        </td>
                                        <td class="px-6 py-3">
                                            <div class="flex flex-col gap-1">
                                                <span class="text-[11px] font-medium text-slate-700 dark:text-slate-300">
                                                    <%= item.board || 'General archive' %>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class="text-[11px] font-medium text-slate-600 dark:text-slate-400">
