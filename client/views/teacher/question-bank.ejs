                                                <span class="px-1.5 py-0.5 rounded-md bg-slate-100/70 dark:bg-slate-800/70 text-slate-600 dark:text-slate-400 font-normal">
                                                    Class <%= Array.isArray(item.classLevel) ? item.classLevel.join(', ') : item.classLevel %>
                                                </span>
                                                <% const qStatus = item.status || 'approved'; %>
