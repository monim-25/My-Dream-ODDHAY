    <script>
        function syncAccessFromCourse(prefix) {
            const picker = document.getElementById(prefix + 'CoursePicker');
            const accessType = document.getElementById(prefix + 'AccessType');
            const autoMsg = document.getElementById(prefix + 'AccessAutoMsg');
            if (picker.value) {
                const opt = picker.options[picker.selectedIndex];
                const acc = opt.getAttribute('data-access');
                if(acc === 'paid' || acc === 'Paid') {
                    accessType.value = 'Paid';
                } else if(acc === 'free' || acc === 'Free') {
                    accessType.value = 'Free';
                }
                accessType.classList.add('opacity-50', 'pointer-events-none');
                autoMsg.classList.remove('hidden');
            } else {
                accessType.classList.remove('opacity-50', 'pointer-events-none');
                autoMsg.classList.add('hidden');
            }
            filterCourses(prefix);
        }

        function filterCourses(prefix) {
            const picker = document.getElementById(prefix + 'CoursePicker');
            const subjectSel = document.getElementById(prefix + 'Subject');
            const classSel = document.getElementById(prefix + 'ClassLevel');
            const opt = picker.options[picker.selectedIndex];
            
            if (picker.value) {
                const subjs = opt.getAttribute('data-subjects').split(',').map(s=>s.trim()).filter(Boolean);
                const clss = opt.getAttribute('data-classes').split(',').map(s=>s.trim()).filter(Boolean);
                
                Array.from(subjectSel.options).forEach(o => {
                    if(!o.value) return;
                    o.style.display = (subjs.length === 0 || subjs.includes(o.value)) ? '' : 'none';
                    if(o.style.display === 'none' && o.selected) o.selected = false;
                });
                Array.from(classSel.options).forEach(o => {
                    if(!o.value) return;
                    o.style.display = (clss.length === 0 || clss.includes(o.value)) ? '' : 'none';
                    if(o.style.display === 'none' && o.selected) o.selected = false;
                });
            } else {
                Array.from(subjectSel.options).forEach(o => o.style.display = '');
                Array.from(classSel.options).forEach(o => o.style.display = '');
            }
        }

        function switchBankTab(tab) {
            const matrixForm = document.getElementById('matrixForm');
            const uploadForm = document.getElementById('uploadForm');
            const tabMatrix = document.getElementById('tab-matrix');
            const tabUpload = document.getElementById('tab-upload');
            
            if(tab === 'matrix') {
                matrixForm.classList.remove('hidden');
                uploadForm.classList.add('hidden');
                tabMatrix.className = "flex-1 h-10 rounded-md text-[11px] font-semibold transition-all bg-white dark:bg-slate-800 text-primary shadow-sm border border-slate-200 dark:border-slate-700";
                tabUpload.className = "flex-1 h-10 rounded-md text-[11px] font-semibold transition-all text-slate-500 hover:text-slate-700";
            } else {
                matrixForm.classList.add('hidden');
                uploadForm.classList.remove('hidden');
                tabUpload.className = "flex-1 h-10 rounded-md text-[11px] font-semibold transition-all bg-white dark:bg-slate-800 text-primary shadow-sm border border-slate-200 dark:border-slate-700";
                tabMatrix.className = "flex-1 h-10 rounded-md text-[11px] font-semibold transition-all text-slate-500 hover:text-slate-700";
            }
        }

        function toggleBankMatrixUI(type) {
            const mcqArea = document.getElementById('bankMcqArea');
            const nonMcqArea = document.getElementById('bankNonMcqArea');
            if(type === 'MCQ') {
                mcqArea.classList.remove('hidden');
                nonMcqArea.classList.add('hidden');
            } else {
                mcqArea.classList.add('hidden');
                nonMcqArea.classList.remove('hidden');
            }
        }

        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                display.innerText = input.files[0].name;
                display.classList.remove('text-slate-400');
                display.classList.add('text-primary');
            } else {
                display.innerText = 'Choose PDF File...';
                display.classList.add('text-slate-400');
            }
        }

        async function submitBankMatrix(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            if(data.questionType === 'MCQ') {
                data.options = Array.from(form.querySelectorAll('input[name="options"]')).map(i => i.value);
            }

            try {
                Swal.fire({ title: 'Committing to Matrix...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const response = await fetch('/admin/add-question-matrix', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if(result.success) {
                    Swal.fire('Success', 'Question added to matrix bank', 'success').then(() => {
                        document.getElementById('addQuestionModal').classList.add('hidden');
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', result.error, 'error');
                }
            } catch (err) { Swal.fire('Error', 'Network Error', 'error'); }
        }

        function updateFilter(key, value) {
            const params = new URLSearchParams(window.location.search);
            params.set('page', '1');
            if (value === 'all') {
                params.delete(key);
            } else {
                params.set(key, value);
            }
            window.location.href = '?' + params.toString();
        }
    </script>
</body>
</html>
