<!DOCTYPE html>
<html lang="en" class="<%= (locals.user && locals.user.theme === 'dark') ? 'dark' : '' %>">
<head>
    <%- include('../partials/head') %>
    <title>Notifications | Teacher ODDHAY</title>
    <style>
        :root { --admin-sidebar-width: 260px; }
        html, body { height: 100%; height: 100dvh; overflow: hidden; margin: 0; padding: 0; }
        .admin-main { 
            margin-left: var(--admin-sidebar-width); 
            height: 100%; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            min-width: 0;
            width: calc(100% - var(--admin-sidebar-width));
            transition: all 0.3s ease; 
        }
        .content-scroll { 
            flex: 1; 
            min-height: 0;
            overflow-y: auto; 
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 0; 
            position: relative; 
        }
        @media (max-width: 1024px) { 
            .admin-sidebar, #adminSidebar { transform: translateX(-100%); } 
            .admin-main { margin-left: 0 !important; width: 100% !important; } 
        }
        .admin-sidebar.active, #adminSidebar.active, .admin-sidebar.translate-x-0, #adminSidebar.translate-x-0 { 
            transform: translateX(0) !important; 
        }
        .cat-pill.active-cat {
            background-color: var(--color-primary, #2563eb) !important;
            color: #ffffff !important;
            font-weight: 700;
        }
    </style>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#020617] text-slate-800 dark:text-slate-200 font-sans overflow-hidden">
    <div class="flex h-full h-[100dvh] w-full overflow-hidden">
        <!-- Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar fixed left-0 top-0 h-full w-[260px] bg-white dark:bg-[#0f172a] transition-transform duration-300 z-[100] border-r border-slate-200 dark:border-slate-800 -translate-x-full lg:translate-x-0">
            <%- include('sidebar', { active: 'notifications' }) %>
        </aside>

        <!-- Backdrop overlay for mobile drawer -->
        <div id="teacherSidebarBackdrop" onclick="toggleTeacherSidebar(false)" class="fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-[90] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

        <!-- Main Content -->
        <main class="admin-main flex-1 bg-[#FFFFFF] dark:bg-[#020617]">
            <%- include('header', { pageTitle: 'Notifications', user: locals.user }) %>

            <div class="content-scroll no-scrollbar">
                <% const notifList = locals.notifications || []; %>
                <% const st = locals.stats || { total: 0, unread: 0, message: 0, exam: 0, course: 0, announcement: 0 }; %>

                <!-- FILTER TABS, ACTIONS & SEARCH BAR -->
                <div class="sticky top-0 z-20 bg-white/95 dark:bg-[#0b1120]/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
                    <!-- Filter Pills -->
                    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                        <button type="button" onclick="setPageCategory('all')" id="catBtn-all" class="cat-pill active-cat px-3 py-1.5 rounded-xl text-xs font-bold transition-all shrink-0 bg-primary text-white shadow-xs cursor-pointer">
                            All <span class="ml-1 opacity-80" id="count-all">(<%= st.total %>)</span>
                        </button>
                        <button type="button" onclick="setPageCategory('unread')" id="catBtn-unread" class="cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 cursor-pointer">
                            Unread <span class="ml-1 text-rose-500 font-bold" id="count-unread">(<%= st.unread %>)</span>
                        </button>
                        <button type="button" onclick="setPageCategory('message')" id="catBtn-message" class="cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-[15px] leading-none text-teal-500">chat</span>
                            <span>Messages</span>
                        </button>
                        <button type="button" onclick="setPageCategory('exam')" id="catBtn-exam" class="cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-[15px] leading-none text-amber-500">rate_review</span>
                            <span>Exams</span>
                        </button>
                        <button type="button" onclick="setPageCategory('course')" id="catBtn-course" class="cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-[15px] leading-none text-blue-500">school</span>
                            <span>Courses</span>
                        </button>
                        <button type="button" onclick="setPageCategory('announcement')" id="catBtn-announcement" class="cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-rounded text-[15px] leading-none text-purple-500">campaign</span>
                            <span>Notices</span>
                        </button>
                    </div>

                    <!-- Right Tools: Search Bar & Actions -->
                    <div class="flex items-center gap-2 shrink-0 ml-auto w-full sm:w-auto">
                        <!-- Live Search -->
                        <div class="relative flex items-center shrink-0 flex-1 sm:w-56">
                            <span class="material-symbols-rounded absolute left-3 text-slate-400 text-base pointer-events-none select-none">search</span>
                            <input type="text" id="notifSearchInput" oninput="handleSearch(this.value)" placeholder="Search notifications..."
                                class="w-full h-9.5 sm:h-10 pl-9 pr-7 text-xs font-semibold bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl outline-none focus:border-primary transition-all text-slate-800 dark:text-white placeholder-slate-400" />
                            <button type="button" id="notifClearSearchBtn" onclick="clearSearch()" class="hidden absolute right-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer">
                                <span class="material-symbols-rounded text-sm">cancel</span>
                            </button>
                        </div>

                        <!-- Action Buttons -->
                        <button type="button" onclick="pageMarkAllRead()" class="h-9.5 sm:h-10 px-3.5 sm:px-4 rounded-xl border border-slate-200 dark:border-slate-700/90 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shrink-0 shadow-xs active:translate-y-0.5" title="Mark all as read">
                            <span class="material-symbols-rounded text-[18px] leading-none text-primary">done_all</span>
                            <span class="hidden md:inline">Mark All Read</span>
                        </button>
                        <button type="button" onclick="pageClearRead()" class="h-9.5 sm:h-10 px-3 sm:px-3.5 rounded-xl border border-slate-200 dark:border-slate-700/90 bg-white dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/30 hover:border-rose-200 dark:hover:border-rose-900/40 text-slate-600 hover:text-rose-600 dark:text-slate-300 dark:hover:text-rose-400 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shrink-0 shadow-xs active:translate-y-0.5" title="Clear read notifications">
                            <span class="material-symbols-rounded text-[18px] leading-none">delete_sweep</span>
                            <span class="hidden md:inline">Clear Read</span>
                        </button>
                    </div>
                </div>

                <!-- NOTIFICATIONS LIST CONTAINER -->
                <div class="max-w-4xl mx-auto p-4 sm:p-6">
                    <div id="pageNotificationList" class="space-y-3">
                        <% if (notifList.length === 0) { %>
                            <div id="initialEmptyState" class="py-16 text-center">
                                <div class="size-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800/60 text-slate-400 flex items-center justify-center mb-3">
                                    <span class="material-symbols-rounded text-3xl leading-none">notifications_none</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-800 dark:text-white">No notifications yet</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">You will receive notifications when students send messages, submit written tests, or when announcements are posted.</p>
                            </div>
                        <% } else { %>
                            <% notifList.forEach(notif => { 
                                let icon = 'notifications';
                                let bgClass = 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300';
                                let borderClass = notif.isRead ? 'border-slate-200/80 dark:border-slate-800/80' : 'border-blue-200 dark:border-primary/40 bg-blue-50/20 dark:bg-primary/5';

                                if (notif.type === 'message') {
                                    icon = 'chat';
                                    bgClass = 'bg-teal-500/10 text-teal-600 dark:text-teal-400';
                                } else if (notif.type === 'exam') {
                                    icon = 'rate_review';
                                    bgClass = 'bg-amber-500/10 text-amber-600 dark:text-amber-400';
                                } else if (notif.type === 'course') {
                                    icon = 'school';
                                    bgClass = 'bg-blue-500/10 text-blue-600 dark:text-blue-400';
                                } else if (notif.type === 'announcement') {
                                    icon = 'campaign';
                                    bgClass = 'bg-purple-500/10 text-purple-600 dark:text-purple-400';
                                } else if (notif.type === 'payment') {
                                    icon = 'receipt_long';
                                    bgClass = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
                                }
                            %>
                                <div class="notif-card flex items-start gap-3.5 p-4 rounded-2xl border transition-all duration-200 relative group <%= borderClass %> bg-white dark:bg-[#0f172a] hover:shadow-md"
                                     data-id="<%= notif._id %>" data-type="<%= notif.type || 'system' %>" data-read="<%= notif.isRead ? 'true' : 'false' %>">
                                    
                                    <!-- Icon Box -->
                                    <div class="size-10 rounded-xl <%= bgClass %> flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-rounded text-xl leading-none"><%= icon %></span>
                                    </div>

                                    <!-- Content -->
                                    <div class="flex-1 min-w-0 pr-1">
                                        <div class="flex items-center justify-between gap-2 mb-1">
                                            <h4 class="text-sm font-bold text-slate-800 dark:text-white truncate">
                                                <%= notif.title %>
                                            </h4>
                                            <span class="text-[11px] font-medium text-slate-400 shrink-0" data-timestamp="<%= notif.createdAt %>">
                                                <%= new Date(notif.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed break-words">
                                            <%= notif.message %>
                                        </p>

                                        <!-- Bottom Link / Action -->
                                        <% if (notif.link && notif.link !== '#' && notif.link !== '/') { %>
                                            <div class="mt-2.5">
                                                <a href="<%= notif.link %>" onclick="pageMarkSingleRead('<%= notif._id %>')"
                                                   class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline">
                                                    <span>View details</span>
                                                    <span class="material-symbols-rounded text-sm">arrow_forward</span>
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Actions: Delete & Unread Indicator -->
                                    <div class="flex items-center gap-2 shrink-0 self-center">
                                        <% if (!notif.isRead) { %>
                                            <span class="size-2.5 rounded-full bg-primary shrink-0 unread-dot" title="Unread"></span>
                                        <% } %>
                                        <button type="button" onclick="pageDeleteNotif('<%= notif._id %>', event)"
                                                class="opacity-0 group-hover:opacity-100 size-8 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-all cursor-pointer"
                                                title="Delete notification">
                                            <span class="material-symbols-rounded text-base">delete</span>
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Script Controller for Teacher Notifications Hub -->
    <script>
    (function() {
        let activeCategory = 'all';
        let searchQuery = '';

        window.setPageCategory = function(cat) {
            activeCategory = cat;
            const pills = document.querySelectorAll('.cat-pill');
            pills.forEach(p => {
                p.classList.remove('active-cat');
                p.className = 'cat-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shrink-0 flex items-center gap-1 cursor-pointer';
            });
            const activePill = document.getElementById(`catBtn-${cat}`);
            if (activePill) {
                activePill.className = 'cat-pill active-cat px-3 py-1.5 rounded-xl text-xs font-bold transition-all shrink-0 bg-primary text-white shadow-xs flex items-center gap-1 cursor-pointer';
            }
            filterCards();
        };

        window.handleSearch = function(val) {
            searchQuery = (val || '').trim().toLowerCase();
            const clearBtn = document.getElementById('notifClearSearchBtn');
            if (clearBtn) {
                if (searchQuery.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }
            filterCards();
        };

        window.clearSearch = function() {
            const input = document.getElementById('notifSearchInput');
            if (input) input.value = '';
            searchQuery = '';
            const clearBtn = document.getElementById('notifClearSearchBtn');
            if (clearBtn) clearBtn.classList.add('hidden');
            filterCards();
        };

        function filterCards() {
            const cards = document.querySelectorAll('.notif-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const type = card.getAttribute('data-type') || 'system';
                const isRead = card.getAttribute('data-read') === 'true';
                const title = card.querySelector('h4')?.textContent?.toLowerCase() || '';
                const body = card.querySelector('p')?.textContent?.toLowerCase() || '';

                // Category check
                let matchesCategory = true;
                if (activeCategory === 'unread') {
                    matchesCategory = !isRead;
                } else if (activeCategory !== 'all') {
                    matchesCategory = (type === activeCategory);
                }

                // Search check
                let matchesSearch = true;
                if (searchQuery) {
                    matchesSearch = title.includes(searchQuery) || body.includes(searchQuery);
                }

                if (matchesCategory && matchesSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const emptyState = document.getElementById('initialEmptyState');
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        }

        window.pageMarkSingleRead = async function(id) {
            try {
                await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
                const card = document.querySelector(`.notif-card[data-id="${id}"]`);
                if (card) {
                    card.setAttribute('data-read', 'true');
                    card.classList.remove('border-blue-200', 'dark:border-primary/40', 'bg-blue-50/20', 'dark:bg-primary/5');
                    card.classList.add('border-slate-200/80', 'dark:border-slate-800/80');
                    const dot = card.querySelector('.unread-dot');
                    if (dot) dot.remove();
                }
                decrementUnreadCount();
            } catch (e) {}
        };

        window.pageMarkAllRead = async function() {
            try {
                await fetch('/api/notifications/mark-all-read', { method: 'POST' });
                const cards = document.querySelectorAll('.notif-card');
                cards.forEach(card => {
                    card.setAttribute('data-read', 'true');
                    card.classList.remove('border-blue-200', 'dark:border-primary/40', 'bg-blue-50/20', 'dark:bg-primary/5');
                    card.classList.add('border-slate-200/80', 'dark:border-slate-800/80');
                    const dot = card.querySelector('.unread-dot');
                    if (dot) dot.remove();
                });
                const countUnread = document.getElementById('count-unread');
                if (countUnread) countUnread.textContent = '(0)';
                if (window.updateNotificationBadge) window.updateNotificationBadge(0);
                filterCards();
            } catch (err) {
                console.error('Failed to mark all as read:', err);
            }
        };

        window.pageClearRead = async function() {
            if (!confirm('Are you sure you want to clear all read notifications?')) return;
            try {
                await fetch('/api/notifications/clear/read', { method: 'DELETE' });
                const cards = document.querySelectorAll('.notif-card[data-read="true"]');
                cards.forEach(card => card.remove());
                filterCards();
            } catch (err) {
                console.error('Failed to clear read notifications:', err);
            }
        };

        window.pageDeleteNotif = async function(id, e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            try {
                await fetch(`/api/notifications/${id}`, { method: 'DELETE' });
                const card = document.querySelector(`.notif-card[data-id="${id}"]`);
                if (card) {
                    const wasUnread = card.getAttribute('data-read') === 'false';
                    card.remove();
                    if (wasUnread) decrementUnreadCount();
                }
                filterCards();
            } catch (e) {}
        };

        function decrementUnreadCount() {
            const countUnread = document.getElementById('count-unread');
            if (countUnread) {
                const current = parseInt(countUnread.textContent.replace(/\D/g, ''), 10) || 0;
                const next = Math.max(0, current - 1);
                countUnread.textContent = `(${next})`;
                if (window.updateNotificationBadge) window.updateNotificationBadge(next);
            }
        }

        // Live notification listener for instant card insertion
        window.addEventListener('oddhay:live-notification', function(e) {
            const notif = e.detail;
            if (!notif) return;

            const list = document.getElementById('pageNotificationList');
            const empty = document.getElementById('initialEmptyState');
            if (empty) empty.style.display = 'none';

            let icon = 'notifications';
            let bgClass = 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300';
            if (notif.type === 'message') {
                icon = 'chat';
                bgClass = 'bg-teal-500/10 text-teal-600 dark:text-teal-400';
            } else if (notif.type === 'exam') {
                icon = 'rate_review';
                bgClass = 'bg-amber-500/10 text-amber-600 dark:text-amber-400';
            } else if (notif.type === 'course') {
                icon = 'school';
                bgClass = 'bg-blue-500/10 text-blue-600 dark:text-blue-400';
            } else if (notif.type === 'announcement') {
                icon = 'campaign';
                bgClass = 'bg-purple-500/10 text-purple-600 dark:text-purple-400';
            }

            const card = document.createElement('div');
            card.className = 'notif-card flex items-start gap-3.5 p-4 rounded-2xl border transition-all duration-200 relative group border-blue-200 dark:border-primary/40 bg-blue-50/20 dark:bg-primary/5 bg-white dark:bg-[#0f172a] hover:shadow-md animate-pulse';
            card.setAttribute('data-id', notif._id);
            card.setAttribute('data-type', notif.type || 'system');
            card.setAttribute('data-read', 'false');

            card.innerHTML = `
                <div class="size-10 rounded-xl ${bgClass} flex items-center justify-center shrink-0 mt-0.5">
                    <span class="material-symbols-rounded text-xl leading-none">${icon}</span>
                </div>
                <div class="flex-1 min-w-0 pr-1">
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <h4 class="text-sm font-bold text-slate-800 dark:text-white truncate">${notif.title}</h4>
                        <span class="text-[11px] font-medium text-slate-400 shrink-0">Just now</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed break-words">${notif.message}</p>
                    ${notif.link && notif.link !== '#' && notif.link !== '/' ? `
                        <div class="mt-2.5">
                            <a href="${notif.link}" onclick="pageMarkSingleRead('${notif._id}')" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline">
                                <span>View details</span>
                                <span class="material-symbols-rounded text-sm">arrow_forward</span>
                            </a>
                        </div>
                    ` : ''}
                </div>
                <div class="flex items-center gap-2 shrink-0 self-center">
                    <span class="size-2.5 rounded-full bg-primary shrink-0 unread-dot" title="Unread"></span>
                    <button type="button" onclick="pageDeleteNotif('${notif._id}', event)" class="opacity-0 group-hover:opacity-100 size-8 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-all cursor-pointer" title="Delete notification">
                        <span class="material-symbols-rounded text-base">delete</span>
                    </button>
                </div>
            `;

            if (list) {
                list.insertBefore(card, list.firstChild);
                setTimeout(() => card.classList.remove('animate-pulse'), 2000);
            }

            const countUnread = document.getElementById('count-unread');
            if (countUnread) {
                const cur = parseInt(countUnread.textContent.replace(/\D/g, ''), 10) || 0;
                countUnread.textContent = `(${cur + 1})`;
            }
        });
    })();
    </script>
</body>
</html>
