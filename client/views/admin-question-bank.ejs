<!DOCTYPE html>
<html lang="bn">

<head>
    <meta charset="UTF-8">
    <title>Admin - Question Bank</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 p-10">
    <h1 class="text-3xl font-bold mb-8">কোয়েশ্চেন ব্যাঙ্ক ম্যানেজমেন্ট (Admin)</h1>
    <form action="/superadmin/add-question-bank" method="POST" enctype="multipart/form-data"
        class="bg-white p-6 rounded-xl shadow-md mb-10">
        <div class="grid grid-cols-2 gap-4">
            <select name="board" class="border p-2 rounded cursor-pointer" required>
                <option value="">বোর্ড সিলেক্ট করুন</option>
                <% if (typeof boards !== 'undefined' && boards && boards.length > 0) { %>
                    <% boards.forEach(function(b) { const bName = typeof b === 'object' ? b.name : b; %>
                        <option value="<%= bName %>"><%= bName %></option>
                    <% }); %>
                <% } %>
            </select>
            <select name="year" class="border p-2 rounded cursor-pointer" required>
                <option value="">বছর সিলেক্ট করুন</option>
                <% if (typeof years !== 'undefined' && years && years.length > 0) { %>
                    <% years.forEach(function(y) { const yVal = typeof y === 'object' ? y.year : y; %>
                        <option value="<%= yVal %>"><%= yVal %></option>
                    <% }); %>
                <% } %>
            </select>
            <input type="text" name="subject" placeholder="বিষয়" class="border p-2 rounded" required>
            <input type="text" name="classLevel" placeholder="ক্লাস (যেমন: SSC)" class="border p-2 rounded" required>
            <input type="file" name="question" class="border p-2 rounded">
        </div>
        <button type="submit" class="mt-4 bg-teal-600 text-white px-6 py-2 rounded font-bold">প্রশ্ন যোগ করুন</button>
    </form>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% questions.forEach(q=> { %>
            <div class="bg-white p-4 rounded-lg shadow">
                <h3 class="font-bold">
                    <%= q.board %> - <%= q.year %>
                </h3>
                <p class="text-sm text-gray-500">
                    <%= q.subject %> | <%= q.classLevel %>
                </p>
                <a href="<%= q.fileUrl %>" target="_blank" class="text-blue-500 text-xs mt-2 block">প্রশ্ন ফাইল
                    ডাউনলোড</a>
            </div>
            <% }) %>
    </div>
</body>

</html>