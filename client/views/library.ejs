<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Library | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'library' }) %>
        
        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120] relative">
            
            <!-- Category Navigation Tabs & Stats Bar (Seamlessly Attached to Header & Sidebar) -->
            <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 px-3 sm:px-4 py-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 shrink-0">
                
                <!-- Category Tabs Row -->
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                    <button class="cat-tab active px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-primary text-white border-primary shadow-2xs flex items-center gap-1.5 cursor-pointer select-none" data-category="all">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">grid_view</span> All Resources
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="Guide">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">menu_book</span> Guides
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="Notes">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">description</span> Notes
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="General Reading">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">library_books</span> General Reading
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="saved">
                        <span class="material-symbols-rounded text-amber-500 text-sm leading-none flex items-center justify-center shrink-0 select-none">bookmark</span> Saved Books
                    </button>
                </div>

                <!-- Right Side: Stats Badges -->
                <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-auto">
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 h-7 sm:h-7.5">
                        <span class="material-symbols-rounded text-primary text-[14px] leading-none flex items-center justify-center shrink-0 select-none">auto_stories</span>
                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200"><%= books ? books.length : 0 %> Books</span>
                    </div>
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 h-7 sm:h-7.5">
                        <span class="material-symbols-rounded text-amber-500 text-[14px] leading-none flex items-center justify-center shrink-0 select-none">bookmark</span>
                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200" id="saved-count-display"><%= locals.savedBookmarks ? savedBookmarks.length : 0 %> Saved</span>
                    </div>
                </div>
            </div>

            <!-- Content Area: Available Reading Materials Grid (Flush & Seamless) -->
            <div class="flex-1 bg-white dark:bg-[#0f172a] p-3 sm:p-4 space-y-3">
                
                <!-- Section Header Bar -->
                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-primary text-lg leading-none flex items-center justify-center shrink-0 select-none">auto_stories</span>
                        <h2 class="text-xs font-bold text-slate-800 dark:text-white">Available Reading Materials</h2>
                    </div>
                    <span id="showing-count-badge" class="text-[10px] font-semibold text-slate-400">
                        Showing <%= books ? books.length : 0 %> items
                    </span>
                </div>

                <!-- Grid List -->
                <div id="library-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
                    <% if (locals.books && books.length > 0) { %>
                        <% books.forEach((item) => { %>
                            <% 
                                const isSaved = locals.savedBookmarks && savedBookmarks.some(b => b.link === item.fileUrl || b.title === item.title);
                            %>
                            <div class="library-item bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl p-2.5 flex flex-col justify-between hover:border-primary/40 transition-all group relative"
                                data-class="<%= item.classLevel %>" 
                                data-subject="<%= item.subject %>" 
                                data-category="<%= item.category %>"
                                data-title="<%= item.title.toLowerCase() %>"
                                data-author="<%= (item.author || '').toLowerCase() %>"
                                data-saved="<%= isSaved ? 'true' : 'false' %>"
                                data-id="<%= item._id %>">

                                <!-- Cover Visual & Badges -->
                                <div>
                                    <div class="w-full aspect-[3/4] rounded-lg overflow-hidden bg-slate-200 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 relative mb-2 shadow-inner group">
                                        <% if (item.coverImage) { %>
                                            <img src="<%= item.coverImage %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                        <% } else { %>
                                            <div class="w-full h-full flex flex-col items-center justify-center p-3 text-slate-400 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                                                <span class="material-symbols-rounded text-3xl mb-1 text-primary/70 flex items-center justify-center leading-none select-none">
                                                    <%= item.category === 'Formula Sheet' ? 'functions' : (item.category === 'Board Solution' ? 'quiz' : 'auto_stories') %>
                                                </span>
                                                <span class="text-[9px] font-bold text-slate-500 text-center"><%= item.subject %></span>
                                            </div>
                                        <% } %>

                                        <!-- Category Tag Badge -->
                                        <span class="absolute top-1.5 left-1.5 px-2 py-0.5 bg-slate-900/85 text-white text-[8px] font-bold rounded backdrop-blur-md border border-white/10 shadow-sm">
                                            <%= item.category || 'Book' %>
                                        </span>

                                        <!-- Bookmark Button -->
                                        <button onclick="toggleBookmark(event, '<%= item._id %>', '<%= item.title %>', '<%= item.fileUrl %>')" 
                                            class="bookmark-btn absolute top-1.5 right-1.5 size-6 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center backdrop-blur-md border border-white/10 transition-transform active:scale-95 shadow-sm cursor-pointer"
                                            title="Save to Bookmarks">
                                            <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center select-none <%= isSaved ? 'text-amber-400 fill-1' : 'text-slate-300' %>">
                                                <%= isSaved ? 'bookmark_added' : 'bookmark' %>
                                            </span>
                                        </button>
                                    </div>

                                    <!-- Class & Subject Pills -->
                                    <div class="flex items-center gap-1 mb-1 flex-wrap">
                                        <span class="px-1.5 py-0.5 bg-primary/10 text-primary text-[8px] font-bold rounded border border-primary/20">
                                            <%= item.classLevel %>
                                        </span>
                                        <span class="text-[9px] font-semibold text-slate-400 truncate"><%= item.subject %></span>
                                    </div>

                                    <!-- Book Title -->
                                    <h3 class="font-bold text-xs text-slate-800 dark:text-white group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-1" title="<%= item.title %>">
                                        <%= item.title %>
                                    </h3>

                                    <!-- Metadata Info -->
                                    <div class="flex items-center gap-2 text-[9.5px] font-semibold text-slate-400 mb-2.5">
                                        <% if (item.pageCount) { %>
                                            <span class="flex items-center gap-0.5" title="Pages"><span class="material-symbols-rounded text-[11px] leading-none flex items-center justify-center shrink-0 select-none">description</span> <%= item.pageCount %> pages</span>
                                        <% } %>
                                        <% if (item.fileSize) { %>
                                            <span class="flex items-center gap-0.5" title="File Size"><span class="material-symbols-rounded text-[11px] leading-none flex items-center justify-center shrink-0 select-none">sd_card</span> <%= item.fileSize %></span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="grid grid-cols-2 gap-1 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
                                    <button onclick="openPdfViewer('<%= item.title %>', '<%= item.fileUrl %>', '<%= item.author %>')" 
                                        class="w-full py-1 bg-primary hover:bg-primary-dark text-white rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 shadow-sm cursor-pointer">
                                        <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center shrink-0 select-none">visibility</span> Read
                                    </button>
                                    <a href="<%= item.fileUrl %>" download target="_blank" 
                                        class="w-full py-1 bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 border border-slate-200 dark:border-slate-600">
                                        <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center shrink-0 select-none">download</span> PDF
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Empty State Container -->
                <div id="empty-state" class="hidden py-10 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-1 flex items-center justify-center leading-none select-none">auto_stories</span>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white mb-0.5">No books or resources found</h3>
                    <p class="text-slate-400 text-[11px] font-medium mb-3">Try adjusting your filters or search terms.</p>
                    <button onclick="resetAllFilters()" class="px-3.5 py-1.5 bg-primary text-white text-xs font-bold rounded-lg shadow-sm hover:bg-primary-dark transition-colors cursor-pointer">
                        Reset All Filters
                    </button>
                </div>
            </div>

        </main>
    </div>

    <!-- PDF Viewer Modal -->
    <div id="pdf-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-2 sm:p-4 hidden transition-opacity">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 w-full max-w-5xl h-[90vh] rounded-xl shadow-2xl flex flex-col overflow-hidden">
            
            <!-- Modal Header -->
            <div class="px-4 py-2.5 bg-slate-50 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3 shrink-0">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="size-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-lg leading-none">menu_book</span>
                    </div>
                    <div class="min-w-0">
                        <h3 id="pdf-modal-title" class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white truncate">Book Viewer</h3>
                        <p id="pdf-modal-author" class="text-[10px] text-slate-400 font-semibold truncate">ODDHAY Resource</p>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <a id="pdf-download-link" href="#" download target="_blank" class="px-3 py-1.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-bold flex items-center gap-1 transition-colors">
                        <span class="material-symbols-rounded text-base leading-none">download</span> <span class="hidden sm:inline">Download</span>
                    </a>
                    <button onclick="closePdfViewer()" class="size-8 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-rose-500 hover:text-white flex items-center justify-center transition-colors">
                        <span class="material-symbols-rounded text-lg leading-none">close</span>
                    </button>
                </div>
            </div>

            <!-- Modal Content Area -->
            <div class="flex-1 w-full h-full bg-slate-100 dark:bg-slate-950 relative overflow-hidden flex items-center justify-center">
                <iframe id="pdf-frame" class="w-full h-full border-none" src="about:blank"></iframe>
            </div>
        </div>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'library' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        let activeCategory = 'all';
        let currentLibrarySearch = '';
        let currentLibrarySubject = (window.currentSelectedLibrarySubject || 'all').toLowerCase().trim();

        window.filterLibraryWithSearch = function(query) {
            currentLibrarySearch = (query || '').toLowerCase().trim();
            filterLibrary();
        };

        window.filterLibraryWithSubject = function(subject) {
            window.currentSelectedLibrarySubject = subject || 'all';
            currentLibrarySubject = (subject || 'all').toLowerCase().trim();
            filterLibrary();
        };

        function filterLibrary() {
            let visibleCount = 0;
            const targetSubject = (currentLibrarySubject || 'all').toLowerCase().trim();
            const targetSearch = (currentLibrarySearch || '').toLowerCase().trim();
            const targetCat = (activeCategory || 'all').toLowerCase().trim();

            const allItems = document.querySelectorAll('.library-item');

            allItems.forEach(item => {
                const itemSubject = (item.getAttribute('data-subject') || '').toLowerCase().trim();
                const itemCategory = (item.getAttribute('data-category') || '').toLowerCase().trim();
                const itemTitle = (item.getAttribute('data-title') || '').toLowerCase().trim();
                const itemAuthor = (item.getAttribute('data-author') || '').toLowerCase().trim();
                const itemSaved = item.getAttribute('data-saved');

                // Subject match
                const matchesSubject = (targetSubject === 'all' || itemSubject === targetSubject || itemSubject.includes(targetSubject) || targetSubject.includes(itemSubject));

                // Search query match
                const matchesQuery = (targetSearch === '' || itemTitle.includes(targetSearch) || itemSubject.includes(targetSearch) || itemCategory.includes(targetSearch) || itemAuthor.includes(targetSearch));

                // Category match
                let matchesCat = true;
                if (targetCat === 'saved') {
                    matchesCat = (itemSaved === 'true');
                } else if (targetCat !== 'all') {
                    matchesCat = (itemCategory === targetCat || itemCategory.includes(targetCat) || targetCat.includes(itemCategory));
                }

                if (matchesQuery && matchesSubject && matchesCat) {
                    item.classList.remove('hidden');
                    visibleCount++;
                } else {
                    item.classList.add('hidden');
                }
            });

            const showingCountBadge = document.getElementById('showing-count-badge');
            if (showingCountBadge) {
                showingCountBadge.textContent = `Showing ${visibleCount} items`;
            }

            const emptyState = document.getElementById('empty-state');
            if (visibleCount === 0 && allItems.length > 0) {
                if (emptyState) emptyState.classList.remove('hidden');
            } else {
                if (emptyState) emptyState.classList.add('hidden');
            }
        }

        const catTabs = document.querySelectorAll('.cat-tab');
        catTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                catTabs.forEach(t => {
                    t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary', 'shadow-2xs');
                    t.classList.add('bg-slate-50', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                });
                tab.classList.add('active', 'bg-primary', 'text-white', 'border-primary', 'shadow-2xs');
                tab.classList.remove('bg-slate-50', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                
                activeCategory = tab.getAttribute('data-category');
                filterLibrary();
            });
        });

        function resetAllFilters() {
            currentLibrarySearch = '';
            currentLibrarySubject = 'all';
            activeCategory = 'all';

            if (typeof selectLibrarySubject === 'function') {
                selectLibrarySubject('all');
            }
            if (typeof clearLibraryHeaderSearch === 'function') {
                clearLibraryHeaderSearch();
            }

            catTabs.forEach(t => {
                if (t.getAttribute('data-category') === 'all') {
                    t.click();
                }
            });

            filterLibrary();
        }

        function openPdfViewer(title, url, author) {
            document.getElementById('pdf-modal-title').textContent = title;
            document.getElementById('pdf-modal-author').textContent = author || 'ODDHAY Resource';
            document.getElementById('pdf-download-link').href = url;
            document.getElementById('pdf-frame').src = url;
            document.getElementById('pdf-modal').classList.remove('hidden');
        }

        function closePdfViewer() {
            document.getElementById('pdf-modal').classList.add('hidden');
            document.getElementById('pdf-frame').src = 'about:blank';
        }

        async function toggleBookmark(e, bookId, title, fileUrl) {
            e.stopPropagation();
            const btn = e.currentTarget;
            const icon = btn.querySelector('.material-symbols-rounded');
            const card = btn.closest('.library-item');
            const isSaved = card.getAttribute('data-saved') === 'true';

            try {
                if (!isSaved) {
                    const res = await fetch('/api/save-bookmark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title, link: fileUrl, itemType: 'book' })
                    });
                    const data = await res.json();
                    if (data.success) {
                        card.setAttribute('data-saved', 'true');
                        icon.textContent = 'bookmark_added';
                        icon.className = 'material-symbols-rounded text-sm text-amber-400 fill-1 flex items-center justify-center';
                        
                        updateSavedCount();
                        if (typeof filterLibrary === 'function') filterLibrary();
                    }
                } else {
                    const res = await fetch('/api/remove-bookmark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ link: fileUrl })
                    });
                    const data = await res.json();
                    if (data.success) {
                        card.setAttribute('data-saved', 'false');
                        icon.textContent = 'bookmark';
                        icon.className = 'material-symbols-rounded text-sm text-slate-300 flex items-center justify-center';
                        
                        updateSavedCount();
                        if (typeof filterLibrary === 'function') filterLibrary();
                    }
                }
            } catch (err) {
                console.error('Error toggling bookmark:', err);
            }
        }

        function updateSavedCount() {
            const countEl = document.getElementById('saved-count-display');
            if (countEl) {
                const savedItems = document.querySelectorAll('.library-item[data-saved="true"]');
                countEl.textContent = `${savedItems.length} Saved`;
            }
        }

        updateSavedCount();

        filterLibrary();
    </script>
</body>
</html>