<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Library | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden">
        <%- include('partials/student-sidebar', { activePage: 'library' }) %>
        
        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-[#f8fafc] dark:bg-[#0b1120] relative">
            
            <!-- Category Navigation Tabs & Stats Bar (Seamlessly Attached to Header & Sidebar) -->
            <div class="bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 px-3 sm:px-4 py-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 shrink-0">
                
                <!-- Category Tabs Row -->
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
                    <button class="cat-tab active px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-primary text-white border-primary shadow-2xs flex items-center gap-1.5 cursor-pointer select-none" data-category="all">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">grid_view</span> All Resources
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="Guide">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">menu_book</span> Guides
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="your-notes">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">edit_note</span> Your Notes
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="General Reading">
                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">library_books</span> General Reading
                    </button>
                    <button class="cat-tab px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all border shrink-0 bg-slate-50 dark:bg-[#1e293b] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary/40 flex items-center gap-1.5 cursor-pointer select-none" data-category="saved">
                        <span class="material-symbols-rounded text-amber-500 text-sm leading-none flex items-center justify-center shrink-0 select-none">bookmark</span> Saved Books
                    </button>
                </div>

                <!-- Right Side: Stats Badges -->
                <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-auto">
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 h-7 sm:h-7.5">
                        <span class="material-symbols-rounded text-primary text-[14px] leading-none flex items-center justify-center shrink-0 select-none">auto_stories</span>
                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200"><%= books ? books.length : 0 %> Books</span>
                    </div>
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 h-7 sm:h-7.5">
                        <span class="material-symbols-rounded text-teal-600 dark:text-teal-400 text-[14px] leading-none flex items-center justify-center shrink-0 select-none">edit_note</span>
                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200" id="user-notes-count-badge"><%= locals.userNotes ? userNotes.length : 0 %> Notes</span>
                    </div>
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#1e293b] border border-slate-200 dark:border-slate-700 h-7 sm:h-7.5">
                        <span class="material-symbols-rounded text-amber-500 text-[14px] leading-none flex items-center justify-center shrink-0 select-none">bookmark</span>
                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200" id="saved-count-display"><%= locals.savedBookmarks ? savedBookmarks.length : 0 %> Saved</span>
                    </div>
                </div>
            </div>

            <!-- Content Area: Reading Materials Grid & Your Notes Grid -->
            <div class="flex-1 bg-white dark:bg-[#0f172a] p-3 sm:p-4 space-y-3">
                
                <!-- Section Header Bar -->
                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span id="section-icon" class="material-symbols-rounded text-primary text-lg leading-none flex items-center justify-center shrink-0 select-none">auto_stories</span>
                        <h2 id="section-title" class="text-xs font-bold text-slate-800 dark:text-white">Available Reading Materials</h2>
                    </div>
                    <div class="flex items-center gap-2">
                        <button id="upload-note-top-btn" onclick="openUploadNoteModal()" class="hidden px-3 py-1.5 bg-teal-600 hover:bg-teal-700 active:scale-[0.98] text-white rounded-lg text-xs font-bold transition-all shadow-xs inline-flex items-center justify-center gap-1.5 cursor-pointer select-none">
                            <span class="material-symbols-rounded text-base leading-none shrink-0 flex items-center justify-center -mt-0.5 select-none">upload_file</span>
                            <span class="leading-none select-none">Upload Note</span>
                        </button>
                        <span id="showing-count-badge" class="text-[10px] font-semibold text-slate-400">
                            Showing <%= books ? books.length : 0 %> items
                        </span>
                    </div>
                </div>

                <!-- 1. Public Library Books Grid List -->
                <div id="library-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
                    <% if (locals.books && books.length > 0) { %>
                        <% books.forEach((item) => { %>
                            <% 
                                const isSaved = locals.savedBookmarks && savedBookmarks.some(b => b.link === item.fileUrl || b.title === item.title);
                            %>
                            <div class="library-item bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl p-2.5 flex flex-col justify-between hover:border-primary/40 transition-all group relative"
                                data-class="<%= item.classLevel %>" 
                                data-subject="<%= item.subject %>" 
                                data-category="<%= item.category %>"
                                data-title="<%= item.title.toLowerCase() %>"
                                data-author="<%= (item.author || '').toLowerCase() %>"
                                data-saved="<%= isSaved ? 'true' : 'false' %>"
                                data-id="<%= item._id %>">

                                <!-- Cover Visual & Badges -->
                                <div>
                                    <div class="w-full aspect-[3/4] rounded-lg overflow-hidden bg-slate-200 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 relative mb-2 shadow-inner group cursor-pointer" onclick="openReaderModal('<%= item.fileUrl %>', '<%= item.title.replace(/'/g, '\\\'') %>', 'pdf', '<%= (item.author || '').replace(/'/g, '\\\'') %>')">
                                        <% if (item.coverImage) { %>
                                            <img src="<%= item.coverImage %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                        <% } else { %>
                                            <div class="w-full h-full flex flex-col items-center justify-center p-3 text-slate-400 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                                                <span class="material-symbols-rounded text-3xl mb-1 text-primary/70 flex items-center justify-center leading-none select-none">
                                                    <%= item.category === 'Formula Sheet' ? 'functions' : (item.category === 'Board Solution' ? 'quiz' : 'auto_stories') %>
                                                </span>
                                                <span class="text-[9px] font-bold text-slate-500 text-center"><%= item.subject %></span>
                                            </div>
                                        <% } %>

                                        <!-- Category Tag Badge -->
                                        <span class="absolute top-1.5 left-1.5 px-2 py-0.5 bg-slate-900/85 text-white text-[8px] font-bold rounded backdrop-blur-md border border-white/10 shadow-sm pointer-events-none">
                                            <%= item.category || 'Book' %>
                                        </span>

                                        <!-- Bookmark Button -->
                                        <button onclick="toggleBookmark(event, '<%= item._id %>', '<%= item.title %>', '<%= item.fileUrl %>')" 
                                            class="bookmark-btn absolute top-1.5 right-1.5 size-6 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center backdrop-blur-md border border-white/10 transition-transform active:scale-95 shadow-sm cursor-pointer"
                                            title="Save to Bookmarks">
                                            <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center select-none <%= isSaved ? 'text-amber-400 fill-1' : 'text-slate-300' %>">
                                                <%= isSaved ? 'bookmark_added' : 'bookmark' %>
                                            </span>
                                        </button>
                                    </div>

                                    <!-- Class & Subject Pills -->
                                    <div class="flex items-center gap-1 mb-1 flex-wrap">
                                        <span class="px-1.5 py-0.5 bg-primary/10 text-primary text-[8px] font-bold rounded border border-primary/20">
                                            <%= item.classLevel %>
                                        </span>
                                        <span class="text-[9px] font-semibold text-slate-400 truncate"><%= item.subject %></span>
                                    </div>

                                    <!-- Book Title -->
                                    <h3 class="font-bold text-xs text-slate-800 dark:text-white group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-1 cursor-pointer" onclick="openReaderModal('<%= item.fileUrl %>', '<%= item.title.replace(/'/g, '\\\'') %>', 'pdf', '<%= (item.author || '').replace(/'/g, '\\\'') %>')" title="<%= item.title %>">
                                        <%= item.title %>
                                    </h3>

                                    <!-- Metadata Info -->
                                    <div class="flex items-center gap-2 text-[9.5px] font-semibold text-slate-400 mb-2.5">
                                        <% if (item.pageCount) { %>
                                            <span class="flex items-center gap-0.5" title="Pages"><span class="material-symbols-rounded text-[11px] leading-none flex items-center justify-center shrink-0 select-none">description</span> <%= item.pageCount %> pages</span>
                                        <% } %>
                                        <% if (item.fileSize) { %>
                                            <span class="flex items-center gap-0.5" title="File Size"><span class="material-symbols-rounded text-[11px] leading-none flex items-center justify-center shrink-0 select-none">sd_card</span> <%= item.fileSize %></span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="grid grid-cols-2 gap-1 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
                                    <button onclick="openReaderModal('<%= item.fileUrl %>', '<%= item.title.replace(/'/g, '\\\'') %>', 'pdf', '<%= (item.author || '').replace(/'/g, '\\\'') %>')" 
                                        class="w-full py-1 bg-primary hover:bg-primary-dark text-white rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 shadow-sm cursor-pointer">
                                        <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center shrink-0 select-none">visibility</span> Read
                                    </button>
                                    <a href="<%= item.fileUrl %>" download target="_blank" 
                                        class="w-full py-1 bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 border border-slate-200 dark:border-slate-600">
                                        <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center shrink-0 select-none">download</span> PDF
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- 2. Student Personal "Your Notes" Container (Private to Logged In Student) -->
                <div id="user-notes-container" class="hidden space-y-3">
                    <div id="user-notes-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
                        <% if (locals.userNotes && userNotes.length > 0) { %>
                            <% userNotes.forEach(note => { %>
                                <div class="user-note-card bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl p-2.5 flex flex-col justify-between hover:border-teal-500/50 transition-all group relative"
                                    id="user-note-<%= note._id %>"
                                    data-title="<%= note.title.toLowerCase() %>"
                                    data-subject="<%= (note.subject || '').toLowerCase() %>"
                                    data-type="<%= note.fileType %>">

                                    <!-- Cover Preview -->
                                    <div>
                                        <div class="w-full aspect-[3/4] rounded-lg overflow-hidden bg-slate-200 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 relative mb-2 shadow-inner group cursor-pointer" onclick="openReaderModal('<%= note.fileUrl %>', '<%= note.title.replace(/'/g, '\\\'') %>', '<%= note.fileType %>', '<%= (note.subject || '').replace(/'/g, '\\\'') %>')">
                                            <% if (note.fileType === 'image') { %>
                                                <img src="<%= note.fileUrl %>" alt="<%= note.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <% } else { %>
                                                <div class="w-full h-full flex flex-col items-center justify-center p-3 text-slate-400 bg-gradient-to-br from-teal-50 to-emerald-100 dark:from-teal-950/40 dark:to-slate-900">
                                                    <span class="material-symbols-rounded text-4xl text-teal-600 dark:text-teal-400 mb-1 leading-none">picture_as_pdf</span>
                                                    <span class="text-[9px] font-bold text-teal-800 dark:text-teal-300 text-center uppercase tracking-wide">PDF Note</span>
                                                </div>
                                            <% } %>

                                            <!-- Badges -->
                                            <span class="absolute top-1.5 left-1.5 px-2 py-0.5 bg-slate-900/85 text-white text-[8px] font-bold rounded backdrop-blur-md border border-white/10 shadow-sm flex items-center gap-1 pointer-events-none">
                                                <span class="material-symbols-rounded text-[10px] text-teal-400">lock</span>
                                                <span>Your Note</span>
                                            </span>

                                            <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded text-[8px] font-black uppercase <%= note.fileType === 'pdf' ? 'bg-rose-500 text-white' : 'bg-emerald-500 text-white' %> shadow-sm pointer-events-none">
                                                <%= note.fileType.toUpperCase() %>
                                            </span>
                                        </div>

                                        <!-- Subject Badge -->
                                        <div class="flex items-center gap-1 mb-1">
                                            <span class="px-1.5 py-0.5 bg-teal-500/10 text-teal-700 dark:text-teal-300 text-[8px] font-bold rounded border border-teal-500/20">
                                                <%= note.subject || 'General' %>
                                            </span>
                                            <span class="text-[9px] font-semibold text-slate-400"><%= note.fileSize || '' %></span>
                                        </div>

                                        <!-- Title -->
                                        <h3 class="font-bold text-xs text-slate-800 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors line-clamp-2 leading-snug mb-2 cursor-pointer" onclick="openReaderModal('<%= note.fileUrl %>', '<%= note.title.replace(/'/g, '\\\'') %>', '<%= note.fileType %>', '<%= (note.subject || '').replace(/'/g, '\\\'') %>')" title="<%= note.title %>">
                                            <%= note.title %>
                                        </h3>
                                    </div>

                                    <!-- Actions: Read, Download, Delete -->
                                    <div class="flex items-center gap-1 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
                                        <button onclick="openReaderModal('<%= note.fileUrl %>', '<%= note.title.replace(/'/g, '\\\'') %>', '<%= note.fileType %>', '<%= (note.subject || '').replace(/'/g, '\\\'') %>')" 
                                            class="flex-1 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 shadow-sm cursor-pointer">
                                            <span class="material-symbols-rounded text-xs leading-none">visibility</span> Read
                                        </button>
                                        <a href="<%= note.fileUrl %>" download target="_blank" 
                                            class="p-1 bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-md text-xs font-bold transition-colors flex items-center justify-center border border-slate-200 dark:border-slate-600" title="Download">
                                            <span class="material-symbols-rounded text-sm leading-none">download</span>
                                        </a>
                                        <button onclick="deleteUserNote('<%= note._id %>')" 
                                            class="p-1 bg-white dark:bg-slate-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 rounded-md text-xs font-bold transition-colors flex items-center justify-center border border-slate-200 dark:border-slate-600 cursor-pointer" title="Delete Note">
                                            <span class="material-symbols-rounded text-sm leading-none">delete</span>
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>

                    <!-- Empty State for Personal Notes -->
                    <div id="user-notes-empty" class="<%= (locals.userNotes && userNotes.length > 0) ? 'hidden' : '' %> py-12 text-center bg-slate-50 dark:bg-slate-800/30 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800 p-6 flex flex-col items-center justify-center">
                        <div class="size-14 rounded-2xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-3">
                            <span class="material-symbols-rounded text-3xl">edit_note</span>
                        </div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-1">No Personal Notes Uploaded Yet</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-xs max-w-sm mb-4 leading-relaxed">Upload your notes and read & review anytime through your screen time.</p>
                        <button onclick="openUploadNoteModal()" class="px-5 py-2.5 bg-teal-600 hover:bg-teal-700 active:scale-[0.98] text-white text-xs font-bold rounded-xl shadow-md shadow-teal-600/20 transition-all cursor-pointer select-none">
                            Upload Your First Note
                        </button>
                    </div>
                </div>

                <!-- Empty State Container for Public Books -->
                <div id="empty-state" class="hidden py-10 text-center bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-1 flex items-center justify-center leading-none select-none">auto_stories</span>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white mb-0.5">No books or resources found</h3>
                    <p class="text-slate-400 text-[11px] font-medium mb-3">Try adjusting your filters or search terms.</p>
                    <button onclick="resetAllFilters()" class="px-3.5 py-1.5 bg-primary text-white text-xs font-bold rounded-lg shadow-sm hover:bg-primary-dark transition-colors cursor-pointer">
                        Reset All Filters
                    </button>
                </div>
            </div>

        </main>
    </div>

    <!-- Upload Personal Note Modal -->
    <div id="upload-note-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-4 hidden transition-opacity">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col animate-in fade-in zoom-in duration-200">
            <!-- Header -->
            <div class="px-5 py-3.5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="size-9 rounded-xl bg-teal-500/15 text-teal-600 dark:text-teal-400 inline-flex items-center justify-center shrink-0 select-none">
                        <span class="material-symbols-rounded text-xl leading-none shrink-0 flex items-center justify-center select-none">upload_file</span>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white">Upload Your Note</h3>
                        <p class="text-[11px] text-slate-400">Add private PDF or image notes for your personal study</p>
                    </div>
                </div>
                <button type="button" onclick="closeUploadNoteModal()" class="size-8 rounded-lg bg-slate-100 hover:bg-rose-500/10 hover:text-rose-600 dark:bg-slate-800 dark:hover:bg-rose-500/20 text-slate-400 dark:text-slate-400 dark:hover:text-rose-400 inline-flex items-center justify-center transition-colors cursor-pointer select-none" title="Close">
                    <span class="material-symbols-rounded text-[20px] leading-none shrink-0 flex items-center justify-center select-none">close</span>
                </button>
            </div>

            <!-- Form -->
            <form id="uploadNoteForm" onsubmit="handleUploadNoteSubmit(event)" class="p-5 space-y-4">
                <!-- Title -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Note Title <span class="text-rose-500">*</span></label>
                    <input type="text" name="title" id="noteTitleInput" required placeholder="e.g. Physics Chapter 3 Motion Handwritten Notes" class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 outline-none">
                </div>

                <!-- Subject (Only subjects available for the student's class) -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Subject <span class="text-rose-500">*</span></label>
                    <select id="noteSubjectSelect" name="subject" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 outline-none cursor-pointer">
                        <% if (locals.subjects && subjects.length > 0) { %>
                            <% subjects.forEach((s, idx) => { %>
                                <option value="<%= s %>" <%= idx === 0 ? 'selected' : '' %>><%= s %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="General" selected>General</option>
                        <% } %>
                    </select>
                </div>

                <!-- File Drop Zone -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Note Document or Image <span class="text-rose-500">*</span></label>
                    <div id="dropZone" onclick="document.getElementById('noteFileInput').click()" class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-teal-500 dark:hover:border-teal-400 rounded-2xl p-5 text-center cursor-pointer bg-slate-50/60 dark:bg-slate-900/40 transition-colors group">
                        <input type="file" id="noteFileInput" name="noteFile" accept=".pdf,.png,.jpg,.jpeg" required class="hidden" onchange="handleNoteFileSelected(this)">
                        <div id="dropZoneContent" class="flex flex-col items-center justify-center gap-1.5">
                            <span class="material-symbols-rounded text-3xl text-teal-600 dark:text-teal-400 group-hover:scale-110 transition-transform leading-none shrink-0 flex items-center justify-center select-none">upload_file</span>
                            <p class="text-xs font-bold text-slate-700 dark:text-slate-200">Click to browse or drop file here</p>
                            <p class="text-[10px] text-slate-400 font-medium">Supports PDF files or Images (JPG, PNG) up to 35MB</p>
                        </div>
                        <div id="dropZoneSelected" class="hidden flex items-center justify-center gap-2 p-2.5 bg-teal-50 dark:bg-teal-950/40 rounded-xl border border-teal-200 dark:border-teal-800">
                            <span class="material-symbols-rounded text-lg text-teal-600 dark:text-teal-400 leading-none shrink-0 flex items-center justify-center select-none" id="selectedFileIcon">description</span>
                            <span class="text-xs font-bold text-teal-900 dark:text-teal-200 truncate max-w-[220px]" id="selectedFileName">file.pdf</span>
                            <span class="text-[10px] text-teal-700 dark:text-teal-300" id="selectedFileSize">(1.2 MB)</span>
                        </div>
                    </div>
                </div>

                <!-- Privacy & Security Notice -->
                <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-teal-50 dark:bg-teal-950/40 border border-teal-200/80 dark:border-teal-800/60 text-teal-800 dark:text-teal-300 text-[11px] leading-snug">
                    <div class="size-6 rounded-lg bg-teal-500/15 dark:bg-teal-400/15 inline-flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-[16px] leading-none shrink-0 flex items-center justify-center select-none text-teal-600 dark:text-teal-400">lock</span>
                    </div>
                    <span class="flex-1 font-medium">This note is 100% private. Only you can view, read, and manage it in your library.</span>
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" onclick="closeUploadNoteModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer select-none inline-flex items-center justify-center leading-none">
                        Cancel
                    </button>
                    <button type="submit" id="uploadSubmitBtn" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-teal-600 hover:bg-teal-700 active:scale-[0.98] text-white shadow-md shadow-teal-600/20 transition-all inline-flex items-center justify-center gap-1.5 cursor-pointer select-none">
                        <span class="material-symbols-rounded text-[18px] leading-none shrink-0 flex items-center justify-center select-none" id="uploadSubmitIcon">upload</span>
                        <span id="uploadSubmitText" class="leading-none select-none">Upload Note</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'library' }) %>
    <%- include('partials/app-scripts') %>

    <script>
        let activeCategory = 'all';
        let currentLibrarySearch = '';
        let currentLibrarySubject = (window.currentSelectedLibrarySubject || 'all').toLowerCase().trim();

        window.filterLibraryWithSearch = function(query) {
            currentLibrarySearch = (query || '').toLowerCase().trim();
            filterLibrary();
        };

        window.filterLibraryWithSubject = function(subject) {
            window.currentSelectedLibrarySubject = subject || 'all';
            currentLibrarySubject = (subject || 'all').toLowerCase().trim();
            filterLibrary();
        };

        function filterLibrary() {
            const targetSubject = (currentLibrarySubject || 'all').toLowerCase().trim();
            const targetSearch = (currentLibrarySearch || '').toLowerCase().trim();
            const targetCat = (activeCategory || 'all').toLowerCase().trim();

            const libraryGrid = document.getElementById('library-grid');
            const userNotesContainer = document.getElementById('user-notes-container');
            const uploadTopBtn = document.getElementById('upload-note-top-btn');
            const sectionIcon = document.getElementById('section-icon');
            const sectionTitle = document.getElementById('section-title');
            const showingCountBadge = document.getElementById('showing-count-badge');
            const emptyState = document.getElementById('empty-state');

            // If "Your Notes" tab is selected:
            if (targetCat === 'your-notes') {
                if (libraryGrid) libraryGrid.classList.add('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                if (userNotesContainer) userNotesContainer.classList.remove('hidden');
                if (uploadTopBtn) uploadTopBtn.classList.remove('hidden');
                if (sectionIcon) sectionIcon.textContent = 'edit_note';
                if (sectionTitle) sectionTitle.textContent = 'Your Personal Notes';

                // Filter user notes by search & subject
                const allUserCards = document.querySelectorAll('.user-note-card');
                let visibleUserNotes = 0;
                allUserCards.forEach(card => {
                    const cTitle = (card.getAttribute('data-title') || '').toLowerCase();
                    const cSubj = (card.getAttribute('data-subject') || '').toLowerCase();
                    const matchesSearch = !targetSearch || cTitle.includes(targetSearch) || cSubj.includes(targetSearch);
                    const matchesSubj = targetSubject === 'all' || cSubj === targetSubject || cSubj.includes(targetSubject) || targetSubject.includes(cSubj);

                    if (matchesSearch && matchesSubj) {
                        card.classList.remove('hidden');
                        visibleUserNotes++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                if (showingCountBadge) {
                    showingCountBadge.textContent = `Showing ${visibleUserNotes} personal notes`;
                }

                const userNotesEmpty = document.getElementById('user-notes-empty');
                if (userNotesEmpty) {
                    if (visibleUserNotes === 0 && allUserCards.length === 0) {
                        userNotesEmpty.classList.remove('hidden');
                    } else if (visibleUserNotes === 0 && allUserCards.length > 0) {
                        userNotesEmpty.classList.remove('hidden');
                    } else {
                        userNotesEmpty.classList.add('hidden');
                    }
                }
                return;
            }

            // Normal Library Book Filtering
            if (userNotesContainer) userNotesContainer.classList.add('hidden');
            if (uploadTopBtn) uploadTopBtn.classList.add('hidden');
            if (libraryGrid) libraryGrid.classList.remove('hidden');
            if (sectionIcon) sectionIcon.textContent = 'auto_stories';
            if (sectionTitle) sectionTitle.textContent = 'Available Reading Materials';

            let visibleCount = 0;
            const allItems = document.querySelectorAll('.library-item');

            allItems.forEach(item => {
                const itemSubject = (item.getAttribute('data-subject') || '').toLowerCase().trim();
                const itemCategory = (item.getAttribute('data-category') || '').toLowerCase().trim();
                const itemTitle = (item.getAttribute('data-title') || '').toLowerCase().trim();
                const itemAuthor = (item.getAttribute('data-author') || '').toLowerCase().trim();
                const itemSaved = item.getAttribute('data-saved');

                // Subject match
                const matchesSubject = (targetSubject === 'all' || itemSubject === targetSubject || itemSubject.includes(targetSubject) || targetSubject.includes(itemSubject));

                // Search query match
                const matchesQuery = (targetSearch === '' || itemTitle.includes(targetSearch) || itemSubject.includes(targetSearch) || itemCategory.includes(targetSearch) || itemAuthor.includes(targetSearch));

                // Category match
                let matchesCat = true;
                if (targetCat === 'saved') {
                    matchesCat = (itemSaved === 'true');
                } else if (targetCat !== 'all') {
                    matchesCat = (itemCategory === targetCat || itemCategory.includes(targetCat) || targetCat.includes(itemCategory));
                }

                if (matchesQuery && matchesSubject && matchesCat) {
                    item.classList.remove('hidden');
                    visibleCount++;
                } else {
                    item.classList.add('hidden');
                }
            });

            if (showingCountBadge) {
                showingCountBadge.textContent = `Showing ${visibleCount} items`;
            }

            if (visibleCount === 0 && allItems.length > 0) {
                if (emptyState) emptyState.classList.remove('hidden');
            } else {
                if (emptyState) emptyState.classList.add('hidden');
            }
        }

        const catTabs = document.querySelectorAll('.cat-tab');
        catTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                catTabs.forEach(t => {
                    t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary', 'shadow-2xs');
                    t.classList.add('bg-slate-50', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                });
                tab.classList.add('active', 'bg-primary', 'text-white', 'border-primary', 'shadow-2xs');
                tab.classList.remove('bg-slate-50', 'dark:bg-[#1e293b]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
                
                activeCategory = tab.getAttribute('data-category');
                filterLibrary();
            });
        });

        function resetAllFilters() {
            currentLibrarySearch = '';
            currentLibrarySubject = 'all';
            activeCategory = 'all';

            if (typeof selectLibrarySubject === 'function') {
                selectLibrarySubject('all');
            }
            if (typeof clearLibraryHeaderSearch === 'function') {
                clearLibraryHeaderSearch();
            }

            catTabs.forEach(t => {
                if (t.getAttribute('data-category') === 'all') {
                    t.click();
                }
            });

            filterLibrary();
        }

        // --- Document & Image Reader Modal (Powered by Premier Media Studio Viewer) ---
        function openReaderModal(arg1, arg2, arg3, arg4) {
            if (typeof window.openMediaViewer === 'function') {
                window.openMediaViewer(arg1, arg2, arg3, arg4);
            } else if (typeof window.openPdfViewer === 'function') {
                window.openPdfViewer(arg1, arg2, arg4);
            } else {
                const isUrl = s => typeof s === 'string' && (s.startsWith('/') || s.startsWith('http'));
                const u = isUrl(arg1) ? arg1 : (isUrl(arg2) ? arg2 : '');
                if (u) window.open(u, '_blank');
            }
        }

        function closePdfViewer() {
            if (typeof window.closeImageViewer === 'function') {
                window.closeImageViewer();
            }
        }

        // --- Personal Note Upload Modal Handlers ---
        function openUploadNoteModal() {
            const modal = document.getElementById('upload-note-modal');
            if (modal) modal.classList.remove('hidden');
            setTimeout(() => {
                const titleInput = document.getElementById('noteTitleInput');
                if (titleInput) titleInput.focus();
            }, 100);
        }

        function closeUploadNoteModal() {
            const modal = document.getElementById('upload-note-modal');
            if (modal) modal.classList.add('hidden');
            const form = document.getElementById('uploadNoteForm');
            if (form) form.reset();
            resetDropZoneUI();
        }

        function handleNoteFileSelected(input) {
            const file = input.files && input.files[0];
            const content = document.getElementById('dropZoneContent');
            const selected = document.getElementById('dropZoneSelected');
            const nameEl = document.getElementById('selectedFileName');
            const sizeEl = document.getElementById('selectedFileSize');
            const iconEl = document.getElementById('selectedFileIcon');

            if (!file) {
                resetDropZoneUI();
                return;
            }

            const ext = file.name.split('.').pop().toLowerCase();
            const allowedExts = ['pdf', 'jpg', 'jpeg', 'png'];
            if (!allowedExts.includes(ext)) {
                alert('Only PDF and image files (JPG, PNG) are allowed! WEBP or other formats are not supported.');
                input.value = '';
                resetDropZoneUI();
                return;
            }

            const isPdf = ext === 'pdf';
            const sizeMB = (file.size / (1024 * 1024)).toFixed(1);

            if (content) content.classList.add('hidden');
            if (selected) selected.classList.remove('hidden');
            if (nameEl) nameEl.textContent = file.name;
            if (sizeEl) sizeEl.textContent = `(${sizeMB} MB)`;
            if (iconEl) iconEl.textContent = isPdf ? 'picture_as_pdf' : 'image';
        }

        function resetDropZoneUI() {
            const content = document.getElementById('dropZoneContent');
            const selected = document.getElementById('dropZoneSelected');
            if (content) content.classList.remove('hidden');
            if (selected) selected.classList.add('hidden');
        }

        async function handleUploadNoteSubmit(e) {
            e.preventDefault();
            const form = document.getElementById('uploadNoteForm');
            const titleInput = document.getElementById('noteTitleInput');
            const fileInput = document.getElementById('noteFileInput');
            const select = document.getElementById('noteSubjectSelect');
            const submitBtn = document.getElementById('uploadSubmitBtn');
            const submitIcon = document.getElementById('uploadSubmitIcon');
            const submitText = document.getElementById('uploadSubmitText');

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select a PDF or image file (JPG, PNG).');
                return;
            }

            const ext = fileInput.files[0].name.split('.').pop().toLowerCase();
            const allowedExts = ['pdf', 'jpg', 'jpeg', 'png'];
            if (!allowedExts.includes(ext)) {
                alert('Only PDF and image files (JPG, PNG) are allowed! WEBP or other formats are not supported.');
                return;
            }

            const title = titleInput.value.trim();
            let subject = select ? select.value.trim() : 'General';
            if (!subject) subject = 'General';

            const formData = new FormData();
            formData.append('title', title);
            formData.append('subject', subject);
            formData.append('noteFile', fileInput.files[0]);

            try {
                submitBtn.disabled = true;
                if (submitIcon) submitIcon.textContent = 'sync';
                if (submitIcon) submitIcon.classList.add('animate-spin');
                if (submitText) submitText.textContent = 'Uploading...';

                const res = await fetch('/api/library/upload-note', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success && data.note) {
                    const note = data.note;
                    closeUploadNoteModal();

                    // Prepend note card dynamically into grid
                    const grid = document.getElementById('user-notes-grid');
                    const empty = document.getElementById('user-notes-empty');
                    if (empty) empty.classList.add('hidden');

                    if (grid) {
                        const card = document.createElement('div');
                        card.className = 'user-note-card bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl p-2.5 flex flex-col justify-between hover:border-teal-500/50 transition-all group relative animate-in fade-in zoom-in duration-300';
                        card.id = `user-note-${note._id}`;
                        card.setAttribute('data-title', (note.title || '').toLowerCase());
                        card.setAttribute('data-subject', (note.subject || '').toLowerCase());
                        card.setAttribute('data-type', note.fileType);

                        const isImage = note.fileType === 'image';
                        card.innerHTML = `
                            <div>
                                <div class="w-full aspect-[3/4] rounded-lg overflow-hidden bg-slate-200 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 relative mb-2 shadow-inner group cursor-pointer" onclick="openReaderModal('${note.fileUrl}', '${note.title.replace(/'/g, "\\'")}', '${note.fileType}', '${(note.subject || '').replace(/'/g, "\\'")}')">
                                    ${isImage 
                                        ? `<img src="${note.fileUrl}" alt="${note.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">`
                                        : `<div class="w-full h-full flex flex-col items-center justify-center p-3 text-slate-400 bg-gradient-to-br from-teal-50 to-emerald-100 dark:from-teal-950/40 dark:to-slate-900">
                                            <span class="material-symbols-rounded text-4xl text-teal-600 dark:text-teal-400 mb-1 leading-none">picture_as_pdf</span>
                                            <span class="text-[9px] font-bold text-teal-800 dark:text-teal-300 text-center uppercase tracking-wide">PDF Note</span>
                                           </div>`
                                    }
                                    <span class="absolute top-1.5 left-1.5 px-2 py-0.5 bg-slate-900/85 text-white text-[8px] font-bold rounded backdrop-blur-md border border-white/10 shadow-sm flex items-center gap-1 pointer-events-none">
                                        <span class="material-symbols-rounded text-[10px] text-teal-400">lock</span>
                                        <span>Your Note</span>
                                    </span>
                                    <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded text-[8px] font-black uppercase ${note.fileType === 'pdf' ? 'bg-rose-500 text-white' : 'bg-emerald-500 text-white'} shadow-sm pointer-events-none">
                                        ${note.fileType.toUpperCase()}
                                    </span>
                                </div>
                                <div class="flex items-center gap-1 mb-1">
                                    <span class="px-1.5 py-0.5 bg-teal-500/10 text-teal-700 dark:text-teal-300 text-[8px] font-bold rounded border border-teal-500/20">
                                        ${note.subject || 'General'}
                                    </span>
                                    <span class="text-[9px] font-semibold text-slate-400">${note.fileSize || ''}</span>
                                </div>
                                <h3 class="font-bold text-xs text-slate-800 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors line-clamp-2 leading-snug mb-2 cursor-pointer" onclick="openReaderModal('${note.fileUrl}', '${note.title.replace(/'/g, "\\'")}', '${note.fileType}', '${(note.subject || '').replace(/'/g, "\\'")}')" title="${note.title}">
                                    ${note.title}
                                </h3>
                            </div>
                            <div class="flex items-center gap-1 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
                                <button onclick="openReaderModal('${note.fileUrl}', '${note.title.replace(/'/g, "\\'")}', '${note.fileType}', '${(note.subject || '').replace(/'/g, "\\'")}')" 
                                    class="flex-1 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded-md text-xs font-bold text-center transition-colors flex items-center justify-center gap-1 shadow-sm cursor-pointer">
                                    <span class="material-symbols-rounded text-xs leading-none">visibility</span> Read
                                </button>
                                <a href="${note.fileUrl}" download target="_blank" 
                                    class="p-1 bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-md text-xs font-bold transition-colors flex items-center justify-center border border-slate-200 dark:border-slate-600" title="Download">
                                    <span class="material-symbols-rounded text-sm leading-none">download</span>
                                </a>
                                <button onclick="deleteUserNote('${note._id}')" 
                                    class="p-1 bg-white dark:bg-slate-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 rounded-md text-xs font-bold transition-colors flex items-center justify-center border border-slate-200 dark:border-slate-600 cursor-pointer" title="Delete Note">
                                    <span class="material-symbols-rounded text-sm leading-none">delete</span>
                                </button>
                            </div>
                        `;
                        grid.prepend(card);
                    }

                    // Update count
                    updateUserNotesCount();

                    // Switch to Your Notes tab if not already on it
                    const yourNotesTab = document.querySelector('.cat-tab[data-category="your-notes"]');
                    if (yourNotesTab && activeCategory !== 'your-notes') {
                        yourNotesTab.click();
                    } else {
                        filterLibrary();
                    }

                    if (window.Swal) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Note Uploaded Successfully!',
                            text: `"${note.title}" has been added to Your Notes.`,
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    }
                } else {
                    alert(data.error || 'Failed to upload note.');
                }
            } catch (err) {
                console.error('Error uploading note:', err);
                alert('Upload failed: ' + err.message);
            } finally {
                submitBtn.disabled = false;
                if (submitIcon) submitIcon.textContent = 'upload';
                if (submitIcon) submitIcon.classList.remove('animate-spin');
                if (submitText) submitText.textContent = 'Upload Note';
            }
        }

        async function deleteUserNote(noteId) {
            const confirmed = window.confirm('Are you sure you want to delete this personal note?');
            if (!confirmed) return;

            try {
                const res = await fetch(`/api/library/delete-note/${noteId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById(`user-note-${noteId}`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease-out';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.9)';
                        setTimeout(() => {
                            card.remove();
                            updateUserNotesCount();
                            const remaining = document.querySelectorAll('.user-note-card').length;
                            if (remaining === 0) {
                                const empty = document.getElementById('user-notes-empty');
                                if (empty) empty.classList.remove('hidden');
                            }
                            filterLibrary();
                        }, 300);
                    }
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Note Deleted',
                            timer: 2000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    }
                } else {
                    alert(data.error || 'Could not delete note.');
                }
            } catch (err) {
                console.error('Error deleting note:', err);
                alert('Delete failed: ' + err.message);
            }
        }

        function updateUserNotesCount() {
            const countBadge = document.getElementById('user-notes-count-badge');
            const total = document.querySelectorAll('.user-note-card').length;
            if (countBadge) {
                countBadge.textContent = `${total} Notes`;
            }
        }

        async function toggleBookmark(e, bookId, title, fileUrl) {
            e.stopPropagation();
            const btn = e.currentTarget;
            const icon = btn.querySelector('.material-symbols-rounded');
            const card = btn.closest('.library-item');
            const isSaved = card.getAttribute('data-saved') === 'true';

            try {
                if (!isSaved) {
                    const res = await fetch('/api/save-bookmark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title, link: fileUrl, itemType: 'book' })
                    });
                    const data = await res.json();
                    if (data.success) {
                        card.setAttribute('data-saved', 'true');
                        icon.textContent = 'bookmark_added';
                        icon.className = 'material-symbols-rounded text-sm text-amber-400 fill-1 flex items-center justify-center';
                        
                        updateSavedCount();
                        if (typeof filterLibrary === 'function') filterLibrary();
                    }
                } else {
                    const res = await fetch('/api/remove-bookmark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ link: fileUrl })
                    });
                    const data = await res.json();
                    if (data.success) {
                        card.setAttribute('data-saved', 'false');
                        icon.textContent = 'bookmark';
                        icon.className = 'material-symbols-rounded text-sm text-slate-300 flex items-center justify-center';
                        
                        updateSavedCount();
                        if (typeof filterLibrary === 'function') filterLibrary();
                    }
                }
            } catch (err) {
                console.error('Error toggling bookmark:', err);
            }
        }

        function updateSavedCount() {
            const countEl = document.getElementById('saved-count-display');
            if (countEl) {
                const savedItems = document.querySelectorAll('.library-item[data-saved="true"]');
                countEl.textContent = `${savedItems.length} Saved`;
            }
        }

        updateSavedCount();
        updateUserNotesCount();
        filterLibrary();
    </script>
</body>
</html>