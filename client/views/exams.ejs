<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@500;600;700;800&family=Noto+Serif+Bengali:wght@600;700;800;900&display=swap" rel="stylesheet">
    <title>Exams & Mock Tests | ODDHAY</title>
</head>

<body class="bg-white dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'exams' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 flex flex-col no-scrollbar bg-white dark:bg-[#0b1120] relative space-y-3 pb-8">
            
            <!-- BENGALI CALLIGRAPHY HERO BANNER -->
            <div class="w-full bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950 border-b border-slate-800/80 px-4 pt-5 pb-4 sm:pt-7 sm:pb-5 flex flex-col items-center justify-between text-center relative overflow-visible shrink-0 min-h-[300px]">
                <!-- Ambient Backdrop Glows -->
                <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-20 left-1/3 w-80 h-80 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

                <!-- RIGHT TOP CORNER TOOLBAR (HISTORY BUTTON & THREE-DOT METRICS DROPDOWN) -->
                <div class="absolute top-3 right-3 sm:top-4 sm:right-5 z-30 flex items-center gap-2 shrink-0">
                    
                    <!-- HISTORY BUTTON -->
                    <a href="/exams/history" class="px-3 py-1.5 bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs font-semibold backdrop-blur-md border border-white/15 flex items-center gap-1.5 transition-all shadow-xs active:scale-95 shrink-0" title="Lifetime Exam History">
                        <span class="material-symbols-rounded text-sm leading-none">history</span>
                        <span>History</span>
                    </a>

                    <!-- THREE-DOT METRICS DROPDOWN TOGGLE BUTTON -->
                    <div class="relative shrink-0">
                        <button type="button" id="metricsDropdownBtn" onclick="toggleMetricsDropdown(event)" class="p-1.5 bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs font-bold backdrop-blur-md border border-white/15 flex items-center justify-center transition-all shadow-xs active:scale-95 cursor-pointer" title="Lifetime Exam Stats">
                            <span class="material-symbols-rounded text-base leading-none">more_vert</span>
                        </button>

                        <!-- DROPDOWN POPUP MENU -->
                        <div id="metricsDropdownMenu" class="hidden absolute right-0 top-full mt-2 w-64 p-3 bg-slate-900/95 dark:bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl shadow-2xl z-50 text-xs font-semibold text-white space-y-2">
                            
                            <div class="flex items-center justify-between border-b border-slate-800 pb-2 text-[11px] font-extrabold text-slate-300">
                                <span>Performance Stats</span>
                                <span class="material-symbols-rounded text-sm text-cyan-400">analytics</span>
                            </div>

                            <% const st = locals.studentStats || { mcqSolved: 0, writtenSolved: 0, marksGained: 0, negativeMarks: 0, rightTicked: 0, wrongTicked: 0 }; %>

                            <div class="grid grid-cols-2 gap-2 text-[11px]">
                                <!-- MCQ Solved -->
                                <div class="p-2 rounded-xl bg-white/5 border border-white/10 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-slate-400 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-emerald-400">quiz</span> MCQ Solved
                                    </span>
                                    <span class="font-bold text-white"><%= st.mcqSolved %></span>
                                </div>

                                <!-- Written Solved -->
                                <div class="p-2 rounded-xl bg-white/5 border border-white/10 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-slate-400 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-cyan-400">edit_note</span> Written Solved
                                    </span>
                                    <span class="font-bold text-white"><%= st.writtenSolved %></span>
                                </div>

                                <!-- Right MCQ -->
                                <div class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-emerald-300 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-emerald-400">check_circle</span> Right MCQ
                                    </span>
                                    <span class="font-bold text-emerald-300"><%= st.rightTicked %></span>
                                </div>

                                <!-- Wrong MCQ -->
                                <div class="p-2 rounded-xl bg-rose-500/10 border border-rose-500/20 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-rose-300 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-rose-400">cancel</span> Wrong MCQ
                                    </span>
                                    <span class="font-bold text-rose-300"><%= st.wrongTicked %></span>
                                </div>

                                <!-- Mark Gained -->
                                <div class="p-2 rounded-xl bg-white/5 border border-white/10 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-slate-400 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-amber-400">star</span> Mark Gained
                                    </span>
                                    <span class="font-bold text-amber-300"><%= st.marksGained %></span>
                                </div>

                                <!-- Negative Mark -->
                                <div class="p-2 rounded-xl bg-white/5 border border-white/10 flex flex-col gap-0.5">
                                    <span class="text-[10px] text-slate-400 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-rose-400">trending_down</span> Negative Mark
                                    </span>
                                    <span class="font-bold text-rose-300">-<%= st.negativeMarks %></span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- STYLED CALLIGRAPHY BENGALI TEXT -->
                <div class="max-w-2xl w-full mx-auto space-y-1 relative z-10 pt-2 overflow-visible">
                    <h1 class="font-['Hind_Siliguri',sans-serif] font-black text-2xl sm:text-3xl md:text-4xl text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 leading-[1.85] pt-3 pb-1 tracking-normal drop-shadow-md overflow-visible">
                        নিজের মত প্রশ্ন সাজিয়ে পরীক্ষা দাও! <br class="hidden sm:inline">
                        আর যাচাই করে নাও নিজেকে
                    </h1>
                    <p class="font-['Hind_Siliguri',sans-serif] text-xs sm:text-sm font-semibold text-slate-300/90 leading-relaxed max-w-lg mx-auto pt-1">
                        বিষয়, অধ্যায় এবং প্রশ্নের ধরন নির্বাচন করে যেকোনো সময় নিজের মত পরিক্ষা দাও!
                    </p>
                </div>

                <!-- MIDDLE LINE: SMART & ULTRA-PREMIUM CUSTOMTEST BUTTON -->
                <div class="pt-4 pb-3 flex justify-center relative z-10">
                    <a href="/exams/custom-test" class="px-7 py-3 bg-[#343A40] hover:bg-[#212529] text-white rounded-2xl font-black text-xs sm:text-sm shadow-xl shadow-[#343A40]/40 border border-white/20 flex items-center gap-2.5 active:scale-95 transition-all group">
                        <span class="material-symbols-rounded text-lg leading-none flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">edit_note</span>
                        <span>CustomTest</span>
                    </a>
                </div>

                <!-- BOTTOM LINE: VERY BOTTOM COMPACT IMAGE-TYPE METRICS ROW -->
                <div class="w-full max-w-5xl mx-auto pt-2 pb-1 relative z-10 mt-auto">
                    <div class="flex flex-wrap items-center justify-center gap-1 sm:gap-1.5">
                        
                        <!-- 1. Total Questions -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">quiz</span>
                            </span>
                            <span><%= globalStats.totalQuestions %> Questions</span>
                        </div>

                        <!-- 2. Question Banks -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">library_books</span>
                            </span>
                            <span><%= globalStats.totalBanks %> Question Banks</span>
                        </div>

                        <!-- 3. Model Tests -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">workspace_premium</span>
                            </span>
                            <span><%= globalStats.totalModelTests %> Model Tests</span>
                        </div>

                        <!-- 4. Mock Tests -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-sky-500/20 text-sky-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">assignment</span>
                            </span>
                            <span><%= globalStats.totalMockTests %> Mock Tests</span>
                        </div>

                        <!-- 5. MCQs -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-teal-500/20 text-teal-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">checklist</span>
                            </span>
                            <span><%= globalStats.mcq %> MCQs</span>
                        </div>

                        <!-- 6. Short -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">short_text</span>
                            </span>
                            <span><%= globalStats.short %> Short</span>
                        </div>

                        <!-- 7. Medium -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">article</span>
                            </span>
                            <span><%= globalStats.medium %> Medium</span>
                        </div>

                        <!-- 8. Comprehension -->
                        <div class="px-2 py-0.5 rounded-lg bg-white/5 dark:bg-slate-800/50 border border-white/10 dark:border-slate-700/40 text-slate-300 text-[10px] font-normal flex items-center gap-1 shadow-2xs">
                            <span class="size-4.5 rounded bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0">
                                <span class="material-symbols-rounded text-[11px] leading-none">description</span>
                            </span>
                            <span><%= globalStats.comprehension %> Comprehension</span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- SECTION 1: MOCK TESTS -->
            <div class="mx-2 sm:mx-4 bg-[#E9F0DD] dark:bg-[#0f172a] border border-lime-200/80 dark:border-slate-800 rounded-3xl p-3.5 sm:p-4 space-y-3 shadow-xs">
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-lime-300/50 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-sky-600 dark:text-sky-400 text-base leading-none flex items-center justify-center shrink-0">assignment</span>
                        <h2 class="font-extrabold text-xs sm:text-sm text-slate-900 dark:text-white leading-tight">Mock Tests</h2>
                    </div>
                    <a href="/exams/mock-tests" class="px-3 py-1 bg-white/80 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shadow-xs border border-lime-200 dark:border-slate-700 rounded-md shrink-0">
                        <span>More...</span>
                    </a>
                </div>

                <% const topMockTests = mockTests.slice(0, 4); %>
                <% if (topMockTests.length === 0) { %>
                    <div class="py-6 text-center bg-white/60 dark:bg-slate-800/30 rounded-xl border border-dashed border-lime-200 dark:border-slate-800">
                        <span class="material-symbols-rounded text-2xl text-slate-400 dark:text-slate-600 leading-none flex items-center justify-center shrink-0 mb-1">event_busy</span>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No Mock Tests Available Right Now</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                        <% topMockTests.forEach(function(mk) { %>
                            <% 
                               const mkSubject = (mk.subject || 'General').trim();
                               const mkTitle = mk.title ? mk.title.trim() : `${mkSubject} Mock Test`;
                            %>
                            <div class="bg-[#F2F6F9] dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-cyan-500/50 dark:hover:border-cyan-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-3">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-2">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/20">
                                                <%= mkSubject %>
                                            </span>
                                            <% if (mk.duration && mk.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300/60 dark:border-slate-700">
                                                    <%= mk.duration %> Mins
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-cyan-600 transition-colors">
                                        <%= mkTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-200/70 dark:border-slate-700/50">
                                    <div class="text-[10px] font-medium text-slate-400 flex items-center gap-1 truncate">
                                        <span class="material-symbols-rounded text-xs text-cyan-500 leading-none select-none">quiz</span>
                                        <span class="truncate">Mock Test</span>
                                    </div>
                                    <a href="/quiz/<%= mk._id %>" class="px-3 py-1 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 shadow-2xs active:scale-95 shrink-0">
                                        <span class="material-symbols-rounded text-xs leading-none">play_arrow</span>
                                        <span>Take Exam</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- SECTION 2: MODEL TESTS -->
            <div class="mx-2 sm:mx-4 bg-[#E9F0DD] dark:bg-[#0f172a] border border-lime-200/80 dark:border-slate-800 rounded-3xl p-3.5 sm:p-4 space-y-3 shadow-xs">
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-lime-300/50 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-rose-600 dark:text-rose-400 text-base leading-none flex items-center justify-center shrink-0">workspace_premium</span>
                        <h2 class="font-extrabold text-xs sm:text-sm text-slate-900 dark:text-white leading-tight">Model Tests</h2>
                    </div>
                    <a href="/exams/model-tests" class="px-3 py-1 bg-white/80 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shadow-xs border border-lime-200 dark:border-slate-700 rounded-md shrink-0">
                        <span>More...</span>
                    </a>
                </div>

                <% const topModelTests = modelTests.slice(0, 4); %>
                <% if (topModelTests.length === 0) { %>
                    <div class="py-6 text-center bg-white/60 dark:bg-slate-800/30 rounded-xl border border-dashed border-lime-200 dark:border-slate-800">
                        <span class="material-symbols-rounded text-2xl text-slate-400 dark:text-slate-600 leading-none flex items-center justify-center shrink-0 mb-1">event_busy</span>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No Model Tests Available Right Now</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                        <% topModelTests.forEach(function(test) { %>
                            <% 
                               const tSubject = (test.subject || 'General').trim();
                               const tBoard = (test.board || '').trim();
                               const tYear = (test.year || '').trim();
                               const tTitle = test.title && test.title.trim() !== '' ? test.title.trim() : `${tSubject} ${tBoard} ${tYear}`.trim();
                            %>
                            <div class="bg-[#F2F6F9] dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-3">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-2">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20">
                                                <%= tSubject %>
                                            </span>
                                            <% if (test.duration && test.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300/60 dark:border-slate-700">
                                                    <%= test.duration %> Mins
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-emerald-500 transition-colors">
                                        <%= tTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-200/70 dark:border-slate-700/50">
                                    <div class="text-[10px] font-medium text-slate-400 flex items-center gap-1 truncate">
                                        <span class="material-symbols-rounded text-xs text-emerald-500 leading-none select-none">workspace_premium</span>
                                        <span class="truncate"><%= tBoard || 'Model Test' %> <%= tYear ? ' • ' + tYear : '' %></span>
                                    </div>
                                    <a href="/question-bank/solve/<%= test._id %>" class="px-3 py-1 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 shadow-2xs active:scale-95 shrink-0">
                                        <span class="material-symbols-rounded text-xs leading-none">play_arrow</span>
                                        <span>Take Exam</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- SECTION 3: QUESTION BANKS -->
            <div class="mx-2 sm:mx-4 bg-[#E9F0DD] dark:bg-[#0f172a] border border-lime-200/80 dark:border-slate-800 rounded-3xl p-3.5 sm:p-4 space-y-3 shadow-xs">
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-lime-300/50 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-indigo-600 dark:text-indigo-400 text-base leading-none flex items-center justify-center shrink-0">library_books</span>
                        <h2 class="font-extrabold text-xs sm:text-sm text-slate-900 dark:text-white leading-tight">Question Banks</h2>
                    </div>
                    <a href="/question-bank" class="px-3 py-1 bg-white/80 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shadow-xs border border-lime-200 dark:border-slate-700 rounded-md shrink-0">
                        <span>More...</span>
                    </a>
                </div>

                <% const topQuestionBanks = questionBanks.slice(0, 4); %>
                <% if (topQuestionBanks.length === 0) { %>
                    <div class="py-6 text-center bg-white/60 dark:bg-slate-800/30 rounded-xl border border-dashed border-lime-200 dark:border-slate-800">
                        <span class="material-symbols-rounded text-2xl text-slate-400 dark:text-slate-600 leading-none flex items-center justify-center shrink-0 mb-1">event_busy</span>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No Question Banks Available Right Now</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                        <% topQuestionBanks.forEach(function(qb) { %>
                            <% 
                               const qbSubject = (qb.subject || 'General').trim();
                               const qbBoard = (qb.board || '').trim();
                               const qbYear = (qb.year || '').trim();
                               const qbTitle = qb.title && qb.title.trim() !== '' ? qb.title.trim() : `${qbSubject} ${qbBoard} ${qbYear}`.trim();
                            %>
                            <div class="bg-[#F2F6F9] dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between hover:border-indigo-500/50 dark:hover:border-indigo-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group relative space-y-3">
                                <div>
                                    <div class="flex items-center justify-between gap-1.5 mb-2">
                                        <div class="flex items-center gap-1 flex-wrap">
                                            <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20">
                                                <%= qbSubject %>
                                            </span>
                                            <% if (qb.duration && qb.duration > 0) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300/60 dark:border-slate-700">
                                                    <%= qb.duration %> Mins
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <h3 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white leading-snug line-clamp-2 group-hover:text-indigo-500 transition-colors">
                                        <%= qbTitle %>
                                    </h3>
                                </div>

                                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-200/70 dark:border-slate-700/50">
                                    <div class="text-[10px] font-medium text-slate-400 flex items-center gap-1 truncate">
                                        <span class="material-symbols-rounded text-xs text-indigo-500 leading-none select-none">account_balance</span>
                                        <span class="truncate"><%= qbBoard || 'Board Archive' %> <%= qbYear ? ' • ' + qbYear : '' %></span>
                                    </div>
                                    <a href="/question-bank/solve/<%= qb._id %>" class="px-3 py-1 bg-[#6C757D] hover:bg-[#5a6268] text-white rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 shadow-2xs active:scale-95 shrink-0">
                                        <span class="material-symbols-rounded text-xs leading-none">play_arrow</span>
                                        <span>Take Exam</span>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- SECTION 4: SUBJECT WISE EXAM -->
            <div class="mx-2 sm:mx-4 bg-[#E9F0DD] dark:bg-[#0f172a] border border-lime-200/80 dark:border-slate-800 rounded-3xl p-3.5 sm:p-4 space-y-3 shadow-xs mb-6">
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-lime-300/50 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-cyan-600 dark:text-cyan-400 text-base leading-none flex items-center justify-center shrink-0">menu_book</span>
                        <h2 class="font-extrabold text-xs sm:text-sm text-slate-900 dark:text-white leading-tight">Subject Wise Exam</h2>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
                    <% allSubjects.forEach(function(sub) { %>
                        <% 
                           const info = subjectTopicMap[sub] || { totalQuestions: 0, mcqCount: 0, writtenCount: 0, topics: [] };
                           const qCount = info.totalQuestions || 0;
                        %>
                        <div onclick="startSubjectExam('<%= sub.replace(/'/g, "\\'") %>')"
                             class="subject-folder-card bg-[#F2F6F9] dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-700/80 hover:border-cyan-500/50 dark:hover:border-cyan-500/50 rounded-2xl p-3.5 sm:p-4 flex flex-col items-center justify-center text-center transition-all duration-200 group shadow-xs cursor-pointer space-y-2.5 hover:shadow-md hover:-translate-y-0.5">
                            <span class="material-symbols-rounded text-4xl sm:text-5xl text-amber-500 leading-none select-none group-hover:scale-110 transition-transform" style="font-variation-settings: 'FILL' 1;">folder</span>
                            <div class="w-full min-w-0">
                                <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-white truncate group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                                    <%= sub %>
                                </h4>
                                <p class="text-[10px] font-semibold text-slate-400 mt-0.5">
                                    <%= qCount %> <%= qCount === 1 ? 'Question' : 'Questions' %>
                                </p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

        </main>
    </div>

    <!-- CUSTOM TEST BUILDER MODAL -->
    <div id="customTestModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3">
        <div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-4 sm:p-5 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-rounded text-[#6C757D] text-lg leading-none flex items-center justify-center shrink-0">edit_note</span>
                    <h2 class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">CustomTest Builder</h2>
                </div>
                <button type="button" onclick="toggleCustomTestModal()" class="size-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-all">
                    <span class="material-symbols-rounded text-base">close</span>
                </button>
            </div>

            <form action="/exams/custom-start" method="POST" class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 ml-0.5">Subject</label>
                        <select id="customSubjectSelect" name="subject" onchange="onSubjectChange()" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-[#6C757D]">
                            <option value="">All Subjects</option>
                            <% allSubjects.forEach(function(sub) { %>
                                <option value="<%= sub %>"><%= sub %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 ml-0.5">Topic / Chapter</label>
                        <select id="customTopicSelect" name="topic" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-[#6C757D]">
                            <option value="">All Topics</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 ml-0.5">Question Type</label>
                        <select name="questionType" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-[#6C757D]">
                            <option value="All">All Question Types</option>
                            <option value="MCQ">MCQs Only</option>
                            <option value="Written">Written Solutions Only</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 ml-0.5">Number of Questions</label>
                        <select name="questionCount" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-[#6C757D]">
                            <option value="5">5 Questions</option>
                            <option value="10" selected>10 Questions</option>
                            <option value="15">15 Questions</option>
                            <option value="20">20 Questions</option>
                            <option value="25">25 Questions</option>
                        </select>
                    </div>

                    <div class="space-y-1 sm:col-span-2">
                        <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400 ml-0.5">Exam Duration</label>
                        <select name="duration" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-[#6C757D]">
                            <option value="10">10 Minutes</option>
                            <option value="15" selected>15 Minutes</option>
                            <option value="20">20 Minutes</option>
                            <option value="30">30 Minutes</option>
                            <option value="45">45 Minutes</option>
                        </select>
                    </div>
                </div>

                <div class="pt-2 flex justify-end gap-2 border-t border-slate-200 dark:border-slate-800">
                    <button type="button" onclick="toggleCustomTestModal()" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold hover:bg-slate-200 transition-all">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-[#6C757D] hover:bg-[#5a6268] text-white text-xs font-bold transition-all shadow-md shadow-[#6C757D]/25 border border-white/20 flex items-center gap-1.5">
                        <span class="material-symbols-rounded text-sm text-white leading-none flex items-center justify-center shrink-0">edit_note</span>
                        <span>Start CustomTest</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- HIDDEN FORM FOR QUICK SUBJECT EXAM START -->
    <form id="quickExamForm" action="/exams/custom-start" method="POST" class="hidden">
        <input type="hidden" name="subject" id="quickSubjectInput">
        <input type="hidden" name="questionType" value="All">
        <input type="hidden" name="questionCount" value="10">
        <input type="hidden" name="duration" value="15">
    </form>

    <script>
        const rawTopicsData = <%- JSON.stringify(rawTopics || []) %>;

        function toggleCustomTestModal() {
            const modal = document.getElementById('customTestModal');
            modal.classList.toggle('hidden');
        }

        function onSubjectChange() {
            const subjectSelect = document.getElementById('customSubjectSelect');
            const topicSelect = document.getElementById('customTopicSelect');
            const selectedSubject = subjectSelect.value;

            topicSelect.innerHTML = '<option value="">All Topics</option>';

            if (!selectedSubject) return;

            const filteredTopics = rawTopicsData
                .filter(t => t._id && t._id.subject === selectedSubject && t._id.topic)
                .map(t => t._id.topic);

            const uniqueTopics = Array.from(new Set(filteredTopics));

            uniqueTopics.forEach(tp => {
                const opt = document.createElement('option');
                opt.value = tp;
                opt.textContent = tp;
                topicSelect.appendChild(opt);
            });
        }

        function startSubjectExam(subjectName) {
            window.location.href = '/exams/subject-tests?subject=' + encodeURIComponent(subjectName);
        }

        function toggleMetricsDropdown(event) {
            event.stopPropagation();
            const menu = document.getElementById('metricsDropdownMenu');
            if (menu) {
                menu.classList.toggle('hidden');
            }
        }

        document.addEventListener('click', function (e) {
            const menu = document.getElementById('metricsDropdownMenu');
            const btn = document.getElementById('metricsDropdownBtn');
            if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                    menu.classList.add('hidden');
                }
            }
        });
    </script>
</body>
</html>