<!DOCTYPE html>
<html class="light" lang="bn">

<head>
    <title>
        <%= note.title %> | অধ্যায় রিডার
    </title>
    <%- include('partials/head') %>
        <style>
            .reader-container {
                height: calc(100vh - 80px);
            }
        </style>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 overflow-hidden">
    <!-- Header -->
    <header
        class="h-20 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md px-6 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <a href="/notes"
                class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-primary transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h1 class="text-lg font-black leading-none mb-1 truncate max-w-[200px] md:max-w-md">
                    <%= note.title %>
                </h1>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                    <%= note.subject %> • <%= note.classLevel %>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button id="saveNoteBtn" onclick="toggleSaveCurrentNote()" class="btn-secondary !py-2 !px-3.5 !text-xs flex items-center gap-1.5 transition-all">
                <span class="material-symbols-outlined text-sm" id="saveNoteIcon">bookmark_border</span>
                <span id="saveNoteText">সেভ করুন</span>
            </button>
            <a href="<%= note.fileUrl %>" download class="btn-secondary !py-2 !px-4 !text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">download</span> ডাউনলোড
            </a>
            <button id="themeToggleBtn" onclick="toggleTheme()"
                class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-primary dark:hover:text-primary transition-all active:scale-90 cursor-pointer" title="Toggle Theme" aria-label="Toggle Theme">
                <span class="material-symbols-outlined text-sm block dark:hidden">dark_mode</span>
                <span class="material-symbols-outlined text-sm hidden dark:block">light_mode</span>
            </button>
        </div>
    </header>

    <main class="reader-container p-4 md:p-8">
        <div
            class="max-w-5xl mx-auto h-full bg-white dark:bg-slate-950 rounded-[2rem] shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden relative flex flex-col">
            <!-- PDF Viewer / Content -->
            <% if (note.fileUrl && note.fileUrl.endsWith('.pdf')) { %>
                <iframe src="<%= note.fileUrl %>#toolbar=0" class="w-full h-full border-none"></iframe>
                <% } else if (note.fileUrl && (note.fileUrl.endsWith('.jpg') || note.fileUrl.endsWith('.png') ||
                    note.fileUrl.endsWith('.jpeg'))) { %>
                    <div class="flex-1 overflow-auto p-8 flex justify-center bg-slate-100 dark:bg-slate-900">
                        <img src="<%= note.fileUrl %>" class="max-w-full shadow-2xl rounded-xl h-fit">
                    </div>
                    <% } else { %>
                        <div class="flex-1 p-12 overflow-auto body-main dark:text-slate-300">
                            <div class="prose dark:prose-invert max-w-none">
                                <%- note.description || 'এই নোটের কোনো টেক্সট কন্টেন্ট নেই।' %>
                            </div>
                        </div>
                        <% } %>

                            <!-- Bottom Floating Toolbar -->
                            <div
                                class="absolute bottom-8 left-1/2 -translate-x-1/2 px-6 py-3 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-800 flex items-center gap-6 z-10">
                                <button onclick="window.print()"
                                    class="flex flex-col items-center gap-1 group text-slate-400 hover:text-primary transition-all">
                                    <span class="material-symbols-outlined">print</span>
                                    <span class="text-[9px] font-black uppercase">প্রিন্ট</span>
                                </button>
                                <div class="w-px h-6 bg-slate-200 dark:bg-slate-800"></div>
                                <button
                                    class="flex flex-col items-center gap-1 group text-slate-400 hover:text-primary transition-all">
                                    <span class="material-symbols-outlined">share</span>
                                    <span class="text-[9px] font-black uppercase">শেয়ার</span>
                                </button>
                            </div>
        </div>
    </main>

    <script>
        const noteId = '<%= note._id %>';
        const noteTitle = '<%= note.title.replace(/'/g, "\\'") %>';
        const noteLink = '/note-viewer/' + noteId;
        let isSaved = false;

        function checkSavedState() {
            try {
                const saved = JSON.parse(localStorage.getItem('oddhay_saved_notes') || '[]');
                isSaved = saved.includes(noteId);
                updateSaveUI();
            } catch(e) {}
        }

        function updateSaveUI() {
            const icon = document.getElementById('saveNoteIcon');
            const text = document.getElementById('saveNoteText');
            const btn = document.getElementById('saveNoteBtn');

            if (isSaved) {
                if (icon) icon.textContent = 'bookmark';
                if (text) text.textContent = 'সেভ করা হয়েছে';
                if (btn) btn.classList.add('bg-amber-50', 'dark:bg-amber-950/40', 'text-amber-600', 'border-amber-200');
            } else {
                if (icon) icon.textContent = 'bookmark_border';
                if (text) text.textContent = 'সেভ করুন';
                if (btn) btn.classList.remove('bg-amber-50', 'dark:bg-amber-950/40', 'text-amber-600', 'border-amber-200');
            }
        }

        function toggleSaveCurrentNote() {
            let saved = JSON.parse(localStorage.getItem('oddhay_saved_notes') || '[]');
            const index = saved.indexOf(noteId);

            if (index > -1) {
                saved.splice(index, 1);
                isSaved = false;
                fetch('/api/remove-bookmark', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ link: noteLink })
                }).catch(e => {});
            } else {
                saved.push(noteId);
                isSaved = true;
                fetch('/api/save-bookmark', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: noteTitle, link: noteLink, itemType: 'note' })
                }).catch(e => {});
            }

            localStorage.setItem('oddhay_saved_notes', JSON.stringify(saved));
            updateSaveUI();
        }

        document.addEventListener('DOMContentLoaded', checkSavedState);
    </script>
</body>

</html>