<!DOCTYPE html>
<html lang="en" class="<%= user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <title>Change Password | ODDHAY</title>
    <style>
        body { display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #f0f4f9; }
        .dark body { background: #0b1120; }
        .card { background: #fff; border-radius: 1rem; box-shadow: 0 20px 60px rgba(0,0,0,0.1); padding: 2rem; max-width: 400px; width: 90%; }
        .dark .card { background: #1e293b; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        input { width: 100%; padding: 12px; margin-bottom: 1rem; border-radius: 0.5rem; border: 1px solid #e2e8f0; background: #f8fafc; box-sizing: border-box; }
        .dark input { background: #334155; border-color: #475569; color: #fff; }
        .btn { width: 100%; padding: 12px; background: #1a73e8; color: white; border: none; border-radius: 0.5rem; font-weight: bold; font-size: 1rem; cursor: pointer; }
        .btn:hover { background: #1557b0; }
        .alert { background: #fff7ed; border-left: 4px solid #f97316; padding: 1rem; margin-bottom: 1rem; border-radius: 0.5rem; font-size: 0.9rem; }
        .dark .alert { background: #1e293b; }
    </style>
</head>
<body>
    <div class="card">
        <h2 style="margin-top: 0; text-align: center;">Security Check</h2>
        <div class="alert">
            <strong>Privacy Alert:</strong> Your password was reset by an administrator for security reasons. You must set a new private password immediately to continue using the platform.
        </div>
        <% if (error) { %>
            <div class="alert" style="background: #fef2f2; border-color: #ef4444; color: #991b1b;"><%= error %></div>
        <% } %>
        <form method="POST" action="/change-password">
            <input type="password" name="newPassword" placeholder="New Password" required>
            <input type="password" name="confirmPassword" placeholder="Confirm New Password" required>
            <button type="submit" class="btn">Update & Continue</button>
        </form>
    </div>
</body>
</html>
