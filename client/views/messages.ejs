            async function executeBlockToggle() {
                if (!activeTeacherId) return;
                const confirmBtn = document.getElementById('modal-block-confirm-btn');
                if (confirmBtn) confirmBtn.disabled = true;

                try {
                    const res = await fetch('/api/messages/toggle-block', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ targetUserId: activeTeacherId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        updateBlockUI(data.isBlocked, isCurrentTeacherBlockedByThem);
                        closeBlockModal();
                    }
                } catch (err) {
                    console.error('Failed to toggle block:', err);
                } finally {
                    if (confirmBtn) confirmBtn.disabled = false;
                }
            }
            window.executeBlockToggle = executeBlockToggle;

            window.addEventListener('popstate', () => {
                const params = new URLSearchParams(window.location.search);
                const tId = params.get('teacherId');
                if (tId && teachersDirectory[tId]) {
                    selectTeacherThread(tId);
                }
            });

            function filterTeacherList(query) {
                const q = (query || '').toLowerCase().trim();
                const items = document.querySelectorAll('.teacher-contact-item');
                items.forEach(item => {
                    const name = item.getAttribute('data-teacher-name') || '';
                    const sub = item.getAttribute('data-teacher-subject') || '';
                    if (!q || name.includes(q) || sub.includes(q)) {
                        item.style.display = 'flex';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            let isFirstLoad = true;
            let prevMessagesSignature = '';

            // --- Staged Attachment & Rich Media Support ---
            let stagedStudentAttachment = null;
            let studentMediaRecorder = null;
            let studentAudioChunks = [];
            let studentVoiceTimerInterval = null;
            let studentVoiceSeconds = 0;
            let studentCameraStream = null;
            let studentCameraFacing = 'user';
            let studentCapturedBlob = null;

            function formatBytes(bytes, decimals = 1) {
                if (!bytes) return '0 B';
                const k = 1024;
                const dm = decimals < 0 ? 0 : decimals;
                const sizes = ['B', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
            }

            function handleStudentFileSelect(e) {
                const file = e.target.files && e.target.files[0];
                if (!file) return;

                const mime = (file.type || '').toLowerCase();
                const name = file.name || 'attachment';
                let fileType = 'other';
                if (mime.startsWith('image/')) fileType = 'image';
                else if (mime.startsWith('video/')) fileType = 'video';
                else if (mime.startsWith('audio/')) fileType = 'audio';
                else if (mime === 'application/pdf' || name.endsWith('.pdf')) fileType = 'pdf';
                else if (mime.includes('word') || mime.includes('document') || name.match(/\.(docx?|txt|xlsx?|pptx?)$/i)) fileType = 'document';

                stageStudentAttachment(file, name, file.size, fileType);
            }
            window.handleStudentFileSelect = handleStudentFileSelect;

            function stageStudentAttachment(fileOrBlob, name, size, fileType, duration) {
                stagedStudentAttachment = {
                    file: fileOrBlob,
                    fileName: name,
                    fileSize: size || 0,
                    fileType: fileType || 'other',
                    duration: duration || undefined
                };

                const bar = document.getElementById('student-staged-attachment-bar');
                const nameEl = document.getElementById('student-staged-name');
                const sizeEl = document.getElementById('student-staged-size');
                const iconEl = document.getElementById('student-staged-icon');
                const imgEl = document.getElementById('student-staged-img');

                if (bar) bar.classList.remove('hidden');
                if (nameEl) nameEl.textContent = name;
                if (sizeEl) sizeEl.textContent = formatBytes(size);

                if (fileType === 'image') {
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        if (imgEl) {
                            imgEl.src = ev.target.result;
                            imgEl.classList.remove('hidden');
                        }
                        if (iconEl) iconEl.classList.add('hidden');
                    };
                    reader.readAsDataURL(fileOrBlob);
                } else {
                    if (imgEl) { imgEl.src = ''; imgEl.classList.add('hidden'); }
                    if (iconEl) {
                        iconEl.classList.remove('hidden');
                        if (fileType === 'video') iconEl.textContent = 'movie';
                        else if (fileType === 'audio') iconEl.textContent = 'mic';
                        else if (fileType === 'pdf') iconEl.textContent = 'picture_as_pdf';
                        else if (fileType === 'document') iconEl.textContent = 'description';
                        else iconEl.textContent = 'attach_file';
                    }
                }

                const input = document.getElementById('student-msg-input');
                if (input) input.focus();
            }

            function clearStudentStagedAttachment() {
                stagedStudentAttachment = null;
                const bar = document.getElementById('student-staged-attachment-bar');
                const fileInput = document.getElementById('student-file-input');
                if (bar) bar.classList.add('hidden');
                if (fileInput) fileInput.value = '';
            }
            window.clearStudentStagedAttachment = clearStudentStagedAttachment;

            // --- Voice Recording ---
            async function startStudentVoiceRecording() {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    studentAudioChunks = [];
                    studentVoiceSeconds = 0;

                    studentMediaRecorder = new MediaRecorder(stream);
                    studentMediaRecorder.ondataavailable = (e) => {
                        if (e.data && e.data.size > 0) studentAudioChunks.push(e.data);
                    };

                    studentMediaRecorder.onstop = () => {
                        stream.getTracks().forEach(track => track.stop());
                    };

                    studentMediaRecorder.start();

                    const recBar = document.getElementById('student-voice-recording-bar');
                    const timerEl = document.getElementById('student-voice-timer');
                    if (recBar) recBar.classList.remove('hidden');
                    if (timerEl) timerEl.textContent = '0:00';

                    if (studentVoiceTimerInterval) clearInterval(studentVoiceTimerInterval);
                    studentVoiceTimerInterval = setInterval(() => {
                        studentVoiceSeconds++;
                        const mins = Math.floor(studentVoiceSeconds / 60);
                        const secs = studentVoiceSeconds % 60;
                        if (timerEl) timerEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
                    }, 1000);
                } catch (err) {
                    console.error('Microphone access error:', err);
                    alert('Unable to access microphone. Please check your browser permissions.');
                }
            }
            window.startStudentVoiceRecording = startStudentVoiceRecording;

            function cancelStudentVoiceRecording() {
                if (studentVoiceTimerInterval) clearInterval(studentVoiceTimerInterval);
                if (studentMediaRecorder && studentMediaRecorder.state !== 'inactive') {
                    studentMediaRecorder.stop();
                }
                studentAudioChunks = [];
                const recBar = document.getElementById('student-voice-recording-bar');
                if (recBar) recBar.classList.add('hidden');
            }
            window.cancelStudentVoiceRecording = cancelStudentVoiceRecording;

            function finishStudentVoiceRecording(autoSend = false) {
                if (studentVoiceTimerInterval) clearInterval(studentVoiceTimerInterval);
                const duration = studentVoiceSeconds;
                const mins = Math.floor(duration / 60);
                const secs = (duration % 60).toString().padStart(2, '0');

                if (!studentMediaRecorder || studentMediaRecorder.state === 'inactive') {
                    cancelStudentVoiceRecording();
                    return;
                }

                studentMediaRecorder.onstop = () => {
                    const audioBlob = new Blob(studentAudioChunks, { type: 'audio/webm' });
                    const recBar = document.getElementById('student-voice-recording-bar');
                    if (recBar) recBar.classList.add('hidden');

                    stageStudentAttachment(audioBlob, `Voice Note (${mins}:${secs})`, audioBlob.size, 'audio', duration);

                    if (autoSend) {
                        sendStudentMessage();
                    }
                };

                studentMediaRecorder.stop();
            }
            window.finishStudentVoiceRecording = finishStudentVoiceRecording;

            // --- Camera Capture Modal ---
            async function openStudentCameraModal() {
                const modal = document.getElementById('student-camera-modal');
                const video = document.getElementById('student-camera-video');
                const liveControls = document.getElementById('student-camera-controls-live');
                const prevControls = document.getElementById('student-camera-controls-preview');
                const prevImg = document.getElementById('student-camera-preview-img');

                if (modal) modal.classList.remove('hidden');
                if (liveControls) liveControls.classList.remove('hidden');
                if (prevControls) prevControls.classList.add('hidden');
                if (prevImg) prevImg.classList.add('hidden');
                if (video) video.classList.remove('hidden');

                try {
                    if (studentCameraStream) {
                        studentCameraStream.getTracks().forEach(t => t.stop());
                    }
                    studentCameraStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: studentCameraFacing },
                        audio: false
                    });
                    if (video) video.srcObject = studentCameraStream;
                } catch (err) {
                    console.error('Camera access error:', err);
                    alert('Unable to access camera. Please check camera permissions.');
                    closeStudentCameraModal();
                }
            }
            window.openStudentCameraModal = openStudentCameraModal;

            function closeStudentCameraModal() {
                if (studentCameraStream) {
                    studentCameraStream.getTracks().forEach(t => t.stop());
                    studentCameraStream = null;
                }
                const modal = document.getElementById('student-camera-modal');
                if (modal) modal.classList.add('hidden');
            }
            window.closeStudentCameraModal = closeStudentCameraModal;

            async function switchStudentCamera() {
                studentCameraFacing = studentCameraFacing === 'user' ? 'environment' : 'user';
                await openStudentCameraModal();
            }
            window.switchStudentCamera = switchStudentCamera;

            function captureStudentPhoto() {
                const video = document.getElementById('student-camera-video');
                const canvas = document.getElementById('student-camera-canvas');
                const prevImg = document.getElementById('student-camera-preview-img');
                const liveControls = document.getElementById('student-camera-controls-live');
                const prevControls = document.getElementById('student-camera-controls-preview');

                if (!video || !canvas) return;

                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                canvas.toBlob((blob) => {
                    studentCapturedBlob = blob;
                    const url = URL.createObjectURL(blob);
                    if (prevImg) {
                        prevImg.src = url;
                        prevImg.classList.remove('hidden');
                    }
                    if (video) video.classList.add('hidden');
                    if (liveControls) liveControls.classList.add('hidden');
                    if (prevControls) prevControls.classList.remove('hidden');
                }, 'image/jpeg', 0.92);
            }
            window.captureStudentPhoto = captureStudentPhoto;

            function retakeStudentPhoto() {
                const video = document.getElementById('student-camera-video');
                const prevImg = document.getElementById('student-camera-preview-img');
                const liveControls = document.getElementById('student-camera-controls-live');
                const prevControls = document.getElementById('student-camera-controls-preview');

                studentCapturedBlob = null;
                if (prevImg) prevImg.classList.add('hidden');
                if (video) video.classList.remove('hidden');
                if (liveControls) liveControls.classList.remove('hidden');
                if (prevControls) prevControls.classList.add('hidden');
            }
            window.retakeStudentPhoto = retakeStudentPhoto;

            function useCapturedStudentPhoto() {
                if (studentCapturedBlob) {
                    stageStudentAttachment(studentCapturedBlob, `photo-${Date.now()}.jpg`, studentCapturedBlob.size, 'image');
                }
                closeStudentCameraModal();
            }
            window.useCapturedStudentPhoto = useCapturedStudentPhoto;

            function renderMessageBubble(msg, isMe) {
                if (msg.deletedForEveryone) {
                    return `
                        <div class="px-3.5 py-2.5 rounded-2xl ${isMe ? 'rounded-tr-none bg-[#0084FF]/20 text-white/90' : 'rounded-tl-none bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400'} border border-slate-200/60 dark:border-slate-700/60 italic text-xs font-medium flex items-center gap-1.5 shadow-2xs select-none">
                            <span class="material-symbols-rounded text-sm opacity-75 leading-none pointer-events-none">block</span>
                            <span>This message was deleted</span>
                        </div>
                    `;
                }

                const att = msg.attachment;
                const hasText = Boolean(msg.text && msg.text.trim());
                const pinnedRing = msg.isPinned ? (isMe ? 'ring-2 ring-amber-400' : 'ring-2 ring-amber-400 border-amber-400') : '';

                let replyQuoteHtml = '';
                if (msg.replyTo && msg.replyTo.messageId) {
                    const rSender = escapeHtml(msg.replyTo.senderName || 'Replied message');
                    const rText = escapeHtml(msg.replyTo.text || (msg.replyTo.fileType ? `[${msg.replyTo.fileType}]` : 'Attachment'));
                    replyQuoteHtml = `
                        <div onclick="scrollToMessage('${msg.replyTo.messageId}')" class="cursor-pointer mb-2 px-2.5 py-1.5 rounded-xl border-l-2 ${isMe ? 'border-white/80 bg-white/15 text-white' : 'border-primary bg-slate-200/80 dark:bg-slate-700/80 text-slate-800 dark:text-slate-100'} text-[11px] select-none transition-all hover:opacity-90">
                            <div class="font-bold flex items-center gap-1">
                                <span class="material-symbols-rounded text-[13px] leading-none">reply</span>
                                <span class="truncate">${rSender}</span>
                            </div>
                            <div class="truncate opacity-80 mt-0.5">${rText}</div>
                        </div>
                    `;
                }

                // 1. Pure Image (No text caption)
                if (att && att.url && att.fileType === 'image' && !hasText) {
                    const fileUrl = escapeHtml(att.url);
                    const fileName = escapeHtml(att.fileName || 'Photo');
                    return `
                        <div class="overflow-hidden rounded-2xl shadow-xs border border-black/10 dark:border-white/10 max-w-[260px] sm:max-w-[320px] ${pinnedRing}">
                            ${replyQuoteHtml ? `<div class="p-2 pb-0">${replyQuoteHtml}</div>` : ''}
                            <div onclick="openImageViewer('${fileUrl}', '${fileName}')" class="block hover:opacity-95 transition-opacity cursor-pointer">
                                <img src="${fileUrl}" alt="${fileName}" class="w-full max-h-80 object-cover block">
                            </div>
                        </div>
                    `;
                }

                // 2. Pure Video (No text caption)
                if (att && att.url && att.fileType === 'video' && !hasText) {
                    const fileUrl = escapeHtml(att.url);
                    return `
                        <div class="overflow-hidden rounded-2xl shadow-xs border border-black/10 dark:border-white/10 max-w-[280px] sm:max-w-[340px] bg-black ${pinnedRing}">
                            ${replyQuoteHtml ? `<div class="p-2 pb-0">${replyQuoteHtml}</div>` : ''}
                            <video controls playsinline preload="metadata" class="w-full rounded-2xl max-h-80 block">
                                <source src="${fileUrl}">
                                Your browser does not support HTML5 video.
                            </video>
                        </div>
                    `;
                }

                // 3. Pure Voice Audio Note
                if (att && att.url && att.fileType === 'audio' && !hasText) {
                    const fileUrl = escapeHtml(att.url);
                    const durStr = att.duration ? `${Math.floor(att.duration / 60)}:${Math.floor(att.duration % 60).toString().padStart(2, '0')}` : '';
                    return `
                        <div class="p-2 sm:p-2.5 rounded-2xl flex flex-col gap-1.5 shadow-2xs min-w-[210px] bg-[#EAE9ED] dark:bg-[#1e293b] text-slate-800 dark:text-slate-100 border border-slate-300/70 dark:border-slate-700/80 ${pinnedRing}">
                            ${replyQuoteHtml}
                            <div class="flex items-center gap-2.5">
                                <div class="size-8.5 rounded-xl bg-white dark:bg-slate-800 text-primary shadow-2xs flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-lg leading-none">mic</span>
                                </div>
                                <audio controls class="h-8 max-w-[150px] sm:max-w-[190px] custom-audio-player">
                                    <source src="${fileUrl}">
                                </audio>
                                ${durStr ? `<span class="text-[10px] font-mono font-semibold text-slate-600 dark:text-slate-300 shrink-0">${durStr}</span>` : ''}
                            </div>
                        </div>
                    `;
                }

                // 4. Pure File / Document (No text caption)
                if (att && att.url && (att.fileType === 'pdf' || att.fileType === 'document' || att.fileType === 'other') && !hasText) {
                    const fileUrl = escapeHtml(att.url);
                    const fileName = escapeHtml(att.fileName || 'Attachment');
                    const fileSizeStr = att.fileSize ? formatBytes(att.fileSize) : '';
                    const isPdf = att.fileType === 'pdf';
                    const iconName = isPdf ? 'picture_as_pdf' : 'description';
                    return `
                        <div class="p-3 rounded-2xl flex flex-col gap-1.5 shadow-2xs min-w-[210px] max-w-[280px] ${isMe ? 'bg-[#0084FF] text-white' : 'bg-[#f0f2f5] dark:bg-[#1e293b] text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-700/80'} ${pinnedRing}">
                            ${replyQuoteHtml}
                            <div onclick="${isPdf ? `openPdfViewer('${fileUrl}', '${fileName}')` : `openMediaViewer('${fileUrl}', '${fileName}')`}" class="flex items-center gap-2.5 group/doc cursor-pointer">
                                <div class="size-9 rounded-xl ${isMe ? 'bg-white/20 text-white' : (isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500')} flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-xl leading-none">${iconName}</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-xs font-semibold truncate group-hover/doc:underline">${fileName}</div>
                                    ${fileSizeStr ? `<div class="text-[10px] opacity-80">${fileSizeStr}</div>` : ''}
                                </div>
                                <span class="material-symbols-rounded text-base opacity-85 shrink-0">visibility</span>
                            </div>
                        </div>
                    `;
                }

                // 5. Combined content or text with attachment
                let innerContent = replyQuoteHtml;
                if (att && att.url) {
                    const fileUrl = escapeHtml(att.url);
                    const fileName = escapeHtml(att.fileName || 'Attachment');
                    const fileSizeStr = att.fileSize ? formatBytes(att.fileSize) : '';

                    if (att.fileType === 'image') {
                        innerContent += `
                            <div class="mb-2 -mx-1.5 -mt-1.5 overflow-hidden rounded-xl">
                                <div onclick="openImageViewer('${fileUrl}', '${fileName}')" class="block hover:opacity-95 transition-opacity cursor-pointer">
                                    <img src="${fileUrl}" alt="${fileName}" class="w-full max-h-72 object-cover block">
                                </div>
                            </div>
                        `;
                    } else if (att.fileType === 'video') {
                        innerContent += `
                            <div class="mb-2 -mx-1.5 -mt-1.5 overflow-hidden rounded-xl bg-black">
                                <video controls playsinline preload="metadata" class="w-full rounded-xl max-h-72 block">
                                    <source src="${fileUrl}">
                                </video>
                            </div>
                        `;
                    } else if (att.fileType === 'audio') {
                        innerContent += `
                            <div class="mb-2 p-1.5 rounded-xl flex items-center gap-2 ${isMe ? 'bg-white/20' : 'bg-[#EAE9ED] dark:bg-slate-700/60'}">
                                <audio controls class="h-8 w-full custom-audio-player"><source src="${fileUrl}"></audio>
                            </div>
                        `;
                    } else {
                        const isPdf = att.fileType === 'pdf';
                        const iconName = isPdf ? 'picture_as_pdf' : 'description';
                        innerContent += `
                            <div onclick="${isPdf ? `openPdfViewer('${fileUrl}', '${fileName}')` : `openMediaViewer('${fileUrl}', '${fileName}')`}" class="mb-1.5 p-2.5 rounded-xl flex items-center gap-2.5 ${isMe ? 'bg-[#0084FF] border border-white/25 text-white' : 'bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-700/80'} transition-all shadow-2xs group/doc cursor-pointer">
                                <div class="size-8.5 rounded-lg ${isMe ? 'bg-white/20 text-white' : (isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500')} flex items-center justify-center shrink-0">
                                    <span class="material-symbols-rounded text-xl leading-none">${iconName}</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-xs font-semibold truncate group-hover/doc:underline">${fileName}</div>
                                    ${fileSizeStr ? `<div class="text-[10px] opacity-80">${fileSizeStr}</div>` : ''}
                                </div>
                                <span class="material-symbols-rounded text-base opacity-85 shrink-0">visibility</span>
                            </div>
                        `;
                    }
                }

                if (hasText) {
                    innerContent += `<div>${escapeHtml(msg.text)}</div>`;
                }

                if (isMe) {
                    return `
                        <div class="px-3.5 py-2.5 rounded-2xl rounded-tr-none bg-[#0084FF] text-white text-xs font-medium leading-relaxed shadow-sm ${pinnedRing}">
                            ${innerContent}
                        </div>
                    `;
                } else {
                    return `
                        <div class="px-3.5 py-2.5 rounded-2xl rounded-tl-none bg-[#f0f2f5] dark:bg-[#1e293b] border border-slate-200/80 dark:border-slate-700/80 text-slate-800 dark:text-slate-100 text-xs font-medium leading-relaxed shadow-2xs ${pinnedRing}">
                            ${innerContent}
                        </div>
                    `;
                }
            }

            async function loadStudentThreadMessages(forceScroll = false) {
                if (!activeTeacherId) return;
                const container = document.getElementById('student-messages-stream');
                if (!container) return;

                try {
                    const res = await fetch('/api/messages/thread/' + activeTeacherId);
                    const data = await res.json();

                    if (data.success && Array.isArray(data.messages)) {
                        updateBlockUI(data.isBlockedByMe, data.isBlockedByThem);

                        // Extract all media & files from messages
                        const mediaGrid = document.getElementById('details-media-grid');
                        const mediaEmpty = document.getElementById('details-media-empty');
                        const mediaCount = document.getElementById('details-media-count');
                        const seeAllMediaBtn = document.getElementById('details-media-see-all-btn');

                        const fullMediaGrid = document.getElementById('full-media-grid');
                        const fullMediaEmpty = document.getElementById('full-media-empty');
                        const fullMediaSubcount = document.getElementById('full-media-subcount');

                        const fullDocsList = document.getElementById('full-docs-list');
                        const fullDocsEmpty = document.getElementById('full-docs-empty');
                        const fullDocsSubcount = document.getElementById('full-docs-subcount');

                        const fullVoiceList = document.getElementById('full-voice-list');
                        const fullVoiceEmpty = document.getElementById('full-voice-empty');
                        const fullVoiceSubcount = document.getElementById('full-voice-subcount');

                        const fullCountBadge = document.getElementById('full-media-files-count');

                        const urlRegex = /(https?:\/\/[^\s]+\.(?:png|jpg|jpeg|gif|webp|svg))/gi;

                        const photosAndVideos = [];
                        const docFiles = [];
                        const voiceNotes = [];
                        const allSharedItems = [];

                        data.messages.forEach(m => {
                            if (m.attachment && m.attachment.url) {
                                const item = {
                                    id: m._id,
                                    url: m.attachment.url,
                                    fileName: m.attachment.fileName || 'Attachment',
                                    fileSize: m.attachment.fileSize || 0,
                                    fileType: m.attachment.fileType || 'other',
                                    duration: m.attachment.duration || 0,
                                    createdAt: m.createdAt,
                                    senderName: m.senderName || (m.sender && m.sender.name) || 'User'
                                };
                                allSharedItems.push(item);
                                if (item.fileType === 'image' || item.fileType === 'video') {
                                    photosAndVideos.push(item);
                                } else if (item.fileType === 'audio') {
                                    voiceNotes.push(item);
                                } else {
                                    docFiles.push(item);
                                }
                            } else {
                                const matches = (m.text || '').match(urlRegex);
                                if (matches) {
                                    matches.forEach(url => {
                                        const item = {
                                            id: m._id,
                                            url: url,
                                            fileName: url.split('/').pop() || 'Image',
                                            fileSize: 0,
                                            fileType: 'image',
                                            duration: 0,
                                            createdAt: m.createdAt,
                                            senderName: m.senderName || (m.sender && m.sender.name) || 'User'
                                        };
                                        allSharedItems.push(item);
                                        photosAndVideos.push(item);
                                    });
                                }
                            }
                        });

                        if (mediaCount) mediaCount.textContent = `${allSharedItems.length} item${allSharedItems.length === 1 ? '' : 's'}`;
                        if (fullCountBadge) fullCountBadge.textContent = allSharedItems.length;

                        // Render Sidebar Preview (up to 6 items)
                        if (allSharedItems.length > 0) {
                            if (mediaEmpty) mediaEmpty.classList.add('hidden');
                            if (mediaGrid) {
                                mediaGrid.classList.remove('hidden');
                                const previewItems = allSharedItems.slice(0, 6);
                                mediaGrid.innerHTML = previewItems.map(item => {
                                    if (item.fileType === 'image') {
                                        return `
                                            <div onclick="openImageViewer('${escapeHtml(item.url)}', '${escapeHtml(item.fileName)}')" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 block hover:opacity-85 transition-all shadow-2xs group cursor-pointer">
                                                <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.fileName)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
                                            </div>
                                        `;
                                    } else if (item.fileType === 'video') {
                                        return `
                                            <a href="${escapeHtml(item.url)}" target="_blank" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl overflow-hidden bg-slate-900 border border-slate-700 flex items-center justify-center text-white relative hover:opacity-85 transition-all shadow-2xs group">
                                                <span class="material-symbols-rounded text-2xl leading-none">play_circle</span>
                                            </a>
                                        `;
                                    } else if (item.fileType === 'audio') {
                                        return `
                                            <div onclick="openAllMediaFilesView(true)" title="Voice Note" class="aspect-square rounded-xl bg-primary/10 border border-primary/20 flex flex-col items-center justify-center text-primary cursor-pointer hover:bg-primary/15 transition-all shadow-2xs p-1">
                                                <span class="material-symbols-rounded text-xl leading-none mb-0.5">mic</span>
                                                <span class="text-[9px] font-bold font-mono">Audio</span>
                                            </div>
                                        `;
                                    } else {
                                        const isPdf = item.fileType === 'pdf';
                                        return `
                                            <div onclick="${isPdf ? `openPdfViewer('${escapeHtml(item.url)}', '${escapeHtml(item.fileName)}')` : `openMediaViewer('${escapeHtml(item.url)}', '${escapeHtml(item.fileName)}')`}" title="${escapeHtml(item.fileName)}" class="aspect-square rounded-xl ${isPdf ? 'bg-rose-500/10 border-rose-500/20 text-rose-500 hover:bg-rose-500/15' : 'bg-blue-500/10 border-blue-500/20 text-blue-500 hover:bg-blue-500/15'} border flex flex-col items-center justify-center transition-all shadow-2xs p-1 text-center cursor-pointer">
                                                <span class="material-symbols-rounded text-xl leading-none mb-0.5">${isPdf ? 'picture_as_pdf' : 'description'}</span>
                                                <span class="text-[8.5px] font-semibold truncate w-full px-1">${escapeHtml(item.fileName.slice(0, 7))}</span>
                                            </div>
                                        `;
                                    }
                                }).join('');
                            }

                            if (seeAllMediaBtn) {
                                seeAllMediaBtn.classList.remove('hidden');
                                seeAllMediaBtn.innerHTML = `<span>See all (${allSharedItems.length})</span><span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>`;
                            }
                        } else {
                            if (mediaGrid) { mediaGrid.innerHTML = ''; mediaGrid.classList.add('hidden'); }
                            if (mediaEmpty) mediaEmpty.classList.remove('hidden');
                            if (seeAllMediaBtn) seeAllMediaBtn.classList.add('hidden');
                        }

                        // Render Full Dedicated View
                        // 1. Photos & Videos
                        if (fullMediaSubcount) fullMediaSubcount.textContent = `(${photosAndVideos.length})`;
                        if (photosAndVideos.length > 0) {
                            if (fullMediaEmpty) fullMediaEmpty.classList.add('hidden');
                            if (fullMediaGrid) {
                                fullMediaGrid.classList.remove('hidden');
                                fullMediaGrid.innerHTML = photosAndVideos.map(item => {
                                    if (item.fileType === 'video') {
                                        return `
                                            <div class="rounded-2xl overflow-hidden bg-black border border-slate-200 dark:border-slate-800 shadow-2xs group relative">
                                                <video controls playsinline preload="metadata" class="w-full h-44 object-cover">
                                                    <source src="${escapeHtml(item.url)}">
                                                </video>
                                                <div class="p-2 bg-slate-900/90 text-white text-[11px] font-medium truncate flex items-center justify-between">
                                                    <span class="truncate">${escapeHtml(item.senderName)}</span>
                                                    <a href="${escapeHtml(item.url)}" target="_blank" download="${escapeHtml(item.fileName)}" class="hover:text-primary"><span class="material-symbols-rounded text-sm">download</span></a>
                                                </div>
                                            </div>
                                        `;
                                    } else {
                                        return `
                                            <a href="${escapeHtml(item.url)}" target="_blank" class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 shadow-2xs group block relative hover:opacity-95 transition-all">
                                                <img src="${escapeHtml(item.url)}" alt="Photo" class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300">
                                            </a>
                                        `;
                                    }
                                }).join('');
                            }
                        } else {
                            if (fullMediaGrid) { fullMediaGrid.innerHTML = ''; fullMediaGrid.classList.add('hidden'); }
                            if (fullMediaEmpty) fullMediaEmpty.classList.remove('hidden');
                        }

                        // 2. Documents & Files
                        if (fullDocsSubcount) fullDocsSubcount.textContent = `(${docFiles.length})`;
                        if (docFiles.length > 0) {
                            if (fullDocsEmpty) fullDocsEmpty.classList.add('hidden');
                            if (fullDocsList) {
                                fullDocsList.classList.remove('hidden');
                                fullDocsList.innerHTML = docFiles.map(item => {
                                    const isPdf = item.fileType === 'pdf';
                                    const iconName = isPdf ? 'picture_as_pdf' : 'description';
                                    const sizeStr = item.fileSize ? formatBytes(item.fileSize) : '';
                                    const timeStr = new Date(item.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' });
                                    return `
                                        <a href="${escapeHtml(item.url)}" target="_blank" download="${escapeHtml(item.fileName)}" class="p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 transition-all flex items-center justify-between gap-3 shadow-2xs group">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="size-10 rounded-xl ${isPdf ? 'bg-rose-500/15 text-rose-500' : 'bg-blue-500/15 text-blue-500'} flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-rounded text-2xl leading-none">${iconName}</span>
                                                </div>
                                                <div class="min-w-0">
                                                    <div class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate group-hover:text-primary transition-colors">${escapeHtml(item.senderName)}</div>
                                                    <div class="text-[10px] text-slate-400 font-medium flex items-center gap-1.5 mt-0.5">
                                                        <span>${sizeStr || 'File'}</span>
                                                        <span>•</span>
                                                        <span>${timeStr}</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="size-8 rounded-xl bg-white dark:bg-slate-700 text-slate-500 dark:text-slate-300 flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-primary group-hover:text-white transition-all">
                                                <span class="material-symbols-rounded text-lg leading-none">download</span>
                                            </div>
                                        </a>
                                    `;
                                }).join('');
                            }
                        } else {
                            if (fullDocsList) { fullDocsList.innerHTML = ''; fullDocsList.classList.add('hidden'); }
                            if (fullDocsEmpty) fullDocsEmpty.classList.remove('hidden');
                        }

                        // 3. Voice Notes
                        if (fullVoiceSubcount) fullVoiceSubcount.textContent = `(${voiceNotes.length})`;
                        if (voiceNotes.length > 0) {
                            if (fullVoiceEmpty) fullVoiceEmpty.classList.add('hidden');
                            if (fullVoiceList) {
                                fullVoiceList.classList.remove('hidden');
                                fullVoiceList.innerHTML = voiceNotes.map(item => {
                                    const durStr = item.duration ? `${Math.floor(item.duration / 60)}:${Math.floor(item.duration % 60).toString().padStart(2, '0')}` : '';
                                    const timeStr = new Date(item.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' });
                                    return `
                                        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 flex items-center justify-between gap-3 shadow-2xs">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="size-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-rounded text-2xl leading-none">mic</span>
                                                </div>
                                                <div class="min-w-0">
                                                    <div class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">${escapeHtml(item.senderName)}</div>
                                                    <div class="text-[10px] text-slate-400 font-medium flex items-center gap-1.5 mt-0.5">
                                                        <span>${durStr || 'Voice'}</span>
                                                        <span>•</span>
                                                        <span>${timeStr}</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <audio controls class="h-8 max-w-[140px] sm:max-w-[180px] custom-audio-player">
                                                <source src="${escapeHtml(item.url)}">
                                            </audio>
                                        </div>
                                    `;
                                }).join('');
                            }
                        } else {
                            if (fullVoiceList) { fullVoiceList.innerHTML = ''; fullVoiceList.classList.add('hidden'); }
                            if (fullVoiceEmpty) fullVoiceEmpty.classList.remove('hidden');
                        }

                        // Extract pinned messages
                        const pinnedContainer = document.getElementById('details-pinned-list-container');
                        const pinnedList = document.getElementById('details-pinned-list');
                        const pinnedEmpty = document.getElementById('details-pinned-empty');
                        const pinnedCount = document.getElementById('details-pinned-count');
                        const seeMoreBtn = document.getElementById('details-pinned-see-more-btn');
                        
                        const fullPinnedContainer = document.getElementById('full-pinned-list-container');
                        const fullPinnedList = document.getElementById('full-pinned-list');
                        const fullPinnedEmpty = document.getElementById('full-pinned-empty');

                        const pinnedMessages = data.messages.filter(m => Boolean(m.isPinned));

                        if (pinnedCount) pinnedCount.textContent = `${pinnedMessages.length} pinned`;

                        const renderPinnedItem = (m) => {
                            const senderName = m.senderName || (m.sender && m.sender.name) || 'User';
                            const timeStr = new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            return `
                                <div onclick="scrollToMessage('${m._id}')" class="p-3 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 cursor-pointer transition-all group">
                                    <div class="flex items-center justify-between gap-1.5 mb-1">
                                        <span class="text-[11.5px] font-semibold text-slate-800 dark:text-slate-200 truncate">${escapeHtml(senderName)}</span>
                                        <div class="flex items-center gap-1.5 shrink-0">
                                            <span class="text-[9.5px] text-slate-400 font-medium">${timeStr}</span>
                                            <button type="button" onclick="event.stopPropagation(); togglePinMessage('${m._id}')" title="Unpin message" class="size-7 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer active:scale-90 select-none">
                                                <span class="material-symbols-rounded text-base leading-none">keep_off</span>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed font-normal">${escapeHtml(m.text || (m.attachment ? m.attachment.fileName : 'Media message'))}</p>
                                </div>
                            `;
                        };

                        if (pinnedMessages.length > 0) {
                            if (pinnedEmpty) pinnedEmpty.classList.add('hidden');
                            if (pinnedContainer) pinnedContainer.classList.remove('hidden');
                            if (pinnedList) {
                                const previewItems = pinnedMessages.slice(0, 3);
                                pinnedList.innerHTML = previewItems.map(renderPinnedItem).join('');
                            }
                            if (seeMoreBtn) {
                                if (pinnedMessages.length > 3) {
                                    seeMoreBtn.classList.remove('hidden');
                                    seeMoreBtn.innerHTML = `<span>See all ${pinnedMessages.length} pinned</span><span class="material-symbols-rounded text-sm leading-none">arrow_forward</span>`;
                                } else {
                                    seeMoreBtn.classList.add('hidden');
                                }
                            }

                            if (fullPinnedEmpty) fullPinnedEmpty.classList.add('hidden');
                            if (fullPinnedContainer) fullPinnedContainer.classList.remove('hidden');
                            if (fullPinnedList) fullPinnedList.innerHTML = pinnedMessages.map(renderPinnedItem).join('');
                        } else {
                            if (pinnedContainer) pinnedContainer.classList.add('hidden');
                            if (pinnedList) pinnedList.innerHTML = '';
                            if (pinnedEmpty) pinnedEmpty.classList.remove('hidden');
                            if (seeMoreBtn) seeMoreBtn.classList.add('hidden');

                            if (fullPinnedContainer) fullPinnedContainer.classList.add('hidden');
                            if (fullPinnedList) fullPinnedList.innerHTML = '';
                            if (fullPinnedEmpty) fullPinnedEmpty.classList.remove('hidden');
                        }

                        const isNearBottom = (container.scrollHeight - container.scrollTop - container.clientHeight) < 80;
                        const newSig = data.messages.map(m => m._id + (m.isRead ? '1' : '0') + (m.isPinned ? 'p' : '') + (m.attachment ? 'a' : '') + (m.likes ? m.likes.length : 0)).join(',');

                        if (newSig === prevMessagesSignature && !forceScroll && !isFirstLoad) {
                            return;
                        }
                        prevMessagesSignature = newSig;

                        // Store in map for fast copy/reply lookup
                        currentThreadMessagesMap = {};
                        data.messages.forEach(m => { currentThreadMessagesMap[m._id] = m; });

                        if (data.messages.length === 0) {
                            container.innerHTML = `
                                <div class="h-full flex flex-col items-center justify-center p-6 text-center">
                                    <div class="size-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-3 shadow-2xs">
                                        <span class="material-symbols-rounded text-2xl leading-none flex items-center justify-center select-none">chat</span>
                                    </div>
                                    <h4 class="text-xs font-bold text-slate-700 dark:text-slate-200">Start asking your questions</h4>
                                    <p class="text-[10px] text-slate-400 mt-1 font-medium">Send a message or voice note to receive guidance directly from instructor.</p>
                                </div>
                            `;
                        } else {
                            let html = '';
                            data.messages.forEach(msg => {
                                const senderId = (msg.sender && msg.sender._id) ? msg.sender._id.toString() : (msg.sender ? msg.sender.toString() : '');
                                const isMe = senderId === currentStudentId;
                                const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                                const avatarUrl = msg.userAvatar || (msg.sender && (msg.sender.profilePicture || msg.sender.profileImage));
                                const senderName = msg.senderName || (msg.sender && msg.sender.name) || (isMe ? 'You' : 'Teacher');
                                const avatarInitial = senderName ? senderName[0].toUpperCase() : 'T';
                                const msgTextSnippet = (msg.text || (msg.attachment ? msg.attachment.fileName : '')).substring(0, 100);
                                const fileType = msg.attachment ? msg.attachment.fileType : '';
                                const isDeleted = Boolean(msg.deletedForEveryone);
                                const isLikedByMe = Array.isArray(msg.likes) && msg.likes.some(id => id.toString() === currentStudentId);
                                const likesCount = Array.isArray(msg.likes) ? msg.likes.length : 0;

                                if (isMe) {
                                    html += `
                                        <div id="msg-${msg._id}" class="flex flex-col items-end group transition-all duration-300 rounded-xl p-1 -m-1 relative">
                                            <!-- 1st Line: Pin indicator & Time -->
                                            <div class="flex items-center gap-1 mb-1 mr-1 select-none">
                                                ${msg.isPinned ? '<span class="material-symbols-rounded text-xs text-amber-500 leading-none mr-0.5" title="Pinned message">push_pin</span>' : ''}
                                                <span class="text-[9.5px] font-medium text-slate-400 dark:text-slate-500">${timeStr}</span>
                                            </div>
                                            <!-- 2nd Line: Message Box + Hover Action Capsule -->
                                            <div class="flex items-center gap-1.5 max-w-[85%] sm:max-w-[75%] flex-row-reverse relative">
                                                <div class="relative max-w-full">
                                                    ${renderMessageBubble(msg, true)}
                                                    ${likesCount > 0 ? `
                                                        <button type="button" onclick="toggleLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'Like'}" class="absolute -bottom-2.5 right-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-md rounded-full px-1.5 py-0.5 flex items-center gap-1 text-[11px] font-bold z-10 cursor-pointer active:scale-95 transition-all select-none hover:scale-105">
                                                            <span class="material-symbols-rounded text-sm text-rose-500 leading-none pointer-events-none">favorite</span>
                                                            ${likesCount > 1 ? `<span class="text-[10px] text-slate-700 dark:text-slate-200 font-semibold pointer-events-none">${likesCount}</span>` : ''}
                                                        </button>
                                                    ` : ''}
                                                </div>

                                                ${!isDeleted ? `
                                                <!-- Sender Hover Action Capsule -->
                                                <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xs border border-slate-200 dark:border-slate-700 rounded-full px-2 py-1 shadow-md shrink-0 select-none z-10">
                                                    <!-- Love / Like Reaction -->
                                                    <button type="button" onclick="toggleLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'React with Love'}" class="size-7.5 sm:size-8 rounded-full ${isLikedByMe ? 'text-rose-500 bg-rose-50 dark:bg-rose-950/40' : 'text-slate-500 dark:text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-700'} flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">favorite</span>
                                                    </button>
                                                    <!-- Copy -->
                                                    <button type="button" onclick="copyMessageContent('${msg._id}')" title="Copy text" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span id="copy-icon-${msg._id}" class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">content_copy</span>
                                                    </button>
                                                    <!-- Reply -->
                                                    <button type="button" onclick="initiateStudentReply('${msg._id}', '${escapeJs(senderName)}', '${escapeJs(msgTextSnippet)}', '${escapeJs(fileType)}')" title="Reply" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                        <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">reply</span>
                                                    </button>
                                                    <!-- Three Dots Menu Button -->
                                                    <div class="relative inline-block">
                                                        <button type="button" onclick="toggleMessageMenu('${msg._id}', event)" title="More options" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                            <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">more_vert</span>
                                                        </button>
                                                        <!-- Dropdown Menu -->
                                                        <div id="msg-menu-${msg._id}" class="msg-action-menu hidden absolute right-0 top-full mt-1.5 w-44 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-xl py-1 z-30 transition-all">
                                                            <button type="button" onclick="togglePinMessage('${msg._id}'); closeAllMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                <span class="material-symbols-rounded text-base text-amber-500 leading-none">${msg.isPinned ? 'keep_off' : 'push_pin'}</span>
                                                                <span>${msg.isPinned ? 'Unpin message' : 'Pin message'}</span>
                                                            </button>
                                                            <button type="button" onclick="deleteStudentMessage('${msg._id}', 'for_me'); closeAllMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                <span class="material-symbols-rounded text-base text-slate-400 leading-none">delete_outline</span>
                                                                <span>Delete for me</span>
                                                            </button>
                                                            <button type="button" onclick="deleteStudentMessage('${msg._id}', 'for_everyone'); closeAllMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2 transition-all cursor-pointer">
                                                                <span class="material-symbols-rounded text-base text-rose-500 leading-none">delete_forever</span>
                                                                <span>Delete for everyone</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                ` : ''}
                                            </div>
                                        </div>
                                    `;
                                } else {
                                    const avatarNode = avatarUrl
                                        ? `<div class="size-8 rounded-xl bg-slate-200 dark:bg-slate-800 shrink-0 shadow-2xs overflow-hidden select-none"><img src="${escapeHtml(avatarUrl)}" alt="${escapeHtml(senderName)}" class="w-full h-full object-cover"></div>`
                                        : `<div class="size-8 rounded-xl bg-primary/15 text-primary font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs select-none">${avatarInitial}</div>`;

                                    html += `
                                        <div id="msg-${msg._id}" class="flex flex-col items-start group transition-all duration-300 rounded-xl p-1 -m-1 relative">
                                            <!-- 1st Line: Actions & Time -->
                                            <div class="flex items-center gap-1 mb-1 ml-10 select-none">
                                                <span class="text-[9.5px] font-medium text-slate-400 dark:text-slate-500">${timeStr}</span>
                                                ${msg.isPinned ? '<span class="material-symbols-rounded text-xs text-amber-500 leading-none ml-0.5" title="Pinned message">push_pin</span>' : ''}
                                            </div>
                                            <!-- 2nd Line: Profile Icon & Message Box + Hover Action Capsule -->
                                            <div class="flex items-start gap-2 max-w-[85%] sm:max-w-[75%]">
                                                ${avatarNode}
                                                <div class="flex items-center gap-1.5 max-w-full relative">
                                                    <div class="relative max-w-full">
                                                        ${renderMessageBubble(msg, false)}
                                                        ${likesCount > 0 ? `
                                                            <button type="button" onclick="toggleLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'Like'}" class="absolute -bottom-2.5 left-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-md rounded-full px-1.5 py-0.5 flex items-center gap-1 text-[11px] font-bold z-10 cursor-pointer active:scale-95 transition-all select-none hover:scale-105">
                                                                <span class="material-symbols-rounded text-sm text-rose-500 leading-none pointer-events-none">favorite</span>
                                                                ${likesCount > 1 ? `<span class="text-[10px] text-slate-700 dark:text-slate-200 font-semibold pointer-events-none">${likesCount}</span>` : ''}
                                                            </button>
                                                        ` : ''}
                                                    </div>

                                                    ${!isDeleted ? `
                                                    <!-- Receiver Hover Action Capsule -->
                                                    <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xs border border-slate-200 dark:border-slate-700 rounded-full px-2 py-1 shadow-md shrink-0 select-none z-10">
                                                        <!-- Love / Like Reaction -->
                                                        <button type="button" onclick="toggleLikeMessage('${msg._id}')" title="${isLikedByMe ? 'Unlike' : 'React with Love'}" class="size-7.5 sm:size-8 rounded-full ${isLikedByMe ? 'text-rose-500 bg-rose-50 dark:bg-rose-950/40' : 'text-slate-500 dark:text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-700'} flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                            <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">favorite</span>
                                                        </button>
                                                        <!-- Copy -->
                                                        <button type="button" onclick="copyMessageContent('${msg._id}')" title="Copy text" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                            <span id="copy-icon-${msg._id}" class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">content_copy</span>
                                                        </button>
                                                        <!-- Reply -->
                                                        <button type="button" onclick="initiateStudentReply('${msg._id}', '${escapeJs(senderName)}', '${escapeJs(msgTextSnippet)}', '${escapeJs(fileType)}')" title="Reply" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                            <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">reply</span>
                                                        </button>
                                                        <!-- Three Dots Menu Button -->
                                                        <div class="relative inline-block">
                                                            <button type="button" onclick="toggleMessageMenu('${msg._id}', event)" title="More options" class="size-7.5 sm:size-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center transition-all cursor-pointer active:scale-90">
                                                                <span class="material-symbols-rounded text-lg sm:text-[19px] leading-none pointer-events-none">more_vert</span>
                                                            </button>
                                                            <!-- Dropdown Menu -->
                                                            <div id="msg-menu-${msg._id}" class="msg-action-menu hidden absolute left-0 top-full mt-1.5 w-44 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700 shadow-xl py-1 z-30 transition-all">
                                                                <button type="button" onclick="togglePinMessage('${msg._id}'); closeAllMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                    <span class="material-symbols-rounded text-base text-amber-500 leading-none">${msg.isPinned ? 'keep_off' : 'push_pin'}</span>
                                                                    <span>${msg.isPinned ? 'Unpin message' : 'Pin message'}</span>
                                                                </button>
                                                                <button type="button" onclick="deleteStudentMessage('${msg._id}', 'for_me'); closeAllMsgMenus();" class="w-full px-3 py-1.5 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-all cursor-pointer">
                                                                    <span class="material-symbols-rounded text-base text-slate-400 leading-none">delete_outline</span>
                                                                    <span>Delete for me</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    ` : ''}
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                }
                            });
                            container.innerHTML = html;

                            if (isFirstLoad || forceScroll || isNearBottom) {
                                container.scrollTop = container.scrollHeight;
                            }
                            isFirstLoad = false;
                        }
                    }
                } catch (err) {
                    console.error('Failed to load thread messages:', err);
                }
            }

            let currentThreadMessagesMap = {};
            let currentReplyTo = null;

            function escapeJs(str) {
                if (!str) return '';
                return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, ' ').replace(/\r/g, '');
            }

            function toggleMessageMenu(msgId, e) {
                if (e) e.stopPropagation();
                const menu = document.getElementById('msg-menu-' + msgId);
                if (!menu) return;
                const isHidden = menu.classList.contains('hidden');
                closeAllMsgMenus();
                if (isHidden) {
                    menu.classList.remove('hidden');
                }
            }
            window.toggleMessageMenu = toggleMessageMenu;

            function closeAllMsgMenus() {
                document.querySelectorAll('.msg-action-menu').forEach(m => m.classList.add('hidden'));
            }
            window.closeAllMsgMenus = closeAllMsgMenus;
            document.addEventListener('click', closeAllMsgMenus);

            async function toggleLikeMessage(msgId) {
                if (!msgId) return;
                try {
                    const res = await fetch('/api/messages/toggle-like', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messageId: msgId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await loadStudentThreadMessages(false);
                    }
                } catch (err) {
                    console.error('Failed to toggle like:', err);
                }
            }
            window.toggleLikeMessage = toggleLikeMessage;

            function copyMessageContent(msgId) {
                const msg = currentThreadMessagesMap[msgId];
                if (!msg) return;
                const textToCopy = msg.text || (msg.attachment ? msg.attachment.url : '');
                if (!textToCopy) return;

                navigator.clipboard.writeText(textToCopy).then(() => {
                    const icon = document.getElementById('copy-icon-' + msgId);
                    if (icon) {
                        const orig = icon.textContent;
                        icon.textContent = 'check';
                        icon.classList.add('text-emerald-500');
                        setTimeout(() => {
                            icon.textContent = orig;
                            icon.classList.remove('text-emerald-500');
                        }, 1500);
                    }
                }).catch(err => {
                    console.error('Copy failed:', err);
                });
            }
            window.copyMessageContent = copyMessageContent;

            function initiateStudentReply(msgId, senderName, text, fileType) {
                currentReplyTo = { messageId: msgId, senderName, text, fileType };
                const bar = document.getElementById('student-reply-preview-bar');
                const nameEl = document.getElementById('student-reply-sender-name');
                const textEl = document.getElementById('student-reply-text-preview');
                if (nameEl) nameEl.textContent = senderName;
                if (textEl) textEl.textContent = text || (fileType ? `[${fileType}]` : 'Attachment');
                if (bar) bar.classList.remove('hidden');

                const input = document.getElementById('student-msg-input');
                if (input) input.focus();
            }
            window.initiateStudentReply = initiateStudentReply;

            function cancelStudentReply() {
                currentReplyTo = null;
                const bar = document.getElementById('student-reply-preview-bar');
                if (bar) bar.classList.add('hidden');
            }
            window.cancelStudentReply = cancelStudentReply;

            async function deleteStudentMessage(msgId, type) {
                if (!msgId) return;
                if (type === 'for_everyone') {
                    if (!confirm('Are you sure you want to delete this message for everyone?')) return;
                }

                try {
                    const res = await fetch('/api/messages/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messageId: msgId, type })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await loadStudentThreadMessages(false);
                    } else {
                        alert(data.error || 'Failed to delete message');
                    }
                } catch (e) {
                    console.error('Delete error:', e);
                }
            }
            window.deleteStudentMessage = deleteStudentMessage;

            function scrollToMessage(msgId) {
                const el = document.getElementById('msg-' + msgId);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    el.classList.add('bg-amber-100/60', 'dark:bg-amber-950/40', 'ring-2', 'ring-amber-400');
                    setTimeout(() => {
                        el.classList.remove('bg-amber-100/60', 'dark:bg-amber-950/40', 'ring-2', 'ring-amber-400');
                    }, 2200);
                }
            }
            window.scrollToMessage = scrollToMessage;

            async function togglePinMessage(msgId) {
                if (!msgId) return;
                try {
                    const res = await fetch('/api/messages/toggle-pin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messageId: msgId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await loadStudentThreadMessages(false);
                    }
                } catch (err) {
                    console.error('Failed to toggle pin:', err);
                }
            }
            window.togglePinMessage = togglePinMessage;

            async function sendStudentMessage(e) {
                if (e && e.preventDefault) e.preventDefault();
                const input = document.getElementById('student-msg-input');
                const btn = document.getElementById('student-send-btn');
                const text = input ? input.value.trim() : '';

                if ((!text && !stagedStudentAttachment) || !activeTeacherId) return;

                if (input) input.value = '';
                if (btn) btn.disabled = true;

                const replyPayload = currentReplyTo;
                cancelStudentReply();

                try {
                    let res;
                    if (stagedStudentAttachment) {
                        const formData = new FormData();
                        formData.append('targetUserId', activeTeacherId);
                        if (text) formData.append('text', text);
                        formData.append('file', stagedStudentAttachment.file, stagedStudentAttachment.fileName);
                        if (stagedStudentAttachment.duration) formData.append('duration', stagedStudentAttachment.duration);
                        if (replyPayload) formData.append('replyTo', JSON.stringify(replyPayload));

                        res = await fetch('/api/messages/send', {
                            method: 'POST',
                            body: formData
                        });
                        clearStudentStagedAttachment();
                    } else {
                        res = await fetch('/api/messages/send', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                targetUserId: activeTeacherId,
                                text,
                                replyTo: replyPayload
                            })
                        });
                    }

                    const data = await res.json();
                    if (data.success) {
                        await loadStudentThreadMessages(true);
                    } else {
                        alert(data.error || 'Failed to send message.');
                    }
                } catch (err) {
                    console.error('Failed to send student message:', err);
                } finally {
                    if (btn) btn.disabled = false;
                    if (input) input.focus();
                }
            }
            window.sendStudentMessage = sendStudentMessage;

            function escapeHtml(unsafe) {
                return (unsafe || '')
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            if (activeTeacherId) {
                loadStudentThreadMessages();
                studentPollTimer = setInterval(loadStudentThreadMessages, 3000);
            }
        </script>
    <% } %>

    <%- include('partials/student-bottom-nav', { activePage: 'messages' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>