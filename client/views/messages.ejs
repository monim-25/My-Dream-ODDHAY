<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Instructor Messages | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'messages' }) %>
        
        <main class="flex-1 overflow-hidden p-2 sm:p-3 bg-[#f8fafc] dark:bg-[#0b1120] flex flex-col no-scrollbar">
            
            <% if (!locals.isEligible) { %>
                <!-- ================= LOCKED PREMIUM ACCESS SCREEN ================= -->
                <div class="flex-1 bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-2xl overflow-y-auto p-4 sm:p-8 flex flex-col items-center justify-center text-center shadow-xs no-scrollbar">
                    
                    <div class="size-16 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center mb-4 border border-amber-500/20 shadow-sm">
                        <span class="material-symbols-rounded text-3xl leading-none flex items-center justify-center select-none">lock</span>
                    </div>

                    <span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wider mb-2">
                        Premium Student Feature
                    </span>

                    <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-white max-w-md mb-1.5 leading-snug">
                        Direct Instructor Messaging
                    </h2>
                    
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md leading-relaxed mb-6 font-medium">
                        Personal 1-on-1 direct communication with expert course teachers is exclusively unlocked when you enroll in any paid course or academic package on ODDHAY.
                    </p>

                    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
                        <a href="/courses" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-xl text-xs font-bold transition-all shadow-md active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none">auto_stories</span>
                            Explore Courses & Packages
                        </a>
                        <a href="/dashboard" class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-all border border-slate-200 dark:border-slate-700">
                            Back to Dashboard
                        </a>
                    </div>

                    <!-- Platform Instructors Preview -->
                    <% if (locals.teachers && teachers.length > 0) { %>
                        <div class="w-full max-w-2xl pt-6 border-t border-slate-100 dark:border-slate-800/80">
                            <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">
                                Available Course Instructors
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
                                <% teachers.slice(0, 6).forEach(t => { %>
                                    <div class="p-2.5 rounded-xl bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 flex items-center gap-2.5 text-left opacity-75">
                                        <div class="size-9 rounded-xl bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= t.name %></h4>
                                            <p class="text-[9px] font-semibold text-primary truncate"><%= t.teachingSubject || t.designation || 'Instructor' %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                </div>

            <% } else { %>
                <!-- ================= UNLOCKED CHAT PORTAL ================= -->
                <div class="flex-1 bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 rounded-2xl overflow-hidden shadow-xs flex flex-col md:flex-row">
                    
                    <!-- Left Sidebar: Teacher Directory & Threads -->
                    <div class="w-full md:w-80 border-r border-slate-200/80 dark:border-slate-800/80 flex flex-col shrink-0 bg-slate-50/50 dark:bg-slate-900/40">
                        
                        <!-- Header & Search -->
                        <div class="p-3 border-b border-slate-200/80 dark:border-slate-800/80 space-y-2">
                            <div class="flex items-center justify-between">
                                <h2 class="text-xs font-bold text-slate-800 dark:text-white flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-primary text-base leading-none flex items-center justify-center shrink-0 select-none">school</span>
                                    Course Instructors
                                </h2>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                                    Verified Access
                                </span>
                            </div>

                            <div class="relative flex items-center">
                                <input type="text" id="teacher-search-input" oninput="filterTeacherList(this.value)" placeholder="Search instructor or subject..."
                                    class="w-full pl-7 pr-3 py-1.5 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg outline-none focus:border-primary text-slate-800 dark:text-slate-100 placeholder:text-slate-400 font-medium">
                                <span class="material-symbols-rounded absolute left-2 text-slate-400 text-xs leading-none flex items-center justify-center pointer-events-none select-none">search</span>
                            </div>
                        </div>

                        <!-- Teachers List -->
                        <div class="flex-1 overflow-y-auto p-2 space-y-1 no-scrollbar" id="teacher-contacts-list">
                            <% if (locals.recentConversations && recentConversations.length > 0) { %>
                                <% recentConversations.forEach(item => { %>
                                    <% const t = item.teacher; %>
                                    <% const isActive = locals.activeTeacher && activeTeacher._id.toString() === t._id.toString(); %>
                                    <div onclick="selectTeacherThread('<%= t._id %>')"
                                        data-teacher-name="<%= t.name.toLowerCase() %>"
                                        data-teacher-subject="<%= (t.teachingSubject || t.designation || '').toLowerCase() %>"
                                        class="teacher-contact-item p-2.5 rounded-xl cursor-pointer transition-all flex items-center gap-2.5 relative <%= isActive ? 'bg-primary/10 border border-primary/30 shadow-2xs' : 'hover:bg-slate-100/80 dark:hover:bg-slate-800/60 border border-transparent' %>">
                                        
                                        <!-- Avatar -->
                                        <div class="size-9 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>

                                        <!-- Teacher Info & Latest Msg -->
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center justify-between gap-1 mb-0.5">
                                                <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate <%= isActive ? 'text-primary dark:text-primary' : '' %>"><%= t.name %></h4>
                                                <% if (item.latestMessage) { %>
                                                    <span class="text-[9px] font-semibold text-slate-400 shrink-0">
                                                        <%= new Date(item.latestMessage.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="flex items-center justify-between gap-1">
                                                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate flex-1">
                                                    <%= item.latestMessage ? item.latestMessage.text : (t.teachingSubject ? t.teachingSubject + ' Teacher' : 'Instructor') %>
                                                </p>
                                                <% if (item.unreadCount > 0) { %>
                                                    <span class="size-4 rounded-full bg-rose-500 text-white text-[9px] font-black flex items-center justify-center shrink-0">
                                                        <%= item.unreadCount %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="flex items-center gap-1 mt-1">
                                                <span class="px-1.5 py-0.2 bg-primary/10 text-primary text-[8px] font-bold rounded">
                                                    <%= t.teachingSubject || t.designation || 'Instructor' %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else if (locals.teachers && teachers.length > 0) { %>
                                <% teachers.forEach(t => { %>
                                    <% const isActive = locals.activeTeacher && activeTeacher._id.toString() === t._id.toString(); %>
                                    <div onclick="selectTeacherThread('<%= t._id %>')"
                                        data-teacher-name="<%= t.name.toLowerCase() %>"
                                        data-teacher-subject="<%= (t.teachingSubject || t.designation || '').toLowerCase() %>"
                                        class="teacher-contact-item p-2.5 rounded-xl cursor-pointer transition-all flex items-center gap-2.5 relative <%= isActive ? 'bg-primary/10 border border-primary/30 shadow-2xs' : 'hover:bg-slate-100/80 dark:hover:bg-slate-800/60 border border-transparent' %>">
                                        
                                        <div class="size-9 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate <%= isActive ? 'text-primary dark:text-primary' : '' %>"><%= t.name %></h4>
                                            <span class="px-1.5 py-0.2 bg-primary/10 text-primary text-[8px] font-bold rounded inline-block mt-0.5">
                                                <%= t.teachingSubject || t.designation || 'Instructor' %>
                                            </span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="py-12 px-4 text-center">
                                    <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600 mb-1 leading-none flex items-center justify-center select-none">person_off</span>
                                    <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No instructors found</p>
                                    <p class="text-[10px] text-slate-400 mt-0.5">Active course teachers will appear here.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Right: Main Chat Stream Area -->
                    <div class="flex-1 flex flex-col bg-white dark:bg-[#0f172a] relative">
                        <% if (locals.activeTeacher) { %>
                            
                            <!-- Chat Header Bar -->
                            <div class="px-4 py-2.5 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between shrink-0 bg-slate-50/30 dark:bg-slate-900/20">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="size-9 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                        <% if (activeTeacher.profilePicture || activeTeacher.profileImage) { %>
                                            <img src="<%= activeTeacher.profilePicture || activeTeacher.profileImage %>" alt="<%= activeTeacher.name %>" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <span><%= activeTeacher.name[0].toUpperCase() %></span>
                                        <% } %>
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate"><%= activeTeacher.name %></h3>
                                        <div class="flex items-center gap-1.5 text-[10px] font-semibold text-slate-400">
                                            <span class="text-primary font-bold"><%= activeTeacher.teachingSubject || activeTeacher.designation || 'Instructor' %></span>
                                            <span>•</span>
                                            <span class="text-emerald-500 font-semibold flex items-center gap-1">
                                                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Available for Questions
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-bold flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-primary leading-none flex items-center justify-center shrink-0 select-none">verified</span>
                                        Verified Instructor
                                    </span>
                                </div>
                            </div>

                            <!-- Messages Stream Container -->
                            <div id="student-messages-stream" class="flex-1 overflow-y-auto p-4 space-y-3 no-scrollbar bg-[#fafafa] dark:bg-[#070d18]">
                                <div id="messages-loading" class="py-10 text-center text-xs font-semibold text-slate-400">
                                    Loading conversation...
                                </div>
                            </div>

                            <!-- Chat Input Box -->
                            <div class="p-3 border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#0f172a] shrink-0">
                                <form id="student-send-form" onsubmit="sendStudentMessage(event)" class="flex items-center gap-2">
                                    <input type="text" id="student-msg-input" 
                                        placeholder="Ask <%= activeTeacher.name %> a question... (Press Enter to send)"
                                        autocomplete="off"
                                        class="flex-1 px-3.5 py-2 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-100 rounded-xl outline-none focus:border-primary transition-all placeholder:text-slate-400">
                                    <button type="submit" id="student-send-btn"
                                        class="px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer active:scale-95">
                                        <span>Send</span>
                                        <span class="material-symbols-rounded text-sm leading-none flex items-center justify-center shrink-0 select-none">send</span>
                                    </button>
                                </form>
                            </div>

                        <% } else { %>
                            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-[#fafafa] dark:bg-[#070d18]">
                                <div class="size-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-3">
                                    <span class="material-symbols-rounded text-3xl leading-none flex items-center justify-center select-none">school</span>
                                </div>
                                <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-1">Select an Instructor</h3>
                                <p class="text-xs text-slate-400 max-w-sm">Choose an instructor from the left list to ask questions and receive personalized academic guidance.</p>
                            </div>
                        <% } %>
                    </div>

                </div>
            <% } %>

        </main>
    </div>

    <% if (locals.isEligible && locals.activeTeacher) { %>
        <script>
            const activeTeacherId = '<%= activeTeacher._id %>';
            const currentStudentId = '<%= user._id %>';
            let studentPollTimer = null;

            function selectTeacherThread(tId) {
                window.location.href = '/messages?teacherId=' + tId;
            }

            function filterTeacherList(query) {
                const q = (query || '').toLowerCase().trim();
                const items = document.querySelectorAll('.teacher-contact-item');
                items.forEach(item => {
                    const name = item.getAttribute('data-teacher-name') || '';
                    const sub = item.getAttribute('data-teacher-subject') || '';
                    if (!q || name.includes(q) || sub.includes(q)) {
                        item.style.display = 'flex';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            async function loadStudentThreadMessages() {
                if (!activeTeacherId) return;
                const container = document.getElementById('student-messages-stream');
                if (!container) return;

                try {
                    const res = await fetch('/api/messages/thread/' + activeTeacherId);
                    const data = await res.json();

                    if (data.success && Array.isArray(data.messages)) {
                        if (data.messages.length === 0) {
                            container.innerHTML = `
                                <div class="py-14 text-center">
                                    <span class="material-symbols-rounded text-4xl text-slate-300 dark:text-slate-600 mb-1.5 leading-none flex items-center justify-center select-none">chat</span>
                                    <h4 class="text-xs font-bold text-slate-700 dark:text-slate-200">Start asking your questions</h4>
                                    <p class="text-[10px] text-slate-400 mt-0.5">Send a message to receive guidance directly from your instructor.</p>
                                </div>
                            `;
                        } else {
                            let html = '';
                            data.messages.forEach(msg => {
                                const isMe = msg.sender.toString() === currentStudentId;
                                const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                                if (isMe) {
                                    html += `
                                        <div class="flex justify-end items-end gap-2 group">
                                            <div class="max-w-[78%] sm:max-w-[70%]">
                                                <div class="px-3.5 py-2.5 rounded-2xl rounded-br-none bg-primary text-white text-xs font-medium leading-relaxed shadow-sm">
                                                    ${escapeHtml(msg.text)}
                                                </div>
                                                <span class="text-[9px] font-semibold text-slate-400 text-right block mt-0.5 mr-1">${timeStr}</span>
                                            </div>
                                        </div>
                                    `;
                                } else {
                                    html += `
                                        <div class="flex justify-start items-end gap-2 group">
                                            <div class="size-6 rounded-lg bg-primary/20 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 shadow-2xs">
                                                ${(msg.senderName || 'T')[0].toUpperCase()}
                                            </div>
                                            <div class="max-w-[78%] sm:max-w-[70%]">
                                                <div class="px-3.5 py-2.5 rounded-2xl rounded-bl-none bg-white dark:bg-[#182234] border border-slate-200/80 dark:border-slate-700/80 text-slate-800 dark:text-slate-100 text-xs font-medium leading-relaxed shadow-2xs">
                                                    ${escapeHtml(msg.text)}
                                                </div>
                                                <span class="text-[9px] font-semibold text-slate-400 block mt-0.5 ml-1">${timeStr}</span>
                                            </div>
                                        </div>
                                    `;
                                }
                            });
                            container.innerHTML = html;
                            container.scrollTop = container.scrollHeight;
                        }
                    }
                } catch (err) {
                    console.error('Failed to load thread messages:', err);
                }
            }

            async function sendStudentMessage(e) {
                e.preventDefault();
                const input = document.getElementById('student-msg-input');
                const btn = document.getElementById('student-send-btn');
                const text = input ? input.value.trim() : '';

                if (!text || !activeTeacherId) return;

                input.value = '';
                if (btn) btn.disabled = true;

                try {
                    const res = await fetch('/api/messages/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ targetUserId: activeTeacherId, text })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await loadStudentThreadMessages();
                    } else {
                        alert(data.error || 'Failed to send message.');
                    }
                } catch (err) {
                    console.error('Failed to send student message:', err);
                } finally {
                    if (btn) btn.disabled = false;
                    if (input) input.focus();
                }
            }

            function escapeHtml(unsafe) {
                return (unsafe || '')
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            if (activeTeacherId) {
                loadStudentThreadMessages();
                studentPollTimer = setInterval(loadStudentThreadMessages, 3000);
            }
        </script>
    <% } %>

    <%- include('partials/student-bottom-nav', { activePage: 'messages' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>