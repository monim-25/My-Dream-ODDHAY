            function setMediaFilter(filter) {
                const sections = { media: 'full-media-section', docs: 'full-docs-section', voice: 'full-voice-section' };
                const btns = { all: 'filter-all-btn', media: 'filter-media-btn', docs: 'filter-docs-btn', voice: 'filter-voice-btn' };
                const active = 'bg-primary text-white shadow-sm';
                const inactive = 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700';
                Object.values(btns).forEach(id => {
                    const btn = document.getElementById(id);
                    if (btn) { btn.className = btn.className.replace(active, '').replace(inactive, '').trim() + ' ' + inactive + ' px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all cursor-pointer select-none'; }
                });
                const activeBtn = document.getElementById(btns[filter]);
                if (activeBtn) { activeBtn.className = 'px-3.5 py-1.5 rounded-full text-[11px] font-semibold transition-all cursor-pointer select-none ' + active; }
                Object.entries(sections).forEach(([key, id]) => {
                    const sec = document.getElementById(id);
                    if (sec) sec.classList.toggle('hidden', filter !== 'all' && filter !== key);
                });
            }
            window.setMediaFilter = setMediaFilter;

            let isCurrentTeacherBlockedByMe = false;
            let isCurrentTeacherBlockedByThem = false;

            function updateBlockUI(blockedByMe, blockedByThem) {
                isCurrentTeacherBlockedByMe = Boolean(blockedByMe);
                isCurrentTeacherBlockedByThem = Boolean(blockedByThem);

                const banner = document.getElementById('blocked-notice-banner');
                const bannerText = document.getElementById('blocked-notice-text');
                const bannerUnblockBtn = document.getElementById('banner-unblock-btn');
                const inputContainer = document.getElementById('student-input-container');
                const blockBtn = document.getElementById('details-block-btn');
                const blockBtnText = document.getElementById('details-block-btn-text');
                const blockBtnIcon = document.getElementById('details-block-btn-icon');

                if (isCurrentTeacherBlockedByMe) {
                    if (banner) {
                        banner.classList.remove('hidden');
                        if (bannerText) bannerText.textContent = 'You have blocked this instructor.';
                        if (bannerUnblockBtn) bannerUnblockBtn.classList.remove('hidden');
                    }
                    if (inputContainer) inputContainer.classList.add('hidden');
                    if (blockBtn) {
                        blockBtn.classList.remove('border-rose-200', 'dark:border-rose-900/50', 'bg-rose-50/50', 'dark:bg-rose-950/20', 'text-rose-600', 'dark:text-rose-400');
                        blockBtn.classList.add('border-slate-200', 'dark:border-slate-700', 'bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
                    }
                    if (blockBtnIcon) blockBtnIcon.textContent = 'lock_open';
                    if (blockBtnText) blockBtnText.textContent = 'Unblock Instructor';
                } else if (isCurrentTeacherBlockedByThem) {
                    if (banner) {
                        banner.classList.remove('hidden');
