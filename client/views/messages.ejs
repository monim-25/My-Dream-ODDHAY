    <% if (locals.isEligible) { %>
        <script>
            function toggleSidebar(forceShow) {
                const sidebar = document.getElementById('messages-sidebar');
                const chatToggleBtn = document.getElementById('chat-sidebar-toggle-btn');
                const emptyToggleBtn = document.getElementById('empty-sidebar-toggle-btn');
                if (!sidebar) return;

                let show;
                if (typeof forceShow === 'boolean') {
                    show = forceShow;
                } else {
                    const isCurrentlyHidden = sidebar.style.display === 'none' || window.getComputedStyle(sidebar).display === 'none';
                    show = isCurrentlyHidden;
                }

                if (show) {
                    sidebar.style.setProperty('display', 'flex', 'important');
                    if (chatToggleBtn) chatToggleBtn.style.setProperty('display', 'none', 'important');
                    if (emptyToggleBtn) emptyToggleBtn.style.setProperty('display', 'none', 'important');
                } else {
                    sidebar.style.setProperty('display', 'none', 'important');
                    if (chatToggleBtn) chatToggleBtn.style.setProperty('display', 'flex', 'important');
                    if (emptyToggleBtn) emptyToggleBtn.style.setProperty('display', 'flex', 'important');
                }
            }
            window.toggleSidebar = toggleSidebar;

            let activeTeacherId = '<%= locals.activeTeacher ? activeTeacher._id : "" %>';
            const currentStudentId = '<%= user._id %>';
            let studentPollTimer = null;

            const teachersDirectory = {
                <% (locals.teachers || []).forEach(t => { %>
                    '<%= t._id %>': {
                        name: <%- JSON.stringify(t.name || '') %>,
                        teachingSubject: <%- JSON.stringify(t.teachingSubject || '') %>,
                        profilePicture: <%- JSON.stringify(t.profilePicture || t.profileImage || '') %>
                    },
                <% }); %>
            };

            function selectTeacherThread(tId) {
                if (!tId) return;
                activeTeacherId = tId;
                isFirstLoad = true;
                prevMessagesSignature = '';

                // Update URL without reloading full page
                if (window.location.search !== '?teacherId=' + tId) {
                    window.history.pushState({ teacherId: tId }, '', '/messages?teacherId=' + tId);
                }

                // Update sidebar items highlight without page reload
                document.querySelectorAll('.teacher-contact-item').forEach(item => {
                    const itemId = item.getAttribute('data-teacher-id');
                    const nameEl = item.querySelector('.teacher-item-name');
                    if (itemId === tId) {
                        item.classList.add('bg-slate-200/90', 'dark:bg-slate-800', 'shadow-2xs');
                        item.classList.remove('hover:bg-slate-100/80', 'dark:hover:bg-slate-800/50');
                        if (nameEl) {
                            nameEl.classList.add('text-primary', 'dark:text-primary', 'font-bold');
                            nameEl.classList.remove('text-slate-700', 'dark:text-slate-200');
                        }
                        const badge = item.querySelector('.unread-badge');
                        if (badge) badge.remove();
                    } else {
                        item.classList.remove('bg-slate-200/90', 'dark:bg-slate-800', 'shadow-2xs');
                        item.classList.add('hover:bg-slate-100/80', 'dark:hover:bg-slate-800/50');
                        if (nameEl) {
                            nameEl.classList.remove('text-primary', 'dark:text-primary', 'font-bold');
                            nameEl.classList.add('text-slate-700', 'dark:text-slate-200');
                        }
                    }
                });

                // Update Active Chat Header
                const tData = teachersDirectory[tId];
                if (tData) {
                    const nameEl = document.getElementById('active-teacher-name');
                    if (nameEl) nameEl.textContent = tData.name;

                    const subEl = document.getElementById('active-teacher-subject');
                    const dotEl = document.getElementById('active-teacher-dot');
                    if (tData.teachingSubject) {
                        if (subEl) { subEl.textContent = tData.teachingSubject; subEl.classList.remove('hidden'); }
                        if (dotEl) dotEl.classList.remove('hidden');
                    } else {
                        if (subEl) subEl.classList.add('hidden');
                        if (dotEl) dotEl.classList.add('hidden');
                    }

                    const avatarEl = document.getElementById('active-teacher-avatar');
                    if (avatarEl) {
                        if (tData.profilePicture) {
                            avatarEl.innerHTML = `<img src="${escapeHtml(tData.profilePicture)}" alt="${escapeHtml(tData.name)}" class="w-full h-full object-cover">`;
                        } else {
                            avatarEl.innerHTML = `<span>${(tData.name || 'T')[0].toUpperCase()}</span>`;
                        }
                    }

                    const inputEl = document.getElementById('student-msg-input');
                    if (inputEl) inputEl.placeholder = `Ask ${tData.name} a question... (Press Enter to send)`;
                }

                // Update Details Panel Header & Avatar
                const detailsAvatar = document.getElementById('details-avatar');
                const detailsName = document.getElementById('details-name');
                if (tData) {
                    if (detailsName) detailsName.textContent = tData.name;
                    if (detailsAvatar) {
                        if (tData.profilePicture) {
                            detailsAvatar.innerHTML = `<img src="${escapeHtml(tData.profilePicture)}" alt="${escapeHtml(tData.name)}" class="w-full h-full object-cover">`;
                        } else {
                            detailsAvatar.innerHTML = `<span>${(tData.name || 'T')[0].toUpperCase()}</span>`;
                        }
                    }
                }

                // On mobile screens, automatically collapse sidebar when opening a thread
                if (window.innerWidth < 768) {
                    toggleSidebar(false);
                }

                // Show active chat container, hide empty placeholder
                const emptyBox = document.getElementById('empty-chat-placeholder');
                const activeBox = document.getElementById('active-chat-content');
                if (emptyBox) emptyBox.classList.add('hidden');
                if (activeBox) activeBox.classList.remove('hidden');

                const streamEl = document.getElementById('student-messages-stream');
                if (streamEl) streamEl.innerHTML = `<div class="py-10 text-center text-xs font-semibold text-slate-400">Loading conversation...</div>`;

                // Immediately load thread messages
                loadStudentThreadMessages(true);

                if (studentPollTimer) clearInterval(studentPollTimer);
                studentPollTimer = setInterval(() => loadStudentThreadMessages(false), 3000);
            }

            function toggleDetailsPanel(forceState) {
                const panel = document.getElementById('chat-details-panel');
                const infoBtn = document.getElementById('chat-details-toggle-btn');
                const sidebar = document.getElementById('messages-sidebar');
                const sidebarToggleBtn = document.getElementById('chat-sidebar-toggle-btn');
                const emptySidebarToggleBtn = document.getElementById('empty-sidebar-toggle-btn');
                if (!panel) return;

                let open;
                if (typeof forceState === 'boolean') {
                    open = forceState;
                } else {
                    open = panel.classList.contains('hidden');
                }

                if (open) {
                    panel.classList.remove('hidden');
                    if (infoBtn) infoBtn.style.setProperty('display', 'none', 'important');
                    // Auto hide instructors sidebar when details panel is opened
                    if (sidebar) sidebar.style.setProperty('display', 'none', 'important');
                    if (sidebarToggleBtn) sidebarToggleBtn.style.setProperty('display', 'flex', 'important');
                    if (emptySidebarToggleBtn) emptySidebarToggleBtn.style.setProperty('display', 'flex', 'important');
                } else {
                    panel.classList.add('hidden');
                    openAllPinnedView(false); // reset view when closed
                    if (infoBtn) infoBtn.style.removeProperty('display');
                    // Auto restore instructors sidebar when details panel is closed
                    if (sidebar) sidebar.style.removeProperty('display');
                    if (sidebarToggleBtn) sidebarToggleBtn.style.setProperty('display', 'none', 'important');
                    if (emptySidebarToggleBtn) emptySidebarToggleBtn.style.setProperty('display', 'none', 'important');
                }
            }
            window.toggleDetailsPanel = toggleDetailsPanel;

            function openAllPinnedView(show) {
                const mainView = document.getElementById('details-main-view');
                const pinnedView = document.getElementById('details-pinned-view');
                if (show) {
                    if (mainView) mainView.classList.add('hidden');
                    if (pinnedView) pinnedView.classList.remove('hidden');
                } else {
                    if (mainView) mainView.classList.remove('hidden');
                    if (pinnedView) pinnedView.classList.add('hidden');
