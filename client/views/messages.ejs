            function openAllMediaFilesView(show = true) {
                const mediaView  = document.getElementById('student-media-files-view');
                const msgStream  = document.getElementById('student-messages-stream');
                const chatHeader = document.getElementById('chat-header-bar');
                const bottomBar  = document.getElementById('student-bottom-bar');
                const sidebar    = document.getElementById('messages-sidebar');
                const detailsPanel = document.getElementById('chat-details-panel');

                if (!mediaView) return;

