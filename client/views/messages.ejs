<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Instructor Messages | ODDHAY</title>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'messages' }) %>
        
        <main class="flex-1 overflow-hidden p-0 bg-white dark:bg-[#0f172a] flex flex-col no-scrollbar">
            
            <% if (!locals.isEligible) { %>
                <!-- ================= LOCKED PREMIUM ACCESS SCREEN ================= -->
                <div class="flex-1 bg-white dark:bg-[#0f172a] overflow-y-auto p-4 sm:p-8 flex flex-col items-center justify-center text-center no-scrollbar">
                    
                    <div class="size-16 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center mb-4 border border-amber-500/20 shadow-sm">
                        <span class="material-symbols-rounded text-3xl leading-none flex items-center justify-center select-none">lock</span>
                    </div>

                    <span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wider mb-2">
                        Premium Student Feature
                    </span>

                    <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-white max-w-md mb-1.5 leading-snug">
                        Direct Instructor Messaging
                    </h2>
                    
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md leading-relaxed mb-6 font-medium">
                        Personal 1-on-1 direct communication with expert course teachers is exclusively unlocked when you enroll in any paid course or academic package on ODDHAY.
                    </p>

                    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
                        <a href="/courses" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-xl text-xs font-bold transition-all shadow-md active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-rounded text-base leading-none flex items-center justify-center select-none">auto_stories</span>
                            Explore Courses & Packages
                        </a>
                        <a href="/dashboard" class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-all border border-slate-200 dark:border-slate-700">
                            Back to Dashboard
                        </a>
                    </div>

                    <!-- Platform Instructors Preview -->
                    <% if (locals.teachers && teachers.length > 0) { %>
                        <div class="w-full max-w-2xl pt-6 border-t border-slate-100 dark:border-slate-800/80">
                            <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">
                                Available Course Instructors
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
                                <% teachers.slice(0, 6).forEach(t => { %>
                                    <div class="p-2.5 rounded-xl bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 flex items-center gap-2.5 text-left opacity-75">
                                        <div class="size-9 rounded-xl bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= t.name %></h4>
                                            <p class="text-[9px] font-semibold text-primary truncate"><%= t.teachingSubject || t.designation || 'Instructor' %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                </div>

            <% } else { %>
                <!-- ================= UNLOCKED CHAT PORTAL ================= -->
                <div class="flex-1 bg-white dark:bg-[#0f172a] overflow-hidden flex flex-col md:flex-row h-full">
                    
                    <!-- Left Sidebar: Teacher Directory & Threads -->
                    <div id="messages-sidebar" class="w-full md:w-80 border-r border-slate-200/80 dark:border-slate-800/80 flex flex-col shrink-0 bg-slate-50/50 dark:bg-slate-900/40 h-full">
                        
                        <!-- Search Box with Toggle Icon beside it -->
                        <div class="p-3 border-b border-slate-200/80 dark:border-slate-800/80 h-16 flex items-center gap-2 shrink-0">
                            <div class="relative flex items-center flex-1">
                                <input type="text" id="teacher-search-input" oninput="filterTeacherList(this.value)" placeholder="Search here..."
                                    class="w-full pl-9 pr-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl outline-none focus:border-primary text-slate-900 dark:text-white placeholder:text-slate-400 font-medium transition-all shadow-2xs">
                                <span class="material-symbols-rounded absolute left-3 text-slate-400 text-lg leading-none flex items-center justify-center pointer-events-none select-none">search</span>
                            </div>
                            <button type="button" 
                                onclick="const s=document.getElementById('messages-sidebar'), b=document.getElementById('chat-sidebar-toggle-btn'), e=document.getElementById('empty-sidebar-toggle-btn'); if(s) s.style.setProperty('display','none','important'); if(b) b.style.setProperty('display','flex','important'); if(e) e.style.setProperty('display','flex','important');" 
                                id="sidebar-toggle-search-btn" title="Hide Instructors" 
                                class="size-10 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center shrink-0 transition-all cursor-pointer shadow-2xs select-none active:scale-95">
                                <span class="material-symbols-rounded text-xl leading-none pointer-events-none">dock_to_left</span>
                            </button>
                        </div>

                        <!-- Teachers List -->
                        <div class="flex-1 overflow-y-auto p-2 space-y-1.5 no-scrollbar" id="teacher-contacts-list">
                            <% if (locals.recentConversations && recentConversations.length > 0) { %>
                                <% recentConversations.forEach(item => { %>
                                    <% const t = item.teacher; %>
                                    <% const isActive = locals.activeTeacher && activeTeacher._id.toString() === t._id.toString(); %>
                                    <div onclick="selectTeacherThread('<%= t._id %>')"
                                        data-teacher-id="<%= t._id %>"
                                        data-teacher-name="<%= t.name.toLowerCase() %>"
                                        data-teacher-subject="<%= (t.teachingSubject || t.designation || '').toLowerCase() %>"
                                        class="teacher-contact-item p-3 rounded-xl cursor-pointer transition-all flex items-center gap-3 relative <%= isActive ? 'bg-slate-200/90 dark:bg-slate-800 shadow-2xs' : 'hover:bg-slate-100/80 dark:hover:bg-slate-800/50' %>">
                                        
                                        <!-- Avatar -->
                                        <div class="size-10 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>

                                        <!-- Teacher Info & Latest Msg -->
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center justify-between gap-1 mb-1">
                                                <h4 class="teacher-item-name text-sm font-semibold tracking-tight antialiased truncate <%= isActive ? 'text-primary dark:text-primary font-bold' : 'text-slate-700 dark:text-slate-200' %>"><%= t.name %></h4>
                                                <% if (item.latestMessage) { %>
                                                    <span class="text-[10px] font-semibold text-slate-400 shrink-0">
                                                        <%= new Date(item.latestMessage.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="flex items-center justify-between gap-2">
                                                <p class="text-xs <%= item.unreadCount > 0 ? 'text-slate-800 dark:text-slate-100 font-semibold' : 'text-slate-500 dark:text-slate-400 font-medium' %> truncate flex-1 leading-snug">
                                                    <%= item.latestMessage ? item.latestMessage.text : 'Available for asking' %>
                                                </p>
                                                <% if (item.unreadCount > 0) { %>
                                                    <span class="unread-badge size-5 rounded-full bg-[#E3E2E6] dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-[11px] font-bold flex items-center justify-center shrink-0 leading-none antialiased">
                                                        <%= item.unreadCount %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <% if (t.teachingSubject) { %>
                                                <div class="flex items-center gap-1 mt-1.5">
                                                    <span class="px-2 py-0.5 bg-primary/10 text-primary text-[9px] font-bold rounded-md">
                                                        <%= t.teachingSubject %>
                                                    </span>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else if (locals.teachers && teachers.length > 0) { %>
                                <% teachers.forEach(t => { %>
                                    <% const isActive = locals.activeTeacher && activeTeacher._id.toString() === t._id.toString(); %>
                                    <div onclick="selectTeacherThread('<%= t._id %>')"
                                        data-teacher-id="<%= t._id %>"
                                        data-teacher-name="<%= t.name.toLowerCase() %>"
                                        data-teacher-subject="<%= (t.teachingSubject || t.designation || '').toLowerCase() %>"
                                        class="teacher-contact-item p-3 rounded-xl cursor-pointer transition-all flex items-center gap-3 relative <%= isActive ? 'bg-slate-200/90 dark:bg-slate-800 shadow-2xs' : 'hover:bg-slate-100/80 dark:hover:bg-slate-800/50' %>">
                                        
                                        <div class="size-10 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                            <% if (t.profilePicture || t.profileImage) { %>
                                                <img src="<%= t.profilePicture || t.profileImage %>" alt="<%= t.name %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span><%= t.name ? t.name[0].toUpperCase() : 'T' %></span>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h4 class="teacher-item-name text-sm font-semibold tracking-tight antialiased truncate <%= isActive ? 'text-primary dark:text-primary font-bold' : 'text-slate-700 dark:text-slate-200' %>"><%= t.name %></h4>
                                            <% if (t.teachingSubject) { %>
                                                <span class="px-2 py-0.5 bg-primary/10 text-primary text-[9px] font-bold rounded-md inline-block mt-1">
                                                    <%= t.teachingSubject %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="py-12 px-4 text-center">
                                    <span class="material-symbols-rounded text-3xl text-slate-300 dark:text-slate-600 mb-1 leading-none flex items-center justify-center select-none">person_off</span>
                                    <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No instructors found</p>
                                    <p class="text-[10px] text-slate-400 mt-0.5">Active course teachers will appear here.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Right: Main Chat Stream Area & Details Panel -->
                    <div class="flex-1 flex flex-row overflow-hidden h-full relative">
                        
                        <!-- Chat Stream Area -->
                        <div class="flex-1 flex flex-col bg-white dark:bg-[#0f172a] relative h-full min-w-0">
                            <!-- Active Chat Container -->
                            <div id="active-chat-content" class="flex-1 flex flex-col h-full <%= locals.activeTeacher ? '' : 'hidden' %>">
                                <!-- Chat Header Bar -->
                                <div id="chat-header-bar" class="px-4 py-2.5 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between shrink-0 bg-slate-50/30 dark:bg-slate-900/20 h-16">
                                    <!-- Left: Toggle Back Button & Teacher Info -->
                                    <div class="flex items-center gap-3 min-w-0">
                                        <button type="button" 
                                            onclick="const s=document.getElementById('messages-sidebar'), b=document.getElementById('chat-sidebar-toggle-btn'), e=document.getElementById('empty-sidebar-toggle-btn'); if(s) s.style.removeProperty('display'); if(b) b.style.setProperty('display','none','important'); if(e) e.style.setProperty('display','none','important');" 
                                            id="chat-sidebar-toggle-btn" title="Show Instructors" style="display: none;" 
                                            class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200/80 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 items-center justify-center shrink-0 transition-all cursor-pointer select-none shadow-2xs active:scale-95">
                                            <span class="material-symbols-rounded text-xl leading-none pointer-events-none">view_sidebar</span>
                                        </button>

                                        <div id="active-teacher-avatar" class="size-10 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                            <% if (locals.activeTeacher && (activeTeacher.profilePicture || activeTeacher.profileImage)) { %>
                                                <img src="<%= activeTeacher.profilePicture || activeTeacher.profileImage %>" alt="<%= activeTeacher.name %>" class="w-full h-full object-cover">
                                            <% } else if (locals.activeTeacher) { %>
                                                <span><%= activeTeacher.name[0].toUpperCase() %></span>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0">
                                            <h3 id="active-teacher-name" class="text-[14.5px] sm:text-[15.5px] font-semibold text-slate-800 dark:text-slate-100 tracking-tight antialiased leading-snug truncate"><%= locals.activeTeacher ? activeTeacher.name : '' %></h3>
                                            <div class="flex items-center gap-1.5 mt-0.5">
                                                <span id="active-teacher-subject" class="text-[11.5px] font-semibold text-primary dark:text-primary tracking-tight antialiased <%= (locals.activeTeacher && activeTeacher.teachingSubject) ? '' : 'hidden' %>"><%= locals.activeTeacher ? (activeTeacher.teachingSubject || '') : '' %></span>
                                                <span id="active-teacher-dot" class="text-slate-300 dark:text-slate-600 text-[10px] <%= (locals.activeTeacher && activeTeacher.teachingSubject) ? '' : 'hidden' %>">•</span>
                                                <span class="text-[11.5px] font-medium text-emerald-600 dark:text-emerald-400 tracking-tight antialiased flex items-center gap-1.5">
                                                    <span class="size-1.5 rounded-full bg-emerald-500 shrink-0"></span> Available for Questions
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right: Info Button -->
                                    <div class="flex items-center gap-2 shrink-0">
                                        <button type="button" onclick="toggleDetailsPanel()" id="chat-details-toggle-btn" title="Details & Options" class="size-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200/80 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 transition-all cursor-pointer select-none shadow-2xs active:scale-95">
                                            <span class="material-symbols-rounded text-xl leading-none pointer-events-none">info</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Messages Stream Container -->
                                <div id="student-messages-stream" class="flex-1 overflow-y-auto p-4 space-y-3 no-scrollbar bg-[#fafafa] dark:bg-[#070d18]">
                                    <div id="messages-loading" class="py-10 text-center text-xs font-semibold text-slate-400">
                                        Loading conversation...
                                    </div>
                                </div>

                                <!-- Bottom Input Area Wrapper (hidden when media view is open) -->
                                <div id="student-bottom-bar" class="shrink-0">

                                <!-- Blocked Notice Banner -->
                                <div id="blocked-notice-banner" class="hidden px-4 py-2.5 border-t border-rose-200 dark:border-rose-900/50 bg-rose-50/80 dark:bg-rose-950/40 flex items-center justify-between gap-3 shrink-0">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="material-symbols-rounded text-base text-rose-500 leading-none shrink-0 flex items-center justify-center select-none">block</span>
                                        <span id="blocked-notice-text" class="text-xs font-semibold text-rose-700 dark:text-rose-300 truncate">You have blocked this instructor.</span>
                                    </div>
                                    <button type="button" id="banner-unblock-btn" onclick="openBlockModal()" class="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs transition-all cursor-pointer shadow-2xs active:scale-95 flex items-center gap-1.5 shrink-0 select-none">
                                        <span class="material-symbols-rounded text-sm leading-none pointer-events-none">lock_open</span>
                                        <span class="pointer-events-none">Unblock</span>
                                    </button>
                                </div>

                                <!-- Staged Attachment Preview Bar -->
                                <div id="student-staged-attachment-bar" class="px-4 py-2.5 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div id="student-staged-thumb-box" class="size-10 rounded-xl bg-[#0084FF]/10 text-[#0084FF] flex items-center justify-center shrink-0 overflow-hidden border border-[#0084FF]/20">
                                            <span id="student-staged-icon" class="material-symbols-rounded text-xl leading-none">attach_file</span>
                                            <img id="student-staged-img" class="w-full h-full object-cover hidden" alt="Preview">
                                        </div>
                                        <div class="min-w-0">
                                            <div id="student-staged-name" class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">attachment.jpg</div>
                                            <div id="student-staged-size" class="text-[10px] font-medium text-slate-400">0 KB</div>
                                        </div>
                                    </div>
                                    <button type="button" onclick="clearStudentStagedAttachment()" title="Remove Attachment" class="size-7 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95">
                                        <span class="material-symbols-rounded text-base leading-none">close</span>
                                    </button>
                                </div>

                                <!-- Live Voice Recording Bar -->
                                <div id="student-voice-recording-bar" class="px-3.5 py-2 bg-rose-50/80 dark:bg-rose-950/40 border-t border-rose-200/70 dark:border-rose-900/50 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2">
                                        <div class="size-2.5 rounded-full bg-rose-500 animate-pulse"></div>
                                        <span class="text-xs font-semibold text-rose-600 dark:text-rose-400">Recording voice...</span>
                                        <span id="student-voice-timer" class="text-xs font-mono font-bold text-slate-700 dark:text-slate-200 ml-0.5">0:00</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <button type="button" onclick="cancelStudentVoiceRecording()" title="Cancel Recording" class="px-2.5 py-1.5 rounded-xl hover:bg-rose-100 dark:hover:bg-rose-900/40 text-rose-600 dark:text-rose-400 text-xs font-semibold flex items-center gap-1 cursor-pointer transition-all active:scale-95 select-none">
                                            <span class="material-symbols-rounded text-base leading-none">delete</span>
                                            <span>Cancel</span>
                                        </button>
                                        <button type="button" onclick="finishStudentVoiceRecording(false)" title="Attach Voice Note to Message" class="px-3 py-1.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-semibold flex items-center gap-1 cursor-pointer transition-all shadow-2xs active:scale-95 select-none">
                                            <span class="material-symbols-rounded text-base leading-none">attach_file</span>
                                            <span>Attach</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Staged Reply Preview Bar -->
                                <div id="student-reply-preview-bar" class="px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-3 hidden transition-all">
                                    <div class="flex items-center gap-2.5 min-w-0 border-l-2 border-primary pl-2.5">
                                        <span class="material-symbols-rounded text-base text-primary leading-none shrink-0">reply</span>
                                        <div class="min-w-0">
                                            <div class="text-[11px] font-bold text-primary truncate">Replying to <span id="student-reply-sender-name">User</span></div>
                                            <div id="student-reply-text-preview" class="text-[11px] text-slate-600 dark:text-slate-300 truncate">Message snippet</div>
                                        </div>
                                    </div>
                                    <button type="button" onclick="cancelStudentReply()" title="Cancel Reply" class="size-7 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all cursor-pointer select-none active:scale-95">
                                        <span class="material-symbols-rounded text-base leading-none pointer-events-none">close</span>
                                    </button>
                                </div>

                                <!-- Chat Input Box -->
                                <div id="student-input-container" class="p-2.5 sm:p-3 border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#0f172a] shrink-0">
                                    <form id="student-send-form" onsubmit="sendStudentMessage(event)" class="flex items-center gap-1.5 sm:gap-2">
                                        <!-- Hidden File Input -->
                                        <input type="file" id="student-file-input" onchange="handleStudentFileSelect(event)" class="hidden" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.xlsx,.pptx">

                                        <!-- Attachment Button -->
                                        <button type="button" onclick="document.getElementById('student-file-input').click()" title="Attach File"
                                            class="size-10 rounded-xl bg-slate-100 hover:bg-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-all flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none shadow-2xs">
                                            <span class="material-symbols-rounded text-[21px] leading-none pointer-events-none">attach_file</span>
                                        </button>

                                        <!-- Camera Button -->
                                        <button type="button" onclick="openStudentCameraModal()" title="Capture Camera / Video"
                                            class="size-10 rounded-xl bg-slate-100 hover:bg-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-all flex items-center justify-center shrink-0 cursor-pointer active:scale-95 select-none shadow-2xs">
                                            <span class="material-symbols-rounded text-[21px] leading-none pointer-events-none">photo_camera</span>
                                        </button>

                                        <!-- Text Input Box (Balanced comfortable size) -->
                                        <input type="text" id="student-msg-input" 
                                            placeholder="<%= locals.activeTeacher ? ('Ask ' + activeTeacher.name + ' a question...') : 'Ask a question...' %>"
                                            autocomplete="off"
                                            class="flex-1 min-h-[42px] sm:min-h-[44px] px-3.5 sm:px-4 py-2 bg-slate-100/90 dark:bg-slate-800/90 border border-slate-200/90 dark:border-slate-700 text-xs sm:text-[13px] font-medium text-slate-800 dark:text-slate-100 rounded-xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-slate-400 shadow-2xs">

                                        <!-- Mic Voice Recording Button -->
                                        <button type="button" id="student-mic-btn" onclick="startStudentVoiceRecording()" title="Record Voice Message"
