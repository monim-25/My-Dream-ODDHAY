<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Student Profile | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-full flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'profile' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <% const u = locals.user || {}; %>

            <!-- SUCCESS BANNER -->
            <% if (locals.success) { %>
                <div id="successBanner" class="m-3 sm:m-4 p-3 sm:p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-200 flex items-center justify-between text-xs sm:text-sm font-medium shadow-xs">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-rounded text-emerald-600 dark:text-emerald-400 text-lg leading-none">check_circle</span>
                        <span>Profile updated successfully!</span>
                    </div>
                    <button type="button" onclick="document.getElementById('successBanner').remove()" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors rounded-md" aria-label="Dismiss">
                        <span class="material-symbols-rounded text-base leading-none">close</span>
                    </button>
                </div>
            <% } %>

            <!-- 1. HERO IDENTITY CARD -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-3.5 sm:p-5 relative overflow-hidden">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3.5 sm:gap-4 w-full">
                    <!-- Avatar & Info Side by Side -->
                    <div class="flex items-center gap-3 sm:gap-4 w-full md:flex-1 min-w-0">
                        <!-- Circle Avatar with Quick Edit Button -->
                        <div class="relative shrink-0">
                            <div class="size-16 sm:size-20 rounded-full border-2 border-primary/30 overflow-hidden bg-slate-100 dark:bg-slate-800 shadow-xs ring-2 ring-white dark:ring-slate-900">
                                <img src="<%= (u.profileImage || u.profilePicture) ? (u.profileImage || u.profilePicture) : (u.name ? `https://ui-avatars.com/api/?name=${encodeURIComponent(u.name)}&background=random&size=144` : '/default-avatar.png') %>" class="w-full h-full object-cover" alt="Profile Avatar">
                            </div>
                            <a href="/profile/edit" class="absolute bottom-0 right-0 size-6 sm:size-6.5 bg-primary text-white rounded-full shadow flex items-center justify-center hover:scale-110 active:scale-95 transition-transform ring-2 ring-white dark:ring-slate-900" title="Edit Avatar">
                                <span class="material-symbols-rounded text-xs sm:text-sm flex items-center justify-center leading-none">edit</span>
                            </a>
                        </div>

                        <!-- Info Column -->
                        <div class="flex flex-col flex-1 min-w-0 gap-1 sm:gap-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <h1 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white leading-tight truncate">
                                    <%= u.name || 'Student' %>
                                </h1>
                            </div>

                            <!-- Stat Chips -->
                            <div class="flex flex-wrap items-center gap-1.5">
                                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-[#F43F5E] font-semibold text-[11px] leading-tight">
                                    <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center">school</span>
                                    <span><%= (u.classLevel && (u.classLevel.toString().toLowerCase().startsWith('class') || u.classLevel.toString().toLowerCase().startsWith('hsc'))) ? u.classLevel : ('Class ' + (u.classLevel || '10')) %></span>
                                </div>
                                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-600 dark:text-amber-400 font-semibold text-[11px] leading-tight">
                                    <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center text-amber-500">local_fire_department</span>
                                    <span><%= u.streak || 0 %> Day Streak</span>
                                </div>
                                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold text-[11px] leading-tight">
                                    <span>ID: #<%= u._id ? u._id.toString().slice(-6).toUpperCase() : 'N/A' %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2 shrink-0 w-full md:w-auto pt-0.5 sm:pt-0">
                        <a href="/profile/edit" class="flex-1 md:flex-initial h-10 px-4 bg-primary hover:bg-primary/90 active:scale-[0.98] text-white rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 shadow-sm shadow-primary/20 transition-all">
                            <span class="material-symbols-rounded text-base sm:text-lg flex items-center justify-center leading-none">edit_note</span>
                            <span>Edit Profile</span>
                        </a>
                        <a href="/profile/security" class="flex-1 md:flex-initial h-10 px-4 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 active:scale-[0.98] text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700/80 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 transition-all">
                            <span class="material-symbols-rounded text-base sm:text-lg flex items-center justify-center leading-none">shield</span>
                            <span>Security & Devices</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 2. ACADEMIC STATS GRID -->
            <div class="w-full bg-slate-50/50 dark:bg-[#0b1120]/50 border-b border-slate-200/80 dark:border-slate-800/80 p-3 sm:p-4">
                <% const statsItems = [ 
                    { t: 'Total Exams', v: u.quizResults ? u.quizResults.length : 0, i: 'quiz', c: 'text-blue-500 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20' }, 
                    { t: 'Average Score', v: locals.avgScore || '0%', i: 'star', c: 'text-amber-500 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20' }, 
                    { t: 'Enrolled Courses', v: u.enrolledCourses ? u.enrolledCourses.length : 0, i: 'library_books', c: 'text-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200/60 dark:border-emerald-500/20' }, 
                    { t: 'Completed Lessons', v: u.completedLessons ? u.completedLessons.length : 0, i: 'task_alt', c: 'text-indigo-500 bg-indigo-50 dark:bg-indigo-500/10 border-indigo-200/60 dark:border-indigo-500/20' } 
                ]; %>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
                    <% statsItems.forEach(s => { %>
                        <div class="p-3 sm:p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200/80 dark:border-slate-800/80 shadow-2xs flex items-center gap-2.5 sm:gap-3">
                            <div class="size-9 sm:size-10 rounded-xl flex items-center justify-center border shrink-0 <%= s.c %>">
                                <span class="material-symbols-rounded text-lg sm:text-xl leading-none flex items-center justify-center"><%= s.i %></span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <h4 class="text-base sm:text-xl font-bold text-slate-800 dark:text-white leading-tight mb-0.5 truncate"><%= s.v %></h4>
                                <p class="text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400 truncate"><%= s.t %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- 3 & 4. PERSONAL & GUARDIAN INFORMATION GRID -->
            <div class="grid grid-cols-1 lg:grid-cols-2 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-y lg:divide-y-0 lg:divide-x divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a]">
                
                <!-- Personal & Academic Information Section -->
                <div class="w-full p-3.5 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary text-lg flex items-center justify-center leading-none">account_circle</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Personal & Academic Information</h3>
                        </div>
                        <a href="/profile/edit" class="px-2.5 py-1 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold flex items-center gap-1 transition-colors active:scale-95">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">edit</span>
                            <span>Edit</span>
                        </a>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5">
                        <!-- Email Address -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">alternate_email</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Email Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" title="<%= u.email || '' %>"><%= u.email || 'Not provided' %></p>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">call</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Phone Number</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.phone || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Class Level -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">school</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Class</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.classLevel || 'Class 10' %></p>
                            </div>
                        </div>

                        <!-- School Name -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">domain</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">School Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" title="<%= u.schoolName || '' %>"><%= u.schoolName || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- College Name -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">apartment</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">College Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" title="<%= u.collegeName || '' %>"><%= u.collegeName || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Joined Date -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">calendar_month</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Joined Date</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate">
                                    <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %>
                                </p>
                            </div>
                        </div>

                        <!-- Present Address -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5 sm:col-span-2">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">home_pin</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Present Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" title="<%= u.presentAddress || '' %>"><%= u.presentAddress || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Permanent Address -->
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5 sm:col-span-2">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">location_city</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Permanent Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate" title="<%= u.permanentAddress || '' %>"><%= u.permanentAddress || 'Not added' %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guardian Information Section -->
                <div class="w-full p-3.5 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg flex items-center justify-center leading-none">family_restroom</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Guardian Information</h3>
                        </div>
                        <a href="/guardian" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold flex items-center gap-1 transition-colors active:scale-95">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">visibility</span>
                            <span>Manage</span>
                        </a>
                    </div>
                    <% const hasGuardian = u && (u.guardianName || u.guardianPhone); %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5">
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">person</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Guardian Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.guardianName || 'Not added' %></p>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">phone_enabled</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Guardian Phone</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.guardianPhone || 'Not added' %></p>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5 sm:col-span-2">
                            <div class="size-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center <%= hasGuardian ? 'text-emerald-500' : 'text-slate-400' %> shrink-0 shadow-2xs">
                                <span class="material-symbols-rounded text-base leading-none">security</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Parental Access Status</p>
                                <% if (hasGuardian) { %>
                                    <div class="flex items-center gap-1.5 mt-0.5">
                                        <span class="size-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
                                        <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 truncate">Active Parental Link</p>
                                    </div>
                                <% } else { %>
                                    <div class="flex items-center justify-between gap-2 mt-0.5">
                                        <p class="text-xs font-bold text-rose-500 dark:text-rose-400 truncate">Inactive (No Guardian Linked)</p>
                                        <a href="/guardian" class="text-[11px] font-bold text-primary hover:underline shrink-0">Link Now</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. QUICK ACTIONS GRID -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-3.5 sm:p-5">
                <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3">
                    <span class="material-symbols-rounded text-amber-500 text-lg flex items-center justify-center leading-none">bolt</span>
                    <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Quick Actions</h3>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                    <% const quickActions = [ 
                        { t: 'Student ID Card', sub: 'Digital Identity', l: '/id-card', i: 'badge', c: 'text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-500/10 border-purple-200/60 dark:border-purple-500/20' }, 
                        { t: 'Progress Report', sub: 'Academic Analytics', l: '/progress-report', i: 'assignment_turned_in', c: 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20' }, 
                        { t: 'Guardian Portal', sub: 'Family Link', l: '/guardian', i: 'family_restroom', c: 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200/60 dark:border-emerald-500/20' }, 
                        { t: 'Payment History', sub: 'Billing & Receipts', l: '/my-payments', i: 'payments', c: 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20' } 
                    ]; %>
                    <% quickActions.forEach(a => { %>
                        <a href="<%= a.l %>" class="flex flex-col items-center p-3 rounded-xl bg-slate-50/80 dark:bg-slate-800/40 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all border border-slate-200/70 dark:border-slate-700/60 group text-center active:scale-[0.98]">
                            <div class="size-10 rounded-xl flex items-center justify-center border shrink-0 mb-1.5 <%= a.c %> group-hover:scale-105 transition-transform">
                                <span class="material-symbols-rounded text-xl leading-none flex items-center justify-center"><%= a.i %></span>
                            </div>
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-tight truncate w-full"><%= a.t %></span>
                            <span class="text-[10px] font-medium text-slate-400 mt-0.5 truncate w-full"><%= a.sub %></span>
                        </a>
                    <% }) %>
                </div>
            </div>

            <!-- Safe clearance for mobile bottom navigation -->
            <div class="h-24 sm:h-28 lg:h-8 w-full shrink-0"></div>
        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'profile' }) %>
