<!DOCTYPE html>
<html lang="en" class="<%= locals.user && user.theme === 'dark' ? 'dark' : '' %>">
<head>
    <%- include('partials/head') %>
    <%- include('partials/app-styles') %>
    <title>Student Profile | ODDHAY</title>
</head>

<body class="bg-[#FFFFFF] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 font-sans h-[100dvh] w-screen flex flex-col transition-colors duration-300 overflow-hidden">
    <%- include('partials/student-header') %>

    <div class="flex-1 flex overflow-hidden w-full relative">
        <%- include('partials/student-sidebar', { activePage: 'profile' }) %>

        <main class="flex-1 w-full overflow-y-auto p-0 m-0 space-y-0 no-scrollbar bg-[#FFFFFF] dark:bg-[#0b1120] relative">
            
            <% const u = locals.user || {}; %>

            <!-- 1. HERO IDENTITY CARD (ATTACHED FLUSH TO SIDEBAR & NAVBAR) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5 shadow-none relative overflow-hidden">
                <div class="flex flex-col md:flex-row items-center justify-between gap-3.5 w-full">
                    <!-- Avatar & Info Side by Side -->
                    <div class="flex items-center gap-3.5 sm:gap-4 w-full md:flex-1 min-w-0">
                        <!-- Circle Avatar with Quick Edit Button -->
                        <div class="relative shrink-0">
                            <div class="relative size-16 sm:size-20 rounded-full border-2 border-primary/30 overflow-hidden bg-slate-100 dark:bg-slate-800 shadow-xs ring-2 ring-white dark:ring-slate-900">
                                <img src="<%= (u.profileImage || u.profilePicture) ? (u.profileImage || u.profilePicture) : (u.name ? `https://ui-avatars.com/api/?name=${encodeURIComponent(u.name)}&background=random&size=144` : '/default-avatar.png') %>" class="w-full h-full object-cover" alt="Profile Avatar">
                            </div>
                            <a href="/profile/edit" class="absolute bottom-0 right-0 size-6 bg-primary text-white rounded-full shadow flex items-center justify-center hover:scale-110 transition-transform ring-2 ring-white dark:ring-slate-900" title="Edit Avatar">
                                <span class="material-symbols-rounded text-xs flex items-center justify-center leading-none">edit</span>
                            </a>
                        </div>

                        <!-- Info Column -->
                        <div class="flex flex-col flex-1 min-w-0 gap-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h1 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white leading-tight truncate">
                                    <%= u.name || 'Student' %>
                                </h1>
                                <span class="px-2 py-0.5 rounded-md bg-primary/10 text-primary text-[10px] font-bold border border-primary/20">
                                    Student Profile
                                </span>
                            </div>

                            <!-- Stat Chips -->
                            <div class="flex flex-wrap items-center gap-1.5">
                                <div class="flex items-center gap-1 px-2.5 py-0.5 rounded bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-[#F43F5E] font-semibold text-[11px]">
                                    <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center">school</span>
                                    <span><%= (u.classLevel && (u.classLevel.toString().toLowerCase().startsWith('class') || u.classLevel.toString().toLowerCase().startsWith('hsc'))) ? u.classLevel : ('Class ' + (u.classLevel || '10')) %></span>
                                </div>
                                <div class="flex items-center gap-1 px-2.5 py-0.5 rounded bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-600 dark:text-amber-400 font-semibold text-[11px]">
                                    <span class="material-symbols-rounded text-xs leading-none flex items-center justify-center text-amber-500">local_fire_department</span>
                                    <span><%= u.streak || 0 %> Day Streak</span>
                                </div>
                                <div class="flex items-center gap-1 px-2.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold text-[11px]">
                                    <span>ID: #<%= u._id ? u._id.toString().slice(-6).toUpperCase() : 'N/A' %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2 shrink-0 w-full md:w-auto">
                        <a href="/profile/edit" class="flex-1 md:flex-initial px-4 py-2 bg-primary hover:bg-primary/90 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition-all">
                            <span class="material-symbols-rounded text-base flex items-center justify-center leading-none">edit_note</span> Edit Profile
                        </a>
                        <a href="/profile/security" class="flex-1 md:flex-initial px-4 py-2 bg-slate-800 hover:bg-slate-900 dark:bg-slate-800 dark:hover:bg-slate-700 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition-all">
                            <span class="material-symbols-rounded text-base flex items-center justify-center leading-none">shield</span> Security & Devices
                        </a>
                    </div>
                </div>
            </div>

            <!-- 2. ACADEMIC STATS GRID (ATTACHED FLUSH) -->
            <div class="grid grid-cols-2 lg:grid-cols-4 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-x divide-y lg:divide-y-0 divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a]">
                <% const statsItems = [ 
                    { t: 'Total Exams', v: u.quizResults ? u.quizResults.length : 0, i: 'quiz', c: 'text-blue-500 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20' }, 
                    { t: 'Average Score', v: locals.avgScore || '0%', i: 'star', c: 'text-amber-500 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20' }, 
                    { t: 'Enrolled Courses', v: u.enrolledCourses ? u.enrolledCourses.length : 0, i: 'library_books', c: 'text-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200/60 dark:border-emerald-500/20' }, 
                    { t: 'Completed Lessons', v: u.completedLessons ? u.completedLessons.length : 0, i: 'task_alt', c: 'text-indigo-500 bg-indigo-50 dark:bg-indigo-500/10 border-indigo-200/60 dark:border-indigo-500/20' } 
                ]; %>
                <% statsItems.forEach(s => { %>
                    <div class="p-3.5 sm:p-4 flex items-center gap-3">
                        <div class="size-9 sm:size-10 rounded-lg flex items-center justify-center border shrink-0 <%= s.c %>">
                            <span class="material-symbols-rounded text-lg sm:text-xl leading-none flex items-center justify-center"><%= s.i %></span>
                        </div>
                        <div class="min-w-0">
                            <h4 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-white leading-none mb-1"><%= s.v %></h4>
                            <p class="text-[11.5px] font-medium text-slate-500 dark:text-slate-400 truncate"><%= s.t %></p>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- 3 & 4. PERSONAL & GUARDIAN INFORMATION GRID (ATTACHED FLUSH) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 w-full border-b border-slate-200/80 dark:border-slate-800/80 divide-y lg:divide-y-0 lg:divide-x divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#0f172a]">
                
                <!-- Personal & Academic Information Section -->
                <div class="w-full p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary text-lg flex items-center justify-center leading-none">badge</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Personal & Academic Information</h3>
                        </div>
                        <a href="/profile/edit" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">edit</span> Edit
                        </a>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <!-- Email Address -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">alternate_email</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Email Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.email || 'Not provided' %></p>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">call</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Phone Number</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.phone || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Class Level -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">school</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Class</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.classLevel || 'Class 10' %></p>
                            </div>
                        </div>

                        <!-- School Name -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">domain</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">School Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.schoolName || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- College Name -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">apartment</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">College Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.collegeName || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Present Address -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">home_pin</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Present Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.presentAddress || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Permanent Address -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">location_city</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Permanent Address</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.permanentAddress || 'Not added' %></p>
                            </div>
                        </div>

                        <!-- Joined Date -->
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">calendar_month</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Joined Date</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate">
                                    <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guardian Information Section -->
                <div class="w-full p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-emerald-500 text-lg flex items-center justify-center leading-none">family_restroom</span>
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Guardian Information</h3>
                        </div>
                        <a href="/guardian" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm flex items-center justify-center leading-none">visibility</span> Manage
                        </a>
                    </div>
                    <% const hasGuardian = u && (u.guardianName || u.guardianPhone); %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">person</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Guardian Name</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.guardianName || 'Not added' %></p>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">phone_enabled</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Guardian Phone</p>
                                <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= u.guardianPhone || 'Not added' %></p>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/60 flex items-center gap-2.5 sm:col-span-2">
                            <span class="material-symbols-rounded text-slate-400 text-base shrink-0 flex items-center justify-center leading-none">security</span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-medium text-slate-400">Parental Access Status</p>
                                <% if (hasGuardian) { %>
                                    <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 truncate">Active Parental Link</p>
                                <% } else { %>
                                    <p class="text-xs font-bold text-rose-500 dark:text-rose-400 truncate">Inactive (No Guardian Linked)</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. QUICK ACTIONS GRID (ATTACHED FLUSH) -->
            <div class="w-full bg-white dark:bg-[#0f172a] border-b border-slate-200/80 dark:border-slate-800/80 p-4 sm:p-5">
                <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2.5 mb-3.5">
                    <span class="material-symbols-rounded text-amber-500 text-lg flex items-center justify-center leading-none">bolt</span>
                    <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Quick Actions</h3>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                    <% const quickActions = [ 
                        { t: 'Progress Report', sub: 'Academic Progress', l: '/progress-report', i: 'assignment_turned_in', c: 'text-blue-500 bg-blue-50 dark:bg-blue-500/10 border-blue-200/60 dark:border-blue-500/20' }, 
                        { t: 'Guardian Portal', sub: 'Family Link', l: '/guardian', i: 'family_restroom', c: 'text-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200/60 dark:border-emerald-500/20' }, 
                        { t: 'Payment History', sub: 'Billing & Receipts', l: '/my-payments', i: 'payments', c: 'text-amber-500 bg-amber-50 dark:bg-amber-500/10 border-amber-200/60 dark:border-amber-500/20' } 
                    ]; %>
                    <% quickActions.forEach(a => { %>
                        <a href="<%= a.l %>" class="flex flex-col items-center p-3 rounded-lg bg-slate-50 dark:bg-slate-800/40 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all border border-slate-200/70 dark:border-slate-700/60 group text-center">
                            <div class="size-9 rounded-lg flex items-center justify-center border shrink-0 mb-1.5 <%= a.c %> group-hover:scale-110 transition-transform">
                                <span class="material-symbols-rounded text-lg leading-none flex items-center justify-center"><%= a.i %></span>
                            </div>
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-tight"><%= a.t %></span>
                            <span class="text-[10px] font-medium text-slate-400 mt-0.5"><%= a.sub %></span>
                        </a>
                    <% }) %>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/student-bottom-nav', { activePage: 'profile' }) %>
    <%- include('partials/app-scripts') %>
</body>
</html>